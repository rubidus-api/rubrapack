# Public surface is a WHITELIST: everything is ignored unless listed below.
# dist/v<version>/ holds each release's files; they are published as GitHub release assets only.
# Development material (operating docs, RFCs, private docs/, scripts/, tests/, .agents/,
# DECISIONS.md, CHANGELOG.md) lives in ../rubrapack_private/. Its entries may appear
# here as untracked symlinks and must never be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-ko.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/nob.c
!/nob.h
!/include/
!/src/
!/vendor/
!/resources/
/resources/*
!/resources/ui/
!/resources/bin/
!/resources/lang/
# docs/ is the book as GitHub Pages served it from main; Pages moves to the gh-pages branch and docs/
# then leaves main. The PDFs were built there but published only as release assets.
!/docs/
/docs/*
!/docs/.nojekyll
!/docs/index.html
!/docs/book.css
!/docs/en/
!/docs/ko/
!/docs/fonts/

# Build output, even inside whitelisted folders.
*.o
*.obj
*.exe
!/resources/bin/**/*.exe
*.msi
*.msix
*.cab
__pycache__/
