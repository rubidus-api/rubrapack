# Public surface is a WHITELIST: everything is ignored unless listed below.
# Development material (operating docs, RFCs, private docs/, scripts/, tests/, .agents/,
# DECISIONS.md, CHANGELOG.md) lives in ../rubrapack_private/. Its entries may appear
# here as untracked symlinks and must never be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-ko.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/nob.c
!/nob.h
!/include/
!/src/
!/vendor/
!/resources/
/resources/*
!/resources/ui/
!/resources/bin/
!/manual/
!/manual-ko/
# docs/ is the book GitHub Pages serves (built by manual/book/build.py --out docs), nothing else;
# development docs are in ../rubrapack_private/docs/ only.
!/docs/
/docs/*
!/docs/.nojekyll
!/docs/index.html
!/docs/book.css
!/docs/en/
!/docs/ko/
!/docs/fonts/
!/docs/rubrapack-manual-en.pdf
!/docs/rubrapack-manual-ko.pdf

# Build output, even inside whitelisted folders.
*.o
*.obj
*.exe
!/resources/bin/**/*.exe
*.msi
*.msix
*.cab
