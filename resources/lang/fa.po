# rubrapack language pack: Persian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.
# The language reads right to left (X-Rubrapack-Direction: rtl): its dialogs are mirrored.

msgid ""
msgstr ""
"Language: fa\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: فارسی\n"
"X-Rubrapack-LangIDs: 1065\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 5\n"
"X-Rubrapack-Direction: rtl\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, گفتگوها {6}{7}\n  1 نام، سازنده، نسخه، معماری                   2 پوشه نصب، برای چه کسی\n  3 گفتگوها، مجوز، زبان‌ها                       4 بخش‌های اختیاری\n  5 میان‌برها                                    6 فایل‌ها: هماهنگ با پوشه برنامه\n  7 هر کلید                                      v نمایش   l lint   s ذخیره   q خروج\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nپیام‌های دارای این کد (* به جای یک نام یا مقدار است):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nنتیجه‌ها به stdout و تشخیص‌ها به stderr می‌روند.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nچه باید کرد: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} دیگر وجود ندارد، اما یک میان‌بر آن را باز می‌کند: ابتدا میان‌برها را تغییر دهید (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} فایل و {2} پوشه آنجا هست\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7، v، l، s یا q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] و [files.{2}] افزوده شد\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] افزوده شد\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  آن را به صورت جدول.کلید بدهید، مانند package.version یا dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: مشکلی نیست\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: مشکلات بالا را ببینید (فایلی که آنجا نام برده شده یک نسخه بررسی است)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  زبان‌های دیگر در [ui] languages نگه داشته می‌شوند؛ آن فهرست را با 7 تغییر دهید (هر کلید)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] حذف شد\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] حذف شد{2}\n"

msgid "  sub folders:"
msgstr "  زیرپوشه‌ها:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  این با زیرمجموعه TOML جور نیست؛ چیزی تغییر نکرد\n"

msgid "  that was not readable text; again, please\n"
msgstr "  این متن خوانا نبود؛ لطفاً دوباره\n"

msgid "  the program folder '%s': %s\n"
msgstr "  پوشه برنامه '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  منبع هیچ جدول [file] ندارد که میان‌بری به آن اشاره کند\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  منبع زیرپوشه‌هایی به شکلی که `new` می‌نویسد ندارد ([files] \"<folder>/<name>/**\")؛ آن‌ها را با 6 بیفزایید\n"

msgid "  too long; again, please\n"
msgstr "  خیلی طولانی است؛ لطفاً دوباره\n"

msgid "  y or n\n"
msgstr "  y یا n\n"

msgid " (changed)"
msgstr " (تغییر کرد)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - ساخت بسته‌های Windows Installer (.msi) و MSIX (.msix)\n\nکاربرد: rubrapack [--lang <code>] <command> [arguments]\n\nفرمان‌ها:\n"

msgid " and its dir"
msgstr " و پوشه آن"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) متغیر محیطی ندارد، پس مقدار قابل‌گسترش نمی‌تواند آن را نگه دارد؛ از مقدار رشته‌ای استفاده کنید (هنگام نصب پر می‌شود)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) یک {2} است: می‌تواند مسیری را آغاز کند یا جای مقداری باشد که Windows Installer پر می‌کند (رجیستری، محیط، INI، آرگومان‌ها، پیام‌ها)، نه اینجا"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) پوشه‌ای نیست که مسیری از آن آغاز شود (یک dir ID، یا ProgramFiles، LOCALAPPDATA، ProgramData ... - بخش مسیرها در راهنما را ببینید){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  ساختار:     {2}\n  چکیده:      {3}\n  امضا:       {4}\n  زنجیره:     {5}{6}{7}\n  ابطال:      بررسی نشده\n  مهر زمانی:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: متغیر تنظیم نشده است"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' کنترلی از این گفتگو نیست"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' در {3} نیست"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': متن مجوز به نام انگلیسی قلم نیاز دارد، پس با قلم خود زبان نمایش داده می‌شود؛ برای استفاده از این قلم در آنجا، نام انگلیسی را بنویسید (مانند \"Malgun Gothic\")"

msgid "%s component, but the package platform is %.*s"
msgstr "مؤلفه {1}، اما سکوی بسته {2} است"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} به kind = \"{2}\" تعلق ندارد"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} به kind = \"firewall\" تعلق ندارد"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} شناسه‌های LANGID را نگه می‌دارد (1..65535)، مانند 1041"

msgid "%s holds strings"
msgstr "{1} رشته‌ها را نگه می‌دارد"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} فهرستی از متن‌های \"کلید=مقدار\" است"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} نام قلمی با 1 تا 31 نویسه است، مانند \"Segoe UI\" ({2} دریافت شد)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} یک شرط MSI با گیومه‌های بسته و پرانتزهای متوازن است"

msgid "%s is an array of strings, one per value"
msgstr "{1} آرایه‌ای از رشته‌ها است، یکی برای هر مقدار"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} برای بسته‌های MSI است: یک MSIX با msiexec حذف نمی‌شود"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} دیگر وجود ندارد. [file.{2}] حذف شود؟"

msgid "%s is longer than 240 characters"
msgstr "{1} بیش از 240 نویسه است"

msgid "%s is new. Add it?"
msgstr "{1} جدید است. افزوده شود؟"

msgid "%s is not a GUID in registry format"
msgstr "{1} یک GUID در قالب رجیستری نیست"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} کدی نیست که این rubrapack به کار ببرد{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} باید \"file:<ID>\" باشد که یک [file.*] از این بسته را نام ببرد"

msgid "%s must be a GUID"
msgstr "{1} باید یک GUID باشد"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} باید GUID مانند {{12345678-...} باشد ('{2}' دریافت شد)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} باید نشانی https://، http:// یا file://، یا مسیر \\\\server\\share باشد ('{2}' دریافت شد)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} باید با upgrade-code متفاوت باشد (یک خانواده ارتقا برای هر معماری)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} به ساخت {2} یا جدیدتر Windows نیاز دارد: [msix] min-version = \"10.0.{3}.0\" را تنظیم کنید"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} به resources/bin/rubrapack_ca-{2}.dll نیاز دارد که این rubrapack بدون آن ساخته شده است"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}، TSA بررسی نشده (--tsa-trust بدهید)"

msgid "%s, TSA trusted"
msgstr "{1}، TSA مورد اعتماد"

msgid "%s, TSA untrusted - %s"
msgstr "{1}، TSA غیرقابل اعتماد - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} وجود ندارد یا خالی است. [files.{3}] و [dir.{4}] حذف شوند؟"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ پوشه‌ای جدید است. افزوده شود؟"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: خطاها: {2}{-3}، هشدارها: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: خطاها: {2}{-3}، هشدارها: {4}{-5} (نسبت به {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} فایل، {3} بایت\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} فایل، {3} خطا، 0 هشدار\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} تشخیص دیگر نمایش داده نشد\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' کنشی استاندارد نیست که rubrapack قرار دهد"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: فایل '{2}' یک [file.*] از این بسته نیست"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: فایل '{2}' برنامه نیست (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' بسته نشده است (برای متن '$(' بنویسید '$$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' از قبل وجود دارد؛ همان‌طور باقی می‌ماند"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' از قبل وجود دارد؛ آن را حذف کنید یا در پوشه دیگری بسازید"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' از قبل یک کنترل‌کننده {2} دارد ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' از قبل مجوزها را دارد"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' و '{2}' در بسته یک مسیرند"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' متعلق به Windows یا مرورگرها است"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' را نمی‌توان نسبت به '{2}' خواند: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' با زیرمجموعه TOML جور نیست؛ چیزی ذخیره نشد"

msgid "'%s' exists already"
msgstr "'{1}' از قبل وجود دارد"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' از قبل وجود دارد؛ آن را با `rubrapack edit {2}` تغییر دهید"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' وجود دارد و پوشه خالی نیست؛ در پوشه‌ای جدید استخراج کنید"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' به {2} می‌رود؛ یا msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' یک جریان اطلاعات خلاصه ناخوانا دارد"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' جدول‌های Directory، Component، File و Media برای استخراج ندارد"

msgid "'%s' has no readable summary information"
msgstr "'{1}' اطلاعات خلاصه خوانا ندارد"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' تبدیل '{2}' را ندارد"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' UTF-16 است: edit فقط منبع‌های UTF-8 را تغییر می‌دهد (ابتدا آن را UTF-8 ذخیره کنید)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' یک نام Windows است؛ نام دیگری به متغیر بدهید"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' یک [chain] است: یک برنامه نصب می‌سازد، -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' کنترلی از قاب داخلی است؛ ID دیگری انتخاب کنید"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' یک پوشه رایانه است؛ بسته {2} نمی‌تواند آنجا بنویسد"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' یک ماژول ادغام است: آن را با [merge.ID] ادغام کنید"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' نامی است که قالب MSIX برای خود نگه می‌دارد"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' یک پیوند نمادین است؛ پیوندها دنبال نمی‌شوند"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' یک [property.*] هم هست"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' یک dir ID هم هست؛ نام دیگری به متغیر بدهید"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' برای ماشین 0x{2} ساخته شده، نه برای معماری این بسته؛ اگر عمدی است any-arch = true بگذارید"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' نه فایل PE (.exe، .dll) است، نه بسته MSI و نه بسته یا مجموعه MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' نه فایل PE است، نه بسته MSI و نه بسته یا مجموعه MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' نه پوشه شناخته‌شده است و نه dir ID (پوشه‌های شناخته‌شده: ProgramFiles، ProgramFiles32، CommonFiles، AppData، LocalAppData، CommonAppData، StartMenu، Programs، Desktop، Windows، System، Fonts، Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' یک cabinet نیست که rubrapack بتواند بخواند (stored یا MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' کد تشخیصی نیست (RP و چهار رقم، مانند RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' برنامه نیست (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' فایل معمولی نیست"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' برنامه نصب rubrapack نیست{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' ID معتبر نیست (حروف، ارقام و '_'، بدون آغاز با رقم، حداکثر {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' پایگاه داده MSI معتبر نیست: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' بسته MSIX معتبر نیست: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' بسته معتبر نیست: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' منبع معتبر نیست (زیرمجموعه TOML)؛ ابتدا آن را دستی درست کنید"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' تبدیل معتبر نیست: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' نام متغیر معتبر نیست"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' رزرو شده و نمی‌تواند به عنوان ID به کار رود"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' نام یک dir است: فقط جستجوی رجیستری یا dir می‌تواند dir را پر کند"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' شبیه فایل برنامه (PE) است اما سرآیندها یا منابع آن آسیب دیده‌اند"

msgid "'%s' must be a string"
msgstr "'{1}' باید رشته باشد"

msgid "'%s' must be an integer"
msgstr "'{1}' باید عدد صحیح باشد"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' باید بین {2} و {3} باشد"

msgid "'%s' must be true or false"
msgstr "'{1}' باید true یا false باشد"

msgid "'%s' must not be empty"
msgstr "'{1}' نباید خالی باشد"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' هیچ تبدیلی را نام نمی‌برد (ویژگی خلاصه 8): وصله نیست"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' با یک پوشه آغاز می‌شود: \"$(ProgramFiles)/Example\"، \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' دارای {4} است؛ چیزی استخراج نشد"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} ورودی، بیش از حد {3} (--limit-entries)؛ چیزی استخراج نشد"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' و '{3}' در Windows یک مسیر می‌شدند؛ چیزی استخراج نشد"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' در [ui] languages نیست"

msgid "'%s': a table cannot be read"
msgstr "'{1}': یک جدول خوانده نمی‌شود"

msgid "'%s': a table is unreadable"
msgstr "'{1}': یک جدول ناخوانا است"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': یک MSIX همه فایل‌هایش را نصب می‌کند (when)؛ از msi-only = true استفاده کنید"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': یک MSIX همه فایل‌هایش را حذف می‌کند (keep)؛ از msi-only = true استفاده کنید"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' آسیب دیده یا stored/MSZIP نیست"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': نام cabinet '{2}' یک نام فایل ساده نیست"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': فایل فشرده '{2}' (ترتیب {3}) cabinet ندارد"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': پوشه '{2}' والدی به نام '{3}' دارد که وجود ندارد"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': پوشه '{2}' نیای خودش است یا بیش از حد تودرتو است"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': فایل '{2}' با MsiFileHash خود جور نیست"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': فایل '{2}' مؤلفه یا پوشه ندارد"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': فایل '{2}' {3} بایت است، جدول File می‌گوید {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': فایل '{2}' در cabinet '{3}' نیست"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': cabinet‌های بیرونی آن را امضا پوشش نمی‌دهد (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': پوشه آن به مکان شناخته‌شده‌ای نمی‌رسد"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': بیش از {2} بایت برای نوشتن (--limit-bytes)؛ چیزی استخراج نشد"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': بدون --timestamp: وقتی گواهی منقضی شود، امضا دیگر معتبر نیست"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': بسته '{2}' با SHA-256 خود جور نیست"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': جریان cabinet '{2}' وجود ندارد"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': مانیفست {2} {3} ندارد"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': مانیفست '{2}' را نام می‌برد که در بسته نیست"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': مهر زمانی از {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': تبدیل '{2}' را نمی‌توان نسبت به '{3}' خواند: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' زبان خود بسته است ({2})؛ آن متن را بدون پسوند بدهید"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' باعث می‌شود Windows Installer یک چندرشته‌ای بنویسد؛ از type = \"multi\" و یک آرایه استفاده کنید"

msgid "'_' in numbers is not supported"
msgstr "'_' در اعداد پشتیبانی نمی‌شود"

msgid "'help' takes at most one command name"
msgstr "'help' حداکثر یک نام فرمان می‌پذیرد"

msgid "'version' takes no arguments"
msgstr "'version' آرگومان نمی‌پذیرد"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs برای .msi است"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch برای مجموعه: فهرستی از x64، x86 و arm64، هر کدام یک بار ('{1}' دریافت شد)"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch یک معماری، یا فهرستی برای خروجی .msixbundle می‌پذیرد"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert، --pass-env، --pass-file، --timestamp و --allow-unsigned-cabs همراه --key می‌آیند"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress برای .msi است؛ MSIX گزینه --msix-compress deflate|store را می‌پذیرد"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist یک پوشه جدید کنار منبع را نام می‌برد (بدون مسیر)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs عددی از 1 تا 64 می‌پذیرد ('{1}' دریافت شد)"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store یک انبار گواهی Windows است؛ جای دیگر از فایل کلید یا --pkcs11 استفاده کنید"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store اثر انگشت SHA-1 گواهی را می‌پذیرد (40 رقم شانزده‌شانزدهی)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: چنین زبانی نیست (داخلی: {2}؛ زبان دیگر به بسته زبان خود نیاز دارد، {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (یا RUBRAPACK_LANG) زبان این متن‌ها را انتخاب می‌کند: {1}، یا زبانی که بسته زبان دارد.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang به یک زبان نیاز دارد، مانند en یا ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages به گفتگوها نیاز دارد: --ui را هم بدهید"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress مقدار deflate یا store را می‌پذیرد ('{1}' دریافت شد)"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: متغیر تنظیم نشده است"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code یک GUID با حروف بزرگ و آکولاد می‌پذیرد: {{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: متغیر تنظیم نشده است"

msgid "--previous compares two .msi packages"
msgstr "--previous دو بسته .msi را مقایسه می‌کند"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: گواهی‌های ریشه سیستم‌عامل خوانده نمی‌شوند"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} با خروجی '{2}' جور نیست"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} پیاده‌سازی نشده است (msi یا msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target مقدار msi یا msix را می‌پذیرد ('{1}' دریافت شد)"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust، --tls-trust، --system-roots و --proxy همراه --timestamp می‌آیند"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test و --msix-compress برای خروجی‌های .msix هستند"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test برای بسته‌های بدون امضا است؛ با --key آن را حذف کنید"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate مقدار none یا برخی از product-code،upgrade-code،language،platform را می‌پذیرد"

msgid "-D %.*s is given twice"
msgstr "-D {1} دو بار داده شده است"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' یک نام Windows است؛ نام دیگری به متغیر بدهید"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D به NAME=VALUE نیاز دارد ('{1}' دریافت شد)"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i همه پاسخ‌ها را می‌پرسد؛ یا -i بدهید یا گزینه‌ها را"

msgid "; its range is "
msgstr "؛ دامنه آن "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' در SecureCustomProperties نیست"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty باید یک ویژگی عمومی (با حروف بزرگ) باشد"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "همه کدها: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x با PKCX آغاز نمی‌شود"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x آخرین ورودی نیست"

msgid "Architecture (x64, x86, arm64)"
msgstr "معماری (x64، x86، arm64)"

msgid "Choose"
msgstr "انتخاب کنید"

msgid "Command line"
msgstr "خط فرمان"

msgid "Command line (lint)"
msgstr "خط فرمان (lint)"

msgid "Common AppData"
msgstr "AppData مشترک"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId یک GUID در قالب رجیستری نیست"

msgid "Desktop shortcut?"
msgstr "میان‌بر روی میزکار؟"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "گفتگوها (none، basic، minimal، installdir، features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "کدهای خروج: 0 موفق، 1 خطای منبع، 2 کاربرد، 3 ورودی/خروجی، 4 امضا یا بررسی،\n5 lint، 6 شبکه.\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "جدول File، Component یا Directory یک ستون استاندارد کم دارد"

msgid "Folder name under Program Files"
msgstr "نام پوشه زیر Program Files"

msgid "Folder with the files to install"
msgstr "پوشه فایل‌هایی که نصب می‌شوند"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "ID '{1}' از قبل به کار رفته است (خط {2})؛ IDها باید در همه جدول‌ها متفاوت باشند"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "پوشه نصب (مسیر [dir.INSTALLDIR])"

msgid "Install for (machine, user, dual)"
msgstr "نصب برای (machine، user، dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "کلید به صورت جدول.کلید (package.version، dir.INSTALLDIR.path، ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' متعلق به مؤلفه دیگری است"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' در File نیست"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' در Registry نیست"

msgid "Korean dialogs as well as English?"
msgstr "گفتگوهای کره‌ای هم در کنار انگلیسی؟"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} از مقدار یک DiskId کوچک‌تر کمتر است"

msgid "Leave without saving the changes?"
msgstr "بدون ذخیره تغییرات خارج شوید؟"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "مجوزی که باید پذیرفته شود (.txt، .md، .rtf؛ - برای هیچ)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "MSIX برای AppData کاربر پوشه مجازی ندارد؛ برنامه هنگام اجرا آنچه لازم دارد را آنجا می‌سازد"

msgid "MSIX packages"
msgstr "بسته‌های MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: یک بسته MSIX به چه نیاز دارد و چه چیزی را نمی‌تواند حمل کند"

msgid "Main program, for shortcuts (- for none)"
msgstr "برنامه اصلی، برای میان‌برها (- برای هیچ)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "راهنما: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "سازنده"

msgid "Manufacturer (shown in Installed apps)"
msgstr "سازنده (در برنامه‌های نصب‌شده نمایش داده می‌شود)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt یک امضای ECDSA با طول نادرست برگرداند"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "بخش‌های اختیاری که کاربر می‌تواند علامت بزند (زیرپوشه‌ها، با ویرگول؛ - برای هیچ)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "توکن PKCS#11: توکن گواهی با CKA_ID کلید ندارد (آن را با --cert بدهید)"

msgid "Paths"
msgstr "مسیرها"

msgid "Product name"
msgstr "نام محصول"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode و UpgradeCode یک GUID هستند"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} در سه بخش اول از قبلی {2} بالاتر نیست: Windows Installer ارتقا نمی‌دهد"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "برنامه‌ای که میان‌برها باز می‌کنند (- بدون میان‌بر)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: چنین زبانی نیست (داخلی: {2}؛ زبان دیگر به بسته زبان خود نیاز دارد، {3}.po)"

msgid "Reference, "
msgstr "مرجع، "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "ترتیب {1} را هیچ ردیف Media پوشش نمی‌دهد (آخرین {2})"

msgid "Sequence %ld is used by another file"
msgstr "ترتیب {1} را فایل دیگری به کار برده است"

msgid "Source file to write"
msgstr "فایل منبعی که نوشته شود"

msgid "Source format"
msgstr "قالب منبع"

msgid "Source must name a File row for type %ld"
msgstr "Source باید یک ردیف File را برای نوع {1} نام ببرد"

msgid "Start menu shortcut?"
msgstr "میان‌بر در منوی شروع؟"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "ورودی‌های منوی شروع، برنامه‌ها، میزکار و راه‌اندازی از [shortcut.*] و [msix-extension.*] می‌آیند"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML بیرون از زیرمجموعه‌ای که rubrapack می‌خواند، یا `format` نیست یا خیلی جدید است"

msgid "Tables"
msgstr "جدول‌ها"

msgid "The TOML subset"
msgstr "زیرمجموعه TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "فایل‌های UTF-16 big-endian پشتیبانی نمی‌شوند؛ به صورت UTF-8 ذخیره کنید"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} با {2} نسخه قبلی متفاوت است: این بسته جایگزین آن نمی‌شود"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode یک GUID در قالب رجیستری نیست"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "مقدار (متن، عدد، true/false، [\"a\", \"b\"]؛ - کلید را حذف می‌کند)"

msgid "Variables"
msgstr "متغیرها"

msgid "Version"
msgstr "نسخه"

msgid "Version ([define] VERSION)"
msgstr "نسخه ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "نسخه‌ها و ارتقاها"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer حداکثر 255.255.65535(.65535) را مجاز می‌داند"

msgid "Windows name"
msgstr "نام Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] به '{4}' نیاز دارد"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] نمی‌تواند در ماژول ادغام باشد؛ بسته‌ای که آن را ادغام می‌کند آن را دارد"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] هنوز پشتیبانی نمی‌شود (برای {3} برنامه‌ریزی شده)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] نمی‌تواند در MSIX باشد؛ برای ساختن MSIX بدون آن msi-only = true بیفزایید"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] در AppData یا LocalAppData کاربر است: بسته dual که برای همه کاربران نصب شود آن را فقط در نمایه کاربر نصب‌کننده می‌گذارد"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: یک ID در ماژول ادغام حداکثر 35 نویسه دارد (GUID ماژول به آن افزوده می‌شود)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] به یک ID نیاز دارد: [{2}.ID] بنویسید"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] ID نمی‌پذیرد: [{2}] بنویسید"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml تگ </Types> ندارد"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml آخرین ورودی نیست (بسته‌ای نیست که rubrapack یا API بسته‌بندی Windows نوشته باشد)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "آرایه‌های جدول [[...]] پشتیبانی نمی‌شوند؛ به هر مورد [kind.ID] خودش را بدهید"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] یک بار قرار می‌گیرد: before، after یا sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] به do و undo هر دو نیاز دارد (undo یک do ناموفق را هم برمی‌گرداند)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] به entry نیاز دارد: تابع DLL که فراخوانده می‌شود"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] به run = \"file:<ID>\" نیاز دارد: برنامه‌ای که do و undo اجرا می‌کنند"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] یک چیز را اجرا می‌کند: run (یک exe)، dll (یک DLL نصب‌شده) یا binary (یک DLL در بسته)؛ یا do و undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} برای یک کنش است، نه برای جفت do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: کنش به‌تعویق‌افتاده‌ای که پروندهٔ نصب‌شده را اجرا می‌کند باید پس از InstallFiles باشد (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: کنش فوری با حساب کاربری که نصب می‌کند اجرا می‌شود؛ as برای مرحله‌های دیگر است"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args از آنِ برنامه است؛ DLL داده data می‌گیرد"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check با جفت do/undo می‌آید"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data برای کنش به‌تعویق‌افتاده، commit یا rollback است (کنش فوری ویژگی‌ها را می‌خواند)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry تابعی از یک DLL است؛ run آرگومان args می‌گیرد"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args برای MSIX باید متن ساده باشد (بدون [...] که هنگام نصب پر شود)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: در MSIX یک نوع فایل برنامه‌ای را باز می‌کند: target باید یک اجرایی [msix-app.*] باشد"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] دو بار آمده است"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] به یک ID نیاز دارد: [chain-package.ID] بنویسید"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id و typelib فقط برای MSI نوشته می‌شوند؛ MSIX کلاس را بدون آن‌ها ثبت می‌کند"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args مال یک برنامه است؛ یک DLL بارگذاری می‌شود، اجرا نمی‌شود"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate یک DLL را در dllhost اجرا می‌کند؛ '{2}' یک برنامه است"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading برای DLL است؛ یک برنامه آپارتمان خودش را تعیین می‌کند"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version و typelib-file به typelib نیاز دارند"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] به {2} می‌رود؛ یا msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: منبع آن باید فایلی باشد که وارد بسته می‌شود"

msgid "[define] values must be strings"
msgstr "مقادیر [define] باید رشته باشند"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] به '{2}' نیاز دارد"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] به image نیاز دارد"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] به 'property' نیاز دارد"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] به 'text' نیاز دارد"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] به 'values' نیاز دارد"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] دارای {2} کنترل است؛ حداکثر 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] هیچ [dialog-control.*] ندارد"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] از طریق گفتگوهای دیگر پس از خودش قرار گرفته است"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] به ui = \"minimal\"، \"installdir\" یا \"features\" نیاز دارد"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' یک نام Windows است؛ ID دیگری به dir بدهید"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard به DLL کمکی rubrapack نیاز دارد که ماژول ادغام آن را حمل نمی‌کند"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] به یک ویژگی نیاز دارد"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: یک MSIX همه متغیرهایش را تنظیم می‌کند (when)؛ از msi-only = true استفاده کنید"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: مقدار آن جایی را نام می‌برد که MSIX نمی‌تواند بدهد (پوشه‌ای بیرون از بسته که پوشه Windows نیست، یا بخشی از زمان نصب)؛ از msi-only = true استفاده کنید"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] از پیش در پوشهٔ برنامهٔ خود است؛ isolate-for برای DLL مشترکی است که جای دیگر نصب می‌شود"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] در نمایه کاربر است و component-guid دارد: مسیر کلید آن همان فایل می‌ماند، در حالی که قواعد Windows آنجا یک مقدار HKCU می‌خواهند (ICE38)؛ برای داشتن آن component-guid را بردارید"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer یک کنترل‌کننده {2} را از یک DLL بارگذاری می‌کند؛ [com.{3}] یک برنامه است"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows کنترل‌کننده‌های ویژگی را فقط در سطح رایانه می‌خواند؛ بسته به scope = \"machine\" نیاز دارد"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: کنترل‌کننده پیش‌نمایش در prevhost ویندوز اجرا می‌شود؛ app-id و surrogate را از [com.{2}] حذف کنید"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX فقط کنترل‌کننده‌های تصویر کوچک و پیش‌نمایش را حمل می‌کند (کنترل‌کننده ویژگی بسته‌بندی‌شده به Explorer مقداری نداد)؛ msi-only = true آن را برای MSI نگه می‌دارد"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: یک نوع فایل MSIX متعلق به یک برنامه است؛ یک [msix-app.*] بیفزایید"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: کلاس {2} یک [com.*] از این بسته نیست (DLL کنترل‌کننده آن را ارائه می‌دهد)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: در MSIX کنترل‌کننده‌ها همه نوع‌هایشان را مشترک دارند یا هیچ‌کدام را (هر نوع در یک پیوند نوع فایل است)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: در MSIX کلاس آن در یک جایگزین اجرا می‌شود؛ threading = \"sta\" در [com.{2}] به پنجره‌اش حلقه پیام می‌دهد (با threading = {3} پیش‌نمایش ممکن است خالی بماند)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: در MSIX همه نوع‌های آن در یک نوع فایل [assoc] هستند، یا هیچ‌کدام"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: کلاس آن فقط MSI است ([com.{2}])؛ MSIX سروری برای آن نخواهد داشت"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types فهرستی از نوع‌های فایل است، مانند [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] به {2} می‌رود؛ یا msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] به 'value' نیاز دارد"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] به یک ویژگی نیاز دارد: 'feature' را اینجا یا روی dir آن تنظیم کنید"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: یک MSIX همه ورودی‌های INI خود را می‌نویسد (when)؛ از msi-only = true استفاده کنید"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: مقدار آن بخشی دارد که Windows Installer هنگام نصب پر می‌کند ([...])؛ یک MSIX فایل را هنگام ساخت می‌نویسد"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] به 'on' نیاز دارد: جایی که مورد نمایش داده می‌شود، مانند [\".txt\"] یا \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] به 'target' (برنامه‌ای که اجرا می‌کند) یا مواردی با parent = \"{2}\" (یک زیرمنو) نیاز دارد"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] به 'target' نیاز دارد: برنامه‌ای که مورد اجرا می‌کند"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: منوی Windows 11 فقط شناسه‌ای از حروف و ارقام می‌پذیرد (بدون '_'): نامش را عوض کنید یا windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: یک زیرمنو چیزی را اجرا نمی‌کند: 'args' را حذف کنید"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: مورد یک زیرمنو جایی نمایش داده می‌شود که زیرمنوی آن نمایش داده می‌شود: 'on' را حذف کنید"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args بخشی دارد که Windows Installer هنگام نصب پر می‌کند ([...])؛ یک MSIX فقط متن ثابت نگه می‌دارد"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when برابر \"HKCU\\\\key\\\\value\" یا \"HKLM\\\\...\" است، روی موردی از منوی Windows 11 که در زیرمنو نیست"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when مقداری را نام می‌برد که خود این بسته می‌نویسد ([registry.{2}]): مورد هرگز دیده نمی‌شود"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: برنامه آن در MSIX نیست (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: مقادیر آن نمی‌توانند در رجیستری بسته قرار گیرند"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list بخشی دارد که Windows Installer هنگام نصب پر می‌کند ([...])؛ یک MSIX فقط متن ثابت نگه می‌دارد"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: وقتی مسیرها در یک خط فرمان جا نمی‌شوند، list جای {2} را می‌گیرد: multi = \"one\"، {3} در args و {4} (پرونده فهرست) در list لازم است"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": هیچ [assoc.{3}] وجود ندارد"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on یک نوع فایل یا فهرستی از آن‌ها است، مانند [\".txt\"، \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: والد '{2}' یک [menu.*] نیست"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: والد '{2}' باید یک زیرمنو باشد: یک [menu.*] بدون target و بدون والد خودش"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] به {2} می‌رود؛ یا msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] به یک ویژگی نیاز دارد: 'feature' را اینجا یا روی dir آن تنظیم کنید"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}؛ یا msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] به feature نیاز دارد (یا with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature با مؤلفهٔ خودش می‌آید، نه با with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name یک پرونده را نام می‌برد؛ name نویسه‌های جایگزین دارد"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args باید متن ساده باشد (بدون [...] که هنگام نصب پر شود)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file باید {2} باشد"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file باید فایلی را نام ببرد که وارد بسته می‌شود"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file باید برنامه‌ای را نام ببرد که وارد بسته می‌شود"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types فهرستی از نوع‌های فایل است، مانند [\".txt\"، \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows فقط حروف و ارقام را می‌پذیرد"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: پروندهٔ '{2}' یک DLL نیست"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] راه‌انداز خود را یک بار نام می‌برد: driver (یک [odbc-driver]) یا driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] با driver-name به with = \"file:<ID>\" نیاز دارد: مؤلفه‌ای که با آن نصب می‌شود"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: بستهٔ هر رایانه منابع داده را برای رایانه ثبت می‌کند"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] یک نسخه را نام می‌برد: msix (با publisher) یا upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix نام هویت بسته است (۳ تا ۵۰ حرف، رقم، '.' یا '-') و publisher (\"CN=...\") می‌خواهد، همان‌طور که در مانیفستش آمده"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: نسخه دیگر را بررسی پیشین می‌جوید: preflight = true لازم است"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code مال خود این بسته است (آن ارتقا است، نه نسخه‌ای دیگر)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] نیاز دارد که dir آن یک ویژگی داشته باشد"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args برای MSIX باید متن ساده باشد (بدون [...] که هنگام نصب پر شود)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: در MSIX یک طرح برنامه‌ای را باز می‌کند: target باید یک اجرایی [msix-app.*] باشد"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] به 'value' نیاز دارد (یا remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR به بیرون از MSIX نمی‌رسد؛ از [assoc.*]، [protocol.*]، [com.*] یا [handler.*]، یا msi-only = true استفاده کنید"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: یک مقدار qword به DLL کمکی rubrapack نیاز دارد که ماژول ادغام آن را حمل نمی‌کند"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: یک MSIX فقط مقادیر زیر {2}\\Software را حمل می‌کند"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: یک MSIX نه مقادیر را حذف می‌کند و نه آن‌ها را باقی می‌گذارد (remove، keep)؛ از msi-only = true استفاده کنید"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: یک MSIX همه مقادیرش را می‌نویسد (when)؛ از msi-only = true استفاده کنید"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: مقدار آن بخشی دارد که Windows Installer هنگام نصب پر می‌کند ([...])؛ یک MSIX فقط مقادیر ثابت نگه می‌دارد"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" به DLL کمکی rubrapack نیاز دارد که ماژول ادغام آن را حمل نمی‌کند"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: نام کلید یا مقدار نمی‌تواند در یک hive رجیستری قرار گیرد"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" برای root = \"HKCU\" با on = \"uninstall\"، در بستهٔ رایانه است"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] به یک ویژگی نیاز دارد: 'feature' را اینجا یا روی dir آن تنظیم کنید"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true برای پوشه‌ای زیر {2} نیست"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true به DLL کمکی rubrapack نیاز دارد که ماژول ادغام آن را حمل نمی‌کند"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" برای recursive = true روی پوشه‌ای در AppData یا LocalAppData، در بستهٔ رایانه است"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args برای MSIX باید متن ساده باشد (بدون [...] که هنگام نصب پر شود)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file باید برنامه‌ای را نام ببرد که وارد بسته می‌شود"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] قابلیت '{2}' را تبلیغ می‌کند که advertise = \"disallow\" دارد"

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise با when ترکیب نمی‌شود"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: یک MSIX فقط روی میزکار و در منوی شروع میان‌بر دارد{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
