msgid "as must be \"system\" or \"user\" (got '%s')"
msgstr "as باید \"system\" یا \"user\" باشد ('{1}' دریافت شد)"

msgid "at most %d languages besides English"
msgstr "حداکثر {1} زبان به جز انگلیسی"

