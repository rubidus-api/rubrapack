msgstr "یک جریان بسته خوانده نمی‌شود"

msgid "a table has more than 32 columns"
msgstr "یک جدول بیش از 32 ستون دارد"

msgid "a value `with` a file shares its component: put `when` on the file"
msgstr "مقداری که `with` یک فایل است مؤلفه آن را شریک است: `when` را روی فایل بگذارید"

msgid "a value is 1 to 64 bytes"
msgstr "یک مقدار 1 تا 64 بایت است"

msgid "a value that goes 'with' a file takes that file's feature"
msgstr "مقداری که 'with' یک فایل می‌رود ویژگی آن فایل را می‌گیرد"

msgid "a version is 3 or 4 numbers with dots, such as 1.0.0"
msgstr "یک نسخه 3 یا 4 عدد با نقطه است، مانند 1.0.0"

msgid "account must be LocalSystem, LocalService or NetworkService"
msgstr "account باید LocalSystem، LocalService یا NetworkService باشد"

msgid "action '%s' is already defined"
msgstr "عمل '{1}' از قبل تعریف شده است"

msgid "action is neither a standard action nor in CustomAction"
msgstr "عمل نه یک عمل استاندارد است و نه در CustomAction"

msgid "action must be \"warn\" or \"refuse\" (got '%s')"
msgstr "action باید \"warn\" یا \"refuse\" باشد ('{1}' آمد)"

msgid "adds too many tables"
msgstr "جدول‌های بیش از حد اضافه می‌کند"

msgid "advertise is \"allow\" or \"disallow\" (got '%s')"
msgstr "advertise باید \"allow\" یا \"disallow\" باشد ('{1}' دریافت شد)"

