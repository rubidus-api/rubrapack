msgid "product-code must be a GUID"
msgstr "product-code باید یک GUID باشد"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile باید \"all\"، \"domain\"، \"private\" یا \"public\" باشد ('{1}' دریافت شد)"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id '{1}' از قبل مال [com.{2}] است"

