msgstr "یک بسته x86 فقط در نمای 32 بیتی رجیستری می‌نویسد"

msgid "app '%s' is not an [msix-app.*]"
msgstr "برنامه '{1}' یک [msix-app.*] نیست"

msgid "appinstaller-uri and package-uri go together: where the .appinstaller file and the package will be"
msgstr "appinstaller-uri و package-uri با هم می‌آیند: جایی که فایل .appinstaller و بسته خواهند بود"

msgid "arch must be \"x64\", \"arm64\" or \"x86\" (got '%s')"
msgstr "arch باید \"x64\"، \"arm64\" یا \"x86\" باشد ('{1}' دریافت شد)"

msgid "arch must be \"x64\", \"x86\" or \"arm64\" (the setup program's own)"
msgstr "arch باید \"x64\"، \"x86\" یا \"arm64\" باشد (معماری خود برنامه نصب)"

