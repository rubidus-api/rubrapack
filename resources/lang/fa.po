msgstr "حداکثر 100 جدول [msix-app.*]"

msgid "at most 50 [action.*] tables (this file has %zu)"
msgstr "حداکثر 50 جدول [action.*] (این فایل {1} دارد)"

msgid "background-color is \"transparent\" or \"#RRGGBB\", like \"#1E3A5F\""
msgstr "background-color مقدار \"transparent\" یا \"#RRGGBB\" است، مانند \"#1E3A5F\""

msgid "bad variable name in '$(...)'"
msgstr "نام متغیر نادرست در '$(...)'"

msgid "banner must be a .bmp file (Windows Installer shows BMP only)"
msgstr "banner باید یک فایل .bmp باشد (Windows Installer فقط BMP نشان می‌دهد)"

msgid "build a package from a source file"
msgstr "ساخت یک بسته از یک فایل منبع"

msgid "building %s from a %s source needs its own upgrade family: add %s = \"{...}\" to [package]"
msgstr "ساختن {1} از یک منبع {2} به خانواده ارتقای خودش نیاز دارد: {3} = \"{{...}\" را به [package] بیفزایید"

msgid "cab must be \"embed\" or \"external\""
