msgctxt "installer"
msgid "DirNotEmptyText"
msgstr "این پوشه از قبل فایل یا پوشه دارد. وقتی [ProductName] حذف شود، همه چیز در این پوشه پاک می‌شود - حتی آنچه اکنون در آن است. پوشه خالی یا جدید انتخاب امن‌تری است."

msgctxt "installer"
msgid "DirChoose"
msgstr "&انتخاب پوشه دیگر"

msgctxt "installer"
msgid "DirContinue"
msgstr "استفاده از این &پوشه"

msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] برنامه از فایل‌های [3] استفاده می‌کند:\r\n[2]\r\nهمه بسته شوند؟\r\n\r\nبله: همه را ببند و ادامه بده (کار ذخیره‌نشده ممکن است از دست برود).\r\nخیر: بدون بستن ادامه بده (برنامه‌های باز تا زمانی که دوباره باز شوند فایل‌های قدیمی را نگه می‌دارند).\r\nلغو: توقف."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: متوقف شد، زیرا [1] برنامه از فایل‌های آن استفاده می‌کند:\r\n[2]آن‌ها را ببندید و دوباره امتحان کنید، یا RPCLOSE=yes (همه را ببند و ادامه بده) یا RPCLOSE=no (بدون بستن ادامه بده) بدهید."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] مورد در پوشه‌های [3] همراه آن نصب نشده‌اند:\r\n[2]\r\nآن‌ها هم پاک شوند؟\r\n\r\nبله: آن‌ها را همراه [3] پاک کن (قابل بازگرداندن نیستند).\r\nخیر: [3] را حذف کن و آن‌ها را نگه دار.\r\nلغو: توقف."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: متوقف شد، زیرا [1] مورد در پوشه‌های آن همراهش نصب نشده‌اند:\r\n[2]RPEXTRA=delete (آن‌ها را هم پاک کن) یا RPEXTRA=keep (آن‌ها را نگه دار) بدهید و دوباره حذف کنید."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "[1] کاربر دیگر این رایانه ممکن است تنظیمات یا داده‌های [3] را داشته باشند:\r\n[2]\r\nمال آن‌ها هم حذف شود؟\r\n\r\nبله: برای همهٔ کاربران حذف شود (قابل بازگرداندن نیست).\r\nخیر: فقط مال شما حذف شود.\r\nلغو: توقف."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] از قبل از Microsoft Store یا به‌صورت بسته برنامه روی این رایانه نصب است ([2]). دو نسخه از یک برنامه هر دو پرونده‌هایش را باز می‌کنند و هر دو منوهایش را نشان می‌دهند.\r\n\r\nاین یکی هم نصب شود؟"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] از قبل از Microsoft Store یا به‌صورت بسته برنامه روی این رایانه نصب است ([2]). اول آن نسخه را حذف کنید (تنظیمات > برنامه‌ها)، بعد این یکی را نصب کنید."

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "نصب دیگری از [1] از قبل روی این رایانه هست ([2]). دو نسخه از یک برنامه هر دو پرونده‌هایش را باز می‌کنند و هر دو منوهایش را نشان می‌دهند.\r\n\r\nاین یکی هم نصب شود؟"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "نصب دیگری از [1] از قبل روی این رایانه هست ([2]). اول آن را حذف کنید (تنظیمات > برنامه‌ها)، بعد این یکی را نصب کنید."

msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] نصب نشد و لغو کردن همه‌چیز را برنداشت. آنچه مانده در زیر آمده است. نصب‌کننده را دوباره اجرا کنید، سپس اگر [1] را نمی‌خواهید آن را حذف کنید.\r\nگزارش: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] ارتقا نیافت و لغو کردن نسخه‌ای را که داشتید برنگرداند. تفاوت‌ها در زیر آمده است. آن را با نصب‌کنندهٔ همان نسخه تعمیر کنید یا نسخهٔ جدید را دوباره نصب کنید.\r\nگزارش: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] حذف نشد و لغو کردن آن را به حال قبل برنگرداند. تفاوت‌ها در زیر آمده است. آن را با نصب‌کننده‌اش تعمیر کنید و سپس دوباره حذف کنید.\r\nگزارش: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] تعمیر نشد و لغو کردن آن را به حال قبل برنگرداند. تفاوت‌ها در زیر آمده است. برای تعمیر، نصب‌کننده را دوباره اجرا کنید.\r\nگزارش: [2]"
