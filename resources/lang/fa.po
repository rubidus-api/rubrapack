msgstr "آرگومان {1} UTF-8 معتبر نیست (بایت {2})"

msgid "argument %d is not valid Unicode (UTF-16 unit %zu)"
msgstr "آرگومان {1} یونیکد معتبر نیست (واحد UTF-16 {2})"

msgid "array is not closed"
msgstr "آرایه بسته نشده است"

msgid "arrays inside arrays are not supported"
msgstr "آرایه‌های درون آرایه پشتیبانی نمی‌شوند"

