msgstr "[dialog-control.{1}] cần 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] có {2} điều khiển; tối đa 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] không có [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] được đặt sau chính nó thông qua các hộp thoại khác"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] cần ui = \"minimal\", \"installdir\" hoặc \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' là tên của Windows; hãy đặt ID khác cho dir"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard cần DLL trợ giúp của rubrapack, mà mô-đun hợp nhất không mang theo"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] cần một tính năng"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX đặt mọi biến của nó (when); hãy dùng msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: giá trị của nó nêu một nơi mà MSIX không thể cung cấp (thư mục ngoài gói không phải thư mục Windows, hoặc phần xác định lúc cài đặt); hãy dùng msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] đã ở trong thư mục chương trình của nó; isolate-for dành cho DLL dùng chung cài ở nơi khác"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] nằm trong hồ sơ người dùng và có component-guid: đường dẫn khóa vẫn là tệp, trong khi quy tắc của Windows muốn một giá trị HKCU ở đó (ICE38); bỏ component-guid để có giá trị đó"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer nạp trình xử lý {2} từ DLL; [com.{3}] là chương trình"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows chỉ đọc trình xử lý thuộc tính theo máy; gói cần scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: trình xử lý xem trước chạy trong prevhost của Windows; bỏ app-id và surrogate khỏi [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX chỉ mang trình xử lý hình thu nhỏ và xem trước (trình xử lý thuộc tính đóng gói không đưa giá trị nào cho Explorer); msi-only = true giữ nó cho MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: loại tệp MSIX thuộc về một ứng dụng; hãy thêm [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: lớp {2} không phải [com.*] của gói này (DLL của trình xử lý phục vụ nó)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: trong MSIX các trình xử lý dùng chung mọi loại hoặc không loại nào (một loại nằm trong một liên kết loại tệp)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: trong MSIX lớp của nó chạy trong surrogate; threading = \"sta\" trong [com.{2}] cho cửa sổ của nó vòng lặp thông điệp (với threading = {3} bản xem trước có thể để trống)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: trong MSIX mọi loại của nó nằm trong một loại tệp [assoc], hoặc không có"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: lớp của nó là msi-only ([com.{2}]); MSIX sẽ không có máy chủ cho nó"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types là danh sách loại tệp, như [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] đi vào {2}; hoặc msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] cần 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] cần một tính năng: đặt 'feature' ở đây hoặc trên dir của nó"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX ghi mọi mục INI của nó (when); hãy dùng msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: giá trị của nó có phần Windows Installer điền lúc cài đặt ([...]); MSIX ghi tệp khi được tạo"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] cần 'on': nơi mục hiển thị, như [\".txt\"] hoặc \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] cần 'target' (chương trình nó khởi chạy), hoặc các mục có parent = \"{2}\" (menu con)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] cần 'target': chương trình mà mục khởi chạy"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: menu của Windows 11 chỉ nhận ID gồm chữ cái và chữ số (không có '_'): hãy đổi tên, hoặc đặt windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: menu con không khởi chạy gì: bỏ 'args' đi"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: mục của menu con hiển thị ở nơi menu con của nó hiển thị: bỏ 'on' đi"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args có phần Windows Installer điền lúc cài đặt ([...]); MSIX chỉ chứa văn bản cố định"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when là \"HKCU\\\\key\\\\value\" hoặc \"HKLM\\\\...\", trên một mục của menu Windows 11 không nằm trong menu con"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when chỉ một giá trị chính gói này ghi ([registry.{2}]): mục sẽ không bao giờ hiện"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: chương trình của nó không có trong MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: các giá trị của nó không thể đưa vào registry của gói"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list có phần Windows Installer điền lúc cài đặt ([...]); MSIX chỉ chứa văn bản cố định"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list thay cho {2} khi các đường dẫn không vừa một dòng lệnh: cần multi = \"one\", {3} trong args và {4} (tệp danh sách) trong list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": không có [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on là một loại tệp hoặc danh sách loại tệp, như [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' không phải [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' phải là menu con: một [menu.*] không có target và không có parent riêng"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] đi vào {2}; hoặc msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] cần một tính năng: đặt 'feature' ở đây hoặc trên dir của nó"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; hoặc msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] cần feature (hoặc with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature đi với thành phần riêng, không phải với with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name nêu một tệp; name có ký tự đại diện"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: đích chia sẻ cần types, formats hoặc cả hai"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: trình xử lý tự động phát cần content-events, device-events hoặc cả hai"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args phải là văn bản thuần (không có [...] điền lúc cài đặt)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events cần class (lớp COM IHWEventHandler của chương trình)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file phải là {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file phải nêu một tệp có trong gói"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file phải nêu một chương trình có trong gói"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types là danh sách loại tệp, như [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows chỉ nhận chữ cái và chữ số"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: tệp '{2}' không phải là DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] nêu trình điều khiển của nó một lần: driver (một [odbc-driver]) hoặc driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] với driver-name cần with = \"file:<ID>\": thành phần mà nó được cài cùng"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: gói theo máy đăng ký nguồn dữ liệu cho máy"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] chỉ một bản: msix (kèm publisher) hoặc upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix là tên định danh của gói (3 đến 50 chữ cái, chữ số, '.' hoặc '-') và cần publisher (\"CN=...\"), đúng như trong tệp kê khai"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: bước kiểm tra trước tìm bản kia: cần preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code là của chính gói này (đó là nâng cấp, không phải bản khác)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] cần dir của nó có một tính năng"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args cho MSIX phải là văn bản thuần (không có [...] điền lúc cài đặt)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: trong MSIX một lược đồ mở một ứng dụng: target phải là tệp thực thi của [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] cần 'value' (hoặc remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR không vươn ra ngoài MSIX; hãy dùng [assoc.*], [protocol.*], [com.*] hoặc [handler.*], hoặc msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: giá trị qword cần DLL trợ giúp của rubrapack, mà mô-đun hợp nhất không mang theo"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX chỉ mang giá trị dưới {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX không xóa giá trị cũng không để lại chúng (remove, keep); hãy dùng msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX ghi mọi giá trị của nó (when); hãy dùng msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: giá trị của nó có phần Windows Installer điền lúc cài đặt ([...]); MSIX chỉ chứa giá trị cố định"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" cần DLL trợ giúp của rubrapack, mà mô-đun hợp nhất không mang theo"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: tên khóa hoặc giá trị không thể đưa vào hive registry"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" dành cho root = \"HKCU\" với on = \"uninstall\", trong gói cho cả máy"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] cần một tính năng: đặt 'feature' ở đây hoặc trên dir của nó"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true không dành cho thư mục dưới {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true cần DLL trợ giúp của rubrapack, mà mô-đun hợp nhất không mang theo"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" dành cho recursive = true trên thư mục trong AppData hoặc LocalAppData, trong gói cho cả máy"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args cho MSIX phải là văn bản thuần (không có [...] điền lúc cài đặt)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file phải nêu một chương trình có trong gói"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] quảng bá tính năng '{2}', vốn có advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise không kết hợp với when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX chỉ có lối tắt trên màn hình nền và trong menu Start{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: lối tắt MSIX không có working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: lối tắt MSIX luôn có (when dành cho MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: lối tắt MSIX hiển thị logo của ứng dụng; icon dành cho MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: lối tắt được quảng bá là dành cho MSI (MSIX cài đặt toàn bộ gói)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: lối tắt được quảng bá cần một biểu tượng"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args cho MSIX phải là văn bản thuần (không có [...] điền lúc cài đặt)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: trong MSIX lối tắt khởi chạy một ứng dụng: target phải là tệp thực thi của [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: mục menu Start của MSIX là ứng dụng của nó, vốn không nhận args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: không có văn bản hộp thoại nào có ID này"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded là dành cho MSI; MSIX không có giao diện trình cài đặt riêng"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] cần ui = \"basic\" hoặc một bộ hộp thoại khác trong [package] (hoặc embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "Chuỗi thoát \\{1} không phải giá trị vô hướng Unicode"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: gói này sẽ không nâng cấp gói trước một cách gọn gàng"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` của gói: hộp thoại, trang mã, chuẩn hóa văn bản"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` của gói hoặc bó MSIX"

msgid "a %s control has no property"
msgstr "điều khiển {1} không có property"

msgid "a %s control has no text; put a text control beside it"
msgstr "điều khiển {1} không có văn bản; hãy đặt một điều khiển văn bản cạnh nó"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "điều khiển {1} cần [property.{2}] với một trong các giá trị của nó làm mặc định (cài đặt im lặng dùng nó)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "gói {1} không ghi được HKLM; hãy dùng HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "đầu ra .msix cần bảng [msix-app.ID] nêu tệp thực thi"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "đầu ra .msix cần bảng [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "đầu ra .msm là mô-đun hợp nhất, tạo từ nguồn có [module] thay vì [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "tệp .txt, .md hoặc .rtf, hoặc - nếu không có"

msgid "a PE file without a certificate table entry"
msgstr "tệp PE không có mục bảng chứng chỉ"

