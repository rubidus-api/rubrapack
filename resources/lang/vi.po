msgstr "types: mỗi mục là \".ext\" hoặc \"*\" (mọi tệp)"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: mỗi mục là '.' và chữ thường, chữ số, '_' hoặc '-' (nhận được '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" cho người dùng chọn thư mục của dir '{2}', vốn không tồn tại (đặt [ui] install-dir)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\" cần bảng [feature.*] để chọn"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui phải là none, basic, minimal, installdir hoặc features (nhận được '{1}')"

msgid "unexpected text after the value"
msgstr "văn bản không mong đợi sau giá trị"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "lệnh không xác định '{1}' (xem 'rubrapack help')"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "chuỗi thoát không xác định \\{1} (dùng '...' cho văn bản có dấu gạch chéo ngược)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "tùy chọn inspect không xác định (dùng tên bảng, --summary, --files hoặc --streams)"

msgid "unknown key '%s' in [%s%s%s]"
msgstr "khóa không xác định '{1}' trong [{2}{3}{4}]"

msgid "unknown key '%s' in [%s%s%s] (did you mean '%s'?)"
msgstr "khóa không xác định '{1}' trong [{2}{3}{4}] (ý bạn là '{5}'?)"

msgid "unknown or incomplete %s option '%s'"
msgstr "tùy chọn {1} '{2}' không xác định hoặc chưa đầy đủ"

msgid "unknown table [%s%s%s]"
msgstr "bảng không xác định [{1}{2}{3}]"

msgid "unknown table [%s%s%s] (did you mean [%s]?)"
msgstr "bảng không xác định [{1}{2}{3}] (ý bạn là [{4}]?)"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "giải nén gói vào một thư mục mới, sắp xếp như khi cài đặt"

msgid "unsupported - %s"
msgstr "không được hỗ trợ - {1}"

msgid "untrusted"
msgstr "không đáng tin cậy"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "các khóa update-* cần appinstaller-uri và package-uri"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false dành cho on = \"uninstall\" hoặc \"both\" (cài đặt không bao giờ là việc gỡ trong nâng cấp)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code phải là GUID như {{12345678-1234-1234-1234-123456789ABC}"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "cách dùng: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (a list for a bundle)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"
msgstr "cách dùng: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (danh sách cho bó)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"

msgid "usage: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"
msgstr "cách dùng: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"

msgid "usage: rubrapack explain [RPnnnn]"
msgstr "cách dùng: rubrapack explain [RPnnnn]"

msgid "usage: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"
msgstr "cách dùng: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"

msgid "usage: rubrapack guid [--from <text>]"
msgstr "cách dùng: rubrapack guid [--from <text>]"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "cách dùng: rubrapack inspect <file.cab> (không có bảng hay tùy chọn)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "cách dùng: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "cách dùng: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "cách dùng: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "cách dùng: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "cách dùng: rubrapack inspect <setup.exe> (không có bảng hay tùy chọn)"

msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "cách dùng: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "cách dùng: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "cách dùng: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "usage: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"
msgstr "cách dùng: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"

msgid "usage: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (a fixed starter <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk names are taken too"
msgstr "cách dùng: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (tệp khởi đầu cố định <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; tên .rpk cũng được chấp nhận"

msgid "usage: rubrapack schema (the JSON Schema of sources, on stdout)"
msgstr "cách dùng: rubrapack schema (JSON Schema của nguồn, ra stdout)"

msgid "usage: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"
msgstr "cách dùng: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"

msgid "usage: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."
msgstr "cách dùng: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."

msgid "use '/' in path"
msgstr "dùng '/' trong đường dẫn"

msgid "use a full rubrapack build or another way"
msgstr "dùng bản dựng đầy đủ của rubrapack hoặc cách khác"

msgid "used by more than one component"
msgstr "được nhiều hơn một thành phần sử dụng"

msgid "users must be \"all\" (got '%s')"
msgstr "users phải là \"all\" (nhận được '{1}')"

msgid "value '%s' is listed twice"
msgstr "giá trị '{1}' được liệt kê hai lần"

msgid "value missing"
msgstr "thiếu giá trị"

msgid "values and labels are strings"
msgstr "values và labels là chuỗi"

msgid "values is an array of 1 to 32 strings"
msgstr "values là mảng từ 1 đến 32 chuỗi"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "giá trị: ID, GUID, phiên bản, số ngoài phạm vi, tham chiếu tới thứ không tồn tại"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "biến '{1}' chưa được định nghĩa ([define] hoặc -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "tên biến '{1}' không được chứa '=' hay bắt đầu bằng = + - ! *"

msgid "variables"
msgstr "biến"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "biến: $(NAME) không có giá trị, $( chưa đóng, tên Windows hoặc dir ID ở nơi không thể đặt"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "phiên bản '{1}' phải là a.b.c hoặc a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "phiên bản '{1}' phải là a.b.c hoặc a.b.c.d với a, b <= 255 và c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" không thể đi 'with' tệp của gói 64 bit"

msgid "view must be \"32\" or \"64\""
msgstr "view phải là \"32\" hoặc \"64\""

msgid "warning"
msgstr "cảnh báo"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "ý nghĩa của một mã chẩn đoán, các thông báo mang nó, cần làm gì và sách hướng dẫn nói thêm ở đâu"

msgid "with must be \"file:<ID>\""
msgstr "with phải là \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: tệp '{1}' không phải [file.*] của gói này"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "không có --pkcs11, `keys list` hiển thị kho chứng chỉ Windows"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' không phải dir ID"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "ghi bản vá (.msp): các tệp và hàng cập nhật bản gốc đã cài lên bản đích"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "ghi tệp nguồn (.toml; cả tên .rpk): từ câu trả lời, được hỏi hoặc đưa qua tùy chọn, một tệp khởi đầu cố định, hoặc một MSI có sẵn"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "ghi transform (.mst): thứ biến gói này thành gói kia"

msgid "write the table or value the plain way the manual shows"
msgstr "viết bảng hoặc giá trị theo cách đơn giản mà sách hướng dẫn chỉ ra"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "viết giá trị không có '[~]'; mode = \"append\" hoặc \"prepend\" sẽ thêm nó"

