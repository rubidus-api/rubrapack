msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] mục trong các thư mục của [3] không được cài cùng nó:\r\n[2]\r\nXóa cả chúng?\r\n\r\nCó: xóa chúng cùng [3] (không thể khôi phục).\r\nKhông: gỡ [3] và giữ chúng lại.\r\nHủy bỏ: dừng."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: đã dừng, vì [1] mục trong các thư mục của nó không được cài cùng nó:\r\n[2]Hãy dùng RPEXTRA=delete (xóa cả chúng) hoặc RPEXTRA=keep (giữ chúng), rồi gỡ lại."

msgctxt "installer"
