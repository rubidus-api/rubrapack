msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] תוכניות משתמשות בקבצים של [3]:\r\n[2]\r\nלסגור את כולן?\r\n\r\nכן: לסגור את כולן ולהמשיך (עבודה שלא נשמרה עלולה ללכת לאיבוד).\r\nלא: להמשיך בלי לסגור (תוכניות שכבר פתוחות ממשיכות להשתמש בקבצים הישנים עד שייפתחו מחדש).\r\nביטול: לעצור."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: נעצר, כי [1] תוכניות משתמשות בקבצים שלו:\r\n[2]סגור אותן ונסה שוב, או תן RPCLOSE=yes (לסגור את כולן ולהמשיך) או RPCLOSE=no (להמשיך בלי לסגור)."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] פריטים בתיקיות של [3] לא הותקנו איתו:\r\n[2]\r\nלמחוק גם אותם?\r\n\r\nכן: למחוק אותם יחד עם [3] (אי אפשר יהיה לשחזר אותם).\r\nלא: להסיר את [3] ולהשאיר אותם.\r\nביטול: לעצור."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: נעצר, כי [1] פריטים בתיקיות שלו לא הותקנו איתו:\r\n[2]תן RPEXTRA=delete (למחוק גם אותם) או RPEXTRA=keep (להשאיר אותם), ואז הסר שוב."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "ייתכן של-[1] משתמשים אחרים במחשב זה יש הגדרות או נתונים של [3]:\r\n[2]\r\nלמחוק גם את שלהם?\r\n\r\nכן: למחוק אותם לכל משתמש (לא ניתן לשחזר אותם).\r\nלא: למחוק רק את שלך.\r\nביטול: לעצור."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] כבר מותקן במחשב הזה מ-Microsoft Store או כחבילת יישום ([2]). שני עותקים של תוכנית אחת פותחים שניהם את הקבצים שלה ומציגים שניהם את התפריטים שלה.\r\n\r\nלהתקין גם את זה?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] כבר מותקן במחשב הזה מ-Microsoft Store או כחבילת יישום ([2]). הסירו קודם את העותק ההוא (הגדרות > יישומים), ואז התקינו את זה."

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "במחשב הזה כבר יש התקנה אחרת של [1] ([2]). שני עותקים של תוכנית אחת פותחים שניהם את הקבצים שלה ומציגים שניהם את התפריטים שלה.\r\n\r\nלהתקין גם את זה?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "במחשב הזה כבר יש התקנה אחרת של [1] ([2]). הסירו אותה קודם (הגדרות > יישומים), ואז התקינו את זה."

msgctxt "installer"
msgid "ReportInstall"
msgstr "לא ניתן היה להתקין את [1], והביטול לא הסיר הכול. מה שנשאר מפורט למטה. הפעילו שוב את תוכנית ההתקנה, ואז הסירו את [1] אם אינכם רוצים בו.\r\nיומן: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "לא ניתן היה לשדרג את [1], והביטול לא החזיר את הגרסה שהייתה לכם. ההבדלים מפורטים למטה. תקנו אותה בתוכנית ההתקנה של אותה גרסה, או התקינו שוב את הגרסה החדשה.\r\nיומן: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "לא ניתן היה להסיר את [1], והביטול לא החזיר אותו כפי שהיה. ההבדלים מפורטים למטה. תקנו אותו בתוכנית ההתקנה שלו, ואז הסירו אותו שוב.\r\nיומן: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "לא ניתן היה לתקן את [1], והביטול לא החזיר אותו כפי שהיה. ההבדלים מפורטים למטה. הפעילו שוב את תוכנית ההתקנה כדי לתקן אותו.\r\nיומן: [2]"
