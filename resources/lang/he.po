msgstr "refuse-upgrade-below ‏'{1}' חייב להיות גרסה כמו 1.2.3"

msgid "refuse-upgrade-message needs refuse-upgrade-below"
msgstr "refuse-upgrade-message דורש refuse-upgrade-below"

