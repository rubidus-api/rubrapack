msgstr "ארכיטקטורה (x64, x86, arm64)"

msgid "Choose"
msgstr "בחר"

msgid "Command line"
msgstr "שורת הפקודה"

msgid "Command line (lint)"
msgstr "שורת הפקודה (lint)"

msgid "Common AppData"
msgstr "AppData משותף"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId אינו GUID בתבנית הרישום"

