msgstr "אסימון PKCS#11: באסימון אין אישור עם ה-CKA_ID של המפתח (תן אותו עם --cert)"

msgid "Paths"
msgstr "נתיבים"

msgid "Product name"
msgstr "שם המוצר"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode ו-UpgradeCode הם אותו GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion ‏{1} אינו גבוה מהקודם {2} בשלושת השדות הראשונים: Windows Installer לא משדרג"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "התוכנית שקיצורי הדרך פותחים (- ללא קיצורי דרך)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: אין שפה כזו (מובנות: {2}; שפה אחרת צריכה את חבילת השפה שלה, {3}.po)"

msgid "Reference, "
msgstr "עיון, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "הרצף {1} אינו מכוסה בשום שורת Media (האחרון {2})"

msgid "Sequence %ld is used by another file"
msgstr "הרצף {1} בשימוש של קובץ אחר"

