msgstr "הדפסת ה-JSON Schema של מקורות (לעורך שמשלים ובודק מפתחות)"

msgid "print the version"
msgstr "הדפסת הגרסה"

msgid "print this help, or one command's usage"
msgstr "הדפסת עזרה זו, או אופן השימוש בפקודה אחת"

msgid "product-code must be a GUID"
msgstr "product-code חייב להיות GUID"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile חייב להיות \"all\", \"domain\", \"private\" או \"public\" (התקבל '{1}')"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id ‏'{1}' כבר שייך ל-[com.{2}]"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id ‏'{1}' שייך גם ל-[assoc.{2}]: סוג קובץ ומחלקת COM צריכים שני שמות"

