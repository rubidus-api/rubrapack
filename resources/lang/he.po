msgstr "path חייב להתחיל בתיקיית Windows (כמו $(ProgramFiles) או $(System))"

msgid "paths"
msgstr "נתיבים"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "perceived-type חייב להיות \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" או \"application\" (התקבל '{1}')"

