msgstr "on: כל אחד הוא סוג קובץ ('.' ואחריו אותיות קטנות, ספרות, '_' או '-'), \"*\" (כל קובץ), \"folder\", \"background\" (החלק הריק של תיקייה), \"drive\" או \"assoc:<ID>\" (התקבל '{1}')"

msgid "only a bitmap control takes an image"
msgstr "רק פקד bitmap מקבל image"

msgid "only radio, combo and listbox controls take labels"
msgstr "רק פקדי radio, combo ו-listbox מקבלים labels"

msgid "only radio, combo and listbox controls take values"
msgstr "רק פקדי radio, combo ו-listbox מקבלים values"

