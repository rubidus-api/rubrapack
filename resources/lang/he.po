msgstr "הגרסה '{1}' חייבת להיות a.b.c או a.b.c.d עם a, b <= 255 ו-c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" לא יכול ללכת 'with' קובץ של חבילת 64 סיביות"

msgid "view must be \"32\" or \"64\""
msgstr "view חייב להיות \"32\" או \"64\""

msgid "warning"
msgstr "אזהרה"

