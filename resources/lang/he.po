msgstr "הרשאות דורשות scope = \"machine\" (זו {1})"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "phase חייב להיות \"immediate\", \"deferred\", \"commit\" או \"rollback\" (התקבל '{1}')"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "ports חייב להיות פורט או טווח כמו \"8000-8100\" בתוך 1-65535 (התקבל '{1}')"

