msgstr "התוכנית הראשית, עבור קיצורי דרך (- ללא)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "מדריך: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

