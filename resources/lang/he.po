msgstr "prog-id ‏'{1}' נמצא גם ב-[assoc.{2}] עם תיאור, target, icon או args אחרים"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "prog-id חייב להיות אותיות, ספרות, '.', '_' או '-', לא מתחיל בספרה, לכל היותר 39 (התקבל '{1}')"

