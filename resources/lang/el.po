msgid "quoted table names are not supported"
msgstr "ονόματα πινάκων σε εισαγωγικά δεν υποστηρίζονται"

msgid "reboot must be \"suppress\" or \"allow\""
msgstr "το reboot πρέπει να είναι \"suppress\" ή \"allow\""

msgid "recursive = true is for on = \"uninstall\""
msgstr "το recursive = true είναι για on = \"uninstall\""

msgid "recursive = true never runs when an upgrade removes this version; it takes no 'upgrade'"
msgstr "το recursive = true δεν εκτελείται ποτέ όταν μια αναβάθμιση αφαιρεί αυτή την έκδοση· δεν δέχεται 'upgrade'"

