msgstr "Το [{1}{2}{3}] χρειάζεται '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "Το [{1}{2}] δεν μπορεί να μπει σε λειτουργική μονάδα συγχώνευσης· το έχει το πακέτο που τη συγχωνεύει"

