# rubrapack language pack: Greek.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: el\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Ελληνικά\n"
"X-Rubrapack-LangIDs: 1032\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, παράθυρα διαλόγου {6}{7}\n  1 όνομα, κατασκευαστής, έκδοση, αρχιτεκτονική  2 φάκελος εγκατάστασης, για ποιον\n  3 παράθυρα διαλόγου, άδεια, γλώσσες           4 προαιρετικά μέρη\n  5 συντομεύσεις                                6 αρχεία: ταίριασμα με τον φάκελο του προγράμματος\n  7 οποιοδήποτε κλειδί                          v προβολή   l lint   s αποθήκευση   q έξοδος\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nΜηνύματα με αυτόν τον κωδικό (το * αντιστοιχεί σε όνομα ή τιμή):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nΤα αποτελέσματα πηγαίνουν στο stdout, τα διαγνωστικά στο stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nΤι να κάνετε: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  Το {1} δεν υπάρχει πια, αλλά μια συντόμευση το ανοίγει: αλλάξτε πρώτα τις συντομεύσεις (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} αρχεία και {2} φάκελοι εκεί\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s ή q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  προστέθηκαν [dir.{1}] και [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  προστέθηκε [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  δώστε το ως table.key, π.χ. package.version ή dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: κανένα πρόβλημα\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: δείτε τα προβλήματα παραπάνω (το αρχείο που αναφέρεται εκεί είναι αντίγραφο ελέγχου)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  οι άλλες γλώσσες στο [ui] languages διατηρούνται· αλλάξτε αυτή τη λίστα με το 7 (οποιοδήποτε κλειδί)\n"

msgid "  removed [file.%s]\n"
msgstr "  αφαιρέθηκε [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  αφαιρέθηκε [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  υποφάκελοι:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  αυτό δεν χωράει στο υποσύνολο TOML· δεν άλλαξε τίποτα\n"

msgid "  that was not readable text; again, please\n"
msgstr "  αυτό δεν ήταν αναγνώσιμο κείμενο· ξανά, παρακαλώ\n"

msgid "  the program folder '%s': %s\n"
msgstr "  ο φάκελος του προγράμματος '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  η πηγή δεν έχει πίνακες [file] στους οποίους να δείχνει μια συντόμευση\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  η πηγή δεν έχει υποφακέλους όπως τους γράφει το `new` ([files] \"<folder>/<name>/**\")· προσθέστε τους με το 6\n"

msgid "  too long; again, please\n"
msgstr "  πολύ μεγάλο· ξανά, παρακαλώ\n"

msgid "  y or n\n"
msgstr "  y ή n\n"

msgid " (changed)"
msgstr " (άλλαξε)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - δημιουργία πακέτων Windows Installer (.msi) και MSIX (.msix)\n\nχρήση: rubrapack [--lang <code>] <command> [arguments]\n\nεντολές:\n"

msgid " and its dir"
msgstr " και το dir του"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "Το $({1}) δεν έχει μεταβλητή περιβάλλοντος, οπότε μια επεκτάσιμη τιμή δεν μπορεί να το περιέχει· χρησιμοποιήστε τιμή συμβολοσειράς (συμπληρώνεται κατά την εγκατάσταση)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "Το $({1}) είναι {2}: μπορεί να ξεκινά μια διαδρομή ή να αντικαθιστά μια τιμή που συμπληρώνει το Windows Installer (μητρώο, περιβάλλον, INI, ορίσματα, μηνύματα), όχι εδώ"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "Το $({1}) δεν είναι φάκελος από τον οποίο μπορεί να ξεκινά μια διαδρομή (ένα dir ID, ή ProgramFiles, LOCALAPPDATA, ProgramData ... - δείτε Paths στο εγχειρίδιο){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  δομή:         {2}\n  σύνοψη:       {3}\n  υπογραφή:     {4}\n  αλυσίδα:      {5}{6}{7}\n  ανάκληση:     δεν ελέγχθηκε\n  χρονοσφραγίδα: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: η μεταβλητή δεν έχει οριστεί"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "Το {1} '{2}' δεν είναι στοιχείο ελέγχου αυτού του παραθύρου διαλόγου"

msgid "%s '%.*s' is not in %s"
msgstr "Το {1} '{2}' δεν είναι στο {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': το κείμενο άδειας χρειάζεται το αγγλικό όνομα της γραμματοσειράς, γι' αυτό εμφανίζεται με τη γραμματοσειρά της γλώσσας· γράψτε το αγγλικό όνομα (π.χ. \"Malgun Gothic\") για να χρησιμοποιηθεί και εκεί αυτή η γραμματοσειρά"

msgid "%s component, but the package platform is %.*s"
msgstr "στοιχείο {1}, αλλά η πλατφόρμα του πακέτου είναι {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "Το {1} δεν ανήκει στο kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "Το {1} δεν ανήκει στο kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "Το {1} περιέχει LANGID (1..65535), π.χ. 1041"

msgid "%s holds strings"
msgstr "Το {1} περιέχει συμβολοσειρές"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "το {1} είναι μια λίστα κειμένων \"Κλειδί=Τιμή\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "το {1} είναι λίστα κειμένων, όπως [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "Το {1} είναι όνομα γραμματοσειράς 1 έως 31 χαρακτήρων, π.χ. \"Segoe UI\" (δόθηκε {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "Το {1} είναι συνθήκη MSI με κλειστά εισαγωγικά και ισορροπημένες παρενθέσεις"

msgid "%s is an array of strings, one per value"
msgstr "Το {1} είναι πίνακας συμβολοσειρών, μία ανά τιμή"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "Το {1} αφορά πακέτα MSI: ένα MSIX δεν αφαιρείται από το msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "Το {1} δεν υπάρχει πια. Να αφαιρεθεί το [file.{2}];"

msgid "%s is longer than 240 characters"
msgstr "Το {1} είναι μεγαλύτερο από 240 χαρακτήρες"

msgid "%s is new. Add it?"
msgstr "Το {1} είναι νέο. Να προστεθεί;"

msgid "%s is not a GUID in registry format"
msgstr "Το {1} δεν είναι GUID σε μορφή μητρώου"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "Το {1} δεν είναι κωδικός που χρησιμοποιεί αυτό το rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "Το {1} πρέπει να είναι \"file:<ID>\" που ονομάζει ένα [file.*] αυτού του πακέτου"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "το {1} πρέπει να έχει {2} έως {3} γράμματα, ψηφία, '.' ή '-' και να μην αρχίζει με '.' (δόθηκε '{4}')"

msgid "%s must be a GUID"
msgstr "Το {1} πρέπει να είναι GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "Το {1} πρέπει να είναι GUID όπως {{12345678-...} (δόθηκε '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "Το {1} πρέπει να είναι διεύθυνση https://, http:// ή file://, ή διαδρομή \\\\server\\share (δόθηκε '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "Το {1} πρέπει να διαφέρει από το upgrade-code (μία οικογένεια αναβάθμισης ανά αρχιτεκτονική)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "Το {1} χρειάζεται Windows build {2} ή νεότερο: ορίστε [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "Το {1} χρειάζεται το resources/bin/rubrapack_ca-{2}.dll, χωρίς το οποίο δημιουργήθηκε αυτό το rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA δεν ελέγχθηκε (δώστε --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA αξιόπιστο"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA μη αξιόπιστο - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "Το {1}/{2} δεν υπάρχει πια ή είναι κενό. Να αφαιρεθούν τα [files.{3}] και [dir.{4}];"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "Το {1}/{2}/ είναι νέος φάκελος. Να προστεθεί;"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: σφάλματα: {2}{-3}, προειδοποιήσεις: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: σφάλματα: {2}{-3}, προειδοποιήσεις: {4}{-5} (έναντι {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} αρχεία, {3} byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} αρχεία, {3} σφάλματα, 0 προειδοποιήσεις\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} ακόμη διαγνωστικά δεν εμφανίζονται\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: το '{2}' δεν είναι τυπική ενέργεια που τοποθετεί το rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: το αρχείο '{2}' δεν είναι [file.*] αυτού του πακέτου"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: το αρχείο '{2}' δεν είναι πρόγραμμα (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "Το '$(' δεν κλείνει (γράψτε '$$(' για το κείμενο '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "Το '{1}' υπάρχει ήδη· μένει ως έχει"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "Το '{1}' υπάρχει ήδη· αφαιρέστε το ή δημιουργήστε σε άλλο φάκελο"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "Το '{1}' έχει ήδη χειριστή {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "Το '{1}' έχει ήδη δικαιώματα"

msgid "'%s' and '%s' are the same path in the package"
msgstr "Τα '{1}' και '{2}' είναι η ίδια διαδρομή στο πακέτο"

msgid "'%s' belongs to Windows or the browsers"
msgstr "Το '{1}' ανήκει στα Windows ή στα προγράμματα περιήγησης"

msgid "'%s' cannot be read against '%s': %s"
msgstr "Το '{1}' δεν μπορεί να διαβαστεί έναντι του '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "Το '{1}' δεν χωράει στο υποσύνολο TOML· δεν αποθηκεύτηκε τίποτα"

msgid "'%s' exists already"
msgstr "Το '{1}' υπάρχει ήδη"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "Το '{1}' υπάρχει ήδη· αλλάξτε το με `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "Το '{1}' υπάρχει και δεν είναι κενός κατάλογος· κάντε εξαγωγή σε νέο"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "Το '{1}' πηγαίνει στο {2}· ή msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "Το '{1}' έχει μη αναγνώσιμη ροή πληροφοριών σύνοψης"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "Το '{1}' δεν έχει πίνακες Directory, Component, File και Media για εξαγωγή"

msgid "'%s' has no embedded transform '%s'"
msgstr "το '{1}' δεν έχει ενσωματωμένο μετασχηματισμό '{2}'"

msgid "'%s' has no readable summary information"
msgstr "Το '{1}' δεν έχει αναγνώσιμες πληροφορίες σύνοψης"

msgid "'%s' has no transform '%.*s'"
msgstr "Το '{1}' δεν έχει μετασχηματισμό '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "Το '{1}' είναι UTF-16: το edit αλλάζει μόνο πηγές UTF-8 (αποθηκεύστε το πρώτα ως UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "Το '{1}' είναι όνομα των Windows· δώστε άλλο όνομα στη μεταβλητή"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "Το '{1}' είναι [chain]: δημιουργεί πρόγραμμα εγκατάστασης, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "Το '{1}' είναι στοιχείο ελέγχου του ενσωματωμένου πλαισίου· επιλέξτε άλλο ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "Το '{1}' είναι φάκελος του υπολογιστή· ένα πακέτο {2} δεν μπορεί να γράψει εκεί"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "Το '{1}' είναι λειτουργική μονάδα συγχώνευσης: συγχωνεύστε το με [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "Το '{1}' είναι όνομα που κρατά για τον εαυτό της η μορφή MSIX"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "Το '{1}' είναι συμβολικός σύνδεσμος· οι σύνδεσμοι δεν ακολουθούνται"

msgid "'%s' is also a [property.*]"
msgstr "Το '{1}' είναι επίσης [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "Το '{1}' είναι επίσης dir ID· δώστε άλλο όνομα στη μεταβλητή"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "Το '{1}' είναι για μηχάνημα 0x{2}, όχι για την αρχιτεκτονική αυτού του πακέτου· ορίστε any-arch = true αν είναι σκόπιμο"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "Το '{1}' δεν είναι ούτε αρχείο PE (.exe, .dll), ούτε πακέτο MSI, ούτε πακέτο ή δέσμη MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "Το '{1}' δεν είναι ούτε αρχείο PE, ούτε πακέτο MSI, ούτε πακέτο ή δέσμη MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "Το '{1}' δεν είναι ούτε γνωστός φάκελος ούτε dir ID (γνωστοί φάκελοι: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "Το '{1}' δεν είναι cabinet που μπορεί να διαβάσει το rubrapack (stored ή MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "Το '{1}' δεν είναι διαγνωστικός κωδικός (RP και τέσσερα ψηφία, π.χ. RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "Το '{1}' δεν είναι πρόγραμμα (.exe)"

msgid "'%s' is not a regular file"
msgstr "Το '{1}' δεν είναι κανονικό αρχείο"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "Το '{1}' δεν είναι πρόγραμμα εγκατάστασης του rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "Το '{1}' δεν είναι έγκυρο ID (γράμματα, ψηφία και '_', όχι ψηφίο στην αρχή, το πολύ {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "Το '{1}' δεν είναι έγκυρη βάση δεδομένων MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "Το '{1}' δεν είναι έγκυρο πακέτο MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "Το '{1}' δεν είναι έγκυρο πακέτο: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "Το '{1}' δεν είναι έγκυρη πηγή (το υποσύνολο TOML)· διορθώστε το πρώτα με το χέρι"

msgid "'%s' is not a valid transform: %s"
msgstr "Το '{1}' δεν είναι έγκυρος μετασχηματισμός: {2}"

msgid "'%s' is not a valid variable name"
msgstr "Το '{1}' δεν είναι έγκυρο όνομα μεταβλητής"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "Το '{1}' είναι δεσμευμένο και δεν μπορεί να χρησιμοποιηθεί ως ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "Το '{1}' είναι το όνομα ενός dir: μόνο αναζήτηση μητρώου ή dir μπορεί να συμπληρώσει ένα dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "Το '{1}' μοιάζει με αρχείο προγράμματος (PE) αλλά οι κεφαλίδες ή οι πόροι του είναι κατεστραμμένοι"

msgid "'%s' must be a string"
msgstr "Το '{1}' πρέπει να είναι συμβολοσειρά"

msgid "'%s' must be an integer"
msgstr "Το '{1}' πρέπει να είναι ακέραιος"

msgid "'%s' must be between %lld and %lld"
msgstr "Το '{1}' πρέπει να είναι μεταξύ {2} και {3}"

msgid "'%s' must be true or false"
msgstr "Το '{1}' πρέπει να είναι true ή false"

msgid "'%s' must not be empty"
msgstr "Το '{1}' δεν πρέπει να είναι κενό"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "Το '{1}' δεν ονομάζει μετασχηματισμούς (ιδιότητα σύνοψης 8): δεν είναι ενημέρωση κώδικα"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "Το '{1}' ξεκινά με φάκελο: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': το {2} '{3}' έχει {4}· δεν έγινε εξαγωγή"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} καταχωρίσεις, περισσότερες από το όριο {3} (--limit-entries)· δεν έγινε εξαγωγή"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
