msgstr "'{1}': ο μετασχηματισμός '{2}' δεν μπορεί να διαβαστεί έναντι του '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "Το '-{1}' είναι η γλώσσα του ίδιου του πακέτου ({2})· δώστε αυτό το κείμενο χωρίς την κατάληξη"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
