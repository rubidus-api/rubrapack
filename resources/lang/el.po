msgstr "χρήση: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "χρήση: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

