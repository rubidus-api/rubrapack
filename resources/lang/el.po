msgid "is '.' or '..'"
msgstr "είναι '.' ή '..'"

msgid "is a reserved device name"
msgstr "είναι δεσμευμένο όνομα συσκευής"

msgid "is empty"
msgstr "είναι κενό"

msgid "is longer than 255 UTF-16 units"
msgstr "είναι μεγαλύτερο από 255 μονάδες UTF-16"

msgid "is not a Windows Installer database"
msgstr "δεν είναι βάση δεδομένων του Windows Installer"

msgid "is not a compound file"
msgstr "δεν είναι σύνθετο αρχείο"

msgid "is not valid UTF-8"
msgstr "δεν είναι έγκυρο UTF-8"

msgid "isolate-for: '%s' is not a program (.exe)"
msgstr "isolate-for: το '{1}' δεν είναι πρόγραμμα (.exe)"

msgid "keep the upgrade code, raise the version, keep component codes of files that stay"
msgstr "κρατήστε τον κωδικό αναβάθμισης, αυξήστε την έκδοση, κρατήστε τους κωδικούς στοιχείων των αρχείων που μένουν"

msgid "key '%.*s' is set twice in this table (first at line %u)"
msgstr "το κλειδί '{1}' ορίζεται δύο φορές σε αυτόν τον πίνακα (πρώτα στη γραμμή {2})"

msgid "key '%s' must not start or end with '\\' or contain an empty part"
msgstr "το κλειδί '{1}' δεν πρέπει να αρχίζει ή να τελειώνει με '\\' ή να περιέχει κενό μέρος"

msgid "key '%s' outside a table; only 'format' comes before the first table"
msgstr "το κλειδί '{1}' είναι εκτός πίνακα· μόνο το 'format' έρχεται πριν από τον πρώτο πίνακα"

msgid "key file '%s': %s"
msgstr "αρχείο κλειδιού '{1}': {2}"

msgid "kind must be \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" or \"autoplay\" (got '%s')"
msgstr "το kind πρέπει να είναι \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" ή \"autoplay\" (δόθηκε '{1}')"

msgid "kind must be \"preview\", \"thumbnail\" or \"property\" (got '%s')"
msgstr "το kind πρέπει να είναι \"preview\", \"thumbnail\" ή \"property\" (δόθηκε '{1}')"

msgid "kind must be registry, file, dir or component"
msgstr "το kind πρέπει να είναι registry, file, dir ή component"

msgid "labels is an array of strings, one per value"
msgstr "το labels είναι πίνακας συμβολοσειρών, μία ανά τιμή"

msgid "language '%s' has no language pack (lang/%s.po beside the source, or RUBRAPACK_LANG_DIR)"
msgstr "η γλώσσα '{1}' δεν έχει πακέτο γλώσσας (lang/{2}.po δίπλα στην πηγή, ή RUBRAPACK_LANG_DIR)"

msgid "language '%s' is listed twice"
msgstr "η γλώσσα '{1}' αναφέρεται δύο φορές"

msgid "language '%s' is not in [ui] languages"
msgstr "η γλώσσα '{1}' δεν είναι στο [ui] languages"

msgid "language '%s' lacks %zu text(s), the first is %s: add them to its language pack (lang/%s.po) or give [ui-text.ID] text-%s"
msgstr "στη γλώσσα '{1}' λείπουν {2} κείμενα, το πρώτο είναι {3}: προσθέστε τα στο πακέτο γλώσσας της (lang/{4}.po) ή δώστε [ui-text.ID] text-{5}"

msgid "language '%s' needs [ui] langid-%s (its LANGIDs, for the automatic choice)"
msgstr "η γλώσσα '{1}' χρειάζεται [ui] langid-{2} (τα LANGID της, για την αυτόματη επιλογή)"

msgid "language '%s' needs [ui] name-%s (its name on the language page)"
msgstr "η γλώσσα '{1}' χρειάζεται [ui] name-{2} (το όνομά της στη σελίδα γλώσσας)"

msgid "language = \"ko-KR\" no longer makes the dialogs Korean: they are English unless [ui] languages = [\"ko\"] adds Korean"
msgstr "το language = \"ko-KR\" δεν κάνει πια κορεατικά τα παράθυρα διαλόγου: είναι αγγλικά εκτός αν το [ui] languages = [\"ko\"] προσθέσει κορεατικά"

msgid "language must be \"ko-KR\" or \"en-US\""
msgstr "το language πρέπει να είναι \"ko-KR\" ή \"en-US\""

msgid "language must be \"neutral\", \"en-US\" or \"ko-KR\""
msgstr "το language πρέπει να είναι \"neutral\", \"en-US\" ή \"ko-KR\""

msgid "languages = \"all\" stands alone, not in an array: it takes every built-in language"
msgstr "Το languages = \"all\" γράφεται μόνο του, όχι μέσα σε πίνακα: περιλαμβάνει όλες τις ενσωματωμένες γλώσσες"

msgid "languages holds codes like \"ko\" or \"zh_TW\" (2 or 3 lower-case letters, and _ and a region's two capitals) (got '%s')"
msgstr "το languages περιέχει κωδικούς όπως \"ko\" ή \"zh_TW\" (2 ή 3 πεζά γράμματα, και _ και δύο κεφαλαία μιας περιοχής) (δόθηκε '{1}')"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "το languages είναι πίνακας κωδικών γλώσσας, π.χ. [\"ko\"]"

msgid "languages needs a dialog set (ui = \"basic\" or another)"
msgstr "το languages χρειάζεται σύνολο παραθύρων διαλόγου (ui = \"basic\" ή άλλο)"

msgid "launch must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "το launch πρέπει να είναι \"file:<ID>\" που ονομάζει ένα [file.*] αυτού του πακέτου"

msgid "launch-args needs launch"
msgstr "το launch-args χρειάζεται launch"

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "το license πρέπει να είναι αρχείο .txt, .md (εμφανίζεται ως απλό κείμενο) ή .rtf"

msgid "lint: %s row %s: column %s is not in NFC (%zu row%s); build --nfc puts folder, file and shortcut names in NFC"
msgstr "lint: {1} γραμμή {2}: η στήλη {3} δεν είναι σε NFC ({4} γραμμές{-5})· το build --nfc βάζει σε NFC τα ονόματα φακέλων, αρχείων και συντομεύσεων"

msgid "lint: %s%s"
msgstr "lint: {1}{2}"

msgid "lint: code page %u, not 65001: text is not checked as UTF-8, widths only for ASCII"
msgstr "lint: κωδικοσελίδα {1}, όχι 65001: το κείμενο δεν ελέγχεται ως UTF-8, πλάτη μόνο για ASCII"

msgid "lint: no problems\n"
msgstr "lint: κανένα πρόβλημα\n"

msgid "lint: see the problems above\n"
msgstr "lint: δείτε τα προβλήματα παραπάνω\n"

msgid "list the keys a token or the Windows certificate store can sign with"
msgstr "λίστα των κλειδιών με τα οποία μπορεί να υπογράψει ένα διακριτικό ή ο χώρος πιστοποιητικών των Windows"

msgid "logo '%s' and its .scale-100 variant are both there: keep one"
msgstr "το λογότυπο '{1}' και η παραλλαγή του .scale-100 υπάρχουν και τα δύο: κρατήστε ένα"

msgid "logo '%s' at scale %s is %ux%u pixels; it must be %ux%u"
msgstr "το λογότυπο '{1}' στην κλίμακα {2} είναι {3}x{4} pixel· πρέπει να είναι {5}x{6}"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "το λογότυπο '{1}' στην κλίμακα {2} δεν είναι αρχείο PNG"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "το λογότυπο '{1}' είναι {2}x{3} pixel· πρέπει να είναι {4}x{5}"

msgid "logo '%s' is not a PNG file"
msgstr "το λογότυπο '{1}' δεν είναι αρχείο PNG"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "το λογότυπο '{1}' δεν βρέθηκε (ούτε ως παραλλαγές .scale-100 ... .scale-400)"

msgid "logo '%s': a logo with scale variants needs an ASCII file name with an extension"
msgstr "λογότυπο '{1}': ένα λογότυπο με παραλλαγές κλίμακας χρειάζεται όνομα αρχείου ASCII με επέκταση"

msgid "logo must be a .png of 8-bit RGB or RGBA, not interlaced, at most 1024 pixels a side"
msgstr "το logo πρέπει να είναι .png 8-bit RGB ή RGBA, χωρίς πλέξη, έως 1024 εικονοστοιχεία ανά πλευρά"

msgid "main-package is the main package's identity name (got '%s')"
msgstr "το main-package είναι το όνομα ταυτότητας του κύριου πακέτου (δόθηκε '{1}')"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "τα main-publisher και modification = true πάνε με το main-package (το πακέτο στο οποίο ανήκει αυτό)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "το main-publisher είναι ο εκδότης του κύριου πακέτου, π.χ. \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "δεν μπορεί να περιέχει χαρακτήρες ελέγχου ή / \\ : * ? \" < > | $"

msgid "may not start with a space or end with a space or a dot"
msgstr "δεν μπορεί να αρχίζει με κενό ή να τελειώνει με κενό ή τελεία"

msgid "merge module '%s' not found"
msgstr "η λειτουργική μονάδα συγχώνευσης '{1}' δεν βρέθηκε"

msgid "min-version must be a version like 1.2.3"
msgstr "το min-version πρέπει να είναι έκδοση όπως 1.2.3"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "το min-version πρέπει να έχει τέσσερα μέρη, π.χ. 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "το min-version πρέπει να έχει τέσσερα μέρη, π.χ. 14.0.24217.0"

msgid "mismatch"
msgstr "αναντιστοιχία"

msgid "mode = \"remove\" removes the key; it takes no 'value'"
msgstr "το mode = \"remove\" αφαιρεί το κλειδί· δεν δέχεται 'value'"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "το mode πρέπει να είναι \"set\", \"add\" ή \"remove\""

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "το mode πρέπει να είναι \"set\", \"append\" ή \"prepend\""

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "περισσότερες καταχωρίσεις ZIP από το επιτρεπτό ή από όσες έχει ο κατάλογος"

msgid "more keys and values than allowed"
msgstr "περισσότερα κλειδιά και τιμές από το επιτρεπτό"

msgid "more than 3 redirects"
msgstr "περισσότερες από 3 ανακατευθύνσεις"

msgid "more than 96 sections"
msgstr "περισσότερες από 96 ενότητες"

msgid "more than one source file ('%s')"
msgstr "περισσότερα από ένα αρχεία πηγής ('{1}')"

msgid "more than one token is present: name one with --token-label"
msgstr "υπάρχουν περισσότερα από ένα διακριτικά: ονομάστε ένα με --token-label"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "το multi πρέπει να είναι \"each\", \"one\" ή \"single\" (δόθηκε '{1}')"

msgid "multi-line strings are not supported"
msgstr "συμβολοσειρές πολλών γραμμών δεν υποστηρίζονται"

msgid "multi-line strings are not supported; use one line with \\n"
msgstr "συμβολοσειρές πολλών γραμμών δεν υποστηρίζονται· χρησιμοποιήστε μία γραμμή με \\n"

msgid "must be 1 to 64 bytes"
msgstr "πρέπει να είναι 1 έως 64 byte"

msgid "name contains a control character"
msgstr "το όνομα περιέχει χαρακτήρα ελέγχου"

msgid "name is a package's identity name (got '%s')"
msgstr "το name είναι το όνομα ταυτότητας ενός πακέτου (δόθηκε '{1}')"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "το όνομα δεν είναι ASCII και λείπει το summary-name· το Subject της σύνοψης θα είναι 'rubrapack package'"

msgid "names a folder its Directory table does not have"
msgstr "ονομάζει φάκελο που δεν έχει ο πίνακας Directory του"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "το new msix δεν έχει υλοποιηθεί ακόμη: φτιάξτε πηγή MSI και προσθέστε [msix] (δείτε το εγχειρίδιο)"

msgid "no 'format = %d' line: a source in the format of rubrapack 0.18 or earlier, which this version does not read (paths start with $(ProgramFiles) or $(INSTALLDIR) now); see the manual's Source format"
msgstr "δεν υπάρχει γραμμή 'format = {1}': πηγή σε μορφή του rubrapack 0.18 ή παλαιότερου, που αυτή η έκδοση δεν διαβάζει (οι διαδρομές ξεκινούν πλέον με $(ProgramFiles) ή $(INSTALLDIR))· δείτε Source format στο εγχειρίδιο"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "δεν δόθηκε --trust: η υπογραφή επαληθεύεται αλλά τίποτα δεν λέει ποιον να εμπιστευτείτε"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "κανένα πιστοποιητικό στο αρχείο κλειδιού (ή στο αρχείο --cert) δεν ανήκει στο κλειδί"

msgid "no control characters"
msgstr "χωρίς χαρακτήρες ελέγχου"

msgid "no keys\n"
msgstr "κανένα κλειδί\n"

msgid "no main program, so no shortcuts: none"
msgstr "κανένα κύριο πρόγραμμα, άρα καμία συντόμευση: καμία"

msgid "no server name, or one longer than 255 bytes"
msgstr "κανένα όνομα διακομιστή, ή μεγαλύτερο από 255 byte"

msgid "no string pool: not a transform"
msgstr "καμία δεξαμενή συμβολοσειρών: δεν είναι μετασχηματισμός"

msgid "no table '%s' in '%s'"
msgstr "κανένας πίνακας '{1}' στο '{2}'"

msgid "no-remove leaves Modify (its Remove) as the only way to remove the product: it cannot go with no-modify"
msgstr "το no-remove αφήνει το Modify (το Remove του) ως μοναδικό τρόπο αφαίρεσης του προϊόντος: δεν μπορεί να πάει με το no-modify"

msgid "not a PE file (no MZ header)"
msgstr "δεν είναι αρχείο PE (καμία κεφαλίδα MZ)"

msgid "not a PE file (no PE header)"
msgstr "δεν είναι αρχείο PE (καμία κεφαλίδα PE)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "δεν είναι αρχείο PEM, PKCS#8 ή PKCS#12"

msgid "not a ZIP archive (no end record)"
msgstr "δεν είναι αρχείο ZIP (καμία εγγραφή τέλους)"

msgid "not a ZIP archive (too short)"
msgstr "δεν είναι αρχείο ZIP (πολύ μικρό)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "δεν είναι URL διακομιστή μεσολάβησης που δέχεται το rubrapack (http://host:port)"

msgid "not a registry hive"
msgstr "δεν είναι hive μητρώου"

msgid "not a valid number"
msgstr "δεν είναι έγκυρος αριθμός"

msgid "not a value"
msgstr "δεν είναι τιμή"

msgid "not a value (strings need quotes)"
msgstr "δεν είναι τιμή (οι συμβολοσειρές θέλουν εισαγωγικά)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "δεν είναι URL http:// ή https:// που δέχεται το rubrapack"

msgid "not valid UTF-8"
msgstr "δεν είναι έγκυρο UTF-8"

msgid "not-checked (give --trust or --system-roots)"
msgstr "δεν ελέγχθηκε (δώστε --trust ή --system-roots)"

msgid "not-present"
msgstr "δεν υπάρχει"

msgid "nothing changed\n"
msgstr "δεν άλλαξε τίποτα\n"

msgid "number out of range"
msgstr "αριθμός εκτός εύρους"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "οκταδικοί και δυαδικοί αριθμοί δεν υποστηρίζονται· χρησιμοποιήστε δεκαδικό ή 0x"

msgid "on = \"uninstall\" is for HKLM, HKCU and HKMU (classes go with [assoc.*], [com.*] and the like)"
msgstr "το on = \"uninstall\" είναι για HKLM, HKCU και HKMU (οι κλάσεις πάνε με [assoc.*], [com.*] και παρόμοια)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "το on = \"uninstall\" αφαιρεί κλειδί με ό,τι βρίσκεται από κάτω: το '{1}' δεν είναι δικό κλειδί προϊόντος κάτω από το Software"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "το on = \"uninstall\" αφαιρεί όλο το κλειδί κατά την αφαίρεση· δεν δέχεται '{1}'"

msgid "on Windows `keys list` shows the certificate store"
msgstr "στα Windows το `keys list` δείχνει τον χώρο πιστοποιητικών"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "στα Windows ένα διακριτικό χρησιμοποιείται μέσω του χώρου πιστοποιητικών (--key-store <thumbprint>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "το on είναι για remove = true (πότε αφαιρείται το κλειδί)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "το on πρέπει να είναι \"install\" ή \"uninstall\""

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "το on πρέπει να είναι \"install\", \"uninstall\" ή \"both\""

msgid "on: each is a file type ('.' and lower-case letters, digits, '_' or '-'), \"*\" (every file), \"folder\", \"background\" (the empty part of a folder), \"drive\" or \"assoc:<ID>\" (got '%s')"
msgstr "on: το καθένα είναι τύπος αρχείου ('.' και πεζά γράμματα, ψηφία, '_' ή '-'), \"*\" (κάθε αρχείο), \"folder\", \"background\" (το κενό μέρος ενός φακέλου), \"drive\" ή \"assoc:<ID>\" (δόθηκε '{1}')"

msgid "only a bitmap control takes an image"
msgstr "μόνο ένα στοιχείο ελέγχου bitmap δέχεται image"

msgid "only radio, combo and listbox controls take labels"
msgstr "μόνο τα στοιχεία ελέγχου radio, combo και listbox δέχονται labels"

msgid "only radio, combo and listbox controls take values"
msgstr "μόνο τα στοιχεία ελέγχου radio, combo και listbox δέχονται values"

msgid "out of memory"
msgstr "η μνήμη εξαντλήθηκε"

msgid "output '%s': rubrapack writes .msi, .msm, .msix, .msixbundle and a chain's setup .exe"
msgstr "έξοδος '{1}': το rubrapack γράφει .msi, .msm, .msix, .msixbundle και το setup .exe μιας αλυσίδας"

msgid "package '%s' %s"
msgstr "πακέτο '{1}' {2}"

msgid "package '%s' not found"
msgstr "το πακέτο '{1}' δεν βρέθηκε"

msgid "parent must be another product's upgrade-code, not this package's own"
msgstr "το parent πρέπει να είναι upgrade-code άλλου προϊόντος, όχι αυτού του πακέτου"

msgid "parent must be the main product's upgrade-code, a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "το parent πρέπει να είναι το upgrade-code του κύριου προϊόντος, GUID όπως {{12345678-1234-1234-1234-123456789ABC}"

msgid "path must be \"$(Base)/relative/path\" with '/' (Base is a folder such as ProgramFiles, or a dir ID)"
msgstr "το path πρέπει να είναι \"$(Base)/relative/path\" με '/' (Base είναι φάκελος όπως ProgramFiles, ή dir ID)"

msgid "path must start with a Windows folder (like $(ProgramFiles) or $(System))"
msgstr "το path πρέπει να ξεκινά με φάκελο των Windows (όπως $(ProgramFiles) ή $(System))"

msgid "paths"
msgstr "διαδρομές"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "το perceived-type πρέπει να είναι \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" ή \"application\" (δόθηκε '{1}')"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "τα δικαιώματα χρειάζονται scope = \"machine\" (αυτό είναι {1})"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "το phase πρέπει να είναι \"immediate\", \"deferred\", \"commit\" ή \"rollback\" (δόθηκε '{1}')"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "το ports πρέπει να είναι θύρα ή εύρος όπως \"8000-8100\" μέσα στο 1-65535 (δόθηκε '{1}')"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "εκτύπωση τυχαίου GUID, ή αυτού που παράγει το rubrapack από ένα κείμενο"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "εκτύπωση του JSON Schema των πηγών (για επεξεργαστή που συμπληρώνει και ελέγχει κλειδιά)"

msgid "print the version"
msgstr "εκτύπωση της έκδοσης"

msgid "print this help, or one command's usage"
msgstr "εκτύπωση αυτής της βοήθειας, ή της χρήσης μιας εντολής"

msgid "product-code must be a GUID"
msgstr "το product-code πρέπει να είναι GUID"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "το profile πρέπει να είναι \"all\", \"domain\", \"private\" ή \"public\" (δόθηκε '{1}')"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "το prog-id '{1}' ανήκει ήδη στο [com.{2}]"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "το prog-id '{1}' ανήκει επίσης στο [assoc.{2}]: ένας τύπος αρχείου και μια κλάση COM χρειάζονται δύο ονόματα"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "το prog-id '{1}' είναι επίσης στο [assoc.{2}] με άλλη περιγραφή, target, icon ή args"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "το prog-id πρέπει να είναι γράμματα, ψηφία, '.', '_' ή '-', όχι ψηφίο στην αρχή, το πολύ 39 (δόθηκε '{1}')"

msgid "property '%s' already belongs to control '%s'"
msgstr "η ιδιότητα '{1}' ανήκει ήδη στο στοιχείο ελέγχου '{2}'"

msgid "property '%s' has the name of a dir or feature"
msgstr "η ιδιότητα '{1}' έχει το όνομα ενός dir ή μιας δυνατότητας"

msgid "property '%s' is already defined (line %u)"
msgstr "η ιδιότητα '{1}' έχει ήδη οριστεί (γραμμή {2})"

msgid "property '%s' is already searched (line %u)"
msgstr "η ιδιότητα '{1}' αναζητείται ήδη (γραμμή {2})"

msgid "property '%s' is set by rubrapack or the installer and cannot be defined here"
msgstr "η ιδιότητα '{1}' ορίζεται από το rubrapack ή το πρόγραμμα εγκατάστασης και δεν μπορεί να οριστεί εδώ"

msgid "property '%s' must be a public name of your own (upper case)"
msgstr "η ιδιότητα '{1}' πρέπει να είναι δικό σας δημόσιο όνομα (κεφαλαία)"

msgid "property '%s' must be a public name: upper-case letters, digits and '_'"
msgstr "η ιδιότητα '{1}' πρέπει να είναι δημόσιο όνομα: κεφαλαία γράμματα, ψηφία και '_'"

