msgstr "ο διακομιστής χρονοσφραγίδας απάντησε με σφάλμα HTTP"

msgid "the timestamp server's certificate is not for time stamping"
msgstr "το πιστοποιητικό του διακομιστή χρονοσφραγίδας δεν είναι για χρονοσήμανση"

msgid "the timestamp server's time lies outside the signing certificate's validity"
msgstr "η ώρα του διακομιστή χρονοσφραγίδας είναι εκτός της ισχύος του πιστοποιητικού υπογραφής"

msgid "the token does not say what kind of key it is"
msgstr "το διακριτικό δεν λέει τι είδους κλειδί είναι"

