msgstr "το public-folder πρέπει να είναι φάκελος του πακέτου, όπως \"Public\" (δόθηκε '{1}')"

msgid "publisher is the package's publisher, such as \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""
msgstr "το publisher είναι ο εκδότης του πακέτου, π.χ. \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""

msgid "publisher must be the signing certificate's subject, such as \"CN=Example, O=Example, C=KR\""
msgstr "το publisher πρέπει να είναι το subject του πιστοποιητικού υπογραφής, π.χ. \"CN=Example, O=Example, C=KR\""

msgid "publisher must not carry the unsigned-test OID; --unsigned-test adds it"
