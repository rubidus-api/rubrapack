msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: τα args είναι ενός προγράμματος· μια DLL παίρνει data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: το check πάει με ζεύγος do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: το data είναι για αναβαλλόμενη, commit ή rollback ενέργεια (μια άμεση διαβάζει ιδιότητες)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: το entry είναι συνάρτηση μιας DLL· το run παίρνει args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: τα args για MSIX πρέπει να είναι απλό κείμενο (χωρίς [...] που συμπληρώνεται στην εγκατάσταση)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: σε MSIX ένας τύπος αρχείου ανοίγει εφαρμογή: το target πρέπει να είναι εκτελέσιμο ενός [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "Το [chain-package.{1}] υπάρχει δύο φορές"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "Το [chain-package] χρειάζεται ID: γράψτε [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: τα app-id και typelib γράφονται μόνο για το MSI· το MSIX καταχωρίζει την κλάση χωρίς αυτά"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: τα args ανήκουν σε πρόγραμμα· ένα DLL φορτώνεται, δεν εκκινείται"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: το surrogate εκτελεί DLL στο dllhost· το '{2}' είναι πρόγραμμα"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: το threading είναι για DLL· ένα πρόγραμμα ορίζει το δικό του apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: τα typelib-version και typelib-file χρειάζονται typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "Το [copy.{1}] πηγαίνει στο {2}· ή msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: η πηγή του πρέπει να είναι αρχείο που μπαίνει στο πακέτο"

msgid "[define] values must be strings"
msgstr "Οι τιμές του [define] πρέπει να είναι συμβολοσειρές"

msgid "[dialog-control.%s] needs '%s'"
msgstr "Το [dialog-control.{1}] χρειάζεται '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "το [dialog-control.{1}] χρειάζεται image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "Το [dialog-control.{1}] χρειάζεται 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "Το [dialog-control.{1}] χρειάζεται 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "Το [dialog-control.{1}] χρειάζεται 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "Το [dialog.{1}] έχει {2} στοιχεία ελέγχου· το πολύ 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "Το [dialog.{1}] δεν έχει [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "Το [dialog.{1}] τοποθετείται μετά από τον εαυτό του μέσω άλλων παραθύρων διαλόγου"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "Το [dialog.{1}] χρειάζεται ui = \"minimal\", \"installdir\" ή \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: το '{2}' είναι όνομα των Windows· δώστε άλλο ID στο dir"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: το guard χρειάζεται το βοηθητικό DLL του rubrapack, που δεν περιέχει μια λειτουργική μονάδα συγχώνευσης"

msgid "[env.%s] needs a feature"
msgstr "Το [env.{1}] χρειάζεται δυνατότητα"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: ένα MSIX ορίζει όλες τις μεταβλητές του (when)· χρησιμοποιήστε msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: η τιμή του ονομάζει θέση που ένα MSIX δεν μπορεί να δώσει (φάκελο εκτός πακέτου που δεν είναι φάκελος των Windows, ή μέρος που ορίζεται στην εγκατάσταση)· χρησιμοποιήστε msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "το [file.{1}] είναι ήδη στον φάκελο του προγράμματός του· το isolate-for είναι για κοινόχρηστη DLL εγκατεστημένη αλλού"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "Το [file.{1}] βρίσκεται στο προφίλ του χρήστη και έχει component-guid: η διαδρομή κλειδιού του μένει το αρχείο, ενώ οι κανόνες των Windows θέλουν εκεί μια τιμή HKCU (ICE38)· αφαιρέστε το component-guid για να την αποκτήσει"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: η Εξερεύνηση φορτώνει χειριστή {2} από DLL· το [com.{3}] είναι πρόγραμμα"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: τα Windows διαβάζουν χειριστές ιδιοτήτων μόνο ανά υπολογιστή· το πακέτο χρειάζεται scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: ο χειριστής προεπισκόπησης εκτελείται στο prevhost των Windows· αφήστε τα app-id και surrogate εκτός του [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: ένα MSIX περιέχει μόνο χειριστές μικρογραφιών και προεπισκόπησης (ένας πακεταρισμένος χειριστής ιδιοτήτων δεν έδωσε τιμές στην Εξερεύνηση)· το msi-only = true τον κρατά για το MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: ένας τύπος αρχείου MSIX ανήκει σε εφαρμογή· προσθέστε [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: η κλάση {2} δεν είναι [com.*] αυτού του πακέτου (την εξυπηρετεί το DLL του χειριστή)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: σε MSIX οι χειριστές μοιράζονται όλους τους τύπους τους ή κανέναν (ένας τύπος είναι σε μία συσχέτιση τύπου αρχείου)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: σε MSIX η κλάση του εκτελείται σε surrogate· το threading = \"sta\" στο [com.{2}] δίνει στο παράθυρό της βρόχο μηνυμάτων (με threading = {3} η προεπισκόπηση μπορεί να μείνει κενή)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: σε MSIX όλοι οι τύποι του είναι σε έναν τύπο αρχείου [assoc], ή σε κανέναν"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: η κλάση του είναι msi-only ([com.{2}])· το MSIX δεν θα είχε διακομιστή γι' αυτήν"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: το types είναι λίστα τύπων αρχείων, π.χ. [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "Το [ini.{1}] πηγαίνει στο {2}· ή msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "Το [ini.{1}] χρειάζεται 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "Το [ini.{1}] χρειάζεται δυνατότητα: ορίστε 'feature' εδώ ή στο dir του"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: ένα MSIX γράφει όλες τις καταχωρίσεις INI του (when)· χρησιμοποιήστε msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: η τιμή του έχει μέρος που συμπληρώνει το Windows Installer στην εγκατάσταση ([...])· ένα MSIX γράφει το αρχείο κατά τη δημιουργία"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "Το [menu.{1}] χρειάζεται 'on': πού εμφανίζεται το στοιχείο, π.χ. [\".txt\"] ή \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "Το [menu.{1}] χρειάζεται 'target' (το πρόγραμμα που εκκινεί), ή στοιχεία με parent = \"{2}\" (υπομενού)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "Το [menu.{1}] χρειάζεται 'target': το πρόγραμμα που εκκινεί το στοιχείο"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: το μενού των Windows 11 δέχεται ID μόνο από γράμματα και ψηφία (όχι '_'): μετονομάστε το ή ορίστε windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: ένα υπομενού δεν εκκινεί τίποτα: αφήστε έξω το 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: ένα στοιχείο υπομενού εμφανίζεται όπου εμφανίζεται το υπομενού του: αφήστε έξω το 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: τα args έχουν μέρος που συμπληρώνει το Windows Installer στην εγκατάσταση ([...])· ένα MSIX περιέχει μόνο σταθερό κείμενο"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: το hide-when είναι \"HKCU\\\\key\\\\value\" ή \"HKLM\\\\...\", σε στοιχείο του μενού των Windows 11 που δεν είναι σε υπομενού"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: το hide-when ονομάζει τιμή που γράφει το ίδιο το πακέτο ([registry.{2}]): το στοιχείο δεν θα εμφανιζόταν ποτέ"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: το πρόγραμμά του δεν είναι στο MSIX (msi-only;)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: οι τιμές του δεν μπορούν να μπουν στο μητρώο του πακέτου"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: τα list έχουν μέρος που συμπληρώνει το Windows Installer στην εγκατάσταση ([...])· ένα MSIX περιέχει μόνο σταθερό κείμενο"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: το list μπαίνει στη θέση του {2} όταν οι διαδρομές δεν χωρούν σε μια γραμμή εντολών: χρειάζονται multi = \"one\", {3} στο args και {4} (το αρχείο λίστας) στο list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": δεν υπάρχει [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: το on είναι τύπος αρχείου ή λίστα τύπων, π.χ. [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: το parent '{2}' δεν είναι [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: το parent '{2}' πρέπει να είναι υπομενού: ένα [menu.*] χωρίς target και χωρίς δικό του parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "Το [merge.{1}] πηγαίνει στο {2}· ή msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "Το [merge.{1}] χρειάζεται δυνατότητα: ορίστε 'feature' εδώ ή στο dir του"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}· ή msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "το [move.{1}] χρειάζεται feature (ή with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: το feature πάει με δικό του στοιχείο, όχι με το with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: το new-name ονομάζει ένα αρχείο· το name έχει χαρακτήρες μπαλαντέρ"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: ένας στόχος κοινής χρήσης χρειάζεται types, formats ή και τα δύο"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: ένα πρόγραμμα αυτόματης αναπαραγωγής χρειάζεται content-events, device-events ή και τα δύο"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: τα args πρέπει να είναι απλό κείμενο (χωρίς [...] που συμπληρώνεται στην εγκατάσταση)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: τα device-events χρειάζονται class (την κλάση COM IHWEventHandler του προγράμματος)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: το file πρέπει να είναι {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: το file πρέπει να ονομάζει αρχείο που μπαίνει στο πακέτο"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: το file πρέπει να ονομάζει πρόγραμμα που μπαίνει στο πακέτο"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: το types είναι λίστα τύπων αρχείων, π.χ. [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': τα Windows δέχονται μόνο γράμματα και ψηφία"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: το αρχείο '{2}' δεν είναι DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "το [odbc-source.{1}] ονομάζει το πρόγραμμα οδήγησής του μία φορά: driver (ένα [odbc-driver]) ή driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "το [odbc-source.{1}] με driver-name χρειάζεται with = \"file:<ID>\": το στοιχείο με το οποίο εγκαθίσταται"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: ένα πακέτο ανά υπολογιστή καταχωρεί προελεύσεις δεδομένων για τον υπολογιστή"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] ονομάζει ένα αντίγραφο: msix (με publisher) ή upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: το msix είναι το όνομα ταυτότητας του πακέτου (3 έως 50 γράμματα, ψηφία, '.' ή '-') και θέλει publisher (\"CN=...\"), όπως τα έχει το μανιφέστο του"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: το άλλο αντίγραφο το ψάχνει ο προέλεγχος: χρειάζεται preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: το upgrade-code είναι αυτού του πακέτου (αυτό είναι αναβάθμιση, όχι άλλο αντίγραφο)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "Το [permission.{1}] χρειάζεται το dir του να έχει δυνατότητα"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: τα args για MSIX πρέπει να είναι απλό κείμενο (χωρίς [...] που συμπληρώνεται στην εγκατάσταση)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: σε MSIX ένα σχήμα ανοίγει εφαρμογή: το target πρέπει να είναι εκτελέσιμο ενός [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "Το [registry.{1}] χρειάζεται 'value' (ή remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: το HKCR δεν φτάνει έξω από ένα MSIX· χρησιμοποιήστε [assoc.*], [protocol.*], [com.*] ή [handler.*], ή msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: μια τιμή qword χρειάζεται το βοηθητικό DLL του rubrapack, που δεν περιέχει μια λειτουργική μονάδα συγχώνευσης"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: ένα MSIX περιέχει τιμές μόνο κάτω από το {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: ένα MSIX ούτε αφαιρεί τιμές ούτε τις αφήνει πίσω (remove, keep)· χρησιμοποιήστε msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: ένα MSIX γράφει όλες τις τιμές του (when)· χρησιμοποιήστε msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: η τιμή του έχει μέρος που συμπληρώνει το Windows Installer στην εγκατάσταση ([...])· ένα MSIX περιέχει μόνο σταθερές τιμές"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: το on = \"uninstall\" χρειάζεται το βοηθητικό DLL του rubrapack, που δεν περιέχει μια λειτουργική μονάδα συγχώνευσης"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: το όνομα κλειδιού ή τιμής δεν μπορεί να μπει σε hive μητρώου"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: το users = \"all\" είναι για root = \"HKCU\" με on = \"uninstall\", σε πακέτο για τον υπολογιστή"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "Το [remove.{1}] χρειάζεται δυνατότητα: ορίστε 'feature' εδώ ή στο dir του"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: το recursive = true δεν είναι για φάκελο κάτω από το {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: το recursive = true χρειάζεται το βοηθητικό DLL του rubrapack, που δεν περιέχει μια λειτουργική μονάδα συγχώνευσης"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: το users = \"all\" είναι για recursive = true σε φάκελο του AppData ή του LocalAppData, σε πακέτο για τον υπολογιστή"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: τα args για MSIX πρέπει να είναι απλό κείμενο (χωρίς [...] που συμπληρώνεται στην εγκατάσταση)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: το file πρέπει να ονομάζει πρόγραμμα που μπαίνει στο πακέτο"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] διαφημίζει τη λειτουργία '{2}', η οποία έχει advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: το advertise δεν συνδυάζεται με το when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: ένα MSIX έχει συντομεύσεις μόνο στην επιφάνεια εργασίας και στο μενού Έναρξη{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: μια συντόμευση MSIX δεν έχει working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: μια συντόμευση MSIX υπάρχει πάντα (το when είναι για MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: μια συντόμευση MSIX εμφανίζει το λογότυπο της εφαρμογής της· το icon είναι για MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: μια διαφημιζόμενη συντόμευση είναι για ένα MSI (ένα MSIX εγκαθιστά ολόκληρο το πακέτο)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
