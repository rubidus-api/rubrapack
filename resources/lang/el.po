msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "Το [{1}.{2}] βρίσκεται στο AppData ή στο LocalAppData του χρήστη: ένα πακέτο dual που εγκαθίσταται για όλους τους χρήστες το βάζει μόνο στο προφίλ του χρήστη που το εγκαθιστά"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ένα ID σε λειτουργική μονάδα συγχώνευσης έχει το πολύ 35 χαρακτήρες (προστίθεται το GUID της μονάδας)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "Το [{1}] χρειάζεται ID: γράψτε [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "Το [{1}] δεν δέχεται ID: γράψτε [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "Το [Content_Types].xml δεν έχει </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "Το [Content_Types].xml δεν είναι η τελευταία καταχώριση (δεν είναι πακέτο που έγραψε το rubrapack ή το API πακεταρίσματος των Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Οι πίνακες πινάκων [[...]] δεν υποστηρίζονται· δώστε σε κάθε στοιχείο το δικό του [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "το [action.{1}] τοποθετείται μία φορά: before, after ή sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "Το [action.{1}] χρειάζεται και do και undo (το undo αναιρεί επίσης ένα αποτυχημένο do)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "το [action.{1}] χρειάζεται entry: τη συνάρτηση της DLL προς κλήση"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "το [action.{1}] χρειάζεται run = \"file:<ID>\": το πρόγραμμα που εκτελούν τα do και undo"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "το [action.{1}] εκτελεί ένα πράγμα: run (ένα exe), dll (μια εγκατεστημένη DLL) ή binary (μια DLL στο πακέτο)· ή do και undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: το {2} είναι για μία ενέργεια, όχι για ζεύγος do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: μια αναβαλλόμενη ενέργεια που εκτελεί εγκατεστημένο αρχείο πρέπει να είναι μετά το InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
