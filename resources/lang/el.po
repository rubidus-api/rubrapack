msgstr "το replaces περιέχει το πολύ 16 κωδικούς αναβάθμισης"

msgid "replaces holds upgrade codes, GUIDs like {12345678-1234-1234-1234-123456789ABC} (got '%s')"
msgstr "το replaces περιέχει κωδικούς αναβάθμισης, GUID όπως {{12345678-1234-1234-1234-123456789ABC} (δόθηκε '{1}')"

msgid "replaces is an array of upgrade codes, like [\"{12345678-1234-1234-1234-123456789ABC}\"]"
msgstr "το replaces είναι πίνακας κωδικών αναβάθμισης, π.χ. [\"{{12345678-1234-1234-1234-123456789ABC}\"]"

msgid "replaces lists %s twice"
