msgstr "--target 接受 msi 或 msix(實際為 '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust、--tls-trust、--system-roots 和 --proxy 須與 --timestamp 一起使用"

