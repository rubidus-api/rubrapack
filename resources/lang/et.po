msgstr "[handler.{1}]: selle klass on msi-only ([com.{2}]); MSIX-il poleks selle jaoks serverit"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types on failitüüpide loend, nt [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] läheb asukohta {2}; või msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] vajab 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] vajab funktsiooni: määrake 'feature' siin või selle dir'il"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX kirjutab kõik oma INI-kirjed (when); kasutage msi-only = true"

