msgstr "[com.{1}]: app-id ja typelib kirjutatakse ainult MSI jaoks; MSIX registreerib klassi ilma nendeta"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args kuuluvad programmile; DLL laaditakse, mitte ei käivitata"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate käivitab DLL-i dllhostis; '{2}' on programm"

