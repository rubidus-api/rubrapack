msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: selle programm pole MSIX-is (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: selle väärtused ei saa minna paketi registrisse"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list'is on osa, mille Windows Installer installimisel täidab ([...]); MSIX sisaldab ainult fikseeritud teksti"

