msgstr "[dialog-control.{1}] vajab image-d"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] vajab 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] vajab 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] vajab 'values'"

