msgstr "[dialog.{1}] on teiste dialoogide kaudu paigutatud iseenda järele"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] vajab ui = \"minimal\", \"installdir\" või \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' on Windowsi nimi; andke dir'ile teine ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard vajab rubrapacki abi-DLL-i, mida ühendusmoodul ei kanna"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] vajab funktsiooni"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX määrab kõik oma muutujad (when); kasutage msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: selle väärtus nimetab koha, mida MSIX anda ei saa (paketivälist kausta, mis pole Windowsi kaust, või installiaegset osa); kasutage msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: external-location = true korral ei sisalda pakett ühtegi programmi faili, seega ka mitte rubrapacki käivitajat; või msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] on juba oma programmi kaustas; isolate-for on mujale installitud jagatud DLL-i jaoks"

