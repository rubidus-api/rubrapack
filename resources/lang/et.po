msgstr "[assoc.{1}]: MSIX-is avab failitüüp rakenduse: target peab olema [msix-app.*] käivitatav fail"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] on kaks korda"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] vajab ID-d: kirjutage [chain-package.ID]"

