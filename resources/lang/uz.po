msgstr "[handler.{1}]: MSIX da uning klassi surrogatda ishlaydi; [com.{2}] dagi threading = \"sta\" oynaga xabar siklini beradi (threading = {3} bilan oldindan ko‘rish bo‘sh qolishi mumkin)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX da uning barcha turlari bitta [assoc] fayl turida bo‘ladi yoki hech biri"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: uning klassi faqat MSI uchun ([com.{2}]); MSIX da unga server bo‘lmasdi"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types fayl turlari ro‘yxati, masalan [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2} ga boradi; yoki msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] ga 'value' kerak"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] ga komponent kerak: 'feature' ni shu yerda yoki uning dir ida o‘rnating"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX barcha INI yozuvlarini yozadi (when); msi-only = true dan foydalaning"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: uning qiymatida Windows Installer o‘rnatishda to‘ldiradigan qism bor ([...]); MSIX faylni yig‘ilganda yozadi"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] ga 'on' kerak: element qayerda ko‘rinishi, masalan [\".txt\"] yoki \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] ga 'target' (u ishga tushiradigan dastur) yoki parent = \"{2}\" bo‘lgan elementlar (ichki menyu) kerak"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] ga 'target' kerak: element ishga tushiradigan dastur"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 menyusi faqat harf va raqamlardan iborat ID qabul qiladi ('_' mumkin emas): nomini o'zgartiring yoki windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: ichki menyu hech narsani ishga tushirmaydi: 'args' ni yozmang"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: ichki menyu elementi ichki menyu ko‘rinadigan joyda ko‘rinadi: 'on' ni yozmang"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args da Windows Installer o‘rnatishda to‘ldiradigan qism bor ([...]); MSIX faqat qat’iy matnni saqlaydi"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when — \"HKCU\\\\key\\\\value\" yoki \"HKLM\\\\...\", ichki menyuda bo'lmagan Windows 11 menyusi bandida"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when shu paketning o'zi yozadigan qiymatni ko'rsatadi ([registry.{2}]): band hech qachon ko'rinmaydi"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: uning dasturi MSIX da yo‘q (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: uning qiymatlari paket reyestriga kira olmaydi"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list da Windows Installer o‘rnatishda to‘ldiradigan qism bor ([...]); MSIX faqat qat’iy matnni saqlaydi"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: yo'llar buyruq satriga sig'maganda list {2} o'rnini egallaydi: multi = \"one\", args ichida {3} va list ichida {4} (ro'yxat fayli) kerak"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": [assoc.{3}] yo‘q"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on fayl turi yoki ularning ro‘yxati, masalan [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: '{2}' ota elementi [menu.*] emas"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: '{2}' ota elementi ichki menyu bo‘lishi kerak: target siz va o‘z ota elementisiz [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2} ga boradi; yoki msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] ga komponent kerak: 'feature' ni shu yerda yoki uning dir ida o‘rnating"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; yoki msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] feature talab qiladi (yoki with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature o'z komponenti bilan boradi, with bilan emas"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name bitta faylni ko'rsatadi; name'da joker belgilar bor"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: ulashish maqsadiga types, formats yoki ikkalasi kerak"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: avtomatik ishga tushirish ishlovchisiga content-events, device-events yoki ikkalasi kerak"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args oddiy matn bo‘lishi kerak (o‘rnatishda to‘ldiriladigan [...] siz)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events uchun class kerak (dasturning IHWEventHandler COM sinfi)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file {2} bo‘lishi kerak"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file paketga kiradigan faylni ko‘rsatishi kerak"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file paketga kiradigan dasturni ko‘rsatishi kerak"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types fayl turlari ro‘yxati, masalan [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows faqat harf va raqamlarni qabul qiladi"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64 uchun [msix-psf] launcher = \"...\" talab qiladi (PSF ishga tushirgichlarini PsfLauncher32.exe, PsfLauncher64.exe deb ataydi)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] na external-location = true, na [env.*] (rubrapack-ning o‘z ishga tushirgichi) bilan birga ishlamaydi"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] ilovalarni PSF ishga tushirgichi orqali ishga tushiradi: unga [msix-app.ID] kerak"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: '{1}' config o‘z \"applications\" qismida '{2}' ilovasini nomlamaydi"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files ichida '{1}' (ishga tushirgich) yo‘q"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: '{2}' fayli DLL emas"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] drayverini bir marta ko'rsatadi: driver (bitta [odbc-driver]) yoki driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] driver-name bilan with = \"file:<ID>\" kerak: u bilan o'rnatiladigan komponent"

