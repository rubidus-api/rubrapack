# rubrapack language pack: Uzbek (Latin script).
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: uz\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: O‘zbekcha\n"
"X-Rubrapack-LangIDs: 1091\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 4\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialoglar {6}{7}\n  1 nomi, ishlab chiqaruvchi, versiya, arxitektura 2 o‘rnatish jildi, kim uchun\n  3 dialoglar, litsenziya, tillar                4 ixtiyoriy qismlar\n  5 yorliqlar                                    6 fayllar: dastur jildiga moslash\n  7 istalgan kalit                               v ko‘rish   l lint   s saqlash   q chiqish\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nShu kodli xabarlar (* nom yoki qiymat o‘rnida turadi):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nNatijalar stdout ga, diagnostika stderr ga chiqadi.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nNima qilish kerak: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} yo‘q, lekin yorliq uni ochadi: avval yorliqlarni o‘zgartiring (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  u yerda {1} ta fayl va {2} ta jild bor\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s yoki q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] va [files.{2}] qo‘shildi\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] qo‘shildi\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  jadval.kalit ko‘rinishida bering, masalan package.version yoki dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: muammo yo‘q\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: yuqoridagi muammolarni ko‘ring (unda aytilgan fayl tekshiruv nusxasi)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages dagi boshqa tillar saqlanadi; u ro‘yxatni 7 bilan o‘zgartiring (istalgan kalit)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] olib tashlandi\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] olib tashlandi{2}\n"

msgid "  sub folders:"
msgstr "  ichki jildlar:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  bu TOML qism to‘plamiga mos emas; hech narsa o‘zgartirilmadi\n"

msgid "  that was not readable text; again, please\n"
msgstr "  bu o‘qiladigan matn emas edi; qaytadan kiriting\n"

msgid "  the program folder '%s': %s\n"
msgstr "  dastur jildi '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  manbada yorliq ko‘rsatishi mumkin bo‘lgan [file] jadvallari yo‘q\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  manbada `new` yozadigan ichki jildlar yo‘q ([files] \"<folder>/<name>/**\"); ularni 6 bilan qo‘shing\n"

msgid "  too long; again, please\n"
msgstr "  juda uzun; qaytadan kiriting\n"

msgid "  y or n\n"
msgstr "  y yoki n\n"

msgid " (changed)"
msgstr " (o‘zgartirildi)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) va MSIX (.msix) paketlarini yaratadi\n\nfoydalanish: rubrapack [--lang <code>] <command> [arguments]\n\nbuyruqlar:\n"

msgid " and its dir"
msgstr " va uning jildi"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) muhit o‘zgaruvchisiga ega emas, shuning uchun kengaytiriladigan qiymat uni saqlay olmaydi; satr qiymatidan foydalaning (o‘rnatishda to‘ldiriladi)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) - {2}: u yo‘lni boshlashi yoki Windows Installer to‘ldiradigan qiymat o‘rnida turishi mumkin (reyestr, muhit, INI, argumentlar, xabarlar), lekin bu yerda emas"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) yo‘l boshlanadigan jild emas (dir ID yoki ProgramFiles, LOCALAPPDATA, ProgramData ... - qo‘llanmadagi Yo‘llar bo‘limiga qarang){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  tuzilma:     {2}\n  dayjest:     {3}\n  imzo:        {4}\n  zanjir:      {5}{6}{7}\n  bekor qilish: tekshirilmagan\n  vaqt tamg‘asi: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: o‘zgaruvchi o‘rnatilmagan"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' bu dialog boshqaruv elementi emas"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3} da yo‘q"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': litsenziya matniga shriftning inglizcha nomi kerak, shuning uchun u tilning o‘z shriftida ko‘rsatiladi; bu shriftni u yerda ham ishlatish uchun inglizcha nomini yozing (masalan \"Malgun Gothic\")"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' jild bo‘lishi kerak"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} komponent, lekin paket platformasi {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\" turiga tegishli emas"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\" turiga tegishli emas"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID larni saqlaydi (1..65535), masalan 1041"

msgid "%s holds strings"
msgstr "{1} satrlarni saqlaydi"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} — \"Kalit=Qiymat\" matnlari ro'yxati"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} matnlar ro‘yxati, masalan [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} 1 dan 31 belgigacha bo‘lgan shrift nomi, masalan \"Segoe UI\" ({2} olindi)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} yopilgan qo‘shtirnoq va muvozanatli qavslarga ega MSI sharti"

msgid "%s is an array of strings, one per value"
msgstr "{1} satrlar massivi, har qiymatga bittadan"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI paketlar uchun: msiexec MSIX ni o‘chirmaydi"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} yo‘q. [file.{2}] olib tashlansinmi?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 belgidan uzun"

msgid "%s is new. Add it?"
msgstr "{1} yangi. Qo‘shilsinmi?"

msgid "%s is not a GUID in registry format"
msgstr "{1} reyestr formatidagi GUID emas"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} bu rubrapack ishlatadigan kod emas{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} bu paketning [file.*] ini ko‘rsatuvchi \"file:<ID>\" bo‘lishi kerak"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} {2}–{3} ta harf, raqam, '.' yoki '-' bo‘lishi va '.' bilan boshlanmasligi kerak ('{4}' olindi)"

msgid "%s must be a GUID"
msgstr "{1} GUID bo‘lishi kerak"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} {{12345678-...} kabi GUID bo‘lishi kerak ('{2}' olindi)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// yoki file:// manzili yoki \\\\server\\share yo‘li bo‘lishi kerak ('{2}' olindi)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} upgrade-code dan farq qilishi kerak (har arxitektura uchun bitta yangilash oilasi)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} uchun Windows {2} yoki undan keyingi yig‘ma kerak: [msix] min-version = \"10.0.{3}.0\" ni o‘rnating"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} uchun resources/bin/rubrapack_ca-{2}.dll kerak, bu rubrapack usiz yig‘ilgan"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA tekshirilmagan (--tsa-trust bering)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA ishonchli"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA ishonchsiz - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} yo‘q yoki bo‘sh. [files.{3}] va [dir.{4}] olib tashlansinmi?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ yangi jild. Qo‘shilsinmi?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: xatolar: {2}{-3}, ogohlantirishlar: {4}{-5}\n"

