msgstr "{1}: {2} ta fayl, {3} ta xato, 0 ta ogohlantirish\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: yana {2} ta diagnostika ko‘rsatilmadi\n"

