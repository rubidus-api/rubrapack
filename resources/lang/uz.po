msgstr "[shortcut.{1}]: MSIX da yorliqlar faqat ish stolida va Boshlash menyusida bo‘ladi{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX yorlig‘ida working-dir yo‘q"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX yorlig‘i doim bo‘ladi (when MSI uchun)"

