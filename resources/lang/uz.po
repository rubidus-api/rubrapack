msgstr "zanjir faqat [chain], [chain-package.ID] va [define] ni saqlaydi, [{1}] ni emas; paketlar o‘z manbalaridan yig‘iladi"

msgid "a chain holds at most %d packages"
msgstr "zanjirda ko‘pi bilan {1} ta paket bo‘ladi"

