msgstr "[shortcut.{1}]: MSIX yorlig‘i o‘z ilovasining logotipini ko‘rsatadi; icon MSI uchun"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: reklama qilingan yorliq MSI uchun (MSIX butun paketni o'rnatadi)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: reklama qilingan yorliq uchun belgi kerak"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX uchun args oddiy matn bo‘lishi kerak (o‘rnatishda to‘ldiriladigan [...] siz)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX da yorliq ilovani ishga tushiradi: target [msix-app.*] bajariladigan fayli bo‘lishi kerak"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX ning Boshlash menyusidagi yozuvi uning ilovasi, u args olmaydi"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: bu ID ga ega dialog matni yo‘q"

