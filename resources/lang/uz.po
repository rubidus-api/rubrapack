msgstr "[odbc-source.{1}]: kompyuter uchun paket ma'lumot manbalarini kompyuter uchun ro'yxatga oladi"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] bitta nusxani ko'rsatadi: msix (publisher bilan) yoki upgrade-code"

