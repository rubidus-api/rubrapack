msgid "a license needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "litsenziyaga ui = \"minimal\", \"installdir\" yoki \"features\" kerak"

msgid "a local header with extra fields (not a package rubrapack or Windows' packaging API wrote)"
msgstr "qo‘shimcha maydonlarga ega mahalliy sarlavha (rubrapack yoki Windows qadoqlash API si yozgan paket emas)"

msgid "a malformed central directory"
msgstr "noto‘g‘ri tuzilgan markaziy katalog"

