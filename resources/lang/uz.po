msgstr "[registry.{1}]: qword qiymatiga rubrapack yordamchi DLL i kerak, birlashtirish moduli uni olib yurmaydi"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX faqat {2}\\Software ostidagi qiymatlarni olib yuradi"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX qiymatlarni o‘chirmaydi ham, qoldirmaydi ham (remove, keep); msi-only = true dan foydalaning"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX barcha qiymatlarini yozadi (when); msi-only = true dan foydalaning"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: uning qiymatida Windows Installer o‘rnatishda to‘ldiradigan qism bor ([...]); MSIX faqat qat’iy qiymatlarni saqlaydi"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" ga rubrapack yordamchi DLL i kerak, birlashtirish moduli uni olib yurmaydi"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: kalit yoki qiymat nomi reyestr hive iga kira olmaydi"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" kompyuter paketida on = \"uninstall\" bilan root = \"HKCU\" uchun"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] ga komponent kerak: 'feature' ni shu yerda yoki uning dir ida o‘rnating"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true {2} ostidagi jild uchun emas"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true ga rubrapack yordamchi DLL i kerak, birlashtirish moduli uni olib yurmaydi"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" kompyuter paketida AppData yoki LocalAppData ichidagi jilddagi recursive = true uchun"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX uchun args oddiy matn bo‘lishi kerak (o‘rnatishda to‘ldiriladigan [...] siz)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file paketga kiradigan dasturni ko‘rsatishi kerak"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] '{2}' funksiyasini reklama qiladi, lekin u advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise when bilan birlashtirilmaydi"

