msgstr "{1}: xatolar: {2}{-3}, ogohlantirishlar: {4}{-5} ({6} ga nisbatan)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} ta fayl, {3} bayt\n"

