msgstr "shikastlangan PE ixtiyoriy sarlavhasi"

msgid "a damaged PE section table"
msgstr "shikastlangan PE bo‘limlar jadvali"

msgid "a damaged ZIP64 end record"
msgstr "shikastlangan ZIP64 yakuniy yozuvi"

msgid "a damaged hive bin"
msgstr "shikastlangan hive bin"

msgid "a diagnostic of rubrapack"
msgstr "rubrapack diagnostikasi"

msgid "a disabled service cannot be started"
msgstr "o‘chirilgan xizmatni ishga tushirib bo‘lmaydi"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "dual paketi foydalanuvchi va tizim o‘zgaruvchisi o‘rtasida tanlay olmaydi"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "dual paketi HKMU ga yozadi (o‘rnatilishiga qarab HKLM yoki HKCU), HKCU ga emas"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "dword qiymati 0..4294967295 butun son (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "bu rubrapack bermaydigan imkoniyat (yoki usiz yig‘ilgan)"

msgid "a file larger than allowed"
msgstr "ruxsat etilgandan katta fayl"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "'{1}' ostidagi fayl nomi yaroqli Unicode emas va uni paketlab bo‘lmaydi"

msgid "a file name without / \\ : * ? \" < > | $"
msgstr "/ \\ : * ? \" < > | $ siz fayl nomi"

