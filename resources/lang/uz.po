msgstr "[other-copy.{1}]: msix — paketning identifikatsiya nomi (3 dan 50 gacha harf, raqam, '.' yoki '-'), unga publisher (\"CN=...\") kerak, manifestda qanday bo'lsa"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: boshqa nusxani oldindan tekshiruv qidiradi: preflight = true kerak"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code shu paketning o'ziniki (bu yangilash, boshqa nusxa emas)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] uchun uning dir ida komponent bo‘lishi kerak"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX uchun args oddiy matn bo‘lishi kerak (o‘rnatishda to‘ldiriladigan [...] siz)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX da sxema ilovani ochadi: target [msix-app.*] bajariladigan fayli bo‘lishi kerak"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] ga 'value' kerak (yoki remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR MSIX dan tashqariga yetmaydi; [assoc.*], [protocol.*], [com.*] yoki [handler.*] dan foydalaning yoki msi-only = true"

