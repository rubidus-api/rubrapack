msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' bu paket arxitekturasi uchun emas, 0x{2} mashinasi uchun yig‘ilgan; ataylab bo‘lsa any-arch = true ni o‘rnating"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' PE fayl (.exe, .dll) ham, MSI paket ham, MSIX paket yoki to‘plam ham emas"

