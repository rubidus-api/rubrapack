msgstr "[ui] embedded MSI uchun; MSIX ning o'z o'rnatuvchi interfeysi yo'q"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] uchun [package] da ui = \"basic\" yoki boshqa dialog to'plami kerak (yoki embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} boshqaruv ketma-ketligi Unicode skalyar qiymati emas"

