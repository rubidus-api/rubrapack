# rubrapack language pack: Portuguese (Portugal).
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: pt_PT\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Português (Portugal)\n"
"X-Rubrapack-LangIDs: 2070\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, diálogos {6}{7}\n  1 nome, fabricante, versão, arquitetura        2 pasta de instalação, para quem\n  3 diálogos, licença, idiomas                   4 partes opcionais\n  5 atalhos                                      6 ficheiros: acompanhar a pasta do programa\n  7 qualquer chave                               v ver   l lint   s guardar   q sair\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMensagens com este código (* indica um nome ou um valor):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nOs resultados vão para stdout e os diagnósticos para stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nO que fazer: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} não existe mais, mas um atalho o abre: altere primeiro os atalhos (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  há {1} ficheiros e {2} pastas lá\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s ou q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] e [files.{2}] adicionados\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] adicionado\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  informe como tabela.chave, por exemplo package.version ou dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: nenhum problema\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: veja os problemas acima (o ficheiro indicado é uma cópia de verificação)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  os outros idiomas em [ui] languages são mantidos; altere essa lista com 7 (qualquer chave)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] removido\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} removido\n"

msgid "  sub folders:"
msgstr "  subpastas:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  isso não cabe no subconjunto TOML; nada foi alterado\n"

msgid "  that was not readable text; again, please\n"
msgstr "  não era um texto legível; de novo, por favor\n"

msgid "  the program folder '%s': %s\n"
msgstr "  a pasta do programa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  a origem não tem tabelas [file] para as quais um atalho possa apontar\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  a origem não tem subpastas como `new` as escreve ([files] \"<folder>/<name>/**\"); adicione-as com 6\n"

msgid "  too long; again, please\n"
msgstr "  longo demais; de novo, por favor\n"

msgid "  y or n\n"
msgstr "  y ou n\n"

msgid " (changed)"
msgstr " (alterado)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - cria pacotes do Windows Installer (.msi) e MSIX (.msix)\n\nuso: rubrapack [--lang <code>] <command> [arguments]\n\ncomandos:\n"

msgid " and its dir"
msgstr " e seu dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) não tem variável de ambiente, então um valor expansível não pode contê-lo; use um valor de cadeia (preenchido na instalação)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) é um {2}: pode iniciar um caminho ou substituir um valor que o Windows Installer preenche (registo, ambiente, INI, argumentos, mensagens), mas não aqui"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) não é uma pasta pela qual um caminho possa começar (um ID de dir, ou ProgramFiles, LOCALAPPDATA, ProgramData ... - veja Paths no manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  estrutura:  {2}\n  resumo:     {3}\n  assinatura: {4}\n  cadeia:     {5}{6}{7}\n  revogação:  não verificada\n  carimbo:    {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: a variável não está definida"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' não é um controle deste diálogo"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' não está em {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': o texto da licença precisa do nome em inglês da fonte, então é mostrado na fonte própria do idioma; escreva o nome em inglês (como \"Malgun Gothic\") para usar esta fonte também lá"

msgid "%s component, but the package platform is %.*s"
msgstr "componente {1}, mas a plataforma do pacote é {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} não pertence a kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} não pertence a kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} contém LANGIDs (1..65535), como 1041"

msgid "%s holds strings"
msgstr "{1} contém cadeias"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} é um nome de fonte de 1 a 31 caracteres, como \"Segoe UI\" (recebido {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} é uma condição MSI com aspas fechadas e parênteses balanceados"

msgid "%s is an array of strings, one per value"
msgstr "{1} é uma matriz de cadeias, uma por valor"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} é para pacotes MSI: um MSIX não é removido pelo msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} não existe mais. Remover [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} tem mais de 240 caracteres"

msgid "%s is new. Add it?"
msgstr "{1} é novo. Adicionar?"

msgid "%s is not a GUID in registry format"
msgstr "{1} não é um GUID no formato do Registo"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} não é um código que este rubrapack usa{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} deve ser \"file:<ID>\" e indicar um [file.*] deste pacote"

msgid "%s must be a GUID"
msgstr "{1} deve ser um GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} deve ser um GUID como {12345678-...} (recebido '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} deve ser um endereço https://, http:// ou file://, ou um caminho \\\\server\\share (recebido '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} deve ser diferente de upgrade-code (uma família de atualização por arquitetura)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} requer o build {2} do Windows ou posterior: defina [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} precisa de resources/bin/rubrapack_ca-{2}.dll, sem a qual este rubrapack foi compilado"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA não verificada (informe --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA confiável"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA não confiável - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} não existe mais ou está vazio. Remover [files.{3}] e [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ é uma pasta nova. Adicionar?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} erro(s){-3}, {4} aviso(s){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} erro(s){-3}, {4} aviso(s){-5} (em relação a {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} ficheiros, {3} bytes\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} ficheiros, {3} erros, 0 avisos\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: mais {2} diagnósticos não mostrados\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: o ficheiro '{2}' não é um [file.*] deste pacote"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: o ficheiro '{2}' não é um programa (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' não está fechado (escreva '$$(' para o texto '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' já existe; foi deixado como está"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' já existe; remova-o ou compile em outra pasta"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' já tem um manipulador {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' já tem permissões"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' e '{2}' são o mesmo caminho no pacote"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' pertence ao Windows ou aos navegadores"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' não pode ser lido em relação a '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' não cabe no subconjunto TOML; nada foi guardado"

msgid "'%s' exists already"
msgstr "'{1}' já existe"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' já existe; altere-o com `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existe e não é um diretório vazio; extraia em um novo"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' vai em {2}; ou msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' tem um fluxo de informações de resumo ilegível"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' não tem tabelas Directory, Component, File e Media das quais extrair"

msgid "'%s' has no readable summary information"
msgstr "'{1}' não tem informações de resumo legíveis"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' não tem a transformação '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' está em UTF-16: edit altera apenas origens UTF-8 (guarde-o primeiro em UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' é um nome do Windows; dê outro nome à variável"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' é um [chain]: ele cria um programa de instalação, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' é um controle do quadro interno; escolha outro ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' é uma pasta do computador; um pacote {2} não pode gravar lá"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' é um módulo de mesclagem: mescle-o com [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' é um nome que o formato MSIX reserva para si"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' é um link simbólico; links não são seguidos"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' também é uma [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' também é um ID de dir; dê outro nome à variável"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' foi compilado para a máquina 0x{2}, não para o arch deste pacote; defina any-arch = true se for intencional"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' não é um ficheiro PE (.exe, .dll), nem um pacote MSI, nem um pacote ou lote MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' não é um ficheiro PE, nem um pacote MSI, nem um pacote ou lote MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' não é uma pasta conhecida nem um ID de dir (pastas conhecidas: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' não é um cabinet que o rubrapack consiga ler (stored ou MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' não é um código de diagnóstico (RP e quatro dígitos, como RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' não é um programa (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' não é um ficheiro comum"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' não é um programa de instalação do rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' não é um ID válido (letras, dígitos e '_', sem começar com dígito, no máximo {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' não é um banco de dados MSI válido: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' não é um pacote MSIX válido: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' não é um pacote válido: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' não é uma origem válida (o subconjunto TOML); corrija-a primeiro à mão"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' não é uma transformação válida: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' não é um nome de variável válido"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' é reservado e não pode ser usado como ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' é o nome de um dir: só uma pesquisa no Registo ou de dir pode preencher um dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' parece um ficheiro de programa (PE), mas seus cabeçalhos ou recursos estão danificados"

msgid "'%s' must be a string"
msgstr "'{1}' deve ser uma cadeia"

msgid "'%s' must be an integer"
msgstr "'{1}' deve ser um inteiro"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' deve estar entre {2} e {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' deve ser true ou false"

msgid "'%s' must not be empty"
msgstr "'{1}' não pode estar vazio"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' não indica transformações (propriedade de resumo 8): não é um patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' começa com uma pasta: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' tem {4}; nada foi extraído"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entradas, mais que o limite {3} (--limit-entries); nada foi extraído"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' e '{3}' seriam o mesmo caminho no Windows; nada foi extraído"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' não está em [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': não é possível ler uma tabela"

msgid "'%s': a table is unreadable"
msgstr "'{1}': uma tabela está ilegível"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': um MSIX instala todos os seus ficheiros (when); use msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': um MSIX remove todos os seus ficheiros (keep); use msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': o cabinet '{2}' está danificado ou não é stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': o nome de cabinet '{2}' não é um nome de ficheiro simples"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': o ficheiro compactado '{2}' (sequência {3}) não tem cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': o diretório '{2}' tem um pai '{3}' que não existe"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': o diretório '{2}' é seu próprio ancestral ou está aninhado demais"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': o ficheiro '{2}' não corresponde ao seu MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': o ficheiro '{2}' não tem componente ou diretório"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': o ficheiro '{2}' tem {3} bytes, a tabela File diz {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': o ficheiro '{2}' não está no cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': seus cabinets externos não são cobertos pela assinatura (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': sua pasta não leva a um local conhecido"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': mais de {2} bytes para gravar (--limit-bytes); nada foi extraído"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': sem --timestamp: a assinatura deixa de ser válida quando o certificado expirar"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': o pacote '{2}' não corresponde ao seu SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': o fluxo de cabinet '{2}' não existe"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': o manifesto não tem {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': o manifesto indica '{2}', que não está no pacote"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': carimbo de data/hora de {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': a transformação '{2}' não pode ser lida em relação a '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' é o idioma do próprio pacote ({2}); informe esse texto sem o sufixo"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' faz o Windows Installer gravar uma cadeia múltipla; use type = \"multi\" e uma matriz"

msgid "'_' in numbers is not supported"
msgstr "'_' em números não é suportado"

msgid "'help' takes at most one command name"
msgstr "'help' aceita no máximo um nome de comando"

msgid "'version' takes no arguments"
msgstr "'version' não aceita argumentos"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs é para .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch para um lote: uma lista de x64, x86 e arm64, cada um uma vez (recebido '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch aceita uma arquitetura, ou uma lista para uma saída .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp e --allow-unsigned-cabs vão com --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress é para .msi; um MSIX aceita --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist indica uma pasta nova ao lado da origem (sem caminho)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs aceita um número de 1 a 64 (recebido '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store é um repositório de certificados do Windows; em outros sistemas use um ficheiro de chave ou --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store aceita a impressão digital SHA-1 do certificado (40 dígitos hexadecimais)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: idioma inexistente (integrados: {2}; outro precisa do seu pacote de idioma, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (ou RUBRAPACK_LANG) escolhe o idioma destes textos: {1} ou um idioma com pacote de idioma.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang precisa de um idioma, como en ou ko"

