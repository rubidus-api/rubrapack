# rubrapack language pack: Hungarian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: hu\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Magyar\n"
"X-Rubrapack-LangIDs: 1038\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, párbeszédpanelek {6}{7}\n  1 név, gyártó, verzió, architektúra           2 telepítési mappa, kinek települ\n  3 párbeszédpanelek, licenc, nyelvek           4 választható részek\n  5 parancsikonok                               6 fájlok: a programmappához igazítás\n  7 bármely kulcs                               v nézet   l lint   s mentés   q kilépés\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nAz ilyen kódú üzenetek (a * egy nevet vagy értéket jelöl):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nAz eredmények az stdout-ra, a diagnosztika az stderr-re kerül.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nTeendő: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} már nincs meg, de egy parancsikon megnyitja: előbb módosítsa a parancsikonokat (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  ott {1} fájl és {2} mappa van\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s vagy q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  hozzáadva: [dir.{1}] és [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  hozzáadva: [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  adja meg tábla.kulcs alakban, például package.version vagy dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: nincs probléma\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: lásd a fenti problémákat (az ott megnevezett fájl ellenőrző másolat)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  a [ui] languages többi nyelve megmarad; a listát a 7-tel módosíthatja (bármely kulcs)\n"

msgid "  removed [file.%s]\n"
msgstr "  eltávolítva: [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  eltávolítva: [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  almappák:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  ez nem fér bele a TOML részhalmazba; semmi sem változott\n"

msgid "  that was not readable text; again, please\n"
msgstr "  ez nem olvasható szöveg volt; kérem, még egyszer\n"

msgid "  the program folder '%s': %s\n"
msgstr "  a programmappa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  a forrásban nincs [file] tábla, amelyre egy parancsikon mutathatna\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  a forrásban nincsenek almappák úgy, ahogy a `new` írja őket ([files] \"<folder>/<name>/**\"); adja hozzá őket a 6-tal\n"

msgid "  too long; again, please\n"
msgstr "  túl hosszú; kérem, még egyszer\n"

msgid "  y or n\n"
msgstr "  y vagy n\n"

msgid " (changed)"
msgstr " (módosítva)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) és MSIX (.msix) csomagokat készít\n\nhasználat: rubrapack [--lang <code>] <command> [arguments]\n\nparancsok:\n"

msgid " and its dir"
msgstr " és a dir-je"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) mögött nincs környezeti változó, ezért kibontható érték nem tartalmazhatja; használjon karakterlánc-értéket (telepítéskor töltődik ki)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) egy {2}: kezdhet útvonalat, vagy állhat egy értékért, amelyet a Windows Installer tölt ki (beállításjegyzék, környezet, INI, argumentumok, üzenetek), de itt nem"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nem olyan mappa, amelyből útvonal indulhat (dir-azonosító, vagy ProgramFiles, LOCALAPPDATA, ProgramData ... - lásd a kézikönyv Paths részét){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  szerkezet:    {2}\n  kivonat:      {3}\n  aláírás:      {4}\n  lánc:         {5}{6}{7}\n  visszavonás:  nincs ellenőrizve\n  időbélyeg:    {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: a változó nincs beállítva"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nem vezérlője ennek a párbeszédpanelnek"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nincs benne ebben: {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': a licencszövegnek a betűtípus angol neve kell, ezért a nyelv saját betűtípusával jelenik meg; írja be az angol nevet (például \"Malgun Gothic\"), hogy ott is ezt a betűtípust használja"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-összetevő, de a csomag platformja {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} nem tartozik ide: kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} nem tartozik ide: kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID-értékeket tartalmaz (1..65535), például 1041"

msgid "%s holds strings"
msgstr "{1} karakterláncokat tartalmaz"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} egy 1-31 karakteres betűtípusnév, például \"Segoe UI\" (kapott: {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} egy MSI-feltétel lezárt idézőjelekkel és kiegyensúlyozott zárójelekkel"

msgid "%s is an array of strings, one per value"
msgstr "{1} karakterláncok tömbje, értékenként egy"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI-csomagokhoz való: az msiexec nem távolít el MSIX-et"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} már nincs meg. Eltávolítja a(z) [file.{2}] táblát?"

msgid "%s is longer than 240 characters"
msgstr "{1} hosszabb 240 karakternél"

msgid "%s is new. Add it?"
msgstr "{1} új. Hozzáadja?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nem beállításjegyzék-formátumú GUID"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nem olyan kód, amelyet ez a rubrapack használ{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} értéke \"file:<ID>\" kell legyen, amely e csomag egy [file.*] tábláját nevezi meg"

msgid "%s must be a GUID"
msgstr "{1} csak GUID lehet"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} egy GUID kell legyen, például {12345678-...} (kapott: '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// vagy file:// cím, vagy \\\\server\\share útvonal kell legyen (kapott: '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} nem egyezhet az upgrade-code értékkel (architektúránként egy frissítési család)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} a Windows {2}. vagy újabb buildjét igényli: állítsa be: [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} igényli a resources/bin/rubrapack_ca-{2}.dll fájlt, amely nélkül ez a rubrapack készült"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nincs ellenőrizve (adja meg a --tsa-trust kapcsolót)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA megbízható"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nem megbízható - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} már nincs meg vagy üres. Eltávolítja a(z) [files.{3}] és [dir.{4}] táblát?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ új mappa. Hozzáadja?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} hiba{-3}, {4} figyelmeztetés{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} hiba{-3}, {4} figyelmeztetés{-5} (ehhez képest: {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} fájl, {3} bájt\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} fájl, {3} hiba, 0 figyelmeztetés\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: további {2} diagnosztika nem látható\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: a(z) '{2}' fájl nem [file.*] ebben a csomagban"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: a(z) '{2}' fájl nem program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "a '$(' nincs lezárva (a '$(' szöveghez írjon '$$(' alakot)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' már létezik; változatlanul marad"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' már létezik; törölje, vagy készítse egy másik mappába"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' már rendelkezik {2}-kezelővel ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' már rendelkezik engedélyekkel"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' és '{2}' ugyanaz az útvonal a csomagban"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' a Windowshoz vagy a böngészőkhöz tartozik"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' nem olvasható '{2}' alapján: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' nem fér bele a TOML részhalmazba; semmi sem lett mentve"

msgid "'%s' exists already"
msgstr "'{1}' már létezik"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' már létezik; módosítsa ezzel: `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' létezik, és nem üres mappa; bontsa ki egy újba"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' ide kerül: {2}; vagy msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' összegzőadat-adatfolyama olvashatatlan"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' nem tartalmaz Directory, Component, File és Media táblát, amelyből kibontható volna"

msgid "'%s' has no readable summary information"
msgstr "'{1}' nem tartalmaz olvasható összegzőadatokat"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nem tartalmaz '{2}' átalakítást"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' UTF-16 kódolású: az edit csak UTF-8 forrásokat módosít (előbb mentse UTF-8-ként)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' egy Windows-név; adjon más nevet a változónak"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' egy [chain]: telepítőprogramot készít, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' a beépített keret vezérlője; válasszon másik azonosítót"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' a számítógép mappája; egy {2} csomag nem írhat oda"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' egy egyesítési modul: inkább [merge.ID] segítségével egyesítse"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' olyan név, amelyet az MSIX formátum magának tart fenn"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' szimbolikus hivatkozás; a hivatkozásokat nem követi"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' egyben [property.*] is"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' egyben dir-azonosító is; adjon más nevet a változónak"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' a 0x{2} géphez készült, nem e csomag arch értékéhez; állítsa be az any-arch = true értéket, ha ez a szándék"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' se nem PE-fájl (.exe, .dll), se nem MSI-csomag, se nem MSIX-csomag vagy -köteg"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' se nem PE-fájl, se nem MSI-csomag, se nem MSIX-csomag vagy -köteg"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' se nem ismert mappa, se nem dir-azonosító (ismert mappák: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' nem olyan cabinet, amelyet a rubrapack olvasni tud (stored vagy MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' nem diagnosztikai kód (RP és négy számjegy, például RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' nem program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nem szabályos fájl"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nem rubrapack telepítőprogram{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nem érvényes azonosító (betűk, számjegyek és '_', nem kezdődhet számjeggyel, legfeljebb {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nem érvényes MSI-adatbázis: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' nem érvényes MSIX-csomag: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nem érvényes csomag: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nem érvényes forrás (a TOML részhalmaz); előbb javítsa kézzel"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nem érvényes átalakítás: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nem érvényes változónév"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' foglalt, nem használható azonosítóként"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' egy dir neve: dir-t csak beállításjegyzék- vagy dir-keresés tölthet ki"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' programfájlnak (PE) tűnik, de a fejlécei vagy erőforrásai sérültek"

msgid "'%s' must be a string"
msgstr "'{1}' csak karakterlánc lehet"

msgid "'%s' must be an integer"
msgstr "'{1}' csak egész szám lehet"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' értéke {2} és {3} között kell legyen"

msgid "'%s' must be true or false"
msgstr "'{1}' csak true vagy false lehet"

msgid "'%s' must not be empty"
msgstr "'{1}' nem lehet üres"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' nem nevez meg átalakítást (8. összegzőtulajdonság): nem javítócsomag"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' mappával kezdődik: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': a(z) {2} '{3}' ezt tartalmazza: {4}; semmi sem lett kibontva"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} bejegyzés, több a(z) {3} korlátnál (--limit-entries); semmi sem lett kibontva"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' és '{3}' Windowson ugyanaz az útvonal lenne; semmi sem lett kibontva"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nincs a [ui] languages között"

msgid "'%s': a table cannot be read"
msgstr "'{1}': egy tábla nem olvasható"

msgid "'%s': a table is unreadable"
msgstr "'{1}': egy tábla olvashatatlan"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': egy MSIX minden fájlját telepíti (when); használja a msi-only = true értéket"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': egy MSIX minden fájlját eltávolítja (keep); használja a msi-only = true értéket"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': a(z) '{2}' cabinet sérült, vagy nem stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': a(z) '{2}' cabinetnév nem egyszerű fájlnév"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': a(z) '{2}' tömörített fájlhoz ({3}. sorszám) nem tartozik cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': a(z) '{2}' könyvtár szülője, '{3}', nem létezik"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': a(z) '{2}' könyvtár saját őse, vagy túl mélyen van beágyazva"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': a(z) '{2}' fájl nem egyezik az MsiFileHash értékével"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': a(z) '{2}' fájlnak nincs összetevője vagy könyvtára"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': a(z) '{2}' fájl {3} bájt, a File tábla szerint {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': a(z) '{2}' fájl nincs a(z) '{3}' cabinetben"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': a külső cabinetjeit nem fedi le az aláírás (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': a mappája nem vezet ismert helyre"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': több mint {2} bájt írandó (--limit-bytes); semmi sem lett kibontva"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': nincs --timestamp: az aláírás érvényessége a tanúsítvány lejártával megszűnik"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': a(z) '{2}' csomag nem egyezik a SHA-256 értékével"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': a(z) '{2}' cabinet-adatfolyam nincs meg"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': a jegyzékben nincs {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
