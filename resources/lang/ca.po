# rubrapack language pack: Catalan.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: ca\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Català\n"
"X-Rubrapack-LangIDs: 1027\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, diàlegs {6}{7}\n  1 nom, fabricant, versió, arquitectura         2 carpeta d'instal·lació, per a qui\n  3 diàlegs, llicència, idiomes                  4 parts opcionals\n  5 dreceres                                     6 fitxers: igualar la carpeta del programa\n  7 qualsevol clau                               v veure   l lint   s desar   q sortir\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMissatges amb aquest codi (* representa un nom o un valor):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nEls resultats van a stdout, els diagnòstics a stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nQuè cal fer: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} ja no hi és, però una drecera l'obre: canvieu primer les dreceres (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  hi ha {1} fitxers i {2} carpetes\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s o q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  s'han afegit [dir.{1}] i [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  s'ha afegit [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  indiqueu-ho com a taula.clau, com ara package.version o dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: cap problema\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: vegeu els problemes de més amunt (el fitxer que s'hi indica és una còpia de comprovació)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  es conserven els altres idiomes de [ui] languages; canvieu aquesta llista amb 7 (qualsevol clau)\n"

msgid "  removed [file.%s]\n"
msgstr "  s'ha suprimit [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  s'ha suprimit [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subcarpetes:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  això no encaixa en el subconjunt de TOML; no s'ha canviat res\n"

msgid "  that was not readable text; again, please\n"
msgstr "  això no era text llegible; torneu-ho a provar\n"

msgid "  the program folder '%s': %s\n"
msgstr "  la carpeta del programa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  la font no té taules [file] a les quals pugui apuntar una drecera\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  la font no té subcarpetes tal com les escriu `new` ([files] \"<folder>/<name>/**\"); afegiu-les amb 6\n"

msgid "  too long; again, please\n"
msgstr "  massa llarg; torneu-ho a provar\n"

msgid "  y or n\n"
msgstr "  y o n\n"

msgid " (changed)"
msgstr " (canviat)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - crea paquets de Windows Installer (.msi) i MSIX (.msix)\n\nús: rubrapack [--lang <code>] <command> [arguments]\n\nordres:\n"

msgid " and its dir"
msgstr " i la seva carpeta"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) no té variable d'entorn, de manera que un valor expandible no el pot contenir; feu servir un valor de cadena (s'omple en instal·lar)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) és un {2}: pot començar un camí, o substituir un valor que omple el Windows Installer (registre, entorn, INI, arguments, missatges), però no aquí"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) no és una carpeta des de la qual pugui començar un camí (un ID de dir, o ProgramFiles, LOCALAPPDATA, ProgramData ... - vegeu Camins al manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  estructura:  {2}\n  resum:       {3}\n  signatura:   {4}\n  cadena:      {5}{6}{7}\n  revocació:   no comprovada\n  segell de temps: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: la variable no està definida"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' no és un control d'aquest diàleg"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' no és a {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': el text de la llicència necessita el nom anglès del tipus de lletra, de manera que es mostra amb el tipus de lletra propi de l'idioma; escriviu el nom anglès (com ara \"Malgun Gothic\") per fer servir aquest tipus de lletra també allà"

msgid "%s component, but the package platform is %.*s"
msgstr "component {1}, però la plataforma del paquet és {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} no pertany a kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} no pertany a kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} conté LANGID (1..65535), com ara 1041"

msgid "%s holds strings"
msgstr "{1} conté cadenes"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} és una llista de textos \"Clau=Valor\""

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} és un nom de tipus de lletra d'1 a 31 caràcters, com ara \"Segoe UI\" (s'ha obtingut {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} és una condició MSI amb cometes tancades i parèntesis equilibrats"

msgid "%s is an array of strings, one per value"
msgstr "{1} és una matriu de cadenes, una per valor"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} és per a paquets MSI: msiexec no suprimeix un MSIX"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} ja no hi és. Voleu suprimir [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} té més de 240 caràcters"

msgid "%s is new. Add it?"
msgstr "{1} és nou. Voleu afegir-lo?"

msgid "%s is not a GUID in registry format"
msgstr "{1} no és un GUID en format de registre"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} no és un codi que faci servir aquest rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} ha de ser \"file:<ID>\" i indicar un [file.*] d'aquest paquet"

msgid "%s must be a GUID"
msgstr "{1} ha de ser un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} ha de ser un GUID com ara {{12345678-...} (s'ha obtingut '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} ha de ser una adreça https://, http:// o file://, o un camí \\\\server\\share (s'ha obtingut '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} ha de ser diferent d'upgrade-code (una família d'actualització per arquitectura)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} necessita la compilació del Windows {2} o posterior: definiu [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} necessita resources/bin/rubrapack_ca-{2}.dll, que aquest rubrapack no inclou"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA no comprovada (indiqueu --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA de confiança"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA no de confiança - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} ja no hi és o és buit. Voleu suprimir [files.{3}] i [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ és una carpeta nova. Voleu afegir-la?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: errors: {2}{-3}, avisos: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: errors: {2}{-3}, avisos: {4}{-5} (respecte de {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} fitxers, {3} bytes\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} fitxers, {3} errors, 0 avisos\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} diagnòstics més que no es mostren\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' no és una acció estàndard que col·loqui el rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: el fitxer '{2}' no és un [file.*] d'aquest paquet"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: el fitxer '{2}' no és un programa (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' no està tancat (escriviu '$$(' per al text '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' ja existeix; es deixa tal com és"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' ja existeix; suprimiu-lo o compileu en una altra carpeta"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' ja té un controlador {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' ja té permisos"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' i '{2}' són el mateix camí dins el paquet"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' pertany al Windows o als navegadors"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' no es pot llegir respecte de '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' no encaixa en el subconjunt de TOML; no s'ha desat res"

msgid "'%s' exists already"
msgstr "'{1}' ja existeix"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' ja existeix; canvieu-lo amb `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existeix i no és un directori buit; extraieu-ho en un de nou"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' va a {2}; o msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' té un flux d'informació de resum il·legible"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' no té taules Directory, Component, File i Media d'on extreure"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' no té la transformació incrustada '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' no té informació de resum llegible"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' no té cap transformació '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' és UTF-16: edit només canvia fonts UTF-8 (deseu-lo primer com a UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' és un nom del Windows; doneu un altre nom a la variable"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' és un [chain]: crea un programa d'instal·lació, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' és un control del marc integrat; trieu un altre ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' és una carpeta de la màquina; un paquet {2} no hi pot escriure"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' és un mòdul de combinació: combineu-lo amb [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' és un nom que el format MSIX es reserva"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' és un enllaç simbòlic; els enllaços no se segueixen"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' també és un [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' també és un ID de dir; doneu un altre nom a la variable"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' està compilat per a la màquina 0x{2}, no per a l'arquitectura d'aquest paquet; definiu any-arch = true si és intencionat"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' no és ni un fitxer PE (.exe, .dll), ni un paquet MSI, ni un paquet o conjunt MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' no és ni un fitxer PE, ni un paquet MSI, ni un paquet o conjunt MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' no és ni una carpeta coneguda ni un ID de dir (carpetes conegudes: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' no és un fitxer cabinet que rubrapack pugui llegir (stored o MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' no és un codi de diagnòstic (RP i quatre xifres, com ara RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' no és un programa (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' no és un fitxer normal"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' no és un programa d'instal·lació de rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' no és un ID vàlid (lletres, xifres i '_', no comença per una xifra, com a màxim {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' no és una base de dades MSI vàlida: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' no és un paquet MSIX vàlid: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' no és un paquet vàlid: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' no és una font vàlida (el subconjunt de TOML); corregiu-la primer a mà"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' no és una transformació vàlida: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' no és un nom de variable vàlid"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' està reservat i no es pot fer servir com a ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' és el nom d'un dir: només una cerca de registre o de dir pot omplir un dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' sembla un fitxer de programa (PE), però les capçaleres o els recursos estan malmesos"

msgid "'%s' must be a string"
msgstr "'{1}' ha de ser una cadena"

msgid "'%s' must be an integer"
msgstr "'{1}' ha de ser un enter"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' ha d'estar entre {2} i {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' ha de ser true o false"

msgid "'%s' must not be empty"
msgstr "'{1}' no pot estar buit"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' no indica cap transformació (propietat de resum 8): no és un pedaç"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' comença per una carpeta: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' té {4}; no s'ha extret res"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entrades, més que el límit {3} (--limit-entries); no s'ha extret res"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' i '{3}' serien el mateix camí al Windows; no s'ha extret res"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' no és a [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': no es pot llegir una taula"

msgid "'%s': a table is unreadable"
msgstr "'{1}': una taula és il·legible"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': un MSIX instal·la tots els seus fitxers (when); feu servir msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': un MSIX suprimeix tots els seus fitxers (keep); feu servir msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': el fitxer cabinet '{2}' està malmès o no és stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': el nom de cabinet '{2}' no és un nom de fitxer simple"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': el fitxer comprimit '{2}' (seqüència {3}) no té cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': el directori '{2}' té un pare '{3}' que no hi és"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': el directori '{2}' és el seu propi avantpassat o està massa niat"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': el fitxer '{2}' no coincideix amb el seu MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': el fitxer '{2}' no té component ni directori"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': el fitxer '{2}' fa {3} bytes, la taula File diu {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': el fitxer '{2}' no és al cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': la signatura no cobreix els seus cabinets externs (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': la seva carpeta no porta a cap ubicació coneguda"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': més de {2} bytes per escriure (--limit-bytes); no s'ha extret res"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': sense --timestamp: la signatura deixa de ser vàlida quan caduca el certificat"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': el paquet '{2}' no coincideix amb el seu SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': el flux de cabinet '{2}' no hi és"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': el manifest no té {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': el manifest indica '{2}', que no és al paquet"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': segell de temps de {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': la transformació '{2}' no es pot llegir respecte de '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' és l'idioma propi del paquet ({2}); doneu aquest text sense el sufix"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' fa que el Windows Installer escrigui una cadena múltiple; feu servir type = \"multi\" i una matriu"

msgid "'_' in numbers is not supported"
msgstr "'_' als nombres no és compatible"

msgid "'help' takes at most one command name"
msgstr "'help' admet com a màxim un nom d'ordre"

msgid "'version' takes no arguments"
msgstr "'version' no admet arguments"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs és per a .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch per a un conjunt: una llista de x64, x86 i arm64, cadascun un cop (s'ha obtingut '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch admet una arquitectura, o una llista per a una sortida .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp i --allow-unsigned-cabs van amb --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress és per a .msi; un MSIX admet --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist indica una carpeta nova al costat de la font (sense camí)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
