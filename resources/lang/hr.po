msgstr "PKCS#11 token: token nema certifikat s CKA_ID ključa (navedite ga s --cert)"

msgid "Paths"
msgstr "Putanje"

msgid "Product name"
msgstr "Naziv proizvoda"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode i UpgradeCode su isti GUID"

