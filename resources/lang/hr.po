msgstr "TOML izvan podskupa koji rubrapack čita, ili `format` nedostaje ili je prenov"

msgid "Tables"
msgstr "Tablice"

msgid "The TOML subset"
msgstr "Podskup TOML-a"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Datoteke UTF-16 big-endian nisu podržane; spremite kao UTF-8"

