# rubrapack language pack: Croatian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: hr\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Hrvatski\n"
"X-Rubrapack-LangIDs: 1050, 4122\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dijalozi {6}{7}\n  1 naziv, proizvođač, verzija, arhitektura      2 mapa za instalaciju, za koga se instalira\n  3 dijalozi, licenca, jezici                    4 neobavezni dijelovi\n  5 prečaci                                      6 datoteke: uskladi s mapom programa\n  7 bilo koji ključ                              v prikaz   l lint   s spremi   q izlaz\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nPoruke s ovim kodom (* označava naziv ili vrijednost):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nRezultati idu na stdout, dijagnostika na stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nŠto učiniti: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} više ne postoji, ali ga otvara prečac: najprije promijenite prečace (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} datoteka i {2} mapa ondje\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s ili q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  dodani [dir.{1}] i [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  dodan [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  navedite ga kao table.key, npr. package.version ili dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: nema problema\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: pogledajte probleme iznad (ondje navedena datoteka je kopija za provjeru)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  ostali jezici u [ui] languages se zadržavaju; promijenite taj popis sa 7 (bilo koji ključ)\n"

msgid "  removed [file.%s]\n"
msgstr "  uklonjen [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  uklonjen [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  podmape:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  to se ne uklapa u podskup TOML-a; ništa nije promijenjeno\n"

msgid "  that was not readable text; again, please\n"
msgstr "  to nije bio čitljiv tekst; ponovno, molim\n"

msgid "  the program folder '%s': %s\n"
msgstr "  mapa programa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  izvor nema tablica [file] na koje bi prečac mogao pokazivati\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  izvor nema podmapa u obliku u kojem ih piše `new` ([files] \"<folder>/<name>/**\"); dodajte ih sa 6\n"

msgid "  too long; again, please\n"
msgstr "  predugo; ponovno, molim\n"

msgid "  y or n\n"
msgstr "  y ili n\n"

msgid " (changed)"
msgstr " (promijenjeno)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - izrađuje pakete Windows Installer (.msi) i MSIX (.msix)\n\nupotreba: rubrapack [--lang <code>] <command> [arguments]\n\nnaredbe:\n"

msgid " and its dir"
msgstr " i njegov dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) nema varijablu okruženja, pa je proširiva vrijednost ne može sadržavati; upotrijebite vrijednost niza (popunjava se pri instalaciji)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) je {2}: može započeti putanju ili zamijeniti vrijednost koju popunjava Windows Installer (registar, okruženje, INI, argumenti, poruke), ali ne ovdje"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nije mapa od koje može započeti putanja (dir ID, ili ProgramFiles, LOCALAPPDATA, ProgramData ... - pogledajte Paths u priručniku){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktura:    {2}\n  sažetak:      {3}\n  potpis:       {4}\n  lanac:        {5}{6}{7}\n  opoziv:       nije provjereno\n  vremenski žig: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: varijabla nije postavljena"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nije kontrola ovog dijaloga"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nije u {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': tekst licence treba engleski naziv fonta, pa se prikazuje fontom samog jezika; napišite engleski naziv (npr. \"Malgun Gothic\") da se taj font koristi i ondje"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' mora biti mapa"

msgid "%s component, but the package platform is %.*s"
msgstr "komponenta {1}, ali platforma paketa je {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} ne pripada kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} ne pripada kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} sadrži LANGID-ove (1..65535), npr. 1041"

msgid "%s holds strings"
msgstr "{1} sadrži nizove"

msgid "%s is %u to %u characters long"
msgstr "{1} je dug {2} do {3} znakova"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} je popis tekstova \"Ključ=Vrijednost\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} je popis tekstova, npr. [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} je naziv fonta od 1 do 31 znaka, npr. \"Segoe UI\" (dobiveno {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} je MSI uvjet sa zatvorenim navodnicima i uravnoteženim zagradama"

msgid "%s is an array of strings, one per value"
msgstr "{1} je polje nizova, po jedan za svaku vrijednost"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} je za MSI pakete: MSIX ne uklanja msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} više ne postoji. Ukloniti [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} je dulje od 240 znakova"

msgid "%s is new. Add it?"
msgstr "{1} je novo. Dodati?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nije GUID u formatu registra"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nije kod koji ovaj rubrapack koristi{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} mora biti \"file:<ID>\" koji imenuje [file.*] ovog paketa"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} mora imati od {2} do {3} slova, znamenki, '.' ili '-' i ne smije počinjati s '.' (dobiveno '{4}')"

msgid "%s must be a GUID"
msgstr "{1} mora biti GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} mora biti GUID kao {{12345678-...} (dobiveno '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} mora biti adresa http:// ili https:// (dobiveno '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} mora biti adresa https://, http:// ili file://, ili putanja \\\\server\\share (dobiveno '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} se mora razlikovati od upgrade-code (jedna obitelj nadogradnje po arhitekturi)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} treba Windows build {2} ili noviji: postavite [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} treba resources/bin/rubrapack_ca-{2}.dll, bez kojeg je ovaj rubrapack izgrađen"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nije provjeren (navedite --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA je pouzdan"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nije pouzdan - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} ne postoji ili je prazna. Ukloniti [files.{3}] i [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ je nova mapa. Dodati?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: pogreške: {2}{-3}, upozorenja: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: pogreške: {2}{-3}, upozorenja: {4}{-5} (u odnosu na {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} datoteka, {3} bajtova\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} datoteka, {3} pogrešaka, 0 upozorenja\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: još {2} dijagnostika nije prikazano\n"

msgid "%s: '%s' is not a program (.exe)"
msgstr "{1}: '{2}' nije program (.exe)"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' nije standardna radnja koju rubrapack postavlja"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: datoteka '{2}' nije [file.*] ovog paketa"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: datoteka '{2}' nije program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' nije zatvoreno (napišite '$$(' za tekst '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' već postoji; ostaje kakav jest"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' već postoji; uklonite ga ili izgradite u drugu mapu"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' već ima rukovatelj {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' već ima dozvole"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' i '{2}' su ista putanja u paketu"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' pripada Windowsu ili preglednicima"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' ne može se pročitati u odnosu na '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' se ne uklapa u podskup TOML-a; ništa nije spremljeno"

msgid "'%s' exists already"
msgstr "'{1}' već postoji"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' već postoji; promijenite ga s `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' postoji i nije prazan direktorij; raspakirajte u novi"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' ide u {2}; ili msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' ima nečitljiv tok sažetka informacija"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' nema tablice Directory, Component, File i Media iz kojih bi se raspakiralo"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' nema ugrađenu transformaciju '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' nema čitljiv sažetak informacija"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nema transformaciju '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' je UTF-16: edit mijenja samo UTF-8 izvore (najprije ga spremite kao UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' je naziv Windowsa; dajte varijabli drugi naziv"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' je [chain]: izrađuje instalacijski program, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' je kontrola ugrađenog okvira; odaberite drugi ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' je mapa računala; paket {2} ne može pisati ondje"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' je modul za spajanje: spojite ga s [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' je naziv koji format MSIX zadržava za sebe"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' je simbolička veza; veze se ne slijede"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' je također [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' je također dir ID; dajte varijabli drugi naziv"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' je izgrađen za stroj 0x{2}, a ne za arhitekturu ovog paketa; postavite any-arch = true ako je to namjerno"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nije ni PE datoteka (.exe, .dll), ni MSI paket, ni MSIX paket ili skup, ni cabinet"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nije ni PE datoteka, ni MSI paket, ni MSIX paket ili skup, ni cabinet"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nije ni poznata mapa ni dir ID (poznate mape: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' nije ni MSIX paket ni naziv obitelji paketa (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' nije cabinet koji rubrapack može čitati (stored ili MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' nije dijagnostički kod (RP i četiri znamenke, npr. RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' nije program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nije obična datoteka"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nije instalacijski program rubrapacka{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nije valjan ID (slova, znamenke i '_', ne počinje znamenkom, najviše {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nije valjana MSI baza podataka: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' nije valjan MSIX paket: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nije valjan paket: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nije valjan izvor (podskup TOML-a); najprije ga ispravite ručno"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nije valjana transformacija: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nije valjan naziv varijable"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' je rezervirano i ne može se koristiti kao ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' je naziv dira: samo pretraživanje registra ili dira može popuniti dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' izgleda kao programska datoteka (PE), ali su joj zaglavlja ili resursi oštećeni"

msgid "'%s' must be a string"
msgstr "'{1}' mora biti niz"

msgid "'%s' must be an integer"
msgstr "'{1}' mora biti cijeli broj"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' mora biti između {2} i {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' mora biti true ili false"

msgid "'%s' must not be empty"
msgstr "'{1}' ne smije biti prazno"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' ne imenuje transformacije (svojstvo sažetka 8): nije zakrpa"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' počinje mapom: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' ima {4}; ništa nije raspakirano"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} unosa, više od ograničenja {3} (--limit-entries); ništa nije raspakirano"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' i '{3}' bili bi ista putanja u Windowsu; ništa nije raspakirano"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nije u [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': tablica se ne može pročitati"

msgid "'%s': a table is unreadable"
msgstr "'{1}': tablica je nečitljiva"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX instalira sve svoje datoteke (when); upotrijebite msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX uklanja sve svoje datoteke (keep); upotrijebite msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' je oštećen ili nije stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': naziv cabineta '{2}' nije običan naziv datoteke"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimirana datoteka '{2}' (slijed {3}) nema cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': direktorij '{2}' ima roditelja '{3}' koji ne postoji"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': direktorij '{2}' je sam sebi predak ili je predubok"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': datoteka '{2}' ne odgovara svom MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': datoteka '{2}' nema komponentu ili direktorij"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': datoteka '{2}' ima {3} bajtova, a tablica File navodi {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': datoteka '{2}' nije u cabinetu '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': njegovi vanjski cabineti nisu obuhvaćeni potpisom (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': njegova mapa ne vodi do poznatog mjesta"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': više od {2} bajtova za pisanje (--limit-bytes); ništa nije raspakirano"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': nema --timestamp: potpis prestaje vrijediti kad certifikat istekne"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': paket '{2}' ne odgovara svom SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': tok cabineta '{2}' ne postoji"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifest nema {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifest navodi '{2}', koji nije u paketu"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': vremenski žig od {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformacija '{2}' ne može se pročitati u odnosu na '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' je vlastiti jezik paketa ({2}); navedite taj tekst bez sufiksa"

