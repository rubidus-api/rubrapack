msgstr "--key-store prima SHA-1 otisak certifikata (40 heksadecimalnih znamenki)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: nema takvog jezika (ugrađeni: {2}; drugi treba svoj jezični paket, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (ili RUBRAPACK_LANG) bira jezik ovih tekstova: {1}, ili jezik s jezičnim paketom.\n"

