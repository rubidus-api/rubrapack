msgstr "ProductVersion {1} nije viša od prethodne {2} u prva tri polja: Windows Installer ne nadograđuje"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Program koji prečaci otvaraju (- za bez prečaca)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: nema takvog jezika (ugrađeni: {2}; drugi treba svoj jezični paket, {3}.po)"

msgid "Reference, "
msgstr "Referenca, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Slijed {1} nije obuhvaćen nijednim retkom Media (posljednji {2})"

msgid "Sequence %ld is used by another file"
msgstr "Slijed {1} koristi druga datoteka"

msgid "Source file to write"
msgstr "Izvorna datoteka za pisanje"

msgid "Source format"
msgstr "Format izvora"

msgid "Source must name a File row for type %ld"
msgstr "Source mora imenovati redak File za vrstu {1}"

msgid "Start menu shortcut?"
msgstr "Prečac u izborniku Start?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Unosi izbornika Start, Programs, radne površine i Startup dolaze iz [shortcut.*] i [msix-extension.*]"

