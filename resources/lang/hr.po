msgstr "--lang treba jezik, npr. en ili ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages treba dijaloge: navedite i --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress prima deflate ili store (dobiveno '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: varijabla nije postavljena"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code prima GUID velikim slovima s vitičastim zagradama: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: varijabla nije postavljena"

msgid "--previous compares two .msi packages"
msgstr "--previous uspoređuje dva .msi paketa"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: korijenski certifikati operacijskog sustava ne mogu se pročitati"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} ne odgovara izlazu '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} nije implementiran (msi ili msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target prima msi ili msix (dobiveno '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots i --proxy idu s --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test i --msix-compress su za .msix izlaze"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test je za pakete bez potpisa; s --key ga izostavite"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate prima none ili neke od product-code,upgrade-code,language,platform"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget je za izlaz .msi, .msix ili .msixbundle"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget treba tablicu [winget]: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget treba paket u jednoj datoteci: winget preuzima jednu, dakle ne cab = \"external\""

msgid "-D %.*s is given twice"
msgstr "-D {1} je naveden dvaput"

