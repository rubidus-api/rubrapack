msgstr "--compress je za .msi; MSIX prima --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist imenuje novu mapu pokraj izvora (bez putanje)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat je za izlaz .msixbundle (njegovi se paketi zapisuju pokraj njega)"

