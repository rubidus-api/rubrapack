msgstr "'_' u brojevima nije podržan"

msgid "'help' takes at most one command name"
msgstr "'help' prima najviše jedan naziv naredbe"

msgid "'version' takes no arguments"
msgstr "'version' ne prima argumente"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs je za .msi"

