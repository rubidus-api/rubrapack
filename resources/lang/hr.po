msgstr "[file.{1}]: '{2}' nije .NET sklop (nema CLI zaglavlja s retkom Assembly)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: .NET sklop sam nosi svoj manifest; manifest je za Win32 sklop"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: Win32 sklop treba manifest = \"file:<ID>\", svoju datoteku manifesta"

