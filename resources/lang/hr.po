msgstr "[file.{1}]: manifest navodi publicKeyToken \"{2}\", ali token ključa --key je \"{3}\""

msgid "[file.%s]: %s"
msgstr "[file.{1}]: {2}"

msgid "[file.%s]: a shared Win32 assembly's manifest '%s' names its signer: publicKeyToken in assemblyIdentity (the token of the --key it is built with)"
msgstr "[file.{1}]: manifest '{2}' dijeljenog Win32 sklopa navodi potpisnika: publicKeyToken u assemblyIdentity (token ključa --key s kojim se gradi)"

msgid "a shared Win32 assembly's catalog needs an RSA key of 2048 bits or more"
msgstr "katalog dijeljenog Win32 sklopa treba RSA ključ od 2048 bita ili više"

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for i manifest idu uz assembly = \"dotnet\" ili \"win32\""

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: njegov manifest '{2}' nema assemblyIdentity s name i version"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: njegov manifest '{2}' mora biti u istom dir i feature (i pod istim when): oba su jedna komponenta"

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: manifest '{2}' pripada drugom sklopu ili je i sam sklop"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer učitava rukovatelj {2} iz DLL-a; [com.{3}] je program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows čita rukovatelje svojstava samo po računalu; paket treba scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: rukovatelj pretpregleda radi u prevhostu Windowsa; izostavite app-id i surrogate iz [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX nosi samo rukovatelje minijatura i pretpregleda (pakirani rukovatelj svojstava nije dao vrijednosti Exploreru); msi-only = true zadržava ga za MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: vrsta datoteke MSIX-a pripada aplikaciji; dodajte [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: klasa {2} nije [com.*] ovog paketa (DLL rukovatelja je poslužuje)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: u MSIX-u rukovatelji dijele sve svoje vrste ili nijednu (vrsta je u jednom pridruživanju vrste datoteke)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: u MSIX-u njegova klasa radi u surrogateu; threading = \"sta\" u [com.{2}] daje njezinom prozoru petlju poruka (uz threading = {3} pretpregled može ostati prazan)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: u MSIX-u sve su njegove vrste u jednoj vrsti datoteke [assoc] ili ni u jednoj"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: njegova klasa je msi-only ([com.{2}]); MSIX ne bi imao poslužitelj za nju"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types je popis vrsta datoteka, npr. [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] ide u {2}; ili msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] treba 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] treba značajku: postavite 'feature' ovdje ili na njegov dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX zapisuje sve svoje INI unose (when); upotrijebite msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: njegova vrijednost ima dio koji Windows Installer popunjava pri instalaciji ([...]); MSIX zapisuje datoteku kad se izgrađuje"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] treba 'on': gdje se stavka prikazuje, npr. [\".txt\"] ili \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] treba 'target' (program koji pokreće) ili stavke s parent = \"{2}\" (podizbornik)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] treba 'target': program koji stavka pokreće"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: izbornik sustava Windows 11 prima ID samo od slova i znamenki (bez '_'): preimenujte ga ili postavite windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: podizbornik ništa ne pokreće: izostavite 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: stavka podizbornika prikazuje se gdje i njezin podizbornik: izostavite 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args ima dio koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksni tekst"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when je \"HKCU\\\\key\\\\value\" ili \"HKLM\\\\...\", na stavci izbornika sustava Windows 11 koja nije u podizborniku"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when navodi vrijednost koju zapisuje sam ovaj paket ([registry.{2}]): stavka se nikad ne bi prikazala"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: njegov program nije u MSIX-u (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: njegove vrijednosti ne mogu ući u registar paketa"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list ima dio koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksni tekst"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list zamjenjuje {2} kad putovi ne stanu u naredbeni redak: potrebni su multi = \"one\", {3} u args i {4} (datoteka popisa) u list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": nema [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on je vrsta datoteke ili popis vrsta, npr. [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' nije [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' mora biti podizbornik: [menu.*] bez targeta i bez vlastitog parenta"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] ide u {2}; ili msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] treba značajku: postavite 'feature' ovdje ili na njegov dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; ili msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] treba feature (ili with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature ide s vlastitom komponentom, ne s with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name navodi jednu datoteku; name ima zamjenske znakove"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: cilj dijeljenja treba types, formats ili oboje"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: rukovatelj automatske reprodukcije treba content-events, device-events ili oboje"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events trebaju class (COM klasu IHWEventHandler programa)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file mora biti {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file mora imenovati datoteku koja ulazi u paket"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file mora imenovati program koji ulazi u paket"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types je popis vrsta datoteka, npr. [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows prima samo slova i znamenke"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "[msix-psf] za arm64 treba launcher = \"...\" (PSF svoje pokretače naziva PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] ne ide ni s external-location = true ni s [env.*] (vlastitim pokretačem rubrapacka)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] pokreće aplikacije preko PSF pokretača: treba mu [msix-app.ID]"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' ne navodi aplikaciju '{2}' u svojim \"applications\""

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files nema '{1}' (pokretač)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: datoteka '{2}' nije DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] svoj upravljački program navodi jednom: driver (jedan [odbc-driver]) ili driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] s driver-name treba with = \"file:<ID>\": komponentu s kojom se instalira"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: paket po računalu registrira izvore podataka za računalo"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] navodi jednu kopiju: msix (s publisher) ili upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix je naziv identiteta paketa (3 do 50 slova, znamenki, '.' ili '-') i traži publisher (\"CN=...\"), kako ih ima njegov manifest"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: drugu kopiju traži prethodna provjera: potrebno je preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code pripada ovom paketu (to je nadogradnja, a ne druga kopija)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] treba da njegov dir ima značajku"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: u MSIX-u shema otvara aplikaciju: target mora biti izvršna datoteka [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] treba 'value' (ili remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR ne seže izvan MSIX-a; upotrijebite [assoc.*], [protocol.*], [com.*] ili [handler.*], ili msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword vrijednost treba pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX nosi vrijednosti samo ispod {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX niti uklanja vrijednosti niti ih ostavlja (remove, keep); upotrijebite msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX zapisuje sve svoje vrijednosti (when); upotrijebite msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: njegova vrijednost ima dio koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksne vrijednosti"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" treba pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: naziv ključa ili vrijednosti ne može ući u hive registra"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" je za root = \"HKCU\" s on = \"uninstall\", u paketu za računalo"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] treba značajku: postavite 'feature' ovdje ili na njegov dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true nije za mapu ispod {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true treba pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" je za recursive = true na mapi u AppData ili LocalAppData, u paketu za računalo"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file mora imenovati program koji ulazi u paket"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] oglašava značajku '{2}', koja ima advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise se ne kombinira s when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX ima prečace samo na radnoj površini i u izborniku Start{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX prečac nema working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX prečac uvijek postoji (when je za MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX prečac prikazuje logotip svoje aplikacije; icon je za MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: oglašavani prečac je za MSI (MSIX instalira cijeli paket)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: oglašavani prečac treba ikonu"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: u MSIX-u prečac pokreće aplikaciju: target mora biti izvršna datoteka [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: unos izbornika Start u MSIX-u je njegova aplikacija, koja ne prima args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: nijedan tekst dijaloga nema ovaj ID"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded je za MSI; MSIX nema vlastito instalacijsko sučelje"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] treba ui = \"basic\" ili drugi skup dijaloga u [package] (ili embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "izlazna sekvenca \\{1} nije skalarna vrijednost Unicodea"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: ovaj paket ne bi čisto nadogradio prethodni"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` paketa: dijalozi, kodna stranica, normalizacija teksta"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` MSIX paketa ili skupa"

msgid "a %s control has no property"
msgstr "kontrola {1} nema property"

msgid "a %s control has no text; put a text control beside it"
msgstr "kontrola {1} nema tekst; stavite tekstnu kontrolu pokraj nje"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "kontrola {1} treba [property.{2}] s jednom od njezinih vrijednosti kao zadanom (tiha instalacija je koristi)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "paket {1} ne može pisati u HKLM; upotrijebite HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "izlaz .msix treba tablicu [msix-app.ID] koja imenuje izvršnu datoteku"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "izlaz .msix treba tablicu [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "izlaz .msm je modul za spajanje, izgrađen iz izvora s [module] umjesto [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "datoteka .txt, .md ili .rtf, ili - za nijednu"

msgid "a PE file without a certificate table entry"
msgstr "PE datoteka bez unosa tablice certifikata"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN se nikad ne uzima iz naredbenog retka (drugi ga mogu vidjeti); upotrijebite --pin-env ili --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "Package manifesta skupa nepoznatog Typea"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "Package manifesta skupa bez FileName, Offset ili Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "ZIP unos se ne raspakira na svoju veličinu"

msgid "a ZIP entry larger than allowed"
msgstr "ZIP unos veći od dopuštenog"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "CRC-32 ZIP unosa ne odgovara"

msgid "a ZIP entry's data lies outside the file"
msgstr "podaci ZIP unosa su izvan datoteke"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "izvor [module] izrađuje modul za spajanje: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "binarna vrijednost je paran broj heksadecimalnih znamenki, npr. \"01A0FF\""

msgid "a bundle without packages"
msgstr "skup bez paketa"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "certifikat u putanji ima kritično proširenje koje rubrapack ne razumije"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "certifikat u putanji potpisan je certifikatom koji nije CA"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "lanac sadrži samo [chain], [chain-package.ID] i [define], ne [{1}]; paketi se izrađuju iz vlastitih izvora"

msgid "a chain holds at most %d packages"
msgstr "lanac sadrži najviše {1} paketa"

msgid "a chain needs [chain]"
msgstr "lanac treba [chain]"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "lanac treba barem jedan [chain-package.ID]"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "znak koji Windows ne dopušta u nazivu (/ \\ : * ? \" < > |)"

msgid "a container holds at most %u package families"
msgstr "spremnik drži najviše {1} obitelji paketa"

msgid "a control character"
msgstr "kontrolni znak"

msgid "a damaged PE optional header"
msgstr "oštećeno PE neobavezno zaglavlje"

msgid "a damaged PE section table"
msgstr "oštećena PE tablica sekcija"

msgid "a damaged ZIP64 end record"
msgstr "oštećen završni zapis ZIP64"

msgid "a damaged cabinet header"
msgstr "oštećeno zaglavlje cabineta"

msgid "a damaged hive bin"
msgstr "oštećen hive bin"

msgid "a diagnostic of rubrapack"
msgstr "dijagnostika rubrapacka"

msgid "a disabled service cannot be started"
msgstr "onemogućena usluga ne može se pokrenuti"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "dvojni paket ne može birati između korisničke i sistemske varijable"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "dvojni paket piše u HKMU (HKLM ili HKCU prema instalaciji), ne u HKCU"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "dword vrijednost je cijeli broj 0..4294967295 (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "značajka koju ovaj rubrapack ne pruža (ili je izgrađen bez nje)"

msgid "a file larger than allowed"
msgstr "datoteka veća od dopuštenog"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "naziv datoteke ispod '{1}' nije valjan Unicode i ne može se pakirati"

