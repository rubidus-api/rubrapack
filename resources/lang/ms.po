# rubrapack language pack: Malay.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: ms\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Bahasa Melayu\n"
"X-Rubrapack-LangIDs: 1086, 2110\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 2\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialog {6}{7}\n  1 nama, pengilang, versi, seni bina            2 folder pemasangan, dipasang untuk siapa\n  3 dialog, lesen, bahasa                        4 bahagian pilihan\n  5 pintasan                                     6 fail: padankan dengan folder program\n  7 sebarang kunci                               v lihat   l lint   s simpan   q keluar\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMesej dengan kod ini (* mewakili nama atau nilai):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nHasil dihantar ke stdout, diagnostik ke stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nApa yang perlu dibuat: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} sudah tiada, tetapi ada pintasan yang membukanya: tukar pintasan (5) dahulu\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} fail dan {2} folder di sana\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s atau q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  menambah [dir.{1}] dan [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  menambah [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  tulis sebagai table.key, contohnya package.version atau dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: tiada masalah\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: lihat masalah di atas (fail yang dinamakan di sana ialah salinan semakan)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  bahasa lain dalam [ui] languages dikekalkan; tukar senarai itu dengan 7 (sebarang kunci)\n"

msgid "  removed [file.%s]\n"
msgstr "  membuang [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  membuang [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subfolder:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  itu tidak sesuai dengan subset TOML; tiada apa yang diubah\n"

msgid "  that was not readable text; again, please\n"
msgstr "  itu bukan teks yang boleh dibaca; sila ulang\n"

msgid "  the program folder '%s': %s\n"
msgstr "  folder program '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  sumber tiada jadual [file] untuk ditujui pintasan\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  sumber tiada subfolder seperti yang ditulis oleh `new` ([files] \"<folder>/<name>/**\"); tambahkannya dengan 6\n"

msgid "  too long; again, please\n"
msgstr "  terlalu panjang; sila ulang\n"

msgid "  y or n\n"
msgstr "  y atau n\n"

msgid " (changed)"
msgstr " (diubah)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - membina pakej Windows Installer (.msi) dan MSIX (.msix)\n\npenggunaan: rubrapack [--lang <code>] <command> [arguments]\n\narahan:\n"

msgid " and its dir"
msgstr " dan dir-nya"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) tiada pemboleh ubah persekitaran, jadi nilai boleh kembang tidak dapat memuatkannya; gunakan nilai rentetan (diisi semasa pemasangan)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) ialah {2}: ia boleh memulakan laluan, atau menggantikan nilai yang diisi oleh Windows Installer (pendaftaran, persekitaran, INI, argumen, mesej), bukan di sini"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) bukan folder permulaan laluan (ID dir, atau ProgramFiles, LOCALAPPDATA, ProgramData ... - lihat Paths dalam manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktur:     {2}\n  digest:       {3}\n  tandatangan:  {4}\n  rantai:       {5}{6}{7}\n  pembatalan:   tidak disemak\n  cap masa:     {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: pemboleh ubah tidak ditetapkan"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' bukan kawalan dialog ini"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' tiada dalam {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': teks lesen memerlukan nama fon dalam bahasa Inggeris, jadi ia dipaparkan dengan fon bahasa itu sendiri; tulis nama bahasa Inggerisnya (seperti \"Malgun Gothic\") supaya fon ini digunakan di sana juga"

msgid "%s component, but the package platform is %.*s"
msgstr "komponen {1}, tetapi platform pakej ialah {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} bukan milik kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} bukan milik kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} mengandungi LANGID (1..65535), seperti 1041"

msgid "%s holds strings"
msgstr "{1} mengandungi rentetan"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} ialah senarai teks \"Kunci=Nilai\""

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} ialah nama fon 1 hingga 31 aksara, seperti \"Segoe UI\" (diterima {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} ialah syarat MSI dengan tanda petik tertutup dan kurungan seimbang"

msgid "%s is an array of strings, one per value"
msgstr "{1} ialah tatasusunan rentetan, satu bagi setiap nilai"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} untuk pakej MSI: MSIX tidak dibuang oleh msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} sudah tiada. Buang [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} lebih panjang daripada 240 aksara"

msgid "%s is new. Add it?"
msgstr "{1} baharu. Tambah?"

msgid "%s is not a GUID in registry format"
msgstr "{1} bukan GUID dalam format pendaftaran"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} bukan kod yang digunakan oleh rubrapack ini{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} mesti \"file:<ID>\" yang menamakan [file.*] dalam pakej ini"

msgid "%s must be a GUID"
msgstr "{1} mesti GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} mesti GUID seperti {{12345678-...} (diterima '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} mesti alamat https://, http:// atau file://, atau laluan \\\\server\\share (diterima '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} mesti berbeza daripada upgrade-code (satu keluarga naik taraf bagi setiap seni bina)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} memerlukan Windows build {2} atau lebih baharu: tetapkan [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} memerlukan resources/bin/rubrapack_ca-{2}.dll, yang tidak disertakan semasa rubrapack ini dibina"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA tidak disemak (berikan --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA dipercayai"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA tidak dipercayai - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} sudah tiada atau kosong. Buang [files.{3}] dan [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ ialah folder baharu. Tambah?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} ralat{-3}, {4} amaran{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} ralat{-3}, {4} amaran{-5} (berbanding {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} fail, {3} bait\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} fail, {3} ralat, 0 amaran\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} lagi diagnostik tidak dipaparkan\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' bukan tindakan standard yang diletakkan oleh rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: fail '{2}' bukan [file.*] dalam pakej ini"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: fail '{2}' bukan program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' tidak ditutup (tulis '$$(' untuk teks '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' sudah wujud; dibiarkan seperti sedia ada"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' sudah wujud; buang atau bina ke folder lain"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' sudah mempunyai pengendali {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' sudah mempunyai kebenaran"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' dan '{2}' ialah laluan yang sama dalam pakej"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' milik Windows atau pelayar"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' tidak dapat dibaca berbanding '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' tidak sesuai dengan subset TOML; tiada apa yang disimpan"

msgid "'%s' exists already"
msgstr "'{1}' sudah wujud"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' sudah wujud; tukar dengan `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' wujud dan bukan direktori kosong; ekstrak ke direktori baharu"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' pergi ke {2}; atau msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' mempunyai strim maklumat ringkasan yang tidak boleh dibaca"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' tiada jadual Directory, Component, File dan Media untuk diekstrak"

msgid "'%s' has no readable summary information"
msgstr "'{1}' tiada maklumat ringkasan yang boleh dibaca"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' tiada transform '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' ialah UTF-16: edit hanya mengubah sumber UTF-8 (simpan sebagai UTF-8 dahulu)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' ialah nama Windows; beri pemboleh ubah nama lain"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' ialah [chain]: ia membina program persediaan, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' ialah kawalan bingkai terbina dalam; pilih ID lain"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' ialah folder mesin; pakej {2} tidak boleh menulis di sana"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' ialah modul gabungan: gabungkannya dengan [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' ialah nama yang dikhaskan oleh format MSIX untuk dirinya"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' ialah pautan simbolik; pautan tidak diikuti"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' juga ialah [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' juga ID dir; beri pemboleh ubah nama lain"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' dibina untuk mesin 0x{2}, bukan seni bina pakej ini; tetapkan any-arch = true jika memang disengajakan"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' bukan fail PE (.exe, .dll), pakej MSI, mahupun pakej atau himpunan MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' bukan fail PE, pakej MSI, mahupun pakej atau himpunan MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' bukan folder yang dikenali mahupun ID dir (folder dikenali: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' bukan cabinet yang boleh dibaca oleh rubrapack (stored atau MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' bukan kod diagnostik (RP dan empat digit, seperti RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' bukan program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' bukan fail biasa"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' bukan program persediaan rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' bukan ID yang sah (huruf, digit dan '_', tidak bermula dengan digit, paling banyak {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' bukan pangkalan data MSI yang sah: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' bukan pakej MSIX yang sah: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' bukan pakej yang sah: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' bukan sumber yang sah (subset TOML); betulkan secara manual dahulu"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' bukan transform yang sah: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' bukan nama pemboleh ubah yang sah"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' dikhaskan dan tidak boleh digunakan sebagai ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' ialah nama dir: hanya carian pendaftaran atau dir boleh mengisi dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' kelihatan seperti fail program (PE) tetapi pengepala atau sumbernya rosak"

msgid "'%s' must be a string"
msgstr "'{1}' mesti rentetan"

msgid "'%s' must be an integer"
msgstr "'{1}' mesti integer"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' mesti antara {2} dan {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' mesti true atau false"

msgid "'%s' must not be empty"
msgstr "'{1}' tidak boleh kosong"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' tidak menamakan transform (sifat ringkasan 8): bukan tampalan"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' bermula dengan folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' mempunyai {4}; tiada apa yang diekstrak"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entri, melebihi had {3} (--limit-entries); tiada apa yang diekstrak"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' dan '{3}' akan menjadi laluan yang sama pada Windows; tiada apa yang diekstrak"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' tiada dalam [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': sebuah jadual tidak dapat dibaca"

msgid "'%s': a table is unreadable"
msgstr "'{1}': sebuah jadual tidak boleh dibaca"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX memasang semua failnya (when); gunakan msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX membuang semua failnya (keep); gunakan msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' rosak atau bukan stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': nama cabinet '{2}' bukan nama fail biasa"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': fail termampat '{2}' (jujukan {3}) tiada cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': direktori '{2}' mempunyai induk '{3}' yang tiada"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': direktori '{2}' ialah leluhurnya sendiri atau bersarang terlalu dalam"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': fail '{2}' tidak sepadan dengan MsiFileHash-nya"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': fail '{2}' tiada komponen atau direktori"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': fail '{2}' bersaiz {3} bait, jadual File menyatakan {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': fail '{2}' tiada dalam cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': cabinet luarannya tidak diliputi tandatangan (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': foldernya tidak membawa ke lokasi yang dikenali"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': lebih daripada {2} bait untuk ditulis (--limit-bytes); tiada apa yang diekstrak"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': tiada --timestamp: tandatangan tidak lagi sah apabila sijil tamat tempoh"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': pakej '{2}' tidak sepadan dengan SHA-256-nya"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': strim cabinet '{2}' tiada"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifest tiada {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifest menamakan '{2}', yang tiada dalam pakej"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': cap masa daripada {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transform '{2}' tidak dapat dibaca berbanding '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' ialah bahasa pakej itu sendiri ({2}); berikan teks itu tanpa akhiran"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' menyebabkan Windows Installer menulis multi-string; gunakan type = \"multi\" dan tatasusunan"

msgid "'_' in numbers is not supported"
msgstr "'_' dalam nombor tidak disokong"

msgid "'help' takes at most one command name"
msgstr "'help' menerima paling banyak satu nama arahan"

msgid "'version' takes no arguments"
msgstr "'version' tidak menerima argumen"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs untuk .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch untuk himpunan: senarai x64, x86 dan arm64, setiap satu sekali (diterima '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch menerima satu seni bina, atau senarai untuk output .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp dan --allow-unsigned-cabs digunakan bersama --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress untuk .msi; MSIX menerima --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist menamakan folder baharu di sebelah sumber (tanpa laluan)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs menerima nombor 1 hingga 64 (diterima '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
