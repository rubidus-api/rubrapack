msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} vyžaduje resources/bin/rubrapack_ca-{2}.dll, bez které byl tento rubrapack sestaven"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nekontrolováno (zadejte --tsa-trust)"

