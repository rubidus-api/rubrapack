msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': časové razítko z {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformaci '{2}' nelze číst oproti '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' je vlastní jazyk balíčku ({2}); zadejte ten text bez přípony"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' způsobí, že Instalační služba systému Windows zapíše vícenásobný řetězec; použijte type = \"multi\" a pole"

msgid "'_' in numbers is not supported"
msgstr "'_' v číslech není podporováno"

msgid "'help' takes at most one command name"
msgstr "'help' přijímá nejvýše jeden název příkazu"

msgid "'version' takes no arguments"
msgstr "'version' nepřijímá argumenty"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs je pro .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch pro sadu: seznam x64, x86 a arm64, každá jednou (zadáno '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch přijímá jednu architekturu, nebo seznam pro výstup .msixbundle / .msixupload"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp a --allow-unsigned-cabs patří k --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress je pro .msi; MSIX přijímá --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist pojmenuje novou složku vedle zdroje (bez cesty)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat je pro výstup .msixbundle (jeho balíčky se zapíší vedle něj)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs přijímá číslo od 1 do 64 (zadáno '{1}')"

msgid "--key signs at most %d external cabinets; raise cab-max-size"
msgstr "--key podepíše nejvýše {1} externích cabinetů; zvyšte cab-max-size"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store je úložiště certifikátů Windows; jinde použijte soubor klíče nebo --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store přijímá kryptografický otisk SHA-1 certifikátu (40 šestnáctkových číslic)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: takový jazyk neexistuje (vestavěné: {2}; jiný potřebuje svůj jazykový balíček, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (nebo RUBRAPACK_LANG) volí jazyk těchto textů: {1}, nebo jazyk s jazykovým balíčkem.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang potřebuje jazyk, například en nebo ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages potřebuje dialogy: zadejte také --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress přijímá deflate nebo store (zadáno '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: proměnná není nastavena"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code přijímá GUID velkými písmeny se složenými závorkami: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: proměnná není nastavena"

msgid "--previous compares two .msi packages"
msgstr "--previous porovnává dva balíčky .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: kořenové certifikáty operačního systému nelze číst"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} neodpovídá výstupu '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} není implementován (msi nebo msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target přijímá msi nebo msix (zadáno '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots a --proxy patří k --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test a --msix-compress jsou pro výstupy .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test je pro balíčky bez podpisu; s --key ho vynechte"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate přijímá none, nebo některé z product-code,upgrade-code,language,platform"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget je pro výstup .msi, .msix nebo .msixbundle"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget potřebuje tabulku [winget]: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget potřebuje balíček v jednom souboru: winget stahuje jeden, tedy ne cab = \"external\""

msgid "-D %.*s is given twice"
msgstr "-D {1} je zadáno dvakrát"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' je název systému Windows; pojmenujte proměnnou jinak"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D potřebuje NÁZEV=HODNOTA (zadáno '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i se ptá na každou odpověď; zadejte buď -i, nebo volby"

msgid "; its range is "
msgstr "; jeho rozsah je "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' není v SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty musí být veřejná vlastnost (velká písmena)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "Všechny kódy: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x nezačíná PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x není poslední položka"

