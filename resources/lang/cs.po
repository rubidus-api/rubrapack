msgstr "{1} musí být adresa https://, http:// nebo file://, nebo cesta \\\\server\\share (zadáno '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} se musí lišit od upgrade-code (jedna rodina upgradů na architekturu)"

