msgstr "Hlavní program, pro zástupce (- pro žádný)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "Příručka: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Výrobce"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Výrobce (zobrazuje se v Nainstalovaných aplikacích)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt vrátil podpis ECDSA nesprávné délky"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "Volitelné části, které uživatel může zaškrtnout (podsložky, čárkami; - pro žádné)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "Token PKCS#11: token neobsahuje certifikát s CKA_ID klíče (zadejte ho pomocí --cert)"

msgid "Paths"
msgstr "Cesty"

msgid "Product name"
msgstr "Název produktu"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode a UpgradeCode jsou stejný GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} není v prvních třech polích vyšší než předchozí {2}: Instalační služba systému Windows neupgraduje"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Program, který otevírají zástupci (- bez zástupců)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: takový jazyk neexistuje (vestavěné: {2}; jiný potřebuje svůj jazykový balíček, {3}.po)"

msgid "Reference, "
msgstr "Reference, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Pořadí {1} nepokrývá žádný řádek Media (poslední {2})"

msgid "Sequence %ld is used by another file"
msgstr "Pořadí {1} používá jiný soubor"

msgid "Source file to write"
msgstr "Zdrojový soubor k zápisu"

msgid "Source format"
msgstr "Formát zdroje"

msgid "Source must name a File row for type %ld"
msgstr "Source musí jmenovat řádek File pro typ {1}"

msgid "Start menu shortcut?"
msgstr "Zástupce v nabídce Start?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Položky nabídky Start, Programy, Plocha a Po spuštění pocházejí z [shortcut.*] a [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML mimo podmnožinu, kterou rubrapack čte, nebo `format` chybí či je příliš nový"

msgid "Tables"
msgstr "Tabulky"

msgid "The TOML subset"
msgstr "Podmnožina TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Soubory UTF-16 big-endian nejsou podporovány; uložte jako UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} se liší od kódu předchozí verze {2}: tento balíček ji nenahrazuje"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode není GUID ve formátu registru"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Hodnota (text, číslo, true/false, [\"a\", \"b\"]; - odebere klíč)"

msgid "Variables"
msgstr "Proměnné"

msgid "Version"
msgstr "Verze"

msgid "Version ([define] VERSION)"
msgstr "Verze ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Verze a upgrady"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Instalační služba systému Windows povoluje nejvýše 255.255.65535(.65535)"

msgid "Windows did not say what is installed for '%s'"
msgstr "Windows neřekl, co je pro '{1}' nainstalováno"

msgid "Windows name"
msgstr "název Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] potřebuje '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] nemůže být ve slučovacím modulu; má to balíček, který ho slučuje"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] zatím není podporováno (plánováno na {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] nemůže být v MSIX; přidejte msi-only = true a MSIX se sestaví bez něj"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] je v AppData nebo LocalAppData uživatele: balíček dual nainstalovaný pro všechny uživatele jej umístí jen do profilu instalujícího uživatele"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID ve slučovacím modulu má nejvýše 35 znaků (přidá se k němu GUID modulu)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] potřebuje ID: napište [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] nepřijímá ID: napište [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml nemá </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml není poslední položka (není to balíček, který zapsal rubrapack nebo rozhraní Windows pro balíčky)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Pole tabulek [[...]] nejsou podporována; dejte každé položce vlastní [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] se umísťuje jednou: before, after nebo sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] potřebuje do i undo (undo vrací také neúspěšné do)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] vyžaduje entry: funkci DLL, která se má zavolat"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] vyžaduje run = \"file:<ID>\": program, který spouští do a undo"

msgid "[action.%s] runs a file of this package before InstallFinalize, where a first installation does not have it yet (Windows Installer error 1721 or 1723): place it after InstallFinalize, or make it deferred"
msgstr "[action.{1}] spouští soubor tohoto balíčku před InstallFinalize, kdy jej první instalace ještě nemá (chyba Instalační služby systému Windows 1721 nebo 1723): umístěte akci za InstallFinalize nebo ji nastavte jako deferred"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] spouští jednu věc: run (exe), dll (nainstalovaná DLL) nebo binary (DLL v balíčku); nebo do a undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} je pro jednu akci, ne pro dvojici do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: odložená akce spouštějící nainstalovaný soubor musí být za InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: okamžitá akce běží jako instalující uživatel; as je pro ostatní fáze"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args patří programu; DLL dostává data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check patří k dvojici do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data je pro odloženou, commit nebo rollback akci (okamžitá čte vlastnosti)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry je funkce knihovny DLL; run bere args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args pro MSIX musí být prostý text (žádné [...] doplňované při instalaci)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: v MSIX otevírá typ souboru aplikaci: target musí být spustitelný soubor [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] je tam dvakrát"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] potřebuje ID: napište [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id a typelib se zapisují jen pro MSI; MSIX registruje třídu bez nich"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args patří programu; DLL se načítá, nespouští"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate spouští DLL v dllhost; '{2}' je program"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading je pro DLL; program si apartment nastavuje sám"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version a typelib-file potřebují typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] jde do {2}; nebo msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: jeho zdrojem musí být soubor, který jde do balíčku"

msgid "[define] values must be strings"
msgstr "Hodnoty [define] musí být řetězce"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] potřebuje '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] vyžaduje image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] potřebuje 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] potřebuje 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] potřebuje 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] má ovládacích prvků: {2}; nejvýše 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] nemá [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] je přes jiné dialogy umístěn za sebou samým"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] potřebuje ui = \"minimal\", \"installdir\" nebo \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' je název systému Windows; dejte dir jiné ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard potřebuje pomocnou DLL rubrapack, kterou slučovací modul nenese"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] potřebuje funkci"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX nastaví všechny své proměnné (when); použijte msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: jeho hodnota jmenuje místo, které MSIX nemůže poskytnout (složku mimo balíček, která není složkou Windows, nebo část z doby instalace); použijte msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: s external-location = true balíček nenese žádný soubor programu, tedy ani spouštěč rubrapacku; nebo msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] už je ve složce svého programu; isolate-for je pro sdílenou knihovnu DLL nainstalovanou jinde"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] je v profilu uživatele a má component-guid: cestou klíče zůstává soubor, kde pravidla Windows chtějí hodnotu HKCU (ICE38); vynechte component-guid, abyste ji získali"

msgid "[file.%s]: %s"
msgstr "[file.{1}]: {2}"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' není sestavení .NET (chybí hlavička CLI s řádkem Assembly)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: sestavení .NET nese svůj manifest samo; manifest je pro sestavení Win32"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: sestavení Win32 potřebuje manifest = \"file:<ID>\", svůj soubor manifestu"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: sdílené sestavení .NET jde do GAC, která přijímá jen sestavení se silným názvem; podepište ho nebo zadejte assembly-for = \"file:<program>\""

msgid "[file.%s]: a shared Win32 assembly goes into WinSxS with a catalog signed by the key its manifest's publicKeyToken names; build with --key (or give assembly-for = \"file:<program>\" for a private one)"
msgstr "[file.{1}]: sdílené sestavení Win32 jde do WinSxS s katalogem podepsaným klíčem, který uvádí publicKeyToken v manifestu; sestavte s --key (nebo pro soukromé zadejte assembly-for = \"file:<program>\")"

msgid "[file.%s]: a shared Win32 assembly's manifest '%s' names its signer: publicKeyToken in assemblyIdentity (the token of the --key it is built with)"
msgstr "[file.{1}]: manifest '{2}' sdíleného sestavení Win32 uvádí podepisujícího: publicKeyToken v assemblyIdentity (token klíče --key, se kterým se sestavuje)"

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for a manifest patří k assembly = \"dotnet\" nebo \"win32\""

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: jeho manifest '{2}' nemá assemblyIdentity s name a version"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: jeho manifest '{2}' musí být ve stejném dir a feature (a pod stejným when): oba tvoří jednu komponentu"

msgid "[file.%s]: its manifest names publicKeyToken \"%s\", but the --key's token is \"%s\""
msgstr "[file.{1}]: manifest uvádí publicKeyToken \"{2}\", ale token klíče --key je \"{3}\""

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: manifest '{2}' patří jinému sestavení nebo je sám sestavením"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Průzkumník načítá obslužnou rutinu {2} z DLL; [com.{3}] je program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows čte obslužné rutiny vlastností jen pro počítač; balíček potřebuje scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: obslužná rutina náhledu běží v prevhost systému Windows; vynechte app-id a surrogate z [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX nese jen obslužné rutiny miniatur a náhledu (zabalená obslužná rutina vlastností nedala Průzkumníku žádné hodnoty); msi-only = true ji ponechá pro MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: typ souboru MSIX patří aplikaci; přidejte [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: třída {2} není [com.*] tohoto balíčku (obsluhuje ji DLL obslužné rutiny)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: v MSIX sdílejí obslužné rutiny všechny své typy, nebo žádný (typ je v jednom přidružení typu souboru)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: v MSIX běží jeho třída v surrogate; threading = \"sta\" v [com.{2}] dá jeho oknu smyčku zpráv (s threading = {3} může náhled zůstat prázdný)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: v MSIX jsou všechny jeho typy v jednom typu souboru [assoc], nebo v žádném"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: jeho třída je msi-only ([com.{2}]); MSIX by pro ni neměl server"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types je seznam typů souborů, například [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] jde do {2}; nebo msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] potřebuje 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] potřebuje funkci: nastavte 'feature' zde nebo u jeho dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX zapíše všechny své položky INI (when); použijte msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: jeho hodnota má část, kterou Instalační služba systému Windows doplní při instalaci ([...]); MSIX zapíše soubor při sestavení"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] potřebuje 'on': kde se položka zobrazuje, například [\".txt\"] nebo \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] potřebuje 'target' (program, který spouští), nebo položky s parent = \"{2}\" (podnabídku)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] potřebuje 'target': program, který položka spouští"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: nabídka Windows 11 přijímá ID jen z písmen a číslic (bez '_'): přejmenujte ji, nebo windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: podnabídka nic nespouští: vynechte 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: položka podnabídky se zobrazuje tam, kde její podnabídka: vynechte 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args má část, kterou Instalační služba systému Windows doplní při instalaci ([...]); MSIX nese jen pevný text"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when je \"HKCU\\\\key\\\\value\" nebo \"HKLM\\\\...\", u položky nabídky Windows 11, která není v podnabídce"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when ukazuje na hodnotu, kterou zapisuje sám tento balíček ([registry.{2}]): položka by se nikdy neukázala"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: jeho program není v MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: jeho hodnoty nemohou jít do registru balíčku"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list má část, kterou Instalační služba systému Windows doplní při instalaci ([...]); MSIX nese jen pevný text"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list zastupuje {2}, když se cesty nevejdou na příkazový řádek: je třeba multi = \"one\", {3} v args a {4} (soubor se seznamem) v list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": neexistuje [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on je typ souboru nebo jejich seznam, například [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' není [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' musí být podnabídka: [menu.*] bez target a bez vlastního parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] jde do {2}; nebo msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] potřebuje funkci: nastavte 'feature' zde nebo u jeho dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; nebo msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] vyžaduje feature (nebo with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature patří k vlastní komponentě, ne k with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name určuje jeden soubor; name má zástupné znaky"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: cíl sdílení potřebuje types, formats nebo obojí"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: obslužná rutina automatického přehrávání potřebuje content-events, device-events nebo obojí"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args musí být prostý text (žádné [...] doplňované při instalaci)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events potřebují class (třídu COM IHWEventHandler programu)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file musí být {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file musí jmenovat soubor, který jde do balíčku"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file musí jmenovat program, který jde do balíčku"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types je seznam typů souborů, například [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows přijímá jen písmena a číslice"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "[msix-psf] pro arm64 vyžaduje launcher = \"...\" (PSF pojmenovává své spouštěče PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] nejde dohromady s external-location = true ani s [env.*] (vlastním spouštěčem rubrapacku)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] spouští aplikace přes spouštěč PSF: potřebuje [msix-app.ID]"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' neuvádí aplikaci '{2}' ve svých \"applications\""

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: ve files chybí '{1}' (spouštěč)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: soubor '{2}' není knihovna DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] určuje svůj ovladač jednou: driver (jeden [odbc-driver]) nebo driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] s driver-name vyžaduje with = \"file:<ID>\": komponentu, se kterou se instaluje"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: balíček pro počítač registruje zdroje dat pro počítač"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] určuje jednu kopii: msix (s publisher) nebo upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix je název identity balíčku (3 až 50 písmen, číslic, '.' nebo '-') a vyžaduje publisher (\"CN=...\"), jak je má jeho manifest"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: druhou kopii hledá předběžná kontrola: je třeba preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code patří tomuto balíčku (to je upgrade, ne jiná kopie)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] potřebuje, aby jeho dir měl funkci"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args pro MSIX musí být prostý text (žádné [...] doplňované při instalaci)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: v MSIX otevírá schéma aplikaci: target musí být spustitelný soubor [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] potřebuje 'value' (nebo remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR nesahá mimo MSIX; použijte [assoc.*], [protocol.*], [com.*] nebo [handler.*], nebo msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: hodnota qword potřebuje pomocnou DLL rubrapack, kterou slučovací modul nenese"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX nese hodnoty jen pod {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX hodnoty ani neodebírá, ani je nenechává (remove, keep); použijte msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX zapíše všechny své hodnoty (when); použijte msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: jeho hodnota má část, kterou Instalační služba systému Windows doplní při instalaci ([...]); MSIX nese jen pevné hodnoty"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" potřebuje pomocnou DLL rubrapack, kterou slučovací modul nenese"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: název klíče nebo hodnoty nemůže jít do podregistru"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" je pro root = \"HKCU\" s on = \"uninstall\", v balíčku pro počítač"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] potřebuje funkci: nastavte 'feature' zde nebo u jeho dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true není pro složku pod {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true potřebuje pomocnou DLL rubrapack, kterou slučovací modul nenese"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" je pro recursive = true na složce v AppData nebo LocalAppData, v balíčku pro počítač"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args pro MSIX musí být prostý text (žádné [...] doplňované při instalaci)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file musí jmenovat program, který jde do balíčku"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] inzeruje funkci '{2}', která má advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise se nekombinuje s when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX má zástupce jen na ploše a v nabídce Start{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: zástupce MSIX nemá working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: zástupce MSIX je tam vždy (when je pro MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: zástupce MSIX ukazuje logo své aplikace; icon je pro MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: inzerovaný zástupce je pro MSI (MSIX nainstaluje celý balíček)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: inzerovaný zástupce potřebuje ikonu"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args pro MSIX musí být prostý text (žádné [...] doplňované při instalaci)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: v MSIX spouští zástupce aplikaci: target musí být spustitelný soubor [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: položka nabídky Start v MSIX je jeho aplikace, která nepřijímá args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: žádný text dialogu nemá toto ID"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded je pro MSI; MSIX nemá vlastní uživatelské rozhraní instalátoru"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] vyžaduje ui = \"basic\" nebo jinou sadu dialogů v [package] (nebo embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "escape sekvence \\{1} není skalární hodnota Unicode"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: tento balíček by předchozí neupgradoval čistě"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` balíčku: dialogy, znaková stránka, normalizace textu"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` balíčku nebo sady MSIX"

msgid "a %s control has no property"
msgstr "ovládací prvek {1} nemá property"

msgid "a %s control has no text; put a text control beside it"
msgstr "ovládací prvek {1} nemá text; dejte vedle něj textový prvek"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "ovládací prvek {1} potřebuje [property.{2}] s jednou ze svých hodnot jako výchozí (použije ji tichá instalace)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "balíček {1} nemůže zapisovat do HKLM; použijte HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "výstup .msix potřebuje tabulku [msix-app.ID] se spustitelným souborem"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "výstup .msix potřebuje tabulku [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "výstup .msm je slučovací modul, sestavený ze zdroje s [module] místo [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "soubor .txt, .md nebo .rtf, nebo - pro žádný"

msgid "a PE file without a certificate table entry"
msgstr "soubor PE bez položky tabulky certifikátů"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN se nikdy nepřijímá na příkazovém řádku (ostatní ho mohou vidět); použijte --pin-env nebo --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "Package manifestu sady s neznámým Type"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "Package manifestu sady bez FileName, Offset nebo Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "položka ZIP se nerozbalí na svou velikost"

msgid "a ZIP entry larger than allowed"
msgstr "položka ZIP větší, než je povoleno"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "CRC-32 položky ZIP nesouhlasí"

msgid "a ZIP entry's data lies outside the file"
msgstr "data položky ZIP leží mimo soubor"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "zdroj [module] sestavuje slučovací modul: -o <název>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "binární hodnota je sudý počet šestnáctkových číslic, například \"01A0FF\""

msgid "a bundle without packages"
msgstr "sada bez balíčků"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "certifikát v cestě má kritické rozšíření, kterému rubrapack nerozumí"

msgid "a certificate in the path is signed by a certificate that is not a CA"
