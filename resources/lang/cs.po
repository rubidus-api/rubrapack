msgstr "{1} je delší než 240 znaků"

msgid "%s is new. Add it?"
msgstr "{1} je nový. Přidat ho?"

msgid "%s is not a GUID in registry format"
msgstr "{1} není GUID ve formátu registru"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} není kód, který tento rubrapack používá{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} musí být \"file:<ID>\" a jmenovat [file.*] tohoto balíčku"

