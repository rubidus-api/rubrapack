msgstr "launch-args 에는 launch 가 필요합니다"

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "license 는 .txt, .md(일반 글로 보임) 또는 .rtf 파일이어야 합니다"

