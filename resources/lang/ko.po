msgstr "로고 '{1}'의 배율 {2} 파일이 {3}x{4} 픽셀입니다. {5}x{6} 이어야 합니다"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "로고 '{1}'의 배율 {2} 파일이 PNG 가 아닙니다"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "로고 '{1}'이(가) {2}x{3} 픽셀입니다. {4}x{5} 이어야 합니다"

msgid "logo '%s' is not a PNG file"
msgstr "로고 '{1}'이(가) PNG 파일이 아닙니다"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "로고 '{1}'을(를) 찾을 수 없습니다(.scale-100 ... .scale-400 변형도 없음)"

