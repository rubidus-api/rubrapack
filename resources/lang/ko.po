msgstr "표를 너무 많이 더합니다"

msgid "advertise is \"allow\" or \"disallow\" (got '%s')"
msgstr "advertise 는 \"allow\" 또는 \"disallow\" 여야 합니다('{1}'을(를) 받음)"

