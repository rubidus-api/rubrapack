msgstr "mode = \"remove\" 는 키를 지웁니다. 'value' 는 받지 않습니다"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "mode 는 \"set\", \"add\", \"remove\" 중 하나여야 합니다"

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "mode 는 \"set\", \"append\", \"prepend\" 중 하나여야 합니다"

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "ZIP 항목이 허용된 수보다, 또는 디렉터리에 든 것보다 많습니다"

