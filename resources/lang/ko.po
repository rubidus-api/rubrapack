msgstr "리디렉션이 3번을 넘습니다"

msgid "more than 96 sections"
msgstr "섹션이 96개보다 많습니다"

msgid "more than one source file ('%s')"
msgstr "소스 파일이 둘 이상입니다('{1}')"

