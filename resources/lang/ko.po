msgstr "embedded 는 .dll 파일이어야 합니다(작성자의 UI 처리기)"

msgid "empty arrays are not supported"
msgstr "빈 배열은 지원하지 않습니다"

msgid "ends with a space or a dot"
msgstr "공백이나 점으로 끝납니다"

msgid "error"
msgstr "오류"

msgid "executable = \"%s\" must name a [file.*] that goes into the package"
msgstr "executable = \"{1}\" 은(는) 패키지에 들어가는 [file.*] 을 가리켜야 합니다"

msgid "expected ',' or ']' in the array"
msgstr "배열에는 ',' 나 ']' 가 와야 합니다"

msgid "expected '=' after the key"
msgstr "키 뒤에 '=' 가 와야 합니다"

