msgstr "languages 에는 \"ko\" 나 \"zh_TW\" 같은 코드를 씁니다(소문자 2~3자, 그리고 _ 와 지역의 대문자 2자)('{1}' 을(를) 받음)"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "languages 는 [\"ko\"] 같은 언어 코드의 배열입니다"

