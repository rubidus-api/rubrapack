msgstr "preflight = false 이면 extra-files 는 효과가 없습니다"

msgid "extra-files must be \"ask\", \"keep\" or \"delete\" (got '%s')"
msgstr "extra-files 는 \"ask\", \"keep\", \"delete\" 가운데 하나입니다('{1}' 을(를) 받음)"

