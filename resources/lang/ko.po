msgstr "병합 모듈 '{1}'을(를) 찾을 수 없습니다"

msgid "min-version must be a version like 1.2.3"
msgstr "min-version 은 1.2.3 같은 버전이어야 합니다"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "min-version 은 10.0.17763.0 처럼 네 부분이어야 합니다"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "min-version 은 14.0.24217.0 처럼 네 부분이어야 합니다"

msgid "mismatch"
msgstr "불일치"

