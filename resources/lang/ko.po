msgstr "확장명 '{1}'에는 이미 프로그램이 있습니다([assoc.{2}])"

msgid "extension must be '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "extension 은 '.' 뒤에 소문자, 숫자, '_', '-' 가 와야 합니다('{1}'을(를) 받음)"

