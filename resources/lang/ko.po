msgstr "사용법: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "사용법: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "사용법: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "사용법: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "사용법: rubrapack inspect <setup.exe> (표나 옵션 없이)"

msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "사용법: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "사용법: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "사용법: rubrapack lint <file.msix|file.msixbundle> [--strict]"

