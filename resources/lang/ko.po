msgstr "file: '{1}'은(는) 이 패키지의 [file.*] 이 아닙니다"

msgid "file: '%s' serves COM classes only as an .exe or a .dll"
msgstr "file: '{1}'은(는) .exe 나 .dll 일 때만 COM 클래스를 제공합니다"

