msgstr "action 이 표준 동작도 아니고 CustomAction 에도 없습니다"

msgid "action must be \"warn\" or \"refuse\" (got '%s')"
msgstr "action 은 \"warn\" 또는 \"refuse\" 여야 합니다('{1}'을(를) 받음)"

