# rubrapack language pack: Kazakh.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: kk\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Қазақ тілі\n"
"X-Rubrapack-LangIDs: 1087\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 4\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, диалогтар {6}{7}\n  1 атауы, өндіруші, нұсқа, архитектура          2 орнату қалтасы, кім үшін\n  3 диалогтар, лицензия, тілдер                  4 қосымша бөліктер\n  5 төте жолдар                                  6 файлдар: бағдарлама қалтасымен сәйкестендіру\n  7 кез келген кілт                              v қарау   l lint   s сақтау   q шығу\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nОсы коды бар хабарлар (* атау немесе мән орнына тұр):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nНәтижелер stdout-қа, диагностика stderr-ге шығады.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nНе істеу керек: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} жоқ, бірақ төте жол оны ашады: алдымен төте жолдарды өзгертіңіз (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  онда {1} файл және {2} қалта бар\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s немесе q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] және [files.{2}] қосылды\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] қосылды\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  кесте.кілт түрінде беріңіз, мысалы package.version немесе dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: ақау жоқ\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: жоғарыдағы ақауларды қараңыз (онда аталған файл - тексеру көшірмесі)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages ішіндегі басқа тілдер сақталады; ол тізімді 7 арқылы өзгертіңіз (кез келген кілт)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] жойылды\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] жойылды{2}\n"

msgid "  sub folders:"
msgstr "  ішкі қалталар:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  бұл TOML ішкі жиынына сай емес; ештеңе өзгертілмеді\n"

msgid "  that was not readable text; again, please\n"
msgstr "  бұл оқылатын мәтін емес еді; қайталаңыз\n"

msgid "  the program folder '%s': %s\n"
msgstr "  бағдарлама қалтасы '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  бастапқы файлда төте жол көрсете алатын [file] кестелері жоқ\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  бастапқы файлда `new` жазатындай ішкі қалталар жоқ ([files] \"<folder>/<name>/**\"); оларды 6 арқылы қосыңыз\n"

msgid "  too long; again, please\n"
msgstr "  тым ұзын; қайталаңыз\n"

msgid "  y or n\n"
msgstr "  y немесе n\n"

msgid " (changed)"
msgstr " (өзгертілді)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) және MSIX (.msix) бумаларын жасайды\n\nпайдалану: rubrapack [--lang <code>] <command> [arguments]\n\nкомандалар:\n"

msgid " and its dir"
msgstr " және оның қалтасы"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) орта айнымалысы жоқ, сондықтан кеңейтілетін мән оны ұстай алмайды; жол мәнін пайдаланыңыз (орнату кезінде толтырылады)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) - {2}: ол жолды бастай алады немесе Windows Installer толтыратын мәннің орнына тұра алады (тізілім, орта, INI, аргументтер, хабарлар), бірақ мұнда емес"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) жол басталатын қалта емес (dir ID немесе ProgramFiles, LOCALAPPDATA, ProgramData ... - нұсқаулықтағы Жолдар бөлімін қараңыз){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  құрылым:     {2}\n  дайджест:    {3}\n  қолтаңба:    {4}\n  тізбек:      {5}{6}{7}\n  кері қайтарып алу: тексерілмеді\n  уақыт белгісі: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: айнымалы орнатылмаған"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' осы диалогтың басқару элементі емес"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3} ішінде жоқ"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': лицензия мәтініне қаріптің ағылшынша атауы керек, сондықтан ол тілдің өз қаріпімен көрсетіледі; бұл қаріпті онда да пайдалану үшін ағылшынша атауын жазыңыз (мысалы, \"Malgun Gothic\")"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} құрамдас бөлігі, бірақ буманың платформасы - {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\" түріне жатпайды"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\" түріне жатпайды"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID мәндерін қамтиды (1..65535), мысалы 1041"

msgid "%s holds strings"
msgstr "{1} жолдарды қамтиды"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} - 1-31 таңбадан тұратын қаріп атауы, мысалы \"Segoe UI\" ({2} алынды)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} - тырнақшалары жабық, жақшалары теңгерілген MSI шарты"

msgid "%s is an array of strings, one per value"
msgstr "{1} - жолдар массиві, әр мәнге біреу"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI бумаларына арналған: msiexec MSIX жоймайды"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} жоқ. [file.{2}] жою керек пе?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 таңбадан ұзын"

msgid "%s is new. Add it?"
msgstr "{1} жаңа. Қосу керек пе?"

msgid "%s is not a GUID in registry format"
msgstr "{1} тізілім пішіміндегі GUID емес"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} - бұл rubrapack пайдаланатын код емес{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} осы буманың [file.*] атайтын \"file:<ID>\" болуы керек"

msgid "%s must be a GUID"
msgstr "{1} GUID болуы керек"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} {{12345678-...} сияқты GUID болуы керек ('{2}' алынды)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// не file:// мекенжайы немесе \\\\server\\share жолы болуы керек ('{2}' алынды)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} upgrade-code мәнінен өзгеше болуы керек (әр архитектураға бір жаңарту отбасы)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} үшін Windows {2} немесе кейінгі жинақ қажет: [msix] min-version = \"10.0.{3}.0\" орнатыңыз"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} үшін resources/bin/rubrapack_ca-{2}.dll қажет, бұл rubrapack онсыз жасалған"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA тексерілмеді (--tsa-trust беріңіз)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA сенімді"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA сенімсіз - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} жоқ немесе бос. [files.{3}] және [dir.{4}] жою керек пе?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ - жаңа қалта. Қосу керек пе?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: қателер: {2}{-3}, ескертулер: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: қателер: {2}{-3}, ескертулер: {4}{-5} ({6} бойынша)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} файл, {3} байт\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} файл, {3} қате, 0 ескерту\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: тағы {2} диагностика көрсетілмеді\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: '{2}' файлы осы буманың [file.*] емес"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: '{2}' файлы бағдарлама емес (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' жабылмаған ('$(' мәтіні үшін '$$(' жазыңыз)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' бар; ол сол күйінде қалдырылады"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' бар; оны жойыңыз немесе басқа қалтаға жинаңыз"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' үшін {2} өңдегіші бар ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' үшін рұқсаттар бар"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' және '{2}' бумадағы бір жол"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' Windows-қа немесе браузерлерге тиесілі"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' файлын '{2}' бойынша оқу мүмкін емес: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' TOML ішкі жиынына сай емес; ештеңе сақталмады"

msgid "'%s' exists already"
msgstr "'{1}' бар"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' бар; оны `rubrapack edit {2}` арқылы өзгертіңіз"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' бар және бос каталог емес; жаңасына шығарыңыз"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' {2} ішіне барады; немесе msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' ішінде оқылмайтын жиынтық ақпарат ағыны бар"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' ішінде шығаруға арналған Directory, Component, File және Media кестелері жоқ"

msgid "'%s' has no readable summary information"
msgstr "'{1}' ішінде оқылатын жиынтық ақпарат жоқ"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' ішінде '{2}' түрлендіруі жоқ"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' - UTF-16: edit тек UTF-8 бастапқы файлдарды өзгертеді (алдымен UTF-8 ретінде сақтаңыз)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' - Windows атауы; айнымалыға басқа атау беріңіз"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' - [chain]: ол орнату бағдарламасын жасайды, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' - кірістірілген жақтаудың басқару элементі; басқа ID таңдаңыз"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' - компьютер қалтасы; {2} бумасы оған жаза алмайды"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' - біріктіру модулі: оны [merge.ID] арқылы біріктіріңіз"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' - MSIX пішімі өзіне сақтайтын атау"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' - символдық сілтеме; сілтемелерге өтілмейді"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' сонымен қатар [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' сонымен қатар dir ID; айнымалыға басқа атау беріңіз"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' осы буманың архитектурасы үшін емес, 0x{2} машинасы үшін жасалған; әдейі болса any-arch = true орнатыңыз"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' PE файлы (.exe, .dll) да, MSI бумасы да, MSIX бумасы не жиыны да емес"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' PE файлы да, MSI бумасы да, MSIX бумасы не жиыны да емес"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' белгілі қалта да, dir ID да емес (белгілі қалталар: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' rubrapack оқи алатын cabinet емес (stored немесе MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' диагностика коды емес (RP және төрт сан, мысалы RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' бағдарлама емес (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' кәдімгі файл емес"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' rubrapack орнату бағдарламасы емес{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' жарамды ID емес (әріптер, сандар және '_', саннан басталмайды, ең көбі {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' жарамды MSI дерекқоры емес: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' жарамды MSIX бумасы емес: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' жарамды бума емес: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' жарамды бастапқы файл емес (TOML ішкі жиыны); алдымен оны қолмен түзетіңіз"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' жарамды түрлендіру емес: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' жарамды айнымалы атауы емес"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' сақталған және ID ретінде пайдаланылмайды"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' - dir атауы: dir-ді тек тізілім не dir іздеуі толтыра алады"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' бағдарлама файлына (PE) ұқсайды, бірақ тақырыптары не ресурстары бүлінген"

msgid "'%s' must be a string"
msgstr "'{1}' жол болуы керек"

msgid "'%s' must be an integer"
msgstr "'{1}' бүтін сан болуы керек"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' {2} мен {3} аралығында болуы керек"

msgid "'%s' must be true or false"
msgstr "'{1}' true немесе false болуы керек"

msgid "'%s' must not be empty"
msgstr "'{1}' бос болмауы керек"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' ешбір түрлендіруді атамайды (жиынтық сипаты 8): бұл түзету емес"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' қалтадан басталады: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' ішінде {4} бар; ештеңе шығарылмады"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} жазба, {3} шегінен көп (--limit-entries); ештеңе шығарылмады"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' және '{3}' Windows-та бір жол болар еді; ештеңе шығарылмады"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' [ui] languages ішінде жоқ"

msgid "'%s': a table cannot be read"
msgstr "'{1}': кестені оқу мүмкін емес"

