msgstr "[com.{1}]: args бағдарламаға арналған; DLL жүктеледі, іске қосылмайды"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate DLL-ді dllhost ішінде орындайды; '{2}' - бағдарлама"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading DLL үшін; бағдарлама өз пәтерін өзі орнатады"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version мен typelib-file үшін typelib керек"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] {2} ішіне барады; немесе msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: оның көзі бумаға кіретін файл болуы керек"

msgid "[define] values must be strings"
msgstr "[define] мәндері жол болуы керек"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] үшін '{2}' керек"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] үшін 'property' керек"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] үшін 'text' керек"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] үшін 'values' керек"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] ішінде {2} басқару элементі бар; ең көбі 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] ішінде [dialog-control.*] жоқ"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] басқа диалогтар арқылы өзінен кейін орналасқан"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] үшін ui = \"minimal\", \"installdir\" немесе \"features\" керек"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' - Windows атауы; dir-ге басқа ID беріңіз"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard үшін rubrapack көмекші DLL-і керек, біріктіру модулі оны алып жүрмейді"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] үшін мүмкіндік керек"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX барлық айнымалыларын орнатады (when); msi-only = true пайдаланыңыз"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: оның мәні MSIX бере алмайтын орынды атайды (бумадан тыс, Windows-қа жатпайтын қалта немесе орнату кезіндегі бөлік); msi-only = true пайдаланыңыз"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] пайдаланушы профилінде және оның component-guid мәні бар: кілт жолы файл болып қалады, ал Windows ережелері онда HKCU мәнін талап етеді (ICE38); оны алу үшін component-guid алып тастаңыз"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer {2} өңдегішін DLL-ден жүктейді; [com.{3}] - бағдарлама"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows сипат өңдегіштерін тек компьютер деңгейінде оқиды; бумаға scope = \"machine\" керек"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: алдын ала қарау өңдегіші Windows prevhost ішінде жұмыс істейді; app-id мен surrogate-ты [com.{2}] ішіне жазбаңыз"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX тек нобай және алдын ала қарау өңдегіштерін алып жүреді (бумаланған сипат өңдегіші Explorer-ге мән бермеді); msi-only = true оны MSI үшін сақтайды"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: MSIX файл түрі қолданбаға тиесілі; [msix-app.*] қосыңыз"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: {2} класы осы буманың [com.*] емес (оны өңдегіштің DLL-і қамтамасыз етеді)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX ішінде өңдегіштер барлық түрлерін ортақ пайдаланады немесе ешқайсысын (түр бір ғана файл түрі байланысында болады)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX ішінде оның класы суррогатта жұмыс істейді; [com.{2}] ішіндегі threading = \"sta\" терезеге хабар циклін береді (threading = {3} болса, алдын ала қарау бос қалуы мүмкін)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX ішінде оның барлық түрлері бір [assoc] файл түрінде болады немесе ешқайсысы"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: оның класы тек MSI үшін ([com.{2}]); MSIX-те оған сервер болмас еді"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types - файл түрлерінің тізімі, мысалы [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2} ішіне барады; немесе msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] үшін 'value' керек"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] үшін мүмкіндік керек: 'feature' мұнда немесе оның dir-інде орнатыңыз"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX барлық INI жазбаларын жазады (when); msi-only = true пайдаланыңыз"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: оның мәнінде Windows Installer орнату кезінде толтыратын бөлік бар ([...]); MSIX файлды жасалған кезде жазады"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] үшін 'on' керек: элемент қайда көрінетіні, мысалы [\".txt\"] немесе \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] үшін 'target' (ол іске қосатын бағдарлама) немесе parent = \"{2}\" бар элементтер (ішкі мәзір) керек"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] үшін 'target' керек: элемент іске қосатын бағдарлама"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 мәзірі тек әріптер мен цифрлардан тұратын ID қабылдайды ('_' болмайды): атын өзгертіңіз немесе windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: ішкі мәзір ештеңені іске қоспайды: 'args' жазбаңыз"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: ішкі мәзір элементі ішкі мәзір көрінетін жерде көрінеді: 'on' жазбаңыз"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args ішінде Windows Installer орнату кезінде толтыратын бөлік бар ([...]); MSIX тек тұрақты мәтінді ұстайды"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: оның бағдарламасы MSIX ішінде жоқ (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: оның мәндері буманың тізіліміне кіре алмайды"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": [assoc.{3}] жоқ"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on - файл түрі немесе олардың тізімі, мысалы [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: '{2}' ата-элементі [menu.*] емес"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: '{2}' ата-элементі ішкі мәзір болуы керек: target-сыз және өз ата-элементі жоқ [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2} ішіне барады; немесе msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] үшін мүмкіндік керек: 'feature' мұнда немесе оның dir-інде орнатыңыз"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; немесе msi-only = true"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args қарапайым мәтін болуы керек (орнату кезінде толтырылатын [...] жоқ)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file {2} болуы керек"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file бумаға кіретін файлды атауы керек"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file бумаға кіретін бағдарламаны атауы керек"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types - файл түрлерінің тізімі, мысалы [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows тек әріптер мен цифрларды қабылдайды"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] үшін оның dir-інде мүмкіндік болуы керек"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX үшін args қарапайым мәтін болуы керек (орнату кезінде толтырылатын [...] жоқ)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX ішінде схема қолданбаны ашады: target [msix-app.*] орындалатын файлы болуы керек"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] үшін 'value' керек (немесе remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR MSIX-тен тыс жетпейді; [assoc.*], [protocol.*], [com.*] не [handler.*] пайдаланыңыз немесе msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword мәні үшін rubrapack көмекші DLL-і керек, біріктіру модулі оны алып жүрмейді"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX тек {2}\\Software астындағы мәндерді алып жүреді"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX мәндерді жоймайды да, қалдырмайды да (remove, keep); msi-only = true пайдаланыңыз"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX барлық мәндерін жазады (when); msi-only = true пайдаланыңыз"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: оның мәнінде Windows Installer орнату кезінде толтыратын бөлік бар ([...]); MSIX тек тұрақты мәндерді ұстайды"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" үшін rubrapack көмекші DLL-і керек, біріктіру модулі оны алып жүрмейді"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: кілт не мән атауы тізілім hive-ына кіре алмайды"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" компьютерге арналған бумада on = \"uninstall\" бар root = \"HKCU\" үшін"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] үшін мүмкіндік керек: 'feature' мұнда немесе оның dir-інде орнатыңыз"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true {2} астындағы қалта үшін емес"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true үшін rubrapack көмекші DLL-і керек, біріктіру модулі оны алып жүрмейді"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" компьютерге арналған бумада AppData не LocalAppData қалтасындағы recursive = true үшін"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX үшін args қарапайым мәтін болуы керек (орнату кезінде толтырылатын [...] жоқ)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file бумаға кіретін бағдарламаны атауы керек"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX-те төте жолдар тек жұмыс үстелінде және Бастау мәзірінде болады{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX төте жолында working-dir жоқ"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX төте жолы әрқашан болады (when MSI үшін)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX төте жолы өз қолданбасының логотипін көрсетеді; icon MSI үшін"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX үшін args қарапайым мәтін болуы керек (орнату кезінде толтырылатын [...] жоқ)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX ішінде төте жол қолданбаны іске қосады: target [msix-app.*] орындалатын файлы болуы керек"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX-тің Бастау мәзіріндегі жазбасы - оның қолданбасы, ол args алмайды"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: бұл ID бар диалог мәтіні жоқ"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package]"
msgstr "[ui] үшін [package] ішінде ui = \"basic\" немесе басқа диалогтар жиыны керек"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} басқару тізбегі Unicode скаляр мәні емес"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: бұл бума алдыңғысын таза жаңартпайды"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "буманың `lint`: диалогтар, код беті, мәтінді қалыпқа келтіру"

msgid "`lint` of an MSIX package or bundle"
msgstr "MSIX бумасының не жиынының `lint`"

msgid "a %s control has no text; put a text control beside it"
msgstr "{1} басқару элементінде мәтін жоқ; жанына мәтін элементін қойыңыз"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "{1} басқару элементіне мәндерінің бірі әдепкі болатын [property.{2}] керек (дыбыссыз орнату соны пайдаланады)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "{1} бумасы HKLM-ге жаза алмайды; HKMU пайдаланыңыз"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr ".msix шығысына орындалатын файлды атайтын [msix-app.ID] кестесі керек"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr ".msix шығысына [msix] кестесі керек (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr ".msm шығысы - [package] орнына [module] бар бастапқы файлдан жасалатын біріктіру модулі"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr ".txt, .md немесе .rtf файлы, немесе жоқ болса -"

msgid "a PE file without a certificate table entry"
msgstr "сертификат кестесі жазбасы жоқ PE файлы"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN ешқашан пәрмен жолынан алынбайды (оны басқалар көре алады); --pin-env немесе --pin-file пайдаланыңыз"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "жиын манифестіндегі белгісіз Type бар Package"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "жиын манифестіндегі FileName, Offset не Size жоқ Package"

msgid "a ZIP entry does not inflate to its size"
msgstr "ZIP жазбасы өз өлшеміне дейін ашылмайды"

msgid "a ZIP entry larger than allowed"
msgstr "рұқсат етілгеннен үлкен ZIP жазбасы"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "ZIP жазбасының CRC-32 мәні сай емес"

msgid "a ZIP entry's data lies outside the file"
msgstr "ZIP жазбасының деректері файлдан тыс жатыр"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "[module] бастапқы файлы біріктіру модулін жасайды: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "екілік мән - он алтылық цифрлардың жұп саны, мысалы \"01A0FF\""

msgid "a bundle without packages"
