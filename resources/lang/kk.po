msgstr "'{1}': '{2}' файлы '{3}' cabinet ішінде жоқ"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': оның сыртқы cabinet файлдарын қолтаңба қамтымайды (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': оның қалтасы белгілі орынға апармайды"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': жазуға {2} байттан көп (--limit-bytes); ештеңе шығарылмады"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': --timestamp жоқ: сертификат мерзімі біткенде қолтаңба жарамсыз болады"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': '{2}' бумасы өзінің SHA-256 мәніне сай емес"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': '{2}' cabinet ағыны жоқ"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': манифестте {2} {3} жоқ"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': манифест бумада жоқ '{2}' атайды"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': {2} уақыт белгісі: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': '{2}' түрлендіруін '{3}' бойынша оқу мүмкін емес: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' - буманың өз тілі ({2}); ол мәтінді жұрнақсыз беріңіз"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' Windows Installer-ге көп жолды мән жазғызады; type = \"multi\" және массив пайдаланыңыз"

msgid "'_' in numbers is not supported"
msgstr "сандардағы '_' қолдау көрсетілмейді"

msgid "'help' takes at most one command name"
msgstr "'help' ең көбі бір команда атауын алады"

msgid "'version' takes no arguments"
msgstr "'version' аргумент алмайды"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs .msi үшін"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch жиын үшін: x64, x86 және arm64 тізімі, әрқайсысы бір рет ('{1}' алынды)"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch бір архитектураны алады немесе .msixbundle шығысы үшін тізім"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp және --allow-unsigned-cabs --key-мен бірге қолданылады"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress .msi үшін; MSIX --msix-compress deflate|store алады"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist бастапқы файлдың жанындағы жаңа қалтаны атайды (жолсыз)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs 1-ден 64-ке дейінгі санды алады ('{1}' алынды)"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store - Windows сертификаттар қоймасы; басқа жерде кілт файлын немесе --pkcs11 пайдаланыңыз"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store сертификаттың SHA-1 таңбасын алады (40 он алтылық сан)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: мұндай тіл жоқ (кірістірілгендер: {2}; басқасына өз тіл бумасы керек, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (немесе RUBRAPACK_LANG) осы мәтіндердің тілін таңдайды: {1} немесе тіл бумасы бар тіл.\n"

