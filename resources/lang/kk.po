msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX барлық файлдарын жояды (keep); msi-only = true пайдаланыңыз"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': '{2}' cabinet бүлінген немесе stored/MSZIP емес"

