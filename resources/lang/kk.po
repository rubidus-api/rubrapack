msgstr "rubrapack оқитын ішкі жиыннан тыс TOML немесе `format` жоқ не тым жаңа"

msgid "Tables"
msgstr "Кестелер"

msgid "The TOML subset"
msgstr "TOML ішкі жиыны"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "UTF-16 big-endian файлдарына қолдау жоқ; UTF-8 ретінде сақтаңыз"

