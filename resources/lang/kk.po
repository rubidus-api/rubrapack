msgstr "--tsa-trust, --tls-trust, --system-roots және --proxy --timestamp-пен бірге қолданылады"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test және --msix-compress .msix шығыстары үшін"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test қолтаңбасыз бумалар үшін; --key бар болса, оны алып тастаңыз"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate none немесе product-code,upgrade-code,language,platform ішінен кейбірін алады"

msgid "-D %.*s is given twice"
msgstr "-D {1} екі рет берілген"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' - Windows атауы; айнымалыға басқа атау беріңіз"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D үшін АТАУ=МӘН керек ('{1}' алынды)"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i барлық жауапты сұрайды; -i немесе опцияларды беріңіз"

msgid "; its range is "
msgstr "; оның ауқымы: "

