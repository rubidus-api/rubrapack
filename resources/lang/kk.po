msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] үшін ID керек: [{2}.ID] жазыңыз"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] ID алмайды: [{2}] жазыңыз"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml ішінде </Types> жоқ"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml соңғы жазба емес (rubrapack немесе Windows буып-түю API жазған бума емес)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "[[...]] кестелер массивтеріне қолдау жоқ; әр элементке өз [kind.ID] беріңіз"

