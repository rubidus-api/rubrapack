msgstr "Нұсқа ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Нұсқалар және жаңартулар"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer ең көбі 255.255.65535(.65535) рұқсат етеді"

msgid "Windows name"
msgstr "Windows атауы"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] үшін '{4}' керек"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] біріктіру модуліне кіре алмайды; оны біріктіретін бумада болады"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] әзірге қолдау көрсетілмейді ({3} үшін жоспарланған)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
