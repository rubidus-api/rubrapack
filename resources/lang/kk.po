msgstr "'{1}': '{2}' файлының құрамдас бөлігі де, каталогы да жоқ"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': '{2}' файлы {3} байт, File кестесі {4} дейді"

