msgstr "'{1}': '{2}' каталогының '{3}' ата-каталогы жоқ"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': '{2}' каталогы өзінің арғы тегі немесе тым терең кірістірілген"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': '{2}' файлы өзінің MsiFileHash мәніне сай емес"

