msgstr "бір жиын үшін тілдер тым көп"

msgid "too many localized texts and logo scales for resources.pri"
msgstr "resources.pri үшін аударылған мәтіндер мен логотип масштабтары тым көп"

msgid "too many packages in the bundle"
msgstr "жиында бумалар тым көп"

msgid "trusted"
msgstr "сенімді"

msgid "two packages of one architecture in a bundle"
msgstr "жиындағы бір архитектураның екі бумасы"

msgid "two packages of one name in a bundle"
msgstr "жиындағы бір атаулы екі бума"

msgid "two resource packages of one ResourceId in a bundle"
msgstr "жиындағы бір ResourceId бар екі ресурс бумасы"

msgid "type must be string, expand, dword, qword, binary or multi (got '%s')"
msgstr "type string, expand, dword, qword, binary немесе multi болуы керек ('{1}' алынды)"

msgid "type must be text, checkbox, edit, radio or combo (got '%s')"
msgstr "type text, checkbox, edit, radio немесе combo болуы керек ('{1}' алынды)"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' осы буманың [file.*] емес"

msgid "typelib-version is major.minor in hex digits, like \"1.0\" (got '%s')"
msgstr "typelib-version - он алтылық цифрлардағы major.minor, мысалы \"1.0\" ('{1}' алынды)"

msgid "types and verb belong to kind = \"context-menu\""
msgstr "types пен verb kind = \"context-menu\" түріне жатады"

msgid "types: each is \".ext\" or \"*\" (every file)"
msgstr "types: әрқайсысы \".ext\" немесе \"*\" (барлық файл)"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: әрқайсысы '.' және кіші әріптер, сандар, '_' не '-' ('{1}' алынды)"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" пайдаланушыға жоқ '{2}' dir қалтасын таңдауға мүмкіндік береді ([ui] install-dir орнатыңыз)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\" таңдау үшін [feature.*] кестелерін талап етеді"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui none, basic, minimal, installdir немесе features болуы керек ('{1}' алынды)"

msgid "unexpected text after the value"
msgstr "мәннен кейін күтпеген мәтін"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "белгісіз команда '{1}' ('rubrapack help' қараңыз)"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "белгісіз басқару тізбегі \\{1} (кері қиғаш сызығы бар мәтін үшін '...' пайдаланыңыз)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "белгісіз inspect опциясы (кесте атауын, --summary, --files не --streams пайдаланыңыз)"

msgid "unknown key '%s' in [%s%s%s]"
msgstr "[{2}{3}{4}] ішіндегі белгісіз кілт '{1}'"

msgid "unknown key '%s' in [%s%s%s] (did you mean '%s'?)"
msgstr "[{2}{3}{4}] ішіндегі белгісіз кілт '{1}' ('{5}' дегіңіз келді ме?)"

msgid "unknown or incomplete %s option '%s'"
msgstr "белгісіз не толық емес {1} опциясы '{2}'"

msgid "unknown table [%s%s%s]"
msgstr "белгісіз кесте [{1}{2}{3}]"

msgid "unknown table [%s%s%s] (did you mean [%s]?)"
msgstr "белгісіз кесте [{1}{2}{3}] ([{4}] дегіңіз келді ме?)"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "буманы жаңа каталогқа орнатылатындай етіп ашу"

msgid "unsupported - %s"
msgstr "қолдау жоқ - {1}"

msgid "untrusted"
msgstr "сенімсіз"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "update-* кілттеріне appinstaller-uri және package-uri керек"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false on = \"uninstall\" немесе \"both\" үшін (орнату ешқашан жаңартудағы жою емес)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code {{12345678-1234-1234-1234-123456789ABC} сияқты GUID болуы керек"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "пайдалану: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (a list for a bundle)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"
msgstr "пайдалану: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (жиын үшін тізім)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"

msgid "usage: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"
msgstr "пайдалану: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"

msgid "usage: rubrapack explain [RPnnnn]"
msgstr "пайдалану: rubrapack explain [RPnnnn]"

msgid "usage: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"
msgstr "пайдалану: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"

msgid "usage: rubrapack guid [--from <text>]"
msgstr "пайдалану: rubrapack guid [--from <text>]"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "пайдалану: rubrapack inspect <file.cab> (кестесіз не опциясыз)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "пайдалану: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "пайдалану: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "пайдалану: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "пайдалану: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "пайдалану: rubrapack inspect <setup.exe> (кестесіз не опциясыз)"

msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "пайдалану: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "пайдалану: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "пайдалану: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "usage: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"
msgstr "пайдалану: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"

msgid "usage: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (a fixed starter <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk names are taken too"
msgstr "пайдалану: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (тұрақты бастапқы <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk атаулары да қабылданады"

msgid "usage: rubrapack schema (the JSON Schema of sources, on stdout)"
msgstr "пайдалану: rubrapack schema (бастапқы файлдардың JSON Schema-сы, stdout-қа)"

msgid "usage: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"
msgstr "пайдалану: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"

msgid "usage: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."
msgstr "пайдалану: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."

msgid "use '/' in path"
msgstr "жолда '/' пайдаланыңыз"

msgid "use a full rubrapack build or another way"
msgstr "rubrapack толық жинағын немесе басқа тәсілді пайдаланыңыз"

msgid "used by more than one component"
msgstr "оны бірнеше құрамдас бөлік пайдаланады"

msgid "users must be \"all\" (got '%s')"
msgstr "users \"all\" болуы керек ('{1}' алынды)"

msgid "value '%s' is listed twice"
msgstr "'{1}' мәні екі рет көрсетілген"

msgid "value missing"
msgstr "мән жоқ"

msgid "values and labels are strings"
msgstr "values пен labels - жолдар"

msgid "values is an array of 1 to 32 strings"
msgstr "values - 1-32 жолдан тұратын массив"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "мәндер: ID, GUID, нұсқалар, ауқымнан тыс сандар, жоқ нәрселерге сілтемелер"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "'{1}' айнымалысы анықталмаған ([define] немесе -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "'{1}' айнымалы атауында '=' болмауы және ол = + - ! * таңбасымен басталмауы керек"

msgid "variables"
msgstr "айнымалылар"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "айнымалылар: мәнсіз $(АТАУЫ), жабылмаған $(, тұра алмайтын жердегі Windows атауы не dir ID"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "'{1}' нұсқасы a.b.c немесе a.b.c.d болуы керек"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "'{1}' нұсқасы a, b <= 255 және c, d <= 65535 болатын a.b.c немесе a.b.c.d болуы керек"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" 64 биттік буманың файлымен 'with' бола алмайды"

msgid "view must be \"32\" or \"64\""
msgstr "view \"32\" немесе \"64\" болуы керек"

msgid "warning"
msgstr "ескерту"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "диагностика кодының мағынасы, оны тасымалдайтын хабарлар, не істеу керек және нұсқаулықта толығырақ қайда жазылғаны"

msgid "with must be \"file:<ID>\""
msgstr "with \"file:<ID>\" болуы керек"

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: '{1}' файлы осы буманың [file.*] емес"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "--pkcs11 жоқ болса, `keys list` Windows сертификаттар қоймасын көрсетеді"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' dir ID емес"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "түзету жазу (.msp): орнатылған негізді мақсатқа дейін жаңартатын файлдар мен жолдар"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "бастапқы файл жазу (.toml; .rpk атаулары да): сұралған не опция ретінде берілген жауаптардан, тұрақты бастапқы файлдан немесе бар MSI-ден жасалады"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "түрлендіру жазу (.mst): бір буманы екіншісіне айналдыратын нәрсе"

msgid "write the table or value the plain way the manual shows"
msgstr "кестені не мәнді нұсқаулық көрсеткен қарапайым тәсілмен жазыңыз"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "мәнді '[~]' жоқ жазыңыз; оны mode = \"append\" не \"prepend\" қосады"

