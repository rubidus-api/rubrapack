msgstr "--lang үшін тіл керек, мысалы en немесе ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages үшін диалогтар керек: --ui да беріңіз"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress deflate немесе store алады ('{1}' алынды)"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: айнымалы орнатылмаған"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code бас әріптермен және жақшалармен GUID алады: {{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: айнымалы орнатылмаған"

msgid "--previous compares two .msi packages"
msgstr "--previous екі .msi бумасын салыстырады"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: операциялық жүйенің түбірлік сертификаттарын оқу мүмкін емес"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} '{2}' шығысына сай емес"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} іске асырылмаған (msi немесе msix)"

