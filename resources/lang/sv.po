msgstr "[menu.{1}]: list står för {2} när sökvägarna inte ryms på en kommandorad: kräver multi = \"one\", {3} i args och {4} (listfilen) i list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": det finns ingen [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on är en filtyp eller en lista med sådana, som [\".txt\", \"folder\"]"

