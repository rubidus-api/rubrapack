msgstr "variabler: $(NAMN) utan värde, $( inte stängd, ett Windows-namn eller dir-ID där det inte kan stå"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "versionen '{1}' måste vara a.b.c eller a.b.c.d"

