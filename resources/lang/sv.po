msgstr "[handler.{1}]: dess klass är msi-only ([com.{2}]); MSIX skulle sakna server för den"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types är en lista med filtyper, som [\".txt\"]"

