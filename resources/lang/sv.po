# rubrapack language pack: Swedish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: sv\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Svenska\n"
"X-Rubrapack-LangIDs: 1053, 2077\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 7\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialogrutor {6}{7}\n  1 namn, tillverkare, version, arkitektur      2 installationsmapp, vem den installeras för\n  3 dialogrutor, licens, språk                  4 valfria delar\n  5 genvägar                                    6 filer: matcha programmappen\n  7 valfri nyckel                               v visa   l lint   s spara   q avsluta\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMeddelanden med den här koden (* står för ett namn eller ett värde):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nResultat går till stdout, diagnostik till stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nVad du ska göra: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} finns inte längre, men en genväg öppnar den: ändra genvägarna (5) först\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  där finns {1} filer och {2} mappar\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s eller q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  lade till [dir.{1}] och [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  lade till [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  ange det som tabell.nyckel, till exempel package.version eller dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: inga problem\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: se problemen ovan (filen som nämns där är en kontrollkopia)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  andra språk i [ui] languages behålls; ändra listan med 7 (valfri nyckel)\n"

msgid "  removed [file.%s]\n"
msgstr "  tog bort [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  tog bort [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  undermappar:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  det passar inte i TOML-delmängden; inget ändrades\n"

msgid "  that was not readable text; again, please\n"
msgstr "  det var ingen läsbar text; försök igen\n"

msgid "  the program folder '%s': %s\n"
msgstr "  programmappen '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  källan har inga [file]-tabeller som en genväg kan peka på\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  källan har inga undermappar så som `new` skriver dem ([files] \"<folder>/<name>/**\"); lägg till dem med 6\n"

msgid "  too long; again, please\n"
msgstr "  för långt; försök igen\n"

msgid "  y or n\n"
msgstr "  y eller n\n"

msgid " (changed)"
msgstr " (ändrad)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - bygger Windows Installer- (.msi) och MSIX-paket (.msix)\n\nanvändning: rubrapack [--lang <code>] <command> [arguments]\n\nkommandon:\n"

msgid " and its dir"
msgstr " och dess dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) har ingen miljövariabel, så ett expanderbart värde kan inte innehålla den; använd ett strängvärde (fylls i vid installationen)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) är en {2}: den kan inleda en sökväg eller stå för ett värde som Windows Installer fyller i (register, miljö, INI, argument, meddelanden), men inte här"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) är ingen mapp som en sökväg kan börja från (ett dir-ID, eller ProgramFiles, LOCALAPPDATA, ProgramData ... - se Paths i handboken){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktur:     {2}\n  hash:         {3}\n  signatur:     {4}\n  kedja:        {5}{6}{7}\n  spärrkontroll: inte kontrollerad\n  tidsstämpel:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: variabeln är inte satt"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' är ingen kontroll i den här dialogrutan"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' finns inte i {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': licenstexten behöver teckensnittets engelska namn och visas därför i språkets eget teckensnitt; skriv det engelska namnet (som \"Malgun Gothic\") för att använda teckensnittet även där"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-komponent, men paketets plattform är {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} hör inte till kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} hör inte till kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} innehåller LANGID (1..65535), som 1041"

msgid "%s holds strings"
msgstr "{1} innehåller strängar"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} är en lista med \"Nyckel=Värde\"-texter"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} är ett teckensnittsnamn på 1 till 31 tecken, som \"Segoe UI\" (fick {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} är ett MSI-villkor med stängda citattecken och balanserade parenteser"

msgid "%s is an array of strings, one per value"
msgstr "{1} är en matris med strängar, en per värde"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} gäller MSI-paket: en MSIX tas inte bort av msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} finns inte längre. Ta bort [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} är längre än 240 tecken"

msgid "%s is new. Add it?"
msgstr "{1} är ny. Lägga till den?"

msgid "%s is not a GUID in registry format"
msgstr "{1} är inget GUID i registerformat"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} är ingen kod som den här rubrapack använder{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} måste vara \"file:<ID>\" som namnger en [file.*] i det här paketet"

msgid "%s must be a GUID"
msgstr "{1} måste vara ett GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} måste vara ett GUID som {12345678-...} (fick '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} måste vara en https://-, http://- eller file://-adress, eller en \\\\server\\share-sökväg (fick '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} måste skilja sig från upgrade-code (en uppgraderingsfamilj per arkitektur)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} kräver Windows-version {2} eller senare: ange [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} kräver resources/bin/rubrapack_ca-{2}.dll, som den här rubrapack byggdes utan"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA inte kontrollerad (ange --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA betrodd"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA inte betrodd - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} finns inte längre eller är tom. Ta bort [files.{3}] och [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ är en ny mapp. Lägga till den?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} fel{-3}, {4} varning(ar){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} fel{-3}, {4} varning(ar){-5} (jämfört med {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} filer, {3} byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} filer, {3} fel, 0 varningar\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: ytterligare {2} diagnoser visas inte\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' är inte en standardåtgärd som rubrapack placerar"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: filen '{2}' är ingen [file.*] i det här paketet"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: filen '{2}' är inget program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' är inte stängd (skriv '$$(' för texten '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' finns redan; den lämnas som den är"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' finns redan; ta bort den eller bygg i en annan mapp"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' har redan en {2}-hanterare ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' har redan behörigheter"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' och '{2}' är samma sökväg i paketet"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' tillhör Windows eller webbläsarna"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' kan inte läsas mot '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' passar inte i TOML-delmängden; inget sparades"

msgid "'%s' exists already"
msgstr "'{1}' finns redan"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' finns redan; ändra den med `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' finns och är ingen tom katalog; packa upp till en ny"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' hamnar i {2}; eller msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' har en oläsbar ström med sammanfattningsinformation"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' har inga Directory-, Component-, File- och Media-tabeller att packa upp från"

msgid "'%s' has no readable summary information"
msgstr "'{1}' har ingen läsbar sammanfattningsinformation"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' har ingen transformering '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' är UTF-16: edit ändrar bara UTF-8-källor (spara den som UTF-8 först)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' är ett Windows-namn; ge variabeln ett annat namn"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' är en [chain]: den bygger ett installationsprogram, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' är en kontroll i den inbyggda ramen; välj ett annat ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' är en datormapp; ett {2}-paket kan inte skriva där"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' är en kopplingsmodul: koppla in den med [merge.ID] i stället"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' är ett namn som MSIX-formatet reserverar för sig själv"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' är en symbolisk länk; länkar följs inte"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' är också en [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' är också ett dir-ID; ge variabeln ett annat namn"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' är byggd för maskin 0x{2}, inte för det här paketets arch; ange any-arch = true om det är avsikten"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' är varken en PE-fil (.exe, .dll), ett MSI-paket eller ett MSIX-paket eller -paketsamling"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' är varken en PE-fil, ett MSI-paket eller ett MSIX-paket eller -paketsamling"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' är varken en känd mapp eller ett dir-ID (kända mappar: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' är ingen cabinet som rubrapack kan läsa (stored eller MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' är ingen diagnostikkod (RP och fyra siffror, som RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' är inget program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' är ingen vanlig fil"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' är inget installationsprogram från rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' är inget giltigt ID (bokstäver, siffror och '_', börjar inte med en siffra, högst {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' är ingen giltig MSI-databas: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' är inget giltigt MSIX-paket: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' är inget giltigt paket: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' är ingen giltig källa (TOML-delmängden); rätta den för hand först"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' är ingen giltig transformering: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' är inget giltigt variabelnamn"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' är reserverat och kan inte användas som ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' är namnet på en dir: bara en register- eller dir-sökning kan fylla en dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' ser ut som en programfil (PE) men dess huvuden eller resurser är skadade"

msgid "'%s' must be a string"
msgstr "'{1}' måste vara en sträng"

msgid "'%s' must be an integer"
msgstr "'{1}' måste vara ett heltal"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' måste vara mellan {2} och {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' måste vara true eller false"

msgid "'%s' must not be empty"
msgstr "'{1}' får inte vara tom"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' namnger inga transformeringar (sammanfattningsegenskap 8): ingen korrigering"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' börjar med en mapp: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' har {4}; inget packades upp"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} poster, fler än gränsen {3} (--limit-entries); inget packades upp"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' och '{3}' skulle vara samma sökväg i Windows; inget packades upp"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' finns inte i [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': en tabell kan inte läsas"

msgid "'%s': a table is unreadable"
msgstr "'{1}': en tabell är oläsbar"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': en MSIX installerar alla sina filer (when); använd msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': en MSIX tar bort alla sina filer (keep); använd msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' är skadad eller inte stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinetnamnet '{2}' är inget enkelt filnamn"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimerad fil '{2}' (sekvens {3}) har ingen cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': katalogen '{2}' har en överordnad '{3}' som inte finns"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': katalogen '{2}' är sin egen förfader eller för djupt kapslad"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': filen '{2}' stämmer inte med sin MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': filen '{2}' har ingen komponent eller katalog"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': filen '{2}' är {3} byte, File-tabellen säger {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': filen '{2}' finns inte i cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': dess externa cabinets omfattas inte av signaturen (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': dess mapp leder inte till en känd plats"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': mer än {2} byte att skriva (--limit-bytes); inget packades upp"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': ingen --timestamp: signaturen slutar gälla när certifikatet går ut"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': paketet '{2}' stämmer inte med sin SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinetströmmen '{2}' finns inte"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifestet har ingen {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifestet nämner '{2}', som inte finns i paketet"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': tidsstämpel från {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformeringen '{2}' kan inte läsas mot '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' är paketets eget språk ({2}); ange den texten utan suffixet"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' får Windows Installer att skriva en multisträng; använd type = \"multi\" och en matris"

msgid "'_' in numbers is not supported"
msgstr "'_' i tal stöds inte"

msgid "'help' takes at most one command name"
msgstr "'help' tar högst ett kommandonamn"

msgid "'version' takes no arguments"
msgstr "'version' tar inga argument"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs gäller .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch för en paketsamling: en lista med x64, x86 och arm64, var och en en gång (fick '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch tar en arkitektur, eller en lista för en .msixbundle-utdata"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp och --allow-unsigned-cabs hör till --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress gäller .msi; en MSIX tar --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist namnger en ny mapp bredvid källan (ingen sökväg)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs tar ett tal från 1 till 64 (fick '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store är ett certifikatarkiv i Windows; använd annars en nyckelfil eller --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store tar certifikatets SHA-1-tumavtryck (40 hexadecimala siffror)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: inget sådant språk (inbyggda: {2}; ett annat behöver sitt språkpaket, {3}.po)"

