msgstr "šis rubrapack ir būvēts bez instalēšanas programmas (nob parts)"

msgid "threading must be \"sta\", \"mta\", \"both\" or \"neutral\" (got '%s')"
msgstr "threading jābūt \"sta\", \"mta\", \"both\" vai \"neutral\" (saņemts '{1}')"

msgid "timestamp: "
msgstr "laikspiedols: "

msgid "too many languages for one bundle"
