msgstr "'{1}' nav lasāmas kopsavilkuma informācijas"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nav transformācijas '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' ir UTF-16: edit maina tikai UTF-8 avotus (vispirms saglabājiet to kā UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' ir Windows nosaukums; piešķiriet mainīgajam citu nosaukumu"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' ir [chain]: tas veido iestatīšanas programmu, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' ir iebūvētā rāmja vadīkla; izvēlieties citu ID"

