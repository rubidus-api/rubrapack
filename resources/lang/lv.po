msgstr "[menu.{1}]: on = \"{2}\": nav [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on ir faila tips vai to saraksts, piem., [\".txt\", \"folder\"]"

