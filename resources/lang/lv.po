msgstr "'{1}' ir arī [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' ir arī dir ID; piešķiriet mainīgajam citu nosaukumu"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' ir būvēts mašīnai 0x{2}, nevis šīs pakotnes arhitektūrai; iestatiet any-arch = true, ja tas ir apzināti"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nav ne PE fails (.exe, .dll), ne MSI pakotne, ne MSIX pakotne vai komplekts"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nav ne PE fails, ne MSI pakotne, ne MSIX pakotne vai komplekts"

