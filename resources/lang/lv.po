msgstr "'{1}': {2} '{3}' ir {4}; nekas netika izvilkts"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} ieraksti, vairāk par ierobežojumu {3} (--limit-entries); nekas netika izvilkts"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' un '{3}' sistēmā Windows būtu viens ceļš; nekas netika izvilkts"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nav [ui] languages"

