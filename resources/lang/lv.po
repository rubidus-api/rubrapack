msgstr "'{1}': MSIX instalē visus savus failus (when); izmantojiet msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX noņem visus savus failus (keep); izmantojiet msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' ir bojāts vai nav stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet nosaukums '{2}' nav vienkāršs faila nosaukums"

