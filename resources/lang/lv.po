msgstr "'{1}' nav rubrapack iestatīšanas programma{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nav derīgs ID (burti, cipari un '_', nesākas ar ciparu, ne vairāk kā {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nav derīga MSI datubāze: {2}"

