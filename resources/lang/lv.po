msgstr "'{1}' jau pastāv; noņemiet to vai būvējiet citā mapē"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' jau ir {2} apdarinātājs ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' jau ir atļaujas"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' un '{2}' ir viens un tas pats ceļš pakotnē"

