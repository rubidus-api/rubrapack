msgstr "mainīgie"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "mainīgie: $(NAME) bez vērtības, neaizvērts $(, Windows nosaukums vai dir ID vietā, kur tas nevar būt"

