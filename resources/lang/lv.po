msgstr "'{1}' pieder Windows vai pārlūkprogrammām"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' nevar nolasīt attiecībā pret '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' neatbilst TOML apakškopai; nekas netika saglabāts"

msgid "'%s' exists already"
msgstr "'{1}' jau pastāv"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' jau pastāv; mainiet to ar `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' pastāv un nav tukša direktorija; izvelciet jaunā"

