msgid "too many localized texts and logo scales for resources.pri"
msgstr "pārāk daudz lokalizētu tekstu un logotipa mērogu resources.pri"

msgid "too many packages in the bundle"
msgstr "komplektā ir pārāk daudz pakotņu"

msgid "trusted"
msgstr "uzticams"

msgid "two actions share sequence %d (%.*s and %.*s); give an [action] a different sequence, before or after"
msgstr "divas darbības dala sequence {1} ({2} un {3}); dodiet vienai [action] citu sequence, before vai after"

msgid "two packages of one architecture in a bundle"
msgstr "komplektā ir divas vienas arhitektūras pakotnes"

msgid "two packages of one name in a bundle"
msgstr "komplektā ir divas viena nosaukuma pakotnes"

msgid "two resource packages of one ResourceId in a bundle"
msgstr "komplektā ir divas resursu pakotnes ar vienu ResourceId"

msgid "type must be string, expand, dword, qword, binary or multi (got '%s')"
msgstr "type jābūt string, expand, dword, qword, binary vai multi (saņemts '{1}')"

msgid "type must be text, checkbox, edit, radio, combo, listbox or bitmap (got '%s')"
msgstr "type jābūt text, checkbox, edit, radio, combo, listbox vai bitmap (saņemts '{1}')"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' nav šīs pakotnes [file.*]"

msgid "typelib-version is major.minor in hex digits, like \"1.0\" (got '%s')"
msgstr "typelib-version ir major.minor heksadecimālos ciparos, piem., \"1.0\" (saņemts '{1}')"

msgid "types and verb belong to kind = \"context-menu\""
msgstr "types un verb pieder kind = \"context-menu\""

msgid "types: each is \".ext\" or \"*\" (every file)"
msgstr "types: katrs ir \".ext\" vai \"*\" (katrs fails)"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: katrs ir '.' un mazie burti, cipari, '_' vai '-' (saņemts '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" ļauj lietotājam izvēlēties dir '{2}' mapi, kas nepastāv (iestatiet [ui] install-dir)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\" nepieciešamas [feature.*] tabulas izvēlei"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui jābūt none, basic, minimal, installdir vai features (saņemts '{1}')"

msgid "unexpected text after the value"
msgstr "negaidīts teksts pēc vērtības"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "nezināma komanda '{1}' (skatiet 'rubrapack help')"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "nezināma atsoļa secība \\{1} (izmantojiet '...' tekstam ar apgrieztajām slīpsvītrām)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "nezināma inspect opcija (izmantojiet tabulas nosaukumu, --summary, --files vai --streams)"

msgid "unknown key '%s' in [%s%s%s]"
msgstr "nezināma atslēga '{1}' tabulā [{2}{3}{4}]"

msgid "unknown key '%s' in [%s%s%s] (did you mean '%s'?)"
msgstr "nezināma atslēga '{1}' tabulā [{2}{3}{4}] (vai domājāt '{5}'?)"

msgid "unknown or incomplete %s option '%s'"
msgstr "nezināma vai nepilnīga {1} opcija '{2}'"

msgid "unknown table [%s%s%s]"
msgstr "nezināma tabula [{1}{2}{3}]"

msgid "unknown table [%s%s%s] (did you mean [%s]?)"
msgstr "nezināma tabula [{1}{2}{3}] (vai domājāt [{4}]?)"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "izpakot pakotni jaunā direktorijā, izkārtotu kā instalējot"

msgid "unsupported - %s"
msgstr "netiek atbalstīts - {1}"

msgid "untrusted"
msgstr "neuzticams"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "update-* atslēgām nepieciešams appinstaller-uri un package-uri"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false ir paredzēts on = \"uninstall\" vai \"both\" (instalēšana nekad nav jauninājuma noņemšana)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code jābūt GUID kā {{12345678-1234-1234-1234-123456789ABC}"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "lietojums: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (a list for a bundle)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"
msgstr "lietojums: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (saraksts komplektam)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"

msgid "usage: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"
msgstr "lietojums: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"

msgid "usage: rubrapack explain [RPnnnn]"
msgstr "lietojums: rubrapack explain [RPnnnn]"

msgid "usage: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"
msgstr "lietojums: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"

msgid "usage: rubrapack guid [--from <text>]"
msgstr "lietojums: rubrapack guid [--from <text>]"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "lietojums: rubrapack inspect <file.cab> (bez tabulas vai opcijas)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "lietojums: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "lietojums: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "lietojums: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "lietojums: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "lietojums: rubrapack inspect <setup.exe> (bez tabulas vai opcijas)"

msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "lietojums: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "lietojums: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "lietojums: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "usage: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"
msgstr "lietojums: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"

msgid "usage: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (a fixed starter <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk names are taken too"
msgstr "lietojums: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (fiksēts sākuma <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; tiek pieņemti arī .rpk nosaukumi"

msgid "usage: rubrapack schema (the JSON Schema of sources, on stdout)"
msgstr "lietojums: rubrapack schema (avotu JSON Schema, uz stdout)"

msgid "usage: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"
msgstr "lietojums: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"

msgid "usage: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."
msgstr "lietojums: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."

