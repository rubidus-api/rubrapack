msgstr "values un labels ir virknes"

msgid "values is an array of 1 to 32 strings"
msgstr "values ir masīvs ar 1 līdz 32 virknēm"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "vērtības: ID, GUID, versijas, skaitļi ārpus diapazona, atsauces uz lietām, kas nepastāv"

