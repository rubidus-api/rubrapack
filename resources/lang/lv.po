msgstr "versijai '{1}' jābūt a.b.c vai a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "versijai '{1}' jābūt a.b.c vai a.b.c.d ar a, b <= 255 un c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" nevar iet 'with' ar 64 bitu pakotnes failu"

msgid "view must be \"32\" or \"64\""
msgstr "view jābūt \"32\" vai \"64\""

msgid "warning"
msgstr "brīdinājums"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "ko nozīmē diagnostikas kods, ziņojumi, kas to satur, ko darīt un kur rokasgrāmatā ir vairāk"

msgid "with must be \"file:<ID>\""
msgstr "with jābūt \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: fails '{1}' nav šīs pakotnes [file.*]"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "bez --pkcs11 `keys list` parāda Windows sertifikātu krātuvi"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' nav dir ID"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "rakstīt ielāpu (.msp): faili un rindas, kas atjaunina instalēto bāzi līdz mērķim"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "rakstīt avota failu (.toml; arī .rpk nosaukumi): no atbildēm, jautātām vai dotām kā opcijas, fiksēta sākuma faila vai esoša MSI"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "rakstīt transformāciju (.mst): to, kas vienu pakotni pārvērš otrā"

msgid "write the table or value the plain way the manual shows"
msgstr "rakstiet tabulu vai vērtību vienkāršajā veidā, ko rāda rokasgrāmata"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "rakstiet vērtību bez '[~]'; mode = \"append\" vai \"prepend\" to pievieno"

msgid "wrote %s\n"
msgstr "ierakstīts {1}\n"

msgid "x + width must be at most 370 (the page width)"
msgstr "x + width jābūt ne vairāk kā 370 (lapas platums)"

msgid "y + height must be at most 234 (the line above the buttons)"
msgstr "y + height jābūt ne vairāk kā 234 (līnija virs pogām)"

