msgstr "'{1}': direktorija '{2}' ir pati sev priekštece vai ir pārāk dziļi ligzdota"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': fails '{2}' neatbilst savam MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': failam '{2}' nav komponenta vai direktorijas"

