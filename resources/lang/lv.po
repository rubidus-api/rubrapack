msgstr "'{1}' ir datora mape; {2} pakotne tur nevar rakstīt"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' ir sapludināšanas modulis: sapludiniet to ar [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' ir nosaukums, ko MSIX formāts patur sev"

msgid "'%s' is a symbolic link; links are not followed"
