msgstr "फ़ाइल नाम {1} UTF-16 इकाइयों का है; 8.3 छोटे नाम के साथ MSI में अधिकतम {2} आते हैं"

msgid "file-system-virtualization and registry-virtualization = false need Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "file-system-virtualization और registry-virtualization = false को Windows बिल्ड 18362 या बाद वाला चाहिए: [msix] min-version = \"10.0.18362.0\" सेट करें"

msgid "file: '%s' is not a [file.*] of this package"
