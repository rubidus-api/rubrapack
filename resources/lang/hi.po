msgstr "यह सेटअप प्रोग्राम क्षतिग्रस्त है: इसे फिर से डाउनलोड करें।"

msgctxt "installer"
msgid "Setup.Ask"
msgstr "ये प्रोग्राम पहले से इंस्टॉल हैं। चुनें कि क्या करना है।"

msgctxt "installer"
msgid "Setup.Repair"
msgstr "सुधारें(&P)"

msgctxt "installer"
msgid "Setup.Remove"
msgstr "हटाएँ(&R)"

msgctxt "installer"
msgid "Setup.Cancel"
msgstr "रद्द करें"

msgctxt "installer"
msgid "Setup.RemoveAsk"
msgstr "इस कंप्यूटर से ये प्रोग्राम हटाएँ?"

msgctxt "installer"
msgid "Setup.Removed"
msgstr "प्रोग्राम हटा दिए गए।"

msgctxt "installer"
msgid "Setup.RemoveFailed"
msgstr "एक प्रोग्राम हटाया नहीं जा सका।"

msgctxt "installer"
msgid "Setup.TempFailed"
msgstr "सेटअप अस्थायी फ़ोल्डर नहीं बना सका।"

msgctxt "installer"
msgid "Setup.RepairFailed"
msgstr "{1} को सुधारा नहीं जा सका (त्रुटि {2})।"

msgctxt "installer"
msgid "Setup.InstallFailed"
msgstr "{1} इंस्टॉल नहीं हो सका (त्रुटि {2})। उसके बाद का कुछ भी इंस्टॉल नहीं हुआ।"

msgctxt "installer"
msgid "Setup.Repaired"
msgstr "प्रोग्राम सुधार दिए गए।"

msgctxt "installer"
msgid "Setup.Finished"
msgstr "सेटअप पूरा हुआ।"

msgctxt "installer"
msgid "Setup.Restart"
msgstr "परिवर्तन पूरे करने के लिए Windows पुनः आरंभ करें।"

msgctxt "installer"
msgid "DirNotEmptyText"
msgstr "इस फ़ोल्डर में पहले से फ़ाइलें या फ़ोल्डर हैं। [ProductName] हटाए जाने पर फ़ोल्डर की हर चीज़ हट जाती है - जो अभी है वह भी। खाली या नया फ़ोल्डर सुरक्षित विकल्प है।"

msgctxt "installer"
msgid "DirChoose"
msgstr "दूसरा चुनें(&C)"

msgctxt "installer"
msgid "DirContinue"
msgstr "यही फ़ोल्डर(&U)"

msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] प्रोग्राम [3] की फ़ाइलें उपयोग कर रहे हैं:\r\n[2]\r\nसभी बंद करें?\r\n\r\nहाँ: सभी बंद करें और जारी रखें (बिना सहेजा काम खो सकता है)।\r\nनहीं: बंद किए बिना जारी रखें (पहले से खुले प्रोग्राम दोबारा खुलने तक पुरानी फ़ाइलें रखते हैं)।\r\nरद्द करें: रोकें।"

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: रुक गया, क्योंकि [1] प्रोग्राम इसकी फ़ाइलें उपयोग कर रहे हैं:\r\n[2]उन्हें बंद करके फिर प्रयास करें, या RPCLOSE=yes (सभी बंद करें और जारी रखें) या RPCLOSE=no (बंद किए बिना जारी रखें) दें।"

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[3] के फ़ोल्डरों में [1] आइटम उसके साथ इंस्टॉल नहीं हुए थे:\r\n[2]\r\nउन्हें भी हटाएँ?\r\n\r\nहाँ: उन्हें [3] के साथ हटाएँ (वापस नहीं लाए जा सकते)।\r\nनहीं: [3] हटाएँ और उन्हें रखें।\r\nरद्द करें: रोकें।"

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: रुक गया, क्योंकि इसके फ़ोल्डरों में [1] आइटम इसके साथ इंस्टॉल नहीं हुए थे:\r\n[2]RPEXTRA=delete (उन्हें भी हटाएँ) या RPEXTRA=keep (उन्हें रखें) दें, फिर दोबारा हटाएँ।"

msgctxt "installer"
msgid "PreflightUsers"
msgstr "इस कंप्यूटर के [1] अन्य उपयोगकर्ताओं के पास [3] की सेटिंग्स या डेटा हो सकता है:\r\n[2]\r\nक्या उनका भी हटाएँ?\r\n\r\nहाँ: हर उपयोगकर्ता के लिए हटाएँ (वापस नहीं लाया जा सकता)।\r\nनहीं: केवल आपका हटाएँ।\r\nरद्द करें: रोकें।"

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] इस कंप्यूटर पर पहले से Microsoft Store से या ऐप पैकेज के रूप में इंस्टॉल है ([2])। एक प्रोग्राम की दो प्रतियाँ दोनों उसकी फ़ाइलें खोलती हैं और दोनों उसके मेन्यू दिखाती हैं।\r\n\r\nक्या इसे भी इंस्टॉल करें?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] इस कंप्यूटर पर पहले से Microsoft Store से या ऐप पैकेज के रूप में इंस्टॉल है ([2])। पहले वह प्रति हटाएँ (सेटिंग्स > ऐप्स), फिर इसे इंस्टॉल करें।"

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "इस कंप्यूटर पर [1] का एक और इंस्टॉलेशन पहले से है ([2])। एक प्रोग्राम की दो प्रतियाँ दोनों उसकी फ़ाइलें खोलती हैं और दोनों उसके मेन्यू दिखाती हैं।\r\n\r\nक्या इसे भी इंस्टॉल करें?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "इस कंप्यूटर पर [1] का एक और इंस्टॉलेशन पहले से है ([2])। पहले उसे हटाएँ (सेटिंग्स > ऐप्स), फिर इसे इंस्टॉल करें।"

msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] इंस्टॉल नहीं हो सका, और पूर्ववत करने से सब कुछ नहीं हटा। जो बचा है वह नीचे दिया है। इंस्टॉलर फिर से चलाएँ, फिर ज़रूरत न हो तो [1] हटा दें।\r\nलॉग: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] अपग्रेड नहीं हो सका, और पूर्ववत करने से आपका पिछला संस्करण वापस नहीं आया। अंतर नीचे दिए हैं। उस संस्करण के इंस्टॉलर से इसे ठीक करें, या नया संस्करण फिर से इंस्टॉल करें।\r\nलॉग: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] हटाया नहीं जा सका, और पूर्ववत करने से यह पहले जैसा नहीं हुआ। अंतर नीचे दिए हैं। इसके इंस्टॉलर से इसे ठीक करें, फिर दोबारा हटाएँ।\r\nलॉग: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] ठीक नहीं हो सका, और पूर्ववत करने से यह पहले जैसा नहीं हुआ। अंतर नीचे दिए हैं। इसे ठीक करने के लिए इंस्टॉलर फिर से चलाएँ।\r\nलॉग: [2]"
