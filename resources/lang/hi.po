msgid "folder name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "फ़ोल्डर नाम {1} UTF-16 इकाइयों का है; 8.3 छोटे नाम के साथ MSI में अधिकतम {2} आते हैं"

msgid "follow-parent needs a parent"
msgstr "follow-parent को पैरेंट चाहिए"

