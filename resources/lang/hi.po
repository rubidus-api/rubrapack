msgid "give a file below this folder"
msgstr "इस फ़ोल्डर के नीचे की कोई फ़ाइल दें"

msgid "give a file directly in the program folder, or - for none"
msgstr "प्रोग्राम फ़ोल्डर में सीधे कोई फ़ाइल दें, या - कोई नहीं"

msgid "give a folder below this one, such as dist"
msgstr "इसके नीचे का कोई फ़ोल्डर दें, जैसे dist"

msgid "give a name of 1 to 128 bytes"
msgstr "1 से 128 बाइट का नाम दें"

msgid "give all three logos (logo-150, logo-44, store-logo) or none"
msgstr "तीनों लोगो दें (logo-150, logo-44, store-logo) या कोई नहीं"

msgid "give one of --key, --pkcs11 and --key-store"
msgstr "--key, --pkcs11 और --key-store में से एक दें"

msgid "give sub folders of the program folder, separated by commas, or - for none"
msgstr "प्रोग्राम फ़ोल्डर के उप-फ़ोल्डर दें, अल्पविराम से अलग, या - कोई नहीं"

msgid "glob '%s' matches no file"
msgstr "glob '{1}' किसी फ़ाइल से मेल नहीं खाता"

msgid "glob '%s' matches the output file '%s'"
msgstr "glob '{1}' आउटपुट फ़ाइल '{2}' से मेल खाता है"

msgid "has a MergeModule.CABinet stream that cannot be read"
msgstr "इसमें MergeModule.CABinet स्ट्रीम है जो पढ़ी नहीं जा सकती"

msgid "has a MergeModule.CABinet that cannot be read"
msgstr "इसमें MergeModule.CABinet है जो पढ़ी नहीं जा सकती"

msgid "has a Module*Sequence table without the standard columns"
msgstr "इसमें मानक स्तंभों के बिना Module*Sequence तालिका है"

msgid "has a ModuleConfiguration item without a name or with an unknown format"
msgstr "इसमें बिना नाम या अज्ञात प्रारूप वाला ModuleConfiguration आइटम है"

msgid "has a ModuleConfiguration table without the standard columns"
msgstr "इसमें मानक स्तंभों के बिना ModuleConfiguration तालिका है"

msgid "has a ModuleSubstitution table without the standard columns"
msgstr "इसमें मानक स्तंभों के बिना ModuleSubstitution तालिका है"

msgid "has a ModuleSubstitution template naming an item that ModuleConfiguration does not have"
msgstr "इसमें ModuleSubstitution टेम्पलेट ऐसा आइटम नामित करता है जो ModuleConfiguration में नहीं है"

msgid "has a Registry table without the standard columns"
msgstr "इसमें मानक स्तंभों के बिना Registry तालिका है"

msgid "has a component with a condition; an MSIX installs everything"
msgstr "इसमें शर्त वाला घटक है; MSIX सब कुछ इंस्टॉल करता है"

msgid "has a file whose component or cabinet entry is missing"
msgstr "इसमें ऐसी फ़ाइल है जिसका घटक या cabinet प्रविष्टि गायब है"

msgid "has a folder outside its TARGETDIR that an MSIX has no place for"
msgstr "इसमें TARGETDIR के बाहर ऐसा फ़ोल्डर है जिसके लिए MSIX में जगह नहीं"

msgid "has a table that cannot be read"
msgstr "इसमें ऐसी तालिका है जो पढ़ी नहीं जा सकती"

msgid "has a table whose columns differ from the package's"
msgstr "इसमें ऐसी तालिका है जिसके स्तंभ पैकेज से भिन्न हैं"

msgid "has actions for a sequence table the package does not have"
msgstr "इसमें ऐसी अनुक्रम तालिका के लिए क्रियाएँ हैं जो पैकेज में नहीं"

msgid "has components, but the package has no FeatureComponents table"
msgstr "इसमें घटक हैं, पर पैकेज में FeatureComponents तालिका नहीं"

msgid "has files but no MergeModule.CABinet or Directory table"
msgstr "इसमें फ़ाइलें हैं पर MergeModule.CABinet या Directory तालिका नहीं"

msgid "has files but no MergeModule.CABinet stream"
msgstr "इसमें फ़ाइलें हैं पर MergeModule.CABinet स्ट्रीम नहीं"

msgid "has files, but the package has no Media table"
msgstr "इसमें फ़ाइलें हैं, पर पैकेज में Media तालिका नहीं"

msgid "has no ModuleSignature: not a merge module"
msgstr "इसमें ModuleSignature नहीं: मर्ज मॉड्यूल नहीं है"

msgid "has no ProductCode or ProductVersion"
msgstr "इसमें ProductCode या ProductVersion नहीं है"

msgid "has no Property table"
msgstr "इसमें Property तालिका नहीं है"

msgid "has no identity (Name, Publisher and Version)"
msgstr "इसकी पहचान नहीं है (Name, Publisher और Version)"

msgid "has no summary information"
msgstr "इसमें सारांश जानकारी नहीं है"

msgid "has records for a table neither the base nor the transform defines"
msgstr "इसमें ऐसी तालिका के रिकॉर्ड हैं जिसे न आधार परिभाषित करता है न ट्रांसफ़ॉर्म"

msgid "has text outside ASCII in another code page than 65001 (UTF-8)"
msgstr "इसमें 65001 (UTF-8) के अलावा किसी कोड पेज में ASCII से बाहर का पाठ है"

msgid "icon must be an .ico file"
msgstr "icon .ico फ़ाइल होनी चाहिए"

msgid "icon: file '%s' is not a [file.*] of this package"
msgstr "icon: फ़ाइल '{1}' इस पैकेज की [file.*] नहीं है"

msgid "id must be a GUID like {12345678-1234-1234-1234-123456789ABC}: the module's own, kept in every version"
msgstr "id {{12345678-1234-1234-1234-123456789ABC} जैसा GUID होना चाहिए: मॉड्यूल का अपना, हर संस्करण में वही"

msgid "identifier is winget's Publisher.Package: 2 to 8 parts of 1 to 32 characters, no spaces or \\ / : * ? \" < > | (got '%s')"
msgstr "identifier winget का Publisher.Package है: 1 से 32 वर्णों के 2 से 8 भाग, बिना रिक्त स्थान और \\ / : * ? \" < > | के ('{1}' मिला)"

msgid "identity-name must be 3 to 50 characters of A-Z, a-z, 0-9, '.' and '-' (got '%s')"
msgstr "identity-name A-Z, a-z, 0-9, '.' और '-' के 3 से 50 वर्णों का होना चाहिए (मिला '{1}')"

msgid "image must be a .bmp file (Windows Installer shows BMP only)"
msgstr "image एक .bmp फ़ाइल होनी चाहिए (Windows Installer केवल BMP दिखाता है)"

msgid "inline tables are not supported; use a [kind.ID] table"
msgstr "इनलाइन तालिकाएँ समर्थित नहीं; [kind.ID] तालिका का उपयोग करें"

msgid "installed asks Windows what is installed; it runs on Windows only"
msgstr "installed Windows से पूछता है कि क्या इंस्टॉल है; यह केवल Windows पर चलता है"

msgid "installs to the same path as line %u (Windows ignores case in names%s)"
msgstr "पंक्ति {1} वाले पथ पर ही इंस्टॉल होता है (Windows नामों में अक्षरों के छोटे-बड़े होने की उपेक्षा करता है{2})"

msgid "instances is for a per-machine package (scope = \"machine\")"
msgstr "instances प्रति कंप्यूटर पैकेज के लिए है (scope = \"machine\")"

msgid "instances is not yet combined with [menu.*] (the menu's identity package is one per build)"
msgstr "instances को अभी [menu.*] के साथ नहीं जोड़ा जा सकता (मेन्यू का पहचान पैकेज प्रति बिल्ड एक होता है)"

msgid "internal error: a built-in dialog has a broken tab order; please report it"
msgstr "आंतरिक त्रुटि: किसी अंतर्निहित संवाद का टैब क्रम टूटा है; कृपया इसकी रिपोर्ट करें"

msgid "internal: a module table has no _Validation rule"
msgstr "आंतरिक: मॉड्यूल तालिका का कोई _Validation नियम नहीं"

msgid "internal: no _Validation rule for a column of %s"
msgstr "आंतरिक: {1} के एक स्तंभ का कोई _Validation नियम नहीं"

msgid "invalid"
msgstr "अमान्य"

msgid "invalid - %s"
msgstr "अमान्य - {1}"

msgid "is '.' or '..'"
msgstr "'.' या '..' है"

msgid "is a reserved device name"
msgstr "आरक्षित डिवाइस नाम है"

msgid "is empty"
msgstr "खाली है"

msgid "is longer than 255 UTF-16 units"
msgstr "255 UTF-16 इकाइयों से लंबा है"

msgid "is not a Windows Installer database"
msgstr "Windows Installer डेटाबेस नहीं है"

msgid "is not a compound file"
msgstr "compound file नहीं है"

msgid "is not a patch: it has no patch code, target products or transforms"
msgstr "पैच नहीं है: इसमें पैच कोड, लक्ष्य उत्पाद या ट्रांसफ़ॉर्म नहीं हैं"

msgid "is not a valid MSIX package"
msgstr "मान्य MSIX पैकेज नहीं है"

msgid "is not valid UTF-8"
msgstr "मान्य UTF-8 नहीं है"

msgid "isolate-for: '%s' is not a program (.exe)"
msgstr "isolate-for: '{1}' प्रोग्राम (.exe) नहीं है"

msgid "keep the upgrade code, raise the version, keep component codes of files that stay"
msgstr "अपग्रेड कोड वही रखें, संस्करण बढ़ाएँ, बने रहने वाली फ़ाइलों के घटक कोड वही रखें"

msgid "key '%.*s' is set twice in this table (first at line %u)"
msgstr "कुंजी '{1}' इस तालिका में दो बार सेट है (पहली बार पंक्ति {2} पर)"

msgid "key '%s' must not start or end with '\\' or contain an empty part"
msgstr "कुंजी '{1}' '\\' से शुरू या खत्म नहीं होनी चाहिए और उसमें खाली भाग नहीं होना चाहिए"

msgid "key '%s' outside a table; only 'format' comes before the first table"
msgstr "कुंजी '{1}' तालिका के बाहर है; पहली तालिका से पहले केवल 'format' आता है"

msgid "key file '%s': %s"
msgstr "कुंजी फ़ाइल '{1}': {2}"

msgid "kind must be \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" or \"autoplay\" (got '%s')"
msgstr "kind \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" या \"autoplay\" होना चाहिए (मिला '{1}')"

msgid "kind must be \"preview\", \"thumbnail\" or \"property\" (got '%s')"
msgstr "kind \"preview\", \"thumbnail\" या \"property\" होना चाहिए (मिला '{1}')"

msgid "kind must be registry, file, dir or component"
msgstr "kind registry, file, dir या component होना चाहिए"

msgid "labels is an array of strings, one per value"
msgstr "labels स्ट्रिंग की सरणी है, हर मान के लिए एक"

msgid "language '%s' has no language pack (lang/%s.po beside the source, or RUBRAPACK_LANG_DIR)"
msgstr "भाषा '{1}' का कोई भाषा पैक नहीं (स्रोत के बगल में lang/{2}.po, या RUBRAPACK_LANG_DIR)"

msgid "language '%s' is listed twice"
msgstr "भाषा '{1}' दो बार सूचीबद्ध है"

msgid "language '%s' is not in [ui] languages"
msgstr "भाषा '{1}' [ui] languages में नहीं है"

msgid "language '%s' lacks %zu text(s), the first is %s: add them to its language pack (lang/%s.po) or give [ui-text.ID] text-%s"
msgstr "भाषा '{1}' में {2} पाठ नहीं हैं, पहला {3} है: उन्हें उसके भाषा पैक (lang/{4}.po) में जोड़ें या [ui-text.ID] text-{5} दें"

msgid "language '%s' needs [ui] langid-%s (its LANGIDs, for the automatic choice)"
msgstr "भाषा '{1}' को [ui] langid-{2} चाहिए (स्वचालित चुनाव के लिए उसके LANGID)"

msgid "language '%s' needs [ui] name-%s (its name on the language page)"
msgstr "भाषा '{1}' को [ui] name-{2} चाहिए (भाषा पृष्ठ पर उसका नाम)"

msgid "language = \"ko-KR\" no longer makes the dialogs Korean: they are English unless [ui] languages = [\"ko\"] adds Korean"
msgstr "language = \"ko-KR\" अब संवादों को कोरियाई नहीं बनाता: वे अंग्रेज़ी में हैं जब तक [ui] languages = [\"ko\"] कोरियाई न जोड़े"

msgid "language must be \"ko-KR\" or \"en-US\""
msgstr "language \"ko-KR\" या \"en-US\" होना चाहिए"

msgid "language must be \"neutral\", \"en-US\" or \"ko-KR\""
msgstr "language \"neutral\", \"en-US\" या \"ko-KR\" होना चाहिए"

msgid "languages = \"all\" stands alone, not in an array: it takes every built-in language"
msgstr "languages = \"all\" अकेला लिखा जाता है, किसी ऐरे में नहीं: यह सभी अंतर्निहित भाषाएँ लेता है"

msgid "languages holds codes like \"ko\" or \"zh_TW\" (2 or 3 lower-case letters, and _ and a region's two capitals) (got '%s')"
msgstr "languages में \"ko\" या \"zh_TW\" जैसे कोड होते हैं (2 या 3 छोटे अक्षर, फिर _ और क्षेत्र के दो बड़े अक्षर) (मिला '{1}')"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "languages भाषा कोडों की सरणी है, जैसे [\"ko\"]"

msgid "languages needs a dialog set (ui = \"basic\" or another)"
msgstr "languages को संवाद सेट चाहिए (ui = \"basic\" या कोई और)"

msgid "launch must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "launch \"file:<ID>\" होना चाहिए जो इस पैकेज की किसी [file.*] को नामित करे"

msgid "launch-args needs launch"
msgstr "launch-args को launch चाहिए"

msgid "launcher is the file name of the PSF launcher in files, like \"PsfLauncher64.exe\""
msgstr "launcher files में PSF लॉन्चर की फ़ाइल का नाम है, जैसे \"PsfLauncher64.exe\""

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "license .txt, .md (सादे पाठ के रूप में दिखता है) या .rtf फ़ाइल होनी चाहिए"

msgid "lint: %s row %s: column %s is not in NFC (%zu row%s); build --nfc puts folder, file and shortcut names in NFC"
msgstr "lint: {1} पंक्ति {2}: स्तंभ {3} NFC में नहीं है ({4} पंक्ति{-5}); build --nfc फ़ोल्डर, फ़ाइल और शॉर्टकट नामों को NFC में रखता है"

msgid "lint: %s%s"
msgstr "lint: {1}{2}"

msgid "lint: code page %u, not 65001: text is not checked as UTF-8, widths only for ASCII"
msgstr "lint: कोड पेज {1}, 65001 नहीं: पाठ UTF-8 के रूप में नहीं जाँचा जाता, चौड़ाई केवल ASCII के लिए"

msgid "lint: no problems\n"
msgstr "lint: कोई समस्या नहीं\n"

msgid "lint: see the problems above\n"
msgstr "lint: ऊपर की समस्याएँ देखें\n"

msgid "list the keys a token or the Windows certificate store can sign with"
msgstr "उन कुंजियों की सूची जिनसे कोई टोकन या Windows प्रमाणपत्र भंडार हस्ताक्षर कर सकता है"

msgid "logo '%s' and its .scale-100 variant are both there: keep one"
msgstr "लोगो '{1}' और उसका .scale-100 रूप दोनों मौजूद हैं: एक रखें"

msgid "logo '%s' at scale %s is %ux%u pixels; it must be %ux%u"
msgstr "स्केल {2} पर लोगो '{1}' {3}x{4} पिक्सेल है; इसे {5}x{6} होना चाहिए"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "स्केल {2} पर लोगो '{1}' PNG फ़ाइल नहीं है"

msgid "logo '%s' is %ux%u pixels; a file type's logo is square"
msgstr "लोगो '{1}' {2}x{3} पिक्सेल का है; फ़ाइल प्रकार का लोगो वर्गाकार होना चाहिए"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "लोगो '{1}' {2}x{3} पिक्सेल है; इसे {4}x{5} होना चाहिए"

msgid "logo '%s' is not a PNG file"
msgstr "लोगो '{1}' PNG फ़ाइल नहीं है"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "लोगो '{1}' नहीं मिला (न ही .scale-100 ... .scale-400 रूप)"

msgid "logo '%s': a logo with scale variants needs an ASCII file name with an extension"
msgstr "लोगो '{1}': स्केल रूपों वाले लोगो को एक्सटेंशन सहित ASCII फ़ाइल नाम चाहिए"

msgid "logo must be a .png of 8-bit RGB or RGBA, not interlaced, at most 1024 pixels a side"
msgstr "logo एक 8-बिट RGB या RGBA .png होना चाहिए, इंटरलेस्ड नहीं, हर भुजा अधिकतम 1024 पिक्सेल"

msgid "main-package is the main package's identity name (got '%s')"
msgstr "main-package मुख्य पैकेज का पहचान नाम है (मिला '{1}')"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "main-publisher और modification = true main-package के साथ आते हैं (वह पैकेज जिसका यह है)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "main-publisher मुख्य पैकेज का प्रकाशक है, जैसे \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "इसमें नियंत्रण वर्ण या / \\ : * ? \" < > | $ नहीं हो सकते"

msgid "may not start with a space or end with a space or a dot"
msgstr "यह स्पेस से शुरू या स्पेस या बिंदु पर खत्म नहीं हो सकता"

msgid "merge module '%s' not found"
msgstr "मर्ज मॉड्यूल '{1}' नहीं मिला"

msgid "min-version must be a version like 1.2.3"
msgstr "min-version 1.2.3 जैसा संस्करण होना चाहिए"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "min-version के चार भाग होने चाहिए, जैसे 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "min-version के चार भाग होने चाहिए, जैसे 14.0.24217.0"

msgid "mismatch"
msgstr "बेमेल"

msgid "mode = \"remove\" removes the key; it takes no 'value'"
msgstr "mode = \"remove\" कुंजी हटाता है; यह 'value' नहीं लेता"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "mode \"set\", \"add\" या \"remove\" होना चाहिए"

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "mode \"set\", \"append\" या \"prepend\" होना चाहिए"

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "अनुमति से या निर्देशिका में जितनी हैं उससे अधिक ZIP प्रविष्टियाँ"

msgid "more keys and values than allowed"
msgstr "अनुमति से अधिक कुंजियाँ और मान"

msgid "more than 3 redirects"
msgstr "3 से अधिक रीडायरेक्ट"

msgid "more than 96 sections"
msgstr "96 से अधिक सेक्शन"

msgid "more than one source file ('%s')"
msgstr "एक से अधिक स्रोत फ़ाइल ('{1}')"

msgid "more than one token is present: name one with --token-label"
msgstr "एक से अधिक टोकन मौजूद हैं: --token-label से एक नामित करें"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "multi \"each\", \"one\" या \"single\" होना चाहिए (मिला '{1}')"

msgid "multi-line strings are not supported"
msgstr "बहु-पंक्ति स्ट्रिंग समर्थित नहीं हैं"

msgid "multi-line strings are not supported; use one line with \\n"
msgstr "बहु-पंक्ति स्ट्रिंग समर्थित नहीं; \\n के साथ एक पंक्ति का उपयोग करें"

msgid "must be 1 to 64 bytes"
msgstr "1 से 64 बाइट होना चाहिए"

msgid "name contains a control character"
msgstr "नाम में नियंत्रण वर्ण है"

msgid "name is a package's identity name (got '%s')"
msgstr "name पैकेज का पहचान नाम है (मिला '{1}')"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "नाम ASCII नहीं है और summary-name नहीं है; सारांश Subject 'rubrapack package' होगा"

msgid "names a folder its Directory table does not have"
msgstr "ऐसा फ़ोल्डर नामित करता है जो उसकी Directory तालिका में नहीं"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "new msix अभी लागू नहीं है: MSI स्रोत बनाएँ और [msix] जोड़ें (मैनुअल देखें)"

msgid "no 'format = %d' line: a source in the format of rubrapack 0.18 or earlier, which this version does not read (paths start with $(ProgramFiles) or $(INSTALLDIR) now); see the manual's Source format"
msgstr "'format = {1}' पंक्ति नहीं: rubrapack 0.18 या पहले के प्रारूप का स्रोत, जिसे यह संस्करण नहीं पढ़ता (पथ अब $(ProgramFiles) या $(INSTALLDIR) से शुरू होते हैं); मैनुअल का Source format देखें"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "--trust नहीं दिया: हस्ताक्षर सत्यापित है पर कुछ नहीं बताता कि किस पर भरोसा करें"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "कुंजी फ़ाइल (या --cert फ़ाइल) में कोई प्रमाणपत्र कुंजी का नहीं है"

msgid "no control characters"
msgstr "कोई नियंत्रण वर्ण नहीं"

msgid "no keys\n"
msgstr "कोई कुंजी नहीं\n"

msgid "no main program, so no shortcuts: none"
msgstr "कोई मुख्य प्रोग्राम नहीं, इसलिए कोई शॉर्टकट नहीं: कोई नहीं"

msgid "no server name, or one longer than 255 bytes"
msgstr "कोई सर्वर नाम नहीं, या वह 255 बाइट से लंबा है"

msgid "no string pool: not a transform"
msgstr "कोई स्ट्रिंग पूल नहीं: ट्रांसफ़ॉर्म नहीं है"

msgid "no table '%s' in '%s'"
msgstr "'{2}' में कोई तालिका '{1}' नहीं"

msgid "no-remove leaves Modify (its Remove) as the only way to remove the product: it cannot go with no-modify"
msgstr "no-remove के बाद उत्पाद हटाने का एकमात्र तरीका Modify (उसका Remove) रहता है: यह no-modify के साथ नहीं आ सकता"

msgid "not a PE file (no MZ header)"
msgstr "PE फ़ाइल नहीं (MZ हेडर नहीं)"

msgid "not a PE file (no PE header)"
msgstr "PE फ़ाइल नहीं (PE हेडर नहीं)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "PEM, PKCS#8 या PKCS#12 फ़ाइल नहीं"

msgid "not a ZIP archive (no end record)"
msgstr "ZIP संग्रह नहीं (अंत रिकॉर्ड नहीं)"

msgid "not a ZIP archive (too short)"
msgstr "ZIP संग्रह नहीं (बहुत छोटा)"

msgid "not a cabinet (no MSCF header)"
msgstr "cabinet नहीं है (MSCF हेडर नहीं)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "ऐसा प्रॉक्सी URL नहीं जिसे rubrapack स्वीकार करे (http://host:port)"

msgid "not a registry hive"
msgstr "रजिस्ट्री हाइव नहीं"

msgid "not a valid number"
msgstr "मान्य संख्या नहीं"

msgid "not a value"
msgstr "मान नहीं"

msgid "not a value (strings need quotes)"
msgstr "मान नहीं (स्ट्रिंग को उद्धरण चिह्न चाहिए)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "ऐसा http:// या https:// URL नहीं जिसे rubrapack स्वीकार करे"

msgid "not valid UTF-8"
msgstr "मान्य UTF-8 नहीं"

msgid "not-checked (give --trust or --system-roots)"
msgstr "जाँचा नहीं गया (--trust या --system-roots दें)"

msgid "not-present"
msgstr "मौजूद नहीं"

msgid "nothing changed\n"
msgstr "कुछ नहीं बदला\n"

msgid "number out of range"
msgstr "संख्या सीमा से बाहर"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "ऑक्टल और बाइनरी संख्याएँ समर्थित नहीं; दशमलव या 0x का उपयोग करें"

msgid "on = \"uninstall\" is for HKLM, HKCU and HKMU (classes go with [assoc.*], [com.*] and the like)"
msgstr "on = \"uninstall\" HKLM, HKCU और HKMU के लिए है (क्लासेस [assoc.*], [com.*] आदि के साथ जाती हैं)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "on = \"uninstall\" किसी कुंजी को उसके नीचे की हर चीज़ सहित हटाता है: '{1}' Software के नीचे किसी उत्पाद की अपनी कुंजी नहीं है"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" हटाते समय पूरी कुंजी हटाता है; यह '{1}' नहीं लेता"

msgid "on Windows `keys list` shows the certificate store"
msgstr "Windows पर `keys list` प्रमाणपत्र भंडार दिखाता है"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "Windows पर टोकन प्रमाणपत्र भंडार के ज़रिए उपयोग होता है (--key-store <thumbprint>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "on remove = true के लिए है (कुंजी कब हटाई जाती है)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "on \"install\" या \"uninstall\" होना चाहिए"

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "on \"install\", \"uninstall\" या \"both\" होना चाहिए"

msgid "on: each is a file type ('.' and lower-case letters, digits, '_' or '-'), \"*\" (every file), \"folder\", \"background\" (the empty part of a folder), \"drive\" or \"assoc:<ID>\" (got '%s')"
msgstr "on: हर एक फ़ाइल प्रकार है ('.' और छोटे अक्षर, अंक, '_' या '-'), \"*\" (हर फ़ाइल), \"folder\", \"background\" (फ़ोल्डर का खाली भाग), \"drive\" या \"assoc:<ID>\" (मिला '{1}')"

msgid "only a bitmap control takes an image"
msgstr "केवल एक bitmap नियंत्रण image लेता है"

msgid "only radio, combo and listbox controls take labels"
msgstr "केवल radio, combo और listbox नियंत्रण labels लेते हैं"

msgid "only radio, combo and listbox controls take values"
msgstr "केवल radio, combo और listbox नियंत्रण values लेते हैं"

msgid "out of memory"
msgstr "मेमोरी समाप्त"

msgid "output '%s': rubrapack writes .msi, .msm, .msix, .msixbundle, .msixupload and a chain's setup .exe"
msgstr "आउटपुट '{1}': rubrapack .msi, .msm, .msix, .msixbundle, .msixupload और chain का setup .exe लिखता है"

msgid "package '%s' %s"
msgstr "पैकेज '{1}' {2}"

msgid "package '%s' not found"
msgstr "पैकेज '{1}' नहीं मिला"

msgid "parent must be another product's upgrade-code, not this package's own"
msgstr "parent किसी दूसरे उत्पाद का upgrade-code होना चाहिए, इस पैकेज का अपना नहीं"

msgid "parent must be the main product's upgrade-code, a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "parent मुख्य उत्पाद का upgrade-code होना चाहिए, {{12345678-1234-1234-1234-123456789ABC} जैसा GUID"

msgid "path must be \"$(Base)/relative/path\" with '/' (Base is a folder such as ProgramFiles, or a dir ID)"
msgstr "path \"$(Base)/relative/path\" होना चाहिए, '/' के साथ (Base ProgramFiles जैसा फ़ोल्डर या कोई dir ID है)"

msgid "path must start with a Windows folder (like $(ProgramFiles) or $(System))"
msgstr "path किसी Windows फ़ोल्डर से शुरू होना चाहिए (जैसे $(ProgramFiles) या $(System))"

msgid "paths"
msgstr "पथ"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "perceived-type \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" या \"application\" होना चाहिए (मिला '{1}')"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "अनुमतियों को scope = \"machine\" चाहिए (यह {1} है)"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "phase \"immediate\", \"deferred\", \"commit\" या \"rollback\" होना चाहिए ('{1}' मिला)"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "ports कोई पोर्ट या 1-65535 के भीतर \"8000-8100\" जैसी सीमा होनी चाहिए (मिला '{1}')"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "एक यादृच्छिक GUID छापें, या वह जो rubrapack किसी पाठ से निकालता है"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "स्रोतों का JSON Schema छापें (कुंजियाँ पूरी करने और जाँचने वाले संपादक के लिए)"

msgid "print the version"
msgstr "संस्करण छापें"

msgid "print this help, or one command's usage"
msgstr "यह सहायता छापें, या किसी एक आदेश का उपयोग"

msgid "product-code must be a GUID"
msgstr "product-code GUID होना चाहिए"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile \"all\", \"domain\", \"private\" या \"public\" होना चाहिए (मिला '{1}')"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id '{1}' पहले से [com.{2}] का है"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id '{1}' [assoc.{2}] का भी है: फ़ाइल प्रकार और COM क्लास को दो नाम चाहिए"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "prog-id '{1}' [assoc.{2}] में भी दूसरे विवरण, target, icon या args के साथ है"

msgid "prog-id '%s' is also in [assoc.%s] with another logo"
msgstr "prog-id '{1}' [assoc.{2}] में भी है, दूसरे logo के साथ"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "prog-id अक्षर, अंक, '.', '_' या '-' होना चाहिए, अंक से शुरू नहीं, अधिकतम 39 (मिला '{1}')"

msgid "properties are for Windows Installer packages; an MSIX takes none"
msgstr "properties Windows Installer पैकेजों के लिए है; MSIX इसे नहीं लेता"

msgid "property '%s' already belongs to control '%s'"
msgstr "गुण '{1}' पहले से नियंत्रण '{2}' का है"

msgid "property '%s' has the name of a dir or feature"
msgstr "गुण '{1}' का नाम किसी dir या फ़ीचर का है"

msgid "property '%s' is already defined (line %u)"
msgstr "गुण '{1}' पहले से परिभाषित है (पंक्ति {2})"

msgid "property '%s' is already searched (line %u)"
msgstr "गुण '{1}' पहले से खोजा जाता है (पंक्ति {2})"

msgid "property '%s' is set by rubrapack or the installer and cannot be defined here"
msgstr "गुण '{1}' rubrapack या इंस्टॉलर सेट करता है और यहाँ परिभाषित नहीं हो सकता"

msgid "property '%s' must be a public name of your own (upper case)"
msgstr "गुण '{1}' आपका अपना सार्वजनिक नाम होना चाहिए (बड़े अक्षरों में)"

msgid "property '%s' must be a public name: upper-case letters, digits and '_'"
msgstr "गुण '{1}' सार्वजनिक नाम होना चाहिए: बड़े अक्षर, अंक और '_'"

msgid "protocol must be \"tcp\" or \"udp\" (got '%s')"
msgstr "protocol \"tcp\" या \"udp\" होना चाहिए (मिला '{1}')"

msgid "public-folder must be a folder of the package, like \"Public\" (got '%s')"
msgstr "public-folder पैकेज का एक फ़ोल्डर होना चाहिए, जैसे \"Public\" (मिला '{1}')"

msgid "publisher is the package's publisher, such as \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""
msgstr "publisher पैकेज का प्रकाशक है, जैसे \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""

msgid "publisher must be the signing certificate's subject, such as \"CN=Example, O=Example, C=KR\""
msgstr "publisher हस्ताक्षर प्रमाणपत्र का subject होना चाहिए, जैसे \"CN=Example, O=Example, C=KR\""

msgid "publisher must not carry the unsigned-test OID; --unsigned-test adds it"
msgstr "publisher में unsigned-test OID नहीं होना चाहिए; --unsigned-test इसे जोड़ता है"

msgid "quoted keys are not supported"
msgstr "उद्धरण चिह्नों वाली कुंजियाँ समर्थित नहीं"

msgid "quoted table names are not supported"
msgstr "उद्धरण चिह्नों वाले तालिका नाम समर्थित नहीं"

msgid "reboot must be \"suppress\" or \"allow\""
msgstr "reboot \"suppress\" या \"allow\" होना चाहिए"

msgid "recursive = true is for on = \"uninstall\""
msgstr "recursive = true on = \"uninstall\" के लिए है"

msgid "recursive = true never runs when an upgrade removes this version; it takes no 'upgrade'"
msgstr "जब कोई अपग्रेड इस संस्करण को हटाता है तो recursive = true कभी नहीं चलता; यह 'upgrade' नहीं लेता"

msgid "recursive = true removes the folder with everything in it; it takes no 'name'"
msgstr "recursive = true फ़ोल्डर को उसकी हर चीज़ सहित हटाता है; यह 'name' नहीं लेता"

msgid "refuse-upgrade-below %s is above this package's version %s"
msgstr "refuse-upgrade-below {1} इस पैकेज के संस्करण {2} से ऊपर है"

msgid "refuse-upgrade-below '%s' must be a version like 1.2.3"
msgstr "refuse-upgrade-below '{1}' 1.2.3 जैसा संस्करण होना चाहिए"

msgid "refuse-upgrade-message needs refuse-upgrade-below"
msgstr "refuse-upgrade-message को refuse-upgrade-below चाहिए"

msgid "region %d of the language page holds %zu languages, at most %d (X-Rubrapack-Group of their packs)"
msgstr "भाषा पृष्ठ के क्षेत्र {1} में {2} भाषाएँ हैं, अधिकतम {3} (उनके पैक का X-Rubrapack-Group)"

msgid "registration must be \"machine\" or \"user\" (got '%s')"
msgstr "registration \"machine\" या \"user\" होना चाहिए ('{1}' मिला)"

msgid "registry '%s' removes a value; it has nothing to protect"
msgstr "रजिस्ट्री '{1}' एक मान हटाती है; उसके पास बचाने को कुछ नहीं"

msgid "registry value '%s' needs a feature"
msgstr "रजिस्ट्री मान '{1}' को फ़ीचर चाहिए"

msgid "remove = true removes the value at install; it takes no 'value'"
msgstr "remove = true इंस्टॉल के समय मान हटाता है; यह 'value' नहीं लेता"

msgid "remove-addons needs the cleanup task: remove cleanup = false"
msgstr "remove-addons को सफ़ाई कार्य चाहिए: cleanup = false हटाएँ"

msgid "replaces holds at most 16 upgrade codes"
msgstr "replaces में अधिकतम 16 अपग्रेड कोड होते हैं"

msgid "replaces holds upgrade codes, GUIDs like {12345678-1234-1234-1234-123456789ABC} (got '%s')"
msgstr "replaces में अपग्रेड कोड होते हैं, {{12345678-1234-1234-1234-123456789ABC} जैसे GUID (मिला '{1}')"

msgid "replaces is an array of upgrade codes, like [\"{12345678-1234-1234-1234-123456789ABC}\"]"
msgstr "replaces अपग्रेड कोडों की सरणी है, जैसे [\"{{12345678-1234-1234-1234-123456789ABC}\"]"

msgid "replaces lists %s twice"
msgstr "replaces {1} को दो बार सूचीबद्ध करता है"

msgid "replaces names %s, which is this package's own upgrade-code or its parent"
msgstr "replaces {1} को नामित करता है, जो इस पैकेज का अपना upgrade-code या उसका पैरेंट है"

msgid "required property %s is missing"
msgstr "आवश्यक गुण {1} नहीं है"

msgid "rollback twin must come before %.*s (%ld <= %ld)"
msgstr "rollback जुड़वाँ {1} से पहले आना चाहिए ({2} <= {3})"

msgid "root must be HKLM, HKCR or HKCU"
msgstr "root HKLM, HKCR या HKCU होना चाहिए"

msgid "root must be HKLM, HKCU, HKCR or HKMU (got '%s')"
msgstr "root HKLM, HKCU, HKCR या HKMU होना चाहिए (मिला '{1}')"

msgid "rubrapack explain <RPnnnn>: what a diagnostic code means. The codes by range:\n"
msgstr "rubrapack explain <RPnnnn>: किसी निदान कोड का अर्थ। सीमा के अनुसार कोड:\n"

msgid "rubrapack new: a few questions make the source (Enter takes the value in [ ]).\n"
msgstr "rubrapack new: कुछ प्रश्न स्रोत बनाते हैं (Enter [ ] वाला मान लेता है)।\n"

msgid "run `rubrapack help <command>`; check the paths and that the output folder exists"
msgstr "`rubrapack help <command>` चलाएँ; पथ जाँचें और कि आउटपुट फ़ोल्डर मौजूद है"

msgid "run: '%s' (machine 0x%04X) cannot run on this package's machines"
msgstr "run: '{1}' (मशीन 0x{2}) इस पैकेज की मशीनों पर नहीं चल सकता"

msgid "run: '%s' is not a program (.exe)"
msgstr "run: '{1}' प्रोग्राम (.exe) नहीं है"

msgid "run: file '%s' is not a [file.*] of this package"
msgstr "run: फ़ाइल '{1}' इस पैकेज की [file.*] नहीं है"

msgid "save the source as UTF-8 (or UTF-16 with a BOM), with LF or CRLF line ends"
msgstr "स्रोत को UTF-8 (या BOM सहित UTF-16) में, LF या CRLF पंक्ति-अंत के साथ सहेजें"

msgid "say whether this Windows has a product of that upgrade code or an app package of that family installed"
msgstr "बताता है कि इस Windows पर उस अपग्रेड कोड वाला उत्पाद या उस फ़ैमिली का ऐप पैकेज इंस्टॉल है या नहीं"

msgid "scheme '%s' already has a program ([protocol.%s])"
msgstr "स्कीम '{1}' का पहले से प्रोग्राम है ([protocol.{2}])"

msgid "scope must be \"machine\", \"user\" or \"dual\""
msgstr "scope \"machine\", \"user\" या \"dual\" होना चाहिए"

msgid "sddl must be an SDDL string like \"D:PAI(A;OICI;FA;;;BA)\""
msgstr "sddl \"D:PAI(A;OICI;FA;;;BA)\" जैसी SDDL स्ट्रिंग होनी चाहिए"

msgid "search property '%s' must be a public name of your own (upper case)"
msgstr "खोज गुण '{1}' आपका अपना सार्वजनिक नाम होना चाहिए (बड़े अक्षरों में)"

msgid "see the message; rebuilding with rubrapack fixes most of these"
msgstr "संदेश देखें; rubrapack से दोबारा बनाने पर इनमें से अधिकांश ठीक हो जाते हैं"

msgid "sequence %ld is not after %s (%ld)"
msgstr "क्रम {1} {2} ({3}) के बाद नहीं है"

msgid "sequences an action next to one that neither the package nor the module runs"
msgstr "किसी क्रिया को ऐसी क्रिया के बगल में रखता है जिसे न पैकेज चलाता है न मॉड्यूल"

msgid "service name '%s' is already used"
msgstr "सेवा नाम '{1}' पहले से उपयोग में है"

msgid "services need scope = \"machine\" (this is %s)"
msgstr "सेवाओं को scope = \"machine\" चाहिए (यह {1} है)"

msgid "shortcut name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "शॉर्टकट नाम {1} UTF-16 इकाइयों का है; 8.3 छोटे नाम के साथ MSI में अधिकतम {2} आते हैं"

msgid "show what differs between two packages: tables, rows, cells and summary"
msgstr "दो पैकेजों में क्या अलग है दिखाता है: तालिकाएँ, पंक्तियाँ, कोष्ठ और सारांश"

msgid "sign a PE file, an MSI package, an MSIX package or bundle"
msgstr "PE फ़ाइल, MSI पैकेज, MSIX पैकेज या बंडल पर हस्ताक्षर करें"

msgid "signed %s\n"
msgstr "{1} पर हस्ताक्षर किए\n"

msgid "source '%s' is a directory; use [files.ID] for many files"
msgstr "स्रोत '{1}' एक निर्देशिका है; कई फ़ाइलों के लिए [files.ID] का उपयोग करें"

msgid "source '%s' is a symbolic link; links are not followed"
msgstr "स्रोत '{1}' प्रतीकात्मक लिंक है; लिंक का अनुसरण नहीं किया जाता"

msgid "source '%s' is not a regular file"
msgstr "स्रोत '{1}' सामान्य फ़ाइल नहीं है"

msgid "source file '%s' changed while the package was being built"
msgstr "पैकेज बनते समय स्रोत फ़ाइल '{1}' बदल गई"

msgid "source file '%s' is larger than 2 GiB"
msgstr "स्रोत फ़ाइल '{1}' 2 GiB से बड़ी है"

msgid "source file '%s' not found"
msgstr "स्रोत फ़ाइल '{1}' नहीं मिली"

msgid "source must be \"file:<ID>\""
msgstr "source \"file:<ID>\" होना चाहिए"

msgid "source must be an .msi, .msix, .msixbundle or .msp package"
msgstr "source .msi, .msix, .msixbundle या .msp पैकेज होना चाहिए"

msgid "source path '%s' must be relative to the source file"
msgstr "स्रोत पथ '{1}' स्रोत फ़ाइल के सापेक्ष होना चाहिए"

msgid "source paths use '/', not '\\\\' (got '%s')"
msgstr "स्रोत पथ '/' का उपयोग करते हैं, '\\\\' का नहीं (मिला '{1}')"

msgid "source-format"
msgstr "source-format"

msgid "source: file '%s' is not a [file.*] of this package"
msgstr "source: फ़ाइल '{1}' इस पैकेज की [file.*] नहीं है"

msgid "start must be auto, demand or disabled"
msgstr "start auto, demand या disabled होना चाहिए"

msgid "string is not closed on this line"
msgstr "इस पंक्ति पर स्ट्रिंग बंद नहीं है"

msgid "string lengths exceed the string data"
msgstr "स्ट्रिंग लंबाइयाँ स्ट्रिंग डेटा से अधिक हैं"

msgid "summary information cannot be shown as IDT yet"
msgstr "सारांश जानकारी अभी IDT के रूप में नहीं दिखाई जा सकती"

msgid "summary-name must be ASCII (summary information holds ASCII only)"
msgstr "summary-name ASCII होना चाहिए (सारांश जानकारी में केवल ASCII होता है)"

msgid "symbols is a list of .pdb files, like [\"build/$(ARCH)/app.pdb\"]"
msgstr "symbols .pdb फ़ाइलों की सूची है, जैसे [\"build/$(ARCH)/app.pdb\"]"

msgid "table %s %s"
msgstr "तालिका {1} {2}"

msgid "table '%s' is unreadable"
msgstr "तालिका '{1}' अपठनीय है"

msgid "table [%s%s%s] is defined twice (first at line %u)"
msgstr "तालिका [{1}{2}{3}] दो बार परिभाषित है (पहली बार पंक्ति {4} पर)"

msgid "table name expected"
msgstr "तालिका नाम अपेक्षित था"

msgid "table names have at most two parts: [kind] or [kind.ID]"
msgstr "तालिका नामों के अधिकतम दो भाग होते हैं: [kind] या [kind.ID]"

msgid "tables"
msgstr "तालिकाएँ"

msgid "tables and keys: an unknown table or key, a required one missing, an item without a feature once features exist"
msgstr "तालिकाएँ और कुंजियाँ: अज्ञात तालिका या कुंजी, कोई आवश्यक गायब, फ़ीचर होने पर बिना फ़ीचर का आइटम"

msgid "tags is a list of at most 16 search terms, like [\"editor\", \"text\"]"
msgstr "tags अधिकतम 16 खोज शब्दों की सूची है, जैसे [\"editor\", \"text\"]"

msgid "takes no configuration (it has no ModuleConfiguration)"
msgstr "कोई कॉन्फ़िगरेशन नहीं लेता (इसमें ModuleConfiguration नहीं)"

msgid "target '%s' does not exist"
msgstr "लक्ष्य '{1}' मौजूद नहीं है"

msgid "target must be \"dir:<ID>\", \"file:<ID>\" or \"registry:<ID>\""
msgstr "target \"dir:<ID>\", \"file:<ID>\" या \"registry:<ID>\" होना चाहिए"

msgid "target must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "target \"file:<ID>\" होना चाहिए जो इस पैकेज की किसी [file.*] को नामित करे"

msgid "target name '%s' %s"
msgstr "लक्ष्य नाम '{1}' {2}"

msgid "target: file '%s' is not a [file.*] of this package"
msgstr "target: फ़ाइल '{1}' इस पैकेज की [file.*] नहीं है"

msgid "task-id '%s' is already used by [msix-extension.%s]"
msgstr "task-id '{1}' पहले से [msix-extension.{2}] उपयोग करता है"

msgid "task-id, display-name and enabled belong to kind = \"startup-task\""
msgstr "task-id, display-name और enabled kind = \"startup-task\" से संबंधित हैं"

msgid "that file exists already; give another name"
msgstr "वह फ़ाइल पहले से है; कोई दूसरा नाम दें"

msgid "that folder holds no files"
msgstr "उस फ़ोल्डर में कोई फ़ाइल नहीं"

msgid "the FilesInUse dialog needs a ListBox table, even an empty one (error 2205; the dialog is skipped)"
msgstr "FilesInUse संवाद को ListBox तालिका चाहिए, भले खाली हो (त्रुटि 2205; संवाद छोड़ दिया जाता है)"

msgid "the PIN has characters or a length the token does not take"
msgstr "PIN में ऐसे वर्ण या लंबाई है जो टोकन नहीं लेता"

msgid "the PIN has expired: change it on the token first"
msgstr "PIN की समय-सीमा समाप्त: पहले इसे टोकन पर बदलें"

msgid "the PIN is locked (too many wrong tries)"
msgstr "PIN लॉक है (बहुत अधिक गलत प्रयास)"

msgid "the ProductCode is the previous version's: that is a minor upgrade (REINSTALLMODE), not the major upgrade rubrapack builds"
msgstr "ProductCode पिछले संस्करण का है: यह छोटा अपग्रेड (REINSTALLMODE) है, वह बड़ा अपग्रेड नहीं जो rubrapack बनाता है"

msgid "the UTF-16 file is not valid UTF-16"
msgstr "UTF-16 फ़ाइल मान्य UTF-16 नहीं है"

msgid "the ZIP central directory lies outside the file"
msgstr "ZIP central directory फ़ाइल के बाहर है"

msgid "the application ID '%s' becomes Application Id: letters and digits only, not starting with a digit"
msgstr "ऐप्लिकेशन ID '{1}' Application Id बनता है: केवल अक्षर और अंक, अंक से शुरू नहीं"

msgid "the archive does not end in ZIP64 end records as MSIX packages do"
msgstr "संग्रह MSIX पैकेजों की तरह ZIP64 अंत रिकॉर्ड पर खत्म नहीं होता"

msgid "the archive has no ZIP64 end record"
msgstr "संग्रह में ZIP64 अंत रिकॉर्ड नहीं है"

msgid "the bundle manifest has no Identity Name, Publisher and Version"
msgstr "बंडल मैनिफ़ेस्ट में Identity Name, Publisher और Version नहीं हैं"

msgid "the cabinet has no room for a signature"
msgstr "cabinet में हस्ताक्षर के लिए जगह नहीं है"

msgid "the cabinet has reserved space in its folders or data blocks, which rubrapack does not lay out"
msgstr "cabinet के फ़ोल्डरों या डेटा ब्लॉकों में आरक्षित जगह है, जिसे rubrapack नहीं संभालता"

msgid "the cabinet's signature uses a hash rubrapack does not check (only SHA-256)"
msgstr "cabinet का हस्ताक्षर ऐसा हैश उपयोग करता है जिसे rubrapack नहीं जाँचता (केवल SHA-256)"

msgid "the central directory lies outside the archive"
msgstr "central directory संग्रह के बाहर है"

msgid "the certificate has a critical extension rubrapack does not understand"
msgstr "प्रमाणपत्र में ऐसा महत्वपूर्ण एक्सटेंशन है जिसे rubrapack नहीं समझता"

msgid "the certificate has expired"
msgstr "प्रमाणपत्र की समय-सीमा समाप्त हो गई है"

msgid "the certificate is a CA certificate, not a signing certificate"
msgstr "प्रमाणपत्र CA प्रमाणपत्र है, हस्ताक्षर प्रमाणपत्र नहीं"

msgid "the certificate is not for code signing (no code-signing extended key usage)"
msgstr "प्रमाणपत्र कोड हस्ताक्षर के लिए नहीं है (कोड-हस्ताक्षर extended key usage नहीं)"

msgid "the certificate is not valid yet"
msgstr "प्रमाणपत्र अभी मान्य नहीं है"

msgid "the certificate path is longer than 8"
msgstr "प्रमाणपत्र पथ 8 से लंबा है"

msgid "the certificate table does not hold an Authenticode signature"
msgstr "प्रमाणपत्र तालिका में Authenticode हस्ताक्षर नहीं है"

msgid "the certificate table is not at the end of the file"
msgstr "प्रमाणपत्र तालिका फ़ाइल के अंत में नहीं है"

msgid "the certificate's key usage does not allow digital signatures"
msgstr "प्रमाणपत्र का key usage डिजिटल हस्ताक्षर की अनुमति नहीं देता"

msgid "the certificate's subject cannot be written as an MSIX publisher"
msgstr "प्रमाणपत्र का subject MSIX प्रकाशक के रूप में नहीं लिखा जा सकता"

msgid "the chunked response is malformed"
msgstr "chunked प्रतिक्रिया विकृत है"

msgid "the command line: an unknown command or option, a file that cannot be read or written, a signature, a difference a transform cannot carry"
msgstr "कमांड लाइन: अज्ञात आदेश या विकल्प, ऐसी फ़ाइल जो पढ़ी या लिखी न जा सके, हस्ताक्षर, ऐसा अंतर जो ट्रांसफ़ॉर्म नहीं ले जा सकता"

msgid "the connection has failed"
msgstr "कनेक्शन विफल हुआ"

msgid "the embedded cabinets make the package 2 GiB or more, which Windows Installer cannot open; use cab = \"external\""
msgstr "एम्बेडेड cabinet पैकेज को 2 GiB या अधिक कर देती हैं, जिसे Windows Installer नहीं खोल सकता; cab = \"external\" का उपयोग करें"

msgid "the entry is not in the central directory"
msgstr "प्रविष्टि central directory में नहीं है"

msgid "the error dialog '%.*s' needs a %s control named %s (error 2835)"
msgstr "त्रुटि संवाद '{1}' को {3} नाम का {2} नियंत्रण चाहिए (त्रुटि 2835)"

msgid "the executable '%s' must be an .exe"
msgstr "executable '{1}' .exe होना चाहिए"

msgid "the executable's folder does not lead to a known location"
msgstr "executable का फ़ोल्डर किसी ज्ञात स्थान तक नहीं ले जाता"

msgid "the file is not signed"
msgstr "फ़ाइल हस्ताक्षरित नहीं है"

msgid "the file is signed already; rubrapack does not sign twice or replace a signature"
msgstr "फ़ाइल पहले से हस्ताक्षरित है; rubrapack दो बार हस्ताक्षर नहीं करता न हस्ताक्षर बदलता है"

msgid "the file is too large to sign"
msgstr "फ़ाइल हस्ताक्षर के लिए बहुत बड़ी है"

msgid "the file needs a [package] table (or [module] for a merge module)"
msgstr "फ़ाइल को [package] तालिका चाहिए (या मर्ज मॉड्यूल के लिए [module])"

msgid "the file was changed after it was signed (its digest does not match)"
msgstr "हस्ताक्षर के बाद फ़ाइल बदली गई (उसका डाइजेस्ट मेल नहीं खाता)"

msgid "the files to install: not found, a folder, a link, a glob without a match, another architecture's program, names too long"
msgstr "इंस्टॉल की जाने वाली फ़ाइलें: नहीं मिली, फ़ोल्डर, लिंक, बिना मेल का glob, दूसरे आर्किटेक्चर का प्रोग्राम, बहुत लंबे नाम"

msgid "the finished tables break a Windows Installer rule"
msgstr "तैयार तालिकाएँ Windows Installer का एक नियम तोड़ती हैं"

msgid "the hive was not closed cleanly (its log would be needed)"
msgstr "हाइव ठीक से बंद नहीं हुआ (उसका लॉग चाहिए होगा)"

msgid "the hive's base block checksum does not match"
msgstr "हाइव के base block का checksum मेल नहीं खाता"

msgid "the hive's bins lie outside the file"
msgstr "हाइव के bin फ़ाइल के बाहर हैं"

msgid "the icon of the installed apps list is [arp] icon = \"app.ico\""
msgstr "इंस्टॉल किए गए ऐप्स की सूची का आइकन [arp] icon = \"app.ico\" है"

msgid "the input ended before every question was answered; nothing was written"
msgstr "हर प्रश्न का उत्तर मिलने से पहले इनपुट समाप्त हो गया; कुछ नहीं लिखा गया"

msgid "the key file is larger than 4 MiB"
msgstr "कुंजी फ़ाइल 4 MiB से बड़ी है"

msgid "the key is neither RSA nor EC"
msgstr "कुंजी न RSA है न EC"

msgid "the library is not a PKCS#11 module (no C_GetFunctionList, or version 1)"
msgstr "लाइब्रेरी PKCS#11 मॉड्यूल नहीं है (C_GetFunctionList नहीं, या संस्करण 1)"

msgid "the manifest has no Identity Publisher"
msgstr "मैनिफ़ेस्ट में Identity Publisher नहीं है"

msgid "the manifest's Identity cannot be read for the package full name"
msgstr "पैकेज के पूरे नाम के लिए मैनिफ़ेस्ट की Identity नहीं पढ़ी जा सकती"

msgid "the merge module %s"
msgstr "मर्ज मॉड्यूल {1}"

msgid "the name %s"
msgstr "नाम {1}"

msgid "the package family %s is in the container twice"
msgstr "पैकेज परिवार {1} कंटेनर में दो बार है"

msgid "the package is not signed"
msgstr "पैकेज हस्ताक्षरित नहीं है"

msgid "the package is not signed (no AppxSignature.p7x)"
msgstr "पैकेज हस्ताक्षरित नहीं है (AppxSignature.p7x नहीं)"

msgid "the package is signed already; rubrapack does not sign twice or replace a signature"
msgstr "पैकेज पहले से हस्ताक्षरित है; rubrapack दो बार हस्ताक्षर नहीं करता न हस्ताक्षर बदलता है"

msgid "the package is signed already; rubrapack signs unsigned packages (and never twice)"
msgstr "पैकेज पहले से हस्ताक्षरित है; rubrapack बिना हस्ताक्षर वाले पैकेजों पर हस्ताक्षर करता है (और कभी दो बार नहीं)"

msgid "the package uses cabinets outside itself, which a signature of the .msi does not cover; build it with --key to sign them too, or with embedded cabinets, or sign anyway with --allow-unsigned-cabs"
msgstr "पैकेज अपने बाहर की cabinet उपयोग करता है, जिन्हें .msi का हस्ताक्षर शामिल नहीं करता; उन पर भी हस्ताक्षर के लिए इसे --key के साथ बनाएँ, या एम्बेडेड cabinet के साथ बनाएँ, या फिर भी --allow-unsigned-cabs से हस्ताक्षर करें"

msgid "the package's contents do not match its signature (it was changed after signing)"
msgstr "पैकेज की सामग्री उसके हस्ताक्षर से मेल नहीं खाती (हस्ताक्षर के बाद बदली गई)"

msgid "the package's directory cannot be read"
msgstr "पैकेज की निर्देशिका पढ़ी नहीं जा सकती"

msgid "the package's file name must not hold quotes or a percent sign: '%s'"
msgstr "पैकेज की फ़ाइल के नाम में उद्धरण चिह्न या प्रतिशत चिह्न नहीं होना चाहिए: '{1}'"

msgid "the packages of a bundle need the same Name, Publisher and Version"
msgstr "बंडल के पैकेजों के Name, Publisher और Version एक जैसे होने चाहिए"

msgid "the proxy asks for a password (407), which rubrapack does not support"
msgstr "प्रॉक्सी पासवर्ड माँगता है (407), जिसे rubrapack समर्थन नहीं करता"

msgid "the proxy did not answer the tunnel request"
msgstr "प्रॉक्सी ने टनल अनुरोध का उत्तर नहीं दिया"

msgid "the proxy sent data after its answer to CONNECT"
msgstr "प्रॉक्सी ने CONNECT के उत्तर के बाद डेटा भेजा"

msgid "the redirect location is too long"
msgstr "रीडायरेक्ट स्थान बहुत लंबा है"

msgid "the request could not be sent"
msgstr "अनुरोध भेजा नहीं जा सका"

msgid "the response has a malformed or conflicting Content-Length"
msgstr "प्रतिक्रिया में विकृत या परस्पर विरोधी Content-Length है"

msgid "the response has both Content-Length and chunked (refused: a smuggling risk)"
msgstr "प्रतिक्रिया में Content-Length और chunked दोनों हैं (अस्वीकृत: smuggling का जोखिम)"

msgid "the response is larger than 4 MiB"
msgstr "प्रतिक्रिया 4 MiB से बड़ी है"

msgid "the response uses a transfer coding other than chunked"
msgstr "प्रतिक्रिया chunked के अलावा कोई transfer coding उपयोग करती है"

msgid "the same condition is already required (line %u)"
msgstr "वही शर्त पहले से आवश्यक है (पंक्ति {1})"

msgid "the same without questions:\n  rubrapack new "
msgstr "यही बिना प्रश्नों के:\n  rubrapack new "

msgid "the server did not answer with HTTP/1.x"
msgstr "सर्वर ने HTTP/1.x से उत्तर नहीं दिया"

msgid "the server redirected from https to http (refused)"
msgstr "सर्वर ने https से http पर रीडायरेक्ट किया (अस्वीकृत)"

msgid "the server's CertificateVerify signature does not verify"
msgstr "सर्वर का CertificateVerify हस्ताक्षर सत्यापित नहीं होता"

msgid "the server's certificate is not for TLS servers (its extended key usage)"
msgstr "सर्वर का प्रमाणपत्र TLS सर्वरों के लिए नहीं है (उसका extended key usage)"

msgid "the server's signature scheme does not fit its certificate's key"
msgstr "सर्वर की हस्ताक्षर योजना उसके प्रमाणपत्र की कुंजी से मेल नहीं खाती"

msgid "the signature does not lie where the cabinet says"
msgstr "हस्ताक्षर वहाँ नहीं है जहाँ cabinet बताता है"

msgid "the signature does not verify"
msgstr "हस्ताक्षर सत्यापित नहीं होता"

msgid "the signature does not verify with the signer's certificate"
msgstr "हस्ताक्षरकर्ता के प्रमाणपत्र से हस्ताक्षर सत्यापित नहीं होता"

msgid "the signature entry is described the ZIP64 way; Windows reads its place from the ZIP32 fields"
msgstr "हस्ताक्षर प्रविष्टि ZIP64 तरीके से वर्णित है; Windows उसकी जगह ZIP32 फ़ील्ड से पढ़ता है"

msgid "the signature is not DER"
msgstr "हस्ताक्षर DER नहीं है"

msgid "the signature streams cannot be read"
msgstr "हस्ताक्षर स्ट्रीम पढ़ी नहीं जा सकतीं"

msgid "the signed attributes do not match the signed content"
msgstr "हस्ताक्षरित गुण हस्ताक्षरित सामग्री से मेल नहीं खाते"

msgid "the signer's certificate is not for code signing"
msgstr "हस्ताक्षरकर्ता का प्रमाणपत्र कोड हस्ताक्षर के लिए नहीं है"

msgid "the source file's encoding"
msgstr "स्रोत फ़ाइल का एन्कोडिंग"

msgid "the system random source failed"
msgstr "सिस्टम का यादृच्छिक स्रोत विफल हुआ"

msgid "the tab order (Control_Next) is not one cycle through its %zu controls from Control_First (Windows Installer stops with error 2809 or 2810)"
msgstr "टैब क्रम (Control_Next) Control_First से अपने {1} नियंत्रणों में एक चक्र नहीं है (Windows Installer त्रुटि 2809 या 2810 के साथ रुकता है)"

msgid "the timestamp server answered with an HTTP error"
msgstr "टाइमस्टैम्प सर्वर ने HTTP त्रुटि से उत्तर दिया"

msgid "the timestamp server's certificate is not for time stamping"
msgstr "टाइमस्टैम्प सर्वर का प्रमाणपत्र समय-मुद्रांकन के लिए नहीं है"

msgid "the timestamp server's time lies outside the signing certificate's validity"
msgstr "टाइमस्टैम्प सर्वर का समय हस्ताक्षर प्रमाणपत्र की वैधता से बाहर है"

msgid "the token does not say what kind of key it is"
msgstr "टोकन नहीं बताता कि कुंजी किस प्रकार की है"

msgid "the token is not present"
msgstr "टोकन मौजूद नहीं है"

msgid "the token returned an ECDSA signature of the wrong length"
msgstr "टोकन ने गलत लंबाई का ECDSA हस्ताक्षर लौटाया"

msgid "the token's EC key has a certificate that is not an EC one"
msgstr "टोकन की EC कुंजी का प्रमाणपत्र EC प्रकार का नहीं है"

msgid "the token's signature does not verify with the certificate (the key and the certificate do not belong together)"
msgstr "टोकन का हस्ताक्षर प्रमाणपत्र से सत्यापित नहीं होता (कुंजी और प्रमाणपत्र एक-दूसरे के नहीं)"

msgid "the trusted certificate is expired or not valid yet"
msgstr "विश्वसनीय प्रमाणपत्र की समय-सीमा समाप्त है या अभी मान्य नहीं"

msgid "the unsigned attributes are malformed or hold more than one timestamp"
msgstr "अहस्ताक्षरित गुण विकृत हैं या उनमें एक से अधिक टाइमस्टैम्प हैं"

msgid "the-toml-subset"
msgstr "the-toml-subset"

msgid "there is no such file here"
msgstr "यहाँ ऐसी कोई फ़ाइल नहीं"

msgid "there is no such folder here"
msgstr "यहाँ ऐसा कोई फ़ोल्डर नहीं"

msgid "this rubrapack was built without its menu part: [menu.*] items do not reach the Windows 11 menu"
msgstr "यह rubrapack अपने मेनू भाग के बिना बना है: [menu.*] आइटम Windows 11 मेनू तक नहीं पहुँचते"

msgid "this rubrapack was built without the setup program (nob parts)"
msgstr "यह rubrapack सेटअप प्रोग्राम के बिना बना है (nob parts)"

msgid "threading must be \"sta\", \"mta\", \"both\" or \"neutral\" (got '%s')"
msgstr "threading \"sta\", \"mta\", \"both\" या \"neutral\" होना चाहिए (मिला '{1}')"

msgid "timestamp: "
msgstr "टाइमस्टैम्प: "

msgid "too many languages for one bundle"
msgstr "एक बंडल के लिए बहुत अधिक भाषाएँ"

msgid "too many localized texts and logo scales for resources.pri"
msgstr "resources.pri के लिए बहुत अधिक स्थानीयकृत पाठ और लोगो स्केल"

msgid "too many packages in the bundle"
msgstr "बंडल में बहुत अधिक पैकेज"

msgid "transform '%s' in '%s' cannot be read: %s"
msgstr "'{2}' में रूपांतरण '{1}' पढ़ा नहीं जा सकता: {3}"

msgid "trusted"
msgstr "विश्वसनीय"

msgid "two actions share sequence %d (%.*s and %.*s); give an [action] a different sequence, before or after"
msgstr "दो क्रियाएँ एक ही sequence {1} साझा करती हैं ({2} और {3}); किसी एक [action] को दूसरा sequence, before या after दें"

msgid "two packages of one architecture in a bundle"
msgstr "एक बंडल में एक ही आर्किटेक्चर के दो पैकेज"

msgid "two packages of one name in a bundle"
msgstr "एक बंडल में एक ही नाम के दो पैकेज"

msgid "two resource packages of one ResourceId in a bundle"
msgstr "एक बंडल में एक ही ResourceId के दो संसाधन पैकेज"

msgid "type must be string, expand, dword, qword, binary or multi (got '%s')"
msgstr "type string, expand, dword, qword, binary या multi होना चाहिए (मिला '{1}')"

msgid "type must be text, checkbox, edit, radio, combo, listbox or bitmap (got '%s')"
msgstr "type को text, checkbox, edit, radio, combo, listbox या bitmap होना चाहिए ('{1}' मिला)"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' इस पैकेज की [file.*] नहीं है"

msgid "typelib-version is major.minor in hex digits, like \"1.0\" (got '%s')"
msgstr "typelib-version हेक्स अंकों में major.minor है, जैसे \"1.0\" (मिला '{1}')"

msgid "types and verb belong to kind = \"context-menu\""
msgstr "types और verb kind = \"context-menu\" से संबंधित हैं"

msgid "types: each is \".ext\" or \"*\" (every file)"
msgstr "types: हर एक \".ext\" या \"*\" (हर फ़ाइल) है"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: हर एक '.' और छोटे अक्षर, अंक, '_' या '-' है (मिला '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" उपयोगकर्ता को dir '{2}' का फ़ोल्डर चुनने देता है, जो मौजूद नहीं ([ui] install-dir सेट करें)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\" को चुनने के लिए [feature.*] तालिकाएँ चाहिए"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui none, basic, minimal, installdir या features होना चाहिए (मिला '{1}')"

msgid "unexpected text after the value"
msgstr "मान के बाद अनपेक्षित पाठ"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "अज्ञात आदेश '{1}' ('rubrapack help' देखें)"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "अज्ञात एस्केप \\{1} (बैकस्लैश वाले पाठ के लिए '...' का उपयोग करें)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "अज्ञात inspect विकल्प (तालिका नाम, --summary, --files या --streams का उपयोग करें)"

msgid "unknown key '%s' in [%s%s%s]"
msgstr "[{2}{3}{4}] में अज्ञात कुंजी '{1}'"

msgid "unknown key '%s' in [%s%s%s] (did you mean '%s'?)"
msgstr "[{2}{3}{4}] में अज्ञात कुंजी '{1}' (क्या आपका मतलब '{5}' था?)"

msgid "unknown or incomplete %s option '%s'"
msgstr "अज्ञात या अधूरा {1} विकल्प '{2}'"

msgid "unknown table [%s%s%s]"
msgstr "अज्ञात तालिका [{1}{2}{3}]"

msgid "unknown table [%s%s%s] (did you mean [%s]?)"
msgstr "अज्ञात तालिका [{1}{2}{3}] (क्या आपका मतलब [{4}] था?)"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "पैकेज को नई निर्देशिका में खोलें, उसी ढाँचे में जैसे वह इंस्टॉल होता है"

msgid "unsupported - %s"
msgstr "असमर्थित - {1}"

msgid "untrusted"
msgstr "अविश्वसनीय"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "update-* कुंजियों को appinstaller-uri और package-uri चाहिए"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false on = \"uninstall\" या \"both\" के लिए है (इंस्टॉलेशन कभी अपग्रेड का हटाना नहीं होता)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code {{12345678-1234-1234-1234-123456789ABC} जैसा GUID होना चाहिए"

msgid "usage: rubrapack %s"
msgstr "उपयोग: rubrapack {1}"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "उपयोग: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "उपयोग: rubrapack inspect <file.cab> (कोई तालिका या विकल्प नहीं)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "उपयोग: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "उपयोग: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "उपयोग: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "उपयोग: rubrapack inspect <setup.exe> (कोई तालिका या विकल्प नहीं)"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "उपयोग: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "उपयोग: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "use '/' in path"
msgstr "पथ में '/' का उपयोग करें"

msgid "use a full rubrapack build or another way"
msgstr "rubrapack का पूर्ण बिल्ड या कोई दूसरा तरीका उपयोग करें"

msgid "used by more than one component"
msgstr "एक से अधिक घटक उपयोग करते हैं"

msgid "users must be \"all\" (got '%s')"
msgstr "users \"all\" होना चाहिए (मिला '{1}')"

msgid "value '%s' is listed twice"
msgstr "मान '{1}' दो बार सूचीबद्ध है"

msgid "value missing"
msgstr "मान नहीं है"

msgid "values and labels are strings"
msgstr "values और labels स्ट्रिंग हैं"

msgid "values is an array of 1 to 32 strings"
msgstr "values 1 से 32 स्ट्रिंग की सरणी है"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "मान: ID, GUID, संस्करण, सीमा से बाहर संख्याएँ, ऐसी चीज़ों के संदर्भ जो मौजूद नहीं"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "चर '{1}' परिभाषित नहीं है ([define] या -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "चर नाम '{1}' में '=' नहीं हो सकता न वह = + - ! * से शुरू हो सकता है"

msgid "variables"
msgstr "चर"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "चर: बिना मान का $(NAME), बंद न किया गया $(, Windows नाम या dir ID जहाँ वह नहीं आ सकता"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "संस्करण '{1}' a.b.c या a.b.c.d होना चाहिए"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "संस्करण '{1}' a.b.c या a.b.c.d होना चाहिए, जहाँ a, b <= 255 और c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" 64-बिट पैकेज की किसी फ़ाइल के 'with' नहीं जा सकता"

msgid "view must be \"32\" or \"64\""
msgstr "view \"32\" या \"64\" होना चाहिए"

msgid "warning"
msgstr "चेतावनी"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "निदान कोड का अर्थ, उसे ले जाने वाले संदेश, क्या करें और मैनुअल कहाँ अधिक बताता है"

msgid "with must be \"file:<ID>\""
msgstr "with \"file:<ID>\" होना चाहिए"

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: फ़ाइल '{1}' इस पैकेज की [file.*] नहीं है"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "--pkcs11 के बिना `keys list` Windows प्रमाणपत्र भंडार दिखाता है"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' dir ID नहीं है"

msgid "write a Windows Sandbox configuration that installs the package in a fresh, disposable Windows"
msgstr "एक Windows Sandbox कॉन्फ़िगरेशन लिखता है जो पैकेज को नए, एक बार के Windows में इंस्टॉल करता है"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "पैच (.msp) लिखें: वे फ़ाइलें और पंक्तियाँ जो इंस्टॉल किए गए आधार को लक्ष्य तक अपडेट करती हैं"

msgid "write a shared package container's definition: MSIX packages that run in one container"
msgstr "साझा पैकेज कंटेनर की परिभाषा लिखता है: एक कंटेनर में चलने वाले MSIX पैकेज"

msgid "write a source file: made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "स्रोत फ़ाइल लिखें: उत्तरों से, पूछे गए या विकल्पों के रूप में दिए गए, एक तय आरंभिक फ़ाइल, या किसी मौजूदा MSI से"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "ट्रांसफ़ॉर्म (.mst) लिखें: जो एक पैकेज को दूसरे में बदलता है"

msgid "write the table or value the plain way the manual shows"
msgstr "तालिका या मान उसी सरल तरीके से लिखें जो मैनुअल दिखाता है"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "मान '[~]' के बिना लिखें; mode = \"append\" या \"prepend\" उसे जोड़ता है"

msgid "wrote %s\n"
msgstr "{1} लिखा गया\n"

msgid "x + width must be at most 370 (the page width)"
msgstr "x + width अधिकतम 370 होना चाहिए (पृष्ठ की चौड़ाई)"

msgid "y + height must be at most 234 (the line above the buttons)"
msgstr "y + height अधिकतम 234 होना चाहिए (बटनों के ऊपर की रेखा)"

