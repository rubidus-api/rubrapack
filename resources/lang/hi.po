# rubrapack language pack: Hindi.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: hi\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: हिन्दी\n"
"X-Rubrapack-LangIDs: 1081\n"
"X-Rubrapack-Font: Nirmala UI\n"
"X-Rubrapack-Group: 3\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, संवाद {6}{7}\n  1 नाम, निर्माता, संस्करण, आर्किटेक्चर            2 इंस्टॉल फ़ोल्डर, किसके लिए इंस्टॉल होता है\n  3 संवाद, लाइसेंस, भाषाएँ                       4 वैकल्पिक भाग\n  5 शॉर्टकट                                      6 फ़ाइलें: प्रोग्राम फ़ोल्डर से मिलाएँ\n  7 कोई भी कुंजी                                  v देखें   l lint   s सहेजें   q बाहर निकलें\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nइस कोड वाले संदेश (* किसी नाम या मान के स्थान पर है):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nपरिणाम stdout पर जाते हैं, निदान stderr पर।\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nक्या करें: {1}।\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} अब नहीं है, पर एक शॉर्टकट इसे खोलता है: पहले शॉर्टकट (5) बदलें\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  वहाँ {1} फ़ाइलें और {2} फ़ोल्डर\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s या q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] और [files.{2}] जोड़े गए\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] जोड़ा गया\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  इसे table.key के रूप में दें, जैसे package.version या dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: कोई समस्या नहीं\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: ऊपर की समस्याएँ देखें (वहाँ नामित फ़ाइल जाँच के लिए प्रति है)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages की अन्य भाषाएँ रखी जाती हैं; वह सूची 7 (कोई भी कुंजी) से बदलें\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] हटाया गया\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} हटाया गया\n"

msgid "  sub folders:"
msgstr "  उप-फ़ोल्डर:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  यह TOML उपसमुच्चय में नहीं बैठता; कुछ नहीं बदला गया\n"

msgid "  that was not readable text; again, please\n"
msgstr "  वह पढ़ने योग्य पाठ नहीं था; कृपया फिर से\n"

msgid "  the program folder '%s': %s\n"
msgstr "  प्रोग्राम फ़ोल्डर '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  स्रोत में कोई [file] तालिका नहीं जिसकी ओर शॉर्टकट इंगित करे\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  स्रोत में `new` द्वारा लिखे गए रूप में कोई उप-फ़ोल्डर नहीं ([files] \"<folder>/<name>/**\"); उन्हें 6 से जोड़ें\n"

msgid "  too long; again, please\n"
msgstr "  बहुत लंबा; कृपया फिर से\n"

msgid "  y or n\n"
msgstr "  y या n\n"

msgid " (changed)"
msgstr " (बदला गया)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) और MSIX (.msix) पैकेज बनाता है\n\nउपयोग: rubrapack [--lang <code>] <command> [arguments]\n\nआदेश:\n"

msgid " and its dir"
msgstr " और उसका dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) कोई पर्यावरण चर नहीं है, इसलिए विस्तारणीय मान इसे नहीं रख सकता; स्ट्रिंग मान का उपयोग करें (इंस्टॉल के समय भरा जाता है)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) एक {2} है: यह किसी पथ को शुरू कर सकता है, या उस मान के स्थान पर आ सकता है जिसे Windows Installer भरता है (रजिस्ट्री, पर्यावरण, INI, तर्क, संदेश), यहाँ नहीं"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ऐसा फ़ोल्डर नहीं जिससे पथ शुरू हो सके (कोई dir ID, या ProgramFiles, LOCALAPPDATA, ProgramData ... - मैनुअल का Paths देखें){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  संरचना:       {2}\n  डाइजेस्ट:      {3}\n  हस्ताक्षर:      {4}\n  शृंखला:        {5}{6}{7}\n  निरस्तीकरण:    जाँचा नहीं गया\n  टाइमस्टैम्प:    {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: चर सेट नहीं है"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' इस संवाद का नियंत्रण नहीं है"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3} में नहीं है"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': लाइसेंस पाठ को फ़ॉन्ट का अंग्रेज़ी नाम चाहिए, इसलिए यह भाषा के अपने फ़ॉन्ट में दिखता है; वहाँ भी यही फ़ॉन्ट उपयोग करने के लिए अंग्रेज़ी नाम लिखें (जैसे \"Malgun Gothic\")"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' एक फ़ोल्डर होना चाहिए"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} घटक, पर पैकेज प्लैटफ़ॉर्म {2} है"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\" से संबंधित नहीं है"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\" से संबंधित नहीं है"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} में LANGID (1..65535) होते हैं, जैसे 1041"

msgid "%s holds strings"
msgstr "{1} में स्ट्रिंग होती हैं"

msgid "%s is %u to %u characters long"
msgstr "{1} {2} से {3} वर्ण लंबा है"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} \"कुंजी=मान\" पाठों की सूची है"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} पाठों की सूची है, जैसे [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} 1 से 31 वर्णों का फ़ॉन्ट नाम है, जैसे \"Segoe UI\" (मिला {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} बंद उद्धरण चिह्नों और संतुलित कोष्ठकों वाली MSI शर्त है"

msgid "%s is an array of strings, one per value"
msgstr "{1} स्ट्रिंग की सरणी है, हर मान के लिए एक"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI पैकेजों के लिए है: MSIX को msiexec नहीं हटाता"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} अब नहीं है। [file.{2}] हटाएँ?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 वर्णों से लंबा है"

msgid "%s is new. Add it?"
msgstr "{1} नया है। जोड़ें?"

msgid "%s is not a GUID in registry format"
msgstr "{1} रजिस्ट्री प्रारूप में GUID नहीं है"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ऐसा कोड नहीं जिसे यह rubrapack उपयोग करता है{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} \"file:<ID>\" होना चाहिए जो इस पैकेज की किसी [file.*] को नामित करे"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} {2} से {3} अक्षर, अंक, '.' या '-' होना चाहिए, '.' से शुरू नहीं (मिला '{4}')"

msgid "%s must be a GUID"
msgstr "{1} GUID होना चाहिए"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} {{12345678-...} जैसा GUID होना चाहिए (मिला '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} एक http:// या https:// पता होना चाहिए ('{2}' मिला)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// या file:// पता, या \\\\server\\share पथ होना चाहिए (मिला '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} upgrade-code से भिन्न होना चाहिए (हर आर्किटेक्चर के लिए एक अपग्रेड परिवार)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} को Windows बिल्ड {2} या बाद वाला चाहिए: [msix] min-version = \"10.0.{3}.0\" सेट करें"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} को resources/bin/rubrapack_ca-{2}.dll चाहिए, जिसके बिना यह rubrapack बनाया गया था"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA जाँचा नहीं गया (--tsa-trust दें)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA विश्वसनीय"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA अविश्वसनीय - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} नहीं है या खाली है। [files.{3}] और [dir.{4}] हटाएँ?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ नया फ़ोल्डर है। जोड़ें?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: त्रुटियाँ: {2}{-3}, चेतावनियाँ: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: त्रुटियाँ: {2}{-3}, चेतावनियाँ: {4}{-5} ({6} की तुलना में)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} फ़ाइलें, {3} बाइट\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} फ़ाइलें, {3} त्रुटियाँ, 0 चेतावनियाँ\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} और निदान नहीं दिखाए गए\n"

msgid "%s: '%s' is not a program (.exe)"
msgstr "{1}: '{2}' प्रोग्राम (.exe) नहीं है"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' rubrapack द्वारा रखी जाने वाली मानक क्रिया नहीं है"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: फ़ाइल '{2}' इस पैकेज की [file.*] नहीं है"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: फ़ाइल '{2}' प्रोग्राम (.exe) नहीं है"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' बंद नहीं है (पाठ '$(' के लिए '$$(' लिखें)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' पहले से है; इसे जैसा है वैसा छोड़ा गया"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' पहले से है; इसे हटाएँ या किसी दूसरे फ़ोल्डर में बनाएँ"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' के पास पहले से {2} हैंडलर है ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' के पास पहले से अनुमतियाँ हैं"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' और '{2}' पैकेज में एक ही पथ हैं"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' Windows या ब्राउज़रों का है"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' को '{2}' के सामने नहीं पढ़ा जा सकता: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' TOML उपसमुच्चय में नहीं बैठता; कुछ नहीं सहेजा गया"

msgid "'%s' exists already"
msgstr "'{1}' पहले से है"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' पहले से है; इसे `rubrapack edit {2}` से बदलें"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' मौजूद है और खाली निर्देशिका नहीं है; किसी नई में निकालें"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' {2} में जाता है; या msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' की सारांश जानकारी स्ट्रीम पढ़ी नहीं जा सकती"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' में निकालने के लिए Directory, Component, File और Media तालिकाएँ नहीं हैं"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' में एम्बेडेड रूपांतरण '{2}' नहीं है"

msgid "'%s' has no readable summary information"
msgstr "'{1}' में पढ़ने योग्य सारांश जानकारी नहीं है"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' में ट्रांसफ़ॉर्म '{2}' नहीं है"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' UTF-16 है: edit केवल UTF-8 स्रोत बदलता है (पहले इसे UTF-8 में सहेजें)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' एक Windows नाम है; चर को कोई दूसरा नाम दें"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' एक [chain] है: यह सेटअप प्रोग्राम बनाता है, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' अंतर्निहित फ़्रेम का नियंत्रण है; कोई दूसरा ID चुनें"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' मशीन फ़ोल्डर है; {2} पैकेज वहाँ नहीं लिख सकता"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' मर्ज मॉड्यूल है: इसके बजाय इसे [merge.ID] से मिलाएँ"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' ऐसा नाम है जिसे MSIX प्रारूप अपने लिए रखता है"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' प्रतीकात्मक लिंक है; लिंक का अनुसरण नहीं किया जाता"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' एक [property.*] भी है"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' एक dir ID भी है; चर को कोई दूसरा नाम दें"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' मशीन 0x{2} के लिए बना है, इस पैकेज के arch के लिए नहीं; यदि यही इरादा है तो any-arch = true सेट करें"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' न PE फ़ाइल (.exe, .dll) है, न MSI पैकेज, न MSIX पैकेज या बंडल, न cabinet"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' न PE फ़ाइल है, न MSI पैकेज, न MSIX पैकेज या बंडल, न cabinet"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' न ज्ञात फ़ोल्डर है न dir ID (ज्ञात फ़ोल्डर: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' न MSIX पैकेज है न पैकेज परिवार का नाम (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' ऐसी cabinet नहीं जिसे rubrapack पढ़ सके (stored या MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' निदान कोड नहीं है (RP और चार अंक, जैसे RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' प्रोग्राम (.exe) नहीं है"

msgid "'%s' is not a regular file"
msgstr "'{1}' सामान्य फ़ाइल नहीं है"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' rubrapack सेटअप प्रोग्राम नहीं है{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' मान्य ID नहीं है (अक्षर, अंक और '_', अंक से शुरू नहीं, अधिकतम {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' मान्य MSI डेटाबेस नहीं है: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' मान्य MSIX पैकेज नहीं है: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' मान्य पैकेज नहीं है: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' मान्य स्रोत नहीं है (TOML उपसमुच्चय); पहले इसे हाथ से ठीक करें"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' मान्य ट्रांसफ़ॉर्म नहीं है: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' मान्य चर नाम नहीं है"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' आरक्षित है और ID के रूप में उपयोग नहीं हो सकता"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' किसी dir का नाम है: केवल रजिस्ट्री या dir खोज ही dir भर सकती है"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' प्रोग्राम फ़ाइल (PE) जैसा दिखता है पर उसके हेडर या संसाधन क्षतिग्रस्त हैं"

msgid "'%s' must be a string"
msgstr "'{1}' स्ट्रिंग होना चाहिए"

msgid "'%s' must be an integer"
msgstr "'{1}' पूर्णांक होना चाहिए"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' {2} और {3} के बीच होना चाहिए"

msgid "'%s' must be true or false"
msgstr "'{1}' true या false होना चाहिए"

msgid "'%s' must not be empty"
msgstr "'{1}' खाली नहीं होना चाहिए"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' कोई ट्रांसफ़ॉर्म नामित नहीं करता (सारांश गुण 8): पैच नहीं है"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' किसी फ़ोल्डर से शुरू होता है: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' में {4} है; कुछ नहीं निकाला गया"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} प्रविष्टियाँ, सीमा {3} (--limit-entries) से अधिक; कुछ नहीं निकाला गया"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' और '{3}' Windows पर एक ही पथ होंगे; कुछ नहीं निकाला गया"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' [ui] languages में नहीं है"

msgid "'%s': a table cannot be read"
msgstr "'{1}': एक तालिका पढ़ी नहीं जा सकती"

msgid "'%s': a table is unreadable"
msgstr "'{1}': एक तालिका अपठनीय है"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX अपनी सभी फ़ाइलें इंस्टॉल करता है (when); msi-only = true का उपयोग करें"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX अपनी सभी फ़ाइलें हटाता है (keep); msi-only = true का उपयोग करें"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' क्षतिग्रस्त है या stored/MSZIP नहीं है"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet नाम '{2}' सादा फ़ाइल नाम नहीं है"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': संपीड़ित फ़ाइल '{2}' (क्रम {3}) की कोई cabinet नहीं है"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': निर्देशिका '{2}' का पैरेंट '{3}' मौजूद नहीं है"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': निर्देशिका '{2}' स्वयं अपना पूर्वज है या बहुत गहराई तक नेस्टेड है"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': फ़ाइल '{2}' अपने MsiFileHash से मेल नहीं खाती"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': फ़ाइल '{2}' का कोई घटक या निर्देशिका नहीं है"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': फ़ाइल '{2}' {3} बाइट की है, File तालिका {4} कहती है"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': फ़ाइल '{2}' cabinet '{3}' में नहीं है"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': इसकी बाहरी cabinet हस्ताक्षर में शामिल नहीं हैं (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': इसका फ़ोल्डर किसी ज्ञात स्थान तक नहीं ले जाता"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': लिखने के लिए {2} बाइट से अधिक (--limit-bytes); कुछ नहीं निकाला गया"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': --timestamp नहीं: प्रमाणपत्र की समय-सीमा समाप्त होने पर हस्ताक्षर मान्य नहीं रहता"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': पैकेज '{2}' अपने SHA-256 से मेल नहीं खाता"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinet स्ट्रीम '{2}' मौजूद नहीं है"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': मैनिफ़ेस्ट में {2} {3} नहीं है"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': मैनिफ़ेस्ट '{2}' का नाम लेता है, जो पैकेज में नहीं है"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': {2} से टाइमस्टैम्प: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': ट्रांसफ़ॉर्म '{2}' को '{3}' के सामने नहीं पढ़ा जा सकता: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' पैकेज की अपनी भाषा है ({2}); वह पाठ प्रत्यय के बिना दें"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' से Windows Installer बहु-स्ट्रिंग लिखता है; type = \"multi\" और एक सरणी का उपयोग करें"

msgid "'_' in numbers is not supported"
msgstr "संख्याओं में '_' समर्थित नहीं है"

msgid "'help' takes at most one command name"
msgstr "'help' अधिकतम एक आदेश नाम लेता है"

msgid "'version' takes no arguments"
msgstr "'version' कोई तर्क नहीं लेता"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs .msi के लिए है"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "बंडल के लिए --arch: x64, x86 और arm64 की सूची, हर एक एक बार (मिला '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch एक आर्किटेक्चर लेता है, या .msixbundle / .msixupload आउटपुट के लिए सूची"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp और --allow-unsigned-cabs --key के साथ आते हैं"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress .msi के लिए है; MSIX --msix-compress deflate|store लेता है"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist स्रोत के बगल में नया फ़ोल्डर नामित करता है (कोई पथ नहीं)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat .msixbundle आउटपुट के लिए है (इसके पैकेज इसके बगल में लिखे जाते हैं)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs 1 से 64 तक की संख्या लेता है (मिला '{1}')"

msgid "--key signs at most %d external cabinets; raise cab-max-size"
msgstr "--key अधिकतम {1} बाहरी cabinet पर हस्ताक्षर करता है; cab-max-size बढ़ाएँ"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store Windows प्रमाणपत्र भंडार है; अन्यत्र कुंजी फ़ाइल या --pkcs11 का उपयोग करें"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store प्रमाणपत्र का SHA-1 थंबप्रिंट लेता है (40 हेक्स अंक)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: ऐसी कोई भाषा नहीं (अंतर्निहित: {2}; किसी अन्य को अपना भाषा पैक चाहिए, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (या RUBRAPACK_LANG) इन पाठों की भाषा चुनता है: {1}, या कोई भाषा जिसका भाषा पैक हो।\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang को भाषा चाहिए, जैसे en या ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages को संवाद चाहिए: --ui भी दें"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress deflate या store लेता है (मिला '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: चर सेट नहीं है"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code बड़े अक्षरों में कोष्ठकों सहित GUID लेता है: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: चर सेट नहीं है"

msgid "--previous compares two .msi packages"
msgstr "--previous दो .msi पैकेजों की तुलना करता है"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: ऑपरेटिंग सिस्टम के मूल प्रमाणपत्र पढ़े नहीं जा सकते"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} आउटपुट '{2}' से मेल नहीं खाता"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} लागू नहीं है (msi या msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target msi या msix लेता है (मिला '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots और --proxy --timestamp के साथ आते हैं"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test और --msix-compress .msix आउटपुट के लिए हैं"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test बिना हस्ताक्षर वाले पैकेजों के लिए है; --key के साथ इसे छोड़ दें"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate none लेता है, या product-code,upgrade-code,language,platform में से कुछ"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget .msi, .msix या .msixbundle आउटपुट के लिए है"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget को [winget] तालिका चाहिए: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget को पैकेज एक फ़ाइल में चाहिए: winget एक डाउनलोड करता है, इसलिए cab = \"external\" नहीं"

msgid "-D %.*s is given twice"
msgstr "-D {1} दो बार दिया गया है"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' एक Windows नाम है; चर को कोई दूसरा नाम दें"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D को NAME=VALUE चाहिए (मिला '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i हर उत्तर पूछता है; या तो -i दें या विकल्प"

msgid "; its range is "
msgstr "; इसकी सीमा है "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' SecureCustomProperties में नहीं है"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty सार्वजनिक (बड़े अक्षरों वाला) गुण होना चाहिए"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/reference.html#diagnostic-codes\n"
msgstr "सभी कोड: https://rubidus-api.github.io/rubrapack/en/reference.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x PKCX से शुरू नहीं होता"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x अंतिम प्रविष्टि नहीं है"

msgid "Architecture (x64, x86, arm64)"
msgstr "आर्किटेक्चर (x64, x86, arm64)"

msgid "Choose"
msgstr "चुनें"

msgid "Command line"
msgstr "कमांड लाइन"

msgid "Command line (lint)"
msgstr "कमांड लाइन (lint)"

msgid "Common AppData"
msgstr "साझा AppData"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId रजिस्ट्री प्रारूप में GUID नहीं है"

msgid "Desktop shortcut?"
msgstr "डेस्कटॉप शॉर्टकट?"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "संवाद (none, basic, minimal, installdir, features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "निकास कोड: 0 ठीक, 1 स्रोत त्रुटि, 2 उपयोग, 3 इनपुट/आउटपुट, 4 हस्ताक्षर या सत्यापन,\n5 lint, 6 नेटवर्क।\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "File, Component या Directory तालिका में एक मानक स्तंभ नहीं है"

msgid "Folder name under Program Files"
msgstr "Program Files के अंतर्गत फ़ोल्डर का नाम"

msgid "Folder with the files to install"
msgstr "इंस्टॉल की जाने वाली फ़ाइलों वाला फ़ोल्डर"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "ID '{1}' पहले से उपयोग में है (पंक्ति {2}); सभी तालिकाओं में ID अलग होने चाहिए"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "इंस्टॉल फ़ोल्डर ([dir.INSTALLDIR] पथ)"

msgid "Install for (machine, user, dual)"
msgstr "किसके लिए इंस्टॉल (machine, user, dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "table.key के रूप में कुंजी (package.version, dir.INSTALLDIR.path, ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' किसी दूसरे घटक का है"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' File में नहीं है"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' Registry में नहीं है"

msgid "Korean dialogs as well as English?"
msgstr "अंग्रेज़ी के साथ कोरियाई संवाद भी?"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} किसी निचले DiskId वाले से कम है"

msgid "Leave without saving the changes?"
msgstr "बदलाव सहेजे बिना बाहर निकलें?"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "स्वीकार करने हेतु लाइसेंस (.txt, .md, .rtf; - कोई नहीं)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "MSIX में उपयोगकर्ता के AppData के लिए कोई आभासी फ़ोल्डर नहीं; ऐप चलने पर वहाँ ज़रूरी चीज़ें खुद बनाता है"

msgid "MSIX packages"
msgstr "MSIX पैकेज"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: MSIX पैकेज को क्या चाहिए, और वह क्या नहीं ले जा सकता"

msgid "Main program, for shortcuts (- for none)"
msgstr "मुख्य प्रोग्राम, शॉर्टकट के लिए (- कोई नहीं)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "मैनुअल: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "निर्माता"

msgid "Manufacturer (shown in Installed apps)"
msgstr "निर्माता (Installed apps में दिखता है)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt ने गलत लंबाई का ECDSA हस्ताक्षर लौटाया"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "वैकल्पिक भाग जिन्हें उपयोगकर्ता चुन सकता है (उप-फ़ोल्डर, अल्पविराम से; - कोई नहीं)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "PKCS#11 टोकन: टोकन में कुंजी के CKA_ID वाला कोई प्रमाणपत्र नहीं (इसे --cert से दें)"

msgid "Paths"
msgstr "पथ"

msgid "Product name"
msgstr "उत्पाद का नाम"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode और UpgradeCode एक ही GUID हैं"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} अपने पहले तीन भागों में पिछले {2} से ऊँचा नहीं है: Windows Installer अपग्रेड नहीं करता"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "वह प्रोग्राम जिसे शॉर्टकट खोलते हैं (- कोई शॉर्टकट नहीं)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: ऐसी कोई भाषा नहीं (अंतर्निहित: {2}; किसी अन्य को अपना भाषा पैक चाहिए, {3}.po)"

msgid "Reference, "
msgstr "संदर्भ, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "क्रम {1} किसी Media पंक्ति में शामिल नहीं है (अंतिम {2})"

msgid "Sequence %ld is used by another file"
msgstr "क्रम {1} किसी दूसरी फ़ाइल द्वारा उपयोग में है"

msgid "Source file to write"
msgstr "लिखने के लिए स्रोत फ़ाइल"

msgid "Source format"
msgstr "स्रोत प्रारूप"

msgid "Source must name a File row for type %ld"
msgstr "प्रकार {1} के लिए Source को कोई File पंक्ति नामित करनी चाहिए"

msgid "Start menu shortcut?"
msgstr "स्टार्ट मेनू शॉर्टकट?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "स्टार्ट मेनू, Programs, डेस्कटॉप और Startup प्रविष्टियाँ [shortcut.*] और [msix-extension.*] से आती हैं"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML उस उपसमुच्चय से बाहर जो rubrapack पढ़ता है, या `format` गायब या बहुत नया है"

msgid "Tables"
msgstr "तालिकाएँ"

msgid "The TOML subset"
msgstr "TOML उपसमुच्चय"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "UTF-16 big-endian फ़ाइलें समर्थित नहीं हैं; UTF-8 में सहेजें"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} पिछले संस्करण के {2} से भिन्न है: यह पैकेज उसे नहीं बदलता"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode रजिस्ट्री प्रारूप में GUID नहीं है"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "मान (पाठ, संख्या, true/false, [\"a\", \"b\"]; - कुंजी हटाता है)"

msgid "Variables"
msgstr "चर"

msgid "Version"
msgstr "संस्करण"

msgid "Version ([define] VERSION)"
msgstr "संस्करण ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "संस्करण और अपग्रेड"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer अधिकतम 255.255.65535(.65535) की अनुमति देता है"

msgid "Windows did not say what is installed for '%s'"
msgstr "Windows ने नहीं बताया कि '{1}' के लिए क्या इंस्टॉल है"

msgid "Windows name"
msgstr "Windows नाम"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] को '{4}' चाहिए"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] मर्ज मॉड्यूल में नहीं जा सकता; उसे मिलाने वाले पैकेज में यह होता है"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] अभी समर्थित नहीं है ({3} के लिए नियोजित)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] MSIX में नहीं जा सकता; इसके बिना MSIX बनाने के लिए msi-only = true जोड़ें"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] उपयोगकर्ता के AppData या LocalAppData में है: सभी उपयोगकर्ताओं के लिए इंस्टॉल किया गया dual पैकेज इसे केवल इंस्टॉल करने वाले उपयोगकर्ता की प्रोफ़ाइल में रखता है"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: मर्ज मॉड्यूल में ID अधिकतम 35 वर्णों का होता है (मॉड्यूल का GUID उसमें जोड़ा जाता है)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] को ID चाहिए: [{2}.ID] लिखें"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] ID नहीं लेता: [{2}] लिखें"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml में </Types> नहीं है"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml अंतिम प्रविष्टि नहीं है (ऐसा पैकेज नहीं जिसे rubrapack या Windows के पैकेजिंग API ने लिखा)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "[[...]] तालिका-सरणियाँ समर्थित नहीं हैं; हर आइटम को अपना [kind.ID] दें"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] एक बार रखा जाता है: before, after या sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] को do और undo दोनों चाहिए (undo विफल do को भी वापस लेता है)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] को entry चाहिए: बुलाया जाने वाला DLL फ़ंक्शन"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] को run = \"file:<ID>\" चाहिए: वह प्रोग्राम जिसे do और undo चलाते हैं"

msgid "[action.%s] runs a file of this package before InstallFinalize, where a first installation does not have it yet (Windows Installer error 1721 or 1723): place it after InstallFinalize, or make it deferred"
msgstr "[action.{1}] InstallFinalize से पहले इस पैकेज की एक फ़ाइल चलाता है, जबकि पहली इंस्टॉलेशन में वह फ़ाइल अभी नहीं होती (Windows Installer त्रुटि 1721 या 1723): इसे InstallFinalize के बाद रखें या deferred बनाएँ"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] एक चीज़ चलाता है: run (एक exe), dll (इंस्टॉल की गई DLL) या binary (पैकेज में मौजूद DLL); या do और undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} एक क्रिया के लिए है, do/undo जोड़े के लिए नहीं"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: इंस्टॉल की गई फ़ाइल चलाने वाली स्थगित क्रिया InstallFiles के बाद होनी चाहिए (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: तत्काल क्रिया इंस्टॉल करने वाले उपयोगकर्ता के रूप में चलती है; as अन्य चरणों के लिए है"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args एक प्रोग्राम के हैं; DLL data लेती है"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check do/undo जोड़े के साथ जाता है"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data स्थगित, commit या rollback क्रिया के लिए है (तत्काल क्रिया गुण पढ़ती है)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry एक DLL का फ़ंक्शन है; run args लेता है"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: MSIX के लिए args सादा पाठ होने चाहिए (इंस्टॉल के समय भरा जाने वाला [...] नहीं)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: MSIX में फ़ाइल प्रकार एक ऐप्लिकेशन खोलता है: target किसी [msix-app.*] का executable होना चाहिए"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] दो बार है"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] को ID चाहिए: [chain-package.ID] लिखें"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id और typelib केवल MSI के लिए लिखे जाते हैं; MSIX क्लास को इनके बिना पंजीकृत करता है"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args प्रोग्राम के होते हैं; DLL लोड होता है, शुरू नहीं होता"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate DLL को dllhost में चलाता है; '{2}' एक प्रोग्राम है"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading DLL के लिए है; प्रोग्राम अपना apartment खुद तय करता है"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version और typelib-file को typelib चाहिए"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] {2} में जाता है; या msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: इसका स्रोत ऐसी फ़ाइल होनी चाहिए जो पैकेज में जाती है"

msgid "[define] values must be strings"
msgstr "[define] मान स्ट्रिंग होने चाहिए"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] को '{2}' चाहिए"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] को image चाहिए"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] को 'property' चाहिए"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] को 'text' चाहिए"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] को 'values' चाहिए"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] में {2} नियंत्रण हैं; अधिकतम 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] में कोई [dialog-control.*] नहीं है"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] अन्य संवादों के रास्ते स्वयं के बाद रखा गया है"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] को ui = \"minimal\", \"installdir\" या \"features\" चाहिए"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' एक Windows नाम है; dir को कोई दूसरा ID दें"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard को rubrapack का सहायक DLL चाहिए, जिसे मर्ज मॉड्यूल नहीं रखता"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] को एक फ़ीचर चाहिए"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX अपने सभी चर सेट करता है (when); msi-only = true का उपयोग करें"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: इसका मान ऐसी जगह बताता है जो MSIX नहीं दे सकता (पैकेज के बाहर का कोई फ़ोल्डर जो Windows फ़ोल्डर नहीं, या इंस्टॉल के समय का भाग); msi-only = true का उपयोग करें"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: external-location = true के साथ पैकेज में प्रोग्राम की कोई फ़ाइल नहीं होती, इसलिए rubrapack का लॉन्चर भी नहीं; या msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] पहले से ही अपने प्रोग्राम के फ़ोल्डर में है; isolate-for कहीं और इंस्टॉल की गई साझा DLL के लिए है"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] उपयोगकर्ता प्रोफ़ाइल में है और इसमें component-guid है: इसका कुंजी पथ फ़ाइल ही रहता है, जबकि Windows के नियम वहाँ HKCU मान चाहते हैं (ICE38); वह पाने के लिए component-guid हटाएँ"

msgid "[file.%s]: %s"
msgstr "[file.{1}]: {2}"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' .NET असेंबली नहीं है (Assembly पंक्ति वाला CLI हेडर नहीं)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: .NET असेंबली अपना मैनिफ़ेस्ट ख़ुद रखती है; manifest, Win32 असेंबली के लिए है"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: Win32 असेंबली को manifest = \"file:<ID>\", यानी अपनी मैनिफ़ेस्ट फ़ाइल चाहिए"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: साझा .NET असेंबली GAC में जाती है, जो केवल मज़बूत नाम वाली असेंबली लेता है; इस पर हस्ताक्षर करें या assembly-for = \"file:<प्रोग्राम>\" दें"

msgid "[file.%s]: a shared Win32 assembly goes into WinSxS with a catalog signed by the key its manifest's publicKeyToken names; build with --key (or give assembly-for = \"file:<program>\" for a private one)"
msgstr "[file.{1}]: साझा Win32 असेंबली WinSxS में ऐसे कैटलॉग के साथ जाती है जो मैनिफ़ेस्ट के publicKeyToken द्वारा बताई गई कुंजी से हस्ताक्षरित हो; --key के साथ बनाएँ (या निजी असेंबली के लिए assembly-for = \"file:<प्रोग्राम>\" दें)"

msgid "[file.%s]: a shared Win32 assembly's manifest '%s' names its signer: publicKeyToken in assemblyIdentity (the token of the --key it is built with)"
msgstr "[file.{1}]: साझा Win32 असेंबली का मैनिफ़ेस्ट '{2}' अपने हस्ताक्षरकर्ता को बताता है: assemblyIdentity में publicKeyToken (जिस --key से बनाया जाता है उसका टोकन)"

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for और manifest, assembly = \"dotnet\" या \"win32\" के साथ आते हैं"

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: इसके मैनिफ़ेस्ट '{2}' में name और version वाला assemblyIdentity नहीं है"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: इसका मैनिफ़ेस्ट '{2}' उसी dir और feature में (उसी when के साथ) होना चाहिए: दोनों एक घटक हैं"

msgid "[file.%s]: its manifest names publicKeyToken \"%s\", but the --key's token is \"%s\""
msgstr "[file.{1}]: मैनिफ़ेस्ट publicKeyToken \"{2}\" बताता है, पर --key का टोकन \"{3}\" है"

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: मैनिफ़ेस्ट '{2}' किसी दूसरी असेंबली का है या ख़ुद असेंबली है"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: एक्सप्लोरर {2} हैंडलर DLL से लोड करता है; [com.{3}] एक प्रोग्राम है"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows गुण हैंडलर केवल प्रति मशीन पढ़ता है; पैकेज को scope = \"machine\" चाहिए"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: पूर्वावलोकन हैंडलर Windows के prevhost में चलता है; app-id और surrogate को [com.{2}] से बाहर रखें"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX केवल थंबनेल और पूर्वावलोकन हैंडलर रखता है (पैक किए गए गुण हैंडलर ने एक्सप्लोरर को कोई मान नहीं दिए); msi-only = true इसे MSI के लिए रखता है"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: MSIX का फ़ाइल प्रकार किसी ऐप्लिकेशन का होता है; एक [msix-app.*] जोड़ें"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: क्लास {2} इस पैकेज की [com.*] नहीं है (हैंडलर का DLL इसे सेवा देता है)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX में हैंडलर अपने सभी प्रकार साझा करते हैं या कोई नहीं (एक प्रकार एक फ़ाइल प्रकार संबंध में होता है)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX में इसकी क्लास surrogate में चलती है; [com.{2}] में threading = \"sta\" इसकी विंडो को संदेश लूप देता है (threading = {3} के साथ पूर्वावलोकन खाली रह सकता है)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX में इसके सभी प्रकार एक [assoc] फ़ाइल प्रकार में होते हैं, या किसी में नहीं"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: इसकी क्लास msi-only है ([com.{2}]); MSIX में इसके लिए कोई सर्वर नहीं होगा"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types फ़ाइल प्रकारों की सूची है, जैसे [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2} में जाता है; या msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] को 'value' चाहिए"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] को फ़ीचर चाहिए: 'feature' यहाँ या उसके dir पर सेट करें"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX अपनी सभी INI प्रविष्टियाँ लिखता है (when); msi-only = true का उपयोग करें"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: इसके मान में ऐसा भाग है जिसे Windows Installer इंस्टॉल के समय भरता है ([...]); MSIX फ़ाइल बनते समय लिखता है"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] को 'on' चाहिए: आइटम कहाँ दिखता है, जैसे [\".txt\"] या \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] को 'target' (जो प्रोग्राम यह शुरू करता है) चाहिए, या parent = \"{2}\" वाले आइटम (उप-मेनू)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] को 'target' चाहिए: वह प्रोग्राम जिसे आइटम शुरू करता है"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 का मेन्यू केवल अक्षरों और अंकों वाला ID लेता है ('_' नहीं): नाम बदलें, या windows11 = false करें"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: उप-मेनू कुछ शुरू नहीं करता: 'args' छोड़ दें"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: उप-मेनू का आइटम वहीं दिखता है जहाँ उसका उप-मेनू: 'on' छोड़ दें"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args में ऐसा भाग है जिसे Windows Installer इंस्टॉल के समय भरता है ([...]); MSIX में केवल स्थिर पाठ होता है"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when, \"HKCU\\\\key\\\\value\" या \"HKLM\\\\...\" होता है, Windows 11 मेन्यू के ऐसे आइटम पर जो किसी उप-मेन्यू में न हो"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when ऐसा मान बताता है जिसे यह पैकेज खुद लिखता है ([registry.{2}]): आइटम कभी नहीं दिखेगा"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: इसका प्रोग्राम MSIX में नहीं है (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: इसके मान पैकेज की रजिस्ट्री में नहीं जा सकते"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list में ऐसा भाग है जिसे Windows Installer इंस्टॉल के समय भरता है ([...]); MSIX में केवल स्थिर पाठ होता है"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: जब पथ एक कमांड लाइन में नहीं समाते, तब list, {2} की जगह लेता है: multi = \"one\", args में {3} और list में {4} (सूची फ़ाइल) चाहिए"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": कोई [assoc.{3}] नहीं है"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on एक फ़ाइल प्रकार या उनकी सूची है, जैसे [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' कोई [menu.*] नहीं है"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' उप-मेनू होना चाहिए: बिना target और बिना अपने parent वाला [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2} में जाता है; या msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] को फ़ीचर चाहिए: 'feature' यहाँ या उसके dir पर सेट करें"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; या msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] को feature चाहिए (या with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature अपने घटक के साथ जाता है, with के साथ नहीं"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name एक फ़ाइल बताता है; name में वाइल्डकार्ड हैं"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: शेयर लक्ष्य को types, formats या दोनों चाहिए"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: ऑटोप्ले हैंडलर को content-events, device-events या दोनों चाहिए"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args सादा पाठ होने चाहिए (इंस्टॉल के समय भरा जाने वाला [...] नहीं)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events को class चाहिए (प्रोग्राम की IHWEventHandler COM क्लास)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file {2} होना चाहिए"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file को ऐसी फ़ाइल नामित करनी चाहिए जो पैकेज में जाती है"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file को ऐसा प्रोग्राम नामित करना चाहिए जो पैकेज में जाता है"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types फ़ाइल प्रकारों की सूची है, जैसे [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows केवल अक्षर और अंक लेता है"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64 के लिए [msix-psf] को launcher = \"...\" चाहिए (PSF अपने लॉन्चरों को PsfLauncher32.exe, PsfLauncher64.exe कहता है)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] न external-location = true के साथ चलता है न [env.*] (rubrapack का अपना लॉन्चर) के साथ"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] एप्लिकेशन PSF लॉन्चर से शुरू करता है: इसे [msix-app.ID] चाहिए"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' अपने \"applications\" में एप्लिकेशन '{2}' का नाम नहीं लेता"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files में '{1}' (लॉन्चर) नहीं है"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: फ़ाइल '{2}' DLL नहीं है"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] अपना ड्राइवर एक बार बताता है: driver (एक [odbc-driver]) या driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] को driver-name के साथ with = \"file:<ID>\" चाहिए: वह घटक जिसके साथ यह इंस्टॉल होता है"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: प्रति मशीन पैकेज डेटा स्रोतों को मशीन के लिए पंजीकृत करता है"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] एक प्रति बताता है: msix (publisher के साथ) या upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix पैकेज का पहचान नाम है (3 से 50 अक्षर, अंक, '.' या '-') और इसे publisher (\"CN=...\") चाहिए, जैसा उसके मैनिफ़ेस्ट में है"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: दूसरी प्रति को पूर्व-जाँच खोजती है: preflight = true चाहिए"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code इसी पैकेज का है (वह अपग्रेड है, दूसरी प्रति नहीं)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] के dir में एक फ़ीचर होना चाहिए"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX के लिए args सादा पाठ होने चाहिए (इंस्टॉल के समय भरा जाने वाला [...] नहीं)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX में स्कीम एक ऐप्लिकेशन खोलती है: target किसी [msix-app.*] का executable होना चाहिए"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] को 'value' चाहिए (या remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR MSIX के बाहर नहीं पहुँचता; [assoc.*], [protocol.*], [com.*] या [handler.*] का उपयोग करें, या msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword मान को rubrapack का सहायक DLL चाहिए, जिसे मर्ज मॉड्यूल नहीं रखता"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX केवल {2}\\Software के अंतर्गत मान रखता है"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX न मान हटाता है न उन्हें पीछे छोड़ता है (remove, keep); msi-only = true का उपयोग करें"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX अपने सभी मान लिखता है (when); msi-only = true का उपयोग करें"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: इसके मान में ऐसा भाग है जिसे Windows Installer इंस्टॉल के समय भरता है ([...]); MSIX में केवल स्थिर मान होते हैं"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" को rubrapack का सहायक DLL चाहिए, जिसे मर्ज मॉड्यूल नहीं रखता"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: कुंजी या मान का नाम रजिस्ट्री हाइव में नहीं जा सकता"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" कंप्यूटर-स्तरीय पैकेज में on = \"uninstall\" के साथ root = \"HKCU\" के लिए है"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] को फ़ीचर चाहिए: 'feature' यहाँ या उसके dir पर सेट करें"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true {2} के नीचे के फ़ोल्डर के लिए नहीं है"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true को rubrapack का सहायक DLL चाहिए, जिसे मर्ज मॉड्यूल नहीं रखता"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" कंप्यूटर-स्तरीय पैकेज में AppData या LocalAppData के फ़ोल्डर पर recursive = true के लिए है"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX के लिए args सादा पाठ होने चाहिए (इंस्टॉल के समय भरा जाने वाला [...] नहीं)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file को ऐसा प्रोग्राम नामित करना चाहिए जो पैकेज में जाता है"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] सुविधा '{2}' का विज्ञापन करता है, जिसमें advertise = \"disallow\" है"

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise को when के साथ नहीं जोड़ा जाता"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX के शॉर्टकट केवल डेस्कटॉप और स्टार्ट मेनू में होते हैं{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX शॉर्टकट का कोई working-dir नहीं होता"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX शॉर्टकट हमेशा रहता है (when MSI के लिए है)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX शॉर्टकट अपने ऐप्लिकेशन का लोगो दिखाता है; icon MSI के लिए है"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: विज्ञापित शॉर्टकट MSI के लिए है (MSIX पूरे पैकेज को इंस्टॉल करता है)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: विज्ञापित शॉर्टकट को एक आइकन चाहिए"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX के लिए args सादा पाठ होने चाहिए (इंस्टॉल के समय भरा जाने वाला [...] नहीं)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX में शॉर्टकट एक ऐप्लिकेशन शुरू करता है: target किसी [msix-app.*] का executable होना चाहिए"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX की स्टार्ट मेनू प्रविष्टि उसका ऐप्लिकेशन है, जो args नहीं लेता"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: किसी संवाद पाठ का यह ID नहीं है"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded MSI के लिए है; MSIX का अपना इंस्टॉलर UI नहीं होता"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] को [package] में ui = \"basic\" या किसी अन्य संवाद सेट की आवश्यकता है (या embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} एस्केप कोई Unicode स्केलर मान नहीं है"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: यह पैकेज पिछले वाले को ठीक से अपग्रेड नहीं करेगा"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "किसी पैकेज का `lint`: संवाद, कोड पेज, पाठ सामान्यीकरण"

msgid "`lint` of an MSIX package or bundle"
msgstr "MSIX पैकेज या बंडल का `lint`"

msgid "a %s control has no property"
msgstr "{1} नियंत्रण में property नहीं है"

msgid "a %s control has no text; put a text control beside it"
msgstr "{1} नियंत्रण में कोई पाठ नहीं; उसके बगल में पाठ नियंत्रण रखें"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "{1} नियंत्रण को [property.{2}] चाहिए जिसमें उसका कोई मान डिफ़ॉल्ट हो (मौन इंस्टॉलेशन इसका उपयोग करता है)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "{1} पैकेज HKLM में नहीं लिख सकता; HKMU का उपयोग करें"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr ".msix आउटपुट को executable नामित करने वाली [msix-app.ID] तालिका चाहिए"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr ".msix आउटपुट को [msix] तालिका चाहिए (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr ".msm आउटपुट मर्ज मॉड्यूल है, जो [package] के बजाय [module] वाले स्रोत से बनता है"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr ".txt, .md या .rtf फ़ाइल, या - कोई नहीं"

msgid "a PE file without a certificate table entry"
msgstr "प्रमाणपत्र तालिका प्रविष्टि के बिना PE फ़ाइल"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN कभी कमांड लाइन से नहीं लिया जाता (दूसरे उसे देख सकते हैं); --pin-env या --pin-file का उपयोग करें"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "बंडल मैनिफ़ेस्ट का अज्ञात Type वाला Package"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "FileName, Offset या Size के बिना बंडल मैनिफ़ेस्ट का Package"

msgid "a ZIP entry does not inflate to its size"
msgstr "ZIP प्रविष्टि अपने आकार तक विस्तृत नहीं होती"

msgid "a ZIP entry larger than allowed"
msgstr "ZIP प्रविष्टि अनुमति से बड़ी है"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "ZIP प्रविष्टि का CRC-32 मेल नहीं खाता"

msgid "a ZIP entry's data lies outside the file"
msgstr "ZIP प्रविष्टि का डेटा फ़ाइल के बाहर है"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "[module] स्रोत मर्ज मॉड्यूल बनाता है: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "बाइनरी मान सम संख्या में हेक्स अंक होता है, जैसे \"01A0FF\""

msgid "a bundle without packages"
msgstr "पैकेजों के बिना बंडल"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "पथ के किसी प्रमाणपत्र में ऐसा महत्वपूर्ण एक्सटेंशन है जिसे rubrapack नहीं समझता"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "पथ का कोई प्रमाणपत्र ऐसे प्रमाणपत्र से हस्ताक्षरित है जो CA नहीं है"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "chain में केवल [chain], [chain-package.ID] और [define] होते हैं, [{1}] नहीं; पैकेज अपने स्रोतों से बनते हैं"

msgid "a chain holds at most %d packages"
msgstr "chain में अधिकतम {1} पैकेज होते हैं"

msgid "a chain needs [chain]"
msgstr "chain को [chain] चाहिए"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "chain को कम से कम एक [chain-package.ID] चाहिए"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "ऐसा वर्ण जिसकी Windows नाम में अनुमति नहीं देता (/ \\ : * ? \" < > |)"

msgid "a container holds at most %u package families"
msgstr "एक कंटेनर में अधिकतम {1} पैकेज परिवार होते हैं"

msgid "a control character"
msgstr "नियंत्रण वर्ण"

msgid "a damaged PE optional header"
msgstr "क्षतिग्रस्त PE optional header"

msgid "a damaged PE section table"
msgstr "क्षतिग्रस्त PE सेक्शन तालिका"

msgid "a damaged ZIP64 end record"
msgstr "क्षतिग्रस्त ZIP64 अंत रिकॉर्ड"

msgid "a damaged cabinet header"
msgstr "खराब cabinet हेडर"

msgid "a damaged hive bin"
msgstr "क्षतिग्रस्त hive bin"

msgid "a diagnostic of rubrapack"
msgstr "rubrapack का निदान"

msgid "a disabled service cannot be started"
msgstr "अक्षम सेवा शुरू नहीं की जा सकती"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "dual पैकेज उपयोगकर्ता और सिस्टम चर के बीच चुन नहीं सकता"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "dual पैकेज HKMU में लिखता है (इंस्टॉल के अनुसार HKLM या HKCU), HKCU में नहीं"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "dword मान 0..4294967295 (0x0..0xFFFFFFFF) का पूर्णांक है"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "ऐसी सुविधा जो यह rubrapack नहीं देता (या इसके बिना बना है)"

msgid "a file larger than allowed"
msgstr "अनुमति से बड़ी फ़ाइल"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "'{1}' के अंतर्गत एक फ़ाइल नाम मान्य Unicode नहीं है और पैक नहीं किया जा सकता"

msgid "a file name without / \\ : * ? \" < > | $"
msgstr "/ \\ : * ? \" < > | $ के बिना फ़ाइल नाम"

msgid "a file's component or directory chain is broken"
msgstr "किसी फ़ाइल की घटक या निर्देशिका शृंखला टूटी है"

msgid "a font goes into an MSIX through a [font.*] that names it"
msgstr "फ़ॉन्ट MSIX में उसे नामित करने वाले [font.*] के ज़रिए जाता है"

msgid "a framework package has no applications, capabilities or dependencies of its own (%s)"
msgstr "फ़्रेमवर्क पैकेज के अपने कोई एप्लिकेशन, क्षमताएँ या निर्भरताएँ नहीं होतीं ({1})"

msgid "a hash the token signing does not know"
msgstr "ऐसा हैश जिसे टोकन हस्ताक्षर नहीं जानता"

msgid "a hive cell crosses its bin"
msgstr "hive cell अपने bin को पार करता है"

msgid "a hive version or type rubrapack does not read"
msgstr "hive संस्करण या प्रकार जिसे rubrapack नहीं पढ़ता"

msgid "a known folder itself ('%s') cannot get permissions"
msgstr "किसी ज्ञात फ़ोल्डर ('{1}') को स्वयं अनुमतियाँ नहीं दी जा सकतीं"

msgid "a license needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "लाइसेंस को ui = \"minimal\", \"installdir\" या \"features\" चाहिए"

msgid "a local header with extra fields (not a package rubrapack or Windows' packaging API wrote)"
msgstr "अतिरिक्त फ़ील्ड वाला local header (ऐसा पैकेज नहीं जिसे rubrapack या Windows के पैकेजिंग API ने लिखा)"

msgid "a malformed central directory"
msgstr "विकृत central directory"

msgid "a modification package has no applications of its own"
msgstr "संशोधन पैकेज के अपने ऐप्लिकेशन नहीं होते"

msgid "a modification package needs Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "संशोधन पैकेज को Windows बिल्ड 18362 या बाद वाला चाहिए: [msix] min-version = \"10.0.18362.0\" सेट करें"

msgid "a module's compress is \"none\", \"mszip\" or \"mszip:0\" ... \"mszip:9\""
msgstr "मॉड्यूल का compress \"none\", \"mszip\" या \"mszip:0\" ... \"mszip:9\" होता है"

msgid "a module's name is its ID in the ModuleID: letters, digits and _, at most 35 characters"
msgstr "मॉड्यूल का नाम ModuleID में उसका ID है: अक्षर, अंक और _, अधिकतम 35 वर्ण"

msgid "a multi value is a non-empty array of strings"
msgstr "multi मान स्ट्रिंग की गैर-खाली सरणी है"

msgid "a multi value is an array of strings"
msgstr "multi मान स्ट्रिंग की सरणी है"

msgid "a name ending with a space or a dot"
msgstr "ऐसा नाम जो स्पेस या बिंदु पर खत्म होता है"

msgid "a name longer than 255 bytes"
msgstr "255 बाइट से लंबा नाम"

msgid "a package named in the bundle manifest is not in the bundle"
msgstr "बंडल मैनिफ़ेस्ट में नामित एक पैकेज बंडल में नहीं है"

msgid "a package without Identity Name, Publisher, Version and ProcessorArchitecture (or ResourceId)"
msgstr "Identity Name, Publisher, Version और ProcessorArchitecture (या ResourceId) के बिना पैकेज"

msgid "a package's Offset or Size in the bundle manifest does not match where it lies (or it is compressed)"
msgstr "बंडल मैनिफ़ेस्ट में किसी पैकेज का Offset या Size उसकी स्थिति से मेल नहीं खाता (या वह संपीड़ित है)"

msgid "a package's identity differs from what the bundle manifest says of it"
msgstr "किसी पैकेज की पहचान बंडल मैनिफ़ेस्ट के कथन से भिन्न है"

msgid "a package's name in the bundle must be a file name ending in .msix or .appx"
msgstr "बंडल में पैकेज का नाम .msix या .appx पर खत्म होने वाला फ़ाइल नाम होना चाहिए"

msgid "a password is never taken on the command line (others can see it); use --pass-env or --pass-file"
msgstr "पासवर्ड कभी कमांड लाइन से नहीं लिया जाता (दूसरे उसे देख सकते हैं); --pass-env या --pass-file का उपयोग करें"

msgid "a per-machine package does not write HKCU (it would be the installing user's); use scope = \"user\""
msgstr "प्रति-मशीन पैकेज HKCU में नहीं लिखता (वह इंस्टॉल करने वाले उपयोगकर्ता का होगा); scope = \"user\" का उपयोग करें"

msgid "a proxy with a user name or password is not supported"
msgstr "उपयोगकर्ता नाम या पासवर्ड वाला प्रॉक्सी समर्थित नहीं है"

msgid "a qword value is an integer or \"0x\" and 1 to 16 hex digits"
msgstr "qword मान पूर्णांक है या \"0x\" और 1 से 16 हेक्स अंक"

msgid "a radio control stacks its buttons: height must be at least 12 per value (%d)"
msgstr "radio नियंत्रण अपने बटन एक के ऊपर एक रखता है: ऊँचाई प्रति मान कम से कम 12 होनी चाहिए ({1})"

msgid "a record has more columns than its table"
msgstr "किसी रिकॉर्ड में उसकी तालिका से अधिक स्तंभ हैं"

msgid "a record is cut short"
msgstr "एक रिकॉर्ड अधूरा कटा है"

msgid "a record names a string the pool does not have"
msgstr "एक रिकॉर्ड ऐसी स्ट्रिंग नामित करता है जो पूल में नहीं है"

msgid "a reserved device name"
msgstr "आरक्षित डिवाइस नाम"

msgid "a rollback action cannot be asynchronous"
msgstr "rollback क्रिया अतुल्यकालिक नहीं हो सकती"

msgid "a scheme is a lower-case letter, then lower-case letters, digits, '+', '-' or '.' (got '%s')"
msgstr "स्कीम एक छोटा अक्षर है, फिर छोटे अक्षर, अंक, '+', '-' या '.' (मिला '{1}')"

msgid "a script action between InstallInitialize and RemoveExistingProducts (error 2613)"
msgstr "InstallInitialize और RemoveExistingProducts के बीच स्क्रिप्ट क्रिया (त्रुटि 2613)"

msgid "a section lies outside the file"
msgstr "एक सेक्शन फ़ाइल के बाहर है"

msgid "a service name may not contain '/' or '\\' (at most 256 characters)"
msgstr "सेवा नाम में '/' या '\\' नहीं हो सकता (अधिकतम 256 वर्ण)"

msgid "a setup .exe is built from a source with [chain]; '%s' builds a package (.msi, .msix)"
msgstr "सेटअप .exe [chain] वाले स्रोत से बनता है; '{1}' एक पैकेज (.msi, .msix) बनाता है"

msgid "a shared Win32 assembly's catalog needs an RSA key of 2048 bits or more"
msgstr "साझा Win32 असेंबली के कैटलॉग के लिए 2048 बिट या अधिक की RSA कुंजी चाहिए"

msgid "a source holds one [package] or one [module], not both"
msgstr "स्रोत में एक [package] या एक [module] होता है, दोनों नहीं"

msgid "a source that passes the RP1xxx checks should never meet these: please report it with the source"
msgstr "RP1xxx जाँचें पास करने वाले स्रोत को ये कभी नहीं मिलने चाहिए: कृपया स्रोत के साथ इसकी रिपोर्ट करें"

msgid "a stored ZIP entry whose sizes differ"
msgstr "stored ZIP प्रविष्टि जिसके आकार भिन्न हैं"

msgid "a stream of the package cannot be read"
msgstr "पैकेज की एक स्ट्रीम पढ़ी नहीं जा सकती"

msgid "a table has more than 32 columns"
msgstr "एक तालिका में 32 से अधिक स्तंभ हैं"

msgid "a value `with` a file shares its component: put `when` on the file"
msgstr "किसी फ़ाइल के `with` वाला मान उसका घटक साझा करता है: `when` फ़ाइल पर लगाएँ"

msgid "a value is 1 to 64 bytes"
msgstr "मान 1 से 64 बाइट का होता है"

msgid "a value that goes 'with' a file takes that file's feature"
msgstr "किसी फ़ाइल के 'with' जाने वाला मान उस फ़ाइल का फ़ीचर लेता है"

msgid "a version is 3 or 4 numbers with dots, such as 1.0.0"
msgstr "संस्करण बिंदुओं वाली 3 या 4 संख्याएँ हैं, जैसे 1.0.0"

msgid "account must be LocalSystem, LocalService or NetworkService"
msgstr "account LocalSystem, LocalService या NetworkService होना चाहिए"

msgid "action '%s' is already defined"
msgstr "क्रिया '{1}' पहले से परिभाषित है"

msgid "action is neither a standard action nor in CustomAction"
msgstr "क्रिया न मानक क्रिया है न CustomAction में है"

msgid "action must be \"warn\" or \"refuse\" (got '%s')"
msgstr "action, \"warn\" या \"refuse\" होना चाहिए ('{1}' मिला)"

msgid "adds too many tables"
msgstr "बहुत अधिक तालिकाएँ जोड़ता है"

msgid "advertise is \"allow\" or \"disallow\" (got '%s')"
msgstr "advertise \"allow\" या \"disallow\" होना चाहिए ('{1}' मिला)"

msgid "after = '%s' is not a page of this dialog set (RpWelcomeDlg%s%s%s) or a [dialog.*]"
msgstr "after = '{1}' न इस संवाद सेट का पृष्ठ है (RpWelcomeDlg{2}{3}{4}) न कोई [dialog.*]"

msgid "alias belongs to kind = \"alias\""
msgstr "alias kind = \"alias\" से संबंधित है"

msgid "alias must be a file name ending in .exe: letters, digits, '.', '_', '-' (got '%s')"
msgstr "alias .exe पर खत्म होने वाला फ़ाइल नाम होना चाहिए: अक्षर, अंक, '.', '_', '-' (मिला '{1}')"

msgid "an INI section may not contain ']' and a key may not contain '='"
msgstr "INI सेक्शन में ']' और कुंजी में '=' नहीं हो सकता"

msgid "an MSIX cannot place files in the temporary folder"
msgstr "MSIX अस्थायी फ़ोल्डर में फ़ाइलें नहीं रख सकता"

msgid "an application has one alias ([msix-extension.%s] is one already)"
msgstr "किसी ऐप्लिकेशन का एक alias होता है ([msix-extension.{1}] पहले से एक है)"

msgid "an application has one share target ([msix-extension.%s] is one already)"
msgstr "एक ऐप्लिकेशन का एक ही शेयर लक्ष्य होता है ([msix-extension.{1}] पहले से एक है)"

msgid "an empty name"
msgstr "खाली नाम"

msgid "an https server needs --tls-trust <certificates> or --system-roots to check it against"
msgstr "https सर्वर को जाँचने के लिए --tls-trust <certificates> या --system-roots चाहिए"

msgid "an https:// proxy is not supported; give an http:// proxy (https servers are reached through CONNECT)"
msgstr "https:// प्रॉक्सी समर्थित नहीं; http:// प्रॉक्सी दें (https सर्वर CONNECT से पहुँचते हैं)"

msgid "an old-style Authenticode timestamp (PKCS#9 counterSignature), which rubrapack does not check"
msgstr "पुरानी शैली का Authenticode टाइमस्टैम्प (PKCS#9 counterSignature), जिसे rubrapack नहीं जाँचता"

msgid "an optional or modification package declares no capabilities and no virtualization settings: its main package's apply"
msgstr "वैकल्पिक या संशोधन पैकेज कोई क्षमता या वर्चुअलाइज़ेशन सेटिंग घोषित नहीं करता: उसके मुख्य पैकेज की लागू होती हैं"

msgid "an x86 package writes the 32-bit registry view only"
msgstr "x86 पैकेज केवल 32-बिट रजिस्ट्री दृश्य में लिखता है"

msgid "app '%s' is not an [msix-app.*]"
msgstr "ऐप '{1}' कोई [msix-app.*] नहीं है"

msgid "appinstaller-uri and package-uri go together: where the .appinstaller file and the package will be"
msgstr "appinstaller-uri और package-uri साथ आते हैं: .appinstaller फ़ाइल और पैकेज कहाँ होंगे"

msgid "arch must be \"x64\", \"arm64\" or \"x86\" (got '%s')"
msgstr "arch \"x64\", \"arm64\" या \"x86\" होना चाहिए (मिला '{1}')"

msgid "arch must be \"x64\", \"x86\" or \"arm64\" (the setup program's own)"
msgstr "arch \"x64\", \"x86\" या \"arm64\" होना चाहिए (सेटअप प्रोग्राम का अपना)"

msgid "argument %d is not valid UTF-8 (byte %zu)"
msgstr "तर्क {1} मान्य UTF-8 नहीं है (बाइट {2})"

msgid "argument %d is not valid Unicode (UTF-16 unit %zu)"
msgstr "तर्क {1} मान्य Unicode नहीं है (UTF-16 इकाई {2})"

msgid "array is not closed"
msgstr "सरणी बंद नहीं है"

msgid "arrays inside arrays are not supported"
msgstr "सरणियों के भीतर सरणियाँ समर्थित नहीं हैं"

msgid "arrays must hold only strings or only integers"
msgstr "सरणियों में केवल स्ट्रिंग या केवल पूर्णांक होने चाहिए"

msgid "as must be \"system\" or \"user\" (got '%s')"
msgstr "as \"system\" या \"user\" होना चाहिए ('{1}' मिला)"

msgid "assembly must be \"dotnet\" or \"win32\""
msgstr "assembly \"dotnet\" या \"win32\" होना चाहिए"

msgid "at most %d languages besides English"
msgstr "अंग्रेज़ी के अलावा अधिकतम {1} भाषाएँ"

msgid "at most 100 [msix-app.*] tables"
msgstr "अधिकतम 100 [msix-app.*] तालिकाएँ"

msgid "at most 50 [action.*] tables (this file has %zu)"
