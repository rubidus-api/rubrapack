msgstr "[dialog-control.{1}] precisa 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] precisa 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] precisa 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] ten {2} controis; como máximo 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] non ten ningún [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] queda situado despois de si mesmo a través doutros diálogos"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] precisa ui = \"minimal\", \"installdir\" ou \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' é un nome de Windows; déalle outro ID ao dir"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard precisa a DLL auxiliar de rubrapack, que un módulo de combinación non leva"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] precisa unha funcionalidade"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: un MSIX define todas as súas variables (when); use msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: o seu valor nomea un lugar que un MSIX non pode dar (un cartafol fóra do paquete que non é de Windows, ou unha parte de tempo de instalación); use msi-only = true"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] está no perfil do usuario e ten component-guid: o camiño de chave segue sendo o ficheiro, onde as regras de Windows queren un valor HKCU (ICE38); quite component-guid para obtelo"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: o Explorador carga un manexador {2} desde unha DLL; [com.{3}] é un programa"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows só le os manexadores de propiedades por máquina; o paquete precisa scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: un manexador de vista previa execútase no prevhost de Windows; deixe app-id e surrogate fóra de [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: un MSIX só leva manexadores de miniaturas e de vista previa (un manexador de propiedades empaquetado non lle deu valores ao Explorador); msi-only = true mantéñeo para o MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: un tipo de ficheiro MSIX pertence a unha aplicación; engada un [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: a clase {2} non é un [com.*] deste paquete (a DLL do manexador sérvea)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: nun MSIX os manexadores comparten todos os seus tipos ou ningún (un tipo está nunha soa asociación de tipo de ficheiro)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: nun MSIX a súa clase execútase nun substituto; threading = \"sta\" en [com.{2}] dálle á xanela un bucle de mensaxes (con threading = {3} a vista previa pode quedar en branco)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: nun MSIX todos os seus tipos están nun só tipo de ficheiro [assoc], ou ningún"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: a súa clase é só MSI ([com.{2}]); o MSIX non tería servidor para ela"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types é unha lista de tipos de ficheiro, como [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] vai a {2}; ou msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] precisa 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] precisa unha funcionalidade: defina 'feature' aquí ou no seu dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: un MSIX escribe todas as súas entradas INI (when); use msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: o seu valor ten unha parte que Windows Installer enche ao instalar ([...]); un MSIX escribe o ficheiro cando se constrúe"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] precisa 'on': onde se amosa o elemento, como [\".txt\"] ou \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] precisa 'target' (o programa que inicia), ou elementos con parent = \"{2}\" (un submenú)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] precisa 'target': o programa que inicia o elemento"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: o menú de Windows 11 só admite un ID de letras e díxitos (sen '_'): cámbielle o nome ou use windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: un submenú non inicia nada: omita 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: un elemento dun submenú amósase onde se amosa o submenú: omita 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args ten unha parte que Windows Installer enche ao instalar ([...]); un MSIX só contén texto fixo"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when é \"HKCU\\\\key\\\\value\" ou \"HKLM\\\\...\", nun elemento do menú de Windows 11 que non estea nun submenú"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when indica un valor que escribe o propio paquete ([registry.{2}]): o elemento non se amosaría nunca"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: o seu programa non está no MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: os seus valores non poden ir ao rexistro do paquete"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list ten unha parte que Windows Installer enche ao instalar ([...]); un MSIX só contén texto fixo"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list substitúe {2} cando os camiños non caben nunha liña de ordes: cómpre multi = \"one\", {3} en args e {4} (o ficheiro de lista) en list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": non hai ningún [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on é un tipo de ficheiro ou unha lista deles, como [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: o pai '{2}' non é un [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: o pai '{2}' debe ser un submenú: un [menu.*] sen target e sen pai propio"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] vai a {2}; ou msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] precisa unha funcionalidade: defina 'feature' aquí ou no seu dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; ou msi-only = true"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args debe ser texto simple (sen [...] enchido ao instalar)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file debe ser {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file debe nomear un ficheiro que vaia ao paquete"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file debe nomear un programa que vaia ao paquete"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types é unha lista de tipos de ficheiro, como [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows só admite letras e díxitos"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] indica unha copia: msix (con publisher) ou upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix é o nome de identidade do paquete (de 3 a 50 letras, díxitos, '.' ou '-') e precisa publisher (\"CN=...\"), tal como os ten o seu manifesto"

