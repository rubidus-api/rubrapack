msgstr "[action.{1}] precisa do e undo (undo tamén desfai un do fallido)"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: os args dun MSIX deben ser texto simple (sen [...] enchido ao instalar)"

