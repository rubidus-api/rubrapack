msgstr "[assoc.{1}]: nun MSIX un tipo de ficheiro abre unha aplicación: target debe ser un executable [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] está dúas veces"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] precisa un ID: escriba [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id e typelib só se escriben para o MSI; o MSIX rexistra a clase sen eles"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: os args son dun programa; unha DLL cárgase, non se inicia"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate executa unha DLL en dllhost; '{2}' é un programa"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading é para unha DLL; un programa define o seu propio apartamento"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version e typelib-file precisan typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] vai a {2}; ou msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: a súa fonte debe ser un ficheiro que vaia ao paquete"

msgid "[define] values must be strings"
msgstr "os valores de [define] deben ser cadeas"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] precisa '{2}'"

