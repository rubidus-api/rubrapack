msgstr "Windows Installer admite como máximo 255.255.65535(.65535)"

msgid "Windows name"
msgstr "nome de Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] precisa '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] non pode ir nun módulo de combinación; teno o paquete que o combina"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] aínda non se admite (previsto para {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] non pode ir nun MSIX; engada msi-only = true para construír o MSIX sen el"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] está no AppData ou LocalAppData do usuario: un paquete dual instalado para todos os usuarios só o pon no perfil do usuario que instala"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: un ID nun módulo de combinación ten como máximo 35 caracteres (engádeselle o GUID do módulo)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] precisa un ID: escriba [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] non admite ID: escriba [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml non ten </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml non é a última entrada (non é un paquete escrito por rubrapack nin pola API de empaquetado de Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "as matrices de táboas [[...]] non se admiten; dea a cada elemento o seu [kind.ID]"

msgid "[action.%s] check has no effect: nothing runs it yet; remove it"
msgstr "[action.{1}] check non ten efecto: aínda nada o executa; quíteo"

