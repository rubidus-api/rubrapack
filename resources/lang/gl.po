# rubrapack language pack: Galician.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: gl\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Galego\n"
"X-Rubrapack-LangIDs: 1110\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, diálogos {6}{7}\n  1 nome, fabricante, versión, arquitectura      2 cartafol de instalación, para quen\n  3 diálogos, licenza, idiomas                   4 partes opcionais\n  5 atallos                                      6 ficheiros: igualar o cartafol do programa\n  7 calquera chave                               v ver   l lint   s gardar   q saír\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMensaxes con este código (* representa un nome ou un valor):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nOs resultados van a stdout, os diagnósticos a stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nQue facer: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} xa non está, pero un atallo ábreo: cambie primeiro os atallos (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  hai {1} ficheiros e {2} cartafoles\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s ou q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  engadíronse [dir.{1}] e [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  engadiuse [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  indíqueo como táboa.chave, por exemplo package.version ou dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: ningún problema\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: vexa os problemas de enriba (o ficheiro que se nomea é unha copia de comprobación)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  consérvanse os outros idiomas de [ui] languages; cambie esa lista con 7 (calquera chave)\n"

msgid "  removed [file.%s]\n"
msgstr "  quitouse [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  quitouse [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subcartafoles:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  iso non encaixa no subconxunto de TOML; non se cambiou nada\n"

msgid "  that was not readable text; again, please\n"
msgstr "  iso non era texto lexible; outra vez, por favor\n"

msgid "  the program folder '%s': %s\n"
msgstr "  o cartafol do programa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  a fonte non ten táboas [file] ás que poida apuntar un atallo\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  a fonte non ten subcartafoles como os escribe `new` ([files] \"<folder>/<name>/**\"); engádaos con 6\n"

msgid "  too long; again, please\n"
msgstr "  demasiado longo; outra vez, por favor\n"

msgid "  y or n\n"
msgstr "  y ou n\n"

msgid " (changed)"
msgstr " (cambiado)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - crea paquetes de Windows Installer (.msi) e MSIX (.msix)\n\nuso: rubrapack [--lang <code>] <command> [arguments]\n\nordes:\n"

msgid " and its dir"
msgstr " e o seu cartafol"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) non ten variable de contorno, así que un valor expandible non o pode conter; use un valor de cadea (énchese ao instalar)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) é un {2}: pode comezar unha ruta, ou substituír un valor que enche Windows Installer (rexistro, contorno, INI, argumentos, mensaxes), pero non aquí"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) non é un cartafol desde o que poida comezar unha ruta (un ID de dir, ou ProgramFiles, LOCALAPPDATA, ProgramData ... - vexa Rutas no manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  estrutura:   {2}\n  resumo:      {3}\n  sinatura:    {4}\n  cadea:       {5}{6}{7}\n  revogación:  non comprobada\n  selo de tempo: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: a variable non está definida"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' non é un control deste diálogo"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' non está en {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': o texto da licenza precisa o nome inglés da fonte, así que se mostra coa fonte propia do idioma; escriba o nome inglés (como \"Malgun Gothic\") para usar esta fonte tamén alí"

msgid "%s component, but the package platform is %.*s"
msgstr "compoñente {1}, pero a plataforma do paquete é {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} non pertence a kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} non pertence a kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} contén LANGID (1..65535), como 1041"

msgid "%s holds strings"
msgstr "{1} contén cadeas"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} é un nome de fonte de 1 a 31 caracteres, como \"Segoe UI\" (obtívose {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} é unha condición MSI con comiñas pechadas e parénteses equilibradas"

msgid "%s is an array of strings, one per value"
msgstr "{1} é unha matriz de cadeas, unha por valor"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} é para paquetes MSI: msiexec non quita un MSIX"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} xa non está. Quitar [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} ten máis de 240 caracteres"

msgid "%s is new. Add it?"
msgstr "{1} é novo. Engadilo?"

msgid "%s is not a GUID in registry format"
msgstr "{1} non é un GUID en formato de rexistro"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} non é un código que use este rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} debe ser \"file:<ID>\" e nomear un [file.*] deste paquete"

msgid "%s must be a GUID"
msgstr "{1} debe ser un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} debe ser un GUID como {{12345678-...} (obtívose '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} debe ser un enderezo https://, http:// ou file://, ou unha ruta \\\\server\\share (obtívose '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} debe ser distinto de upgrade-code (unha familia de actualización por arquitectura)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} precisa a compilación de Windows {2} ou posterior: defina [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} precisa resources/bin/rubrapack_ca-{2}.dll, que este rubrapack non inclúe"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA non comprobada (indique --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA de confianza"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA non de confianza - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} xa non está ou está baleiro. Quitar [files.{3}] e [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ é un cartafol novo. Engadilo?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: erros: {2}{-3}, avisos: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: erros: {2}{-3}, avisos: {4}{-5} (respecto de {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} ficheiros, {3} bytes\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} ficheiros, {3} erros, 0 avisos\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} diagnósticos máis que non se amosan\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: o ficheiro '{2}' non é un [file.*] deste paquete"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: o ficheiro '{2}' non é un programa (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' non está pechado (escriba '$$(' para o texto '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' xa existe; déixase como está"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' xa existe; quíteo ou constrúa noutro cartafol"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' xa ten un manexador {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' xa ten permisos"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' e '{2}' son a mesma ruta no paquete"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' pertence a Windows ou aos navegadores"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' non se pode ler respecto de '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' non encaixa no subconxunto de TOML; non se gardou nada"

msgid "'%s' exists already"
msgstr "'{1}' xa existe"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' xa existe; cámbieo con `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existe e non é un directorio baleiro; extraia nun novo"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' vai a {2}; ou msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' ten un fluxo de información de resumo ilexible"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' non ten táboas Directory, Component, File e Media das que extraer"

msgid "'%s' has no readable summary information"
msgstr "'{1}' non ten información de resumo lexible"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' non ten ningunha transformación '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' é UTF-16: edit só cambia fontes UTF-8 (gárdeo primeiro como UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' é un nome de Windows; déalle outro nome á variable"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' é un [chain]: crea un programa de instalación, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' é un control do marco integrado; escolla outro ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' é un cartafol da máquina; un paquete {2} non pode escribir alí"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' é un módulo de combinación: combíneo con [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' é un nome que o formato MSIX se reserva"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' é unha ligazón simbólica; as ligazóns non se seguen"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' tamén é un [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' tamén é un ID de dir; déalle outro nome á variable"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' está compilado para a máquina 0x{2}, non para a arquitectura deste paquete; defina any-arch = true se é intencionado"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' non é nin un ficheiro PE (.exe, .dll), nin un paquete MSI, nin un paquete ou conxunto MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' non é nin un ficheiro PE, nin un paquete MSI, nin un paquete ou conxunto MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' non é nin un cartafol coñecido nin un ID de dir (cartafoles coñecidos: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' non é un cabinet que rubrapack poida ler (stored ou MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' non é un código de diagnóstico (RP e catro díxitos, como RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' non é un programa (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' non é un ficheiro normal"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' non é un programa de instalación de rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' non é un ID válido (letras, díxitos e '_', non comeza por díxito, como máximo {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' non é unha base de datos MSI válida: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' non é un paquete MSIX válido: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' non é un paquete válido: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' non é unha fonte válida (o subconxunto de TOML); corríxaa primeiro á man"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' non é unha transformación válida: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' non é un nome de variable válido"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' está reservado e non se pode usar como ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' é o nome dun dir: só unha busca de rexistro ou de dir pode encher un dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' parece un ficheiro de programa (PE), pero as cabeceiras ou os recursos están danados"

msgid "'%s' must be a string"
msgstr "'{1}' debe ser unha cadea"

msgid "'%s' must be an integer"
msgstr "'{1}' debe ser un enteiro"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' debe estar entre {2} e {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' debe ser true ou false"

msgid "'%s' must not be empty"
msgstr "'{1}' non pode estar baleiro"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' non nomea ningunha transformación (propiedade de resumo 8): non é un parche"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' comeza por un cartafol: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' ten {4}; non se extraeu nada"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entradas, máis que o límite {3} (--limit-entries); non se extraeu nada"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' e '{3}' serían a mesma ruta en Windows; non se extraeu nada"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' non está en [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': non se pode ler unha táboa"

msgid "'%s': a table is unreadable"
msgstr "'{1}': unha táboa é ilexible"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': un MSIX instala todos os seus ficheiros (when); use msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': un MSIX quita todos os seus ficheiros (keep); use msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': o cabinet '{2}' está danado ou non é stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': o nome de cabinet '{2}' non é un nome de ficheiro simple"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': o ficheiro comprimido '{2}' (secuencia {3}) non ten cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': o directorio '{2}' ten un pai '{3}' que non está"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': o directorio '{2}' é o seu propio antepasado ou está aniñado de máis"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': o ficheiro '{2}' non coincide co seu MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': o ficheiro '{2}' non ten compoñente nin directorio"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': o ficheiro '{2}' ten {3} bytes, a táboa File di {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': o ficheiro '{2}' non está no cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': a sinatura non cobre os seus cabinets externos (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': o seu cartafol non leva a ningunha localización coñecida"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': máis de {2} bytes para escribir (--limit-bytes); non se extraeu nada"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': sen --timestamp: a sinatura deixa de ser válida cando caduca o certificado"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': o paquete '{2}' non coincide co seu SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': o fluxo de cabinet '{2}' non está"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': o manifesto non ten {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': o manifesto nomea '{2}', que non está no paquete"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': selo de tempo de {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': a transformación '{2}' non se pode ler respecto de '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' é o idioma propio do paquete ({2}); dea ese texto sen o sufixo"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' fai que Windows Installer escriba unha cadea múltiple; use type = \"multi\" e unha matriz"

msgid "'_' in numbers is not supported"
msgstr "'_' nos números non se admite"

msgid "'help' takes at most one command name"
msgstr "'help' admite como máximo un nome de orde"

msgid "'version' takes no arguments"
msgstr "'version' non admite argumentos"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs é para .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch para un conxunto: unha lista de x64, x86 e arm64, cada un unha vez (obtívose '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch admite unha arquitectura, ou unha lista para unha saída .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp e --allow-unsigned-cabs van con --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress é para .msi; un MSIX admite --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist nomea un cartafol novo ao lado da fonte (sen ruta)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs admite un número do 1 ao 64 (obtívose '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store é un almacén de certificados de Windows; noutros sitios use un ficheiro de chave ou --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store admite a pegada SHA-1 do certificado (40 díxitos hexadecimais)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: non existe ese idioma (integrados: {2}; outro precisa o seu paquete de idioma, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (ou RUBRAPACK_LANG) escolle o idioma destes textos: {1}, ou un que teña paquete de idioma.\n"

