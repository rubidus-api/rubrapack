msgstr "--target admite msi ou msix (obtívose '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots e --proxy van con --timestamp"

