msgstr "As entradas de Inicio, Programas, Escritorio e Inicio automático veñen de [shortcut.*] e [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML fóra do subconxunto que le rubrapack, ou `format` ausente ou demasiado novo"

msgid "Tables"
msgstr "Táboas"

msgid "The TOML subset"
msgstr "O subconxunto de TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Os ficheiros UTF-16 big-endian non se admiten; gárdeos como UTF-8"

