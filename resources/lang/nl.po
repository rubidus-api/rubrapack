msgid "the package is signed already; rubrapack does not sign twice or replace a signature"
msgstr "het pakket is al ondertekend; rubrapack ondertekent niet twee keer en vervangt geen handtekening"

msgid "the package is signed already; rubrapack signs unsigned packages (and never twice)"
msgstr "het pakket is al ondertekend; rubrapack ondertekent niet-ondertekende pakketten (en nooit twee keer)"

msgid "the package uses cabinets outside itself, which a signature of the .msi does not cover; build it with embedded cabinets, or sign anyway with --allow-unsigned-cabs"
msgstr "het pakket gebruikt cabinets buiten zichzelf, die een handtekening van de .msi niet dekt; bouw het met ingesloten cabinets, of onderteken toch met --allow-unsigned-cabs"

msgid "the package's contents do not match its signature (it was changed after signing)"
msgstr "de inhoud van het pakket komt niet overeen met zijn handtekening (het is na ondertekening gewijzigd)"

msgid "the package's directory cannot be read"
msgstr "de map van het pakket kan niet worden gelezen"

msgid "the packages of a bundle need the same Name, Publisher and Version"
msgstr "de pakketten van een bundel hebben dezelfde Name, Publisher en Version nodig"

msgid "the proxy asks for a password (407), which rubrapack does not support"
msgstr "de proxy vraagt om een wachtwoord (407), wat rubrapack niet ondersteunt"

msgid "the proxy did not answer the tunnel request"
msgstr "de proxy antwoordde niet op het tunnelverzoek"

msgid "the proxy sent data after its answer to CONNECT"
msgstr "de proxy stuurde gegevens na zijn antwoord op CONNECT"

msgid "the redirect location is too long"
msgstr "de omleidingslocatie is te lang"

msgid "the request could not be sent"
msgstr "het verzoek kon niet worden verzonden"

msgid "the response has a malformed or conflicting Content-Length"
msgstr "het antwoord heeft een misvormde of tegenstrijdige Content-Length"

msgid "the response has both Content-Length and chunked (refused: a smuggling risk)"
msgstr "het antwoord heeft zowel Content-Length als chunked (geweigerd: een smokkelrisico)"

msgid "the response is larger than 4 MiB"
msgstr "het antwoord is groter dan 4 MiB"

msgid "the response uses a transfer coding other than chunked"
msgstr "het antwoord gebruikt een andere overdrachtscodering dan chunked"

msgid "the same condition is already required (line %u)"
msgstr "dezelfde voorwaarde wordt al vereist (regel {1})"

msgid "the same without questions:\n  rubrapack new "
msgstr "hetzelfde zonder vragen:\n  rubrapack new "

msgid "the server did not answer with HTTP/1.x"
msgstr "de server antwoordde niet met HTTP/1.x"

msgid "the server redirected from https to http (refused)"
msgstr "de server leidde om van https naar http (geweigerd)"

msgid "the server's CertificateVerify signature does not verify"
msgstr "de CertificateVerify-handtekening van de server klopt niet"

msgid "the server's certificate is not for TLS servers (its extended key usage)"
msgstr "het certificaat van de server is niet voor TLS-servers (zijn uitgebreid sleutelgebruik)"

msgid "the server's signature scheme does not fit its certificate's key"
msgstr "het handtekeningschema van de server past niet bij de sleutel van zijn certificaat"

msgid "the signature does not verify"
msgstr "de handtekening klopt niet"

msgid "the signature does not verify with the signer's certificate"
msgstr "de handtekening klopt niet met het certificaat van de ondertekenaar"

msgid "the signature entry is described the ZIP64 way; Windows reads its place from the ZIP32 fields"
msgstr "het handtekeningitem is op de ZIP64-manier beschreven; Windows leest zijn plaats uit de ZIP32-velden"

msgid "the signature is not DER"
msgstr "de handtekening is geen DER"

msgid "the signature streams cannot be read"
msgstr "de handtekeningstromen kunnen niet worden gelezen"

msgid "the signed attributes do not match the signed content"
msgstr "de ondertekende kenmerken komen niet overeen met de ondertekende inhoud"

msgid "the signer's certificate is not for code signing"
msgstr "het certificaat van de ondertekenaar is niet voor codeondertekening"

msgid "the source file's encoding"
msgstr "de codering van het bronbestand"

msgid "the system random source failed"
msgstr "de willekeurigheidsbron van het systeem faalde"

msgid "the tab order (Control_Next) is not one cycle through its %zu controls from Control_First (Windows Installer stops with error 2809 or 2810)"
msgstr "de tabvolgorde (Control_Next) is geen enkele cyclus door zijn {1} besturingselementen vanaf Control_First (Windows Installer stopt met fout 2809 of 2810)"

msgid "the timestamp server answered with an HTTP error"
msgstr "de tijdstempelserver antwoordde met een HTTP-fout"

msgid "the timestamp server's certificate is not for time stamping"
msgstr "het certificaat van de tijdstempelserver is niet voor tijdstempels"

msgid "the timestamp server's time lies outside the signing certificate's validity"
msgstr "de tijd van de tijdstempelserver ligt buiten de geldigheid van het ondertekeningscertificaat"

msgid "the token does not say what kind of key it is"
msgstr "de token zegt niet wat voor sleutel het is"

msgid "the token is not present"
msgstr "de token is niet aanwezig"

msgid "the token returned an ECDSA signature of the wrong length"
msgstr "de token gaf een ECDSA-handtekening van de verkeerde lengte terug"

msgid "the token's EC key has a certificate that is not an EC one"
msgstr "de EC-sleutel van de token heeft een certificaat dat geen EC-certificaat is"

msgid "the token's signature does not verify with the certificate (the key and the certificate do not belong together)"
msgstr "de handtekening van de token klopt niet met het certificaat (de sleutel en het certificaat horen niet bij elkaar)"

msgid "the trusted certificate is expired or not valid yet"
msgstr "het vertrouwde certificaat is verlopen of nog niet geldig"

msgid "the unsigned attributes are malformed or hold more than one timestamp"
msgstr "de niet-ondertekende kenmerken zijn misvormd of bevatten meer dan één tijdstempel"

msgid "the-toml-subset"
msgstr "the-toml-subset"

msgid "there is no such file here"
msgstr "zo'n bestand is hier niet"

msgid "there is no such folder here"
msgstr "zo'n map is hier niet"

msgid "this rubrapack was built without its menu part: [menu.*] items do not reach the Windows 11 menu"
msgstr "deze rubrapack is gebouwd zonder zijn menudeel: [menu.*]-items bereiken het menu van Windows 11 niet"

msgid "this rubrapack was built without the setup program (nob parts)"
msgstr "deze rubrapack is gebouwd zonder het setupprogramma (nob parts)"

msgid "threading must be \"sta\", \"mta\", \"both\" or \"neutral\" (got '%s')"
msgstr "threading moet \"sta\", \"mta\", \"both\" of \"neutral\" zijn (gekregen: '{1}')"

msgid "timestamp: "
msgstr "tijdstempel: "

msgid "too many languages for one bundle"
msgstr "te veel talen voor één bundel"

msgid "too many localized texts and logo scales for resources.pri"
msgstr "te veel gelokaliseerde teksten en logoschalen voor resources.pri"

msgid "too many packages in the bundle"
msgstr "te veel pakketten in de bundel"

msgid "trusted"
msgstr "vertrouwd"

msgid "two packages of one architecture in a bundle"
msgstr "twee pakketten van één architectuur in een bundel"

msgid "two packages of one name in a bundle"
msgstr "twee pakketten met één naam in een bundel"

msgid "two resource packages of one ResourceId in a bundle"
msgstr "twee resourcepakketten met één ResourceId in een bundel"

msgid "type must be string, expand, dword, qword, binary or multi (got '%s')"
msgstr "type moet string, expand, dword, qword, binary of multi zijn (gekregen: '{1}')"

msgid "type must be text, checkbox, edit, radio or combo (got '%s')"
msgstr "type moet text, checkbox, edit, radio of combo zijn (gekregen: '{1}')"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' is geen [file.*] van dit pakket"

msgid "typelib-version is major.minor in hex digits, like \"1.0\" (got '%s')"
msgstr "typelib-version is major.minor in hexadecimale cijfers, zoals \"1.0\" (gekregen: '{1}')"

msgid "types and verb belong to kind = \"context-menu\""
msgstr "types en verb horen bij kind = \"context-menu\""

msgid "types: each is \".ext\" or \"*\" (every file)"
msgstr "types: elk is \".ext\" of \"*\" (elk bestand)"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: elk is '.' en kleine letters, cijfers, '_' of '-' (gekregen: '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" laat de gebruiker de map van dir '{2}' kiezen, die niet bestaat (stel [ui] install-dir in)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\" heeft [feature.*]-tabellen nodig om uit te kiezen"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui moet none, basic, minimal, installdir of features zijn (gekregen: '{1}')"

msgid "unexpected text after the value"
msgstr "onverwachte tekst na de waarde"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "onbekende opdracht '{1}' (zie 'rubrapack help')"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "onbekende escape \\{1} (gebruik '...' voor tekst met backslashes)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "onbekende inspect-optie (gebruik een tabelnaam, --summary, --files of --streams)"

msgid "unknown key '%s' in [%s%s%s]%s%s%s"
msgstr "onbekende sleutel '{1}' in [{2}{3}{4}]{5}{6}{7}"

msgid "unknown or incomplete %s option '%s'"
msgstr "onbekende of onvolledige {1}-optie '{2}'"

msgid "unknown table [%s%s%s]%s%s%s"
msgstr "onbekende tabel [{1}{2}{3}]{4}{5}{6}"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "een pakket uitpakken in een nieuwe map, ingedeeld zoals het installeert"

msgid "unsupported - %s"
msgstr "niet ondersteund - {1}"

msgid "untrusted"
msgstr "niet vertrouwd"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "update-*-sleutels hebben appinstaller-uri en package-uri nodig"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false is voor on = \"uninstall\" of \"both\" (een installatie is nooit de verwijdering van een upgrade)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code moet een GUID zijn zoals {12345678-1234-1234-1234-123456789ABC}"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "gebruik: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (a list for a bundle)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"
msgstr "gebruik: rubrapack build <src.toml> -o <out.msi|out.msm|out.msix|out.msixbundle> [-D NAME=VALUE] [--arch x64|arm64|x86 (een lijst voor een bundel)] [--compress none] [--jobs N] [--nfc] [--reproducible] [--key <key> [--cert <chain.pem>] [--pass-env VAR | --pass-file FILE] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs]] [--unsigned-test] [--msix-compress deflate|store]"

msgid "usage: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"
msgstr "gebruik: rubrapack edit <file>.toml | rubrapack edit <file>.toml [--set table.key=value]... [--unset table.key]... [--sync]"

msgid "usage: rubrapack explain [RPnnnn]"
msgstr "gebruik: rubrapack explain [RPnnnn]"

msgid "usage: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"
msgstr "gebruik: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"

msgid "usage: rubrapack guid [--from <text>]"
msgstr "gebruik: rubrapack guid [--from <text>]"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "gebruik: rubrapack inspect <file.cab> (geen tabel of optie)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "gebruik: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "gebruik: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "gebruik: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "gebruik: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "gebruik: rubrapack inspect <setup.exe> (geen tabel of optie)"

msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "gebruik: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "gebruik: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "gebruik: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "usage: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"
msgstr "gebruik: rubrapack lint <src.toml> [-D NAME=VALUE] [--arch x64|arm64|x86] [--target msi|msix] [--nfc] [--strict]"

msgid "usage: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (a fixed starter <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk names are taken too"
msgstr "gebruik: rubrapack new [<file>.toml] | rubrapack new <file>.toml --dist <folder> [--name <text>] [--manufacturer <text>] [--version <a.b.c>] [--arch x64|x86|arm64] [--main <file>|-] [--install-dir <folder>] [--scope machine|user|dual] [--ui none|basic|minimal|installdir|features] [--license <file>|-] [--languages ko|-] [--optional <folder,...>|-] [--shortcuts start,desktop|none] | rubrapack new <name> (een vast startbestand <name>.toml) | rubrapack new <file>.toml --from <package.msi> [--dist <new folder>] [--publisher \"CN=...\"]; .rpk-namen worden ook aangenomen"

msgid "usage: rubrapack schema (the JSON Schema of sources, on stdout)"
msgstr "gebruik: rubrapack schema (het JSON Schema van bronnen, op stdout)"

msgid "usage: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"
msgstr "gebruik: rubrapack sign <file.exe|.dll|.msi|.msp|.msix|.msixbundle> (--key <key.pfx|.pem> [--pass-env VAR | --pass-file FILE] | --pkcs11 <module> --key-label <label> [--token-label <label>] [--pin-env VAR | --pin-file FILE] | --key-store <thumbprint> [--machine-store]) [--cert <chain.pem>] [--timestamp <URL> [--tsa-trust <certificates>] [--tls-trust <certificates>] [--system-roots] [--proxy <URL>]] [--allow-unsigned-cabs] [-o <out>]"

msgid "usage: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."
msgstr "gebruik: rubrapack verify <file.exe|.dll|.msi|.msp|.msix|.msixbundle> [--trust <certificates>]... [--system-roots] [--tsa-trust <certificates>]..."

