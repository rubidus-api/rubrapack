# rubrapack language pack: Dutch.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: nl\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Nederlands\n"
"X-Rubrapack-LangIDs: 1043, 2067\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialoogvensters {6}{7}\n  1 naam, fabrikant, versie, architectuur       2 installatiemap, voor wie het installeert\n  3 dialoogvensters, licentie, talen            4 optionele onderdelen\n  5 snelkoppelingen                             6 bestanden: afstemmen op de programmamap\n  7 willekeurige sleutel                        v bekijken   l lint   s opslaan   q afsluiten\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMeldingen met deze code (* staat voor een naam of een waarde):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nResultaten gaan naar stdout, diagnoses naar stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nWat te doen: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} is weg, maar een snelkoppeling opent het: wijzig eerst de snelkoppelingen (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  daar staan {1} bestanden en {2} mappen\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s of q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] en [files.{2}] toegevoegd\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] toegevoegd\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  geef het op als tabel.sleutel, zoals package.version of dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: geen problemen\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: zie de problemen hierboven (het daar genoemde bestand is een controlekopie)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  andere talen in [ui] languages blijven behouden; wijzig die lijst met 7 (willekeurige sleutel)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] verwijderd\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} verwijderd\n"

msgid "  sub folders:"
msgstr "  submappen:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  dat past niet in de TOML-subset; er is niets gewijzigd\n"

msgid "  that was not readable text; again, please\n"
msgstr "  dat was geen leesbare tekst; nogmaals, alstublieft\n"

msgid "  the program folder '%s': %s\n"
msgstr "  de programmamap '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  de bron heeft geen [file]-tabellen waar een snelkoppeling naar kan wijzen\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  de bron heeft geen submappen zoals `new` ze schrijft ([files] \"<folder>/<name>/**\"); voeg ze toe met 6\n"

msgid "  too long; again, please\n"
msgstr "  te lang; nogmaals, alstublieft\n"

msgid "  y or n\n"
msgstr "  y of n\n"

msgid " (changed)"
msgstr " (gewijzigd)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - bouwt Windows Installer- (.msi) en MSIX-pakketten (.msix)\n\ngebruik: rubrapack [--lang <code>] <command> [arguments]\n\nopdrachten:\n"

msgid " and its dir"
msgstr " en zijn dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) heeft geen omgevingsvariabele, dus een uitbreidbare waarde kan het niet bevatten; gebruik een tekenreekswaarde (ingevuld bij de installatie)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) is een {2}: het kan een pad beginnen of staan voor een waarde die Windows Installer invult (register, omgeving, INI, argumenten, meldingen), maar niet hier"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) is geen map waarmee een pad kan beginnen (een dir-ID, of ProgramFiles, LOCALAPPDATA, ProgramData ... - zie Paths in de handleiding){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  structuur:    {2}\n  digest:       {3}\n  handtekening: {4}\n  keten:        {5}{6}{7}\n  intrekking:   niet gecontroleerd\n  tijdstempel:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: de variabele is niet ingesteld"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' is geen besturingselement van dit dialoogvenster"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' staat niet in {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': de licentietekst heeft de Engelse naam van het lettertype nodig en verschijnt dus in het eigen lettertype van de taal; schrijf de Engelse naam (zoals \"Malgun Gothic\") om ook daar dit lettertype te gebruiken"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-onderdeel, maar het platform van het pakket is {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} hoort niet bij kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} hoort niet bij kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} bevat LANGID's (1..65535), zoals 1041"

msgid "%s holds strings"
msgstr "{1} bevat tekenreeksen"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} is een lettertypenaam van 1 tot 31 tekens, zoals \"Segoe UI\" (gekregen: {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} is een MSI-voorwaarde met gesloten aanhalingstekens en gebalanceerde haakjes"

msgid "%s is an array of strings, one per value"
msgstr "{1} is een array van tekenreeksen, één per waarde"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} is voor MSI-pakketten: een MSIX wordt niet door msiexec verwijderd"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} is weg. [file.{2}] verwijderen?"

msgid "%s is longer than 240 characters"
msgstr "{1} is langer dan 240 tekens"

msgid "%s is new. Add it?"
msgstr "{1} is nieuw. Toevoegen?"

msgid "%s is not a GUID in registry format"
msgstr "{1} is geen GUID in registerindeling"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} is geen code die deze rubrapack gebruikt{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} moet \"file:<ID>\" zijn en een [file.*] van dit pakket noemen"

msgid "%s must be a GUID"
msgstr "{1} moet een GUID zijn"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} moet een GUID zijn zoals {12345678-...} (gekregen: '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} moet een https://-, http://- of file://-adres zijn, of een \\\\server\\share-pad (gekregen: '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} moet verschillen van upgrade-code (één upgradefamilie per architectuur)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} heeft Windows-build {2} of later nodig: stel [msix] min-version = \"10.0.{3}.0\" in"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} heeft resources/bin/rubrapack_ca-{2}.dll nodig, waarzonder deze rubrapack is gebouwd"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA niet gecontroleerd (geef --tsa-trust op)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA vertrouwd"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA niet vertrouwd - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} is weg of leeg. [files.{3}] en [dir.{4}] verwijderen?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ is een nieuwe map. Toevoegen?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} fout(en){-3}, {4} waarschuwing(en){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} fout(en){-3}, {4} waarschuwing(en){-5} (ten opzichte van {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} bestanden, {3} bytes\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} bestanden, {3} fouten, 0 waarschuwingen\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: nog {2} diagnoses niet getoond\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: bestand '{2}' is geen [file.*] van dit pakket"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: bestand '{2}' is geen programma (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' is niet gesloten (schrijf '$$(' voor de tekst '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' bestaat al; het blijft zoals het is"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' bestaat al; verwijder het of bouw in een andere map"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' heeft al een {2}-handler ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' heeft al machtigingen"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' en '{2}' zijn hetzelfde pad in het pakket"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' hoort bij Windows of de browsers"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' kan niet worden gelezen ten opzichte van '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' past niet in de TOML-subset; er is niets opgeslagen"

msgid "'%s' exists already"
msgstr "'{1}' bestaat al"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' bestaat al; wijzig het met `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' bestaat en is geen lege map; pak uit naar een nieuwe"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' gaat naar {2}; of msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' heeft een onleesbare stroom met samenvattingsinformatie"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' heeft geen Directory-, Component-, File- en Media-tabellen om uit te pakken"

msgid "'%s' has no readable summary information"
msgstr "'{1}' heeft geen leesbare samenvattingsinformatie"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' heeft geen transformatie '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' is UTF-16: edit wijzigt alleen UTF-8-bronnen (sla het eerst op als UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' is een Windows-naam; geef de variabele een andere naam"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' is een [chain]: het bouwt een setupprogramma, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' is een besturingselement van het ingebouwde frame; kies een andere ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' is een computermap; een {2}-pakket kan daar niet schrijven"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' is een samenvoegmodule: voeg het samen met [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' is een naam die het MSIX-formaat voor zichzelf houdt"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' is een symbolische koppeling; koppelingen worden niet gevolgd"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' is ook een [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' is ook een dir-ID; geef de variabele een andere naam"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' is gebouwd voor machine 0x{2}, niet voor de arch van dit pakket; stel any-arch = true in als dat de bedoeling is"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' is geen PE-bestand (.exe, .dll), geen MSI-pakket en geen MSIX-pakket of -bundel"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' is geen PE-bestand, geen MSI-pakket en geen MSIX-pakket of -bundel"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' is geen bekende map en geen dir-ID (bekende mappen: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' is geen cabinet dat rubrapack kan lezen (stored of MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' is geen diagnosecode (RP en vier cijfers, zoals RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' is geen programma (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' is geen gewoon bestand"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' is geen setupprogramma van rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' is geen geldige ID (letters, cijfers en '_', niet beginnend met een cijfer, hoogstens {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' is geen geldige MSI-database: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' is geen geldig MSIX-pakket: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' is geen geldig pakket: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' is geen geldige bron (de TOML-subset); herstel het eerst met de hand"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' is geen geldige transformatie: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' is geen geldige variabelenaam"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' is gereserveerd en kan niet als ID worden gebruikt"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' is de naam van een dir: alleen een register- of dir-zoekopdracht kan een dir vullen"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' lijkt een programmabestand (PE), maar de headers of resources zijn beschadigd"

msgid "'%s' must be a string"
msgstr "'{1}' moet een tekenreeks zijn"

msgid "'%s' must be an integer"
msgstr "'{1}' moet een geheel getal zijn"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' moet tussen {2} en {3} liggen"

msgid "'%s' must be true or false"
msgstr "'{1}' moet true of false zijn"

msgid "'%s' must not be empty"
msgstr "'{1}' mag niet leeg zijn"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' noemt geen transformaties (samenvattingseigenschap 8): geen patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' begint met een map: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' heeft {4}; er is niets uitgepakt"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} items, meer dan de limiet {3} (--limit-entries); er is niets uitgepakt"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' en '{3}' zouden onder Windows hetzelfde pad zijn; er is niets uitgepakt"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' staat niet in [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': een tabel kan niet worden gelezen"

msgid "'%s': a table is unreadable"
msgstr "'{1}': een tabel is onleesbaar"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': een MSIX installeert al zijn bestanden (when); gebruik msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': een MSIX verwijdert al zijn bestanden (keep); gebruik msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' is beschadigd of niet stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinetnaam '{2}' is geen gewone bestandsnaam"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': gecomprimeerd bestand '{2}' (volgorde {3}) heeft geen cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': map '{2}' heeft een bovenliggende map '{3}' die er niet is"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': map '{2}' is zijn eigen voorouder of te diep genest"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': bestand '{2}' komt niet overeen met zijn MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': bestand '{2}' heeft geen onderdeel of map"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': bestand '{2}' is {3} bytes, de File-tabel zegt {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': bestand '{2}' staat niet in cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': de externe cabinets vallen niet onder de handtekening (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': de map leidt niet naar een bekende locatie"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': meer dan {2} bytes te schrijven (--limit-bytes); er is niets uitgepakt"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': geen --timestamp: de handtekening is niet meer geldig als het certificaat verloopt"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': pakket '{2}' komt niet overeen met zijn SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': de cabinetstroom '{2}' is er niet"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': het manifest heeft geen {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': het manifest noemt '{2}', dat niet in het pakket staat"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': tijdstempel van {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformatie '{2}' kan niet worden gelezen ten opzichte van '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' is de eigen taal van het pakket ({2}); geef die tekst zonder het achtervoegsel"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' laat Windows Installer een multi-string schrijven; gebruik type = \"multi\" en een array"

msgid "'_' in numbers is not supported"
msgstr "'_' in getallen wordt niet ondersteund"

msgid "'help' takes at most one command name"
msgstr "'help' neemt hoogstens één opdrachtnaam"

msgid "'version' takes no arguments"
msgstr "'version' neemt geen argumenten"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs is voor .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch voor een bundel: een lijst van x64, x86 en arm64, elk één keer (gekregen: '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch neemt één architectuur, of een lijst voor een .msixbundle-uitvoer"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp en --allow-unsigned-cabs horen bij --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress is voor .msi; een MSIX neemt --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist noemt een nieuwe map naast de bron (geen pad)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs neemt een getal van 1 tot 64 (gekregen: '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store is een Windows-certificaatarchief; gebruik elders een sleutelbestand of --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store neemt de SHA-1-vingerafdruk van het certificaat (40 hexadecimale cijfers)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
