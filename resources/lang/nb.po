msgstr "'{1}' har allerede tillatelser"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' og '{2}' er samme bane i pakken"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' tilhører Windows eller nettleserne"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' kan ikke leses mot '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' passer ikke i TOML-delmengden; ingenting ble lagret"

msgid "'%s' exists already"
msgstr "'{1}' finnes allerede"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' finnes allerede; endre den med `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' finnes og er ikke en tom katalog; pakk ut til en ny"

