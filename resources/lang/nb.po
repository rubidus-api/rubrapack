msgstr "verdier: ID-er, GUID-er, versjoner, tall utenfor område, referanser til ting som ikke finnes"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "variabelen '{1}' er ikke definert ([define] eller -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "variabelnavnet '{1}' kan ikke inneholde '=' eller begynne med = + - ! *"

msgid "variables"
msgstr "variabler"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "variabler: $(NAVN) uten verdi, $( ikke lukket, et Windows-navn eller en dir-ID der det ikke kan stå"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "versjonen '{1}' må være a.b.c eller a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "versjonen '{1}' må være a.b.c eller a.b.c.d med a, b <= 255 og c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" kan ikke gå 'with' en fil i en 64-biters pakke"

msgid "view must be \"32\" or \"64\""
msgstr "view må være \"32\" eller \"64\""

msgid "warning"
msgstr "advarsel"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "hva en diagnosekode betyr, meldingene som bærer den, hva du skal gjøre og hvor håndboken sier mer"

msgid "with must be \"file:<ID>\""
msgstr "with må være \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: filen '{1}' er ikke en [file.*] i denne pakken"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "uten --pkcs11 viser `keys list` Windows-sertifikatlageret"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' er ikke en dir-ID"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "skriv en oppdatering (.msp): filene og radene som oppdaterer en installert base til målet"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "skriv en kildefil (.toml; også .rpk-navn): laget av svar, spurt eller gitt som alternativer, en fast startfil, eller en eksisterende MSI"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "skriv en transformering (.mst): det som gjør den ene pakken til den andre"

msgid "write the table or value the plain way the manual shows"
msgstr "skriv tabellen eller verdien på den enkle måten håndboken viser"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "skriv verdien uten '[~]'; mode = \"append\" eller \"prepend\" legger den til"

