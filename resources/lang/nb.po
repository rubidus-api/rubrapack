msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] trenger 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] trenger en funksjon: angi 'feature' her eller på dir-en"

