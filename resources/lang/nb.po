msgstr "bruk et fullstendig rubrapack-bygg eller en annen måte"

msgid "used by more than one component"
msgstr "brukes av mer enn én komponent"

msgid "users must be \"all\" (got '%s')"
msgstr "users må være \"all\" (fikk '{1}')"

msgid "value '%s' is listed twice"
msgstr "verdien '{1}' står to ganger i listen"

msgid "value missing"
msgstr "verdi mangler"

msgid "values and labels are strings"
msgstr "values og labels er strenger"

msgid "values is an array of 1 to 32 strings"
msgstr "values er en matrise av 1 til 32 strenger"

