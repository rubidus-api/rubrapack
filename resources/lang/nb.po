msgstr "[menu.{1}]: list står for {2} når banene ikke får plass på en kommandolinje: krever multi = \"one\", {3} i args og {4} (listefilen) i list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": det finnes ingen [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on er en filtype eller en liste med dem, som [\".txt\", \"folder\"]"

