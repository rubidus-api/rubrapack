msgstr "'{1}': ingen --timestamp: signaturen slutter å være gyldig når sertifikatet utløper"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': pakken '{2}' samsvarer ikke med sin SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinet-strømmen '{2}' finnes ikke"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifestet har ingen {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifestet nevner '{2}', som ikke er i pakken"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': tidsstempel fra {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformeringen '{2}' kan ikke leses mot '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' er pakkens eget språk ({2}); oppgi den teksten uten suffikset"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' får Windows Installer til å skrive en multistreng; bruk type = \"multi\" og en matrise"

msgid "'_' in numbers is not supported"
msgstr "'_' i tall støttes ikke"

msgid "'help' takes at most one command name"
msgstr "'help' tar høyst ett kommandonavn"

msgid "'version' takes no arguments"
msgstr "'version' tar ingen argumenter"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs gjelder .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch for en samling: en liste med x64, x86 og arm64, hver én gang (fikk '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch tar én arkitektur, eller en liste for en .msixbundle-utdata"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp og --allow-unsigned-cabs hører til --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress gjelder .msi; en MSIX tar --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist navngir en ny mappe ved siden av kilden (ingen bane)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs tar et tall fra 1 til 64 (fikk '{1}')"

