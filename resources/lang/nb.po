msgstr "'{1}': en MSIX installerer alle filene sine (when); bruk msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': en MSIX fjerner alle filene sine (keep); bruk msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' er skadet eller ikke stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinetnavnet '{2}' er ikke et enkelt filnavn"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimert fil '{2}' (sekvens {3}) har ingen cabinet"

