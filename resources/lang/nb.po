msgstr "'{1}' ser ut som en programfil (PE), men hodene eller ressursene er skadet"

msgid "'%s' must be a string"
msgstr "'{1}' må være en streng"

msgid "'%s' must be an integer"
msgstr "'{1}' må være et heltall"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' må være mellom {2} og {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' må være true eller false"

msgid "'%s' must not be empty"
msgstr "'{1}' kan ikke være tom"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' navngir ingen transformeringer (sammendragsegenskap 8): ikke en oppdatering"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' begynner med en mappe: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' har {4}; ingenting ble pakket ut"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} oppføringer, flere enn grensen {3} (--limit-entries); ingenting ble pakket ut"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' og '{3}' ville vært samme bane i Windows; ingenting ble pakket ut"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' er ikke i [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': en tabell kan ikke leses"

msgid "'%s': a table is unreadable"
msgstr "'{1}': en tabell er uleselig"

