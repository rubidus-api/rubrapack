msgstr "[handler.{1}]: klassen er msi-only ([com.{2}]); MSIX-en ville ikke ha noen server for den"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types er en liste med filtyper, som [\".txt\"]"

