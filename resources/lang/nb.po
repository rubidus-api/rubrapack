msgstr "'{1}' har en uleselig strøm med sammendragsinformasjon"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' har ingen Directory-, Component-, File- og Media-tabeller å pakke ut fra"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' har ingen innebygd transformasjon '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' har ingen lesbar sammendragsinformasjon"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' har ingen transformering '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' er UTF-16: edit endrer bare UTF-8-kilder (lagre den som UTF-8 først)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' er et Windows-navn; gi variabelen et annet navn"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' er en [chain]: den bygger et installasjonsprogram, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' er en kontroll i den innebygde rammen; velg en annen ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' er en datamaskinmappe; en {2}-pakke kan ikke skrive der"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' er en flettemodul: flett den med [merge.ID] i stedet"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' er et navn som MSIX-formatet holder for seg selv"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' er en symbolsk lenke; lenker følges ikke"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' er også en [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' er også en dir-ID; gi variabelen et annet navn"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' er bygget for maskin 0x{2}, ikke for denne pakkens arch; angi any-arch = true hvis det er meningen"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' er verken en PE-fil (.exe, .dll), en MSI-pakke eller en MSIX-pakke eller -samling"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' er verken en PE-fil, en MSI-pakke eller en MSIX-pakke eller -samling"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' er verken en kjent mappe eller en dir-ID (kjente mapper: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

