msgctxt "installer"
msgid "DirNotEmptyText"
msgstr "Denne mappen inneholder allerede filer eller mapper. Når [ProductName] fjernes, slettes alt i mappen - også det som er der nå. En tom eller ny mappe er det trygge valget."

msgctxt "installer"
msgid "DirChoose"
msgstr "&Velg en annen"

msgctxt "installer"
msgid "DirContinue"
msgstr "Br&uk denne mappen"

msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] program bruker filer fra [3]:\r\n[2]\r\nVil du lukke alle?\r\n\r\nJa: lukk alle og fortsett (arbeid som ikke er lagret, kan gå tapt).\r\nNei: fortsett uten å lukke (programmer som allerede er åpne, beholder de gamle filene til de åpnes på nytt).\r\nAvbryt: stopp."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: stoppet fordi [1] program bruker filene:\r\n[2]Lukk dem og prøv igjen, eller angi RPCLOSE=yes (lukk alle og fortsett) eller RPCLOSE=no (fortsett uten å lukke)."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] element i mappene til [3] ble ikke installert med det:\r\n[2]\r\nVil du slette også disse?\r\n\r\nJa: slett dem sammen med [3] (de kan ikke gjenopprettes).\r\nNei: fjern [3] og behold dem.\r\nAvbryt: stopp."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: stoppet fordi [1] element i mappene ikke ble installert med det:\r\n[2]Angi RPEXTRA=delete (slett også disse) eller RPEXTRA=keep (behold dem), og fjern det på nytt."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "[1] andre brukere av denne datamaskinen kan ha innstillinger eller data fra [3]:\r\n[2]\r\nSkal deres også slettes?\r\n\r\nJa: slett dem for alle brukere (de kan ikke gjenopprettes).\r\nNei: slett bare dine.\r\nAvbryt: stopp."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] er allerede installert på datamaskinen fra Microsoft Store eller som app-pakke ([2]). To kopier av et program åpner begge filene og viser begge menyene.\r\n\r\nInstallere også denne?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] er allerede installert på datamaskinen fra Microsoft Store eller som app-pakke ([2]). Fjern den kopien først (Innstillinger > Apper), og installer deretter denne."

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "Det finnes allerede en annen installasjon av [1] på datamaskinen ([2]). To kopier av et program åpner begge filene og viser begge menyene.\r\n\r\nInstallere også denne?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "Det finnes allerede en annen installasjon av [1] på datamaskinen ([2]). Fjern den først (Innstillinger > Apper), og installer deretter denne."

msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] kunne ikke installeres, og angringen fjernet ikke alt. Det som er igjen, står nedenfor. Kjør installasjonsprogrammet på nytt, og fjern deretter [1] hvis du ikke vil ha det.\r\nLogg: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] kunne ikke oppgraderes, og angringen gjenopprettet ikke versjonen du hadde. Forskjellene står nedenfor. Reparer den med installasjonsprogrammet for den versjonen, eller installer den nye versjonen på nytt.\r\nLogg: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] kunne ikke fjernes, og angringen gjenopprettet det ikke. Forskjellene står nedenfor. Reparer det med installasjonsprogrammet, og fjern det deretter på nytt.\r\nLogg: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] kunne ikke repareres, og angringen gjenopprettet det ikke. Forskjellene står nedenfor. Kjør installasjonsprogrammet på nytt for å reparere det.\r\nLogg: [2]"
