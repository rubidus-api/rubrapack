# rubrapack language pack: Russian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: ru\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Русский\n"
"X-Rubrapack-LangIDs: 1049\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, диалоги {6}{7}\n  1 имя, производитель, версия, архитектура     2 папка установки, для кого\n  3 диалоги, лицензия, языки                     4 необязательные части\n  5 ярлыки                                       6 файлы: по папке программы\n  7 любой ключ                                   v показать   l lint   s сохранить   q выйти\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nСообщения с этим кодом (* - имя или значение):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nРезультаты выводятся в stdout, диагностика - в stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nЧто сделать: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} больше нет, но его открывает ярлык: сначала измените ярлыки (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  там файлов: {1}, папок: {2}\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s или q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  добавлены [dir.{1}] и [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  добавлен [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  укажите в виде таблица.ключ, например package.version или dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: проблем нет\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: см. проблемы выше (указанный там файл - проверочная копия)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  остальные языки в [ui] languages сохранены; изменить этот список можно через 7 (любой ключ)\n"

msgid "  removed [file.%s]\n"
msgstr "  удален [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  удален [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  вложенные папки:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  это не укладывается в подмножество TOML; ничего не изменено\n"

msgid "  that was not readable text; again, please\n"
msgstr "  это не читаемый текст; повторите, пожалуйста\n"

msgid "  the program folder '%s': %s\n"
msgstr "  папка программы '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  в исходнике нет таблиц [file], на которые мог бы указывать ярлык\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  в исходнике нет вложенных папок в том виде, как их пишет `new` ([files] \"<folder>/<name>/**\"); добавьте их через 6\n"

msgid "  too long; again, please\n"
msgstr "  слишком длинно; повторите, пожалуйста\n"

msgid "  y or n\n"
msgstr "  y или n\n"

msgid " (changed)"
msgstr " (изменено)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - сборка пакетов Windows Installer (.msi) и MSIX (.msix)\n\nиспользование: rubrapack [--lang <code>] <command> [arguments]\n\nкоманды:\n"

msgid " and its dir"
msgstr " и его dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "у $({1}) нет переменной среды, поэтому расширяемое значение не может его содержать; используйте строковое значение (заполняется при установке)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) - это {2}: он может начинать путь или заменять значение, которое заполняет Windows Installer (реестр, среда, INI, аргументы, сообщения), но не здесь"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) - не папка, с которой может начинаться путь (ID dir или ProgramFiles, LOCALAPPDATA, ProgramData ... - см. раздел Paths руководства){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  структура:   {2}\n  хэш:        {3}\n  подпись:     {4}\n  цепочка:     {5}{6}{7}\n  отзыв:       не проверен\n  метка времени: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: переменная не задана"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' не является элементом управления этого диалога"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' нет в {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': тексту лицензии нужно английское имя шрифта, поэтому он показывается собственным шрифтом языка; напишите английское имя (например \"Malgun Gothic\"), чтобы использовать этот шрифт и там"

msgid "%s component, but the package platform is %.*s"
msgstr "компонент {1}, но платформа пакета - {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} не относится к kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} не относится к kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} содержит LANGID (1..65535), например 1041"

msgid "%s holds strings"
msgstr "{1} содержит строки"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} - имя шрифта длиной от 1 до 31 символа, например \"Segoe UI\" (получено {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} - условие MSI с закрытыми кавычками и парными скобками"

msgid "%s is an array of strings, one per value"
msgstr "{1} - массив строк, по одной на значение"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} относится к пакетам MSI: MSIX не удаляется через msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} больше нет. Удалить [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} длиннее 240 символов"

msgid "%s is new. Add it?"
msgstr "{1} - новый. Добавить?"

msgid "%s is not a GUID in registry format"
msgstr "{1} не является GUID в формате реестра"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} - не код, который использует этот rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} должен быть \"file:<ID>\" и указывать [file.*] этого пакета"

msgid "%s must be a GUID"
msgstr "{1} должен быть GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} должен быть GUID вида {12345678-...} (получено '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} должен быть адресом https://, http:// или file:// либо путем \\\\server\\share (получено '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} должен отличаться от upgrade-code (одно семейство обновлений на архитектуру)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} требуется сборка Windows {2} или новее: задайте [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} требуется resources/bin/rubrapack_ca-{2}.dll, без которой собран этот rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA не проверен (укажите --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA доверенный"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA недоверенный - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} больше нет или он пуст. Удалить [files.{3}] и [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ - новая папка. Добавить?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: ошибок: {2}{-3}, предупреждений: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: ошибок: {2}{-3}, предупреждений: {4}{-5} (по сравнению с {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: файлов: {2}, байт: {3}\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: файлов: {2}, ошибок: {3}, предупреждений: 0\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: еще {2} диагностических сообщений не показано\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: файл '{2}' не является [file.*] этого пакета"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: файл '{2}' не является программой (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' не закрыт (для текста '$(' пишите '$$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' уже существует; оставлен как есть"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' уже существует; удалите его или выполните сборку в другую папку"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "у '{1}' уже есть обработчик {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "у '{1}' уже есть разрешения"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' и '{2}' - один и тот же путь в пакете"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' принадлежит Windows или браузерам"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' нельзя прочитать относительно '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' не укладывается в подмножество TOML; ничего не сохранено"

msgid "'%s' exists already"
msgstr "'{1}' уже существует"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' уже существует; измените его через `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' существует и не является пустым каталогом; распакуйте в новый"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' относится к {2}; или msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "у '{1}' нечитаемый поток сводной информации"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "в '{1}' нет таблиц Directory, Component, File и Media для распаковки"

msgid "'%s' has no readable summary information"
msgstr "в '{1}' нет читаемой сводной информации"

msgid "'%s' has no transform '%.*s'"
msgstr "в '{1}' нет преобразования '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' в UTF-16: edit изменяет только исходники в UTF-8 (сначала сохраните его в UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' - имя Windows; дайте переменной другое имя"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' - это [chain]: он собирает программу установки, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' - элемент управления встроенной рамки; выберите другой ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' - папка компьютера; пакет {2} не может писать туда"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' - модуль слияния: используйте вместо этого [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' - имя, которое формат MSIX оставляет за собой"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' - символическая ссылка; по ссылкам не переходят"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' также является [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' также является ID dir; дайте переменной другое имя"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' собран для машины 0x{2}, а не для arch этого пакета; задайте any-arch = true, если так и задумано"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не является ни файлом PE (.exe, .dll), ни пакетом MSI, ни пакетом или пакетом-набором MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не является ни файлом PE, ни пакетом MSI, ни пакетом или пакетом-набором MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' не является ни известной папкой, ни ID dir (известные папки: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' не является CAB-файлом, который может прочитать rubrapack (stored или MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' не является диагностическим кодом (RP и четыре цифры, например RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' не является программой (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' не является обычным файлом"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' не является программой установки rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' не является допустимым ID (буквы, цифры и '_', не с цифры, не более {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' не является допустимой базой данных MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' не является допустимым пакетом MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' не является допустимым пакетом: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' не является допустимым исходником (подмножество TOML); сначала исправьте его вручную"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' не является допустимым преобразованием: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' не является допустимым именем переменной"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' зарезервировано и не может быть ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' - имя dir: заполнить dir может только поиск в реестре или поиск dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' похож на программный файл (PE), но его заголовки или ресурсы повреждены"

msgid "'%s' must be a string"
msgstr "'{1}' должен быть строкой"

msgid "'%s' must be an integer"
msgstr "'{1}' должен быть целым числом"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' должен быть от {2} до {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' должен быть true или false"

msgid "'%s' must not be empty"
msgstr "'{1}' не может быть пустым"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' не указывает преобразований (свойство сводки 8): это не исправление"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' начинается с папки: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': у {2} '{3}' есть {4}; ничего не распаковано"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': записей {2}, больше предела {3} (--limit-entries); ничего не распаковано"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' и '{3}' были бы одним путем в Windows; ничего не распаковано"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' нет в [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': не удается прочитать таблицу"

msgid "'%s': a table is unreadable"
msgstr "'{1}': таблица нечитаема"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX устанавливает все свои файлы (when); используйте msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX удаляет все свои файлы (keep); используйте msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': CAB-файл '{2}' поврежден или не stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': имя CAB-файла '{2}' не является простым именем файла"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': у сжатого файла '{2}' (последовательность {3}) нет CAB-файла"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': у каталога '{2}' есть родитель '{3}', которого нет"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': каталог '{2}' является собственным предком или вложен слишком глубоко"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': файл '{2}' не соответствует своему MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': у файла '{2}' нет компонента или каталога"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': файл '{2}' - {3} байт, а в таблице File указано {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': файла '{2}' нет в CAB-файле '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': его внешние CAB-файлы не охвачены подписью (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': его папка не ведет в известное расположение"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': для записи больше {2} байт (--limit-bytes); ничего не распаковано"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': нет --timestamp: подпись перестанет быть действительной, когда истечет срок сертификата"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': пакет '{2}' не соответствует своему SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': потока CAB '{2}' нет"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': в манифесте нет {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': манифест указывает '{2}', которого нет в пакете"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': метка времени от {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': преобразование '{2}' нельзя прочитать относительно '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' - собственный язык пакета ({2}); укажите этот текст без суффикса"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' заставляет Windows Installer записать многострочное значение; используйте type = \"multi\" и массив"

msgid "'_' in numbers is not supported"
msgstr "'_' в числах не поддерживается"

msgid "'help' takes at most one command name"
msgstr "'help' принимает не более одного имени команды"

msgid "'version' takes no arguments"
msgstr "'version' не принимает аргументов"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs относится к .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch для пакета-набора: список из x64, x86 и arm64, каждый по разу (получено '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch принимает одну архитектуру или список для вывода .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp и --allow-unsigned-cabs используются с --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress относится к .msi; MSIX принимает --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist указывает новую папку рядом с исходником (без пути)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs принимает число от 1 до 64 (получено '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store - хранилище сертификатов Windows; в других системах используйте файл ключа или --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store принимает отпечаток SHA-1 сертификата (40 шестнадцатеричных цифр)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: такого языка нет (встроены: {2}; для другого нужен его языковой пакет, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (или RUBRAPACK_LANG) выбирает язык этих текстов: {1} или язык с языковым пакетом.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang нужен язык, например en или ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages нужны диалоги: укажите также --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress принимает deflate или store (получено '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: переменная не задана"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code принимает GUID в верхнем регистре в фигурных скобках: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: переменная не задана"

msgid "--previous compares two .msi packages"
msgstr "--previous сравнивает два пакета .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: не удается прочитать корневые сертификаты операционной системы"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} не соответствует выводу '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} не реализован (msi или msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target принимает msi или msix (получено '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots и --proxy используются с --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test и --msix-compress относятся к выводу .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test - для пакетов без подписи; с --key не указывайте его"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate принимает none или часть из product-code,upgrade-code,language,platform"

msgid "-D %.*s is given twice"
msgstr "-D {1} указан дважды"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' - имя Windows; дайте переменной другое имя"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D требует ИМЯ=ЗНАЧЕНИЕ (получено '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i спрашивает каждый ответ; укажите либо -i, либо параметры"

msgid "; its range is "
msgstr "; его диапазон: "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' нет в SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty должно быть открытым свойством (верхний регистр)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "Все коды: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x не начинается с PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x - не последняя запись"

msgid "Architecture (x64, x86, arm64)"
msgstr "Архитектура (x64, x86, arm64)"

msgid "Choose"
msgstr "Выберите"

msgid "Command line"
msgstr "Командная строка"

msgid "Command line (lint)"
msgstr "Командная строка (lint)"

msgid "Common AppData"
msgstr "Общие AppData"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId не является GUID в формате реестра"

msgid "Desktop shortcut?"
msgstr "Ярлык на рабочем столе?"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "Диалоги (none, basic, minimal, installdir, features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "Коды выхода: 0 успех, 1 ошибка в исходнике, 2 использование, 3 ввод-вывод, 4 подпись или проверка,\n5 lint, 6 сеть.\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "В таблице File, Component или Directory нет стандартного столбца"

msgid "Folder name under Program Files"
msgstr "Имя папки в Program Files"

msgid "Folder with the files to install"
msgstr "Папка с файлами для установки"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "ID '{1}' уже используется (строка {2}); ID должны различаться во всех таблицах"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "Папка установки ([dir.INSTALLDIR] path)"

msgid "Install for (machine, user, dual)"
msgstr "Для кого установка (machine, user, dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "Ключ вида таблица.ключ (package.version, dir.INSTALLDIR.path, ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' принадлежит другому компоненту"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' нет в File"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' нет в Registry"

msgid "Korean dialogs as well as English?"
msgstr "Корейские диалоги в дополнение к английским?"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} меньше, чем у меньшего DiskId"

msgid "Leave without saving the changes?"
msgstr "Выйти, не сохранив изменения?"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "Лицензия для принятия (.txt, .md, .rtf; - если нет)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "В MSIX нет виртуальной папки для AppData пользователя; приложение создает там нужное при запуске"

msgid "MSIX packages"
msgstr "Пакеты MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: что нужно пакету MSIX и чего он не может содержать"

msgid "Main program, for shortcuts (- for none)"
msgstr "Основная программа для ярлыков (- если нет)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "Руководство: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Производитель"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Производитель (показывается в списке установленных приложений)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt вернул подпись ECDSA неверной длины"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "Необязательные части, которые пользователь может отметить (вложенные папки через запятую; - если нет)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "Токен PKCS#11: в токене нет сертификата с CKA_ID ключа (укажите его через --cert)"

msgid "Paths"
msgstr "Пути"

msgid "Product name"
msgstr "Имя продукта"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode и UpgradeCode - один и тот же GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} не выше предыдущей {2} в первых трех полях: Windows Installer не обновляет"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Программа, которую открывают ярлыки (- без ярлыков)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: такого языка нет (встроены: {2}; для другого нужен его языковой пакет, {3}.po)"

msgid "Reference, "
msgstr "Справочник, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Последовательность {1} не охвачена ни одной строкой Media (последняя {2})"

msgid "Sequence %ld is used by another file"
msgstr "Последовательность {1} используется другим файлом"

msgid "Source file to write"
msgstr "Исходный файл для записи"

msgid "Source format"
msgstr "Формат исходника"

msgid "Source must name a File row for type %ld"
msgstr "Source должен указывать строку File для типа {1}"

msgid "Start menu shortcut?"
msgstr "Ярлык в меню «Пуск»?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Элементы меню «Пуск», «Программы», рабочего стола и автозагрузки берутся из [shortcut.*] и [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML вне подмножества, которое читает rubrapack, или `format` отсутствует либо слишком новый"

msgid "Tables"
msgstr "Таблицы"

msgid "The TOML subset"
msgstr "Подмножество TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Файлы UTF-16 big-endian не поддерживаются; сохраните в UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} отличается от {2} предыдущей версии: этот пакет не заменяет ее"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode не является GUID в формате реестра"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Значение (текст, число, true/false, [\"a\", \"b\"]; - удаляет ключ)"

msgid "Variables"
msgstr "Переменные"

msgid "Version"
msgstr "Версия"

msgid "Version ([define] VERSION)"
msgstr "Версия ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Версии и обновления"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer допускает не более 255.255.65535(.65535)"

msgid "Windows name"
msgstr "имя Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] требует '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] нельзя поместить в модуль слияния; его содержит пакет, который выполняет слияние"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] пока не поддерживается (запланировано на {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] нельзя поместить в MSIX; добавьте msi-only = true, чтобы собрать MSIX без него"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] находится в AppData или LocalAppData пользователя: пакет dual, установленный для всех пользователей, помещает его только в профиль устанавливающего пользователя"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID в модуле слияния - не более 35 символов (к нему добавляется GUID модуля)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] нужен ID: напишите [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] не принимает ID: напишите [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "в [Content_Types].xml нет </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml - не последняя запись (пакет записан не rubrapack и не API упаковки Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "массивы таблиц [[...]] не поддерживаются; дайте каждому элементу свой [kind.ID]"


msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] требует и do, и undo (undo также откатывает неудачный do)"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args для MSIX должны быть простым текстом (без [...], заполняемых при установке)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: в MSIX тип файла открывает приложение: target должен быть исполняемым файлом [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] указан дважды"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] нужен ID: напишите [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id и typelib записываются только для MSI; MSIX регистрирует класс без них"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args относятся к программе; DLL загружается, а не запускается"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate запускает DLL в dllhost; '{2}' - программа"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading относится к DLL; программа сама задает свое подразделение"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version и typelib-file требуют typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] относится к {2}; или msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: источником должен быть файл, который входит в пакет"

msgid "[define] values must be strings"
msgstr "значения [define] должны быть строками"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] требует '{2}'"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] требует 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] требует 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] требует 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "в [dialog.{1}] элементов управления: {2}; не более 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "в [dialog.{1}] нет [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] через другие диалоги оказывается после самого себя"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] требует ui = \"minimal\", \"installdir\" или \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' - имя Windows; дайте dir другой ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard требует вспомогательную DLL rubrapack, которой нет в модуле слияния"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] требует компонент"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX задает все свои переменные (when); используйте msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: значение указывает место, которое MSIX не может дать (папку вне пакета, не являющуюся папкой Windows, или часть, известную только при установке); используйте msi-only = true"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] находится в профиле пользователя и имеет component-guid: ключевым путём остаётся файл, тогда как правила Windows требуют там значение HKCU (ICE38); уберите component-guid, чтобы его получить"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Проводник загружает обработчик {2} из DLL; [com.{3}] - программа"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows читает обработчики свойств только для всего компьютера; пакету нужен scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: обработчик предварительного просмотра работает в prevhost Windows; уберите app-id и surrogate из [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX содержит только обработчики эскизов и просмотра (упакованный обработчик свойств не давал Проводнику значений); msi-only = true оставляет его для MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: тип файла MSIX принадлежит приложению; добавьте [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: класс {2} не является [com.*] этого пакета (его обслуживает DLL обработчика)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: в MSIX обработчики разделяют все свои типы или ни одного (тип входит в одну связь типа файла)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: в MSIX его класс работает в суррогатном процессе; threading = \"sta\" в [com.{2}] дает его окну цикл сообщений (при threading = {3} просмотр может остаться пустым)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: в MSIX все его типы входят в один тип файла [assoc] или ни в один"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: его класс msi-only ([com.{2}]); у MSIX не было бы для него сервера"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types - список типов файлов, например [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] относится к {2}; или msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] требует 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] требует компонент: задайте 'feature' здесь или у его dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX записывает все свои записи INI (when); используйте msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: в значении есть часть, которую Windows Installer заполняет при установке ([...]); MSIX записывает файл при сборке"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] требует 'on': где показывается элемент, например [\".txt\"] или \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] требует 'target' (запускаемую программу) или элементы с parent = \"{2}\" (подменю)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] требует 'target': программу, которую запускает элемент"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: меню Windows 11 принимает ID только из букв и цифр (без '_'): переименуйте или укажите windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: подменю ничего не запускает: уберите 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: элемент подменю показывается там же, где его подменю: уберите 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: в args есть часть, которую Windows Installer заполняет при установке ([...]); MSIX содержит только постоянный текст"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when — это \"HKCU\\\\key\\\\value\" или \"HKLM\\\\...\", у пункта меню Windows 11, который не входит в подменю"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when указывает на значение, которое пишет сам этот пакет ([registry.{2}]): пункт никогда не появится"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: его программы нет в MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: его значения нельзя поместить в реестр пакета"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: в list есть часть, которую Windows Installer заполняет при установке ([...]); MSIX содержит только постоянный текст"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list заменяет {2}, когда пути не помещаются в командную строку: нужны multi = \"one\", {3} в args и {4} (файл списка) в list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": нет [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on - тип файла или их список, например [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' не является [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' должен быть подменю: [menu.*] без target и без собственного parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] относится к {2}; или msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] требует компонент: задайте 'feature' здесь или у его dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; или msi-only = true"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args должны быть простым текстом (без [...], заполняемых при установке)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file должен быть {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file должен указывать файл, который входит в пакет"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file должен указывать программу, которая входит в пакет"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types - список типов файлов, например [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows принимает только буквы и цифры"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] указывает одну копию: msix (с publisher) или upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix — имя удостоверения пакета (от 3 до 50 букв, цифр, '.' или '-'), и нужен publisher (\"CN=...\"), как в его манифесте"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: другую копию ищет предварительная проверка: нужно preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code принадлежит этому пакету (это обновление, а не другая копия)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] требует, чтобы у его dir был компонент"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args для MSIX должны быть простым текстом (без [...], заполняемых при установке)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: в MSIX схема открывает приложение: target должен быть исполняемым файлом [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] требует 'value' (или remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR не выходит за пределы MSIX; используйте [assoc.*], [protocol.*], [com.*] или [handler.*] либо msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: значение qword требует вспомогательную DLL rubrapack, которой нет в модуле слияния"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX содержит значения только в {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX не удаляет значения и не оставляет их (remove, keep); используйте msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX записывает все свои значения (when); используйте msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: в значении есть часть, которую Windows Installer заполняет при установке ([...]); MSIX содержит только постоянные значения"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" требует вспомогательную DLL rubrapack, которой нет в модуле слияния"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: имя раздела или параметра нельзя поместить в куст реестра"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" — для root = \"HKCU\" с on = \"uninstall\", в пакете для компьютера"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] требует компонент: задайте 'feature' здесь или у его dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true не для папки внутри {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true требует вспомогательную DLL rubrapack, которой нет в модуле слияния"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" — для recursive = true у папки в AppData или LocalAppData, в пакете для компьютера"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args для MSIX должны быть простым текстом (без [...], заполняемых при установке)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file должен указывать программу, которая входит в пакет"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: у MSIX ярлыки бывают только на рабочем столе и в меню «Пуск»{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: у ярлыка MSIX нет working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: ярлык MSIX есть всегда (when - для MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: ярлык MSIX показывает логотип своего приложения; icon - для MSI"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args для MSIX должны быть простым текстом (без [...], заполняемых при установке)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: в MSIX ярлык запускает приложение: target должен быть исполняемым файлом [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: элемент меню «Пуск» у MSIX - это его приложение, которое не принимает args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: нет текста диалога с этим ID"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package]"
msgstr "[ui] требует ui = \"basic\" или другой набор диалогов в [package]"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "экранирование \\{1} не является скалярным значением Unicode"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: этот пакет не обновил бы предыдущий чисто"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` пакета: диалоги, кодовая страница, нормализация текста"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` пакета или пакета-набора MSIX"

msgid "a %s control has no text; put a text control beside it"
msgstr "у элемента {1} нет текста; поставьте рядом текстовый элемент"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "элементу {1} нужен [property.{2}] с одним из его значений по умолчанию (его использует тихая установка)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "пакет {1} не может писать в HKLM; используйте HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "выводу .msix нужна таблица [msix-app.ID] с исполняемым файлом"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "выводу .msix нужна таблица [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "вывод .msm - модуль слияния, собираемый из исходника с [module] вместо [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "файл .txt, .md или .rtf либо - если нет"

msgid "a PE file without a certificate table entry"
msgstr "файл PE без записи таблицы сертификатов"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN никогда не принимается в командной строке (его видят другие); используйте --pin-env или --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "Package манифеста пакета-набора с неизвестным Type"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "Package манифеста пакета-набора без FileName, Offset или Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "запись ZIP не распаковывается до своего размера"

msgid "a ZIP entry larger than allowed"
msgstr "запись ZIP больше допустимого"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "CRC-32 записи ZIP не совпадает"

msgid "a ZIP entry's data lies outside the file"
msgstr "данные записи ZIP лежат вне файла"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "исходник [module] собирает модуль слияния: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "двоичное значение - четное число шестнадцатеричных цифр, например \"01A0FF\""

msgid "a bundle without packages"
msgstr "пакет-набор без пакетов"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "у сертификата в цепочке есть критическое расширение, которое rubrapack не понимает"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "сертификат в цепочке подписан сертификатом, который не является ЦС"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "цепочка содержит только [chain], [chain-package.ID] и [define], но не [{1}]; пакеты собираются из своих исходников"

msgid "a chain holds at most %d packages"
msgstr "цепочка содержит не более {1} пакетов"

msgid "a chain needs [chain]"
msgstr "цепочке нужен [chain]"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "цепочке нужен хотя бы один [chain-package.ID]"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "символ, недопустимый в имени Windows (/ \\ : * ? \" < > |)"

msgid "a control character"
msgstr "управляющий символ"

msgid "a damaged PE optional header"
msgstr "поврежденный необязательный заголовок PE"

msgid "a damaged PE section table"
msgstr "поврежденная таблица разделов PE"

msgid "a damaged ZIP64 end record"
msgstr "поврежденная завершающая запись ZIP64"

msgid "a damaged hive bin"
msgstr "поврежденный bin куста"

msgid "a diagnostic of rubrapack"
msgstr "диагностика rubrapack"

msgid "a disabled service cannot be started"
msgstr "отключенную службу нельзя запустить"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "пакет dual не может выбирать между переменной пользователя и системной"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "пакет dual пишет в HKMU (HKLM или HKCU в зависимости от установки), а не в HKCU"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "значение dword - целое число 0..4294967295 (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "возможность, которой нет в этом rubrapack (или без которой он собран)"

msgid "a file larger than allowed"
msgstr "файл больше допустимого"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "имя файла в '{1}' не является допустимым Unicode и не может быть упаковано"

msgid "a file name without / \\ : * ? \" < > | $"
msgstr "имя файла без / \\ : * ? \" < > | $"

msgid "a file's component or directory chain is broken"
msgstr "цепочка компонента или каталога файла нарушена"

msgid "a font goes into an MSIX through a [font.*] that names it"
msgstr "шрифт попадает в MSIX через [font.*], который его указывает"

msgid "a hash the token signing does not know"
msgstr "хэш, который не знает подпись токеном"

msgid "a hive cell crosses its bin"
msgstr "ячейка куста пересекает свой bin"

msgid "a hive version or type rubrapack does not read"
msgstr "версия или тип куста, которые rubrapack не читает"

msgid "a known folder itself ('%s') cannot get permissions"
msgstr "самой известной папке ('{1}') нельзя назначить разрешения"

msgid "a license needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "лицензия требует ui = \"minimal\", \"installdir\" или \"features\""

msgid "a local header with extra fields (not a package rubrapack or Windows' packaging API wrote)"
msgstr "локальный заголовок с дополнительными полями (пакет записан не rubrapack и не API упаковки Windows)"

msgid "a malformed central directory"
msgstr "поврежденный центральный каталог"

msgid "a modification package has no applications of its own"
msgstr "у пакета изменения нет собственных приложений"

msgid "a modification package needs Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "пакету изменения нужна сборка Windows 18362 или новее: задайте [msix] min-version = \"10.0.18362.0\""

msgid "a module's compress is \"none\", \"mszip\" or \"mszip:0\" ... \"mszip:9\""
msgstr "compress модуля - \"none\", \"mszip\" или \"mszip:0\" ... \"mszip:9\""

msgid "a module's name is its ID in the ModuleID: letters, digits and _, at most 35 characters"
msgstr "имя модуля - его ID в ModuleID: буквы, цифры и _, не более 35 символов"

msgid "a multi value is a non-empty array of strings"
msgstr "значение multi - непустой массив строк"

msgid "a multi value is an array of strings"
msgstr "значение multi - массив строк"

msgid "a name ending with a space or a dot"
msgstr "имя, оканчивающееся пробелом или точкой"

msgid "a name longer than 255 bytes"
msgstr "имя длиннее 255 байт"

msgid "a package named in the bundle manifest is not in the bundle"
msgstr "пакета, указанного в манифесте пакета-набора, нет в наборе"

msgid "a package without Identity Name, Publisher, Version and ProcessorArchitecture (or ResourceId)"
msgstr "пакет без Identity Name, Publisher, Version и ProcessorArchitecture (или ResourceId)"

msgid "a package's Offset or Size in the bundle manifest does not match where it lies (or it is compressed)"
msgstr "Offset или Size пакета в манифесте набора не совпадают с его положением (или он сжат)"

msgid "a package's identity differs from what the bundle manifest says of it"
msgstr "удостоверение пакета отличается от указанного в манифесте набора"

msgid "a package's name in the bundle must be a file name ending in .msix or .appx"
msgstr "имя пакета в наборе должно быть именем файла, оканчивающимся на .msix или .appx"

msgid "a password is never taken on the command line (others can see it); use --pass-env or --pass-file"
msgstr "пароль никогда не принимается в командной строке (его видят другие); используйте --pass-env или --pass-file"

msgid "a per-machine package does not write HKCU (it would be the installing user's); use scope = \"user\""
msgstr "пакет для всего компьютера не пишет в HKCU (это был бы раздел устанавливающего пользователя); используйте scope = \"user\""

msgid "a proxy with a user name or password is not supported"
msgstr "прокси с именем пользователя или паролем не поддерживается"

msgid "a qword value is an integer or \"0x\" and 1 to 16 hex digits"
msgstr "значение qword - целое число или \"0x\" и от 1 до 16 шестнадцатеричных цифр"

msgid "a radio control stacks its buttons: height must be at least 12 per value (%d)"
msgstr "переключатель располагает кнопки друг под другом: height должна быть не меньше 12 на значение ({1})"

msgid "a record has more columns than its table"
msgstr "в записи больше столбцов, чем в ее таблице"

msgid "a record is cut short"
msgstr "запись обрезана"

msgid "a record names a string the pool does not have"
msgstr "запись указывает строку, которой нет в пуле"

msgid "a reserved device name"
msgstr "зарезервированное имя устройства"

msgid "a rollback action cannot be asynchronous"
msgstr "действие отката не может быть асинхронным"

msgid "a scheme is a lower-case letter, then lower-case letters, digits, '+', '-' or '.' (got '%s')"
msgstr "схема - строчная буква, затем строчные буквы, цифры, '+', '-' или '.' (получено '{1}')"

msgid "a script action between InstallInitialize and RemoveExistingProducts (error 2613)"
msgstr "действие скрипта между InstallInitialize и RemoveExistingProducts (ошибка 2613)"

msgid "a section lies outside the file"
msgstr "раздел лежит вне файла"

msgid "a service name may not contain '/' or '\\' (at most 256 characters)"
msgstr "имя службы не может содержать '/' или '\\' (не более 256 символов)"

msgid "a setup .exe is built from a source with [chain]; '%s' builds a package (.msi, .msix)"
msgstr "программа установки .exe собирается из исходника с [chain]; '{1}' собирает пакет (.msi, .msix)"

msgid "a source holds one [package] or one [module], not both"
msgstr "исходник содержит один [package] или один [module], но не оба"

msgid "a source that passes the RP1xxx checks should never meet these: please report it with the source"
msgstr "исходник, прошедший проверки RP1xxx, никогда не должен встречать это: сообщите об этом, приложив исходник"

msgid "a stored ZIP entry whose sizes differ"
msgstr "запись ZIP stored с несовпадающими размерами"

msgid "a stream of the package cannot be read"
msgstr "не удается прочитать поток пакета"

msgid "a table has more than 32 columns"
msgstr "в таблице больше 32 столбцов"

