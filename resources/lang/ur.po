# rubrapack language pack: Urdu.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.
# The language reads right to left (X-Rubrapack-Direction: rtl): its dialogs are mirrored.

msgid ""
msgstr ""
"Language: ur\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: اردو\n"
"X-Rubrapack-LangIDs: 1056, 2080\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 3\n"
"X-Rubrapack-Direction: rtl\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, ڈائیلاگز {6}{7}\n  1 نام، بنانے والا، ورژن، آرکیٹیکچر            2 انسٹال فولڈر، کس کے لیے\n  3 ڈائیلاگز، لائسنس، زبانیں                     4 اختیاری حصے\n  5 شارٹ کٹس                                     6 فائلیں: پروگرام فولڈر سے ملائیں\n  7 کوئی بھی کلید                                v دیکھیں   l lint   s محفوظ   q باہر\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nاس کوڈ والے پیغامات (* کسی نام یا قدر کی جگہ ہے):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nنتائج stdout پر اور تشخیصات stderr پر جاتی ہیں۔\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nکیا کرنا ہے: {1}۔\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} موجود نہیں، لیکن ایک شارٹ کٹ اسے کھولتا ہے: پہلے شارٹ کٹس تبدیل کریں (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  وہاں {1} فائلیں اور {2} فولڈر ہیں\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7، v، l، s یا q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] اور [files.{2}] شامل کیے گئے\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] شامل کیا گیا\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  اسے جدول.کلید کی صورت میں دیں، جیسے package.version یا dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: کوئی مسئلہ نہیں\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: اوپر کے مسائل دیکھیں (وہاں نام دی گئی فائل جانچ کی کاپی ہے)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages میں دوسری زبانیں رکھی جاتی ہیں؛ وہ فہرست 7 سے تبدیل کریں (کوئی بھی کلید)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] ہٹا دیا گیا\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] ہٹا دیا گیا{2}\n"

msgid "  sub folders:"
msgstr "  ذیلی فولڈرز:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  یہ TOML ذیلی سیٹ میں فٹ نہیں؛ کچھ تبدیل نہیں ہوا\n"

msgid "  that was not readable text; again, please\n"
msgstr "  یہ پڑھنے کے قابل متن نہیں تھا؛ براہ کرم دوبارہ\n"

msgid "  the program folder '%s': %s\n"
msgstr "  پروگرام فولڈر '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  سورس میں کوئی [file] جدول نہیں جس کی طرف شارٹ کٹ اشارہ کرے\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  سورس میں `new` کی طرح لکھے گئے ذیلی فولڈرز نہیں ([files] \"<folder>/<name>/**\")؛ انہیں 6 سے شامل کریں\n"

msgid "  too long; again, please\n"
msgstr "  بہت لمبا ہے؛ براہ کرم دوبارہ\n"

msgid "  y or n\n"
msgstr "  y یا n\n"

msgid " (changed)"
msgstr " (تبدیل ہوا)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) اور MSIX (.msix) پیکیجز بناتا ہے\n\nاستعمال: rubrapack [--lang <code>] <command> [arguments]\n\nکمانڈز:\n"

msgid " and its dir"
msgstr " اور اس کا فولڈر"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) کا کوئی ماحولیاتی متغیر نہیں، اس لیے قابلِ توسیع قدر اسے نہیں رکھ سکتی؛ اسٹرنگ قدر استعمال کریں (انسٹال کے وقت بھری جاتی ہے)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) ایک {2} ہے: یہ کسی راستے کو شروع کر سکتا ہے یا کسی ایسی قدر کی جگہ لے سکتا ہے جو Windows Installer بھرتا ہے (رجسٹری، ماحول، INI، دلائل، پیغامات)، یہاں نہیں"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ایسا فولڈر نہیں جس سے راستہ شروع ہو سکے (ایک dir ID، یا ProgramFiles، LOCALAPPDATA، ProgramData ... - دستی میں راستے دیکھیں){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  ڈھانچہ:     {2}\n  ڈائجسٹ:     {3}\n  دستخط:      {4}\n  زنجیر:      {5}{6}{7}\n  منسوخی:     جانچ نہیں ہوئی\n  ٹائم اسٹیمپ: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: متغیر سیٹ نہیں"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' اس ڈائیلاگ کا کنٹرول نہیں"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3} میں نہیں"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': لائسنس کے متن کو فونٹ کا انگریزی نام چاہیے، اس لیے یہ زبان کے اپنے فونٹ میں دکھتا ہے؛ وہاں بھی یہ فونٹ استعمال کرنے کے لیے انگریزی نام لکھیں (جیسے \"Malgun Gothic\")"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' ایک فولڈر ہونا چاہیے"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} جزو، لیکن پیکیج کا پلیٹ فارم {2} ہے"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\" سے تعلق نہیں رکھتا"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\" سے تعلق نہیں رکھتا"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGIDs رکھتا ہے (1..65535)، جیسے 1041"

msgid "%s holds strings"
msgstr "{1} اسٹرنگز رکھتا ہے"

msgid "%s is %u to %u characters long"
msgstr "{1} کی لمبائی {2} سے {3} حروف ہے"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} \"کلید=قدر\" متون کی فہرست ہے"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} متنوں کی فہرست ہے، جیسے [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} 1 سے 31 حروف کا فونٹ نام ہے، جیسے \"Segoe UI\" ({2} ملا)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} بند کوٹس اور متوازن قوسین والی MSI شرط ہے"

msgid "%s is an array of strings, one per value"
msgstr "{1} اسٹرنگز کی ایک ترتیب ہے، ہر قدر کے لیے ایک"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI پیکیجز کے لیے ہے: MSIX کو msiexec نہیں ہٹاتا"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} موجود نہیں۔ [file.{2}] ہٹائیں؟"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 حروف سے لمبا ہے"

msgid "%s is new. Add it?"
msgstr "{1} نیا ہے۔ شامل کریں؟"

msgid "%s is not a GUID in registry format"
msgstr "{1} رجسٹری فارمیٹ میں GUID نہیں"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ایسا کوڈ نہیں جو یہ rubrapack استعمال کرے{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} کو \"file:<ID>\" ہونا چاہیے جو اس پیکیج کی [file.*] کا نام لے"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} کو {2} سے {3} حروف، ہندسے، '.' یا '-' ہونا چاہیے اور '.' سے شروع نہیں ہونا چاہیے ('{4}' ملا)"

msgid "%s must be a GUID"
msgstr "{1} کو GUID ہونا چاہیے"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} کو {{12345678-...} جیسا GUID ہونا چاہیے ('{2}' ملا)"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} ایک http:// یا https:// پتہ ہونا چاہیے ('{2}' ملا)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} کو https://، http:// یا file:// پتہ، یا \\\\server\\share راستہ ہونا چاہیے ('{2}' ملا)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} کو upgrade-code سے مختلف ہونا چاہیے (ہر آرکیٹیکچر کے لیے ایک اپ گریڈ فیملی)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} کو Windows بلڈ {2} یا بعد کا چاہیے: [msix] min-version = \"10.0.{3}.0\" سیٹ کریں"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} کو resources/bin/rubrapack_ca-{2}.dll چاہیے، جس کے بغیر یہ rubrapack بنایا گیا"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}، TSA جانچ نہیں ہوئی (--tsa-trust دیں)"

msgid "%s, TSA trusted"
msgstr "{1}، TSA قابلِ اعتماد"

msgid "%s, TSA untrusted - %s"
msgstr "{1}، TSA ناقابلِ اعتماد - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} موجود نہیں یا خالی ہے۔ [files.{3}] اور [dir.{4}] ہٹائیں؟"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ ایک نیا فولڈر ہے۔ شامل کریں؟"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: خرابیاں: {2}{-3}، انتباہات: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: خرابیاں: {2}{-3}، انتباہات: {4}{-5} ({6} کے مقابلے میں)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} فائلیں، {3} بائٹس\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} فائلیں، {3} خرابیاں، 0 انتباہات\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: مزید {2} تشخیصات نہیں دکھائی گئیں\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' کوئی معیاری عمل نہیں جو rubrapack رکھتا ہے"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: فائل '{2}' اس پیکیج کی [file.*] نہیں"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: فائل '{2}' پروگرام نہیں (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' بند نہیں ہوا (متن '$(' کے لیے '$$(' لکھیں)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' پہلے سے موجود ہے؛ اسے ویسا ہی چھوڑا جاتا ہے"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' پہلے سے موجود ہے؛ اسے ہٹائیں یا کسی اور فولڈر میں بنائیں"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' کا پہلے سے {2} ہینڈلر ہے ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' کی پہلے سے اجازتیں ہیں"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' اور '{2}' پیکیج میں ایک ہی راستہ ہیں"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' Windows یا براؤزرز کا ہے"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' کو '{2}' کے مقابلے میں نہیں پڑھا جا سکتا: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' TOML ذیلی سیٹ میں فٹ نہیں؛ کچھ محفوظ نہیں ہوا"

msgid "'%s' exists already"
msgstr "'{1}' پہلے سے موجود ہے"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' پہلے سے موجود ہے؛ اسے `rubrapack edit {2}` سے تبدیل کریں"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' موجود ہے اور خالی ڈائریکٹری نہیں؛ نئی میں نکالیں"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' {2} میں جاتا ہے؛ یا msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' میں ناقابلِ مطالعہ خلاصہ معلومات اسٹریم ہے"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' میں نکالنے کے لیے Directory، Component، File اور Media جدول نہیں"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' میں سرایت شدہ ٹرانسفارم '{2}' نہیں ہے"

msgid "'%s' has no readable summary information"
msgstr "'{1}' میں قابلِ مطالعہ خلاصہ معلومات نہیں"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' میں '{2}' ٹرانسفارم نہیں"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' UTF-16 ہے: edit صرف UTF-8 سورسز تبدیل کرتا ہے (پہلے اسے UTF-8 میں محفوظ کریں)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' ایک Windows نام ہے؛ متغیر کو کوئی اور نام دیں"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' ایک [chain] ہے: یہ سیٹ اپ پروگرام بناتا ہے، -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' بلٹ اِن فریم کا کنٹرول ہے؛ کوئی اور ID منتخب کریں"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' مشین فولڈر ہے؛ {2} پیکیج وہاں نہیں لکھ سکتا"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' ایک مرج ماڈیول ہے: اسے [merge.ID] سے ضم کریں"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' ایسا نام ہے جو MSIX فارمیٹ اپنے لیے رکھتا ہے"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' ایک علامتی لنک ہے؛ لنکس کی پیروی نہیں کی جاتی"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' ایک [property.*] بھی ہے"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' ایک dir ID بھی ہے؛ متغیر کو کوئی اور نام دیں"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' مشین 0x{2} کے لیے بنا ہے، اس پیکیج کے آرکیٹیکچر کے لیے نہیں؛ اگر جان بوجھ کر ہے تو any-arch = true سیٹ کریں"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' نہ PE فائل (.exe، .dll) ہے، نہ MSI پیکیج اور نہ MSIX پیکیج یا بنڈل"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' نہ PE فائل ہے، نہ MSI پیکیج اور نہ MSIX پیکیج یا بنڈل"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' نہ کوئی معلوم فولڈر ہے اور نہ dir ID (معلوم فولڈرز: ProgramFiles، ProgramFiles32، CommonFiles، AppData، LocalAppData، CommonAppData، StartMenu، Programs، Desktop، Windows، System، Fonts، Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' ایسا cabinet نہیں جو rubrapack پڑھ سکے (stored یا MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' تشخیصی کوڈ نہیں (RP اور چار ہندسے، جیسے RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' پروگرام نہیں (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' عام فائل نہیں"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' rubrapack سیٹ اپ پروگرام نہیں{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' درست ID نہیں (حروف، ہندسے اور '_'، ہندسے سے شروع نہیں، زیادہ سے زیادہ {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' درست MSI ڈیٹابیس نہیں: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' درست MSIX پیکیج نہیں: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' درست پیکیج نہیں: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' درست سورس نہیں (TOML ذیلی سیٹ)؛ پہلے اسے ہاتھ سے درست کریں"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' درست ٹرانسفارم نہیں: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' درست متغیر نام نہیں"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' محفوظ ہے اور ID کے طور پر استعمال نہیں ہو سکتا"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' ایک dir کا نام ہے: dir کو صرف رجسٹری یا dir تلاش بھر سکتی ہے"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' پروگرام فائل (PE) جیسا لگتا ہے لیکن اس کے ہیڈرز یا ریسورسز خراب ہیں"

msgid "'%s' must be a string"
msgstr "'{1}' کو اسٹرنگ ہونا چاہیے"

msgid "'%s' must be an integer"
msgstr "'{1}' کو عدد صحیح ہونا چاہیے"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' کو {2} اور {3} کے درمیان ہونا چاہیے"

msgid "'%s' must be true or false"
msgstr "'{1}' کو true یا false ہونا چاہیے"

msgid "'%s' must not be empty"
msgstr "'{1}' خالی نہیں ہونا چاہیے"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' کسی ٹرانسفارم کا نام نہیں لیتا (خلاصہ خاصیت 8): پیچ نہیں"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' فولڈر سے شروع ہوتا ہے: \"$(ProgramFiles)/Example\"، \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' میں {4} ہے؛ کچھ نہیں نکالا گیا"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} اندراجات، حد {3} سے زیادہ (--limit-entries)؛ کچھ نہیں نکالا گیا"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' اور '{3}' Windows پر ایک ہی راستہ ہوتے؛ کچھ نہیں نکالا گیا"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' [ui] languages میں نہیں"

msgid "'%s': a table cannot be read"
msgstr "'{1}': ایک جدول نہیں پڑھا جا سکتا"

msgid "'%s': a table is unreadable"
msgstr "'{1}': ایک جدول ناقابلِ مطالعہ ہے"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX اپنی تمام فائلیں انسٹال کرتا ہے (when)؛ msi-only = true استعمال کریں"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX اپنی تمام فائلیں ہٹاتا ہے (keep)؛ msi-only = true استعمال کریں"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' خراب ہے یا stored/MSZIP نہیں"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet نام '{2}' سادہ فائل نام نہیں"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': کمپریسڈ فائل '{2}' (ترتیب {3}) کا کوئی cabinet نہیں"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': ڈائریکٹری '{2}' کا ایک والد '{3}' ہے جو موجود نہیں"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': ڈائریکٹری '{2}' اپنا ہی جدِ امجد ہے یا بہت گہرائی میں ہے"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': فائل '{2}' اپنے MsiFileHash سے میل نہیں کھاتی"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': فائل '{2}' کا کوئی جزو یا ڈائریکٹری نہیں"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': فائل '{2}' {3} بائٹس ہے، File جدول {4} کہتا ہے"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': فائل '{2}' cabinet '{3}' میں نہیں"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': اس کے بیرونی cabinets دستخط میں شامل نہیں (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': اس کا فولڈر کسی معلوم مقام تک نہیں جاتا"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': لکھنے کے لیے {2} بائٹس سے زیادہ (--limit-bytes)؛ کچھ نہیں نکالا گیا"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': --timestamp نہیں: سرٹیفکیٹ کی میعاد ختم ہونے پر دستخط درست نہیں رہتا"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': پیکیج '{2}' اپنے SHA-256 سے میل نہیں کھاتا"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinet اسٹریم '{2}' موجود نہیں"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': مینی فیسٹ میں {2} {3} نہیں"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': مینی فیسٹ '{2}' کا نام لیتا ہے جو پیکیج میں نہیں"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': {2} سے ٹائم اسٹیمپ: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': ٹرانسفارم '{2}' کو '{3}' کے مقابلے میں نہیں پڑھا جا سکتا: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' پیکیج کی اپنی زبان ہے ({2})؛ وہ متن لاحقے کے بغیر دیں"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' سے Windows Installer کثیر اسٹرنگ لکھتا ہے؛ type = \"multi\" اور ایک ترتیب استعمال کریں"

msgid "'_' in numbers is not supported"
msgstr "اعداد میں '_' معاون نہیں"

msgid "'help' takes at most one command name"
msgstr "'help' زیادہ سے زیادہ ایک کمانڈ نام لیتا ہے"

msgid "'version' takes no arguments"
msgstr "'version' کوئی دلائل نہیں لیتا"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs .msi کے لیے ہے"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "بنڈل کے لیے --arch: x64، x86 اور arm64 کی فہرست، ہر ایک ایک بار ('{1}' ملا)"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch ایک آرکیٹیکچر، یا .msixbundle / .msixupload آؤٹ پٹ کے لیے فہرست لیتا ہے"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert، --pass-env، --pass-file، --timestamp اور --allow-unsigned-cabs --key کے ساتھ آتے ہیں"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress .msi کے لیے ہے؛ MSIX --msix-compress deflate|store لیتا ہے"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist سورس کے ساتھ ایک نئے فولڈر کا نام لیتا ہے (بغیر راستے)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat ‏.msixbundle آؤٹ پٹ کے لیے ہے (اس کے پیکیج اس کے ساتھ لکھے جاتے ہیں)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs 1 سے 64 تک کا عدد لیتا ہے ('{1}' ملا)"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store ایک Windows سرٹیفکیٹ اسٹور ہے؛ دوسری جگہ کلید فائل یا --pkcs11 استعمال کریں"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store سرٹیفکیٹ کا SHA-1 تھمب پرنٹ لیتا ہے (40 ہیکس ہندسے)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: ایسی کوئی زبان نہیں (بلٹ اِن: {2}؛ کسی اور کو اپنا زبان پیک چاہیے، {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (یا RUBRAPACK_LANG) ان متنوں کی زبان منتخب کرتا ہے: {1}، یا کوئی ایسی زبان جس کا زبان پیک ہو۔\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang کو زبان چاہیے، جیسے en یا ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages کو ڈائیلاگز چاہییں: --ui بھی دیں"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress deflate یا store لیتا ہے ('{1}' ملا)"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: متغیر سیٹ نہیں"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code بڑے حروف اور بریسز کے ساتھ GUID لیتا ہے: {{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: متغیر سیٹ نہیں"

msgid "--previous compares two .msi packages"
msgstr "--previous دو .msi پیکیجز کا موازنہ کرتا ہے"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: آپریٹنگ سسٹم کے روٹ سرٹیفکیٹ نہیں پڑھے جا سکتے"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} آؤٹ پٹ '{2}' سے میل نہیں کھاتا"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} نافذ نہیں (msi یا msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target msi یا msix لیتا ہے ('{1}' ملا)"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust، --tls-trust، --system-roots اور --proxy --timestamp کے ساتھ آتے ہیں"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test اور --msix-compress .msix آؤٹ پٹس کے لیے ہیں"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test بغیر دستخط پیکیجز کے لیے ہے؛ --key کے ساتھ اسے چھوڑ دیں"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate none یا product-code,upgrade-code,language,platform میں سے کچھ لیتا ہے"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget ‏.msi، .msix یا .msixbundle آؤٹ پٹ کے لیے ہے"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget کو [winget] جدول درکار ہے: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget کو پیکیج ایک فائل میں درکار ہے: winget ایک فائل اتارتا ہے، اس لیے cab = \"external\" نہیں"

msgid "-D %.*s is given twice"
msgstr "-D {1} دو بار دیا گیا ہے"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' ایک Windows نام ہے؛ متغیر کو کوئی اور نام دیں"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D کو NAME=VALUE چاہیے ('{1}' ملا)"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i ہر جواب پوچھتا ہے؛ یا تو -i دیں یا اختیارات"

msgid "; its range is "
msgstr "؛ اس کی حد "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' SecureCustomProperties میں نہیں"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty کو عوامی (بڑے حروف) خاصیت ہونا چاہیے"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "تمام کوڈز: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x PKCX سے شروع نہیں ہوتا"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x آخری اندراج نہیں"

msgid "Architecture (x64, x86, arm64)"
msgstr "آرکیٹیکچر (x64، x86، arm64)"

msgid "Choose"
msgstr "منتخب کریں"

msgid "Command line"
msgstr "کمانڈ لائن"

msgid "Command line (lint)"
msgstr "کمانڈ لائن (lint)"

msgid "Common AppData"
msgstr "مشترکہ AppData"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId رجسٹری فارمیٹ میں GUID نہیں"

msgid "Desktop shortcut?"
msgstr "ڈیسک ٹاپ شارٹ کٹ؟"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "ڈائیلاگز (none، basic، minimal، installdir، features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "اخراج کوڈز: 0 ٹھیک، 1 سورس کی خرابی، 2 استعمال، 3 ان پٹ/آؤٹ پٹ، 4 دستخط یا تصدیق،\n5 lint، 6 نیٹ ورک۔\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "File، Component یا Directory جدول میں ایک معیاری کالم نہیں"

msgid "Folder name under Program Files"
msgstr "Program Files کے تحت فولڈر کا نام"

msgid "Folder with the files to install"
msgstr "انسٹال ہونے والی فائلوں کا فولڈر"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "ID '{1}' پہلے سے استعمال ہو رہا ہے (لائن {2})؛ IDs تمام جدولوں میں مختلف ہونے چاہییں"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "انسٹال فولڈر ([dir.INSTALLDIR] راستہ)"

msgid "Install for (machine, user, dual)"
msgstr "کس کے لیے انسٹال (machine، user، dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "جدول.کلید کی صورت میں کلید (package.version، dir.INSTALLDIR.path، ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' کسی اور جزو کا ہے"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' File میں نہیں"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' Registry میں نہیں"

msgid "Korean dialogs as well as English?"
msgstr "انگریزی کے ساتھ کوریائی ڈائیلاگز بھی؟"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} کم DiskId والے سے کم ہے"

msgid "Leave without saving the changes?"
msgstr "تبدیلیاں محفوظ کیے بغیر باہر نکلیں؟"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "قبول کرنے والا لائسنس (.txt، .md، .rtf؛ کوئی نہیں کے لیے -)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "MSIX میں صارف کے AppData کے لیے کوئی ورچوئل فولڈر نہیں؛ ایپ چلتے وقت وہاں ضرورت کی چیزیں بناتی ہے"

msgid "MSIX packages"
msgstr "MSIX پیکیجز"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: MSIX پیکیج کو کیا چاہیے، اور وہ کیا نہیں لے جا سکتا"

msgid "Main program, for shortcuts (- for none)"
msgstr "مرکزی پروگرام، شارٹ کٹس کے لیے (کوئی نہیں کے لیے -)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "دستی: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "بنانے والا"

msgid "Manufacturer (shown in Installed apps)"
msgstr "بنانے والا (انسٹال شدہ ایپس میں دکھایا جاتا ہے)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt نے غلط لمبائی کا ECDSA دستخط لوٹایا"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "اختیاری حصے جن پر صارف نشان لگا سکے (ذیلی فولڈرز، کاموں سے؛ کوئی نہیں کے لیے -)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "PKCS#11 ٹوکن: ٹوکن میں کلید کے CKA_ID والا کوئی سرٹیفکیٹ نہیں (اسے --cert سے دیں)"

msgid "Paths"
msgstr "راستے"

msgid "Product name"
msgstr "پروڈکٹ کا نام"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode اور UpgradeCode ایک ہی GUID ہیں"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} پہلے تین حصوں میں پچھلے {2} سے زیادہ نہیں: Windows Installer اپ گریڈ نہیں کرتا"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "پروگرام جسے شارٹ کٹس کھولتے ہیں (بغیر شارٹ کٹس کے لیے -)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: ایسی کوئی زبان نہیں (بلٹ اِن: {2}؛ کسی اور کو اپنا زبان پیک چاہیے، {3}.po)"

msgid "Reference, "
msgstr "حوالہ، "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "ترتیب {1} کسی Media قطار میں شامل نہیں (آخری {2})"

msgid "Sequence %ld is used by another file"
msgstr "ترتیب {1} کسی اور فائل نے استعمال کی ہے"

msgid "Source file to write"
msgstr "لکھنے کے لیے سورس فائل"

msgid "Source format"
msgstr "سورس فارمیٹ"

msgid "Source must name a File row for type %ld"
msgstr "Source کو قسم {1} کے لیے File قطار کا نام لینا چاہیے"

msgid "Start menu shortcut?"
msgstr "اسٹارٹ مینو شارٹ کٹ؟"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "اسٹارٹ مینو، پروگرامز، ڈیسک ٹاپ اور اسٹارٹ اپ اندراجات [shortcut.*] اور [msix-extension.*] سے آتے ہیں"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "rubrapack کے پڑھے جانے والے ذیلی سیٹ سے باہر TOML، یا `format` موجود نہیں یا بہت نیا ہے"

msgid "Tables"
msgstr "جدول"

msgid "The TOML subset"
msgstr "TOML ذیلی سیٹ"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "UTF-16 big-endian فائلیں معاون نہیں؛ UTF-8 کے طور پر محفوظ کریں"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} پچھلے ورژن کے {2} سے مختلف ہے: یہ پیکیج اس کی جگہ نہیں لیتا"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode رجسٹری فارمیٹ میں GUID نہیں"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "قدر (متن، عدد، true/false، [\"a\", \"b\"]؛ - کلید ہٹا دیتا ہے)"

msgid "Variables"
msgstr "متغیرات"

msgid "Version"
msgstr "ورژن"

msgid "Version ([define] VERSION)"
msgstr "ورژن ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "ورژنز اور اپ گریڈز"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer زیادہ سے زیادہ 255.255.65535(.65535) کی اجازت دیتا ہے"

msgid "Windows name"
msgstr "Windows نام"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] کو '{4}' چاہیے"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] مرج ماڈیول میں نہیں جا سکتا؛ اسے ضم کرنے والا پیکیج رکھتا ہے"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] ابھی معاون نہیں ({3} کے لیے منصوبہ ہے)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] MSIX میں نہیں جا سکتا؛ اس کے بغیر MSIX بنانے کے لیے msi-only = true شامل کریں"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] صارف کے AppData یا LocalAppData میں ہے: تمام صارفین کے لیے انسٹال کیا گیا dual پیکیج اسے صرف انسٹال کرنے والے صارف کی پروفائل میں رکھتا ہے"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: مرج ماڈیول میں ID زیادہ سے زیادہ 35 حروف کا ہوتا ہے (اس میں ماڈیول کا GUID شامل کیا جاتا ہے)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] کو ایک ID چاہیے: [{2}.ID] لکھیں"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] کوئی ID نہیں لیتا: [{2}] لکھیں"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml میں </Types> نہیں"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml آخری اندراج نہیں (ایسا پیکیج نہیں جو rubrapack یا Windows کی پیکیجنگ API نے لکھا ہو)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "[[...]] جدولوں کی ترتیبیں معاون نہیں؛ ہر آئٹم کو اپنا [kind.ID] دیں"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] ایک بار رکھا جاتا ہے: before، after یا sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] کو do اور undo دونوں چاہییں (undo ناکام do کو بھی واپس لیتا ہے)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] کو entry چاہیے: بلائے جانے والا DLL فنکشن"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] کو run = \"file:<ID>\" چاہیے: وہ پروگرام جسے do اور undo چلاتے ہیں"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] ایک چیز چلاتا ہے: run (ایک exe)، dll (انسٹال شدہ DLL) یا binary (پیکج میں موجود DLL)؛ یا do اور undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} ایک عمل کے لیے ہے، do/undo جوڑے کے لیے نہیں"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: انسٹال شدہ فائل چلانے والا مؤخر عمل InstallFiles کے بعد ہونا چاہیے (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: فوری عمل انسٹال کرنے والے صارف کے طور پر چلتا ہے؛ as دوسرے مراحل کے لیے ہے"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args پروگرام کے ہیں؛ DLL data لیتی ہے"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check do/undo جوڑے کے ساتھ جاتا ہے"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data مؤخر، commit یا rollback عمل کے لیے ہے (فوری عمل خصوصیات پڑھتا ہے)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry ایک DLL کا فنکشن ہے؛ run args لیتا ہے"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: MSIX کے لیے args سادہ متن ہونے چاہییں (انسٹال پر بھرا جانے والا [...] نہیں)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: MSIX میں فائل کی قسم ایک ایپ کھولتی ہے: target کو [msix-app.*] ایگزیکیوٹیبل ہونا چاہیے"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] دو بار موجود ہے"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] کو ایک ID چاہیے: [chain-package.ID] لکھیں"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id اور typelib صرف MSI کے لیے لکھے جاتے ہیں؛ MSIX کلاس کو ان کے بغیر رجسٹر کرتا ہے"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args پروگرام کے ہیں؛ DLL لوڈ کی جاتی ہے، شروع نہیں کی جاتی"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate ایک DLL کو dllhost میں چلاتا ہے؛ '{2}' ایک پروگرام ہے"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading DLL کے لیے ہے؛ پروگرام اپنا اپارٹمنٹ خود طے کرتا ہے"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version اور typelib-file کو typelib چاہیے"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] {2} میں جاتا ہے؛ یا msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: اس کا سورس ایسی فائل ہونی چاہیے جو پیکیج میں جائے"

msgid "[define] values must be strings"
msgstr "[define] کی قدریں اسٹرنگز ہونی چاہییں"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] کو '{2}' چاہیے"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] کو image درکار ہے"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] کو 'property' چاہیے"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] کو 'text' چاہیے"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] کو 'values' چاہیے"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] میں {2} کنٹرولز ہیں؛ زیادہ سے زیادہ 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] میں کوئی [dialog-control.*] نہیں"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] دوسرے ڈائیلاگز کے ذریعے اپنے ہی بعد رکھا گیا ہے"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] کو ui = \"minimal\"، \"installdir\" یا \"features\" چاہیے"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' ایک Windows نام ہے؛ dir کو کوئی اور ID دیں"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard کو rubrapack کی مددگار DLL چاہیے، جو مرج ماڈیول ساتھ نہیں رکھتا"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] کو ایک خصوصیت چاہیے"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX اپنے تمام متغیرات سیٹ کرتا ہے (when)؛ msi-only = true استعمال کریں"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: اس کی قدر ایسی جگہ کا نام لیتی ہے جو MSIX نہیں دے سکتا (پیکیج سے باہر کا فولڈر جو Windows فولڈر نہیں، یا انسٹال کے وقت کا حصہ)؛ msi-only = true استعمال کریں"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: external-location = true کے ساتھ پیکیج میں پروگرام کی کوئی فائل نہیں ہوتی، اس لیے rubrapack کا لانچر بھی نہیں؛ یا msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] پہلے ہی اپنے پروگرام کے فولڈر میں ہے؛ isolate-for کسی اور جگہ انسٹال ہونے والی مشترکہ DLL کے لیے ہے"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] صارف کی پروفائل میں ہے اور اس میں component-guid ہے: اس کا کلیدی راستہ فائل ہی رہتا ہے، جبکہ Windows کے اصول وہاں HKCU قدر چاہتے ہیں (ICE38)؛ وہ پانے کے لیے component-guid ہٹا دیں"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer {2} ہینڈلر DLL سے لوڈ کرتا ہے؛ [com.{3}] ایک پروگرام ہے"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows پراپرٹی ہینڈلرز صرف مشین کی سطح پر پڑھتا ہے؛ پیکیج کو scope = \"machine\" چاہیے"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: پیش منظر ہینڈلر Windows کے prevhost میں چلتا ہے؛ app-id اور surrogate کو [com.{2}] سے نکال دیں"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX صرف تھمب نیل اور پیش منظر ہینڈلرز رکھتا ہے (پیکیجڈ پراپرٹی ہینڈلر نے Explorer کو قدریں نہیں دیں)؛ msi-only = true اسے MSI کے لیے رکھتا ہے"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: MSIX فائل کی قسم کسی ایپ کی ہوتی ہے؛ ایک [msix-app.*] شامل کریں"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: کلاس {2} اس پیکیج کا [com.*] نہیں (ہینڈلر کی DLL اسے فراہم کرتی ہے)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX میں ہینڈلرز اپنی تمام اقسام مشترک رکھتے ہیں یا کوئی نہیں (ایک قسم ایک فائل ٹائپ ایسوسی ایشن میں ہوتی ہے)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX میں اس کی کلاس سروگیٹ میں چلتی ہے؛ [com.{2}] میں threading = \"sta\" اس کی ونڈو کو میسج لوپ دیتا ہے (threading = {3} کے ساتھ پیش منظر خالی رہ سکتا ہے)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX میں اس کی تمام اقسام ایک [assoc] فائل ٹائپ میں ہیں، یا کوئی نہیں"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: اس کی کلاس صرف MSI ہے ([com.{2}])؛ MSIX میں اس کے لیے کوئی سرور نہیں ہوگا"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types فائل اقسام کی فہرست ہے، جیسے [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2} میں جاتا ہے؛ یا msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] کو 'value' چاہیے"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] کو ایک خصوصیت چاہیے: 'feature' یہاں یا اس کے dir پر سیٹ کریں"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX اپنے تمام INI اندراجات لکھتا ہے (when)؛ msi-only = true استعمال کریں"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: اس کی قدر میں ایسا حصہ ہے جو Windows Installer انسٹال کے وقت بھرتا ہے ([...])؛ MSIX فائل کو بنتے وقت لکھتا ہے"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] کو 'on' چاہیے: جہاں آئٹم دکھتا ہے، جیسے [\".txt\"] یا \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] کو 'target' (وہ پروگرام جو یہ شروع کرے) یا parent = \"{2}\" والے آئٹمز (ذیلی مینو) چاہییں"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] کو 'target' چاہیے: وہ پروگرام جو آئٹم شروع کرتا ہے"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 کا مینو صرف حروف اور ہندسوں والا ID لیتا ہے ('_' نہیں): نام بدلیں، یا windows11 = false کریں"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: ذیلی مینو کچھ شروع نہیں کرتا: 'args' نکال دیں"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: ذیلی مینو کا آئٹم وہیں دکھتا ہے جہاں اس کا ذیلی مینو دکھتا ہے: 'on' نکال دیں"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args میں ایسا حصہ ہے جو Windows Installer انسٹال کے وقت بھرتا ہے ([...])؛ MSIX صرف مقررہ متن رکھتا ہے"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when، \"HKCU\\\\key\\\\value\" یا \"HKLM\\\\...\" ہوتا ہے، Windows 11 مینو کے ایسے آئٹم پر جو ذیلی مینو میں نہ ہو"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when ایسی قدر بتاتا ہے جو یہ پیکج خود لکھتا ہے ([registry.{2}]): آئٹم کبھی نہیں دکھے گا"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: اس کا پروگرام MSIX میں نہیں (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: اس کی قدریں پیکیج کی رجسٹری میں نہیں جا سکتیں"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list میں ایسا حصہ ہے جو Windows Installer انسٹال کے وقت بھرتا ہے ([...])؛ MSIX صرف مقررہ متن رکھتا ہے"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: جب راستے ایک کمانڈ لائن میں نہ سمائیں تو list، {2} کی جگہ لیتا ہے: multi = \"one\"، args میں {3} اور list میں {4} (فہرست فائل) چاہیے"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": کوئی [assoc.{3}] نہیں"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on ایک فائل کی قسم یا ان کی فہرست ہے، جیسے [\".txt\"، \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: والد '{2}' کوئی [menu.*] نہیں"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: والد '{2}' کو ذیلی مینو ہونا چاہیے: target کے بغیر اور اپنے والد کے بغیر ایک [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2} میں جاتا ہے؛ یا msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] کو ایک خصوصیت چاہیے: 'feature' یہاں یا اس کے dir پر سیٹ کریں"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}؛ یا msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] کو feature چاہیے (یا with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature اپنے جزو کے ساتھ جاتا ہے، with کے ساتھ نہیں"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name ایک فائل بتاتا ہے؛ name میں وائلڈ کارڈ ہیں"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: شیئر ہدف کو types، formats یا دونوں چاہییں"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: آٹو پلے ہینڈلر کو content-events، device-events یا دونوں چاہییں"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args سادہ متن ہونے چاہییں (انسٹال پر بھرا جانے والا [...] نہیں)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events کو class چاہیے (پروگرام کی IHWEventHandler COM کلاس)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file کو {2} ہونا چاہیے"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file کو ایسی فائل کا نام لینا چاہیے جو پیکیج میں جائے"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file کو ایسے پروگرام کا نام لینا چاہیے جو پیکیج میں جائے"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types فائل اقسام کی فہرست ہے، جیسے [\".txt\"، \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows صرف حروف اور ہندسے لیتا ہے"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64 کے لیے [msix-psf] کو launcher = \"...\" درکار ہے (PSF اپنے لانچرز کو PsfLauncher32.exe, PsfLauncher64.exe کہتا ہے)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] نہ external-location = true کے ساتھ چلتا ہے نہ [env.*] (rubrapack کے اپنے لانچر) کے ساتھ"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] ایپلیکیشنز کو PSF لانچر سے شروع کرتا ہے: اسے [msix-app.ID] درکار ہے"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' اپنی \"applications\" میں ایپلیکیشن '{2}' کا نام نہیں لیتا"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files میں '{1}' (لانچر) نہیں ہے"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: فائل '{2}' DLL نہیں ہے"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] اپنا ڈرائیور ایک بار بتاتا ہے: driver (ایک [odbc-driver]) یا driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] کو driver-name کے ساتھ with = \"file:<ID>\" چاہیے: وہ جزو جس کے ساتھ یہ انسٹال ہوتا ہے"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: فی کمپیوٹر پیکج ڈیٹا ذرائع کو کمپیوٹر کے لیے رجسٹر کرتا ہے"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] ایک کاپی بتاتا ہے: msix (publisher کے ساتھ) یا upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix پیکج کا شناختی نام ہے (3 سے 50 حروف، ہندسے، '.' یا '-') اور اسے publisher (\"CN=...\") چاہیے، جیسا اس کے مینی فیسٹ میں ہے"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: دوسری کاپی پیشگی جانچ ڈھونڈتی ہے: preflight = true چاہیے"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code اسی پیکج کا ہے (وہ اپ گریڈ ہے، دوسری کاپی نہیں)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] کے لیے اس کے dir کی خصوصیت ہونی چاہیے"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX کے لیے args سادہ متن ہونے چاہییں (انسٹال پر بھرا جانے والا [...] نہیں)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX میں اسکیم ایک ایپ کھولتی ہے: target کو [msix-app.*] ایگزیکیوٹیبل ہونا چاہیے"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] کو 'value' چاہیے (یا remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR MSIX سے باہر نہیں پہنچتا؛ [assoc.*]، [protocol.*]، [com.*] یا [handler.*]، یا msi-only = true استعمال کریں"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword قدر کو rubrapack کی مددگار DLL چاہیے، جو مرج ماڈیول ساتھ نہیں رکھتا"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX صرف {2}\\Software کے تحت قدریں رکھتا ہے"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX نہ قدریں ہٹاتا ہے اور نہ پیچھے چھوڑتا ہے (remove، keep)؛ msi-only = true استعمال کریں"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX اپنی تمام قدریں لکھتا ہے (when)؛ msi-only = true استعمال کریں"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: اس کی قدر میں ایسا حصہ ہے جو Windows Installer انسٹال کے وقت بھرتا ہے ([...])؛ MSIX صرف مقررہ قدریں رکھتا ہے"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" کو rubrapack کی مددگار DLL چاہیے، جو مرج ماڈیول ساتھ نہیں رکھتا"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: کلید یا قدر کا نام رجسٹری ہائیو میں نہیں جا سکتا"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" کمپیوٹر کی سطح کے پیکج میں on = \"uninstall\" کے ساتھ root = \"HKCU\" کے لیے ہے"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] کو ایک خصوصیت چاہیے: 'feature' یہاں یا اس کے dir پر سیٹ کریں"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true {2} کے تحت فولڈر کے لیے نہیں"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true کو rubrapack کی مددگار DLL چاہیے، جو مرج ماڈیول ساتھ نہیں رکھتا"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" کمپیوٹر کی سطح کے پیکج میں AppData یا LocalAppData کے فولڈر پر recursive = true کے لیے ہے"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX کے لیے args سادہ متن ہونے چاہییں (انسٹال پر بھرا جانے والا [...] نہیں)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file کو ایسے پروگرام کا نام لینا چاہیے جو پیکیج میں جائے"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] خصوصیت '{2}' کی تشہیر کرتا ہے، جس میں advertise = \"disallow\" ہے"

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise کو when کے ساتھ نہیں ملایا جاتا"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX کے شارٹ کٹس صرف ڈیسک ٹاپ اور اسٹارٹ مینو میں ہوتے ہیں{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX شارٹ کٹ کا کوئی working-dir نہیں"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX شارٹ کٹ ہمیشہ موجود ہوتا ہے (when MSI کے لیے ہے)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX شارٹ کٹ اپنی ایپ کا لوگو دکھاتا ہے؛ icon MSI کے لیے ہے"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: ایک مشتہر شارٹ کٹ MSI کے لیے ہے (MSIX پورا پیکج انسٹال کرتا ہے)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: ایک مشتہر شارٹ کٹ کو ایک آئیکن درکار ہے"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX کے لیے args سادہ متن ہونے چاہییں (انسٹال پر بھرا جانے والا [...] نہیں)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX میں شارٹ کٹ ایک ایپ شروع کرتا ہے: target کو [msix-app.*] ایگزیکیوٹیبل ہونا چاہیے"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX کا اسٹارٹ مینو اندراج اس کی ایپ ہے، جو args نہیں لیتی"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: کسی ڈائیلاگ متن کا یہ ID نہیں"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "‏[ui] embedded ایک MSI کے لیے ہے؛ MSIX کا اپنا انسٹالر UI نہیں ہوتا"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "‏[ui] کو [package] میں ui = \"basic\" یا کسی اور ڈائیلاگ سیٹ کی ضرورت ہے (یا embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} ایسکیپ یونی کوڈ اسکیلر قدر نہیں"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: یہ پیکیج پچھلے کو صاف طریقے سے اپ گریڈ نہیں کرے گا"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "پیکیج کا `lint`: ڈائیلاگز، کوڈ پیج، متن کی نارملائزیشن"

msgid "`lint` of an MSIX package or bundle"
msgstr "MSIX پیکیج یا بنڈل کا `lint`"

msgid "a %s control has no property"
msgstr "{1} کنٹرول میں property نہیں ہے"

msgid "a %s control has no text; put a text control beside it"
msgstr "{1} کنٹرول کا کوئی متن نہیں؛ اس کے ساتھ ایک متن کنٹرول رکھیں"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "{1} کنٹرول کو [property.{2}] چاہیے جس کی ایک قدر ڈیفالٹ ہو (خاموش انسٹالیشن اسے استعمال کرتی ہے)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "{1} پیکیج HKLM میں نہیں لکھ سکتا؛ HKMU استعمال کریں"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr ".msix آؤٹ پٹ کو ایک [msix-app.ID] جدول چاہیے جو ایگزیکیوٹیبل کا نام لے"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr ".msix آؤٹ پٹ کو [msix] جدول چاہیے (identity-name، publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr ".msm آؤٹ پٹ ایک مرج ماڈیول ہے، جو [package] کی بجائے [module] والے سورس سے بنتا ہے"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "ایک .txt، .md یا .rtf فائل، یا کوئی نہیں کے لیے -"

msgid "a PE file without a certificate table entry"
msgstr "سرٹیفکیٹ جدول اندراج کے بغیر PE فائل"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN کبھی کمانڈ لائن سے نہیں لیا جاتا (دوسرے اسے دیکھ سکتے ہیں)؛ --pin-env یا --pin-file استعمال کریں"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "بنڈل مینی فیسٹ کا ایک Package نامعلوم Type کے ساتھ"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "بنڈل مینی فیسٹ کا ایک Package بغیر FileName، Offset یا Size کے"

msgid "a ZIP entry does not inflate to its size"
msgstr "ایک ZIP اندراج اپنے سائز تک نہیں کھلتا"

msgid "a ZIP entry larger than allowed"
msgstr "اجازت سے بڑا ZIP اندراج"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "ایک ZIP اندراج کا CRC-32 میل نہیں کھاتا"

msgid "a ZIP entry's data lies outside the file"
msgstr "ایک ZIP اندراج کا ڈیٹا فائل سے باہر ہے"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "[module] سورس مرج ماڈیول بناتا ہے: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "بائنری قدر جفت تعداد میں ہیکس ہندسے ہوتی ہے، جیسے \"01A0FF\""

msgid "a bundle without packages"
msgstr "بغیر پیکیجز کا بنڈل"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "راستے کے ایک سرٹیفکیٹ میں ایسی اہم توسیع ہے جو rubrapack نہیں سمجھتا"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "راستے کا ایک سرٹیفکیٹ ایسے سرٹیفکیٹ سے دستخط شدہ ہے جو CA نہیں"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "چین میں صرف [chain]، [chain-package.ID] اور [define] ہوتے ہیں، [{1}] نہیں؛ پیکیجز اپنے سورسز سے بنتے ہیں"

msgid "a chain holds at most %d packages"
msgstr "چین میں زیادہ سے زیادہ {1} پیکیجز ہوتے ہیں"

msgid "a chain needs [chain]"
msgstr "چین کو [chain] چاہیے"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "چین کو کم از کم ایک [chain-package.ID] چاہیے"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "ایسا حرف جس کی Windows نام میں اجازت نہیں دیتا (/ \\ : * ? \" < > |)"

msgid "a control character"
msgstr "ایک کنٹرول حرف"

msgid "a damaged PE optional header"
msgstr "خراب PE اختیاری ہیڈر"

msgid "a damaged PE section table"
msgstr "خراب PE سیکشن جدول"

msgid "a damaged ZIP64 end record"
msgstr "خراب ZIP64 اختتامی ریکارڈ"

msgid "a damaged hive bin"
msgstr "خراب ہائیو bin"

msgid "a diagnostic of rubrapack"
msgstr "rubrapack کی ایک تشخیص"

msgid "a disabled service cannot be started"
msgstr "غیر فعال سروس شروع نہیں ہو سکتی"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "dual پیکیج صارف اور سسٹم متغیر کے درمیان انتخاب نہیں کر سکتا"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "dual پیکیج HKMU میں لکھتا ہے (انسٹال کے مطابق HKLM یا HKCU)، HKCU میں نہیں"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "dword قدر 0..4294967295 کا عدد صحیح ہے (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "ایسی خصوصیت جو یہ rubrapack فراہم نہیں کرتا (یا اس کے بغیر بنایا گیا)"

msgid "a file larger than allowed"
msgstr "اجازت سے بڑی فائل"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
