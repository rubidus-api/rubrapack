msgstr "'format = {1}' لائن نہیں: rubrapack 0.18 یا پرانے فارمیٹ کا سورس، جو یہ ورژن نہیں پڑھتا (اب راستے $(ProgramFiles) یا $(INSTALLDIR) سے شروع ہوتے ہیں)؛ دستی میں سورس فارمیٹ دیکھیں"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "--trust نہیں دیا گیا: دستخط تصدیق ہوتا ہے لیکن کچھ نہیں بتاتا کہ کس پر اعتماد کیا جائے"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "کلید فائل (یا --cert فائل) میں کوئی سرٹیفکیٹ کلید کا نہیں"

msgid "no control characters"
msgstr "بغیر کنٹرول حروف کے"

msgid "no keys\n"
msgstr "کوئی کلید نہیں\n"

msgid "no main program, so no shortcuts: none"
msgstr "کوئی مرکزی پروگرام نہیں، اس لیے کوئی شارٹ کٹ نہیں: کوئی نہیں"

msgid "no server name, or one longer than 255 bytes"
msgstr "سرور کا نام نہیں، یا 255 بائٹس سے لمبا ہے"

msgid "no string pool: not a transform"
msgstr "اسٹرنگ پول نہیں: ٹرانسفارم نہیں"

msgid "no table '%s' in '%s'"
msgstr "'{2}' میں '{1}' جدول نہیں"

msgid "no-remove leaves Modify (its Remove) as the only way to remove the product: it cannot go with no-modify"
msgstr "no-remove تبدیل کریں (اس کا ہٹائیں) کو پروڈکٹ ہٹانے کا واحد راستہ چھوڑتا ہے: یہ no-modify کے ساتھ نہیں چل سکتا"

msgid "not a PE file (no MZ header)"
msgstr "PE فائل نہیں (MZ ہیڈر نہیں)"

msgid "not a PE file (no PE header)"
msgstr "PE فائل نہیں (PE ہیڈر نہیں)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "PEM، PKCS#8 یا PKCS#12 فائل نہیں"

msgid "not a ZIP archive (no end record)"
msgstr "ZIP آرکائیو نہیں (اختتامی ریکارڈ نہیں)"

msgid "not a ZIP archive (too short)"
msgstr "ZIP آرکائیو نہیں (بہت چھوٹا)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "ایسا پراکسی URL نہیں جو rubrapack قبول کرے (http://host:port)"

msgid "not a registry hive"
msgstr "رجسٹری ہائیو نہیں"

msgid "not a valid number"
msgstr "درست عدد نہیں"

msgid "not a value"
msgstr "قدر نہیں"

msgid "not a value (strings need quotes)"
msgstr "قدر نہیں (اسٹرنگز کو کوٹس چاہییں)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "ایسا http:// یا https:// URL نہیں جو rubrapack قبول کرے"

msgid "not valid UTF-8"
msgstr "درست UTF-8 نہیں"

msgid "not-checked (give --trust or --system-roots)"
msgstr "جانچ نہیں ہوئی (--trust یا --system-roots دیں)"

msgid "not-present"
msgstr "موجود نہیں"

msgid "nothing changed\n"
msgstr "کچھ تبدیل نہیں ہوا\n"

msgid "number out of range"
msgstr "عدد حد سے باہر ہے"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "آکٹل اور بائنری اعداد معاون نہیں؛ اعشاری یا 0x استعمال کریں"

msgid "on = \"uninstall\" is for HKLM, HKCU and HKMU (classes go with [assoc.*], [com.*] and the like)"
msgstr "on = \"uninstall\" HKLM، HKCU اور HKMU کے لیے ہے (کلاسز [assoc.*]، [com.*] وغیرہ کے ساتھ جاتی ہیں)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "on = \"uninstall\" کلید کو اس کے نیچے کی ہر چیز کے ساتھ ہٹاتا ہے: '{1}' Software کے تحت کسی پروڈکٹ کی اپنی کلید نہیں"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" ہٹاتے وقت پوری کلید ہٹاتا ہے؛ یہ '{1}' نہیں لیتا"

msgid "on Windows `keys list` shows the certificate store"
msgstr "Windows پر `keys list` سرٹیفکیٹ اسٹور دکھاتا ہے"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "Windows پر ٹوکن سرٹیفکیٹ اسٹور کے ذریعے استعمال ہوتا ہے (--key-store <تھمب پرنٹ>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "on remove = true کے لیے ہے (جب کلید ہٹائی جاتی ہے)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "on کو \"install\" یا \"uninstall\" ہونا چاہیے"

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "on کو \"install\"، \"uninstall\" یا \"both\" ہونا چاہیے"

msgid "on: each is a file type ('.' and lower-case letters, digits, '_' or '-'), \"*\" (every file), \"folder\", \"background\" (the empty part of a folder), \"drive\" or \"assoc:<ID>\" (got '%s')"
msgstr "on: ہر ایک فائل کی قسم ہے ('.' اور چھوٹے حروف، ہندسے، '_' یا '-')، \"*\" (ہر فائل)، \"folder\"، \"background\" (فولڈر کا خالی حصہ)، \"drive\" یا \"assoc:<ID>\" ('{1}' ملا)"

msgid "only a bitmap control takes an image"
msgstr "صرف ایک bitmap کنٹرول image لیتا ہے"

msgid "only radio, combo and listbox controls take labels"
msgstr "صرف radio، combo اور listbox کنٹرول labels لیتے ہیں"

msgid "only radio, combo and listbox controls take values"
msgstr "صرف radio، combo اور listbox کنٹرول values لیتے ہیں"

msgid "out of memory"
msgstr "میموری ختم ہو گئی"

msgid "output '%s': rubrapack writes .msi, .msm, .msix, .msixbundle, .msixupload and a chain's setup .exe"
msgstr "آؤٹ پٹ '{1}': rubrapack .msi، .msm، .msix، .msixbundle، .msixupload اور چین کا سیٹ اپ .exe لکھتا ہے"

msgid "package '%s' %s"
msgstr "پیکیج '{1}' {2}"

msgid "package '%s' not found"
msgstr "پیکیج '{1}' نہیں ملا"

msgid "parent must be another product's upgrade-code, not this package's own"
msgstr "parent کو کسی اور پروڈکٹ کا upgrade-code ہونا چاہیے، اس پیکیج کا اپنا نہیں"

msgid "parent must be the main product's upgrade-code, a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "parent کو مرکزی پروڈکٹ کا upgrade-code ہونا چاہیے، {{12345678-1234-1234-1234-123456789ABC} جیسا GUID"

msgid "path must be \"$(Base)/relative/path\" with '/' (Base is a folder such as ProgramFiles, or a dir ID)"
msgstr "path کو '/' کے ساتھ \"$(Base)/نسبتی/راستہ\" ہونا چاہیے (Base ProgramFiles جیسا فولڈر یا dir ID ہے)"

msgid "path must start with a Windows folder (like $(ProgramFiles) or $(System))"
msgstr "path کو Windows فولڈر سے شروع ہونا چاہیے (جیسے $(ProgramFiles) یا $(System))"

msgid "paths"
msgstr "راستے"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "perceived-type کو \"image\"، \"text\"، \"audio\"، \"video\"، \"compressed\"، \"document\"، \"system\" یا \"application\" ہونا چاہیے ('{1}' ملا)"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "اجازتوں کو scope = \"machine\" چاہیے (یہ {1} ہے)"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "phase کو \"immediate\"، \"deferred\"، \"commit\" یا \"rollback\" ہونا چاہیے ('{1}' ملا)"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "ports کو پورٹ یا 1-65535 کے اندر \"8000-8100\" جیسی حد ہونا چاہیے ('{1}' ملا)"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "ایک بے ترتیب GUID، یا وہ جو rubrapack کسی متن سے بناتا ہے، چھاپیں"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "سورسز کا JSON Schema چھاپیں (ایسے ایڈیٹر کے لیے جو کلیدیں مکمل اور جانچتا ہے)"

msgid "print the version"
msgstr "ورژن چھاپیں"

msgid "print this help, or one command's usage"
msgstr "یہ مدد، یا کسی کمانڈ کا استعمال چھاپیں"

msgid "product-code must be a GUID"
msgstr "product-code کو GUID ہونا چاہیے"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile کو \"all\"، \"domain\"، \"private\" یا \"public\" ہونا چاہیے ('{1}' ملا)"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id '{1}' پہلے سے [com.{2}] کا ہے"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id '{1}' [assoc.{2}] کا بھی ہے: فائل کی قسم اور COM کلاس کو دو نام چاہییں"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "prog-id '{1}' [assoc.{2}] میں کسی اور تفصیل، target، icon یا args کے ساتھ بھی ہے"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "prog-id کو حروف، ہندسے، '.'، '_' یا '-' ہونا چاہیے، ہندسے سے شروع نہیں، زیادہ سے زیادہ 39 ('{1}' ملا)"

msgid "property '%s' already belongs to control '%s'"
msgstr "خاصیت '{1}' پہلے سے کنٹرول '{2}' کی ہے"

msgid "property '%s' has the name of a dir or feature"
msgstr "خاصیت '{1}' کا نام کسی dir یا خصوصیت جیسا ہے"

msgid "property '%s' is already defined (line %u)"
msgstr "خاصیت '{1}' پہلے سے بیان ہے (لائن {2})"

msgid "property '%s' is already searched (line %u)"
msgstr "خاصیت '{1}' پہلے سے تلاش ہو رہی ہے (لائن {2})"

msgid "property '%s' is set by rubrapack or the installer and cannot be defined here"
msgstr "خاصیت '{1}' rubrapack یا انسٹالر سیٹ کرتا ہے اور اسے یہاں بیان نہیں کیا جا سکتا"

msgid "property '%s' must be a public name of your own (upper case)"
msgstr "خاصیت '{1}' آپ کا اپنا عوامی نام ہونی چاہیے (بڑے حروف)"

msgid "property '%s' must be a public name: upper-case letters, digits and '_'"
msgstr "خاصیت '{1}' عوامی نام ہونی چاہیے: بڑے حروف، ہندسے اور '_'"

msgid "protocol must be \"tcp\" or \"udp\" (got '%s')"
msgstr "protocol کو \"tcp\" یا \"udp\" ہونا چاہیے ('{1}' ملا)"

msgid "public-folder must be a folder of the package, like \"Public\" (got '%s')"
msgstr "public-folder کو پیکیج کا ایک فولڈر ہونا چاہیے، جیسے \"Public\" ('{1}' ملا)"

msgid "publisher is the package's publisher, such as \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""
msgstr "publisher پیکیج کا ناشر ہے، جیسے \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""

msgid "publisher must be the signing certificate's subject, such as \"CN=Example, O=Example, C=KR\""
msgstr "publisher کو دستخطی سرٹیفکیٹ کا subject ہونا چاہیے، جیسے \"CN=Example, O=Example, C=KR\""

msgid "publisher must not carry the unsigned-test OID; --unsigned-test adds it"
msgstr "publisher میں unsigned-test OID نہیں ہونی چاہیے؛ اسے --unsigned-test شامل کرتا ہے"

msgid "quoted keys are not supported"
msgstr "کوٹس والی کلیدیں معاون نہیں"

msgid "quoted table names are not supported"
msgstr "کوٹس والے جدول نام معاون نہیں"

msgid "reboot must be \"suppress\" or \"allow\""
msgstr "reboot کو \"suppress\" یا \"allow\" ہونا چاہیے"

msgid "recursive = true is for on = \"uninstall\""
msgstr "recursive = true on = \"uninstall\" کے لیے ہے"

msgid "recursive = true never runs when an upgrade removes this version; it takes no 'upgrade'"
msgstr "جب اپ گریڈ یہ ورژن ہٹاتا ہے تو recursive = true کبھی نہیں چلتا؛ یہ 'upgrade' نہیں لیتا"

msgid "recursive = true removes the folder with everything in it; it takes no 'name'"
msgstr "recursive = true فولڈر کو اس کی ہر چیز کے ساتھ ہٹاتا ہے؛ یہ 'name' نہیں لیتا"

msgid "refuse-upgrade-below %s is above this package's version %s"
msgstr "refuse-upgrade-below {1} اس پیکیج کے ورژن {2} سے اوپر ہے"

msgid "refuse-upgrade-below '%s' must be a version like 1.2.3"
msgstr "refuse-upgrade-below '{1}' کو 1.2.3 جیسا ورژن ہونا چاہیے"

msgid "refuse-upgrade-message needs refuse-upgrade-below"
msgstr "refuse-upgrade-message کو refuse-upgrade-below چاہیے"

msgid "region %d of the language page holds %zu languages, at most %d (X-Rubrapack-Group of their packs)"
msgstr "زبان کے صفحے کے علاقے {1} میں {2} زبانیں ہیں، زیادہ سے زیادہ {3} (ان کے پیک کا X-Rubrapack-Group)"

msgid "registration must be \"machine\" or \"user\" (got '%s')"
msgstr "registration کو \"machine\" یا \"user\" ہونا چاہیے ('{1}' ملا)"

msgid "registry '%s' removes a value; it has nothing to protect"
msgstr "رجسٹری '{1}' ایک قدر ہٹاتی ہے؛ اس کے پاس بچانے کو کچھ نہیں"

msgid "registry value '%s' needs a feature"
msgstr "رجسٹری قدر '{1}' کو ایک خصوصیت چاہیے"

msgid "remove = true removes the value at install; it takes no 'value'"
msgstr "remove = true انسٹال پر قدر ہٹاتا ہے؛ یہ 'value' نہیں لیتا"

msgid "remove-addons needs the cleanup task: remove cleanup = false"
msgstr "remove-addons کو صفائی کا کام چاہیے: cleanup = false ہٹائیں"

msgid "replaces holds at most 16 upgrade codes"
msgstr "replaces زیادہ سے زیادہ 16 اپ گریڈ کوڈز رکھتا ہے"

msgid "replaces holds upgrade codes, GUIDs like {12345678-1234-1234-1234-123456789ABC} (got '%s')"
msgstr "replaces اپ گریڈ کوڈز رکھتا ہے، {{12345678-1234-1234-1234-123456789ABC} جیسے GUIDs ('{1}' ملا)"

msgid "replaces is an array of upgrade codes, like [\"{12345678-1234-1234-1234-123456789ABC}\"]"
msgstr "replaces اپ گریڈ کوڈز کی ترتیب ہے، جیسے [\"{{12345678-1234-1234-1234-123456789ABC}\"]"

msgid "replaces lists %s twice"
msgstr "replaces {1} کو دو بار درج کرتا ہے"

msgid "replaces names %s, which is this package's own upgrade-code or its parent"
msgstr "replaces {1} کا نام لیتا ہے، جو اس پیکیج کا اپنا یا اس کے والد کا upgrade-code ہے"

msgid "required property %s is missing"
msgstr "ضروری خاصیت {1} موجود نہیں"

msgid "rollback twin must come before %.*s (%ld <= %ld)"
msgstr "رول بیک جڑواں {1} سے پہلے آنا چاہیے ({2} <= {3})"

msgid "root must be HKLM, HKCR or HKCU"
msgstr "root کو HKLM، HKCR یا HKCU ہونا چاہیے"

msgid "root must be HKLM, HKCU, HKCR or HKMU (got '%s')"
msgstr "root کو HKLM، HKCU، HKCR یا HKMU ہونا چاہیے ('{1}' ملا)"

msgid "rubrapack explain <RPnnnn>: what a diagnostic code means. The codes by range:\n"
msgstr "rubrapack explain <RPnnnn>: تشخیصی کوڈ کا مطلب۔ حد کے لحاظ سے کوڈز:\n"

msgid "rubrapack new: a few questions make the source (Enter takes the value in [ ]).\n"
msgstr "rubrapack new: چند سوال سورس بناتے ہیں (Enter [ ] کے اندر کی قدر لیتا ہے)۔\n"

msgid "run `rubrapack help <command>`; check the paths and that the output folder exists"
msgstr "`rubrapack help <command>` چلائیں؛ راستے اور آؤٹ پٹ فولڈر کی موجودگی جانچیں"

msgid "run: '%s' (machine 0x%04X) cannot run on this package's machines"
msgstr "run: '{1}' (مشین 0x{2}) اس پیکیج کی مشینوں پر نہیں چل سکتا"

msgid "run: '%s' is not a program (.exe)"
msgstr "run: '{1}' پروگرام نہیں (.exe)"

msgid "run: file '%s' is not a [file.*] of this package"
msgstr "run: فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "save the source as UTF-8 (or UTF-16 with a BOM), with LF or CRLF line ends"
msgstr "سورس کو LF یا CRLF لائن اختتام کے ساتھ UTF-8 (یا BOM والی UTF-16) کے طور پر محفوظ کریں"

msgid "scheme '%s' already has a program ([protocol.%s])"
msgstr "اسکیم '{1}' کا پہلے سے پروگرام ہے ([protocol.{2}])"

msgid "scope must be \"machine\", \"user\" or \"dual\""
msgstr "scope کو \"machine\"، \"user\" یا \"dual\" ہونا چاہیے"

msgid "sddl must be an SDDL string like \"D:PAI(A;OICI;FA;;;BA)\""
msgstr "sddl کو \"D:PAI(A;OICI;FA;;;BA)\" جیسی SDDL اسٹرنگ ہونا چاہیے"

msgid "search property '%s' must be a public name of your own (upper case)"
msgstr "تلاش کی خاصیت '{1}' آپ کا اپنا عوامی نام ہونی چاہیے (بڑے حروف)"

msgid "see the message; rebuilding with rubrapack fixes most of these"
msgstr "پیغام دیکھیں؛ rubrapack سے دوبارہ بنانا ان میں سے زیادہ تر ٹھیک کر دیتا ہے"

msgid "sequence %ld is not after %s (%ld)"
msgstr "ترتیب {1} {2} کے بعد نہیں ({3})"

msgid "sequences an action next to one that neither the package nor the module runs"
msgstr "ایک عمل کو ایسے عمل کے ساتھ رکھتا ہے جسے نہ پیکیج چلاتا ہے نہ ماڈیول"

msgid "service name '%s' is already used"
msgstr "سروس نام '{1}' پہلے سے استعمال میں ہے"

msgid "services need scope = \"machine\" (this is %s)"
msgstr "سروسز کو scope = \"machine\" چاہیے (یہ {1} ہے)"

msgid "shortcut name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "شارٹ کٹ نام {1} UTF-16 اکائیاں ہے؛ 8.3 مختصر نام کے ساتھ MSI زیادہ سے زیادہ {2} رکھتا ہے"

msgid "show what differs between two packages: tables, rows, cells and summary"
msgstr "دو پیکیجوں میں فرق دکھاتا ہے: جدولیں، قطاریں، خانے اور خلاصہ"

msgid "sign a PE file, an MSI package, an MSIX package or bundle"
msgstr "PE فائل، MSI پیکیج، MSIX پیکیج یا بنڈل پر دستخط کریں"

msgid "signed %s\n"
msgstr "دستخط ہوا: {1}\n"

msgid "source '%s' is a directory; use [files.ID] for many files"
msgstr "سورس '{1}' ڈائریکٹری ہے؛ بہت سی فائلوں کے لیے [files.ID] استعمال کریں"

msgid "source '%s' is a symbolic link; links are not followed"
msgstr "سورس '{1}' علامتی لنک ہے؛ لنکس کی پیروی نہیں کی جاتی"

msgid "source '%s' is not a regular file"
msgstr "سورس '{1}' عام فائل نہیں"

msgid "source file '%s' changed while the package was being built"
msgstr "سورس فائل '{1}' پیکیج بنتے وقت بدل گئی"

msgid "source file '%s' is larger than 2 GiB"
msgstr "سورس فائل '{1}' 2 GiB سے بڑی ہے"

msgid "source file '%s' not found"
msgstr "سورس فائل '{1}' نہیں ملی"

msgid "source must be \"file:<ID>\""
msgstr "source کو \"file:<ID>\" ہونا چاہیے"

msgid "source must be an .msi package"
msgstr "source کو .msi پیکیج ہونا چاہیے"

msgid "source path '%s' must be relative to the source file"
msgstr "سورس راستہ '{1}' سورس فائل کے لحاظ سے ہونا چاہیے"

msgid "source paths use '/', not '\\\\' (got '%s')"
msgstr "سورس راستے '/' استعمال کرتے ہیں، '\\\\' نہیں ('{1}' ملا)"

msgid "source-format"
msgstr "source-format"

msgid "source: file '%s' is not a [file.*] of this package"
msgstr "source: فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "start must be auto, demand or disabled"
msgstr "start کو auto، demand یا disabled ہونا چاہیے"

msgid "string is not closed on this line"
msgstr "اسٹرنگ اس لائن میں بند نہیں ہوئی"

msgid "string lengths exceed the string data"
msgstr "اسٹرنگز کی لمبائیاں اسٹرنگ ڈیٹا سے زیادہ ہیں"

msgid "summary information cannot be shown as IDT yet"
msgstr "خلاصہ معلومات ابھی IDT کے طور پر نہیں دکھائی جا سکتی"

msgid "summary-name must be ASCII (summary information holds ASCII only)"
msgstr "summary-name کو ASCII ہونا چاہیے (خلاصہ معلومات صرف ASCII رکھتی ہے)"

msgid "symbols is a list of .pdb files, like [\"build/$(ARCH)/app.pdb\"]"
msgstr "symbols ‏.pdb فائلوں کی فہرست ہے، جیسے [\"build/$(ARCH)/app.pdb\"]"

msgid "table %s %s"
msgstr "جدول {1} {2}"

msgid "table '%s' is unreadable"
msgstr "جدول '{1}' ناقابلِ مطالعہ ہے"

msgid "table [%s%s%s] is defined twice (first at line %u)"
msgstr "جدول [{1}{2}{3}] دو بار بیان ہے (پہلی بار لائن {4} پر)"

msgid "table name expected"
msgstr "جدول نام متوقع تھا"

msgid "table names have at most two parts: [kind] or [kind.ID]"
msgstr "جدول ناموں کے زیادہ سے زیادہ دو حصے ہوتے ہیں: [kind] یا [kind.ID]"

msgid "tables"
msgstr "جدول"

msgid "tables and keys: an unknown table or key, a required one missing, an item without a feature once features exist"
msgstr "جدول اور کلیدیں: نامعلوم جدول یا کلید، غائب ضروری کلید، خصوصیات ہونے پر بغیر خصوصیت کا آئٹم"

msgid "tags is a list of at most 16 search terms, like [\"editor\", \"text\"]"
msgstr "tags زیادہ سے زیادہ 16 تلاش کے الفاظ کی فہرست ہے، جیسے [\"editor\", \"text\"]"

msgid "takes no configuration (it has no ModuleConfiguration)"
msgstr "کوئی کنفیگریشن نہیں لیتا (ModuleConfiguration نہیں)"

msgid "target '%s' does not exist"
msgstr "ہدف '{1}' موجود نہیں"

msgid "target must be \"dir:<ID>\", \"file:<ID>\" or \"registry:<ID>\""
msgstr "target کو \"dir:<ID>\"، \"file:<ID>\" یا \"registry:<ID>\" ہونا چاہیے"

msgid "target must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "target کو \"file:<ID>\" ہونا چاہیے جو اس پیکیج کی [file.*] کا نام لے"

msgid "target name '%s' %s"
msgstr "ہدف نام '{1}' {2}"

msgid "target: file '%s' is not a [file.*] of this package"
msgstr "target: فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "task-id '%s' is already used by [msix-extension.%s]"
msgstr "task-id '{1}' پہلے سے [msix-extension.{2}] استعمال کر رہا ہے"

msgid "task-id, display-name and enabled belong to kind = \"startup-task\""
msgstr "task-id، display-name اور enabled kind = \"startup-task\" سے تعلق رکھتے ہیں"

msgid "that file exists already; give another name"
msgstr "وہ فائل پہلے سے موجود ہے؛ کوئی اور نام دیں"

msgid "that folder holds no files"
msgstr "اس فولڈر میں کوئی فائل نہیں"

msgid "the FilesInUse dialog needs a ListBox table, even an empty one (error 2205; the dialog is skipped)"
msgstr "FilesInUse ڈائیلاگ کو ListBox جدول چاہیے، خواہ خالی ہو (خرابی 2205؛ ڈائیلاگ چھوڑ دیا جاتا ہے)"

msgid "the PIN has characters or a length the token does not take"
msgstr "PIN میں ایسے حروف یا لمبائی ہے جو ٹوکن نہیں لیتا"

msgid "the PIN has expired: change it on the token first"
msgstr "PIN کی میعاد ختم ہو گئی: پہلے اسے ٹوکن پر تبدیل کریں"

msgid "the PIN is locked (too many wrong tries)"
msgstr "PIN مقفل ہے (بہت زیادہ غلط کوششیں)"

msgid "the ProductCode is the previous version's: that is a minor upgrade (REINSTALLMODE), not the major upgrade rubrapack builds"
msgstr "ProductCode پچھلے ورژن کا ہے: یہ چھوٹا اپ گریڈ ہے (REINSTALLMODE)، وہ بڑا اپ گریڈ نہیں جو rubrapack بناتا ہے"

msgid "the UTF-16 file is not valid UTF-16"
msgstr "UTF-16 فائل درست UTF-16 نہیں"

msgid "the ZIP central directory lies outside the file"
msgstr "ZIP مرکزی ڈائریکٹری فائل سے باہر ہے"

msgid "the application ID '%s' becomes Application Id: letters and digits only, not starting with a digit"
msgstr "ایپ ID '{1}' Application Id بن جاتا ہے: صرف حروف اور ہندسے، ہندسے سے شروع نہیں"

msgid "the archive does not end in ZIP64 end records as MSIX packages do"
msgstr "آرکائیو MSIX پیکیجز کی طرح ZIP64 اختتامی ریکارڈز پر ختم نہیں ہوتا"

msgid "the archive has no ZIP64 end record"
msgstr "آرکائیو میں ZIP64 اختتامی ریکارڈ نہیں"

msgid "the bundle manifest has no Identity Name, Publisher and Version"
msgstr "بنڈل مینی فیسٹ میں Identity Name، Publisher اور Version نہیں"

msgid "the central directory lies outside the archive"
msgstr "مرکزی ڈائریکٹری آرکائیو سے باہر ہے"

msgid "the certificate has a critical extension rubrapack does not understand"
msgstr "سرٹیفکیٹ میں ایسی اہم توسیع ہے جو rubrapack نہیں سمجھتا"

msgid "the certificate has expired"
msgstr "سرٹیفکیٹ کی میعاد ختم ہو گئی"

msgid "the certificate is a CA certificate, not a signing certificate"
msgstr "سرٹیفکیٹ CA سرٹیفکیٹ ہے، دستخطی سرٹیفکیٹ نہیں"

msgid "the certificate is not for code signing (no code-signing extended key usage)"
msgstr "سرٹیفکیٹ کوڈ پر دستخط کے لیے نہیں (کوڈ سائننگ توسیعی کلید استعمال نہیں)"

msgid "the certificate is not valid yet"
msgstr "سرٹیفکیٹ ابھی درست نہیں"

msgid "the certificate path is longer than 8"
msgstr "سرٹیفکیٹ راستہ 8 سے لمبا ہے"

msgid "the certificate table does not hold an Authenticode signature"
