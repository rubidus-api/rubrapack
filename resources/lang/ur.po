msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] پروگرام [3] کی فائلیں استعمال کر رہے ہیں:\r\n[2]\r\nسب بند کریں؟\r\n\r\nہاں: سب بند کر کے جاری رکھیں (غیر محفوظ کام ضائع ہو سکتا ہے)۔\r\nنہیں: بند کیے بغیر جاری رکھیں (پہلے سے کھلے پروگرام دوبارہ کھلنے تک پرانی فائلیں رکھتے ہیں)۔\r\nمنسوخ کریں: روکیں۔"

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: رک گیا، کیونکہ [1] پروگرام اس کی فائلیں استعمال کر رہے ہیں:\r\n[2]انہیں بند کر کے دوبارہ کوشش کریں، یا RPCLOSE=yes (سب بند کر کے جاری رکھیں) یا RPCLOSE=no (بند کیے بغیر جاری رکھیں) دیں۔"

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[3] کے فولڈرز میں [1] اشیاء اس کے ساتھ انسٹال نہیں ہوئیں:\r\n[2]\r\nانہیں بھی حذف کریں؟\r\n\r\nہاں: انہیں [3] کے ساتھ حذف کریں (واپس نہیں لائی جا سکتیں)۔\r\nنہیں: [3] کو ہٹائیں اور انہیں رکھیں۔\r\nمنسوخ کریں: روکیں۔"

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: رک گیا، کیونکہ اس کے فولڈرز میں [1] اشیاء اس کے ساتھ انسٹال نہیں ہوئیں:\r\n[2]RPEXTRA=delete (انہیں بھی حذف کریں) یا RPEXTRA=keep (انہیں رکھیں) دیں، پھر دوبارہ ہٹائیں۔"

msgctxt "installer"
msgid "PreflightUsers"
msgstr "اس کمپیوٹر کے [1] دیگر صارفین کے پاس [3] کی ترتیبات یا ڈیٹا ہو سکتا ہے:\r\n[2]\r\nکیا ان کا بھی حذف کریں؟\r\n\r\nہاں: ہر صارف کے لیے حذف کریں (واپس نہیں لایا جا سکتا)۔\r\nنہیں: صرف آپ کا حذف کریں۔\r\nمنسوخ کریں: روکیں۔"

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] اس کمپیوٹر پر پہلے سے Microsoft Store سے یا ایپ پیکج کے طور پر انسٹال ہے ([2])۔ ایک پروگرام کی دو کاپیاں دونوں اس کی فائلیں کھولتی ہیں اور دونوں اس کے مینو دکھاتی ہیں۔\r\n\r\nکیا یہ بھی انسٹال کریں؟"

