msgstr "کلاس {1} پہلے سے [com.{2}] فراہم کرتا ہے"

msgid "class %s is also in [msix-extension.%s]"
msgstr "کلاس {1} [msix-extension.{2}] میں بھی ہے"

msgid "class must be a GUID like {12345678-...} (got '%s')"
msgstr "class کو {{12345678-...} جیسا GUID ہونا چاہیے ('{1}' ملا)"

msgid "close-programs has no effect with preflight = false"
msgstr "preflight = false کے ساتھ close-programs کا کوئی اثر نہیں"

msgid "close-programs must be \"ask\", \"always\" or \"never\" (got '%s')"
msgstr "close-programs کو \"ask\"، \"always\" یا \"never\" ہونا چاہیے ('{1}' ملا)"

msgid "column %s holds the wrong kind of value"
msgstr "کالم {1} میں غلط قسم کی قدر ہے"

msgid "column %s is not valid UTF-8"
msgstr "کالم {1} درست UTF-8 نہیں"

msgid "column %s may not be null"
msgstr "کالم {1} null نہیں ہو سکتا"

msgid "column %s: %ld is outside the column's range"
msgstr "کالم {1}: {2} کالم کی حد سے باہر ہے"

msgid "column %s: %zu UTF-16 units, the column holds %u"
msgstr "کالم {1}: {2} UTF-16 اکائیاں، کالم {3} رکھتا ہے"

msgid "column %s: %zu characters, the column holds %u"
msgstr "کالم {1}: {2} حروف، کالم {3} رکھتا ہے"

msgid "command '%s' is not implemented yet"
msgstr "کمانڈ '{1}' ابھی نافذ نہیں"

msgid "command-line"
msgstr "کمانڈ لائن"

msgid "component %s %s changed between 32 and 64 bits: the component rules want a new GUID"
msgstr "جزو {1} {2} 32 اور 64 بٹ کے درمیان بدل گیا: جزو کے قواعد نیا GUID چاہتے ہیں"

msgid "component %s %s is gone (its resources are removed with the previous version)"
msgstr "جزو {1} {2} موجود نہیں (اس کے ریسورسز پچھلے ورژن کے ساتھ ہٹائے جاتے ہیں)"

msgid "component %s %s now has the key path %s instead of %s: the component rules want a new GUID"
msgstr "جزو {1} {2} کا کلیدی راستہ اب {4} کی بجائے {3} ہے: جزو کے قواعد نیا GUID چاہتے ہیں"

msgid "component-guid must be a GUID"
msgstr "component-guid کو GUID ہونا چاہیے"

msgid "compress must be \"none\", \"mszip\", \"mszip:0\" ... \"mszip:9\", \"lzx\" or \"lzx:15\" ... \"lzx:21\""
msgstr "compress کو \"none\"، \"mszip\"، \"mszip:0\" ... \"mszip:9\"، \"lzx\" یا \"lzx:15\" ... \"lzx:21\" ہونا چاہیے"

msgid "condition has an unclosed quote or unbalanced parentheses"
msgstr "شرط میں بند نہ ہونے والا کوٹ یا غیر متوازن قوسین ہیں"

msgid "condition is longer than 240 characters (rubrapack adds \"Installed OR ( )\")"
msgstr "شرط 240 حروف سے لمبی ہے (rubrapack \"Installed OR ( )\" شامل کرتا ہے)"

msgid "config holds \"Name=value\" strings (got '%s')"
msgstr "config میں \"Name=value\" اسٹرنگز ہوتی ہیں ('{1}' ملا)"

msgid "config is an array of \"Name=value\" strings"
msgstr "config \"Name=value\" اسٹرنگز کی ترتیب ہے"

msgid "contains a control character"
msgstr "ایک کنٹرول حرف رکھتا ہے"

msgid "contains one of < > : \" / \\ | ? *"
msgstr "< > : \" / \\ | ? * میں سے ایک رکھتا ہے"

msgid "content-type is a media type, like \"image/png\" (got '%s')"
msgstr "content-type میڈیا کی قسم ہے، جیسے \"image/png\" ('{1}' ملا)"

msgid "control character"
msgstr "کنٹرول حرف"

msgid "control character in a comment"
msgstr "تبصرے میں کنٹرول حرف"

msgid "control character in a string"
msgstr "اسٹرنگ میں کنٹرول حرف"

msgid "dates and times are not supported; write them as strings"
msgstr "تاریخیں اور اوقات معاون نہیں؛ انہیں اسٹرنگز کے طور پر لکھیں"

msgid "default-when needs level above 1 (a level-1 feature is installed by default anyway)"
msgstr "default-when کو 1 سے اوپر کا لیول چاہیے (لیول 1 کی خصوصیت ویسے بھی بطورِ ڈیفالٹ انسٹال ہوتی ہے)"

msgid "define the variable ([define] or -D NAME=value), or write $$ for a literal $"
msgstr "متغیر بیان کریں ([define] یا -D NAME=value)، یا لفظی $ کے لیے $$ لکھیں"

msgid "dialog '%s' is not a [dialog.*]"
msgstr "ڈائیلاگ '{1}' کوئی [dialog.*] نہیں"

msgid "dialog IDs starting with 'Rp' (and FilesInUse) are rubrapack's own"
msgstr "'Rp' سے شروع ہونے والے ڈائیلاگ IDs (اور FilesInUse) rubrapack کے اپنے ہیں"

msgid "dir '%s' is inside itself (path loop)"
msgstr "dir '{1}' اپنے ہی اندر ہے (راستے کا لوپ)"

msgid "dir '%s' is neither a dir ID nor Programs, Desktop, StartMenu or Startup"
msgstr "dir '{1}' نہ dir ID ہے اور نہ Programs، Desktop، StartMenu یا Startup"

msgid "dir '%s' is not a dir ID"
msgstr "dir '{1}' کوئی dir ID نہیں"

msgid "dir '%s' is not defined"
msgstr "dir '{1}' بیان نہیں"

msgid "dir ID"
msgstr "dir ID"

msgid "direction must be \"in\" or \"out\" (got '%s')"
msgstr "direction کو \"in\" یا \"out\" ہونا چاہیے ('{1}' ملا)"

msgid "do/undo arguments are longer than 255 characters"
msgstr "do/undo دلائل 255 حروف سے لمبے ہیں"

msgid "dotted keys are not supported; put the key in its own table"
msgstr "نقطے والی کلیدیں معاون نہیں؛ کلید کو اس کے اپنے جدول میں رکھیں"

msgid "driver '%s' is not an [odbc-driver.*]"
msgstr "ڈرائیور '{1}' [odbc-driver.*] نہیں ہے"

msgid "dump a package (MSI tables as IDT)"
msgstr "پیکیج ڈمپ کریں (MSI جدول IDT کے طور پر)"

msgid "duplicate primary key"
msgstr "دہرائی گئی بنیادی کلید"

msgid "embedded must be a .dll file (the author's UI handler)"
msgstr "embedded ایک ‎.dll فائل ہونی چاہیے (مصنف کا UI ہینڈلر)"

msgid "empty arrays are not supported"
msgstr "خالی ترتیبیں معاون نہیں"

msgid "ends with a space or a dot"
msgstr "خالی جگہ یا نقطے پر ختم ہوتا ہے"

msgid "error"
msgstr "خرابی"

msgid "executable = \"%s\" must name a [file.*] that goes into the package"
msgstr "executable = \"{1}\" کو ایسی [file.*] کا نام لینا چاہیے جو پیکیج میں جائے"

msgid "expected ',' or ']' in the array"
msgstr "ترتیب میں ',' یا ']' متوقع تھا"

msgid "expected '=' after the key"
msgstr "کلید کے بعد '=' متوقع تھا"

msgid "expected ']' to close the table name"
msgstr "جدول نام بند کرنے کے لیے ']' متوقع تھا"

msgid "expected a key, a [table] or a comment"
msgstr "کلید، [جدول] یا تبصرہ متوقع تھا"

msgid "extension '%s' already has a program ([assoc.%s])"
msgstr "ایکسٹینشن '{1}' کا پہلے سے پروگرام ہے ([assoc.{2}])"

msgid "extension must be '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "ایکسٹینشن کو '.' اور چھوٹے حروف، ہندسے، '_' یا '-' ہونا چاہیے ('{1}' ملا)"

msgid "external-location = true makes the identity of a program installed elsewhere: not a framework, optional or modification package"
msgstr "external-location = true پیکیج کو کہیں اور نصب پروگرام کی شناخت بناتا ہے: یہ فریم ورک، اختیاری یا ترمیمی پیکیج نہیں"

msgid "external-location = true needs Windows build 19041 or later: set [msix] min-version = \"10.0.19041.0\""
msgstr "external-location = true کے لیے Windows بلڈ 19041 یا بعد کا درکار ہے: [msix] min-version = \"10.0.19041.0\" سیٹ کریں"

msgid "extra-files has no effect with preflight = false"
msgstr "preflight = false کے ساتھ extra-files کا کوئی اثر نہیں"

msgid "extra-files must be \"ask\", \"keep\" or \"delete\" (got '%s')"
msgstr "extra-files کو \"ask\"، \"keep\" یا \"delete\" ہونا چاہیے ('{1}' ملا)"

msgid "feature %s is gone: installations that had it lose what it held"
msgstr "خصوصیت {1} موجود نہیں: جن انسٹالیشنز میں یہ تھی وہ اس کا مواد کھو دیتی ہیں"

msgid "feature '%s' is its own ancestor"
msgstr "خصوصیت '{1}' اپنی ہی جدِ امجد ہے"

msgid "feature '%s' is not defined"
msgstr "خصوصیت '{1}' بیان نہیں"

msgid "feature parent '%s' is not defined"
msgstr "خصوصیت کا والد '{1}' بیان نہیں"

msgid "file '%s' already runs service '%s'"
msgstr "فائل '{1}' پہلے سے سروس '{2}' چلاتی ہے"

msgid "file '%s' is already registered as a font"
msgstr "فائل '{1}' پہلے سے فونٹ کے طور پر رجسٹرڈ ہے"

msgid "file '%s' is not a [file.*] of this package"
msgstr "فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "file '%s' must be installed in the Fonts folder itself (a [dir.*] with path = \"Fonts\")"
msgstr "فائل '{1}' خود Fonts فولڈر میں انسٹال ہونی چاہیے (path = \"Fonts\" والا [dir.*])"

msgid "file '%s' needs a feature: set 'feature' here or on its dir"
msgstr "فائل '{1}' کو ایک خصوصیت چاہیے: 'feature' یہاں یا اس کے dir پر سیٹ کریں"

msgid "file must be \"file:<ID>\""
msgstr "file کو \"file:<ID>\" ہونا چاہیے"

msgid "file name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "فائل نام {1} UTF-16 اکائیاں ہے؛ 8.3 مختصر نام کے ساتھ MSI زیادہ سے زیادہ {2} رکھتا ہے"

msgid "file-system-virtualization and registry-virtualization = false need Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "file-system-virtualization اور registry-virtualization = false کو Windows بلڈ 18362 یا بعد کا چاہیے: [msix] min-version = \"10.0.18362.0\" سیٹ کریں"

msgid "file: '%s' is not a [file.*] of this package"
msgstr "file: '{1}' اس پیکیج کی [file.*] نہیں"

msgid "file: '%s' serves COM classes only as an .exe or a .dll"
msgstr "file: '{1}' COM کلاسز صرف .exe یا .dll کے طور پر فراہم کرتی ہے"

msgid "files but no Media row"
msgstr "فائلیں ہیں لیکن کوئی Media قطار نہیں"

msgid "fix the value the message names; IDs are letters, digits and '_' and differ across all tables"
msgstr "پیغام میں نامزد قدر درست کریں؛ IDs حروف، ہندسے اور '_' ہیں اور تمام جدولوں میں مختلف ہیں"

msgid "floating-point numbers are not supported"
msgstr "فلوٹنگ پوائنٹ اعداد معاون نہیں"

msgid "folder '%s' needs a feature: set 'feature' here or on its dir"
msgstr "فولڈر '{1}' کو ایک خصوصیت چاہیے: 'feature' یہاں یا اس کے dir پر سیٹ کریں"

msgid "folder name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "فولڈر نام {1} UTF-16 اکائیاں ہے؛ 8.3 مختصر نام کے ساتھ MSI زیادہ سے زیادہ {2} رکھتا ہے"

msgid "follow-parent needs a parent"
msgstr "follow-parent کو والد چاہیے"

msgid "fonts need scope = \"machine\" (this is %s)"
msgstr "فونٹس کو scope = \"machine\" چاہیے (یہ {1} ہے)"

msgid "format %lld needs a newer rubrapack (this one reads format %d)"
msgstr "فارمیٹ {1} کو نیا rubrapack چاہیے (یہ فارمیٹ {2} پڑھتا ہے)"

msgid "format is a whole number: format = %d"
msgstr "format ایک عدد صحیح ہے: format = {1}"

msgid "give --pass-env or --pass-file, not both"
msgstr "--pass-env یا --pass-file دیں، دونوں نہیں"

msgid "give --pin-env or --pin-file, not both"
msgstr "--pin-env یا --pin-file دیں، دونوں نہیں"

msgid "give [msix] and [msix-app.*] what they need, or keep the item for the MSI with msi-only = true"
msgstr "[msix] اور [msix-app.*] کو ان کی ضرورت دیں، یا آئٹم کو msi-only = true سے MSI کے لیے رکھیں"

msgid "give a file below this folder"
msgstr "اس فولڈر کے نیچے کوئی فائل دیں"

msgid "give a file directly in the program folder, or - for none"
msgstr "براہِ راست پروگرام فولڈر میں فائل دیں، یا کوئی نہیں کے لیے -"

msgid "give a folder below this one, such as dist"
msgstr "اس کے نیچے کوئی فولڈر دیں، جیسے dist"

msgid "give a name of 1 to 128 bytes"
msgstr "1 سے 128 بائٹس کا نام دیں"

msgid "give all three logos (logo-150, logo-44, store-logo) or none"
msgstr "تینوں لوگو (logo-150، logo-44، store-logo) دیں یا کوئی نہیں"

msgid "give one of --key, --pkcs11 and --key-store"
msgstr "--key، --pkcs11 اور --key-store میں سے ایک دیں"

msgid "give sub folders of the program folder, separated by commas, or - for none"
msgstr "پروگرام فولڈر کے ذیلی فولڈرز کاموں سے الگ کر کے دیں، یا کوئی نہیں کے لیے -"

msgid "glob '%s' matches no file"
msgstr "پیٹرن '{1}' کسی فائل سے میل نہیں کھاتا"

msgid "glob '%s' matches the output file '%s'"
msgstr "پیٹرن '{1}' آؤٹ پٹ فائل '{2}' سے میل کھاتا ہے"

msgid "has a MergeModule.CABinet stream that cannot be read"
msgstr "ایسی MergeModule.CABinet اسٹریم ہے جو نہیں پڑھی جا سکتی"

msgid "has a MergeModule.CABinet that cannot be read"
msgstr "ایسا MergeModule.CABinet ہے جو نہیں پڑھا جا سکتا"

msgid "has a Module*Sequence table without the standard columns"
msgstr "معیاری کالموں کے بغیر Module*Sequence جدول ہے"

msgid "has a ModuleConfiguration item without a name or with an unknown format"
msgstr "نام کے بغیر یا نامعلوم فارمیٹ والا ModuleConfiguration آئٹم ہے"

msgid "has a ModuleConfiguration table without the standard columns"
msgstr "معیاری کالموں کے بغیر ModuleConfiguration جدول ہے"

msgid "has a ModuleSubstitution table without the standard columns"
msgstr "معیاری کالموں کے بغیر ModuleSubstitution جدول ہے"

msgid "has a ModuleSubstitution template naming an item that ModuleConfiguration does not have"
msgstr "ایسا ModuleSubstitution سانچہ ہے جو ایسے آئٹم کا نام لیتا ہے جو ModuleConfiguration میں نہیں"

msgid "has a component with a condition; an MSIX installs everything"
msgstr "شرط والا ایک جزو ہے؛ MSIX سب کچھ انسٹال کرتا ہے"

msgid "has a file whose component or cabinet entry is missing"
msgstr "ایسی فائل ہے جس کا جزو یا cabinet اندراج غائب ہے"

msgid "has a folder outside its TARGETDIR that an MSIX has no place for"
msgstr "TARGETDIR سے باہر ایسا فولڈر ہے جس کی MSIX میں کوئی جگہ نہیں"

msgid "has a table that cannot be read"
msgstr "ایسا جدول ہے جو نہیں پڑھا جا سکتا"

msgid "has a table whose columns differ from the package's"
msgstr "ایسا جدول ہے جس کے کالم پیکیج سے مختلف ہیں"

msgid "has actions for a sequence table the package does not have"
msgstr "ایسے ترتیب جدول کے لیے اعمال ہیں جو پیکیج میں نہیں"

msgid "has components, but the package has no FeatureComponents table"
msgstr "اجزاء ہیں، لیکن پیکیج میں FeatureComponents جدول نہیں"

msgid "has files but no MergeModule.CABinet or Directory table"
msgstr "فائلیں ہیں لیکن MergeModule.CABinet یا Directory جدول نہیں"

msgid "has files but no MergeModule.CABinet stream"
msgstr "فائلیں ہیں لیکن MergeModule.CABinet اسٹریم نہیں"

msgid "has files, but the package has no Media table"
msgstr "فائلیں ہیں، لیکن پیکیج میں Media جدول نہیں"

msgid "has no ModuleSignature: not a merge module"
msgstr "ModuleSignature نہیں: مرج ماڈیول نہیں"

msgid "has no ProductCode or ProductVersion"
msgstr "ProductCode یا ProductVersion نہیں"

msgid "has no Property table"
msgstr "Property جدول نہیں"

msgid "has records for a table neither the base nor the transform defines"
msgstr "ایسے جدول کے ریکارڈز ہیں جسے نہ بنیاد بیان کرتی ہے نہ ٹرانسفارم"

msgid "has text outside ASCII in another code page than 65001 (UTF-8)"
msgstr "65001 (UTF-8) کے علاوہ کوڈ پیج میں ASCII سے باہر متن ہے"

msgid "icon must be an .ico file"
msgstr "icon کو .ico فائل ہونا چاہیے"

msgid "icon: file '%s' is not a [file.*] of this package"
msgstr "icon: فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "id must be a GUID like {12345678-1234-1234-1234-123456789ABC}: the module's own, kept in every version"
msgstr "id کو {{12345678-1234-1234-1234-123456789ABC} جیسا GUID ہونا چاہیے: ماڈیول کا اپنا، ہر ورژن میں رکھا جاتا ہے"

msgid "identifier is winget's Publisher.Package: 2 to 8 parts of 1 to 32 characters, no spaces or \\ / : * ? \" < > | (got '%s')"
msgstr "identifier، winget کا Publisher.Package ہے: 1 سے 32 حروف کے 2 سے 8 حصے، بغیر خالی جگہ اور \\ / : * ? \" < > | کے ('{1}' ملا)"

msgid "identity-name must be 3 to 50 characters of A-Z, a-z, 0-9, '.' and '-' (got '%s')"
msgstr "identity-name کو A-Z، a-z، 0-9، '.' اور '-' کے 3 سے 50 حروف ہونا چاہیے ('{1}' ملا)"

msgid "image must be a .bmp file (Windows Installer shows BMP only)"
msgstr "image ایک ‎.bmp فائل ہونی چاہیے (Windows Installer صرف BMP دکھاتا ہے)"

msgid "inline tables are not supported; use a [kind.ID] table"
msgstr "ان لائن جدول معاون نہیں؛ [kind.ID] جدول استعمال کریں"

msgid "installs to the same path as line %u (Windows ignores case in names%s)"
msgstr "لائن {1} والے راستے پر ہی انسٹال ہوتا ہے (Windows ناموں میں حروف کے چھوٹے بڑے کو نظر انداز کرتا ہے{2})"

msgid "instances is for a per-machine package (scope = \"machine\")"
msgstr "instances فی کمپیوٹر پیکج کے لیے ہے (scope = \"machine\")"

msgid "instances is not yet combined with [menu.*] (the menu's identity package is one per build)"
msgstr "instances کو ابھی [menu.*] کے ساتھ نہیں ملایا جا سکتا (مینیو کا شناختی پیکج فی بلڈ ایک ہوتا ہے)"

msgid "internal error: a built-in dialog has a broken tab order; please report it"
msgstr "اندرونی خرابی: بلٹ اِن ڈائیلاگ کی ٹیب ترتیب ٹوٹی ہوئی ہے؛ رپورٹ کریں"

msgid "internal: a module table has no _Validation rule"
msgstr "اندرونی: ماڈیول جدول کا کوئی _Validation قاعدہ نہیں"

msgid "internal: no _Validation rule for a column of %s"
msgstr "اندرونی: {1} کے ایک کالم کے لیے _Validation قاعدہ نہیں"

msgid "invalid"
msgstr "غلط"

msgid "invalid - %s"
msgstr "غلط - {1}"

msgid "is '.' or '..'"
msgstr "'.' یا '..' ہے"

msgid "is a reserved device name"
msgstr "ایک محفوظ ڈیوائس نام ہے"

msgid "is empty"
msgstr "خالی ہے"

msgid "is longer than 255 UTF-16 units"
msgstr "255 UTF-16 اکائیوں سے لمبا ہے"

msgid "is not a Windows Installer database"
msgstr "Windows Installer ڈیٹابیس نہیں"

msgid "is not a compound file"
msgstr "کمپاؤنڈ فائل نہیں"

msgid "is not valid UTF-8"
msgstr "درست UTF-8 نہیں"

msgid "isolate-for: '%s' is not a program (.exe)"
msgstr "isolate-for: '{1}' پروگرام (.exe) نہیں ہے"

msgid "keep the upgrade code, raise the version, keep component codes of files that stay"
msgstr "اپ گریڈ کوڈ رکھیں، ورژن بڑھائیں، رہنے والی فائلوں کے جزو کوڈز رکھیں"

msgid "key '%.*s' is set twice in this table (first at line %u)"
msgstr "کلید '{1}' اس جدول میں دو بار سیٹ ہے (پہلی بار لائن {2} پر)"

msgid "key '%s' must not start or end with '\\' or contain an empty part"
msgstr "کلید '{1}' '\\' سے شروع یا ختم نہیں ہونی چاہیے یا خالی حصہ نہیں رکھنا چاہیے"

msgid "key '%s' outside a table; only 'format' comes before the first table"
msgstr "کلید '{1}' جدول سے باہر ہے؛ پہلے جدول سے پہلے صرف 'format' آتا ہے"

msgid "key file '%s': %s"
msgstr "کلید فائل '{1}': {2}"

msgid "kind must be \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" or \"autoplay\" (got '%s')"
msgstr "kind کو \"alias\"، \"startup-task\"، \"firewall\"، \"com-server\"، \"toast\"، \"context-menu\"، \"app-extension\"، \"app-extension-host\"، \"app-service\"، \"share-target\" یا \"autoplay\" ہونا چاہیے ('{1}' ملا)"

msgid "kind must be \"preview\", \"thumbnail\" or \"property\" (got '%s')"
msgstr "kind کو \"preview\"، \"thumbnail\" یا \"property\" ہونا چاہیے ('{1}' ملا)"

msgid "kind must be registry, file, dir or component"
msgstr "kind کو registry، file، dir یا component ہونا چاہیے"

msgid "labels is an array of strings, one per value"
msgstr "labels اسٹرنگز کی ترتیب ہے، ہر قدر کے لیے ایک"

msgid "language '%s' has no language pack (lang/%s.po beside the source, or RUBRAPACK_LANG_DIR)"
msgstr "زبان '{1}' کا کوئی زبان پیک نہیں (سورس کے ساتھ lang/{2}.po، یا RUBRAPACK_LANG_DIR)"

msgid "language '%s' is listed twice"
msgstr "زبان '{1}' دو بار درج ہے"

msgid "language '%s' is not in [ui] languages"
msgstr "زبان '{1}' [ui] languages میں نہیں"

msgid "language '%s' lacks %zu text(s), the first is %s: add them to its language pack (lang/%s.po) or give [ui-text.ID] text-%s"
msgstr "زبان '{1}' میں {2} متن کم ہیں، پہلا {3} ہے: انہیں اس کے زبان پیک میں شامل کریں (lang/{4}.po) یا [ui-text.ID] text-{5} دیں"

msgid "language '%s' needs [ui] langid-%s (its LANGIDs, for the automatic choice)"
msgstr "زبان '{1}' کو [ui] langid-{2} چاہیے (خودکار انتخاب کے لیے اس کے LANGIDs)"

msgid "language '%s' needs [ui] name-%s (its name on the language page)"
msgstr "زبان '{1}' کو [ui] name-{2} چاہیے (زبان صفحے پر اس کا نام)"

msgid "language = \"ko-KR\" no longer makes the dialogs Korean: they are English unless [ui] languages = [\"ko\"] adds Korean"
msgstr "language = \"ko-KR\" اب ڈائیلاگز کو کوریائی نہیں بناتا: وہ انگریزی ہیں جب تک [ui] languages = [\"ko\"] کوریائی شامل نہ کرے"

msgid "language must be \"ko-KR\" or \"en-US\""
msgstr "language کو \"ko-KR\" یا \"en-US\" ہونا چاہیے"

msgid "language must be \"neutral\", \"en-US\" or \"ko-KR\""
msgstr "language کو \"neutral\"، \"en-US\" یا \"ko-KR\" ہونا چاہیے"

msgid "languages = \"all\" stands alone, not in an array: it takes every built-in language"
msgstr "languages = \"all\" اکیلا لکھا جاتا ہے، کسی ارے میں نہیں: یہ تمام اندرونی زبانیں لیتا ہے"

msgid "languages holds codes like \"ko\" or \"zh_TW\" (2 or 3 lower-case letters, and _ and a region's two capitals) (got '%s')"
msgstr "languages میں \"ko\" یا \"zh_TW\" جیسے کوڈز ہوتے ہیں (2 یا 3 چھوٹے حروف، اور _ اور علاقے کے دو بڑے حروف) ('{1}' ملا)"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "languages زبان کوڈز کی ترتیب ہے، جیسے [\"ko\"]"

msgid "languages needs a dialog set (ui = \"basic\" or another)"
msgstr "languages کو ڈائیلاگ سیٹ چاہیے (ui = \"basic\" یا کوئی اور)"

msgid "launch must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "launch کو \"file:<ID>\" ہونا چاہیے جو اس پیکیج کی [file.*] کا نام لے"

msgid "launch-args needs launch"
msgstr "launch-args کو launch چاہیے"

msgid "launcher is the file name of the PSF launcher in files, like \"PsfLauncher64.exe\""
msgstr "launcher، files میں PSF لانچر کی فائل کا نام ہے، جیسے \"PsfLauncher64.exe\""

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "license کو .txt، .md (سادہ متن کے طور پر دکھائی جاتی ہے) یا .rtf فائل ہونا چاہیے"

msgid "lint: %s row %s: column %s is not in NFC (%zu row%s); build --nfc puts folder, file and shortcut names in NFC"
msgstr "lint: {1} قطار {2}: کالم {3} NFC میں نہیں ({4} قطار{-5})؛ build --nfc فولڈر، فائل اور شارٹ کٹ نام NFC میں کرتا ہے"

msgid "lint: %s%s"
msgstr "lint: {1}{2}"

msgid "lint: code page %u, not 65001: text is not checked as UTF-8, widths only for ASCII"
msgstr "lint: کوڈ پیج {1}، 65001 نہیں: متن UTF-8 کے طور پر نہیں جانچا جاتا، چوڑائیاں صرف ASCII کے لیے"

msgid "lint: no problems\n"
msgstr "lint: کوئی مسئلہ نہیں\n"

msgid "lint: see the problems above\n"
msgstr "lint: اوپر کے مسائل دیکھیں\n"

msgid "list the keys a token or the Windows certificate store can sign with"
msgstr "وہ کلیدیں دکھائیں جن سے ٹوکن یا Windows سرٹیفکیٹ اسٹور دستخط کر سکے"

msgid "logo '%s' and its .scale-100 variant are both there: keep one"
msgstr "لوگو '{1}' اور اس کا .scale-100 ورژن دونوں موجود ہیں: ایک رکھیں"

msgid "logo '%s' at scale %s is %ux%u pixels; it must be %ux%u"
msgstr "پیمانہ {2} پر لوگو '{1}' {3}x{4} پکسل ہے؛ اسے {5}x{6} ہونا چاہیے"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "پیمانہ {2} پر لوگو '{1}' PNG فائل نہیں"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "لوگو '{1}' {2}x{3} پکسل ہے؛ اسے {4}x{5} ہونا چاہیے"

msgid "logo '%s' is not a PNG file"
msgstr "لوگو '{1}' PNG فائل نہیں"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "لوگو '{1}' نہیں ملا (نہ .scale-100 ... .scale-400 ورژنز کے طور پر)"

msgid "logo '%s': a logo with scale variants needs an ASCII file name with an extension"
msgstr "لوگو '{1}': پیمانہ ورژنز والے لوگو کو ایکسٹینشن کے ساتھ ASCII فائل نام چاہیے"

msgid "logo must be a .png of 8-bit RGB or RGBA, not interlaced, at most 1024 pixels a side"
msgstr "logo کو 8 بٹ RGB یا RGBA کی .png ہونا چاہیے، غیر انٹرلیسڈ، ہر طرف زیادہ سے زیادہ 1024 پکسل"

msgid "main-package is the main package's identity name (got '%s')"
msgstr "main-package مرکزی پیکیج کا شناختی نام ہے ('{1}' ملا)"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "main-publisher اور modification = true main-package کے ساتھ آتے ہیں (وہ پیکیج جس کا یہ ہے)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "main-publisher مرکزی پیکیج کا ناشر ہے، جیسے \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "کنٹرول حروف یا / \\ : * ? \" < > | $ نہیں رکھ سکتا"

msgid "may not start with a space or end with a space or a dot"
msgstr "خالی جگہ سے شروع یا خالی جگہ یا نقطے پر ختم نہیں ہو سکتا"

msgid "merge module '%s' not found"
msgstr "مرج ماڈیول '{1}' نہیں ملا"

msgid "min-version must be a version like 1.2.3"
msgstr "min-version کو 1.2.3 جیسا ورژن ہونا چاہیے"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "min-version کے چار حصے ہونے چاہییں، جیسے 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "min-version کے چار حصے ہونے چاہییں، جیسے 14.0.24217.0"

msgid "mismatch"
msgstr "عدم مطابقت"

msgid "mode = \"remove\" removes the key; it takes no 'value'"
msgstr "mode = \"remove\" کلید ہٹاتا ہے؛ یہ 'value' نہیں لیتا"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "mode کو \"set\"، \"add\" یا \"remove\" ہونا چاہیے"

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "mode کو \"set\"، \"append\" یا \"prepend\" ہونا چاہیے"

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "اجازت سے یا ڈائریکٹری سے زیادہ ZIP اندراجات"

msgid "more keys and values than allowed"
msgstr "اجازت سے زیادہ کلیدیں اور قدریں"

msgid "more than 3 redirects"
msgstr "3 سے زیادہ ری ڈائریکٹس"

msgid "more than 96 sections"
msgstr "96 سے زیادہ سیکشنز"

msgid "more than one source file ('%s')"
msgstr "ایک سے زیادہ سورس فائلیں ('{1}')"

msgid "more than one token is present: name one with --token-label"
msgstr "ایک سے زیادہ ٹوکن موجود ہیں: --token-label سے ایک کا نام لیں"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "multi کو \"each\"، \"one\" یا \"single\" ہونا چاہیے ('{1}' ملا)"

msgid "multi-line strings are not supported"
msgstr "کثیر سطری اسٹرنگز معاون نہیں"

msgid "multi-line strings are not supported; use one line with \\n"
msgstr "کثیر سطری اسٹرنگز معاون نہیں؛ \\n کے ساتھ ایک لائن استعمال کریں"

msgid "must be 1 to 64 bytes"
msgstr "1 سے 64 بائٹس ہونا چاہیے"

msgid "name contains a control character"
msgstr "نام میں کنٹرول حرف ہے"

msgid "name is a package's identity name (got '%s')"
msgstr "name پیکیج کا شناختی نام ہے ('{1}' ملا)"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "نام ASCII نہیں اور summary-name موجود نہیں؛ خلاصے کا Subject 'rubrapack package' ہوگا"

msgid "names a folder its Directory table does not have"
msgstr "ایسے فولڈر کا نام لیتا ہے جو اس کے Directory جدول میں نہیں"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "new msix ابھی نافذ نہیں: MSI سورس بنائیں اور [msix] شامل کریں (دستی دیکھیں)"

