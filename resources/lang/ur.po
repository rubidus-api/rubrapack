msgid "use '/' in path"
msgstr "راستے میں '/' استعمال کریں"

msgid "use a full rubrapack build or another way"
msgstr "مکمل rubrapack بلڈ یا کوئی اور طریقہ استعمال کریں"

msgid "used by more than one component"
msgstr "ایک سے زیادہ اجزاء استعمال کرتے ہیں"

msgid "users must be \"all\" (got '%s')"
msgstr "users کو \"all\" ہونا چاہیے ('{1}' ملا)"

msgid "value '%s' is listed twice"
msgstr "قدر '{1}' دو بار درج ہے"

msgid "value missing"
msgstr "قدر غائب ہے"

msgid "values and labels are strings"
msgstr "values اور labels اسٹرنگز ہیں"

msgid "values is an array of 1 to 32 strings"
msgstr "values 1 سے 32 اسٹرنگز کی صف ہے"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "اقدار: IDs، GUIDs، ورژنز، حد سے باہر اعداد، غیر موجود چیزوں کے حوالے"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "متغیر '{1}' بیان نہیں ([define] یا -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "متغیر نام '{1}' میں '=' نہیں ہو سکتا نہ یہ = + - ! * سے شروع ہو سکتا ہے"

msgid "variables"
msgstr "متغیرات"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "متغیرات: بغیر قدر $(NAME)، بند نہ کیا گیا $(، Windows نام یا dir ID جہاں وہ نہیں آ سکتا"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "ورژن '{1}' کو a.b.c یا a.b.c.d ہونا چاہیے"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "ورژن '{1}' کو a.b.c یا a.b.c.d ہونا چاہیے جہاں a، b <= 255 اور c، d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" 64 بٹ پیکیج کی فائل کے 'with' نہیں جا سکتا"

msgid "view must be \"32\" or \"64\""
msgstr "view کو \"32\" یا \"64\" ہونا چاہیے"

msgid "warning"
msgstr "انتباہ"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "تشخیصی کوڈ کا مطلب، اسے رکھنے والے پیغامات، کیا کرنا ہے اور دستی کہاں زیادہ بتاتی ہے"

msgid "with must be \"file:<ID>\""
msgstr "with کو \"file:<ID>\" ہونا چاہیے"

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: فائل '{1}' اس پیکیج کی [file.*] نہیں"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "--pkcs11 کے بغیر `keys list` Windows سرٹیفکیٹ اسٹور دکھاتا ہے"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' dir ID نہیں"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "پیچ (.msp) لکھیں: وہ فائلیں اور قطاریں جو انسٹال شدہ بنیاد کو ہدف تک اپ ڈیٹ کرتی ہیں"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "سورس فائل لکھیں (.toml؛ .rpk نام بھی): جوابات سے بنی، پوچھے گئے یا اختیارات کے طور پر دیے گئے، ایک مقررہ آغاز، یا موجودہ MSI"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "ٹرانسفارم (.mst) لکھیں: جو ایک پیکیج کو دوسرے میں بدلتا ہے"

msgid "write the table or value the plain way the manual shows"
msgstr "جدول یا قدر کو اس سادہ طریقے سے لکھیں جو دستی دکھاتی ہے"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "قدر کو '[~]' کے بغیر لکھیں؛ mode = \"append\" یا \"prepend\" اسے جوڑتا ہے"

msgid "wrote %s\n"
msgstr "لکھا گیا {1}\n"

msgid "x + width must be at most 370 (the page width)"
msgstr "x + width زیادہ سے زیادہ 370 ہونا چاہیے (صفحے کی چوڑائی)"

