msgstr "Pakiety MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: czego potrzebuje pakiet MSIX i czego nie może zawierać"

msgid "Main program, for shortcuts (- for none)"
msgstr "Program główny, dla skrótów (- jeśli brak)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "Podręcznik: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Producent"

