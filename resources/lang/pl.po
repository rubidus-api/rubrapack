msgstr "Producent (widoczny w Zainstalowanych aplikacjach)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt zwrócił podpis ECDSA o złej długości"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "Części opcjonalne, które użytkownik może zaznaczyć (podfoldery, po przecinku; - jeśli brak)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "Token PKCS#11: token nie zawiera certyfikatu z CKA_ID klucza (podaj go przez --cert)"

msgid "Paths"
msgstr "Ścieżki"

msgid "Product name"
msgstr "Nazwa produktu"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode i UpgradeCode to ten sam identyfikator GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} nie jest wyższa od poprzedniej {2} w pierwszych trzech polach: Instalator Windows nie uaktualnia"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Program otwierany przez skróty (- bez skrótów)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: nie ma takiego języka (wbudowane: {2}; inny wymaga swojego pakietu językowego, {3}.po)"

msgid "Reference, "
msgstr "Dokumentacja, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Sekwencji {1} nie obejmuje żaden wiersz Media (ostatni {2})"

msgid "Sequence %ld is used by another file"
msgstr "Sekwencja {1} jest używana przez inny plik"

msgid "Source file to write"
msgstr "Plik źródłowy do zapisania"

msgid "Source format"
msgstr "Format źródła"

msgid "Source must name a File row for type %ld"
msgstr "Source musi wskazywać wiersz File dla typu {1}"

msgid "Start menu shortcut?"
msgstr "Skrót w menu Start?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Wpisy menu Start, Programy, Pulpit i Autostart pochodzą z [shortcut.*] i [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML spoza podzbioru czytanego przez rubrapack albo brak `format` lub jest zbyt nowy"

msgid "Tables"
msgstr "Tabele"

msgid "The TOML subset"
msgstr "Podzbiór TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Pliki UTF-16 big-endian nie są obsługiwane; zapisz jako UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} różni się od kodu poprzedniej wersji {2}: ten pakiet jej nie zastępuje"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode nie jest identyfikatorem GUID w formacie rejestru"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Wartość (tekst, liczba, true/false, [\"a\", \"b\"]; - usuwa klucz)"

msgid "Variables"
msgstr "Zmienne"

msgid "Version"
msgstr "Wersja"

msgid "Version ([define] VERSION)"
msgstr "Wersja ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Wersje i uaktualnienia"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Instalator Windows dopuszcza najwyżej 255.255.65535(.65535)"

msgid "Windows did not say what is installed for '%s'"
msgstr "system Windows nie podał, co jest zainstalowane dla '{1}'"

msgid "Windows name"
msgstr "nazwa systemu Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] wymaga '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] nie może trafić do modułu scalającego; ma to pakiet, który go scala"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] nie jest jeszcze obsługiwane (planowane na {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] nie może trafić do MSIX; dodaj msi-only = true, aby zbudować MSIX bez niego"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] jest w AppData lub LocalAppData użytkownika: pakiet dual zainstalowany dla wszystkich użytkowników umieszcza go tylko w profilu użytkownika, który instaluje"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: identyfikator w module scalającym ma najwyżej 35 znaków (dodawany jest GUID modułu)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] wymaga identyfikatora: napisz [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] nie przyjmuje identyfikatora: napisz [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml nie ma </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml nie jest ostatnim wpisem (nie jest to pakiet zapisany przez rubrapack ani API pakowania systemu Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Tablice tabel [[...]] nie są obsługiwane; daj każdemu elementowi własne [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] umieszcza się raz: before, after lub sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] wymaga zarówno do, jak i undo (undo wycofuje też nieudane do)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] wymaga entry: funkcji DLL do wywołania"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] wymaga run = \"file:<ID>\": program, który uruchamiają do i undo"

msgid "[action.%s] runs a file of this package before InstallFinalize, where a first installation does not have it yet (Windows Installer error 1721 or 1723): place it after InstallFinalize, or make it deferred"
msgstr "[action.{1}] uruchamia plik tego pakietu przed InstallFinalize, a przy pierwszej instalacji tego pliku jeszcze nie ma (błąd Instalatora Windows 1721 lub 1723): umieść akcję po InstallFinalize lub ustaw ją jako deferred"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] uruchamia jedną rzecz: run (exe), dll (zainstalowana DLL) lub binary (DLL w pakiecie); albo do i undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} dotyczy pojedynczej akcji, nie pary do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: akcja odroczona uruchamiająca zainstalowany plik musi być po InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: akcja natychmiastowa działa jako użytkownik instalujący; as dotyczy innych faz"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args należą do programu; DLL otrzymuje data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check idzie z parą do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data dotyczy akcji odroczonej, commit lub rollback (natychmiastowa czyta właściwości)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry to funkcja biblioteki DLL; run przyjmuje args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args dla MSIX muszą być zwykłym tekstem (bez [...] wypełnianych przy instalacji)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: w MSIX typ pliku otwiera aplikację: target musi być plikiem wykonywalnym [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] występuje dwa razy"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] wymaga identyfikatora: napisz [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id i typelib są zapisywane tylko dla MSI; MSIX rejestruje klasę bez nich"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args należą do programu; DLL jest ładowana, nie uruchamiana"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate uruchamia DLL w dllhost; '{2}' to program"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading dotyczy DLL; program ustawia własny apartament"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version i typelib-file wymagają typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] trafia do {2}; albo msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: jego źródłem musi być plik trafiający do pakietu"

msgid "[define] values must be strings"
msgstr "Wartości [define] muszą być ciągami znaków"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] wymaga '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] wymaga image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] wymaga 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] wymaga 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] wymaga 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] ma kontrolek: {2}; najwyżej 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] nie ma [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] jest umieszczony po sobie samym przez inne okna dialogowe"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] wymaga ui = \"minimal\", \"installdir\" lub \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' to nazwa systemu Windows; nadaj dir inny identyfikator"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard wymaga pomocniczej biblioteki DLL rubrapack, której moduł scalający nie zawiera"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] wymaga funkcji"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX ustawia wszystkie swoje zmienne (when); użyj msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: jego wartość wskazuje miejsce, którego MSIX nie może dać (folder poza pakietem, który nie jest folderem Windows, lub część z czasu instalacji); użyj msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: przy external-location = true pakiet nie zawiera żadnego pliku programu, więc i programu uruchamiającego rubrapack; lub msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] jest już w folderze swojego programu; isolate-for dotyczy współdzielonej biblioteki DLL zainstalowanej gdzie indziej"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] jest w profilu użytkownika i ma component-guid: ścieżką klucza pozostaje plik, a reguły Windows wymagają tam wartości HKCU (ICE38); pomiń component-guid, aby ją uzyskać"

msgid "[file.%s]: %s"
msgstr "[file.{1}]: {2}"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' nie jest zestawem .NET (brak nagłówka CLI z wierszem Assembly)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: zestaw .NET sam zawiera swój manifest; manifest jest dla zestawu Win32"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: zestaw Win32 wymaga manifest = \"file:<ID>\", czyli swojego pliku manifestu"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: współdzielony zestaw .NET trafia do GAC, który przyjmuje tylko zestawy o silnej nazwie; podpisz go lub podaj assembly-for = \"file:<program>\""

msgid "[file.%s]: a shared Win32 assembly goes into WinSxS with a catalog signed by the key its manifest's publicKeyToken names; build with --key (or give assembly-for = \"file:<program>\" for a private one)"
msgstr "[file.{1}]: współdzielony zestaw Win32 trafia do WinSxS z katalogiem podpisanym kluczem, który wskazuje publicKeyToken w manifeście; zbuduj z --key (albo podaj assembly-for = \"file:<program>\" dla prywatnego)"

msgid "[file.%s]: a shared Win32 assembly's manifest '%s' names its signer: publicKeyToken in assemblyIdentity (the token of the --key it is built with)"
msgstr "[file.{1}]: manifest '{2}' współdzielonego zestawu Win32 wskazuje podpisującego: publicKeyToken w assemblyIdentity (token klucza --key, którym się buduje)"

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for i manifest idą razem z assembly = \"dotnet\" lub \"win32\""

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: jego manifest '{2}' nie ma assemblyIdentity z name i version"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: jego manifest '{2}' musi być w tym samym dir i feature (i pod tym samym when): oba tworzą jeden składnik"

msgid "[file.%s]: its manifest names publicKeyToken \"%s\", but the --key's token is \"%s\""
msgstr "[file.{1}]: manifest wskazuje publicKeyToken \"{2}\", ale token klucza --key to \"{3}\""

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: manifest '{2}' należy do innego zestawu lub sam jest zestawem"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Eksplorator ładuje obsługę {2} z biblioteki DLL; [com.{3}] to program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows czyta obsługę właściwości tylko dla komputera; pakiet wymaga scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: obsługa podglądu działa w prevhost systemu Windows; pomiń app-id i surrogate w [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX zawiera tylko obsługę miniatur i podglądu (spakowana obsługa właściwości nie dała Eksploratorowi wartości); msi-only = true zachowuje ją dla MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: typ pliku MSIX należy do aplikacji; dodaj [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: klasa {2} nie jest [com.*] tego pakietu (obsługuje ją biblioteka DLL obsługi)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: w MSIX obsługi dzielą wszystkie swoje typy albo żadnego (typ jest w jednym skojarzeniu typu pliku)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: w MSIX jego klasa działa w surrogate; threading = \"sta\" w [com.{2}] daje jego oknu pętlę komunikatów (przy threading = {3} podgląd może pozostać pusty)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: w MSIX wszystkie jego typy są w jednym typie pliku [assoc] albo w żadnym"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: jego klasa jest msi-only ([com.{2}]); MSIX nie miałby dla niej serwera"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types to lista typów plików, np. [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] trafia do {2}; albo msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] wymaga 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] wymaga funkcji: ustaw 'feature' tutaj lub w jego dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX zapisuje wszystkie swoje wpisy INI (when); użyj msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: jego wartość ma część wypełnianą przez Instalator Windows przy instalacji ([...]); MSIX zapisuje plik podczas budowania"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] wymaga 'on': gdzie element się pokazuje, np. [\".txt\"] lub \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] wymaga 'target' (programu, który uruchamia) lub elementów z parent = \"{2}\" (podmenu)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] wymaga 'target': programu uruchamianego przez element"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: menu Windows 11 przyjmuje ID tylko z liter i cyfr (bez '_'): zmień nazwę lub ustaw windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: podmenu niczego nie uruchamia: pomiń 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: element podmenu pokazuje się tam, gdzie jego podmenu: pomiń 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args ma część wypełnianą przez Instalator Windows przy instalacji ([...]); MSIX zawiera tylko stały tekst"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when to \"HKCU\\\\key\\\\value\" lub \"HKLM\\\\...\", przy elemencie menu Windows 11 spoza podmenu"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when wskazuje wartość zapisywaną przez ten pakiet ([registry.{2}]): element nigdy by się nie pokazał"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: jego programu nie ma w MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: jego wartości nie mogą trafić do rejestru pakietu"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list ma część wypełnianą przez Instalator Windows przy instalacji ([...]); MSIX zawiera tylko stały tekst"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list zastępuje {2}, gdy ścieżki nie mieszczą się w wierszu polecenia: potrzebne są multi = \"one\", {3} w args i {4} (plik listy) w list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": nie ma [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on to typ pliku lub ich lista, np. [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' nie jest [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' musi być podmenu: [menu.*] bez target i bez własnego parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] trafia do {2}; albo msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] wymaga funkcji: ustaw 'feature' tutaj lub w jego dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; albo msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] wymaga feature (lub with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature idzie z własnym składnikiem, nie z with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name wskazuje jeden plik; name ma symbole wieloznaczne"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: cel udostępniania wymaga types, formats lub obu"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: program obsługi autoodtwarzania wymaga content-events, device-events lub obu"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args muszą być zwykłym tekstem (bez [...] wypełnianych przy instalacji)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events wymagają class (klasy COM IHWEventHandler programu)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file musi być {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file musi wskazywać plik trafiający do pakietu"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file musi wskazywać program trafiający do pakietu"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types to lista typów plików, np. [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows przyjmuje tylko litery i cyfry"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "[msix-psf] dla arm64 wymaga launcher = \"...\" (PSF nazywa swoje programy uruchamiające PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] nie łączy się ani z external-location = true, ani z [env.*] (własnym programem uruchamiającym rubrapack)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] uruchamia aplikacje przez program uruchamiający PSF: potrzebny jest [msix-app.ID]"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' nie wymienia aplikacji '{2}' w swoich \"applications\""

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: w files nie ma '{1}' (programu uruchamiającego)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: plik '{2}' nie jest biblioteką DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] wskazuje swój sterownik raz: driver (jeden [odbc-driver]) lub driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] z driver-name wymaga with = \"file:<ID>\": składnika, z którym jest instalowany"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: pakiet dla komputera rejestruje źródła danych dla komputera"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] wskazuje jedną kopię: msix (z publisher) lub upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix to nazwa tożsamości pakietu (od 3 do 50 liter, cyfr, '.' lub '-') i wymaga publisher (\"CN=...\"), tak jak w jego manifeście"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: drugiej kopii szuka kontrola wstępna: potrzebne jest preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code należy do tego pakietu (to uaktualnienie, a nie druga kopia)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] wymaga, aby jego dir miał funkcję"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args dla MSIX muszą być zwykłym tekstem (bez [...] wypełnianych przy instalacji)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: w MSIX schemat otwiera aplikację: target musi być plikiem wykonywalnym [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] wymaga 'value' (lub remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR nie sięga poza MSIX; użyj [assoc.*], [protocol.*], [com.*] lub [handler.*] albo msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: wartość qword wymaga pomocniczej biblioteki DLL rubrapack, której moduł scalający nie zawiera"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX zawiera wartości tylko pod {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX ani nie usuwa wartości, ani ich nie zostawia (remove, keep); użyj msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX zapisuje wszystkie swoje wartości (when); użyj msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: jego wartość ma część wypełnianą przez Instalator Windows przy instalacji ([...]); MSIX zawiera tylko stałe wartości"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" wymaga pomocniczej biblioteki DLL rubrapack, której moduł scalający nie zawiera"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: nazwa klucza lub wartości nie może trafić do gałęzi rejestru"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" dotyczy root = \"HKCU\" z on = \"uninstall\", w pakiecie dla komputera"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] wymaga funkcji: ustaw 'feature' tutaj lub w jego dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true nie dotyczy folderu pod {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true wymaga pomocniczej biblioteki DLL rubrapack, której moduł scalający nie zawiera"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" dotyczy recursive = true dla folderu w AppData lub LocalAppData, w pakiecie dla komputera"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args dla MSIX muszą być zwykłym tekstem (bez [...] wypełnianych przy instalacji)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file musi wskazywać program trafiający do pakietu"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] reklamuje funkcję '{2}', która ma advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise nie łączy się z when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX ma skróty tylko na pulpicie i w menu Start{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: skrót MSIX nie ma working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: skrót MSIX jest zawsze (when dotyczy MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: skrót MSIX pokazuje logo swojej aplikacji; icon dotyczy MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: reklamowany skrót jest dla MSI (MSIX instaluje cały pakiet)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: reklamowany skrót potrzebuje ikony"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args dla MSIX muszą być zwykłym tekstem (bez [...] wypełnianych przy instalacji)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: w MSIX skrót uruchamia aplikację: target musi być plikiem wykonywalnym [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: wpis menu Start w MSIX to jego aplikacja, która nie przyjmuje args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: żaden tekst okna dialogowego nie ma tego identyfikatora"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded jest dla MSI; MSIX nie ma własnego interfejsu instalatora"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] wymaga ui = \"basic\" lub innego zestawu okien w [package] (albo embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "sekwencja ucieczki \\{1} nie jest wartością skalarną Unicode"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: ten pakiet nie uaktualniłby poprzedniego czysto"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` pakietu: okna dialogowe, strona kodowa, normalizacja tekstu"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` pakietu lub zestawu MSIX"

msgid "a %s control has no property"
msgstr "kontrolka {1} nie ma property"

msgid "a %s control has no text; put a text control beside it"
msgstr "kontrolka {1} nie ma tekstu; umieść obok niej kontrolkę tekstową"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "kontrolka {1} wymaga [property.{2}] z jedną z jej wartości jako domyślną (używa jej instalacja cicha)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "pakiet {1} nie może zapisywać HKLM; użyj HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "wyjście .msix wymaga tabeli [msix-app.ID] wskazującej plik wykonywalny"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "wyjście .msix wymaga tabeli [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "wyjście .msm to moduł scalający, budowany ze źródła z [module] zamiast [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "plik .txt, .md lub .rtf albo - jeśli brak"

msgid "a PE file without a certificate table entry"
msgstr "plik PE bez wpisu tabeli certyfikatów"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN nigdy nie jest przyjmowany w wierszu polecenia (inni mogą go zobaczyć); użyj --pin-env lub --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "Package manifestu zestawu o nieznanym Type"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "Package manifestu zestawu bez FileName, Offset lub Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "wpis ZIP nie rozpakowuje się do swojego rozmiaru"

msgid "a ZIP entry larger than allowed"
msgstr "wpis ZIP większy niż dozwolony"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "CRC-32 wpisu ZIP się nie zgadza"

msgid "a ZIP entry's data lies outside the file"
msgstr "dane wpisu ZIP leżą poza plikiem"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "źródło [module] buduje moduł scalający: -o <nazwa>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "wartość binarna to parzysta liczba cyfr szesnastkowych, np. \"01A0FF\""

msgid "a bundle without packages"
msgstr "zestaw bez pakietów"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "certyfikat w ścieżce ma krytyczne rozszerzenie, którego rubrapack nie rozumie"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "certyfikat w ścieżce jest podpisany certyfikatem, który nie jest urzędem certyfikacji"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "łańcuch zawiera tylko [chain], [chain-package.ID] i [define], nie [{1}]; pakiety są budowane z własnych źródeł"

msgid "a chain holds at most %d packages"
msgstr "łańcuch zawiera najwyżej {1} pakietów"

msgid "a chain needs [chain]"
msgstr "łańcuch wymaga [chain]"

