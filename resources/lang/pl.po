# rubrapack language pack: Polish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: pl\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Polski\n"
"X-Rubrapack-LangIDs: 1045\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, okna dialogowe {6}{7}\n  1 nazwa, producent, wersja, architektura      2 folder instalacji, dla kogo\n  3 okna dialogowe, licencja, języki            4 części opcjonalne\n  5 skróty                                      6 pliki: dopasuj do folderu programu\n  7 dowolny klucz                               v pokaż   l lint   s zapisz   q wyjdź\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nKomunikaty z tym kodem (* oznacza nazwę lub wartość):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nWyniki trafiają do stdout, diagnostyka do stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nCo zrobić: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} już nie istnieje, ale otwiera go skrót: najpierw zmień skróty (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  jest tam plików: {1}, folderów: {2}\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s lub q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  dodano [dir.{1}] i [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  dodano [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  podaj to jako tabela.klucz, np. package.version lub dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: brak problemów\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: zobacz problemy powyżej (wskazany tam plik to kopia kontrolna)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  pozostałe języki w [ui] languages zostają; zmień tę listę przez 7 (dowolny klucz)\n"

msgid "  removed [file.%s]\n"
msgstr "  usunięto [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  usunięto [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  podfoldery:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  to nie mieści się w podzbiorze TOML; nic nie zmieniono\n"

msgid "  that was not readable text; again, please\n"
msgstr "  to nie był czytelny tekst; jeszcze raz, proszę\n"

msgid "  the program folder '%s': %s\n"
msgstr "  folder programu '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  źródło nie ma tabel [file], na które mógłby wskazywać skrót\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  źródło nie ma podfolderów w postaci, w jakiej zapisuje je `new` ([files] \"<folder>/<name>/**\"); dodaj je przez 6\n"

msgid "  too long; again, please\n"
msgstr "  za długie; jeszcze raz, proszę\n"

msgid "  y or n\n"
msgstr "  y lub n\n"

msgid " (changed)"
msgstr " (zmieniono)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - tworzy pakiety Windows Installer (.msi) i MSIX (.msix)\n\nużycie: rubrapack [--lang <code>] <command> [arguments]\n\npolecenia:\n"

msgid " and its dir"
msgstr " i jego dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) nie ma zmiennej środowiskowej, więc wartość rozwijalna nie może jej zawierać; użyj wartości tekstowej (wypełnianej podczas instalacji)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) to {2}: może rozpoczynać ścieżkę lub zastępować wartość, którą wypełnia Instalator Windows (rejestr, środowisko, INI, argumenty, komunikaty), ale nie tutaj"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nie jest folderem, od którego może zaczynać się ścieżka (identyfikator dir albo ProgramFiles, LOCALAPPDATA, ProgramData ... - zobacz Paths w podręczniku){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktura:    {2}\n  skrót:        {3}\n  podpis:       {4}\n  łańcuch:      {5}{6}{7}\n  odwołanie:    nie sprawdzono\n  znacznik czasu: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: zmienna nie jest ustawiona"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nie jest kontrolką tego okna dialogowego"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nie występuje w {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': tekst licencji potrzebuje angielskiej nazwy czcionki, więc pojawia się w czcionce własnej języka; wpisz angielską nazwę (np. \"Malgun Gothic\"), aby i tam użyć tej czcionki"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' musi być folderem"

msgid "%s component, but the package platform is %.*s"
msgstr "składnik {1}, ale platforma pakietu to {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} nie należy do kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} nie należy do kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} zawiera identyfikatory LANGID (1..65535), np. 1041"

msgid "%s holds strings"
msgstr "{1} zawiera ciągi znaków"

msgid "%s is %u to %u characters long"
msgstr "{1} ma od {2} do {3} znaków"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} to lista tekstów \"Klucz=Wartość\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} to lista tekstów, np. [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} to nazwa czcionki o długości od 1 do 31 znaków, np. \"Segoe UI\" (otrzymano {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} to warunek MSI z zamkniętymi cudzysłowami i zrównoważonymi nawiasami"

msgid "%s is an array of strings, one per value"
msgstr "{1} to tablica ciągów, po jednym na wartość"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} dotyczy pakietów MSI: msiexec nie usuwa pakietu MSIX"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} już nie istnieje. Usunąć [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} ma ponad 240 znaków"

msgid "%s is new. Add it?"
msgstr "{1} jest nowy. Dodać go?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nie jest identyfikatorem GUID w formacie rejestru"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nie jest kodem używanym przez ten rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} musi mieć postać \"file:<ID>\" i wskazywać [file.*] tego pakietu"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} musi mieć od {2} do {3} liter, cyfr, '.' lub '-' i nie może zaczynać się od '.' (otrzymano '{4}')"

msgid "%s must be a GUID"
msgstr "{1} musi być identyfikatorem GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} musi być identyfikatorem GUID, np. {12345678-...} (otrzymano '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} musi być adresem http:// lub https:// (otrzymano '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} musi być adresem https://, http:// lub file:// albo ścieżką \\\\server\\share (otrzymano '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} musi różnić się od upgrade-code (jedna rodzina uaktualnień na architekturę)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} wymaga kompilacji Windows {2} lub nowszej: ustaw [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} wymaga resources/bin/rubrapack_ca-{2}.dll, bez którego zbudowano ten rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nie sprawdzono (podaj --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA zaufany"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA niezaufany - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} już nie istnieje lub jest pusty. Usunąć [files.{3}] i [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ to nowy folder. Dodać go?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: błędy: {2}{-3}, ostrzeżenia: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: błędy: {2}{-3}, ostrzeżenia: {4}{-5} (względem {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: pliki: {2}, bajty: {3}\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: pliki: {2}, błędy: {3}, ostrzeżenia: 0\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: nie pokazano kolejnych diagnostyk: {2}\n"

msgid "%s: '%s' is not a program (.exe)"
msgstr "{1}: '{2}' nie jest programem (.exe)"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' nie jest standardową akcją, którą umieszcza rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: plik '{2}' nie jest [file.*] tego pakietu"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: plik '{2}' nie jest programem (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' nie jest zamknięte (napisz '$$(' dla tekstu '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' już istnieje; pozostaje bez zmian"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' już istnieje; usuń go lub zbuduj w innym folderze"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' ma już obsługę {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' ma już uprawnienia"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' i '{2}' to ta sama ścieżka w pakiecie"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' należy do systemu Windows lub przeglądarek"

msgid "'%s' cannot be read against '%s': %s"
msgstr "Nie można odczytać '{1}' względem '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' nie mieści się w podzbiorze TOML; nic nie zapisano"

msgid "'%s' exists already"
msgstr "'{1}' już istnieje"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' już istnieje; zmień go poleceniem `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' istnieje i nie jest pustym katalogiem; wypakuj do nowego"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' trafia do {2}; albo msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' ma nieczytelny strumień informacji podsumowania"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' nie ma tabel Directory, Component, File i Media, z których można wypakować"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' nie ma osadzonej transformacji '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' nie ma czytelnych informacji podsumowania"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nie ma transformacji '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' jest w UTF-16: edit zmienia tylko źródła UTF-8 (najpierw zapisz go jako UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' to nazwa systemu Windows; nadaj zmiennej inną nazwę"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' to [chain]: tworzy program instalacyjny, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' to kontrolka wbudowanej ramki; wybierz inny identyfikator"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' to folder komputera; pakiet {2} nie może tam zapisywać"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' to moduł scalający: zamiast tego scal go przez [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' to nazwa zastrzeżona przez format MSIX"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' to łącze symboliczne; łącza nie są śledzone"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' jest też [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' jest też identyfikatorem dir; nadaj zmiennej inną nazwę"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' zbudowano dla maszyny 0x{2}, nie dla arch tego pakietu; ustaw any-arch = true, jeśli to zamierzone"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nie jest ani plikiem PE (.exe, .dll), ani pakietem MSI, ani pakietem lub zestawem MSIX, ani plikiem cabinet"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nie jest ani plikiem PE, ani pakietem MSI, ani pakietem lub zestawem MSIX, ani plikiem cabinet"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nie jest ani znanym folderem, ani identyfikatorem dir (znane foldery: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' nie jest ani pakietem MSIX, ani nazwą rodziny pakietów (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' nie jest plikiem cabinet, który rubrapack umie odczytać (stored lub MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' nie jest kodem diagnostycznym (RP i cztery cyfry, np. RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' nie jest programem (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nie jest zwykłym plikiem"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nie jest programem instalacyjnym rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nie jest prawidłowym identyfikatorem (litery, cyfry i '_', nie zaczyna się cyfrą, najwyżej {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nie jest prawidłową bazą danych MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' nie jest prawidłowym pakietem MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nie jest prawidłowym pakietem: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nie jest prawidłowym źródłem (podzbiór TOML); najpierw popraw go ręcznie"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nie jest prawidłową transformacją: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nie jest prawidłową nazwą zmiennej"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' jest zastrzeżone i nie może być identyfikatorem"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' to nazwa dir: dir może wypełnić tylko wyszukiwanie w rejestrze lub dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' wygląda na plik programu (PE), ale jego nagłówki lub zasoby są uszkodzone"

msgid "'%s' must be a string"
msgstr "'{1}' musi być ciągiem znaków"

msgid "'%s' must be an integer"
msgstr "'{1}' musi być liczbą całkowitą"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' musi mieścić się między {2} a {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' musi mieć wartość true lub false"

msgid "'%s' must not be empty"
msgstr "'{1}' nie może być puste"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' nie wskazuje transformacji (właściwość podsumowania 8): to nie poprawka"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' zaczyna się od folderu: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' ma {4}; nic nie wypakowano"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': wpisów: {2}, więcej niż limit {3} (--limit-entries); nic nie wypakowano"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' i '{3}' byłyby w systemie Windows tą samą ścieżką; nic nie wypakowano"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nie ma w [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': nie można odczytać tabeli"

msgid "'%s': a table is unreadable"
msgstr "'{1}': tabela jest nieczytelna"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX instaluje wszystkie swoje pliki (when); użyj msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX usuwa wszystkie swoje pliki (keep); użyj msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': plik cabinet '{2}' jest uszkodzony lub nie jest stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': nazwa pliku cabinet '{2}' nie jest zwykłą nazwą pliku"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': skompresowany plik '{2}' (sekwencja {3}) nie ma pliku cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': katalog '{2}' ma nadrzędny '{3}', którego nie ma"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': katalog '{2}' jest własnym przodkiem lub jest zagnieżdżony zbyt głęboko"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': plik '{2}' nie zgadza się ze swoim MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': plik '{2}' nie ma składnika ani katalogu"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': plik '{2}' ma {3} B, tabela File podaje {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': pliku '{2}' nie ma w pliku cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': jego zewnętrzne pliki cabinet nie są objęte podpisem (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': jego folder nie prowadzi do znanej lokalizacji"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': do zapisania ponad {2} B (--limit-bytes); nic nie wypakowano"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': brak --timestamp: podpis przestaje być ważny, gdy certyfikat wygaśnie"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': pakiet '{2}' nie zgadza się ze swoim SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': brak strumienia cabinet '{2}'"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifest nie ma {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifest wymienia '{2}', którego nie ma w pakiecie"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': znacznik czasu z {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': nie można odczytać transformacji '{2}' względem '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' to własny język pakietu ({2}); podaj ten tekst bez przyrostka"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' sprawia, że Instalator Windows zapisuje wielociąg; użyj type = \"multi\" i tablicy"

msgid "'_' in numbers is not supported"
msgstr "'_' w liczbach nie jest obsługiwane"

msgid "'help' takes at most one command name"
msgstr "'help' przyjmuje najwyżej jedną nazwę polecenia"

msgid "'version' takes no arguments"
msgstr "'version' nie przyjmuje argumentów"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs dotyczy plików .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch dla zestawu: lista x64, x86 i arm64, każda raz (otrzymano '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch przyjmuje jedną architekturę lub listę dla wyjścia .msixbundle / .msixupload"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp i --allow-unsigned-cabs idą z --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress dotyczy .msi; MSIX przyjmuje --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist wskazuje nowy folder obok źródła (bez ścieżki)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat jest dla wyjścia .msixbundle (jego pakiety są zapisywane obok)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs przyjmuje liczbę od 1 do 64 (otrzymano '{1}')"

msgid "--key signs at most %d external cabinets; raise cab-max-size"
msgstr "--key podpisuje najwyżej {1} zewnętrznych plików cabinet; zwiększ cab-max-size"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store to magazyn certyfikatów systemu Windows; gdzie indziej użyj pliku klucza lub --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store przyjmuje odcisk SHA-1 certyfikatu (40 cyfr szesnastkowych)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: nie ma takiego języka (wbudowane: {2}; inny wymaga swojego pakietu językowego, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (lub RUBRAPACK_LANG) wybiera język tych tekstów: {1} albo język z pakietem językowym.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang wymaga języka, np. en lub ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages wymaga okien dialogowych: podaj też --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress przyjmuje deflate lub store (otrzymano '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: zmienna nie jest ustawiona"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code przyjmuje GUID wielkimi literami w nawiasach klamrowych: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: zmienna nie jest ustawiona"

msgid "--previous compares two .msi packages"
msgstr "--previous porównuje dwa pakiety .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: nie można odczytać certyfikatów głównych systemu operacyjnego"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} nie pasuje do wyjścia '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} nie jest zaimplementowany (msi lub msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target przyjmuje msi lub msix (otrzymano '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots i --proxy idą z --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test i --msix-compress dotyczą wyjść .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test dotyczy pakietów bez podpisu; z --key pomiń go"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate przyjmuje none lub niektóre z: product-code,upgrade-code,language,platform"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget jest dla wyjścia .msi, .msix lub .msixbundle"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget wymaga tabeli [winget]: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget wymaga pakietu w jednym pliku: winget pobiera jeden, więc nie cab = \"external\""

msgid "-D %.*s is given twice"
msgstr "-D {1} podano dwa razy"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' to nazwa systemu Windows; nadaj zmiennej inną nazwę"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D wymaga NAZWA=WARTOŚĆ (otrzymano '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i pyta o każdą odpowiedź; podaj albo -i, albo opcje"

msgid "; its range is "
msgstr "; jego zakres to "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' nie występuje w SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty musi być właściwością publiczną (wielkie litery)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/reference.html#diagnostic-codes\n"
msgstr "Wszystkie kody: https://rubidus-api.github.io/rubrapack/en/reference.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x nie zaczyna się od PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x nie jest ostatnim wpisem"

msgid "Architecture (x64, x86, arm64)"
msgstr "Architektura (x64, x86, arm64)"

msgid "Choose"
msgstr "Wybierz"

msgid "Command line"
msgstr "Wiersz polecenia"

