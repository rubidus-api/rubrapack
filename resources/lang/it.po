msgstr "'{1}' va in {2}; oppure msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' ha un flusso di informazioni di riepilogo illeggibile"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' non ha tabelle Directory, Component, File e Media da cui estrarre"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' non ha la trasformazione incorporata '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' non ha informazioni di riepilogo leggibili"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' non ha la trasformazione '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' è in UTF-16: edit modifica solo origini UTF-8 (salvarlo prima in UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' è un nome di Windows; dare un altro nome alla variabile"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' è un [chain]: crea un programma di installazione, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' è un controllo della cornice integrata; scegliere un altro ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' è una cartella del computer; un pacchetto {2} non può scriverci"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' è un modulo unione: unirlo invece con [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' è un nome che il formato MSIX riserva a sé"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' è un collegamento simbolico; i collegamenti non vengono seguiti"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' è anche una [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' è anche un ID dir; dare un altro nome alla variabile"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' è compilato per la macchina 0x{2}, non per l'arch di questo pacchetto; impostare any-arch = true se è voluto"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' non è né un file PE (.exe, .dll), né un pacchetto MSI, né un pacchetto o bundle MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' non è né un file PE, né un pacchetto MSI, né un pacchetto o bundle MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' non è né una cartella nota né un ID dir (cartelle note: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' non è un cabinet che rubrapack sa leggere (stored o MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' non è un codice di diagnostica (RP e quattro cifre, come RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' non è un programma (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' non è un file normale"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' non è un programma di installazione rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' non è un ID valido (lettere, cifre e '_', senza iniziare con una cifra, al massimo {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' non è un database MSI valido: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' non è un pacchetto MSIX valido: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' non è un pacchetto valido: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' non è un'origine valida (il sottoinsieme TOML); correggerla prima a mano"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' non è una trasformazione valida: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' non è un nome di variabile valido"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' è riservato e non può essere usato come ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' è il nome di un dir: solo una ricerca nel Registro di sistema o di dir può riempire un dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' sembra un file di programma (PE), ma le intestazioni o le risorse sono danneggiate"

msgid "'%s' must be a string"
msgstr "'{1}' deve essere una stringa"

msgid "'%s' must be an integer"
msgstr "'{1}' deve essere un intero"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' deve essere tra {2} e {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' deve essere true o false"

msgid "'%s' must not be empty"
msgstr "'{1}' non deve essere vuoto"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' non indica trasformazioni (proprietà di riepilogo 8): non è una patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' inizia con una cartella: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' ha {4}; non è stato estratto nulla"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} voci, più del limite {3} (--limit-entries); non è stato estratto nulla"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' e '{3}' sarebbero lo stesso percorso in Windows; non è stato estratto nulla"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' non è in [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': impossibile leggere una tabella"

msgid "'%s': a table is unreadable"
msgstr "'{1}': una tabella è illeggibile"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': un MSIX installa tutti i suoi file (when); usare msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': un MSIX rimuove tutti i suoi file (keep); usare msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': il cabinet '{2}' è danneggiato o non stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': il nome di cabinet '{2}' non è un semplice nome di file"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': il file compresso '{2}' (sequenza {3}) non ha cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': la directory '{2}' ha un padre '{3}' che non esiste"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': la directory '{2}' è il proprio antenato o è annidata troppo"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': il file '{2}' non corrisponde al suo MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': il file '{2}' non ha componente o directory"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': il file '{2}' è di {3} byte, la tabella File indica {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': il file '{2}' non è nel cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': i suoi cabinet esterni non sono coperti dalla firma (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': la sua cartella non porta a un percorso noto"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': più di {2} byte da scrivere (--limit-bytes); non è stato estratto nulla"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': nessun --timestamp: la firma non è più valida alla scadenza del certificato"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': il pacchetto '{2}' non corrisponde al suo SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': il flusso di cabinet '{2}' non esiste"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': il manifesto non ha {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': il manifesto indica '{2}', che non è nel pacchetto"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': timestamp da {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': la trasformazione '{2}' non può essere letta rispetto a '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' è la lingua propria del pacchetto ({2}); indicare quel testo senza suffisso"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' fa scrivere a Windows Installer una stringa multipla; usare type = \"multi\" e una matrice"

msgid "'_' in numbers is not supported"
msgstr "'_' nei numeri non è supportato"

msgid "'help' takes at most one command name"
msgstr "'help' accetta al massimo un nome di comando"

msgid "'version' takes no arguments"
msgstr "'version' non accetta argomenti"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs riguarda i .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch per un bundle: un elenco di x64, x86 e arm64, ciascuno una volta (ricevuto '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch accetta un'architettura, o un elenco per un output .msixbundle / .msixupload"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp e --allow-unsigned-cabs vanno con --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress riguarda i .msi; un MSIX accetta --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist indica una nuova cartella accanto all'origine (senza percorso)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs accetta un numero da 1 a 64 (ricevuto '{1}')"

