# rubrapack language pack: Italian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: it\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Italiano\n"
"X-Rubrapack-LangIDs: 1040, 2064\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, finestre {6}{7}\n  1 nome, produttore, versione, architettura      2 cartella di installazione, per chi\n  3 finestre, licenza, lingue                    4 parti facoltative\n  5 collegamenti                                 6 file: seguire la cartella del programma\n  7 qualsiasi chiave                             v vedi   l lint   s salva   q esci\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMessaggi con questo codice (* indica un nome o un valore):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nI risultati vanno su stdout, la diagnostica su stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nCosa fare: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} non esiste più, ma un collegamento lo apre: modificare prima i collegamenti (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  lì ci sono {1} file e {2} cartelle\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s o q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  aggiunti [dir.{1}] e [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  aggiunto [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  indicarla come tabella.chiave, ad esempio package.version o dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: nessun problema\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: vedere i problemi sopra (il file indicato è una copia di controllo)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  le altre lingue in [ui] languages restano; modificare l'elenco con 7 (qualsiasi chiave)\n"

msgid "  removed [file.%s]\n"
msgstr "  rimosso [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  rimosso [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  sottocartelle:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  non rientra nel sottoinsieme TOML; non è stato modificato nulla\n"

msgid "  that was not readable text; again, please\n"
msgstr "  non era testo leggibile; di nuovo, per favore\n"

msgid "  the program folder '%s': %s\n"
msgstr "  la cartella del programma '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  l'origine non ha tabelle [file] a cui un collegamento possa puntare\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  l'origine non ha sottocartelle come le scrive `new` ([files] \"<folder>/<name>/**\"); aggiungerle con 6\n"

msgid "  too long; again, please\n"
msgstr "  troppo lungo; di nuovo, per favore\n"

msgid "  y or n\n"
msgstr "  y o n\n"

msgid " (changed)"
msgstr " (modificato)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - crea pacchetti Windows Installer (.msi) e MSIX (.msix)\n\nuso: rubrapack [--lang <code>] <command> [arguments]\n\ncomandi:\n"

msgid " and its dir"
msgstr " e il suo dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) non ha una variabile di ambiente, quindi un valore espandibile non può contenerlo; usare un valore stringa (compilato in fase di installazione)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) è un {2}: può iniziare un percorso o sostituire un valore che Windows Installer compila (registro, ambiente, INI, argomenti, messaggi), ma non qui"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) non è una cartella da cui possa iniziare un percorso (un ID dir, o ProgramFiles, LOCALAPPDATA, ProgramData ... - vedere Paths nel manuale){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struttura:  {2}\n  digest:     {3}\n  firma:      {4}\n  catena:     {5}{6}{7}\n  revoca:     non verificata\n  timestamp:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: la variabile non è impostata"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' non è un controllo di questa finestra"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' non è in {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': il testo della licenza ha bisogno del nome inglese del tipo di carattere, quindi viene mostrato con quello proprio della lingua; scrivere il nome inglese (come \"Malgun Gothic\") per usarlo anche lì"

msgid "%s component, but the package platform is %.*s"
msgstr "componente {1}, ma la piattaforma del pacchetto è {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} non appartiene a kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} non appartiene a kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} contiene LANGID (1..65535), come 1041"

msgid "%s holds strings"
msgstr "{1} contiene stringhe"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} è un elenco di testi \"Chiave=Valore\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} è un elenco di testi, ad esempio [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} è un nome di tipo di carattere da 1 a 31 caratteri, come \"Segoe UI\" (ricevuti {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} è una condizione MSI con virgolette chiuse e parentesi bilanciate"

msgid "%s is an array of strings, one per value"
msgstr "{1} è una matrice di stringhe, una per valore"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} riguarda i pacchetti MSI: un MSIX non viene rimosso da msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} non esiste più. Rimuovere [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} supera i 240 caratteri"

msgid "%s is new. Add it?"
msgstr "{1} è nuovo. Aggiungerlo?"

msgid "%s is not a GUID in registry format"
msgstr "{1} non è un GUID nel formato del Registro di sistema"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} non è un codice usato da questo rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} deve essere \"file:<ID>\" e indicare un [file.*] di questo pacchetto"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} deve avere da {2} a {3} lettere, cifre, '.' o '-', senza iniziare con '.' (ricevuto '{4}')"

msgid "%s must be a GUID"
msgstr "{1} deve essere un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} deve essere un GUID come {12345678-...} (ricevuto '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} deve essere un indirizzo https://, http:// o file://, o un percorso \\\\server\\share (ricevuto '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} deve essere diverso da upgrade-code (una famiglia di aggiornamento per architettura)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} richiede la build {2} di Windows o successiva: impostare [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} richiede resources/bin/rubrapack_ca-{2}.dll, senza la quale è stato compilato questo rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA non verificata (indicare --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA attendibile"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA non attendibile - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} non esiste più o è vuoto. Rimuovere [files.{3}] e [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ è una nuova cartella. Aggiungerla?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} errori{-3}, {4} avvisi{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} errori{-3}, {4} avvisi{-5} (rispetto a {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} file, {3} byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} file, {3} errori, 0 avvisi\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: altri {2} messaggi diagnostici non mostrati\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' non è un'azione standard che rubrapack colloca"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: il file '{2}' non è un [file.*] di questo pacchetto"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: il file '{2}' non è un programma (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' non è chiuso (scrivere '$$(' per il testo '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' esiste già; viene lasciato com'è"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' esiste già; rimuoverlo o compilare in un'altra cartella"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' ha già un gestore {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' ha già delle autorizzazioni"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' e '{2}' sono lo stesso percorso nel pacchetto"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' appartiene a Windows o ai browser"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' non può essere letto rispetto a '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' non rientra nel sottoinsieme TOML; non è stato salvato nulla"

msgid "'%s' exists already"
msgstr "'{1}' esiste già"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' esiste già; modificarlo con `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' esiste e non è una directory vuota; estrarre in una nuova"

