msgstr "'{1}' n'est pas un package MSIX valide : {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' n'est pas un package valide : {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' n'est pas une source valide (le sous-ensemble TOML) ; corrigez-la d'abord à la main"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' n'est pas une transformation valide : {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' n'est pas un nom de variable valide"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' est réservé et ne peut pas servir d'ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' est le nom d'un dir : seule une recherche dans le registre ou de dir peut remplir un dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' ressemble à un fichier programme (PE), mais ses en-têtes ou ressources sont endommagés"

msgid "'%s' must be a string"
msgstr "'{1}' doit être une chaîne"

msgid "'%s' must be an integer"
msgstr "'{1}' doit être un entier"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' doit être compris entre {2} et {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' doit être true ou false"

msgid "'%s' must not be empty"
msgstr "'{1}' ne doit pas être vide"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' ne nomme aucune transformation (propriété récapitulative 8) : ce n'est pas un correctif"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' commence par un dossier : \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}' : {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}' : {2} '{3}' a {4} ; rien n'a été extrait"

msgid "'%s': %s%s"
msgstr "'{1}' : {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}' : {2} entrées, plus que la limite {3} (--limit-entries) ; rien n'a été extrait"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}' : '{2}' et '{3}' seraient le même chemin sous Windows ; rien n'a été extrait"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}' : '{2}' n'est pas dans [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}' : une table ne peut pas être lue"

msgid "'%s': a table is unreadable"
msgstr "'{1}' : une table est illisible"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}' : un MSIX installe tous ses fichiers (when) ; utilisez msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}' : un MSIX supprime tous ses fichiers (keep) ; utilisez msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}' : le cabinet '{2}' est endommagé ou n'est pas stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}' : le nom de cabinet '{2}' n'est pas un simple nom de fichier"

