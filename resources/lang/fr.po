msgstr "'{1}' : le fichier '{2}' fait {3} octets, la table File indique {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}' : le fichier '{2}' n'est pas dans le cabinet '{3}'"

