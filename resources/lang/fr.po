msgstr "'{1}' : pas de --timestamp : la signature cesse d'être valide à l'expiration du certificat"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}' : le package '{2}' ne correspond pas à son SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}' : le flux de cabinet '{2}' est absent"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}' : le manifeste n'a pas de {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}' : le manifeste nomme '{2}', qui n'est pas dans le package"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}' : horodatage de {2} : {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}' : la transformation '{2}' ne peut pas être lue par rapport à '{3}' : {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' est la langue propre du package ({2}) ; donnez ce texte sans le suffixe"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' fait écrire une chaîne multiple par Windows Installer ; utilisez type = \"multi\" et un tableau"

msgid "'_' in numbers is not supported"
msgstr "'_' dans les nombres n'est pas pris en charge"

msgid "'help' takes at most one command name"
msgstr "'help' accepte au plus un nom de commande"

msgid "'version' takes no arguments"
msgstr "'version' n'accepte pas d'arguments"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs concerne les .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch pour un bundle : une liste de x64, x86 et arm64, chacun une fois (reçu : '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch accepte une architecture, ou une liste pour une sortie .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp et --allow-unsigned-cabs vont avec --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress concerne les .msi ; un MSIX prend --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist nomme un nouveau dossier à côté de la source (sans chemin)"

