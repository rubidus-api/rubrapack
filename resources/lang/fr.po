msgstr "Versions et mises à niveau"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer autorise au plus 255.255.65535(.65535)"

msgid "Windows name"
msgstr "nom Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] a besoin de '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] ne peut pas aller dans un module de fusion ; c'est le package qui le fusionne qui l'a"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] n'est pas encore pris en charge (prévu pour {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] ne peut pas aller dans un MSIX ; ajoutez msi-only = true pour générer le MSIX sans lui"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] est dans l'AppData ou le LocalAppData de l'utilisateur : un paquet dual installé pour tous les utilisateurs ne le met que dans le profil de l'utilisateur qui installe"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}] : un ID dans un module de fusion a au plus 35 caractères (le GUID du module y est ajouté)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] a besoin d'un ID : écrivez [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] ne prend pas d'ID : écrivez [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml n'a pas de </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml n'est pas la dernière entrée (ce n'est pas un package écrit par rubrapack ou l'API d'empaquetage de Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Les tableaux de tables [[...]] ne sont pas pris en charge ; donnez à chaque élément son propre [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] est placée une fois : before, after ou sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] a besoin de do et de undo (undo annule aussi un do échoué)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] exige entry : la fonction de la DLL à appeler"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] exige run = \"file:<ID>\" : le programme que do et undo exécutent"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] exécute une chose : run (un exe), dll (une DLL installée) ou binary (une DLL du paquet) ; ou do et undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}] : {2} est pour une action unique, pas pour une paire do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}] : une action différée qui exécute un fichier installé doit venir après InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}] : une action immédiate s'exécute comme l'utilisateur qui installe ; as est pour les autres phases"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}] : args sont ceux d'un programme ; une DLL reçoit data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}] : check va avec une paire do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}] : data est pour une action différée, commit ou rollback (une immédiate lit les propriétés)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}] : entry est la fonction d'une DLL ; run prend args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}] : les args d'un MSIX doivent être du texte simple (pas de [...] rempli à l'installation)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}] : dans un MSIX un type de fichier ouvre une application : target doit être un exécutable [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] figure deux fois"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] a besoin d'un ID : écrivez [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}] : app-id et typelib ne sont écrits que pour le MSI ; le MSIX inscrit la classe sans eux"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}] : args concerne un programme ; une DLL est chargée, pas lancée"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}] : surrogate exécute une DLL dans dllhost ; '{2}' est un programme"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}] : threading concerne une DLL ; un programme définit son propre apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}] : typelib-version et typelib-file ont besoin de typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] va dans {2} ; ou msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}] : sa source doit être un fichier qui entre dans le package"

msgid "[define] values must be strings"
msgstr "Les valeurs de [define] doivent être des chaînes"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] a besoin de '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] a besoin de image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] a besoin de 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] a besoin de 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] a besoin de 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] a {2} contrôles ; au plus 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] n'a pas de [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] est placé après lui-même via d'autres dialogues"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] a besoin de ui = \"minimal\", \"installdir\" ou \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}] : '{2}' est un nom de Windows ; donnez un autre ID au dir"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}] : guard a besoin de la DLL d'aide de rubrapack, qu'un module de fusion ne contient pas"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] a besoin d'une fonctionnalité"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}] : un MSIX définit toutes ses variables (when) ; utilisez msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}] : sa valeur nomme un emplacement qu'un MSIX ne peut pas donner (un dossier hors du package qui n'est pas un dossier Windows, ou une partie fixée à l'installation) ; utilisez msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] est déjà dans le dossier de son programme ; isolate-for est pour une DLL partagée installée ailleurs"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] est dans le profil de l'utilisateur et a component-guid : son chemin clé reste le fichier, alors que les règles de Windows y veulent une valeur HKCU (ICE38) ; retirez component-guid pour en obtenir une"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}] : l'Explorateur charge un gestionnaire {2} depuis une DLL ; [com.{3}] est un programme"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}] : Windows ne lit les gestionnaires de propriétés que par ordinateur ; le package a besoin de scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}] : un gestionnaire d'aperçu s'exécute dans le prevhost de Windows ; retirez app-id et surrogate de [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}] : un MSIX ne contient que des gestionnaires de miniatures et d'aperçu (un gestionnaire de propriétés empaqueté n'a donné aucune valeur à l'Explorateur) ; msi-only = true le garde pour le MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}] : un type de fichier MSIX appartient à une application ; ajoutez une [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}] : la classe {2} n'est pas une [com.*] de ce package (la DLL du gestionnaire la sert)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}] : dans un MSIX les gestionnaires partagent tous leurs types ou aucun (un type est dans une seule association de type de fichier)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}] : dans un MSIX sa classe s'exécute dans un substitut ; threading = \"sta\" dans [com.{2}] donne à sa fenêtre une boucle de messages (avec threading = {3} l'aperçu peut rester vide)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}] : dans un MSIX ses types sont tous dans un même type de fichier [assoc], ou dans aucun"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}] : sa classe est msi-only ([com.{2}]) ; le MSIX n'aurait pas de serveur pour elle"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}] : types est une liste de types de fichiers, comme [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] va dans {2} ; ou msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] a besoin de 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] a besoin d'une fonctionnalité : définissez 'feature' ici ou sur son dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}] : un MSIX écrit toutes ses entrées INI (when) ; utilisez msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}] : sa valeur a une partie que Windows Installer remplit à l'installation ([...]) ; un MSIX écrit le fichier lors de sa génération"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] a besoin de 'on' : où l'élément apparaît, comme [\".txt\"] ou \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] a besoin de 'target' (le programme qu'il lance), ou d'éléments avec parent = \"{2}\" (un sous-menu)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] a besoin de 'target' : le programme que lance l'élément"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}] : le menu de Windows 11 n'accepte qu'un ID de lettres et de chiffres (pas de '_') : renommez-le, ou windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}] : un sous-menu ne lance rien : omettez 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}] : un élément de sous-menu apparaît là où apparaît son sous-menu : omettez 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}] : args a une partie que Windows Installer remplit à l'installation ([...]) ; un MSIX ne contient que du texte fixe"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}] : hide-when vaut \"HKCU\\\\key\\\\value\" ou \"HKLM\\\\...\", sur un élément du menu de Windows 11 qui n'est pas dans un sous-menu"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}] : hide-when désigne une valeur que ce paquet écrit lui-même ([registry.{2}]) : l'élément ne s'afficherait jamais"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}] : son programme n'est pas dans le MSIX (msi-only ?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}] : ses valeurs ne peuvent pas aller dans le registre du package"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}] : list a une partie que Windows Installer remplit à l'installation ([...]) ; un MSIX ne contient que du texte fixe"

