msgstr "'{1}' n'est pas un code de diagnostic (RP et quatre chiffres, comme RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' n'est pas un programme (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' n'est pas un fichier ordinaire"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' n'est pas un programme d'installation rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' n'est pas un ID valide (lettres, chiffres et '_', sans commencer par un chiffre, au plus {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' n'est pas une base de données MSI valide : {2}"

