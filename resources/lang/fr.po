msgstr "'{1}' va dans {2} ; ou msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' a un flux d'informations récapitulatives illisible"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' n'a pas de tables Directory, Component, File et Media à extraire"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' n'a pas de transformation incorporée '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' n'a pas d'informations récapitulatives lisibles"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' n'a pas de transformation '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' est en UTF-16 : edit ne modifie que les sources UTF-8 (enregistrez-le d'abord en UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' est un nom de Windows ; donnez un autre nom à la variable"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' est un [chain] : il crée un programme d'installation, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' est un contrôle du cadre intégré ; choisissez un autre ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' est un dossier de l'ordinateur ; un package {2} ne peut pas y écrire"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' est un module de fusion : fusionnez-le plutôt avec [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' est un nom que le format MSIX se réserve"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' est un lien symbolique ; les liens ne sont pas suivis"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' est aussi une [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' est aussi un ID de dir ; donnez un autre nom à la variable"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' est compilé pour la machine 0x{2}, pas pour l'arch de ce package ; définissez any-arch = true si c'est voulu"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' n'est ni un fichier PE (.exe, .dll), ni un package MSI, ni un package ou bundle MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' n'est ni un fichier PE, ni un package MSI, ni un package ou bundle MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' n'est ni un dossier connu ni un ID de dir (dossiers connus : ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' n'est pas un cabinet que rubrapack sait lire (stored ou MSZIP)"

