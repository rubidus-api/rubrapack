msgstr "Source doit nommer une ligne File pour le type {1}"

msgid "Start menu shortcut?"
msgstr "Raccourci dans le menu Démarrer ?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Les entrées du menu Démarrer, de Programmes, du Bureau et du Démarrage proviennent de [shortcut.*] et [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML hors du sous-ensemble lu par rubrapack, ou `format` absent ou trop récent"

msgid "Tables"
msgstr "Tables"

