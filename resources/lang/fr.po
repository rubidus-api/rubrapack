msgstr "'{1}' : ses cabinets externes ne sont pas couverts par la signature (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}' : son dossier ne mène pas à un emplacement connu"

