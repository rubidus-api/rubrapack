# rubrapack language pack: French.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: fr\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Français\n"
"X-Rubrapack-LangIDs: 1036, 2060, 3084, 4108, 5132, 6156\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1} : \"{2}\" {3}, {4}, {5}, dialogues {6}{7}\n  1 nom, fabricant, version, architecture        2 dossier d'installation, pour qui\n  3 dialogues, licence, langues                  4 parties facultatives\n  5 raccourcis                                   6 fichiers : suivre le dossier du programme\n  7 toute clé                                    v voir   l lint   s enregistrer   q quitter\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMessages avec ce code (* représente un nom ou une valeur) :\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nLes résultats vont sur stdout, les diagnostics sur stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nQue faire : {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} a disparu, mais un raccourci l'ouvre : modifiez d'abord les raccourcis (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} fichiers et {2} dossiers s'y trouvent\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s ou q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] et [files.{2}] ajoutés\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] ajouté\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  indiquez-le sous la forme table.clé, comme package.version ou dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint : aucun problème\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint : voir les problèmes ci-dessus (le fichier nommé est une copie de contrôle)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  les autres langues de [ui] languages sont conservées ; modifiez cette liste avec 7 (toute clé)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] supprimé\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} supprimé\n"

msgid "  sub folders:"
msgstr "  sous-dossiers :"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  cela ne respecte pas le sous-ensemble TOML ; rien n'a été modifié\n"

msgid "  that was not readable text; again, please\n"
msgstr "  ce n'était pas du texte lisible ; recommencez, s'il vous plaît\n"

msgid "  the program folder '%s': %s\n"
msgstr "  le dossier du programme '{1}' : {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  la source n'a aucune table [file] vers laquelle un raccourci peut pointer\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  la source n'a pas de sous-dossiers tels que `new` les écrit ([files] \"<folder>/<name>/**\") ; ajoutez-les avec 6\n"

msgid "  too long; again, please\n"
msgstr "  trop long ; recommencez, s'il vous plaît\n"

msgid "  y or n\n"
msgstr "  y ou n\n"

msgid " (changed)"
msgstr " (modifié)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - crée des packages Windows Installer (.msi) et MSIX (.msix)\n\nutilisation : rubrapack [--lang <code>] <command> [arguments]\n\ncommandes :\n"

msgid " and its dir"
msgstr " et son dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) n'a pas de variable d'environnement, donc une valeur extensible ne peut pas la contenir ; utilisez une valeur chaîne (remplie à l'installation)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) est un {2} : il peut commencer un chemin, ou remplacer une valeur que Windows Installer remplit (registre, environnement, INI, arguments, messages), mais pas ici"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) n'est pas un dossier par lequel un chemin peut commencer (un ID de dir, ou ProgramFiles, LOCALAPPDATA, ProgramData ... - voir Paths dans le manuel){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  structure :   {2}\n  condensat :   {3}\n  signature :   {4}\n  chaîne :      {5}{6}{7}\n  révocation :  non vérifiée\n  horodatage :  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2} : la variable n'est pas définie"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' n'est pas un contrôle de ce dialogue"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' n'est pas dans {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}' : {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}' : le texte de la licence a besoin du nom anglais de la police, il s'affiche donc dans la police propre à la langue ; écrivez le nom anglais (comme \"Malgun Gothic\") pour utiliser aussi cette police"

msgid "%s component, but the package platform is %.*s"
msgstr "composant {1}, mais la plateforme du package est {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} n'appartient pas à kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} n'appartient pas à kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} contient des LANGID (1..65535), comme 1041"

msgid "%s holds strings"
msgstr "{1} contient des chaînes"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} est une liste de textes \"Clé=Valeur\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} est une liste de textes, par exemple [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} est un nom de police de 1 à 31 caractères, comme \"Segoe UI\" ({2} reçus)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} est une condition MSI aux guillemets fermés et aux parenthèses équilibrées"

msgid "%s is an array of strings, one per value"
msgstr "{1} est un tableau de chaînes, une par valeur"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} concerne les packages MSI : un MSIX n'est pas supprimé par msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} a disparu. Supprimer [file.{2}] ?"

msgid "%s is longer than 240 characters"
msgstr "{1} dépasse 240 caractères"

msgid "%s is new. Add it?"
msgstr "{1} est nouveau. L'ajouter ?"

msgid "%s is not a GUID in registry format"
msgstr "{1} n'est pas un GUID au format du registre"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} n'est pas un code utilisé par ce rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} doit être \"file:<ID>\" et nommer un [file.*] de ce package"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} doit comporter de {2} à {3} lettres, chiffres, '.' ou '-', sans commencer par '.' (reçu : '{4}')"

msgid "%s must be a GUID"
msgstr "{1} doit être un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} doit être un GUID comme {12345678-...} (reçu : '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} doit être une adresse https://, http:// ou file://, ou un chemin \\\\server\\share (reçu : '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} doit différer de upgrade-code (une famille de mise à niveau par architecture)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} nécessite la build {2} de Windows ou ultérieure : définissez [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} nécessite resources/bin/rubrapack_ca-{2}.dll, que ce rubrapack n'inclut pas"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA non vérifiée (indiquez --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA approuvée"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA non approuvée - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} a disparu ou est vide. Supprimer [files.{3}] et [dir.{4}] ?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ est un nouveau dossier. L'ajouter ?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1} : {2} erreur(s){-3}, {4} avertissement(s){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1} : {2} erreur(s){-3}, {4} avertissement(s){-5} (par rapport à {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1} : {2} fichiers, {3} octets\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1} : {2} fichiers, {3} erreurs, 0 avertissement\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1} : {2} autres diagnostics non affichés\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1} : '{2}' n'est pas une action standard que rubrapack place"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1} : le fichier '{2}' n'est pas un [file.*] de ce package"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1} : le fichier '{2}' n'est pas un programme (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' n'est pas fermé (écrivez '$$(' pour le texte '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' existe déjà ; il est laissé tel quel"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' existe déjà ; supprimez-le ou générez dans un autre dossier"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' a déjà un gestionnaire {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' a déjà des autorisations"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' et '{2}' sont le même chemin dans le package"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' appartient à Windows ou aux navigateurs"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' ne peut pas être lu par rapport à '{2}' : {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' ne respecte pas le sous-ensemble TOML ; rien n'a été enregistré"

msgid "'%s' exists already"
msgstr "'{1}' existe déjà"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' existe déjà ; modifiez-le avec `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existe et n'est pas un répertoire vide ; extrayez dans un nouveau"

