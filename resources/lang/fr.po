msgstr "--patch-code prend un GUID en majuscules avec accolades : {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1} : la variable n'est pas définie"

