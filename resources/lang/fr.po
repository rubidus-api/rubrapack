msgstr "--target accepte msi ou msix (reçu : '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots et --proxy vont avec --timestamp"

