msgstr "[shortcut.{1}]: odkaz MSIX zobrazuje logo svojej aplikácie; icon je pre MSI"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args pre MSIX musia byť obyčajný text (bez [...] dopĺňaných pri inštalácii)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: v MSIX odkaz spúšťa aplikáciu: target musí byť spustiteľný súbor [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: položka ponuky Štart v MSIX je jeho aplikácia, ktorá neprijíma args"

