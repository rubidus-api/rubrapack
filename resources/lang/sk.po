msgstr "čo znamená diagnostický kód, správy, ktoré ho nesú, čo robiť a kde príručka hovorí viac"

msgid "with must be \"file:<ID>\""
msgstr "with musí byť \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: súbor '{1}' nie je [file.*] tohto balíka"

