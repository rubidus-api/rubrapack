# rubrapack language pack: Slovak.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: sk\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Slovenčina\n"
"X-Rubrapack-LangIDs: 1051\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialógy {6}{7}\n  1 názov, výrobca, verzia, architektúra         2 priečinok inštalácie, pre koho sa inštaluje\n  3 dialógy, licencia, jazyky                    4 voliteľné časti\n  5 odkazy                                       6 súbory: zosúladiť s priečinkom programu\n  7 ľubovoľný kľúč                               v zobraziť   l lint   s uložiť   q koniec\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nSprávy s týmto kódom (* zastupuje názov alebo hodnotu):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nVýsledky idú na stdout, diagnostika na stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nČo robiť: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} už neexistuje, ale otvára ho odkaz: najprv zmeňte odkazy (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} súborov a {2} priečinkov tam\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s alebo q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  pridané [dir.{1}] a [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  pridané [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  zadajte ho ako table.key, napr. package.version alebo dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: žiadne problémy\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: pozrite problémy vyššie (súbor tam uvedený je kontrolná kópia)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  ostatné jazyky v [ui] languages sa zachovajú; tento zoznam zmeníte cez 7 (ľubovoľný kľúč)\n"

msgid "  removed [file.%s]\n"
msgstr "  odstránené [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  odstránené [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  podpriečinky:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  to nezodpovedá podmnožine TOML; nič sa nezmenilo\n"

msgid "  that was not readable text; again, please\n"
msgstr "  to nebol čitateľný text; znova, prosím\n"

msgid "  the program folder '%s': %s\n"
msgstr "  priečinok programu '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  zdroj nemá tabuľky [file], na ktoré by mohol odkaz ukazovať\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  zdroj nemá podpriečinky v tvare, v akom ich zapisuje `new` ([files] \"<folder>/<name>/**\"); pridajte ich cez 6\n"

msgid "  too long; again, please\n"
msgstr "  príliš dlhé; znova, prosím\n"

msgid "  y or n\n"
msgstr "  y alebo n\n"

msgid " (changed)"
msgstr " (zmenené)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - vytvára balíky Windows Installer (.msi) a MSIX (.msix)\n\npoužitie: rubrapack [--lang <code>] <command> [arguments]\n\npríkazy:\n"

msgid " and its dir"
msgstr " a jeho dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) nemá premennú prostredia, preto ho rozšíriteľná hodnota nemôže obsahovať; použite reťazcovú hodnotu (doplní sa pri inštalácii)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) je {2}: môže začínať cestu alebo zastupovať hodnotu, ktorú dopĺňa Windows Installer (register, prostredie, INI, argumenty, správy), ale nie tu"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nie je priečinok, z ktorého môže začínať cesta (dir ID, alebo ProgramFiles, LOCALAPPDATA, ProgramData ... - pozrite Paths v príručke){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  štruktúra:    {2}\n  digest:       {3}\n  podpis:       {4}\n  reťaz:        {5}{6}{7}\n  odvolanie:    nekontrolované\n  časová pečiatka: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: premenná nie je nastavená"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nie je ovládací prvok tohto dialógu"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nie je v {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': text licencie potrebuje anglický názov písma, preto sa zobrazí písmom daného jazyka; napíšte anglický názov (napr. \"Malgun Gothic\"), aby sa toto písmo použilo aj tam"

msgid "%s component, but the package platform is %.*s"
msgstr "komponent {1}, ale platforma balíka je {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} nepatrí k kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} nepatrí k kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} obsahuje LANGID (1..65535), napr. 1041"

msgid "%s holds strings"
msgstr "{1} obsahuje reťazce"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} je názov písma s 1 až 31 znakmi, napr. \"Segoe UI\" (zadané {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} je podmienka MSI s uzavretými úvodzovkami a vyváženými zátvorkami"

msgid "%s is an array of strings, one per value"
msgstr "{1} je pole reťazcov, jeden pre každú hodnotu"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} je pre balíky MSI: MSIX neodstraňuje msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} už neexistuje. Odstrániť [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} je dlhšie ako 240 znakov"

msgid "%s is new. Add it?"
msgstr "{1} je nové. Pridať?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nie je GUID vo formáte registra"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nie je kód, ktorý tento rubrapack používa{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} musí byť \"file:<ID>\" označujúce [file.*] tohto balíka"

msgid "%s must be a GUID"
msgstr "{1} musí byť GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} musí byť GUID ako {{12345678-...} (zadané '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} musí byť adresa https://, http:// alebo file://, alebo cesta \\\\server\\share (zadané '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} sa musí líšiť od upgrade-code (jedna rodina aktualizácií na architektúru)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} potrebuje Windows build {2} alebo novší: nastavte [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} potrebuje resources/bin/rubrapack_ca-{2}.dll, bez ktorého bol tento rubrapack zostavený"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nekontrolovaná (zadajte --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA dôveryhodná"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nedôveryhodná - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} neexistuje alebo je prázdny. Odstrániť [files.{3}] a [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ je nový priečinok. Pridať?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: chyby: {2}{-3}, upozornenia: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: chyby: {2}{-3}, upozornenia: {4}{-5} (oproti {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} súborov, {3} bajtov\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} súborov, {3} chýb, 0 upozornení\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: ďalších {2} diagnostík sa nezobrazilo\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: súbor '{2}' nie je [file.*] tohto balíka"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: súbor '{2}' nie je program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' nie je uzavreté (pre text '$(' napíšte '$$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' už existuje; ponecháva sa tak, ako je"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' už existuje; odstráňte ho alebo zostavte do iného priečinka"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' už má obslužný program {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' už má povolenia"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' a '{2}' sú v balíku tá istá cesta"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' patrí systému Windows alebo prehliadačom"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' sa nedá prečítať voči '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' nezodpovedá podmnožine TOML; nič sa neuložilo"

msgid "'%s' exists already"
msgstr "'{1}' už existuje"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' už existuje; zmeňte ho cez `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existuje a nie je prázdny adresár; rozbaľte do nového"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' ide do {2}; alebo msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' má nečitateľný prúd súhrnných informácií"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' nemá tabuľky Directory, Component, File a Media, z ktorých by sa dalo rozbaliť"

msgid "'%s' has no readable summary information"
msgstr "'{1}' nemá čitateľné súhrnné informácie"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nemá transformáciu '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' je UTF-16: edit mení len zdroje v UTF-8 (najprv ho uložte ako UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' je názov systému Windows; dajte premennej iný názov"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' je [chain]: vytvára inštalačný program, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' je ovládací prvok vstavaného rámca; vyberte iné ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' je priečinok počítača; balík {2} tam nemôže zapisovať"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' je zlučovací modul: zlúčte ho cez [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' je názov, ktorý si formát MSIX vyhradzuje"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' je symbolický odkaz; odkazy sa nesledujú"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' je aj [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' je aj dir ID; dajte premennej iný názov"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' je zostavený pre stroj 0x{2}, nie pre architektúru tohto balíka; nastavte any-arch = true, ak je to zámerné"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nie je ani súbor PE (.exe, .dll), ani balík MSI, ani balík či zväzok MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nie je ani súbor PE, ani balík MSI, ani balík či zväzok MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nie je ani známy priečinok, ani dir ID (známe priečinky: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' nie je cabinet, ktorý rubrapack vie čítať (stored alebo MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' nie je diagnostický kód (RP a štyri číslice, napr. RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' nie je program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nie je bežný súbor"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nie je inštalačný program rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nie je platné ID (písmená, číslice a '_', nezačína číslicou, najviac {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nie je platná databáza MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' nie je platný balík MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nie je platný balík: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nie je platný zdroj (podmnožina TOML); najprv ho opravte ručne"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nie je platná transformácia: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nie je platný názov premennej"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' je vyhradené a nedá sa použiť ako ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' je názov dir: dir môže vyplniť len vyhľadávanie v registri alebo dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' vyzerá ako programový súbor (PE), ale jeho hlavičky alebo prostriedky sú poškodené"

msgid "'%s' must be a string"
msgstr "'{1}' musí byť reťazec"

msgid "'%s' must be an integer"
msgstr "'{1}' musí byť celé číslo"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' musí byť medzi {2} a {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' musí byť true alebo false"

msgid "'%s' must not be empty"
msgstr "'{1}' nesmie byť prázdne"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' neuvádza žiadne transformácie (súhrnná vlastnosť 8): nie je opravou"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' začína priečinkom: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' má {4}; nič sa nerozbalilo"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} položiek, viac ako limit {3} (--limit-entries); nič sa nerozbalilo"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' a '{3}' by boli v systéme Windows tá istá cesta; nič sa nerozbalilo"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nie je v [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': tabuľku nemožno prečítať"

msgid "'%s': a table is unreadable"
msgstr "'{1}': tabuľka je nečitateľná"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX inštaluje všetky svoje súbory (when); použite msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX odstraňuje všetky svoje súbory (keep); použite msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' je poškodený alebo nie je stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': názov cabinetu '{2}' nie je obyčajný názov súboru"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimovaný súbor '{2}' (poradie {3}) nemá cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': adresár '{2}' má nadradený '{3}', ktorý neexistuje"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': adresár '{2}' je svojím vlastným predkom alebo je vnorený príliš hlboko"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': súbor '{2}' nezodpovedá svojmu MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': súbor '{2}' nemá komponent ani adresár"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': súbor '{2}' má {3} bajtov, tabuľka File uvádza {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': súbor '{2}' nie je v cabinete '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': jeho externé cabinety nie sú pokryté podpisom (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': jeho priečinok nevedie na známe miesto"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': viac ako {2} bajtov na zápis (--limit-bytes); nič sa nerozbalilo"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': bez --timestamp: podpis prestane platiť, keď certifikát vyprší"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': balík '{2}' nezodpovedá svojmu SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': prúd cabinetu '{2}' neexistuje"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifest nemá {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifest uvádza '{2}', ktoré nie je v balíku"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': časová pečiatka z {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformáciu '{2}' nemožno prečítať voči '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' je vlastný jazyk balíka ({2}); zadajte ten text bez prípony"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' spôsobí, že Windows Installer zapíše viacreťazcovú hodnotu; použite type = \"multi\" a pole"

msgid "'_' in numbers is not supported"
msgstr "'_' v číslach nie je podporované"

msgid "'help' takes at most one command name"
msgstr "'help' prijíma najviac jeden názov príkazu"

msgid "'version' takes no arguments"
msgstr "'version' neprijíma argumenty"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs je pre .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch pre zväzok: zoznam x64, x86 a arm64, každý raz (zadané '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch prijíma jednu architektúru alebo zoznam pre výstup .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp a --allow-unsigned-cabs patria k --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress je pre .msi; MSIX prijíma --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist určuje nový priečinok vedľa zdroja (bez cesty)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs prijíma číslo od 1 do 64 (zadané '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store je úložisko certifikátov systému Windows; inde použite súbor kľúča alebo --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store prijíma odtlačok SHA-1 certifikátu (40 šestnástkových číslic)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: taký jazyk neexistuje (vstavané: {2}; iný potrebuje svoj jazykový balík, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (alebo RUBRAPACK_LANG) vyberá jazyk týchto textov: {1}, alebo jazyk s jazykovým balíkom.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang potrebuje jazyk, napr. en alebo ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages potrebuje dialógy: zadajte aj --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress prijíma deflate alebo store (zadané '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: premenná nie je nastavená"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code prijíma GUID veľkými písmenami so zátvorkami: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: premenná nie je nastavená"

msgid "--previous compares two .msi packages"
msgstr "--previous porovnáva dva balíky .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: koreňové certifikáty operačného systému nemožno prečítať"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} nezodpovedá výstupu '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} nie je implementovaný (msi alebo msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target prijíma msi alebo msix (zadané '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots a --proxy patria k --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test a --msix-compress sú pre výstupy .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test je pre balíky bez podpisu; s --key ho vynechajte"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate prijíma none alebo niektoré z product-code,upgrade-code,language,platform"

msgid "-D %.*s is given twice"
msgstr "-D {1} je zadané dvakrát"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' je názov systému Windows; dajte premennej iný názov"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D potrebuje NAME=VALUE (zadané '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i sa pýta na každú odpoveď; zadajte buď -i, alebo možnosti"

msgid "; its range is "
msgstr "; jeho rozsah je "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' nie je v SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty musí byť verejná vlastnosť (veľkými písmenami)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "Všetky kódy: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x nezačína PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x nie je posledná položka"

msgid "Architecture (x64, x86, arm64)"
msgstr "Architektúra (x64, x86, arm64)"

msgid "Choose"
msgstr "Vyberte"

msgid "Command line"
msgstr "Príkazový riadok"

msgid "Command line (lint)"
msgstr "Príkazový riadok (lint)"

msgid "Common AppData"
msgstr "Spoločné AppData"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId nie je GUID vo formáte registra"

msgid "Desktop shortcut?"
msgstr "Odkaz na pracovnej ploche?"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "Dialógy (none, basic, minimal, installdir, features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "Návratové kódy: 0 v poriadku, 1 chyba zdroja, 2 použitie, 3 vstup/výstup, 4 podpisovanie alebo overenie,\n5 lint, 6 sieť.\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "Tabuľke File, Component alebo Directory chýba štandardný stĺpec"

msgid "Folder name under Program Files"
msgstr "Názov priečinka v Program Files"

msgid "Folder with the files to install"
msgstr "Priečinok so súbormi na inštaláciu"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "ID '{1}' sa už používa (riadok {2}); ID sa musia líšiť naprieč všetkými tabuľkami"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "Priečinok inštalácie (cesta [dir.INSTALLDIR])"

msgid "Install for (machine, user, dual)"
msgstr "Inštalovať pre (machine, user, dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "Kľúč ako table.key (package.version, dir.INSTALLDIR.path, ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' patrí inému komponentu"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' nie je v File"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' nie je v Registry"

msgid "Korean dialogs as well as English?"
msgstr "Dialógy v kórejčine popri angličtine?"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} je nižšie ako pri nižšom DiskId"

msgid "Leave without saving the changes?"
msgstr "Odísť bez uloženia zmien?"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "Licencia na prijatie (.txt, .md, .rtf; - pre žiadnu)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "MSIX nemá virtuálny priečinok pre AppData používateľa; aplikácia si tam pri spustení vytvorí, čo potrebuje"

msgid "MSIX packages"
msgstr "Balíky MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: čo balík MSIX potrebuje a čo nemôže obsahovať"

msgid "Main program, for shortcuts (- for none)"
msgstr "Hlavný program, pre odkazy (- pre žiadny)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "Príručka: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Výrobca"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Výrobca (zobrazí sa v Nainštalovaných aplikáciách)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt vrátil podpis ECDSA nesprávnej dĺžky"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "Voliteľné časti, ktoré môže používateľ zaškrtnúť (podpriečinky, čiarkami; - pre žiadne)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "Token PKCS#11: token neobsahuje certifikát s CKA_ID kľúča (zadajte ho cez --cert)"

msgid "Paths"
msgstr "Cesty"

msgid "Product name"
msgstr "Názov produktu"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode a UpgradeCode sú ten istý GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} nie je v prvých troch poliach vyššia ako predchádzajúca {2}: Windows Installer neaktualizuje"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Program, ktorý otvárajú odkazy (- bez odkazov)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: taký jazyk neexistuje (vstavané: {2}; iný potrebuje svoj jazykový balík, {3}.po)"

msgid "Reference, "
msgstr "Referencia, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Poradie {1} nepokrýva žiadny riadok Media (posledný {2})"

msgid "Sequence %ld is used by another file"
msgstr "Poradie {1} používa iný súbor"

msgid "Source file to write"
msgstr "Zdrojový súbor na zápis"

msgid "Source format"
msgstr "Formát zdroja"

msgid "Source must name a File row for type %ld"
msgstr "Source musí uvádzať riadok File pre typ {1}"

msgid "Start menu shortcut?"
msgstr "Odkaz v ponuke Štart?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Položky ponuky Štart, Programs, pracovnej plochy a Startup pochádzajú z [shortcut.*] a [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML mimo podmnožiny, ktorú rubrapack číta, alebo `format` chýba či je príliš nový"

msgid "Tables"
msgstr "Tabuľky"

msgid "The TOML subset"
msgstr "Podmnožina TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Súbory UTF-16 big-endian nie sú podporované; uložte ako UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} sa líši od {2} predchádzajúcej verzie: tento balík ju nenahrádza"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode nie je GUID vo formáte registra"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Hodnota (text, číslo, true/false, [\"a\", \"b\"]; - odstráni kľúč)"

msgid "Variables"
msgstr "Premenné"

msgid "Version"
msgstr "Verzia"

msgid "Version ([define] VERSION)"
msgstr "Verzia ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Verzie a aktualizácie"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer povoľuje najviac 255.255.65535(.65535)"

msgid "Windows name"
msgstr "názov Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] potrebuje '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] nemôže byť v zlučovacom module; má ho balík, ktorý ho zlučuje"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] zatiaľ nie je podporované (plánované pre {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] nemôže byť v MSIX; pridajte msi-only = true, aby sa MSIX zostavil bez neho"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] je v AppData alebo LocalAppData používateľa: balík dual nainštalovaný pre všetkých používateľov ho umiestni len do profilu inštalujúceho používateľa"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID v zlučovacom module má najviac 35 znakov (pridá sa k nemu GUID modulu)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] potrebuje ID: napíšte [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] neprijíma ID: napíšte [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml nemá </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml nie je posledná položka (nie je to balík zapísaný rubrapack alebo rozhraním API balíkov Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Polia tabuliek [[...]] nie sú podporované; každej položke dajte vlastné [kind.ID]"

msgid "[action.%s] check has no effect: nothing runs it yet; remove it"
msgstr "check v [action.{1}] nemá účinok: zatiaľ ho nič nespúšťa; odstráňte ho"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] potrebuje do aj undo (undo vráti aj neúspešné do)"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args pre MSIX musia byť obyčajný text (bez [...] dopĺňaných pri inštalácii)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: v MSIX typ súboru otvára aplikáciu: target musí byť spustiteľný súbor [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] je tam dvakrát"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] potrebuje ID: napíšte [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id a typelib sa zapisujú len pre MSI; MSIX registruje triedu bez nich"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args patria programu; DLL sa načíta, nespúšťa"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate spúšťa DLL v dllhost; '{2}' je program"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading je pre DLL; program si nastavuje vlastný apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version a typelib-file potrebujú typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] ide do {2}; alebo msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: jeho zdroj musí byť súbor, ktorý ide do balíka"

msgid "[define] values must be strings"
msgstr "Hodnoty [define] musia byť reťazce"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] potrebuje '{2}'"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] potrebuje 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] potrebuje 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] potrebuje 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] má {2} ovládacích prvkov; najviac 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] nemá [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] je umiestnený za sebou samým cez iné dialógy"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] potrebuje ui = \"minimal\", \"installdir\" alebo \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' je názov systému Windows; dajte dir iné ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard potrebuje pomocnú knižnicu DLL rubrapack, ktorú zlučovací modul nemá"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] potrebuje funkciu"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX nastaví všetky svoje premenné (when); použite msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: jeho hodnota uvádza miesto, ktoré MSIX nemôže poskytnúť (priečinok mimo balíka, ktorý nie je priečinkom systému Windows, alebo časť z času inštalácie); použite msi-only = true"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] je v profile používateľa a má component-guid: cestou kľúča zostáva súbor, kde pravidlá Windows chcú hodnotu HKCU (ICE38); vynechajte component-guid, aby ste ju získali"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Prieskumník načítava obslužný program {2} z DLL; [com.{3}] je program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows číta obslužné programy vlastností len pre počítač; balík potrebuje scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: obslužný program ukážky beží v prevhost systému Windows; vynechajte app-id a surrogate z [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX obsahuje len obslužné programy miniatúr a ukážok (zabalený obslužný program vlastností nedal Prieskumníkovi žiadne hodnoty); msi-only = true ho ponechá pre MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: typ súboru MSIX patrí aplikácii; pridajte [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: trieda {2} nie je [com.*] tohto balíka (obsluhuje ju DLL obslužného programu)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: v MSIX obslužné programy zdieľajú všetky svoje typy alebo žiadny (typ je v jednom priradení typu súboru)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: v MSIX jeho trieda beží v surrogate; threading = \"sta\" v [com.{2}] dá jej oknu slučku správ (s threading = {3} môže ukážka zostať prázdna)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: v MSIX sú všetky jeho typy v jednom type súboru [assoc], alebo v žiadnom"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: jeho trieda je msi-only ([com.{2}]); MSIX by pre ňu nemal server"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types je zoznam typov súborov, napr. [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] ide do {2}; alebo msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] potrebuje 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] potrebuje funkciu: nastavte 'feature' tu alebo na jeho dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX zapíše všetky svoje položky INI (when); použite msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: jeho hodnota má časť, ktorú Windows Installer dopĺňa pri inštalácii ([...]); MSIX zapíše súbor pri zostavení"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] potrebuje 'on': kde sa položka zobrazí, napr. [\".txt\"] alebo \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] potrebuje 'target' (program, ktorý spúšťa) alebo položky s parent = \"{2}\" (podponuka)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] potrebuje 'target': program, ktorý položka spúšťa"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: podponuka nič nespúšťa: vynechajte 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: položka podponuky sa zobrazí tam, kde jej podponuka: vynechajte 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args má časť, ktorú Windows Installer dopĺňa pri inštalácii ([...]); MSIX obsahuje len pevný text"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: jeho program nie je v MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: jeho hodnoty nemôžu ísť do registra balíka"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": neexistuje [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on je typ súboru alebo ich zoznam, napr. [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' nie je [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' musí byť podponuka: [menu.*] bez target a bez vlastného parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] ide do {2}; alebo msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] potrebuje funkciu: nastavte 'feature' tu alebo na jeho dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; alebo msi-only = true"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args musia byť obyčajný text (bez [...] dopĺňaných pri inštalácii)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file musí byť {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file musí uvádzať súbor, ktorý ide do balíka"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file musí uvádzať program, ktorý ide do balíka"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types je zoznam typov súborov, napr. [\".txt\", \"*\"]"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] potrebuje, aby jeho dir mal funkciu"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args pre MSIX musia byť obyčajný text (bez [...] dopĺňaných pri inštalácii)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: v MSIX schéma otvára aplikáciu: target musí byť spustiteľný súbor [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] potrebuje 'value' (alebo remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR nesiaha mimo MSIX; použite [assoc.*], [protocol.*], [com.*] alebo [handler.*], alebo msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: hodnota qword potrebuje pomocnú knižnicu DLL rubrapack, ktorú zlučovací modul nemá"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX obsahuje hodnoty len pod {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX hodnoty ani neodstraňuje, ani ich nenecháva (remove, keep); použite msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX zapíše všetky svoje hodnoty (when); použite msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: jeho hodnota má časť, ktorú Windows Installer dopĺňa pri inštalácii ([...]); MSIX obsahuje len pevné hodnoty"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" potrebuje pomocnú knižnicu DLL rubrapack, ktorú zlučovací modul nemá"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: názov kľúča alebo hodnoty nemôže ísť do hive registra"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" je pre root = \"HKCU\" s on = \"uninstall\", v balíku pre počítač"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] potrebuje funkciu: nastavte 'feature' tu alebo na jeho dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true nie je pre priečinok pod {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true potrebuje pomocnú knižnicu DLL rubrapack, ktorú zlučovací modul nemá"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" je pre recursive = true na priečinku v AppData alebo LocalAppData, v balíku pre počítač"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args pre MSIX musia byť obyčajný text (bez [...] dopĺňaných pri inštalácii)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file musí uvádzať program, ktorý ide do balíka"

