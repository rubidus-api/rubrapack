msgstr "názov premennej '{1}' nesmie obsahovať '=' ani začínať = + - ! *"

msgid "variables"
msgstr "premenné"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "premenné: $(NAME) bez hodnoty, neuzavreté $(, názov systému Windows alebo dir ID tam, kde nemôže stáť"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "verzia '{1}' musí byť a.b.c alebo a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "verzia '{1}' musí byť a.b.c alebo a.b.c.d s a, b <= 255 a c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" nemôže ísť 'with' súborom 64-bitového balíka"

