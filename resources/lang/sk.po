msgstr "Zrušiť"

msgctxt "installer"
msgid "Setup.RemoveAsk"
msgstr "Odstrániť tieto programy z tohto počítača?"

msgctxt "installer"
msgid "Setup.Removed"
msgstr "Programy sa odstránili."

msgctxt "installer"
msgid "Setup.RemoveFailed"
msgstr "Jeden program sa nepodarilo odstrániť."

msgctxt "installer"
msgid "Setup.TempFailed"
msgstr "Inštalačný program nemohol vytvoriť dočasný priečinok."

msgctxt "installer"
msgid "Setup.RepairFailed"
msgstr "{1} sa nepodarilo opraviť (chyba {2})."

msgctxt "installer"
msgid "Setup.InstallFailed"
msgstr "{1} sa nepodarilo nainštalovať (chyba {2}). Nič po ňom sa nenainštalovalo."

msgctxt "installer"
msgid "Setup.Repaired"
msgstr "Programy sa opravili."

msgctxt "installer"
msgid "Setup.Finished"
msgstr "Inštalácia sa skončila."

msgctxt "installer"
msgid "DirNotEmptyText"
msgstr "Tento priečinok už obsahuje súbory alebo priečinky. Keď sa [ProductName] odstráni, odstráni sa všetko v priečinku - aj to, čo je v ňom teraz. Prázdny alebo nový priečinok je bezpečná voľba."

msgctxt "installer"
msgid "DirChoose"
msgstr "&Vybrať iný"

msgctxt "installer"
msgid "DirContinue"
msgstr "&Tento priečinok"

msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] program(y) používajú súbory produktu [3]:\r\n[2]\r\nZavrieť všetky?\r\n\r\nÁno: zavrieť všetky a pokračovať (neuložená práca sa môže stratiť).\r\nNie: pokračovať bez zatvorenia (už otvorené programy ponechajú staré súbory, kým sa znova neotvoria).\r\nZrušiť: zastaviť."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: zastavené, pretože [1] program(y) používajú jeho súbory:\r\n[2]Zatvorte ich a skúste znova alebo zadajte RPCLOSE=yes (zavrieť všetky a pokračovať) alebo RPCLOSE=no (pokračovať bez zatvorenia)."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] položiek v priečinkoch produktu [3] sa s ním nenainštalovalo:\r\n[2]\r\nOdstrániť aj ich?\r\n\r\nÁno: odstrániť ich spolu s [3] (nedajú sa vrátiť).\r\nNie: odstrániť [3] a ponechať ich.\r\nZrušiť: zastaviť."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: zastavené, pretože [1] položiek v jeho priečinkoch sa s ním nenainštalovalo:\r\n[2]Zadajte RPEXTRA=delete (odstrániť aj ich) alebo RPEXTRA=keep (ponechať ich) a potom ho znova odstráňte."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "[1] ďalších používateľov tohto počítača môže mať nastavenia alebo údaje produktu [3]:\r\n[2]\r\nOdstrániť aj ich?\r\n\r\nÁno: odstrániť ich pre všetkých používateľov (nedajú sa obnoviť).\r\nNie: odstrániť len vaše.\r\nZrušiť: zastaviť."
