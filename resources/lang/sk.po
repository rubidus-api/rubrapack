msgid "usage: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"
msgstr "použitie: rubrapack keys list [--pkcs11 <module> [--token-label <label>] [--pin-env VAR | --pin-file FILE]]"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "použitie: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "použitie: rubrapack lint <file.msix|file.msixbundle> [--strict]"

