msgstr "'{1}': Datei '{2}' stimmt nicht mit ihrem MsiFileHash überein"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': Datei '{2}' hat keine Komponente oder kein Verzeichnis"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': Datei '{2}' hat {3} Byte, die File-Tabelle sagt {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': Datei '{2}' ist nicht im Cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': Seine externen Cabinets sind nicht von der Signatur abgedeckt (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': sein Ordner führt nicht zu einem bekannten Ort"

