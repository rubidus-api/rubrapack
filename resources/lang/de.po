msgstr "'{1}': kein --timestamp: Die Signatur wird ungültig, wenn das Zertifikat abläuft"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': Paket '{2}' stimmt nicht mit seinem SHA-256 überein"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': Der Cabinet-Stream '{2}' ist nicht vorhanden"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': Das Manifest hat kein {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': Das Manifest nennt '{2}', das nicht im Paket ist"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': Zeitstempel von {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': Transformation '{2}' kann nicht gegen '{3}' gelesen werden: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' ist die eigene Sprache des Pakets ({2}); geben Sie diesen Text ohne das Suffix an"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' lässt Windows Installer eine Mehrfachzeichenfolge schreiben; verwenden Sie type = \"multi\" und ein Array"

msgid "'_' in numbers is not supported"
msgstr "'_' in Zahlen wird nicht unterstützt"

msgid "'help' takes at most one command name"
msgstr "'help' nimmt höchstens einen Befehlsnamen"

msgid "'version' takes no arguments"
msgstr "'version' nimmt keine Argumente"

