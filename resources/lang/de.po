msgstr "'{1}' ist kein Diagnosecode (RP und vier Ziffern, etwa RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' ist kein Programm (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' ist keine reguläre Datei"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' ist kein rubrapack-Setup-Programm{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' ist keine gültige ID (Buchstaben, Ziffern und '_', nicht mit einer Ziffer beginnend, höchstens {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' ist keine gültige MSI-Datenbank: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' ist kein gültiges MSIX-Paket: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' ist kein gültiges Paket: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' ist keine gültige Quelle (die TOML-Teilmenge); korrigieren Sie sie zuerst von Hand"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' ist keine gültige Transformation: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' ist kein gültiger Variablenname"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' ist reserviert und kann nicht als ID verwendet werden"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' ist der Name eines dir: Nur eine Registrierungs- oder dir-Suche kann ein dir füllen"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' sieht wie eine Programmdatei (PE) aus, aber ihre Header oder Ressourcen sind beschädigt"

msgid "'%s' must be a string"
msgstr "'{1}' muss eine Zeichenfolge sein"

msgid "'%s' must be an integer"
msgstr "'{1}' muss eine ganze Zahl sein"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' muss zwischen {2} und {3} liegen"

msgid "'%s' must be true or false"
msgstr "'{1}' muss true oder false sein"

msgid "'%s' must not be empty"
msgstr "'{1}' darf nicht leer sein"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' nennt keine Transformationen (Zusammenfassungseigenschaft 8): kein Patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' beginnt mit einem Ordner: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' hat {4}; nichts wurde extrahiert"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} Einträge, mehr als die Grenze {3} (--limit-entries); nichts wurde extrahiert"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' und '{3}' wären unter Windows derselbe Pfad; nichts wurde extrahiert"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' ist nicht in [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': eine Tabelle kann nicht gelesen werden"

msgid "'%s': a table is unreadable"
msgstr "'{1}': eine Tabelle ist unlesbar"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': Ein MSIX installiert alle seine Dateien (when); verwenden Sie msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': Ein MSIX entfernt alle seine Dateien (keep); verwenden Sie msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': Cabinet '{2}' ist beschädigt oder nicht stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': Cabinet-Name '{2}' ist kein einfacher Dateiname"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimierte Datei '{2}' (Sequenz {3}) hat kein Cabinet"

