msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] konnte nicht installiert werden, und das Rückgängigmachen hat nicht alles entfernt. Was übrig ist, steht unten. Starten Sie das Setup erneut und entfernen Sie [1] dann, wenn Sie es nicht möchten.\r\nProtokoll: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] konnte nicht aktualisiert werden, und das Rückgängigmachen hat Ihre bisherige Version nicht wiederhergestellt. Die Unterschiede stehen unten. Reparieren Sie sie mit dem Setup dieser Version oder installieren Sie die neue Version erneut.\r\nProtokoll: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] konnte nicht entfernt werden, und das Rückgängigmachen hat es nicht wiederhergestellt. Die Unterschiede stehen unten. Reparieren Sie es mit seinem Setup und entfernen Sie es dann erneut.\r\nProtokoll: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] konnte nicht repariert werden, und das Rückgängigmachen hat es nicht wiederhergestellt. Die Unterschiede stehen unten. Starten Sie das Setup erneut, um es zu reparieren.\r\nProtokoll: [2]"
