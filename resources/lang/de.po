msgstr "'{1}' hat einen unlesbaren Zusammenfassungsinformationsstream"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' hat keine Directory-, Component-, File- und Media-Tabellen zum Extrahieren"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' hat keine eingebettete Transformation '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' hat keine lesbaren Zusammenfassungsinformationen"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' hat keine Transformation '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' ist UTF-16: edit ändert nur UTF-8-Quellen (speichern Sie sie zuerst als UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' ist ein Windows-Name; geben Sie der Variablen einen anderen Namen"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' ist ein [chain]: Es baut ein Setup-Programm, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' ist ein Steuerelement des eingebauten Rahmens; wählen Sie eine andere ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' ist ein Computerordner; ein {2}-Paket kann dort nicht schreiben"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' ist ein Mergemodul: führen Sie es stattdessen mit [merge.ID] zusammen"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' ist ein Name, den das MSIX-Format für sich reserviert"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' ist eine symbolische Verknüpfung; Verknüpfungen werden nicht verfolgt"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' ist auch eine [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' ist auch eine dir-ID; geben Sie der Variablen einen anderen Namen"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' ist für Maschine 0x{2} gebaut, nicht für die arch dieses Pakets; setzen Sie any-arch = true, wenn das beabsichtigt ist"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' ist weder eine PE-Datei (.exe, .dll) noch ein MSI-Paket noch ein MSIX-Paket oder -Bundle noch ein Cabinet"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' ist weder eine PE-Datei noch ein MSI-Paket noch ein MSIX-Paket oder -Bundle noch ein Cabinet"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' ist weder ein bekannter Ordner noch eine dir-ID (bekannte Ordner: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' ist weder ein MSIX-Paket noch ein Paketfamilienname (<Name>_<publisher ID>)"

