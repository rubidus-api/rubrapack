# rubrapack language pack: German.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: de\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Deutsch\n"
"X-Rubrapack-LangIDs: 1031, 2055, 3079, 4103, 5127\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, Dialoge {6}{7}\n  1 Name, Hersteller, Version, Architektur       2 Installationsordner, für wen\n  3 Dialoge, Lizenz, Sprachen                    4 optionale Teile\n  5 Verknüpfungen                                6 Dateien: an den Programmordner anpassen\n  7 beliebiger Schlüssel                         v anzeigen   l lint   s speichern   q beenden\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMeldungen mit diesem Code (* steht für einen Namen oder Wert):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nErgebnisse gehen nach stdout, Diagnosen nach stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nWas zu tun ist: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} ist nicht mehr vorhanden, aber eine Verknüpfung öffnet es: ändern Sie zuerst die Verknüpfungen (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  dort sind {1} Dateien und {2} Ordner\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s oder q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] und [files.{2}] hinzugefügt\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] hinzugefügt\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  geben Sie es als Tabelle.Schlüssel an, etwa package.version oder dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: keine Probleme\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: siehe die Probleme oben (die dort genannte Datei ist eine Prüfkopie)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  andere Sprachen in [ui] languages bleiben erhalten; ändern Sie diese Liste mit 7 (beliebiger Schlüssel)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] entfernt\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} entfernt\n"

msgid "  sub folders:"
msgstr "  Unterordner:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  das passt nicht in die TOML-Teilmenge; nichts wurde geändert\n"

msgid "  that was not readable text; again, please\n"
msgstr "  das war kein lesbarer Text; bitte noch einmal\n"

msgid "  the program folder '%s': %s\n"
msgstr "  der Programmordner '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  die Quelle hat keine [file]-Tabellen, auf die eine Verknüpfung zeigen kann\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  die Quelle hat keine Unterordner, wie `new` sie schreibt ([files] \"<folder>/<name>/**\"); fügen Sie sie mit 6 hinzu\n"

msgid "  too long; again, please\n"
msgstr "  zu lang; bitte noch einmal\n"

msgid "  y or n\n"
msgstr "  y oder n\n"

msgid " (changed)"
msgstr " (geändert)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - erstellt Windows Installer- (.msi) und MSIX-Pakete (.msix)\n\nAufruf: rubrapack [--lang <code>] <command> [arguments]\n\nBefehle:\n"

msgid " and its dir"
msgstr " und sein dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) hat keine Umgebungsvariable, daher kann ein erweiterbarer Wert es nicht enthalten; verwenden Sie einen Zeichenfolgenwert (bei der Installation gefüllt)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) ist ein {2}: Es kann einen Pfad beginnen oder für einen Wert stehen, den Windows Installer füllt (Registrierung, Umgebung, INI, Argumente, Meldungen), aber nicht hier"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ist kein Ordner, mit dem ein Pfad beginnen kann (eine dir-ID oder ProgramFiles, LOCALAPPDATA, ProgramData ... - siehe Paths im Handbuch){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  Struktur:     {2}\n  Digest:       {3}\n  Signatur:     {4}\n  Kette:        {5}{6}{7}\n  Sperrprüfung: nicht geprüft\n  Zeitstempel:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: die Variable ist nicht gesetzt"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' ist kein Steuerelement dieses Dialogs"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' ist nicht in {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': Der Lizenztext braucht den englischen Namen der Schriftart und wird daher in der Schriftart der Sprache angezeigt; schreiben Sie den englischen Namen (etwa \"Malgun Gothic\"), um auch dort diese Schriftart zu verwenden"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' muss ein Ordner sein"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-Komponente, aber die Plattform des Pakets ist {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} gehört nicht zu kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} gehört nicht zu kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} enthält LANGIDs (1..65535), etwa 1041"

msgid "%s holds strings"
msgstr "{1} enthält Zeichenfolgen"

msgid "%s is %u to %u characters long"
msgstr "{1} ist {2} bis {3} Zeichen lang"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} ist eine Liste von \"Schlüssel=Wert\"-Texten"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} ist eine Liste von Texten, etwa [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} ist ein Schriftartname mit 1 bis 31 Zeichen, etwa \"Segoe UI\" (erhalten: {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} ist eine MSI-Bedingung mit geschlossenen Anführungszeichen und ausgeglichenen Klammern"

msgid "%s is an array of strings, one per value"
msgstr "{1} ist ein Array von Zeichenfolgen, eine pro Wert"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} gilt für MSI-Pakete: Ein MSIX wird nicht von msiexec entfernt"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} ist nicht mehr vorhanden. [file.{2}] entfernen?"

msgid "%s is longer than 240 characters"
msgstr "{1} ist länger als 240 Zeichen"

msgid "%s is new. Add it?"
msgstr "{1} ist neu. Hinzufügen?"

msgid "%s is not a GUID in registry format"
msgstr "{1} ist keine GUID im Registrierungsformat"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ist kein Code, den dieses rubrapack verwendet{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} muss \"file:<ID>\" sein und ein [file.*] dieses Pakets nennen"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} muss aus {2} bis {3} Buchstaben, Ziffern, '.' oder '-' bestehen und darf nicht mit '.' beginnen (erhalten: '{4}')"

msgid "%s must be a GUID"
msgstr "{1} muss eine GUID sein"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} muss eine GUID wie {12345678-...} sein (erhalten: '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} muss eine http://- oder https://-Adresse sein (erhalten '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} muss eine https://-, http://- oder file://-Adresse oder ein \\\\server\\share-Pfad sein (erhalten: '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} muss sich von upgrade-code unterscheiden (eine Upgrade-Familie pro Architektur)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} benötigt Windows-Build {2} oder höher: setzen Sie [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} benötigt resources/bin/rubrapack_ca-{2}.dll, ohne die dieses rubrapack gebaut wurde"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA nicht geprüft (geben Sie --tsa-trust an)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA vertrauenswürdig"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nicht vertrauenswürdig - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} ist nicht mehr vorhanden oder leer. [files.{3}] und [dir.{4}] entfernen?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ ist ein neuer Ordner. Hinzufügen?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} Fehler{-3}, {4} Warnung(en){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} Fehler{-3}, {4} Warnung(en){-5} (gegenüber {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} Dateien, {3} Byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} Dateien, {3} Fehler, 0 Warnungen\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} weitere Diagnosen nicht angezeigt\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' ist keine Standardaktion, die rubrapack platziert"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: Datei '{2}' ist kein [file.*] dieses Pakets"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: Datei '{2}' ist kein Programm (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' ist nicht geschlossen (schreiben Sie '$$(' für den Text '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' ist bereits vorhanden; es bleibt unverändert"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' ist bereits vorhanden; entfernen Sie es oder bauen Sie in einen anderen Ordner"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' hat bereits einen {2}-Handler ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' hat bereits Berechtigungen"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' und '{2}' sind im Paket derselbe Pfad"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' gehört zu Windows oder den Browsern"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' kann nicht gegen '{2}' gelesen werden: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' passt nicht in die TOML-Teilmenge; nichts wurde gespeichert"

msgid "'%s' exists already"
msgstr "'{1}' ist bereits vorhanden"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' ist bereits vorhanden; ändern Sie es mit `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' ist vorhanden und kein leeres Verzeichnis; extrahieren Sie in ein neues"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' gehört in {2}; oder msi-only = true"

