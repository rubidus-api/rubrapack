msgstr "[{1}.{2}] negali būti MSIX; pridėkite msi-only = true, kad MSIX būtų sukurtas be jo"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] yra naudotojo AppData arba LocalAppData aplanke: visiems naudotojams įdiegtas dual paketas jį padeda tik diegiančio naudotojo profilyje"

