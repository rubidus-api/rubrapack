msgstr "[{1}.{2}]: ID suliejimo modulyje turi ne daugiau kaip 35 simbolius (prie jo pridedamas modulio GUID)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] reikia ID: rašykite [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] nepriima ID: rašykite [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml neturi </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml nėra paskutinis įrašas (tai ne paketas, kurį parašė rubrapack ar Windows paketų API)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Lentelių masyvai [[...]] nepalaikomi; kiekvienam elementui duokite savo [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] dedamas vieną kartą: before, after arba sequence"

