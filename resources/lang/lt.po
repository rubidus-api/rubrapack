msgstr "--pass-env {1}: kintamasis nenustatytas"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code priima GUID didžiosiomis raidėmis su riestiniais skliaustais: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: kintamasis nenustatytas"

msgid "--previous compares two .msi packages"
msgstr "--previous palygina du .msi paketus"

