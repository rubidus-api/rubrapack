# rubrapack language pack: Lithuanian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: lt\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Lietuvių\n"
"X-Rubrapack-LangIDs: 1063\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 7\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialogai {6}{7}\n  1 pavadinimas, gamintojas, versija, architektūra  2 diegimo aplankas, kam diegiama\n  3 dialogai, licencija, kalbos                  4 pasirenkamos dalys\n  5 nuorodos                                     6 failai: suderinti su programos aplanku\n  7 bet kuris raktas                             v rodyti   l lint   s įrašyti   q išeiti\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nPranešimai su šiuo kodu (* reiškia pavadinimą arba reikšmę):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nRezultatai siunčiami į stdout, diagnostika į stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nKą daryti: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} nebėra, bet nuoroda jį atveria: pirmiausia pakeiskite nuorodas (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} failai ir {2} aplankai ten\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s arba q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  pridėta [dir.{1}] ir [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  pridėta [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  nurodykite kaip table.key, pvz., package.version arba dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: problemų nėra\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: žr. problemas aukščiau (ten nurodytas failas yra tikrinimo kopija)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  kitos kalbos [ui] languages išlaikomos; tą sąrašą keiskite per 7 (bet kuris raktas)\n"

msgid "  removed [file.%s]\n"
msgstr "  pašalinta [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  pašalinta [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  poaplankiai:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  tai netinka TOML poaibiui; niekas nepakeista\n"

msgid "  that was not readable text; again, please\n"
msgstr "  tai nebuvo skaitomas tekstas; prašom dar kartą\n"

msgid "  the program folder '%s': %s\n"
msgstr "  programos aplankas '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  šaltinyje nėra [file] lentelių, į kurias galėtų rodyti nuoroda\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  šaltinyje nėra poaplankių tokia forma, kokia juos rašo `new` ([files] \"<folder>/<name>/**\"); pridėkite juos per 6\n"

msgid "  too long; again, please\n"
msgstr "  per ilgas; prašom dar kartą\n"

msgid "  y or n\n"
msgstr "  y arba n\n"

msgid " (changed)"
msgstr " (pakeista)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - kuria Windows Installer (.msi) ir MSIX (.msix) paketus\n\nnaudojimas: rubrapack [--lang <code>] <command> [arguments]\n\nkomandos:\n"

msgid " and its dir"
msgstr " ir jo dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) neturi aplinkos kintamojo, todėl išplečiama reikšmė jo negali turėti; naudokite eilutės reikšmę (užpildoma diegiant)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) yra {2}: juo gali prasidėti kelias arba jis gali pakeisti reikšmę, kurią užpildo Windows Installer (registras, aplinka, INI, argumentai, pranešimai), bet ne čia"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nėra aplankas, nuo kurio gali prasidėti kelias (dir ID arba ProgramFiles, LOCALAPPDATA, ProgramData ... - žr. vadovo skyrių Paths){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktūra:    {2}\n  santrauka:    {3}\n  parašas:      {4}\n  grandinė:     {5}{6}{7}\n  atšaukimas:   netikrinta\n  laiko žyma:   {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: kintamasis nenustatytas"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nėra šio dialogo valdiklis"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nėra {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': licencijos tekstui reikia šrifto pavadinimo anglų kalba, todėl jis rodomas pačios kalbos šriftu; parašykite angliškąjį pavadinimą (pvz., \"Malgun Gothic\"), kad šis šriftas būtų naudojamas ir ten"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' turi būti aplankas"

msgid "%s component, but the package platform is %.*s"
msgstr "komponentas {1}, bet paketo platforma yra {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} nepriklauso kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} nepriklauso kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} turi LANGID (1..65535), pvz., 1041"

msgid "%s holds strings"
msgstr "{1} turi eilutes"

msgid "%s is %u to %u characters long"
msgstr "{1} ilgis yra {2}–{3} simbolių"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} yra \"Raktas=Reikšmė\" tekstų sąrašas"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} yra tekstų sąrašas, pvz., [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} yra šrifto pavadinimas iš 1-31 simbolio, pvz., \"Segoe UI\" (gauta {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} yra MSI sąlyga su uždarytomis kabutėmis ir subalansuotais skliaustais"

msgid "%s is an array of strings, one per value"
msgstr "{1} yra eilučių masyvas, po vieną kiekvienai reikšmei"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} skirtas MSI paketams: MSIX nepašalinamas su msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} nebėra. Pašalinti [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} yra ilgesnis nei 240 simbolių"

msgid "%s is new. Add it?"
msgstr "{1} yra naujas. Pridėti?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nėra GUID registro formatu"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nėra kodas, kurį naudoja šis rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} turi būti \"file:<ID>\", nurodantis šio paketo [file.*]"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} turi būti nuo {2} iki {3} raidžių, skaitmenų, '.' arba '-' ir negali prasidėti '.' (gauta '{4}')"

msgid "%s must be a GUID"
msgstr "{1} turi būti GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} turi būti GUID kaip {{12345678-...} (gauta '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} turi būti http:// arba https:// adresas (gauta '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} turi būti adresas https://, http:// arba file:// arba kelias \\\\server\\share (gauta '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} turi skirtis nuo upgrade-code (viena naujinimo šeima kiekvienai architektūrai)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} reikia Windows versijos {2} arba naujesnės: nustatykite [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} reikia resources/bin/rubrapack_ca-{2}.dll, be kurio šis rubrapack buvo sukurtas"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA netikrinta (nurodykite --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA patikima"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nepatikima - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} nėra arba tuščias. Pašalinti [files.{3}] ir [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ yra naujas aplankas. Pridėti?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: klaidos: {2}{-3}, įspėjimai: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: klaidos: {2}{-3}, įspėjimai: {4}{-5} (palyginti su {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} failai, {3} baitai\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} failai, {3} klaidos, 0 įspėjimų\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: dar {2} diagnostikos neparodyta\n"

msgid "%s: '%s' is not a program (.exe)"
msgstr "{1}: '{2}' nėra programa (.exe)"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' nėra standartinis veiksmas, kurį įdeda rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: failas '{2}' nėra šio paketo [file.*]"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: failas '{2}' nėra programa (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' neuždarytas (tekstui '$(' rašykite '$$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' jau yra; paliekamas toks, koks yra"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' jau yra; pašalinkite jį arba kurkite kitame aplanke"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' jau turi {2} doroklį ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' jau turi teises"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' ir '{2}' yra tas pats kelias pakete"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' priklauso Windows arba naršyklėms"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' negalima perskaityti '{2}' atžvilgiu: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' netinka TOML poaibiui; niekas neįrašyta"

msgid "'%s' exists already"
msgstr "'{1}' jau yra"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' jau yra; pakeiskite jį su `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' yra ir nėra tuščias katalogas; išskleiskite į naują"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' patenka į {2}; arba msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' turi neperskaitomą suvestinės informacijos srautą"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' neturi lentelių Directory, Component, File ir Media, iš kurių išskleisti"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' neturi įterptosios transformacijos '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' neturi perskaitomos suvestinės informacijos"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' neturi transformacijos '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' yra UTF-16: edit keičia tik UTF-8 šaltinius (pirmiausia įrašykite jį kaip UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' yra Windows pavadinimas; kintamajam duokite kitą pavadinimą"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' yra [chain]: kuria diegimo programą, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' yra įtaisyto rėmelio valdiklis; pasirinkite kitą ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' yra kompiuterio aplankas; {2} paketas ten rašyti negali"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' yra suliejimo modulis: suliekite jį su [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' yra pavadinimas, kurį MSIX formatas pasilieka sau"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' yra simbolinė nuoroda; nuorodomis neinama"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' taip pat yra [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' taip pat yra dir ID; kintamajam duokite kitą pavadinimą"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' sukurtas mašinai 0x{2}, o ne šio paketo architektūrai; nustatykite any-arch = true, jei taip ir norėta"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nėra nei PE failas (.exe, .dll), nei MSI paketas, nei MSIX paketas ar rinkinys, nei cabinet"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' nėra nei PE failas, nei MSI paketas, nei MSIX paketas ar rinkinys, nei cabinet"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nėra nei žinomas aplankas, nei dir ID (žinomi aplankai: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' nėra nei MSIX paketas, nei paketų šeimos pavadinimas (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' nėra cabinet, kurį rubrapack gali perskaityti (stored arba MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' nėra diagnostikos kodas (RP ir keturi skaitmenys, pvz., RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' nėra programa (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nėra paprastas failas"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nėra rubrapack diegimo programa{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nėra tinkamas ID (raidės, skaitmenys ir '_', neprasideda skaitmeniu, ne daugiau kaip {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' nėra tinkama MSI duomenų bazė: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' nėra tinkamas MSIX paketas: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nėra tinkamas paketas: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nėra tinkamas šaltinis (TOML poaibis); pirmiausia pataisykite jį rankiniu būdu"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nėra tinkama transformacija: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nėra tinkamas kintamojo pavadinimas"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' yra rezervuotas ir negali būti naudojamas kaip ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' yra dir pavadinimas: dir gali užpildyti tik registro arba dir paieška"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' atrodo kaip programos failas (PE), bet jo antraštės ar ištekliai sugadinti"

msgid "'%s' must be a string"
msgstr "'{1}' turi būti eilutė"

msgid "'%s' must be an integer"
msgstr "'{1}' turi būti sveikasis skaičius"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' turi būti tarp {2} ir {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' turi būti true arba false"

msgid "'%s' must not be empty"
msgstr "'{1}' negali būti tuščias"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' nenurodo transformacijų (suvestinės savybė 8): nėra pataisa"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' prasideda aplanku: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' turi {4}; niekas neišskleista"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} įrašai, daugiau nei riba {3} (--limit-entries); niekas neišskleista"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' ir '{3}' sistemoje Windows būtų tas pats kelias; niekas neišskleista"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' nėra [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': lentelės negalima perskaityti"

msgid "'%s': a table is unreadable"
msgstr "'{1}': lentelė neperskaitoma"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX įdiegia visus savo failus (when); naudokite msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX pašalina visus savo failus (keep); naudokite msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' sugadintas arba nėra stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet pavadinimas '{2}' nėra paprastas failo pavadinimas"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': suglaudintas failas '{2}' (seka {3}) neturi cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': katalogas '{2}' turi tėvinį '{3}', kurio nėra"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': katalogas '{2}' yra pats sau protėvis arba įdėtas per giliai"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': failas '{2}' neatitinka savo MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': failas '{2}' neturi komponento arba katalogo"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': failas '{2}' yra {3} baitų, lentelė File nurodo {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': failo '{2}' nėra cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': jo išoriniai cabinet nepadengti parašu (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': jo aplankas neveda į žinomą vietą"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': rašyti daugiau nei {2} baitų (--limit-bytes); niekas neišskleista"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': nėra --timestamp: parašas nebegalioja, kai sertifikatas nustoja galioti"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': paketas '{2}' neatitinka savo SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
