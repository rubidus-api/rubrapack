msgstr "[file.{1}] yra naudotojo profilyje ir turi component-guid: rakto kelias lieka failas, nors Windows taisyklės ten nori HKCU reikšmės (ICE38); praleiskite component-guid, kad ją gautumėte"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' nėra .NET rinkinys (nėra CLI antraštės su Assembly eilute)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: .NET rinkinys savo manifestą neša pats; manifest skirtas Win32 rinkiniui"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: Win32 rinkiniui reikia manifest = \"file:<ID>\", jo manifesto failo"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: bendrinamas .NET rinkinys patenka į GAC, kuri priima tik stipriojo vardo rinkinius; pasirašykite jį arba nurodykite assembly-for = \"file:<programa>\""

msgid "[file.%s]: a shared Win32 assembly (WinSxS) needs a catalog signed by a trusted certificate, which rubrapack does not make; give assembly-for = \"file:<program>\" for a private one"
msgstr "[file.{1}]: bendrinamam Win32 rinkiniui (WinSxS) reikia katalogo, pasirašyto patikimu sertifikatu, kurio rubrapack nekuria; privačiam nurodykite assembly-for = \"file:<programa>\""

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for ir manifest naudojami su assembly = \"dotnet\" arba \"win32\""

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: jo manifeste '{2}' nėra assemblyIdentity su name ir version"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: jo manifestas '{2}' turi būti tame pačiame dir ir feature (ir su tuo pačiu when): abu yra vienas komponentas"

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: manifestas '{2}' priklauso kitam rinkiniui arba pats yra rinkinys"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer įkelia {2} doroklį iš DLL; [com.{3}] yra programa"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows savybių doroklius skaito tik kompiuterio lygiu; paketui reikia scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: peržiūros doroklis veikia Windows prevhost; app-id ir surrogate nenurodykite [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX turi tik miniatiūrų ir peržiūros doroklius (supakuotas savybių doroklis Explorer nedavė reikšmių); msi-only = true palieka jį MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: MSIX failo tipas priklauso programai; pridėkite [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: klasė {2} nėra šio paketo [com.*] (ją aptarnauja doroklio DLL)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX dorokliai dalijasi visais savo tipais arba nė vienu (tipas yra viename failo tipo susiejime)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX jo klasė veikia surrogate; threading = \"sta\" [com.{2}] suteikia jos langui pranešimų ciklą (su threading = {3} peržiūra gali likti tuščia)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX visi jo tipai yra viename [assoc] failo tipe arba nė viename"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: jo klasė yra msi-only ([com.{2}]); MSIX neturėtų jai serverio"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types yra failų tipų sąrašas, pvz., [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] patenka į {2}; arba msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] reikia 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] reikia funkcijos: nustatykite 'feature' čia arba jo dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX įrašo visus savo INI įrašus (when); naudokite msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: jo reikšmėje yra dalis, kurią Windows Installer užpildo diegiant ([...]); MSIX failą įrašo kuriamas"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] reikia 'on': kur rodomas elementas, pvz., [\".txt\"] arba \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] reikia 'target' (programos, kurią jis paleidžia) arba elementų su parent = \"{2}\" (submeniu)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] reikia 'target': programos, kurią elementas paleidžia"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 meniu priima tik raidžių ir skaitmenų ID (be '_'): pervadinkite arba nurodykite windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: submeniu nieko nepaleidžia: 'args' nenurodykite"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: submeniu elementas rodomas ten, kur jo submeniu: 'on' nenurodykite"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args yra dalis, kurią Windows Installer užpildo diegiant ([...]); MSIX turi tik fiksuotą tekstą"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when yra \"HKCU\\\\key\\\\value\" arba \"HKLM\\\\...\", Windows 11 meniu elemente, kuris nėra pomeniu"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when nurodo reikšmę, kurią rašo pats šis paketas ([registry.{2}]): elementas niekada nebūtų rodomas"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: jo programos nėra MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: jo reikšmės negali patekti į paketo registrą"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list yra dalis, kurią Windows Installer užpildo diegiant ([...]); MSIX turi tik fiksuotą tekstą"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list pakeičia {2}, kai keliai netelpa komandų eilutėje: reikia multi = \"one\", {3} reikšmėje args ir {4} (sąrašo failas) reikšmėje list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": nėra [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on yra failo tipas arba jų sąrašas, pvz., [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' nėra [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' turi būti submeniu: [menu.*] be target ir be savo parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] patenka į {2}; arba msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] reikia funkcijos: nustatykite 'feature' čia arba jo dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; arba msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] reikia feature (arba with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature eina su savo komponentu, ne su with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name nurodo vieną failą; name turi pakaitos simbolių"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: bendrinimo paskirčiai reikia types, formats arba abiejų"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: automatinio paleidimo doroklei reikia content-events, device-events arba abiejų"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args turi būti paprastas tekstas (be [...], užpildomų diegiant)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events reikia class (programos IHWEventHandler COM klasės)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file turi būti {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file turi nurodyti failą, patenkantį į paketą"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file turi nurodyti programą, patenkančią į paketą"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types yra failų tipų sąrašas, pvz., [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows priima tik raides ir skaitmenis"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "[msix-psf] arm64 atveju reikia launcher = \"...\" (PSF savo paleidiklius vadina PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] nedera nei su external-location = true, nei su [env.*] (paties rubrapack paleidikliu)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] paleidžia programas per PSF paleidiklį: reikia [msix-app.ID]"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' savo \"applications\" nemini programos '{2}'"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: aplanke files nėra '{1}' (paleidiklio)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: failas '{2}' nėra DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] savo tvarkyklę nurodo vieną kartą: driver (vienas [odbc-driver]) arba driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] su driver-name reikia with = \"file:<ID>\": komponento, su kuriuo jis įdiegiamas"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: kompiuterinis paketas registruoja duomenų šaltinius kompiuteriui"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] nurodo vieną kopiją: msix (su publisher) arba upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix yra paketo tapatybės vardas (3–50 raidžių, skaitmenų, '.' arba '-') ir reikalauja publisher (\"CN=...\"), kaip jie nurodyti jo manifeste"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: kitos kopijos ieško išankstinė patikra: reikia preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code yra šio paketo (tai naujinimas, o ne kita kopija)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] reikia, kad jo dir turėtų funkciją"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX args turi būti paprastas tekstas (be [...], užpildomų diegiant)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX schema atveria programą: target turi būti [msix-app.*] vykdomasis failas"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] reikia 'value' (arba remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR nepasiekia už MSIX ribų; naudokite [assoc.*], [protocol.*], [com.*] arba [handler.*], arba msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword reikšmei reikia rubrapack pagalbinio DLL, kurio suliejimo modulis neturi"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX turi reikšmes tik po {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX nei šalina reikšmių, nei jų palieka (remove, keep); naudokite msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX įrašo visas savo reikšmes (when); naudokite msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: jo reikšmėje yra dalis, kurią Windows Installer užpildo diegiant ([...]); MSIX turi tik fiksuotas reikšmes"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" reikia rubrapack pagalbinio DLL, kurio suliejimo modulis neturi"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: rakto ar reikšmės pavadinimas negali patekti į registro hive"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" skirtas root = \"HKCU\" su on = \"uninstall\", viso kompiuterio pakete"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] reikia funkcijos: nustatykite 'feature' čia arba jo dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true netaikomas aplankui po {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true reikia rubrapack pagalbinio DLL, kurio suliejimo modulis neturi"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" skirtas recursive = true aplankui AppData arba LocalAppData, viso kompiuterio pakete"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX args turi būti paprastas tekstas (be [...], užpildomų diegiant)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file turi nurodyti programą, patenkančią į paketą"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] reklamuoja funkciją '{2}', kuriai nustatyta advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise nederinamas su when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX turi nuorodas tik darbalaukyje ir meniu Pradžia{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX nuoroda neturi working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX nuoroda yra visada (when skirtas MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX nuoroda rodo savo programos logotipą; icon skirtas MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: reklamuojama nuoroda skirta MSI (MSIX įdiegia visą paketą)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: reklamuojamam nuorodai reikia piktogramos"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX args turi būti paprastas tekstas (be [...], užpildomų diegiant)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX nuoroda paleidžia programą: target turi būti [msix-app.*] vykdomasis failas"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX meniu Pradžia įrašas yra jo programa, kuri nepriima args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: joks dialogo tekstas neturi šio ID"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded skirtas MSI; MSIX neturi savo diegimo programos sąsajos"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] reikia ui = \"basic\" arba kito dialogų rinkinio [package] (arba embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "valdymo seka \\{1} nėra Unicode skaliarinė reikšmė"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: šis paketas švariai neatnaujintų ankstesniojo"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "paketo `lint`: dialogai, kodų lentelė, teksto normalizavimas"

msgid "`lint` of an MSIX package or bundle"
msgstr "MSIX paketo arba rinkinio `lint`"

msgid "a %s control has no property"
msgstr "valdiklis {1} neturi property"

msgid "a %s control has no text; put a text control beside it"
msgstr "valdiklis {1} neturi teksto; šalia padėkite teksto valdiklį"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "valdikliui {1} reikia [property.{2}] su viena iš jo reikšmių kaip numatytąja (tylusis diegimas ją naudoja)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "{1} paketas negali rašyti į HKLM; naudokite HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr ".msix išvesčiai reikia lentelės [msix-app.ID], nurodančios vykdomąjį failą"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr ".msix išvesčiai reikia lentelės [msix] (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr ".msm išvestis yra suliejimo modulis, sukurtas iš šaltinio su [module] vietoj [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr ".txt, .md arba .rtf failas, arba - jei nėra"

msgid "a PE file without a certificate table entry"
msgstr "PE failas be sertifikatų lentelės įrašo"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN niekada neimamas iš komandinės eilutės (kiti gali jį matyti); naudokite --pin-env arba --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "rinkinio manifesto Package nežinomo Type"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "rinkinio manifesto Package be FileName, Offset arba Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "ZIP įrašas neišsiskleidžia iki savo dydžio"

msgid "a ZIP entry larger than allowed"
msgstr "ZIP įrašas, didesnis nei leidžiama"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "ZIP įrašo CRC-32 nesutampa"

msgid "a ZIP entry's data lies outside the file"
msgstr "ZIP įrašo duomenys yra už failo ribų"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "[module] šaltinis sukuria suliejimo modulį: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "dvejetainė reikšmė yra lyginis šešioliktainių skaitmenų skaičius, pvz., \"01A0FF\""

msgid "a bundle without packages"
msgstr "rinkinys be paketų"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "kelio sertifikatas turi kritinį plėtinį, kurio rubrapack nesupranta"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "kelio sertifikatas pasirašytas sertifikatu, kuris nėra CA"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "grandinėje yra tik [chain], [chain-package.ID] ir [define], ne [{1}]; paketai kuriami iš savo šaltinių"

msgid "a chain holds at most %d packages"
msgstr "grandinėje yra ne daugiau kaip {1} paketų"

msgid "a chain needs [chain]"
msgstr "grandinei reikia [chain]"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "grandinei reikia bent vieno [chain-package.ID]"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "simbolis, kurio Windows neleidžia pavadinime (/ \\ : * ? \" < > |)"

msgid "a container holds at most %u package families"
msgstr "konteineryje telpa ne daugiau kaip {1} paketų šeimų"

msgid "a control character"
msgstr "valdymo simbolis"

msgid "a damaged PE optional header"
msgstr "sugadinta PE pasirenkamoji antraštė"

msgid "a damaged PE section table"
msgstr "sugadinta PE sekcijų lentelė"

