msgstr "[action.{1}] reikia entry: iškviečiamos DLL funkcijos"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] reikia run = \"file:<ID>\": programos, kurią paleidžia do ir undo"

msgid "[action.%s] runs a file of this package before InstallFinalize, where a first installation does not have it yet (Windows Installer error 1721 or 1723): place it after InstallFinalize, or make it deferred"
msgstr "[action.{1}] paleidžia šio paketo failą prieš InstallFinalize, kai per pirmąjį diegimą jo dar nėra (Windows Installer klaida 1721 arba 1723): perkelkite ją po InstallFinalize arba padarykite deferred"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] paleidžia vieną dalyką: run (exe), dll (įdiegta DLL) arba binary (DLL pakete); arba do ir undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} skirtas vienam veiksmui, ne do/undo porai"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: atidėtas veiksmas, paleidžiantis įdiegtą failą, turi būti po InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: neatidėliotinas veiksmas vykdomas kaip diegiantis vartotojas; as skirtas kitoms fazėms"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args priklauso programai; DLL gauna data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check eina su do/undo pora"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data skirtas atidėtam, commit arba rollback veiksmui (neatidėliotinas skaito ypatybes)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry yra DLL funkcija; run ima args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: MSIX args turi būti paprastas tekstas (be [...], užpildomų diegiant)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: MSIX failo tipas atveria programą: target turi būti [msix-app.*] vykdomasis failas"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] yra du kartus"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] reikia ID: rašykite [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id ir typelib rašomi tik MSI; MSIX užregistruoja klasę be jų"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args priklauso programai; DLL įkeliamas, o ne paleidžiamas"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate paleidžia DLL dllhost; '{2}' yra programa"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading skirtas DLL; programa pati nustato savo apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version ir typelib-file reikia typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] patenka į {2}; arba msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: jo šaltinis turi būti failas, patenkantis į paketą"

msgid "[define] values must be strings"
msgstr "[define] reikšmės turi būti eilutės"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] reikia '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] reikia image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] reikia 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] reikia 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] reikia 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] turi {2} valdiklių; ne daugiau kaip 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] neturi [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] per kitus dialogus padėtas po savęs paties"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] reikia ui = \"minimal\", \"installdir\" arba \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' yra Windows pavadinimas; dir duokite kitą ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard reikia rubrapack pagalbinio DLL, kurio suliejimo modulis neturi"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] reikia funkcijos"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX nustato visus savo kintamuosius (when); naudokite msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: jo reikšmė nurodo vietą, kurios MSIX negali suteikti (aplanką už paketo, kuris nėra Windows aplankas, arba diegimo metu nustatomą dalį); naudokite msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: su external-location = true pakete nėra nė vieno programos failo, taigi ir rubrapack paleidiklio; arba msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] jau yra savo programos aplanke; isolate-for skirtas bendrai DLL, įdiegtai kitur"

