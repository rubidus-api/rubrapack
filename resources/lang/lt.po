msgstr "--target priima msi arba msix (gauta '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots ir --proxy naudojami su --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test ir --msix-compress skirti .msix išvestims"

