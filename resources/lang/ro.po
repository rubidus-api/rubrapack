# rubrapack language pack: Romanian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: ro\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Română\n"
"X-Rubrapack-LangIDs: 1048, 2072\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialoguri {6}{7}\n  1 nume, producător, versiune, arhitectură     2 folder de instalare, pentru cine\n  3 dialoguri, licență, limbi                   4 părți opționale\n  5 comenzi rapide                              6 fișiere: potrivire cu folderul programului\n  7 orice cheie                                 v vizualizare   l lint   s salvare   q ieșire\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMesaje cu acest cod (* ține locul unui nume sau al unei valori):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nRezultatele merg la stdout, diagnosticele la stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nCe trebuie făcut: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} nu mai există, dar o comandă rapidă îl deschide: modificați mai întâi comenzile rapide (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  acolo sunt {1} fișiere și {2} foldere\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s sau q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  s-au adăugat [dir.{1}] și [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  s-a adăugat [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  dați-o ca tabel.cheie, de exemplu package.version sau dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: nicio problemă\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: vedeți problemele de mai sus (fișierul numit acolo este o copie de verificare)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  celelalte limbi din [ui] languages se păstrează; modificați lista cu 7 (orice cheie)\n"

msgid "  removed [file.%s]\n"
msgstr "  s-a eliminat [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  s-a eliminat [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subfoldere:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  aceasta nu se încadrează în subsetul TOML; nu s-a modificat nimic\n"

msgid "  that was not readable text; again, please\n"
msgstr "  acesta nu a fost text lizibil; încă o dată, vă rog\n"

msgid "  the program folder '%s': %s\n"
msgstr "  folderul programului '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  sursa nu are tabele [file] spre care să arate o comandă rapidă\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  sursa nu are subfoldere așa cum le scrie `new` ([files] \"<folder>/<name>/**\"); adăugați-le cu 6\n"

msgid "  too long; again, please\n"
msgstr "  prea lung; încă o dată, vă rog\n"

msgid "  y or n\n"
msgstr "  y sau n\n"

msgid " (changed)"
msgstr " (modificat)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - creează pachete Windows Installer (.msi) și MSIX (.msix)\n\nutilizare: rubrapack [--lang <code>] <command> [arguments]\n\ncomenzi:\n"

msgid " and its dir"
msgstr " și dir-ul său"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) nu are o variabilă de mediu, deci o valoare expandabilă nu o poate conține; folosiți o valoare șir (completată la instalare)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) este un {2}: poate începe o cale sau ține locul unei valori pe care o completează Windows Installer (registry, mediu, INI, argumente, mesaje), dar nu aici"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) nu este un folder de la care poate începe o cale (un ID dir, sau ProgramFiles, LOCALAPPDATA, ProgramData ... - vedeți Paths în manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  structură:    {2}\n  rezumat:      {3}\n  semnătură:    {4}\n  lanț:         {5}{6}{7}\n  revocare:     neverificată\n  marcaj de timp: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: variabila nu este setată"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' nu este un control al acestui dialog"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' nu este în {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': textul licenței are nevoie de numele englezesc al fontului, așa că apare în fontul propriu al limbii; scrieți numele englezesc (de exemplu \"Malgun Gothic\") pentru a folosi acest font și acolo"

msgid "%s component, but the package platform is %.*s"
msgstr "componentă {1}, dar platforma pachetului este {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} nu aparține de kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} nu aparține de kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} conține LANGID-uri (1..65535), de exemplu 1041"

msgid "%s holds strings"
msgstr "{1} conține șiruri"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} este un nume de font de 1 până la 31 de caractere, de exemplu \"Segoe UI\" (primit {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} este o condiție MSI cu ghilimele închise și paranteze echilibrate"

msgid "%s is an array of strings, one per value"
msgstr "{1} este un tablou de șiruri, câte unul pe valoare"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} este pentru pachete MSI: un MSIX nu este eliminat de msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} nu mai există. Eliminați [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} are peste 240 de caractere"

msgid "%s is new. Add it?"
msgstr "{1} este nou. Îl adăugați?"

msgid "%s is not a GUID in registry format"
msgstr "{1} nu este un GUID în format registry"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} nu este un cod pe care îl folosește acest rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} trebuie să fie \"file:<ID>\" și să numească un [file.*] al acestui pachet"

msgid "%s must be a GUID"
msgstr "{1} trebuie să fie un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} trebuie să fie un GUID ca {12345678-...} (primit '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} trebuie să fie o adresă https://, http:// sau file://, ori o cale \\\\server\\share (primit '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} trebuie să difere de upgrade-code (o familie de actualizare pe arhitectură)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} necesită versiunea Windows {2} sau ulterioară: setați [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} necesită resources/bin/rubrapack_ca-{2}.dll, fără de care a fost construit acest rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA neverificat (dați --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA de încredere"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA nu este de încredere - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} nu mai există sau este gol. Eliminați [files.{3}] și [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ este un folder nou. Îl adăugați?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} erori{-3}, {4} avertismente{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} erori{-3}, {4} avertismente{-5} (față de {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} fișiere, {3} octeți\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} fișiere, {3} erori, 0 avertismente\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: încă {2} diagnostice neafișate\n"

