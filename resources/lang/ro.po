msgstr "'{1}': transformarea '{2}' nu poate fi citită față de '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' este limba proprie a pachetului ({2}); dați acel text fără sufix"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' face ca Windows Installer să scrie un șir multiplu; folosiți type = \"multi\" și un tablou"

msgid "'_' in numbers is not supported"
msgstr "'_' în numere nu este acceptat"

msgid "'help' takes at most one command name"
msgstr "'help' primește cel mult un nume de comandă"

msgid "'version' takes no arguments"
msgstr "'version' nu primește argumente"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs este pentru .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch pentru un pachet grupat: o listă de x64, x86 și arm64, fiecare o dată (primit '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch primește o arhitectură sau o listă pentru o ieșire .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp și --allow-unsigned-cabs merg cu --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress este pentru .msi; un MSIX primește --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist numește un folder nou lângă sursă (fără cale)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
