msgstr "'{1}' nu este un program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' nu este un fișier obișnuit"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' nu este un program de instalare rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' nu este un ID valid (litere, cifre și '_', nu începe cu o cifră, cel mult {2})"

