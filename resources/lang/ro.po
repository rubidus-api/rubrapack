msgstr "'{1}' trebuie să fie un șir"

msgid "'%s' must be an integer"
msgstr "'{1}' trebuie să fie un număr întreg"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' trebuie să fie între {2} și {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' trebuie să fie true sau false"

msgid "'%s' must not be empty"
msgstr "'{1}' nu trebuie să fie gol"

