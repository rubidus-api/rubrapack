msgstr "'{1}': un MSIX instalează toate fișierele sale (when); folosiți msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': un MSIX elimină toate fișierele sale (keep); folosiți msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet-ul '{2}' este deteriorat sau nu este stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': numele de cabinet '{2}' nu este un simplu nume de fișier"

