msgstr "'{1}' nu este un pachet MSIX valid: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' nu este un pachet valid: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' nu este o sursă validă (subsetul TOML); corectați-l mai întâi manual"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' nu este o transformare validă: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' nu este un nume de variabilă valid"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' este rezervat și nu poate fi folosit ca ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' este numele unui dir: doar o căutare în registry sau dir poate completa un dir"

