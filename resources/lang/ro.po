msgstr "{1}: fișierul '{2}' nu este un [file.*] al acestui pachet"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: fișierul '{2}' nu este un program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' nu este închis (scrieți '$$(' pentru textul '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' există deja; este lăsat așa cum este"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' există deja; eliminați-l sau construiți în alt folder"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' are deja un handler {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' are deja permisiuni"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' și '{2}' sunt aceeași cale în pachet"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' aparține Windows sau browserelor"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' nu poate fi citit față de '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' nu se încadrează în subsetul TOML; nu s-a salvat nimic"

msgid "'%s' exists already"
msgstr "'{1}' există deja"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' există deja; modificați-l cu `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' există și nu este un director gol; extrageți într-unul nou"

