msgstr "'{1}' este și un [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' este și un ID dir; dați variabilei alt nume"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' este construit pentru mașina 0x{2}, nu pentru arch-ul acestui pachet; setați any-arch = true dacă asta se intenționează"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nu este nici fișier PE (.exe, .dll), nici pachet MSI, nici pachet sau pachet grupat MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nu este nici fișier PE, nici pachet MSI, nici pachet sau pachet grupat MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nu este nici folder cunoscut, nici ID dir (foldere cunoscute: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

