msgstr "'{1}': cabinet-urile sale externe nu sunt acoperite de semnătură (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': folderul său nu duce la o locație cunoscută"

