msgstr "'{1}' nu are informații rezumat lizibile"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' nu are transformarea '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' este UTF-16: edit modifică doar surse UTF-8 (salvați-l mai întâi ca UTF-8)"

