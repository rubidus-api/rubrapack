msgstr "'{1}' este un nume Windows; dați variabilei alt nume"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' este un [chain]: construiește un program de instalare, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' este un control al cadrului încorporat; alegeți alt ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' este un folder al computerului; un pachet {2} nu poate scrie acolo"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' este un modul de îmbinare: îmbinați-l în schimb cu [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' este un nume pe care formatul MSIX îl păstrează pentru sine"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' este o legătură simbolică; legăturile nu sunt urmate"

