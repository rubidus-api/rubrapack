msgstr "[env.{1}]: external-location = true-rekin paketeak ez du programaren fitxategirik, ezta rubrapack-en abiarazlea ere; edo msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] bere programaren karpetan dago jada; isolate-for beste nonbait instalatutako DLL partekatu baterako da"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] erabiltzailearen profilean dago eta component-guid du: gako-bidea fitxategia izaten jarraitzen du, Windows-en arauek han HKCU balio bat nahi duten arren (ICE38); kendu component-guid hura lortzeko"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' ez da .NET multzo bat (ez dago Assembly errenkadadun CLI goibururik)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: .NET multzo batek berak darama bere manifestua; manifest Win32 multzoentzat da"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: Win32 multzo batek manifest = \"file:<ID>\" behar du, bere manifestu-fitxategia"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: .NET multzo partekatua GACera doa, eta hark izen sendodun multzoak soilik onartzen ditu; sinatu edo eman assembly-for = \"file:<programa>\""

msgid "[file.%s]: a shared Win32 assembly (WinSxS) needs a catalog signed by a trusted certificate, which rubrapack does not make; give assembly-for = \"file:<program>\" for a private one"
msgstr "[file.{1}]: Win32 multzo partekatu batek (WinSxS) ziurtagiri fidagarri batez sinatutako katalogoa behar du, eta rubrapack-ek ez du egiten; pribatu baterako eman assembly-for = \"file:<programa>\""

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for eta manifest assembly = \"dotnet\" edo \"win32\"-rekin doaz"

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: bere '{2}' manifestuak ez du name eta version dituen assemblyIdentity-rik"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: bere '{2}' manifestuak dir eta feature berean egon behar du (when berarekin): biak osagai bakarra dira"

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: '{2}' manifestua beste multzo batena da edo bera da multzo bat"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Arakatzaileak {2} kudeatzaile bat DLL batetik kargatzen du; [com.{3}] programa bat da"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows-ek propietate-kudeatzaileak makina bakoitzeko bakarrik irakurtzen ditu; paketeak scope = \"machine\" behar du"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: aurrebista-kudeatzaile bat Windows-en prevhost-ean exekutatzen da; utzi app-id eta surrogate [com.{2}]-tik kanpo"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX batek miniatura- eta aurrebista-kudeatzaileak bakarrik eramaten ditu (paketatutako propietate-kudeatzaile batek ez zion Arakatzaileari baliorik eman); msi-only = true-k MSIrako gordetzen du"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: MSIX fitxategi-mota bat aplikazio batena da; gehitu [msix-app.*] bat"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: {2} klasea ez da pakete honetako [com.*] bat (kudeatzailearen DLLak zerbitzatzen du)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX batean kudeatzaileek mota guztiak partekatzen dituzte edo bat ere ez (mota bat fitxategi-mota elkartze bakar batean dago)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX batean bere klasea ordezko batean exekutatzen da; [com.{2}]-ko threading = \"sta\"-k mezu-begizta bat ematen dio leihoari (threading = {3}-rekin aurrebista hutsik gera daiteke)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX batean bere mota guztiak [assoc] fitxategi-mota bakar batean daude, edo bat ere ez"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: bere klasea MSI soilik da ([com.{2}]); MSIX-ek ez luke zerbitzaririk izango harentzat"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types fitxategi-moten zerrenda bat da, adibidez [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] hona doa: {2}; edo msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] taulak 'value' behar du"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] taulak eginbide bat behar du: ezarri 'feature' hemen edo bere dir-ean"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX batek bere INI sarrera guztiak idazten ditu (when); erabili msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: bere balioak Windows Installer-ek instalatzean betetzen duen zati bat du ([...]); MSIX batek fitxategia sortzean idazten du"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] taulak 'on' behar du: elementua non erakusten den, adibidez [\".txt\"] edo \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] taulak 'target' behar du (abiarazten duen programa), edo parent = \"{2}\" duten elementuak (azpimenu bat)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] taulak 'target' behar du: elementuak abiarazten duen programa"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11-ren menuak hizki eta zenbakiz osatutako ID bat baino ez du onartzen ('_' gabe): aldatu izena, edo windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: azpimenu batek ez du ezer abiarazten: utzi 'args' kanpoan"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: azpimenu bateko elementua azpimenua erakusten den lekuan erakusten da: utzi 'on' kanpoan"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args-ek Windows Installer-ek instalatzean betetzen duen zati bat du ([...]); MSIX batek testu finkoa bakarrik du"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when \"HKCU\\\\key\\\\value\" edo \"HKLM\\\\...\" da, azpimenu batean ez dagoen Windows 11-ren menuko elementu batean"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when-ek pakete honek berak idazten duen balio bat izendatzen du ([registry.{2}]): elementua ez litzateke inoiz agertuko"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: bere programa ez dago MSIX-ean (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: bere balioak ezin dira paketearen erregistroan sartu"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list-ek Windows Installer-ek instalatzean betetzen duen zati bat du ([...]); MSIX batek testu finkoa bakarrik du"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: bideak komando-lerro batean sartzen ez direnean, list {2}-ren ordez doa: multi = \"one\", args-en {3} eta list-en {4} (zerrenda-fitxategia) behar dira"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": ez dago [assoc.{3}]-rik"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on fitxategi-mota bat edo horien zerrenda bat da, adibidez [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: '{2}' gurasoa ez da [menu.*] bat"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: '{2}' gurasoa azpimenu bat izan behar da: target gabeko eta guraso propiorik gabeko [menu.*] bat"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] hona doa: {2}; edo msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] taulak eginbide bat behar du: ezarri 'feature' hemen edo bere dir-ean"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; edo msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}]-k feature behar du (edo with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature bere osagaiarekin doa, ez with-ekin"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name fitxategi bat izendatzen du; name-k komodinak ditu"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: partekatze-helburu batek types, formats edo biak behar ditu"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: erreprodukzio automatikoko kudeatzaile batek content-events, device-events edo biak behar ditu"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args testu soila izan behar da (instalatzean betetzen den [...] gabe)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events-ek class behar dute (programaren IHWEventHandler COM klasea)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file {2} izan behar da"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file-k paketean sartzen den fitxategi bat izendatu behar du"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file-k paketean sartzen den programa bat izendatu behar du"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types fitxategi-moten zerrenda bat da, adibidez [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows-ek hizkiak eta zenbakiak baino ez ditu onartzen"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64-rako [msix-psf]-k launcher = \"...\" behar du (PSF-k PsfLauncher32.exe, PsfLauncher64.exe deitzen die bere abiarazleei)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] ez dator bat ez external-location = true-rekin ez [env.*]-rekin (rubrapack-en abiarazle propioa)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf]-k PSF abiarazlearen bidez abiarazten ditu aplikazioak: [msix-app.ID] bat behar du"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: '{1}' config-ak ez du '{2}' aplikazioa aipatzen bere \"applications\"-en"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files-ek ez du '{1}' (abiarazlea)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: '{2}' fitxategia ez da DLL bat"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] bere kontrolatzailea behin izendatzen du: driver ([odbc-driver] bat) edo driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] driver-name-ekin with = \"file:<ID>\" behar du: zein osagairekin instalatzen den"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: makinako pakete batek datu-iturriak makinarentzat erregistratzen ditu"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}]-ek kopia bat izendatzen du: msix (publisher-ekin) edo upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix paketearen identitate-izena da (3 eta 50 artean hizki, zenbaki, '.' edo '-') eta publisher (\"CN=...\") behar du, manifestuan dauden bezala"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: beste kopia aurretiazko egiaztapenak bilatzen du: preflight = true behar da"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code pakete honena da (hori bertsio-berritzea da, ez beste kopia bat)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] taulak bere dir-ak eginbide bat izatea behar du"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX baten args testu soila izan behar da (instalatzean betetzen den [...] gabe)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX batean eskema batek aplikazio bat irekitzen du: target [msix-app.*] exekutagarri bat izan behar da"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] taulak 'value' behar du (edo remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR ez da MSIX batetik kanpora iristen; erabili [assoc.*], [protocol.*], [com.*] edo [handler.*], edo msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword balio batek rubrapack-en DLL laguntzailea behar du, eta bateratze-modulu batek ez du eramaten"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX batek {2}\\Software azpiko balioak bakarrik eramaten ditu"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX batek ez ditu balioak kentzen ezta atzean uzten ere (remove, keep); erabili msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX batek bere balio guztiak idazten ditu (when); erabili msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: bere balioak Windows Installer-ek instalatzean betetzen duen zati bat du ([...]); MSIX batek balio finkoak bakarrik ditu"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\"-ek rubrapack-en DLL laguntzailea behar du, eta bateratze-modulu batek ez du eramaten"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: gakoaren edo balioaren izena ezin da erregistro-hive batean sartu"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" on = \"uninstall\" duen root = \"HKCU\" baterako da, ordenagailu osorako pakete batean"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] taulak eginbide bat behar du: ezarri 'feature' hemen edo bere dir-ean"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true ez da {2} azpiko karpeta baterako"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true-k rubrapack-en DLL laguntzailea behar du, eta bateratze-modulu batek ez du eramaten"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" AppData edo LocalAppData karpeta bateko recursive = true baterako da, ordenagailu osorako pakete batean"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX baten args testu soila izan behar da (instalatzean betetzen den [...] gabe)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file-k paketean sartzen den programa bat izendatu behar du"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] '{2}' eginbidea iragartzen du, eta horrek advertise = \"disallow\" du"

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise ez da when-ekin konbinatzen"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX batek mahaigaineko eta Hasi menuko lasterbideak bakarrik ditu{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX lasterbide batek ez du working-dir-ik"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX lasterbide bat beti dago (when MSI baterako da)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX lasterbide batek bere aplikazioaren logotipoa erakusten du; icon MSI baterako da"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: iragarritako lasterbidea MSI batentzat da (MSIX batek pakete osoa instalatzen du)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: iragarritako lasterbide batek ikono bat behar du"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX baten args testu soila izan behar da (instalatzean betetzen den [...] gabe)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX batean lasterbide batek aplikazio bat abiarazten du: target [msix-app.*] exekutagarri bat izan behar da"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: MSIX baten Hasi menuko sarrera bere aplikazioa da, eta ez du args onartzen"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: elkarrizketa-testurik ez du ID hau"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded MSI batentzat da; MSIX batek ez du instalatzaile-interfaze propiorik"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui]-k [package]-en ui = \"basic\" edo beste elkarrizketa-multzo bat behar du (edo embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} ihes-sekuentzia ez da Unicode balio eskalar bat"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: pakete honek ez luke aurrekoa garbi eguneratuko"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "pakete baten `lint`: elkarrizketak, kode-orria, testuaren normalizazioa"

msgid "`lint` of an MSIX package or bundle"
msgstr "MSIX pakete edo sorta baten `lint`"

msgid "a %s control has no property"
msgstr "{1} kontrolak ez du property-rik"

msgid "a %s control has no text; put a text control beside it"
msgstr "{1} kontrol batek ez du testurik; jarri testu-kontrol bat ondoan"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "{1} kontrol batek [property.{2}] behar du bere balioetako bat lehenetsi gisa (instalazio isil batek erabiltzen du)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "{1} pakete batek ezin du HKLM-n idatzi; erabili HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr ".msix irteera batek exekutagarria izendatzen duen [msix-app.ID] taula bat behar du"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr ".msix irteera batek [msix] taula bat behar du (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr ".msm irteera bat bateratze-modulu bat da, [package]-ren ordez [module] duen iturburu batetik sortua"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr ".txt, .md edo .rtf fitxategi bat, edo - bat ere ez"

msgid "a PE file without a certificate table entry"
msgstr "ziurtagiri-taularen sarrerarik gabeko PE fitxategi bat"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
