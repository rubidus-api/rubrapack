msgstr "'{1}' 0x{2} makinarako konpilatu da, ez pakete honen arkitekturarako; ezarri any-arch = true nahita bada"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
