# rubrapack language pack: Basque.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: eu\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Euskara\n"
"X-Rubrapack-LangIDs: 1069\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, elkarrizketak {6}{7}\n  1 izena, fabrikatzailea, bertsioa, arkitektura 2 instalazio-karpeta, norentzat\n  3 elkarrizketak, lizentzia, hizkuntzak         4 aukerako zatiak\n  5 lasterbideak                                 6 fitxategiak: programaren karpetarekin bat\n  7 edozein gako                                 v ikusi   l lint   s gorde   q irten\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nKode hau duten mezuak (* izen edo balio baten ordez dago):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nEmaitzak stdout-era doaz, diagnostikoak stderr-era.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nZer egin: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} ez dago jada, baina lasterbide batek irekitzen du: aldatu lehenik lasterbideak (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} fitxategi eta {2} karpeta daude\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s edo q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] eta [files.{2}] gehitu dira\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] gehitu da\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  eman taula.gakoa moduan, adibidez package.version edo dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: arazorik ez\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: ikusi goiko arazoak (bertan aipatzen den fitxategia egiaztapen-kopia bat da)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages zerrendako beste hizkuntzak gordetzen dira; aldatu zerrenda hori 7 aukerarekin (edozein gako)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] kendu da\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] kendu da{2}\n"

msgid "  sub folders:"
msgstr "  azpikarpetak:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  hori ez dator bat TOML azpimultzoarekin; ez da ezer aldatu\n"

msgid "  that was not readable text; again, please\n"
msgstr "  hori ez zen testu irakurgarria; berriro, mesedez\n"

msgid "  the program folder '%s': %s\n"
msgstr "  programaren karpeta '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  iturburuak ez du lasterbide batek seinala dezakeen [file] taularik\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  iturburuak ez du `new`-ek idazten dituen moduko azpikarpetarik ([files] \"<folder>/<name>/**\"); gehitu 6 aukerarekin\n"

msgid "  too long; again, please\n"
msgstr "  luzeegia; berriro, mesedez\n"

msgid "  y or n\n"
msgstr "  y edo n\n"

msgid " (changed)"
msgstr " (aldatua)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) eta MSIX (.msix) paketeak sortzen ditu\n\nerabilera: rubrapack [--lang <code>] <command> [arguments]\n\nkomandoak:\n"

msgid " and its dir"
msgstr " eta bere karpeta"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) ez du ingurune-aldagairik, beraz balio hedagarri batek ezin du eduki; erabili kate-balio bat (instalatzean betetzen da)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) {2} bat da: bide bat has dezake, edo Windows Installer-ek betetzen duen balio baten ordez egon (erregistroa, ingurunea, INI, argumentuak, mezuak), baina ez hemen"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ez da bide bat has daitekeen karpeta (dir ID bat, edo ProgramFiles, LOCALAPPDATA, ProgramData ... - ikusi eskuliburuko Bideak){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  egitura:     {2}\n  laburpena:   {3}\n  sinadura:    {4}\n  katea:       {5}{6}{7}\n  ezeztapena:  egiaztatu gabe\n  denbora-zigilua: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: aldagaia ez dago ezarrita"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' ez da elkarrizketa honen kontrol bat"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' ez dago hemen: {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': lizentziaren testuak letra-tipoaren izen ingelesa behar du, beraz hizkuntzaren letra-tipoarekin erakusten da; idatzi izen ingelesa (adibidez \"Malgun Gothic\") letra-tipo hau han ere erabiltzeko"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' karpeta bat izan behar da"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} osagaia, baina paketearen plataforma {2} da"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} ez da kind = \"{2}\" motakoa"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} ez da kind = \"firewall\" motakoa"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID-ak ditu (1..65535), adibidez 1041"

msgid "%s holds strings"
msgstr "{1} kateak ditu"

msgid "%s is %u to %u characters long"
msgstr "{1} {2} eta {3} karaktere artekoa da"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} \"Gakoa=Balioa\" testuen zerrenda da"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} testu-zerrenda bat da, adibidez [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} 1etik 31 karakterrera arteko letra-tipo izena da, adibidez \"Segoe UI\" ({2} jaso da)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} komatxo itxiak eta parentesi orekatuak dituen MSI baldintza bat da"

msgid "%s is an array of strings, one per value"
msgstr "{1} kate-matrize bat da, balio bakoitzeko bat"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI paketeentzat da: msiexec-ek ez du MSIX bat kentzen"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} ez dago jada. [file.{2}] kendu?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 karaktere baino luzeagoa da"

msgid "%s is new. Add it?"
msgstr "{1} berria da. Gehitu?"

msgid "%s is not a GUID in registry format"
msgstr "{1} ez da erregistro-formatuko GUID bat"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ez da rubrapack honek erabiltzen duen kode bat{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} \"file:<ID>\" izan behar da, pakete honetako [file.*] bat izendatuz"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} {2} eta {3} arteko letra, zenbaki, '.' edo '-' izan behar da, '.'-z hasi gabe ('{4}' jaso da)"

msgid "%s must be a GUID"
msgstr "{1} GUID bat izan behar da"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} GUID bat izan behar da, adibidez {{12345678-...} ('{2}' jaso da)"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} http:// edo https:// helbide bat izan behar da ('{2}' jaso da)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// edo file:// helbide bat izan behar da, edo \\\\server\\share bide bat ('{2}' jaso da)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} upgrade-code-ren desberdina izan behar da (eguneratze-familia bat arkitektura bakoitzeko)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} elementuak Windows {2} konpilazioa edo berriagoa behar du: ezarri [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} elementuak resources/bin/rubrapack_ca-{2}.dll behar du, eta rubrapack hau hura gabe konpilatu zen"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA egiaztatu gabe (eman --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA fidagarria"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA ez fidagarria - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} ez dago jada edo hutsik dago. [files.{3}] eta [dir.{4}] kendu?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ karpeta berria da. Gehitu?"

