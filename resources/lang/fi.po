# rubrapack language pack: Finnish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: fi\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Suomi\n"
"X-Rubrapack-LangIDs: 1035\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 7\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, valintaikkunat {6}{7}\n  1 nimi, valmistaja, versio, arkkitehtuuri     2 asennuskansio, kenelle asennetaan\n  3 valintaikkunat, lisenssi, kielet            4 valinnaiset osat\n  5 pikakuvakkeet                               6 tiedostot: vastaa ohjelmakansiota\n  7 mikä tahansa avain                          v näytä   l lint   s tallenna   q lopeta\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nTämän koodin viestit (* tarkoittaa nimeä tai arvoa):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nTulokset menevät stdoutiin, diagnostiikka stderriin.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nMitä tehdä: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} on poissa, mutta pikakuvake avaa sen: muuta ensin pikakuvakkeita (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  siellä on {1} tiedostoa ja {2} kansiota\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s tai q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  lisättiin [dir.{1}] ja [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  lisättiin [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  anna se muodossa taulukko.avain, esimerkiksi package.version tai dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: ei ongelmia\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: katso yllä olevat ongelmat (siinä mainittu tiedosto on tarkistuskopio)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  muut kielet kohdassa [ui] languages säilyvät; muuta luetteloa valinnalla 7 (mikä tahansa avain)\n"

msgid "  removed [file.%s]\n"
msgstr "  poistettiin [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  poistettiin [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  alikansiot:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  se ei sovi TOML-osajoukkoon; mitään ei muutettu\n"

msgid "  that was not readable text; again, please\n"
msgstr "  se ei ollut luettavaa tekstiä; uudelleen, kiitos\n"

msgid "  the program folder '%s': %s\n"
msgstr "  ohjelmakansio '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  lähteessä ei ole [file]-taulukoita, joihin pikakuvake voisi osoittaa\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  lähteessä ei ole alikansioita sellaisina kuin `new` ne kirjoittaa ([files] \"<folder>/<name>/**\"); lisää ne valinnalla 6\n"

msgid "  too long; again, please\n"
msgstr "  liian pitkä; uudelleen, kiitos\n"

msgid "  y or n\n"
msgstr "  y tai n\n"

msgid " (changed)"
msgstr " (muutettu)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - rakentaa Windows Installer- (.msi) ja MSIX-paketteja (.msix)\n\nkäyttö: rubrapack [--lang <code>] <command> [arguments]\n\nkomennot:\n"

msgid " and its dir"
msgstr " ja sen dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}):lla ei ole ympäristömuuttujaa, joten laajennettava arvo ei voi sisältää sitä; käytä merkkijonoarvoa (täytetään asennuksessa)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) on {2}: se voi aloittaa polun tai edustaa arvoa, jonka Windows Installer täyttää (rekisteri, ympäristö, INI, argumentit, viestit), mutta ei tässä"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ei ole kansio, josta polku voi alkaa (dir-tunnus tai ProgramFiles, LOCALAPPDATA, ProgramData ... - katso käsikirjan Paths){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  rakenne:      {2}\n  tiiviste:     {3}\n  allekirjoitus: {4}\n  ketju:        {5}{6}{7}\n  sulkulista:   ei tarkistettu\n  aikaleima:    {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: muuttujaa ei ole asetettu"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' ei ole tämän valintaikkunan ohjausobjekti"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' ei ole kohteessa {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': lisenssiteksti tarvitsee fontin englanninkielisen nimen, joten se näkyy kielen omalla fontilla; kirjoita englanninkielinen nimi (kuten \"Malgun Gothic\") käyttääksesi tätä fonttia myös siellä"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-komponentti, mutta paketin alusta on {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} ei kuulu kohteeseen kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} ei kuulu kohteeseen kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} sisältää LANGID-arvoja (1..65535), kuten 1041"

msgid "%s holds strings"
msgstr "{1} sisältää merkkijonoja"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} on 1-31 merkin fontin nimi, kuten \"Segoe UI\" (saatiin {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} on MSI-ehto, jossa lainausmerkit on suljettu ja sulkeet täsmäävät"

msgid "%s is an array of strings, one per value"
msgstr "{1} on merkkijonojen taulukko, yksi arvoa kohden"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} on MSI-paketeille: msiexec ei poista MSIX-pakettia"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} on poissa. Poistetaanko [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} on pidempi kuin 240 merkkiä"

msgid "%s is new. Add it?"
msgstr "{1} on uusi. Lisätäänkö se?"

msgid "%s is not a GUID in registry format"
msgstr "{1} ei ole GUID rekisterimuodossa"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ei ole koodi, jota tämä rubrapack käyttää{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1}:n on oltava \"file:<ID>\", joka nimeää tämän paketin [file.*]-taulukon"

msgid "%s must be a GUID"
msgstr "{1}:n on oltava GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1}:n on oltava GUID, kuten {12345678-...} (saatiin '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1}:n on oltava https://-, http://- tai file://-osoite tai \\\\server\\share-polku (saatiin '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1}:n on erottava upgrade-codesta (yksi päivitysperhe arkkitehtuuria kohden)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} vaatii Windowsin koontiversion {2} tai uudemman: aseta [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} tarvitsee tiedoston resources/bin/rubrapack_ca-{2}.dll, jota ilman tämä rubrapack käännettiin"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA:ta ei tarkistettu (anna --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA luotettu"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA ei luotettu - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} on poissa tai tyhjä. Poistetaanko [files.{3}] ja [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ on uusi kansio. Lisätäänkö se?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} virhettä{-3}, {4} varoitusta{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} virhettä{-3}, {4} varoitusta{-5} (verrattuna: {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} tiedostoa, {3} tavua\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} tiedostoa, {3} virhettä, 0 varoitusta\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} diagnostiikkaa lisää, ei näytetty\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: tiedosto '{2}' ei ole tämän paketin [file.*]"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: tiedosto '{2}' ei ole ohjelma (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' ei ole suljettu (kirjoita '$$(' tekstille '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' on jo olemassa; se jätetään ennalleen"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' on jo olemassa; poista se tai käännä toiseen kansioon"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}':lla on jo {2}-käsittelijä ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}':lla on jo käyttöoikeudet"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' ja '{2}' ovat sama polku paketissa"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' kuuluu Windowsille tai selaimille"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}':tä ei voi lukea suhteessa '{2}':een: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' ei sovi TOML-osajoukkoon; mitään ei tallennettu"

msgid "'%s' exists already"
msgstr "'{1}' on jo olemassa"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' on jo olemassa; muuta sitä komennolla `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' on olemassa eikä ole tyhjä kansio; pura uuteen"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' menee kohteeseen {2}; tai msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}':ssä on lukukelvoton yhteenvetotietovirta"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}':ssä ei ole Directory-, Component-, File- ja Media-taulukoita, joista purkaa"

msgid "'%s' has no readable summary information"
msgstr "'{1}':ssä ei ole luettavia yhteenvetotietoja"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}':ssä ei ole muunnosta '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' on UTF-16: edit muuttaa vain UTF-8-lähteitä (tallenna se ensin UTF-8:na)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' on Windowsin nimi; anna muuttujalle toinen nimi"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' on [chain]: se rakentaa asennusohjelman, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' on sisäänrakennetun kehyksen ohjausobjekti; valitse toinen tunnus"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' on koneen kansio; {2}-paketti ei voi kirjoittaa sinne"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' on yhdistämismoduuli: yhdistä se sen sijaan [merge.ID]:llä"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' on nimi, jonka MSIX-muoto varaa itselleen"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' on symbolinen linkki; linkkejä ei seurata"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' on myös [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' on myös dir-tunnus; anna muuttujalle toinen nimi"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' on käännetty koneelle 0x{2}, ei tämän paketin arch-arvolle; aseta any-arch = true, jos se on tarkoitus"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ei ole PE-tiedosto (.exe, .dll), MSI-paketti eikä MSIX-paketti tai -nippu"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ei ole PE-tiedosto, MSI-paketti eikä MSIX-paketti tai -nippu"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' ei ole tunnettu kansio eikä dir-tunnus (tunnetut kansiot: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' ei ole cabinet, jota rubrapack osaa lukea (stored tai MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' ei ole diagnostiikkakoodi (RP ja neljä numeroa, kuten RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' ei ole ohjelma (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' ei ole tavallinen tiedosto"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' ei ole rubrapackin asennusohjelma{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' ei ole kelvollinen tunnus (kirjaimia, numeroita ja '_', ei ala numerolla, enintään {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' ei ole kelvollinen MSI-tietokanta: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' ei ole kelvollinen MSIX-paketti: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' ei ole kelvollinen paketti: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' ei ole kelvollinen lähde (TOML-osajoukko); korjaa se ensin käsin"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' ei ole kelvollinen muunnos: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' ei ole kelvollinen muuttujan nimi"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' on varattu, eikä sitä voi käyttää tunnuksena"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' on dir-kohteen nimi: vain rekisteri- tai dir-haku voi täyttää dir-kohteen"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' näyttää ohjelmatiedostolta (PE), mutta sen otsakkeet tai resurssit ovat vahingoittuneet"

msgid "'%s' must be a string"
msgstr "'{1}':n on oltava merkkijono"

msgid "'%s' must be an integer"
msgstr "'{1}':n on oltava kokonaisluku"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}':n on oltava välillä {2}-{3}"

msgid "'%s' must be true or false"
msgstr "'{1}':n on oltava true tai false"

msgid "'%s' must not be empty"
msgstr "'{1}' ei saa olla tyhjä"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' ei nimeä muunnoksia (yhteenvetoominaisuus 8): ei korjaustiedosto"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' alkaa kansiolla: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' sisältää {4}; mitään ei purettu"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} merkintää, enemmän kuin raja {3} (--limit-entries); mitään ei purettu"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' ja '{3}' olisivat Windowsissa sama polku; mitään ei purettu"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' ei ole kohdassa [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': taulukkoa ei voi lukea"

msgid "'%s': a table is unreadable"
msgstr "'{1}': taulukko on lukukelvoton"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX asentaa kaikki tiedostonsa (when); käytä msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX poistaa kaikki tiedostonsa (keep); käytä msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' on vahingoittunut tai ei stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet-nimi '{2}' ei ole pelkkä tiedostonimi"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': pakatulla tiedostolla '{2}' (järjestys {3}) ei ole cabinetia"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': hakemistolla '{2}' on yläkansio '{3}', jota ei ole"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': hakemisto '{2}' on oma esivanhempansa tai liian syvällä"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': tiedosto '{2}' ei vastaa MsiFileHash-arvoaan"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': tiedostolla '{2}' ei ole komponenttia tai hakemistoa"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': tiedosto '{2}' on {3} tavua, File-taulukon mukaan {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': tiedosto '{2}' ei ole cabinetissa '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': allekirjoitus ei kata sen ulkoisia cabinet-tiedostoja (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': sen kansio ei johda tunnettuun sijaintiin"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': kirjoitettavaa yli {2} tavua (--limit-bytes); mitään ei purettu"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': ei --timestamp-valitsinta: allekirjoitus lakkaa olemasta voimassa, kun varmenne vanhenee"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': paketti '{2}' ei vastaa SHA-256-arvoaan"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinet-virtaa '{2}' ei ole"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifestissa ei ole {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifesti mainitsee '{2}':n, jota ei ole paketissa"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': aikaleima palvelusta {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': muunnosta '{2}' ei voi lukea suhteessa '{3}':een: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' on paketin oma kieli ({2}); anna se teksti ilman päätettä"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' saa Windows Installerin kirjoittamaan monimerkkijonon; käytä type = \"multi\" ja taulukkoa"

msgid "'_' in numbers is not supported"
msgstr "'_' numeroissa ei ole tuettu"

msgid "'help' takes at most one command name"
msgstr "'help' ottaa enintään yhden komennon nimen"

msgid "'version' takes no arguments"
msgstr "'version' ei ota argumentteja"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs on .msi-tiedostoille"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch nipulle: luettelo x64, x86 ja arm64, kukin kerran (saatiin '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch ottaa yhden arkkitehtuurin tai luettelon .msixbundle-tulosteelle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp ja --allow-unsigned-cabs kuuluvat --key-valitsimen kanssa"

