msgstr "sertifikat u putanji potpisan je sertifikatom koji nije CA"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "lanac sadrži samo [chain], [chain-package.ID] i [define], ne [{1}]; paketi se prave iz sopstvenih izvora"

