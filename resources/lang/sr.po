msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "Na ovom računaru već postoji druga instalacija programa [1] ([2]). Dve kopije jednog programa obe otvaraju njegove datoteke i obe prikazuju njegove menije.\r\n\r\nInstalirati i ovu?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
