msgstr "ime datoteke bez / \\ : * ? \" < > | $"

msgid "a file's component or directory chain is broken"
msgstr "lanac komponente ili direktorijuma datoteke je prekinut"

msgid "a font goes into an MSIX through a [font.*] that names it"
msgstr "font ulazi u MSIX preko [font.*] koji ga imenuje"

