msgstr "paket za izmenu traži Windows build 18362 ili noviji: postavite [msix] min-version = \"10.0.18362.0\""

msgid "a module's compress is \"none\", \"mszip\" or \"mszip:0\" ... \"mszip:9\""
msgstr "compress modula je \"none\", \"mszip\" ili \"mszip:0\" ... \"mszip:9\""

msgid "a module's name is its ID in the ModuleID: letters, digits and _, at most 35 characters"
msgstr "ime modula je njegov ID u ModuleID: slova, cifre i _, najviše 35 znakova"

msgid "a multi value is a non-empty array of strings"
msgstr "multi vrednost je neprazan niz niski"

msgid "a multi value is an array of strings"
msgstr "multi vrednost je niz niski"

msgid "a name ending with a space or a dot"
msgstr "ime koje se završava razmakom ili tačkom"

msgid "a name longer than 255 bytes"
msgstr "ime duže od 255 bajtova"

msgid "a package named in the bundle manifest is not in the bundle"
msgstr "paket naveden u manifestu skupa nije u skupu"

msgid "a package without Identity Name, Publisher, Version and ProcessorArchitecture (or ResourceId)"
msgstr "paket bez Identity Name, Publisher, Version i ProcessorArchitecture (ili ResourceId)"

