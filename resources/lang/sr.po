msgstr "--lang {1}: nema takvog jezika (ugrađeni: {2}; drugi traži svoj jezički paket, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (ili RUBRAPACK_LANG) bira jezik ovih tekstova: {1}, ili jezik koji ima jezički paket.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang traži jezik, npr. en ili ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages traži dijaloge: navedite i --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress prima deflate ili store (dobijeno '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: promenljiva nije postavljena"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code prima GUID velikim slovima sa vitičastim zagradama: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: promenljiva nije postavljena"

msgid "--previous compares two .msi packages"
msgstr "--previous poredi dva .msi paketa"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: korenski sertifikati operativnog sistema ne mogu da se pročitaju"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} ne odgovara izlazu '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} nije implementiran (msi ili msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target prima msi ili msix (dobijeno '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots i --proxy idu sa --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test i --msix-compress su za .msix izlaze"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test je za pakete bez potpisa; sa --key ga izostavite"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate prima none, ili neke od product-code,upgrade-code,language,platform"

msgid "-D %.*s is given twice"
msgstr "-D {1} je naveden dvaput"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' je ime Windowsa; dajte promenljivoj drugo ime"

