msgstr "ProductVersion {1} nije veća od prethodne {2} u prva tri polja: Windows Installer ne nadograđuje"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Program koji prečice otvaraju (- bez prečica)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: nema takvog jezika (ugrađeni: {2}; drugi traži svoj jezički paket, {3}.po)"

msgid "Reference, "
msgstr "Referenca, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Redosled {1} nije obuhvaćen nijednim redom Media (poslednji {2})"

msgid "Sequence %ld is used by another file"
msgstr "Redosled {1} koristi druga datoteka"

msgid "Source file to write"
msgstr "Izvorna datoteka za pisanje"

msgid "Source format"
msgstr "Format izvora"

msgid "Source must name a File row for type %ld"
msgstr "Source mora da imenuje red File za tip {1}"

msgid "Start menu shortcut?"
msgstr "Prečica u meniju Start?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Unosi menija Start, Programs, radne površine i Startup dolaze iz [shortcut.*] i [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML izvan podskupa koji rubrapack čita, ili `format` nedostaje ili je previše nov"

msgid "Tables"
msgstr "Tabele"

msgid "The TOML subset"
msgstr "Podskup TOML-a"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "UTF-16 big-endian datoteke nisu podržane; sačuvajte kao UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} razlikuje se od {2} prethodne verzije: ovaj paket je ne zamenjuje"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode nije GUID u formatu registra"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Vrednost (tekst, broj, true/false, [\"a\", \"b\"]; - uklanja ključ)"

msgid "Variables"
msgstr "Promenljive"

msgid "Version"
msgstr "Verzija"

msgid "Version ([define] VERSION)"
msgstr "Verzija ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Verzije i nadogradnje"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer dozvoljava najviše 255.255.65535(.65535)"

msgid "Windows name"
msgstr "Windows naziv"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] traži '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] ne može da uđe u modul za spajanje; ima ga paket koji ga spaja"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] još nije podržan (planirano za {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] ne može da uđe u MSIX; dodajte msi-only = true da se MSIX napravi bez njega"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] nalazi se u korisnikovom AppData ili LocalAppData: dual paket instaliran za sve korisnike stavlja ga samo u profil korisnika koji instalira"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID u modulu za spajanje ima najviše 35 znakova (dodaje mu se GUID modula)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] traži ID: napišite [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] ne prima ID: napišite [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml nema </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml nije poslednji unos (nije paket koji je napisao rubrapack ili Windows API za pakovanje)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Nizovi tabela [[...]] nisu podržani; dajte svakoj stavci sopstveni [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] se postavlja jednom: before, after ili sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] traži i do i undo (undo takođe poništava neuspeli do)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] zahteva entry: funkciju DLL-a koju treba pozvati"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] zahteva run = \"file:<ID>\": program koji pokreću do i undo"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] pokreće jedno: run (exe), dll (instalirana DLL) ili binary (DLL u paketu); ili do i undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} je za jednu radnju, ne za par do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: odložena radnja koja pokreće instaliran fajl mora biti posle InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: trenutna radnja se izvršava kao korisnik koji instalira; as je za ostale faze"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args pripadaju programu; DLL dobija data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check ide sa parom do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data je za odloženu, commit ili rollback radnju (trenutna čita svojstva)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry je funkcija DLL-a; run uzima args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: u MSIX-u tip datoteke otvara aplikaciju: target mora biti izvršna datoteka [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] postoji dvaput"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] traži ID: napišite [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id i typelib se pišu samo za MSI; MSIX registruje klasu bez njih"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args pripadaju programu; DLL se učitava, ne pokreće"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate pokreće DLL u dllhost; '{2}' je program"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading je za DLL; program sam postavlja svoj apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version i typelib-file traže typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] ide u {2}; ili msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: izvor mora biti datoteka koja ulazi u paket"

msgid "[define] values must be strings"
msgstr "Vrednosti [define] moraju biti niske"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] traži '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] zahteva image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] traži 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] traži 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] traži 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] ima {2} kontrola; najviše 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] nema [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] je postavljen iza samog sebe preko drugih dijaloga"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] traži ui = \"minimal\", \"installdir\" ili \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' je ime Windowsa; dajte diru drugi ID"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard traži pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] traži funkciju"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX postavlja sve svoje promenljive (when); koristite msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: njegova vrednost navodi mesto koje MSIX ne može da da (fasciklu van paketa koja nije fascikla Windowsa, ili deo iz vremena instalacije); koristite msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: са external-location = true пакет не носи ниједну датотеку програма, па ни покретач rubrapack-а; или msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] je već u fascikli svog programa; isolate-for je za deljenu DLL instaliranu drugde"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] nalazi se u korisničkom profilu i ima component-guid: putanja ključa ostaje datoteka, a pravila sistema Windows tu traže HKCU vrednost (ICE38); izostavite component-guid da biste je dobili"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer učitava rukovalac {2} iz DLL-a; [com.{3}] je program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows čita rukovaoce svojstava samo po računaru; paket traži scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: rukovalac pregleda radi u prevhost-u Windowsa; izostavite app-id i surrogate iz [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX nosi samo rukovaoce sličica i pregleda (upakovani rukovalac svojstava nije dao vrednosti Exploreru); msi-only = true ga zadržava za MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: tip datoteke MSIX-a pripada aplikaciji; dodajte [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: klasa {2} nije [com.*] ovog paketa (DLL rukovaoca je opslužuje)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: u MSIX-u rukovaoci dele sve svoje tipove ili nijedan (tip je u jednom povezivanju tipa datoteke)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: u MSIX-u njegova klasa radi u surrogate-u; threading = \"sta\" u [com.{2}] daje njenom prozoru petlju poruka (sa threading = {3} pregled može ostati prazan)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: u MSIX-u svi njegovi tipovi su u jednom tipu datoteke [assoc], ili ni u jednom"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: njegova klasa je msi-only ([com.{2}]); MSIX ne bi imao server za nju"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types je lista tipova datoteka, npr. [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] ide u {2}; ili msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] traži 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] traži funkciju: postavite 'feature' ovde ili na njegov dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX upisuje sve svoje INI unose (when); koristite msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: njegova vrednost ima deo koji Windows Installer popunjava pri instalaciji ([...]); MSIX upisuje datoteku kada se pravi"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] traži 'on': gde se stavka prikazuje, npr. [\".txt\"] ili \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] traži 'target' (program koji pokreće), ili stavke sa parent = \"{2}\" (podmeni)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] traži 'target': program koji stavka pokreće"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: meni operativnog sistema Windows 11 prima ID samo od slova i cifara (bez '_'): preimenujte ga ili postavite windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: podmeni ništa ne pokreće: izostavite 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: stavka podmenija se prikazuje gde i njen podmeni: izostavite 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args ima deo koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksni tekst"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when je \"HKCU\\\\key\\\\value\" ili \"HKLM\\\\...\", na stavci menija operativnog sistema Windows 11 koja nije u podmeniju"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when navodi vrednost koju upisuje sam ovaj paket ([registry.{2}]): stavka se nikad ne bi prikazala"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: njegov program nije u MSIX-u (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: njegove vrednosti ne mogu da uđu u registar paketa"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list ima deo koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksni tekst"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list zamenjuje {2} kada putanje ne staju u komandnu liniju: potrebni su multi = \"one\", {3} u args i {4} (datoteka sa spiskom) u list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": nema [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on je tip datoteke ili lista tipova, npr. [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' nije [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' mora biti podmeni: [menu.*] bez target-a i bez sopstvenog parent-a"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] ide u {2}; ili msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] traži funkciju: postavite 'feature' ovde ili na njegov dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; ili msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] zahteva feature (ili with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature ide sa sopstvenom komponentom, ne sa with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name navodi jedan fajl; name ima zamenske znakove"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: cilju deljenja trebaju types, formats ili oba"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: rukovaocu automatske reprodukcije trebaju content-events, device-events ili oba"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events traže class (COM klasu IHWEventHandler programa)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file mora biti {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file mora da imenuje datoteku koja ulazi u paket"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file mora da imenuje program koji ulazi u paket"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types je lista tipova datoteka, npr. [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows prima samo slova i cifre"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: fajl '{2}' nije DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] svoj upravljački program navodi jednom: driver (jedan [odbc-driver]) ili driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] sa driver-name zahteva with = \"file:<ID>\": komponentu sa kojom se instalira"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: paket po računaru registruje izvore podataka za računar"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] navodi jednu kopiju: msix (sa publisher) ili upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix je naziv identiteta paketa (3 do 50 slova, cifara, '.' ili '-') i traži publisher (\"CN=...\"), kako ih ima njegov manifest"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: drugu kopiju traži prethodna provera: potrebno je preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code pripada ovom paketu (to je nadogradnja, a ne druga kopija)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] traži da njegov dir ima funkciju"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: u MSIX-u šema otvara aplikaciju: target mora biti izvršna datoteka [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] traži 'value' (ili remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR ne doseže van MSIX-a; koristite [assoc.*], [protocol.*], [com.*] ili [handler.*], ili msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: qword vrednost traži pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX nosi vrednosti samo ispod {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX niti uklanja vrednosti niti ih ostavlja (remove, keep); koristite msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX upisuje sve svoje vrednosti (when); koristite msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: njegova vrednost ima deo koji Windows Installer popunjava pri instalaciji ([...]); MSIX sadrži samo fiksne vrednosti"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" traži pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: ime ključa ili vrednosti ne može da uđe u hive registra"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" je za root = \"HKCU\" sa on = \"uninstall\", u paketu za računar"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] traži funkciju: postavite 'feature' ovde ili na njegov dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true nije za fasciklu ispod {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true traži pomoćni DLL rubrapacka, koji modul za spajanje ne nosi"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" je za recursive = true na fascikli u AppData ili LocalAppData, u paketu za računar"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file mora da imenuje program koji ulazi u paket"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] oglašava funkciju '{2}', koja ima advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise se ne kombinuje sa when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX ima prečice samo na radnoj površini i u meniju Start{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: MSIX prečica nema working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: MSIX prečica uvek postoji (when je za MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: MSIX prečica prikazuje logo svoje aplikacije; icon je za MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: oglašavana prečica je za MSI (MSIX instalira ceo paket)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: oglašavana prečica zahteva ikonu"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args za MSIX moraju biti običan tekst (bez [...] koji se popunjava pri instalaciji)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: u MSIX-u prečica pokreće aplikaciju: target mora biti izvršna datoteka [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: unos menija Start u MSIX-u je njegova aplikacija, koja ne prima args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: nijedan tekst dijaloga nema ovaj ID"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded je za MSI; MSIX nema sopstveni instalacioni interfejs"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] zahteva ui = \"basic\" ili drugi skup dijaloga u [package] (ili embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "izlazna sekvenca \\{1} nije skalarna vrednost Unicode-a"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: ovaj paket ne bi čisto nadogradio prethodni"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` paketa: dijalozi, kodna strana, normalizacija teksta"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` MSIX paketa ili skupa"

msgid "a %s control has no property"
msgstr "kontrola {1} nema property"

msgid "a %s control has no text; put a text control beside it"
msgstr "kontrola {1} nema tekst; postavite tekstualnu kontrolu pored nje"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "kontrola {1} traži [property.{2}] sa jednom od njenih vrednosti kao podrazumevanom (tiha instalacija je koristi)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "paket {1} ne može da piše u HKLM; koristite HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "izlaz .msix traži tabelu [msix-app.ID] koja imenuje izvršnu datoteku"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "izlaz .msix traži tabelu [msix] (identity-name, publisher)"

