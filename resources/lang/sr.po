msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] program(a) koristi datoteke programa [3]:\r\n[2]\r\nZatvoriti sve?\r\n\r\nDa: zatvori sve i nastavi (nesačuvan rad može da se izgubi).\r\nNe: nastavi bez zatvaranja (već otvoreni programi zadržavaju stare datoteke dok se ponovo ne otvore).\r\nOtkaži: zaustavi."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: zaustavljeno jer [1] program(a) koristi njegove datoteke:\r\n[2]Zatvorite ih i pokušajte ponovo ili navedite RPCLOSE=yes (zatvori sve i nastavi) ili RPCLOSE=no (nastavi bez zatvaranja)."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] stavki u fasciklama programa [3] nije instalirano sa njim:\r\n[2]\r\nIzbrisati i njih?\r\n\r\nDa: izbriši ih zajedno sa [3] (ne mogu se vratiti).\r\nNe: ukloni [3] i zadrži ih.\r\nOtkaži: zaustavi."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: zaustavljeno jer [1] stavki u njegovim fasciklama nije instalirano sa njim:\r\n[2]Navedite RPEXTRA=delete (izbriši i njih) ili RPEXTRA=keep (zadrži ih), a zatim ponovo uklonite."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "[1] drugih korisnika ovog računara možda ima podešavanja ili podatke proizvoda [3]:\r\n[2]\r\nIzbrisati i njihove?\r\n\r\nDa: izbriši ih za svakog korisnika (ne mogu se vratiti).\r\nNe: izbriši samo vaše.\r\nOtkaži: zaustavi."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] je već instaliran na ovom računaru iz prodavnice Microsoft Store ili kao paket aplikacije ([2]). Dve kopije jednog programa obe otvaraju njegove datoteke i obe prikazuju njegove menije.\r\n\r\nInstalirati i ovu?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
