msgstr "Priručnik: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Proizvođač"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Proizvođač (prikazuje se u Instaliranim aplikacijama)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt je vratio ECDSA potpis pogrešne dužine"

