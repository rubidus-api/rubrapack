msgstr "dvojni paket piše u HKMU (HKLM ili HKCU prema instalaciji), ne u HKCU"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "dword vrednost je ceo broj 0..4294967295 (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "funkcija koju ovaj rubrapack ne pruža (ili je napravljen bez nje)"

msgid "a file larger than allowed"
msgstr "datoteka veća od dozvoljenog"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "ime datoteke ispod '{1}' nije važeći Unicode i ne može da se upakuje"

