msgstr "radio kontrola slaže svoje dugmiće jedno ispod drugog: visina mora biti najmanje 12 po vrednosti ({1})"

msgid "a record has more columns than its table"
msgstr "zapis ima više kolona od svoje tabele"

msgid "a record is cut short"
msgstr "zapis je skraćen"

msgid "a record names a string the pool does not have"
msgstr "zapis imenuje nisku koje nema u skladištu"

msgid "a reserved device name"
msgstr "rezervisano ime uređaja"

msgid "a rollback action cannot be asynchronous"
msgstr "akcija vraćanja ne može biti asinhrona"

msgid "a scheme is a lower-case letter, then lower-case letters, digits, '+', '-' or '.' (got '%s')"
msgstr "šema je malo slovo, pa mala slova, cifre, '+', '-' ili '.' (dobijeno '{1}')"

msgid "a script action between InstallInitialize and RemoveExistingProducts (error 2613)"
msgstr "skript akcija između InstallInitialize i RemoveExistingProducts (greška 2613)"

msgid "a section lies outside the file"
msgstr "sekcija je izvan datoteke"

msgid "a service name may not contain '/' or '\\' (at most 256 characters)"
