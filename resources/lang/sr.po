msgstr "heš koji potpisivanje tokenom ne poznaje"

msgid "a hive cell crosses its bin"
msgstr "ćelija hive-a prelazi svoj bin"

msgid "a hive version or type rubrapack does not read"
msgstr "verzija ili tip hive-a koji rubrapack ne čita"

