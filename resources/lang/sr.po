msgstr "lozinka se nikada ne uzima iz komandne linije (drugi je mogu videti); koristite --pass-env ili --pass-file"

msgid "a per-machine package does not write HKCU (it would be the installing user's); use scope = \"user\""
msgstr "paket po računaru ne piše u HKCU (bio bi korisnika koji instalira); koristite scope = \"user\""

