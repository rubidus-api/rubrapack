msgstr "--arch prima jednu arhitekturu, ili listu za izlaz .msixbundle / .msixupload"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp i --allow-unsigned-cabs idu sa --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress je za .msi; MSIX prima --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist imenuje novu fasciklu pored izvora (bez putanje)"

