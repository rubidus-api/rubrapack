msgstr "PKCS#11 token: token nema sertifikat sa CKA_ID ključa (navedite ga sa --cert)"

msgid "Paths"
msgstr "Putanje"

msgid "Product name"
msgstr "Naziv proizvoda"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode i UpgradeCode su isti GUID"

