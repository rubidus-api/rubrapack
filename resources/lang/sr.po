msgstr "licenca traži ui = \"minimal\", \"installdir\" ili \"features\""

msgid "a local header with extra fields (not a package rubrapack or Windows' packaging API wrote)"
msgstr "lokalno zaglavlje sa dodatnim poljima (nije paket koji je napisao rubrapack ili Windows API za pakovanje)"

msgid "a malformed central directory"
msgstr "neispravan centralni direktorijum"

msgid "a modification package has no applications of its own"
msgstr "paket za izmenu nema sopstvene aplikacije"

