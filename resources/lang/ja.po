msgstr "[dialog-control.{1}] には 'property' が必要です"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] には 'text' が必要です"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] には 'values' が必要です"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] にはコントロールが {2} 個あります。64 個までです"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] には [dialog-control.*] がありません"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] はほかのダイアログを経て自分自身の後に置かれています"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] には ui = \"minimal\"、\"installdir\"、\"features\" のいずれかが必要です"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' は Windows の名前です。dir には別の ID を付けてください"

