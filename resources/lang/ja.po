msgstr "ZIP アーカイブではありません (短すぎます)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "rubrapack が受け付けるプロキシの URL (http://host:port) ではありません"

msgid "not a registry hive"
msgstr "レジストリ ハイブではありません"

msgid "not a valid number"
