msgstr "on = \"uninstall\" は HKLM、HKCU、HKMU 用です (クラスは [assoc.*]、[com.*] などで扱います)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "on = \"uninstall\" はキーをその下ごと削除します: '{1}' は Software の下の製品自身のキーではありません"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" は削除時にキー全体を削除します。'{1}' は取りません"

