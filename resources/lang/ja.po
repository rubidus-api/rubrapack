msgstr "必須プロパティ {1} がありません"

msgid "rollback twin must come before %.*s (%ld <= %ld)"
msgstr "ロールバックの対は {1} より前に来なければなりません ({2} <= {3})"

msgid "root must be HKLM, HKCR or HKCU"
msgstr "root は HKLM、HKCR、HKCU のいずれかでなければなりません"

msgid "root must be HKLM, HKCU, HKCR or HKMU (got '%s')"
msgstr "root は HKLM、HKCU、HKCR、HKMU のいずれかでなければなりません ('{1}' でした)"

