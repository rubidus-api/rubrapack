msgstr "run: '{1}' (マシン 0x{2}) はこのパッケージのマシンでは実行できません"

msgid "run: '%s' is not a program (.exe)"
msgstr "run: '{1}' はプログラム (.exe) ではありません"

msgid "run: file '%s' is not a [file.*] of this package"
msgstr "run: ファイル '{1}' はこのパッケージの [file.*] ではありません"

