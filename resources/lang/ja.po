msgstr "no-remove では製品を削除する方法が [変更] (その中の削除) だけになります: no-modify とは一緒に使えません"

msgid "not a PE file (no MZ header)"
msgstr "PE ファイルではありません (MZ ヘッダーなし)"

msgid "not a PE file (no PE header)"
msgstr "PE ファイルではありません (PE ヘッダーなし)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "PEM、PKCS#8、PKCS#12 のファイルではありません"

