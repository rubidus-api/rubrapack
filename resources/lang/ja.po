msgstr "--target {1} は実装されていません (msi または msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target は msi か msix を取ります ('{1}' でした)"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust、--tls-trust、--system-roots、--proxy は --timestamp と一緒に使います"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test と --msix-compress は .msix の出力用です"

