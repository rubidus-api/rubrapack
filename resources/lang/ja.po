msgstr "使い方: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "使い方: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

