msgstr "--allow-unsigned-cabs は .msi 用です"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "バンドルの --arch: x64、x86、arm64 をそれぞれ 1 回ずつ並べます ('{1}' でした)"

