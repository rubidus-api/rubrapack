msgstr "[com.{1}]: threading は DLL 用です。プログラムは自分でアパートメントを設定します"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version と typelib-file には typelib が必要です"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] は {2} に入ります。または msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: コピー元はパッケージに入るファイルでなければなりません"

msgid "[define] values must be strings"
msgstr "[define] の値は文字列でなければなりません"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] には '{2}' が必要です"

