msgstr "--cert、--pass-env、--pass-file、--timestamp、--allow-unsigned-cabs は --key と一緒に使います"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress は .msi 用です。MSIX は --msix-compress deflate|store を取ります"

