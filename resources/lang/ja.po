msgstr "rubrapack が受け付ける http:// か https:// の URL ではありません"

msgid "not valid UTF-8"
msgstr "有効な UTF-8 ではありません"

msgid "not-checked (give --trust or --system-roots)"
msgstr "未確認 (--trust か --system-roots を指定してください)"

msgid "not-present"
msgstr "なし"

msgid "nothing changed\n"
msgstr "変更はありません\n"

msgid "number out of range"
msgstr "数値が範囲外です"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "8 進数と 2 進数には対応していません。10 進数か 0x を使ってください"

