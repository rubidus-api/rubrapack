msgstr "ショートカット名は UTF-16 単位で {1} あります。8.3 の短い名前と合わせて MSI に入るのは {2} までです"

msgid "sign a PE file, an MSI package, an MSIX package or bundle"
msgstr "PE ファイル、MSI パッケージ、MSIX パッケージやバンドルに署名します"

msgid "signed %s\n"
msgstr "{1} に署名しました\n"

