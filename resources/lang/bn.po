msgstr "config হলো \"Name=value\" স্ট্রিংয়ের একটি অ্যারে"

msgid "contains a control character"
msgstr "একটি নিয়ন্ত্রণ অক্ষর আছে"

msgid "contains one of < > : \" / \\ | ? *"
msgstr "< > : \" / \\ | ? *-এর একটি আছে"

