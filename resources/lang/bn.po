msgstr "ভেরিয়েবল সংজ্ঞায়িত করুন ([define] বা -D NAME=value), অথবা আক্ষরিক $-এর জন্য $$ লিখুন"

msgid "dialog '%s' is not a [dialog.*]"
msgstr "ডায়ালগ '{1}' একটি [dialog.*] নয়"

