# rubrapack language pack: Bengali.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: bn\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: বাংলা\n"
"X-Rubrapack-LangIDs: 1093, 2117\n"
"X-Rubrapack-Font: Nirmala UI\n"
"X-Rubrapack-Group: 3\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, ডায়ালগ {6}{7}\n  1 নাম, প্রস্তুতকারক, সংস্করণ, আর্কিটেকচার      2 ইনস্টল ফোল্ডার, কার জন্য\n  3 ডায়ালগ, লাইসেন্স, ভাষা                       4 ঐচ্ছিক অংশ\n  5 শর্টকাট                                      6 ফাইল: প্রোগ্রাম ফোল্ডারের সাথে মেলান\n  7 যেকোনো কী                                    v দেখুন   l lint   s সংরক্ষণ   q প্রস্থান\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nএই কোডসহ বার্তা (* একটি নাম বা মানের জায়গায় বসে):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nফলাফল stdout-এ, ডায়াগনস্টিক stderr-এ যায়।\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nকী করবেন: {1}।\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} আর নেই, কিন্তু একটি শর্টকাট এটি খোলে: আগে শর্টকাট পরিবর্তন করুন (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  সেখানে {1}টি ফাইল এবং {2}টি ফোল্ডার আছে\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s বা q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] এবং [files.{2}] যোগ করা হয়েছে\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] যোগ করা হয়েছে\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  এটি টেবিল.কী হিসেবে দিন, যেমন package.version বা dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: কোনো সমস্যা নেই\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: উপরের সমস্যাগুলি দেখুন (সেখানে উল্লিখিত ফাইলটি একটি পরীক্ষার কপি)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages-এর অন্য ভাষাগুলি রাখা হয়; সেই তালিকা 7 দিয়ে পরিবর্তন করুন (যেকোনো কী)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] সরানো হয়েছে\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] সরানো হয়েছে{2}\n"

msgid "  sub folders:"
msgstr "  সাব-ফোল্ডার:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  এটি TOML উপসেটে খাপ খায় না; কিছুই পরিবর্তন করা হয়নি\n"

msgid "  that was not readable text; again, please\n"
msgstr "  এটি পাঠযোগ্য লেখা ছিল না; অনুগ্রহ করে আবার দিন\n"

msgid "  the program folder '%s': %s\n"
msgstr "  প্রোগ্রাম ফোল্ডার '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  উৎসে শর্টকাট নির্দেশ করার মতো কোনো [file] টেবিল নেই\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  উৎসে `new` যেভাবে লেখে সেরকম সাব-ফোল্ডার নেই ([files] \"<folder>/<name>/**\"); 6 দিয়ে যোগ করুন\n"

msgid "  too long; again, please\n"
msgstr "  খুব দীর্ঘ; অনুগ্রহ করে আবার দিন\n"

msgid "  y or n\n"
msgstr "  y বা n\n"

msgid " (changed)"
msgstr " (পরিবর্তিত)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) এবং MSIX (.msix) প্যাকেজ তৈরি করে\n\nব্যবহার: rubrapack [--lang <code>] <command> [arguments]\n\nকমান্ড:\n"

msgid " and its dir"
msgstr " এবং এর ফোল্ডার"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1})-এর কোনো পরিবেশ ভেরিয়েবল নেই, তাই প্রসারণযোগ্য মান এটি রাখতে পারে না; একটি স্ট্রিং মান ব্যবহার করুন (ইনস্টলের সময় পূরণ হয়)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) একটি {2}: এটি একটি পথ শুরু করতে পারে, অথবা Windows Installer যে মান পূরণ করে তার জায়গায় বসতে পারে (রেজিস্ট্রি, পরিবেশ, INI, আর্গুমেন্ট, বার্তা), এখানে নয়"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) এমন ফোল্ডার নয় যেখান থেকে পথ শুরু হতে পারে (একটি dir ID, বা ProgramFiles, LOCALAPPDATA, ProgramData ... - ম্যানুয়ালের পথ অংশ দেখুন){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  গঠন:        {2}\n  ডাইজেস্ট:   {3}\n  স্বাক্ষর:    {4}\n  শৃঙ্খল:     {5}{6}{7}\n  প্রত্যাহার:  যাচাই করা হয়নি\n  টাইমস্ট্যাম্প: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: ভেরিয়েবল সেট করা নেই"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' এই ডায়ালগের কোনো কন্ট্রোল নয়"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3}-এ নেই"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': লাইসেন্সের লেখার জন্য ফন্টের ইংরেজি নাম লাগে, তাই এটি ভাষার নিজস্ব ফন্টে দেখায়; সেখানেও এই ফন্ট ব্যবহার করতে ইংরেজি নামটি লিখুন (যেমন \"Malgun Gothic\")"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' একটি ফোল্ডার হতে হবে"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} উপাদান, কিন্তু প্যাকেজের প্ল্যাটফর্ম {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\"-এর অন্তর্গত নয়"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\"-এর অন্তর্গত নয়"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1}-এ LANGID থাকে (1..65535), যেমন 1041"

msgid "%s holds strings"
msgstr "{1}-এ স্ট্রিং থাকে"

msgid "%s is %u to %u characters long"
msgstr "{1} {2} থেকে {3} অক্ষর দীর্ঘ"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} হলো \"কী=মান\" পাঠের একটি তালিকা"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} হলো লেখার তালিকা, যেমন [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} হলো 1 থেকে 31 অক্ষরের ফন্টের নাম, যেমন \"Segoe UI\" ({2} পাওয়া গেছে)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} হলো বন্ধ উদ্ধৃতিচিহ্ন ও সুষম বন্ধনীসহ একটি MSI শর্ত"

msgid "%s is an array of strings, one per value"
msgstr "{1} হলো স্ট্রিংয়ের একটি অ্যারে, প্রতিটি মানের জন্য একটি"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI প্যাকেজের জন্য: msiexec একটি MSIX সরায় না"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} আর নেই। [file.{2}] সরাবেন?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 অক্ষরের চেয়ে দীর্ঘ"

msgid "%s is new. Add it?"
msgstr "{1} নতুন। যোগ করবেন?"

msgid "%s is not a GUID in registry format"
msgstr "{1} রেজিস্ট্রি বিন্যাসে GUID নয়"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} এই rubrapack-এর ব্যবহৃত কোনো কোড নয়{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1}-কে এই প্যাকেজের একটি [file.*] নির্দেশকারী \"file:<ID>\" হতে হবে"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1}-কে {2} থেকে {3}টি অক্ষর, অঙ্ক, '.' বা '-' হতে হবে, '.' দিয়ে শুরু নয় ('{4}' পাওয়া গেছে)"

msgid "%s must be a GUID"
msgstr "{1}-কে একটি GUID হতে হবে"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1}-কে {{12345678-...} এর মতো GUID হতে হবে ('{2}' পাওয়া গেছে)"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} একটি http:// বা https:// ঠিকানা হতে হবে ('{2}' পাওয়া গেছে)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1}-কে https://, http:// বা file:// ঠিকানা, অথবা \\\\server\\share পথ হতে হবে ('{2}' পাওয়া গেছে)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1}-কে upgrade-code থেকে আলাদা হতে হবে (প্রতি আর্কিটেকচারে একটি আপগ্রেড পরিবার)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1}-এর জন্য Windows বিল্ড {2} বা পরবর্তী প্রয়োজন: [msix] min-version = \"10.0.{3}.0\" সেট করুন"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1}-এর জন্য resources/bin/rubrapack_ca-{2}.dll প্রয়োজন, যা ছাড়াই এই rubrapack তৈরি"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA যাচাই করা হয়নি (--tsa-trust দিন)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA বিশ্বস্ত"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA অবিশ্বস্ত - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} নেই বা খালি। [files.{3}] এবং [dir.{4}] সরাবেন?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ একটি নতুন ফোল্ডার। যোগ করবেন?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: ত্রুটি: {2}{-3}, সতর্কতা: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: ত্রুটি: {2}{-3}, সতর্কতা: {4}{-5} ({6}-এর তুলনায়)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2}টি ফাইল, {3} বাইট\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2}টি ফাইল, {3}টি ত্রুটি, 0টি সতর্কতা\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: আরও {2}টি ডায়াগনস্টিক দেখানো হয়নি\n"

msgid "%s: '%s' is not a program (.exe)"
msgstr "{1}: '{2}' প্রোগ্রাম (.exe) নয়"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' rubrapack যে স্ট্যান্ডার্ড ক্রিয়া বসায় তা নয়"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: '{2}' ফাইলটি এই প্যাকেজের [file.*] নয়"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: '{2}' ফাইলটি কোনো প্রোগ্রাম নয় (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' বন্ধ হয়নি ('$(' লেখার জন্য '$$(' লিখুন)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' আগে থেকেই আছে; এটি যেমন আছে তেমন রাখা হয়"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' আগে থেকেই আছে; এটি সরান বা অন্য ফোল্ডারে তৈরি করুন"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}'-এর ইতিমধ্যে একটি {2} হ্যান্ডলার আছে ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}'-এর ইতিমধ্যে অনুমতি আছে"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' এবং '{2}' প্যাকেজে একই পথ"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' Windows বা ব্রাউজারগুলির"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' '{2}'-এর বিপরীতে পড়া যায় না: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' TOML উপসেটে খাপ খায় না; কিছুই সংরক্ষিত হয়নি"

msgid "'%s' exists already"
msgstr "'{1}' আগে থেকেই আছে"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' আগে থেকেই আছে; `rubrapack edit {2}` দিয়ে এটি পরিবর্তন করুন"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' আছে এবং খালি ডিরেক্টরি নয়; নতুন একটিতে বের করুন"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' {2}-এ যায়; অথবা msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}'-এ একটি অপাঠ্য সারাংশ তথ্য স্ট্রিম আছে"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}'-এ বের করার জন্য Directory, Component, File এবং Media টেবিল নেই"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}'-এ এম্বেড করা রূপান্তর '{2}' নেই"

msgid "'%s' has no readable summary information"
msgstr "'{1}'-এ পাঠযোগ্য সারাংশ তথ্য নেই"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}'-এ '{2}' ট্রান্সফর্ম নেই"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' হলো UTF-16: edit শুধু UTF-8 উৎস পরিবর্তন করে (আগে এটি UTF-8 হিসেবে সংরক্ষণ করুন)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' একটি Windows নাম; ভেরিয়েবলের অন্য নাম দিন"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' একটি [chain]: এটি একটি সেটআপ প্রোগ্রাম তৈরি করে, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' অন্তর্নির্মিত ফ্রেমের একটি কন্ট্রোল; অন্য ID বেছে নিন"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' একটি মেশিন ফোল্ডার; {2} প্যাকেজ সেখানে লিখতে পারে না"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' একটি মার্জ মডিউল: এটি [merge.ID] দিয়ে একত্রিত করুন"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' এমন নাম যা MSIX বিন্যাস নিজের জন্য রাখে"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' একটি সিম্বলিক লিঙ্ক; লিঙ্ক অনুসরণ করা হয় না"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' একটি [property.*]-ও"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' একটি dir ID-ও; ভেরিয়েবলের অন্য নাম দিন"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' মেশিন 0x{2}-এর জন্য তৈরি, এই প্যাকেজের আর্কিটেকচারের জন্য নয়; ইচ্ছাকৃত হলে any-arch = true সেট করুন"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' PE ফাইল (.exe, .dll), MSI প্যাকেজ, MSIX প্যাকেজ বা বান্ডল বা cabinet কোনোটিই নয়"

msgid "'%s' is neither a PE file, an MSI package, an MSIX package or bundle nor a cabinet"
msgstr "'{1}' PE ফাইল, MSI প্যাকেজ, MSIX প্যাকেজ বা বান্ডল বা cabinet কোনোটিই নয়"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' কোনো পরিচিত ফোল্ডার বা dir ID নয় (পরিচিত ফোল্ডার: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' কোনো MSIX প্যাকেজও নয়, প্যাকেজ পরিবারের নামও নয় (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' এমন cabinet নয় যা rubrapack পড়তে পারে (stored বা MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' কোনো ডায়াগনস্টিক কোড নয় (RP এবং চারটি সংখ্যা, যেমন RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' কোনো প্রোগ্রাম নয় (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' কোনো সাধারণ ফাইল নয়"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' কোনো rubrapack সেটআপ প্রোগ্রাম নয়{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' বৈধ ID নয় (অক্ষর, সংখ্যা এবং '_', সংখ্যা দিয়ে শুরু নয়, সর্বোচ্চ {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' বৈধ MSI ডেটাবেস নয়: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' বৈধ MSIX প্যাকেজ নয়: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' বৈধ প্যাকেজ নয়: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' বৈধ উৎস নয় (TOML উপসেট); আগে হাতে ঠিক করুন"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' বৈধ ট্রান্সফর্ম নয়: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' বৈধ ভেরিয়েবল নাম নয়"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' সংরক্ষিত এবং ID হিসেবে ব্যবহার করা যায় না"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' একটি dir-এর নাম: শুধু রেজিস্ট্রি বা dir অনুসন্ধানই dir পূরণ করতে পারে"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' প্রোগ্রাম ফাইলের (PE) মতো দেখায় কিন্তু এর হেডার বা রিসোর্স ক্ষতিগ্রস্ত"

msgid "'%s' must be a string"
msgstr "'{1}'-কে স্ট্রিং হতে হবে"

msgid "'%s' must be an integer"
msgstr "'{1}'-কে পূর্ণসংখ্যা হতে হবে"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}'-কে {2} এবং {3}-এর মধ্যে হতে হবে"

msgid "'%s' must be true or false"
msgstr "'{1}'-কে true বা false হতে হবে"

msgid "'%s' must not be empty"
msgstr "'{1}' খালি হওয়া চলবে না"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' কোনো ট্রান্সফর্মের নাম দেয় না (সারাংশ বৈশিষ্ট্য 8): প্যাচ নয়"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' একটি ফোল্ডার দিয়ে শুরু হয়: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}'-এ {4} আছে; কিছুই বের করা হয়নি"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2}টি এন্ট্রি, সীমা {3}-এর বেশি (--limit-entries); কিছুই বের করা হয়নি"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' এবং '{3}' Windows-এ একই পথ হতো; কিছুই বের করা হয়নি"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' [ui] languages-এ নেই"

msgid "'%s': a table cannot be read"
msgstr "'{1}': একটি টেবিল পড়া যায় না"

msgid "'%s': a table is unreadable"
msgstr "'{1}': একটি টেবিল অপাঠ্য"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': একটি MSIX তার সব ফাইল ইনস্টল করে (when); msi-only = true ব্যবহার করুন"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': একটি MSIX তার সব ফাইল সরায় (keep); msi-only = true ব্যবহার করুন"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' ক্ষতিগ্রস্ত বা stored/MSZIP নয়"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinet নাম '{2}' সাধারণ ফাইল নাম নয়"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': সংকুচিত ফাইল '{2}' (ক্রম {3})-এর কোনো cabinet নেই"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': ডিরেক্টরি '{2}'-এর একটি প্যারেন্ট '{3}' আছে যা নেই"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': ডিরেক্টরি '{2}' নিজেরই পূর্বপুরুষ বা খুব গভীরে নেস্টেড"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': ফাইল '{2}' তার MsiFileHash-এর সাথে মেলে না"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': ফাইল '{2}'-এর কোনো উপাদান বা ডিরেক্টরি নেই"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': ফাইল '{2}' {3} বাইট, File টেবিল বলে {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': ফাইল '{2}' cabinet '{3}'-এ নেই"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': এর বাহ্যিক cabinet-গুলি স্বাক্ষরের আওতায় নেই (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': এর ফোল্ডার কোনো পরিচিত অবস্থানে নিয়ে যায় না"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': লেখার জন্য {2} বাইটের বেশি (--limit-bytes); কিছুই বের করা হয়নি"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': --timestamp নেই: সার্টিফিকেটের মেয়াদ শেষ হলে স্বাক্ষর অবৈধ হয়ে যায়"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': প্যাকেজ '{2}' তার SHA-256-এর সাথে মেলে না"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinet স্ট্রিম '{2}' নেই"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': ম্যানিফেস্টে {2} {3} নেই"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': ম্যানিফেস্ট '{2}'-এর নাম দেয়, যা প্যাকেজে নেই"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': {2} থেকে টাইমস্ট্যাম্প: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': ট্রান্সফর্ম '{2}' '{3}'-এর বিপরীতে পড়া যায় না: {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' প্যাকেজের নিজের ভাষা ({2}); সেই লেখাটি প্রত্যয় ছাড়া দিন"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' Windows Installer-কে একটি মাল্টি-স্ট্রিং লেখায়; type = \"multi\" এবং একটি অ্যারে ব্যবহার করুন"

msgid "'_' in numbers is not supported"
msgstr "সংখ্যায় '_' সমর্থিত নয়"

msgid "'help' takes at most one command name"
msgstr "'help' সর্বোচ্চ একটি কমান্ড নাম নেয়"

msgid "'version' takes no arguments"
msgstr "'version' কোনো আর্গুমেন্ট নেয় না"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs .msi-এর জন্য"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "বান্ডলের জন্য --arch: x64, x86 এবং arm64-এর তালিকা, প্রতিটি একবার ('{1}' পাওয়া গেছে)"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch একটি আর্কিটেকচার, বা .msixbundle / .msixupload আউটপুটের জন্য তালিকা নেয়"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp এবং --allow-unsigned-cabs --key-এর সাথে যায়"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress .msi-এর জন্য; MSIX --msix-compress deflate|store নেয়"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist উৎসের পাশে একটি নতুন ফোল্ডারের নাম দেয় (পথ ছাড়া)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat হলো .msixbundle আউটপুটের জন্য (এর প্যাকেজগুলো এর পাশে লেখা হয়)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs 1 থেকে 64 পর্যন্ত একটি সংখ্যা নেয় ('{1}' পাওয়া গেছে)"

msgid "--key signs at most %d external cabinets; raise cab-max-size"
msgstr "--key সর্বাধিক {1}টি বাইরের cabinet-এ স্বাক্ষর করে; cab-max-size বাড়ান"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store হলো Windows সার্টিফিকেট স্টোর; অন্যত্র কী ফাইল বা --pkcs11 ব্যবহার করুন"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store সার্টিফিকেটের SHA-1 থাম্বপ্রিন্ট নেয় (40টি হেক্স অঙ্ক)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: এমন কোনো ভাষা নেই (অন্তর্নির্মিত: {2}; অন্যটির জন্য তার ভাষা প্যাক লাগবে, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (বা RUBRAPACK_LANG) এই লেখাগুলির ভাষা বেছে নেয়: {1}, অথবা ভাষা প্যাক আছে এমন কোনো ভাষা।\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang-এর জন্য একটি ভাষা দরকার, যেমন en বা ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages-এর জন্য ডায়ালগ লাগবে: --ui-ও দিন"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress deflate বা store নেয় ('{1}' পাওয়া গেছে)"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: ভেরিয়েবল সেট করা নেই"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code বড় হাতের অক্ষর ও বন্ধনীসহ GUID নেয়: {{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: ভেরিয়েবল সেট করা নেই"

msgid "--previous compares two .msi packages"
msgstr "--previous দুটি .msi প্যাকেজ তুলনা করে"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: অপারেটিং সিস্টেমের রুট সার্টিফিকেট পড়া যায় না"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} আউটপুট '{2}'-এর সাথে মেলে না"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} বাস্তবায়িত নয় (msi বা msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target msi বা msix নেয় ('{1}' পাওয়া গেছে)"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots এবং --proxy --timestamp-এর সাথে যায়"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test এবং --msix-compress .msix আউটপুটের জন্য"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test স্বাক্ষরহীন প্যাকেজের জন্য; --key থাকলে এটি বাদ দিন"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate none, অথবা product-code,upgrade-code,language,platform-এর কয়েকটি নেয়"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget হলো .msi, .msix বা .msixbundle আউটপুটের জন্য"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "--winget-এর জন্য একটি [winget] টেবিল লাগে: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "--winget-এর জন্য প্যাকেজ একটি ফাইলে থাকতে হবে: winget একটি ফাইল নামায়, তাই cab = \"external\" নয়"

msgid "-D %.*s is given twice"
msgstr "-D {1} দুবার দেওয়া হয়েছে"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' একটি Windows নাম; ভেরিয়েবলের অন্য নাম দিন"

msgid "-D needs NAME=VALUE (got '%s')"
