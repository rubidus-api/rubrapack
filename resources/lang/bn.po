msgstr "Source-কে টাইপ {1}-এর জন্য একটি File সারির নাম দিতে হবে"

msgid "Start menu shortcut?"
msgstr "স্টার্ট মেনু শর্টকাট?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "স্টার্ট মেনু, প্রোগ্রাম, ডেস্কটপ এবং স্টার্টআপ এন্ট্রি [shortcut.*] এবং [msix-extension.*] থেকে আসে"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "rubrapack যে উপসেট পড়ে তার বাইরের TOML, অথবা `format` নেই বা খুব নতুন"

msgid "Tables"
msgstr "টেবিল"

msgid "The TOML subset"
msgstr "TOML উপসেট"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "UTF-16 big-endian ফাইল সমর্থিত নয়; UTF-8 হিসেবে সংরক্ষণ করুন"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} আগের সংস্করণের {2} থেকে আলাদা: এই প্যাকেজ এটি প্রতিস্থাপন করে না"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode রেজিস্ট্রি বিন্যাসে GUID নয়"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "মান (লেখা, সংখ্যা, true/false, [\"a\", \"b\"]; - কী সরায়)"

msgid "Variables"
msgstr "ভেরিয়েবল"

msgid "Version"
msgstr "সংস্করণ"

msgid "Version ([define] VERSION)"
msgstr "সংস্করণ ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "সংস্করণ ও আপগ্রেড"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer সর্বোচ্চ 255.255.65535(.65535) অনুমোদন করে"

msgid "Windows did not say what is installed for '%s'"
msgstr "'{1}'-এর জন্য কী ইনস্টল করা আছে Windows তা বলেনি"

msgid "Windows name"
msgstr "Windows নাম"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}]-এর জন্য '{4}' দরকার"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] মার্জ মডিউলে যেতে পারে না; যে প্যাকেজ এটি একত্রিত করে তাতে থাকে"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] এখনো সমর্থিত নয় ({3}-এর জন্য পরিকল্পিত)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] MSIX-এ যেতে পারে না; এটি ছাড়া MSIX তৈরি করতে msi-only = true যোগ করুন"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] ব্যবহারকারীর AppData বা LocalAppData-তে আছে: সব ব্যবহারকারীর জন্য ইনস্টল করা dual প্যাকেজ এটি কেবল ইনস্টলকারী ব্যবহারকারীর প্রোফাইলে রাখে"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: মার্জ মডিউলে একটি ID সর্বোচ্চ 35 অক্ষরের (এতে মডিউলের GUID যোগ হয়)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}]-এর জন্য একটি ID দরকার: [{2}.ID] লিখুন"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] কোনো ID নেয় না: [{2}] লিখুন"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml-এ </Types> নেই"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml শেষ এন্ট্রি নয় (rubrapack বা Windows প্যাকেজিং API-এর লেখা প্যাকেজ নয়)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "[[...]] টেবিলের অ্যারে সমর্থিত নয়; প্রতিটি আইটেমকে নিজস্ব [kind.ID] দিন"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] একবার বসানো হয়: before, after বা sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}]-এর জন্য do এবং undo দুটোই দরকার (undo একটি ব্যর্থ do-কেও ফিরিয়ে নেয়)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}]-এর entry লাগে: যে DLL ফাংশন ডাকা হবে"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}]-এর run = \"file:<ID>\" লাগে: do ও undo যে প্রোগ্রাম চালায়"

msgid "[action.%s] runs a file of this package before InstallFinalize, where a first installation does not have it yet (Windows Installer error 1721 or 1723): place it after InstallFinalize, or make it deferred"
msgstr "[action.{1}] InstallFinalize-এর আগে এই প্যাকেজের একটি ফাইল চালায়, অথচ প্রথম ইনস্টলেশনে সেই ফাইল এখনও থাকে না (Windows Installer ত্রুটি 1721 বা 1723): এটিকে InstallFinalize-এর পরে রাখুন বা deferred করুন"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] একটি জিনিস চালায়: run (একটি exe), dll (ইনস্টল করা DLL) বা binary (প্যাকেজের DLL); বা do ও undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} একটি ক্রিয়ার জন্য, do/undo জোড়ার জন্য নয়"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: ইনস্টল করা ফাইল চালানো স্থগিত ক্রিয়া InstallFiles-এর পরে হতে হবে (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: তাৎক্ষণিক ক্রিয়া ইনস্টলকারী ব্যবহারকারী হিসেবে চলে; as অন্য ধাপগুলোর জন্য"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args একটি প্রোগ্রামের; DLL data নেয়"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check do/undo জোড়ার সঙ্গে যায়"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data স্থগিত, commit বা rollback ক্রিয়ার জন্য (তাৎক্ষণিক ক্রিয়া বৈশিষ্ট্য পড়ে)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry একটি DLL-এর ফাংশন; run args নেয়"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: MSIX-এর জন্য args সাধারণ লেখা হতে হবে (ইনস্টলের সময় পূরণ হওয়া [...] নয়)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: MSIX-এ একটি ফাইল টাইপ একটি অ্যাপ খোলে: target-কে [msix-app.*] এক্সিকিউটেবল হতে হবে"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] দুবার আছে"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package]-এর জন্য একটি ID দরকার: [chain-package.ID] লিখুন"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id এবং typelib শুধু MSI-এর জন্য লেখা হয়; MSIX ক্লাসটি এগুলি ছাড়াই নিবন্ধন করে"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args একটি প্রোগ্রামের; DLL লোড করা হয়, চালু করা হয় না"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate একটি DLL-কে dllhost-এ চালায়; '{2}' একটি প্রোগ্রাম"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading একটি DLL-এর জন্য; প্রোগ্রাম নিজের অ্যাপার্টমেন্ট নিজেই ঠিক করে"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version এবং typelib-file-এর জন্য typelib দরকার"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] {2}-এ যায়; অথবা msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: এর উৎস প্যাকেজে যাওয়া একটি ফাইল হতে হবে"

msgid "[define] values must be strings"
msgstr "[define]-এর মান স্ট্রিং হতে হবে"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}]-এর জন্য '{2}' দরকার"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}]-এর image প্রয়োজন"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}]-এর জন্য 'property' দরকার"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}]-এর জন্য 'text' দরকার"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}]-এর জন্য 'values' দরকার"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}]-এ {2}টি কন্ট্রোল আছে; সর্বোচ্চ 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}]-এ কোনো [dialog-control.*] নেই"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] অন্য ডায়ালগের মাধ্যমে নিজের পরেই রাখা হয়েছে"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}]-এর জন্য ui = \"minimal\", \"installdir\" বা \"features\" দরকার"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' একটি Windows নাম; dir-কে অন্য ID দিন"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard-এর জন্য rubrapack-এর সহায়ক DLL দরকার, যা মার্জ মডিউল বহন করে না"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}]-এর জন্য একটি বৈশিষ্ট্য দরকার"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: একটি MSIX তার সব ভেরিয়েবল সেট করে (when); msi-only = true ব্যবহার করুন"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: এর মান এমন একটি জায়গার নাম দেয় যা MSIX দিতে পারে না (প্যাকেজের বাইরের ফোল্ডার যা Windows ফোল্ডার নয়, বা ইনস্টল-সময়ের অংশ); msi-only = true ব্যবহার করুন"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: external-location = true থাকলে প্যাকেজে প্রোগ্রামের কোনো ফাইল থাকে না, তাই rubrapack-এর লঞ্চারও নয়; অথবা msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] ইতিমধ্যে তার প্রোগ্রামের ফোল্ডারে আছে; isolate-for অন্যত্র ইনস্টল করা শেয়ার করা DLL-এর জন্য"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] ব্যবহারকারীর প্রোফাইলে আছে এবং এতে component-guid আছে: এর কী পাথ ফাইলটিই থাকে, অথচ Windows-এর নিয়ম সেখানে একটি HKCU মান চায় (ICE38); সেটি পেতে component-guid বাদ দিন"

msgid "[file.%s]: '%s' is not a .NET assembly (no CLI header with an Assembly row)"
msgstr "[file.{1}]: '{2}' .NET অ্যাসেম্বলি নয় (Assembly সারি থাকা CLI হেডার নেই)"

msgid "[file.%s]: a .NET assembly carries its manifest itself; manifest is for a Win32 one"
msgstr "[file.{1}]: .NET অ্যাসেম্বলি নিজের ম্যানিফেস্ট নিজেই বহন করে; manifest Win32 অ্যাসেম্বলির জন্য"

msgid "[file.%s]: a Win32 assembly needs manifest = \"file:<ID>\", its manifest file"
msgstr "[file.{1}]: Win32 অ্যাসেম্বলির manifest = \"file:<ID>\", অর্থাৎ তার ম্যানিফেস্ট ফাইল দরকার"

msgid "[file.%s]: a shared .NET assembly goes into the GAC, which takes strong-named ones only; sign it, or give assembly-for = \"file:<program>\""
msgstr "[file.{1}]: শেয়ার করা .NET অ্যাসেম্বলি GAC-এ যায়, যা কেবল শক্ত-নামের অ্যাসেম্বলি নেয়; এতে স্বাক্ষর করুন বা assembly-for = \"file:<প্রোগ্রাম>\" দিন"

msgid "[file.%s]: a shared Win32 assembly goes into WinSxS with a catalog signed by the key its manifest's publicKeyToken names; build with --key (or give assembly-for = \"file:<program>\" for a private one)"
msgstr "[file.{1}]: শেয়ার করা Win32 অ্যাসেম্বলি WinSxS-এ যায় এমন ক্যাটালগ নিয়ে যা ম্যানিফেস্টের publicKeyToken যে কী-র নাম দেয় তা দিয়ে স্বাক্ষরিত; --key দিয়ে তৈরি করুন (বা ব্যক্তিগত অ্যাসেম্বলির জন্য assembly-for = \"file:<প্রোগ্রাম>\" দিন)"

msgid "[file.%s]: its manifest names publicKeyToken \"%s\", but the --key's token is \"%s\""
msgstr "[file.{1}]: ম্যানিফেস্ট publicKeyToken \"{2}\" বলে, কিন্তু --key-এর টোকেন \"{3}\""

msgid "[file.%s]: %s"
msgstr "[file.{1}]: {2}"

msgid "[file.%s]: a shared Win32 assembly's manifest '%s' names its signer: publicKeyToken in assemblyIdentity (the token of the --key it is built with)"
msgstr "[file.{1}]: শেয়ার করা Win32 অ্যাসেম্বলির ম্যানিফেস্ট '{2}' তার স্বাক্ষরকারীর নাম দেয়: assemblyIdentity-তে publicKeyToken (যে --key দিয়ে তৈরি তার টোকেন)"

msgid "a shared Win32 assembly's catalog needs an RSA key of 2048 bits or more"
msgstr "শেয়ার করা Win32 অ্যাসেম্বলির ক্যাটালগের জন্য 2048 বিট বা তার বেশি RSA কী লাগে"

msgid "[file.%s]: assembly-for and manifest go with assembly = \"dotnet\" or \"win32\""
msgstr "[file.{1}]: assembly-for ও manifest, assembly = \"dotnet\" বা \"win32\"-এর সঙ্গে যায়"

msgid "[file.%s]: its manifest '%s' has no assemblyIdentity with a name and a version"
msgstr "[file.{1}]: এর ম্যানিফেস্ট '{2}'-এ name ও version সহ assemblyIdentity নেই"

msgid "[file.%s]: its manifest '%s' must be in the same dir and feature (and under the same when): the two are one component"
msgstr "[file.{1}]: এর ম্যানিফেস্ট '{2}' একই dir ও feature-এ (একই when-এ) থাকতে হবে: দুটি এক উপাদান"

msgid "[file.%s]: the manifest '%s' is another assembly's or an assembly itself"
msgstr "[file.{1}]: ম্যানিফেস্ট '{2}' অন্য অ্যাসেম্বলির বা নিজেই অ্যাসেম্বলি"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer একটি DLL থেকে {2} হ্যান্ডলার লোড করে; [com.{3}] একটি প্রোগ্রাম"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows প্রপার্টি হ্যান্ডলার শুধু মেশিন স্তরে পড়ে; প্যাকেজের scope = \"machine\" দরকার"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: প্রিভিউ হ্যান্ডলার Windows-এর prevhost-এ চলে; [com.{2}] থেকে app-id এবং surrogate বাদ দিন"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX শুধু থাম্বনেইল ও প্রিভিউ হ্যান্ডলার বহন করে (প্যাকেজড প্রপার্টি হ্যান্ডলার Explorer-কে কোনো মান দেয়নি); msi-only = true এটি MSI-এর জন্য রাখে"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: একটি MSIX ফাইল টাইপ একটি অ্যাপের; একটি [msix-app.*] যোগ করুন"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: ক্লাস {2} এই প্যাকেজের [com.*] নয় (হ্যান্ডলারের DLL এটি পরিবেশন করে)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: MSIX-এ হ্যান্ডলাররা তাদের সব টাইপ ভাগ করে বা কোনোটিই না (একটি টাইপ একটি ফাইল টাইপ অ্যাসোসিয়েশনে থাকে)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: MSIX-এ এর ক্লাস একটি সারোগেটে চলে; [com.{2}]-এ threading = \"sta\" এর উইন্ডোকে একটি মেসেজ লুপ দেয় (threading = {3} হলে প্রিভিউ ফাঁকা থাকতে পারে)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: MSIX-এ এর সব টাইপ একটি [assoc] ফাইল টাইপে থাকে, বা কোনোটিই না"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: এর ক্লাস শুধু MSI ([com.{2}]); MSIX-এ এর জন্য কোনো সার্ভার থাকবে না"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types হলো ফাইল টাইপের তালিকা, যেমন [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2}-এ যায়; অথবা msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}]-এর জন্য 'value' দরকার"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}]-এর জন্য একটি বৈশিষ্ট্য দরকার: 'feature' এখানে বা এর dir-এ সেট করুন"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: একটি MSIX তার সব INI এন্ট্রি লেখে (when); msi-only = true ব্যবহার করুন"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: এর মানে এমন একটি অংশ আছে যা Windows Installer ইনস্টলের সময় পূরণ করে ([...]); একটি MSIX তৈরির সময় ফাইলটি লেখে"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}]-এর জন্য 'on' দরকার: আইটেমটি কোথায় দেখায়, যেমন [\".txt\"] বা \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}]-এর জন্য 'target' (যে প্রোগ্রাম চালু করে) বা parent = \"{2}\" সহ আইটেম (একটি সাবমেনু) দরকার"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}]-এর জন্য 'target' দরকার: আইটেমটি যে প্রোগ্রাম চালু করে"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11-এর মেনু শুধু অক্ষর ও অঙ্কের ID নেয় ('_' নয়): নাম বদলান, অথবা windows11 = false দিন"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: একটি সাবমেনু কিছুই চালু করে না: 'args' বাদ দিন"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: একটি সাবমেনুর আইটেম সেখানে দেখায় যেখানে তার সাবমেনু দেখায়: 'on' বাদ দিন"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args-এ এমন অংশ আছে যা Windows Installer ইনস্টলের সময় পূরণ করে ([...]); একটি MSIX শুধু স্থির লেখা রাখে"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when হলো \"HKCU\\\\key\\\\value\" বা \"HKLM\\\\...\", Windows 11 মেনুর এমন আইটেমে যা কোনো সাবমেনুতে নেই"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when এমন একটি মান দেখায় যা এই প্যাকেজ নিজেই লেখে ([registry.{2}]): আইটেমটি কখনো দেখা যাবে না"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: এর প্রোগ্রাম MSIX-এ নেই (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: এর মানগুলি প্যাকেজের রেজিস্ট্রিতে যেতে পারে না"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list-এ এমন অংশ আছে যা Windows Installer ইনস্টলের সময় পূরণ করে ([...]); একটি MSIX শুধু স্থির লেখা রাখে"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: পথগুলো একটি কমান্ড লাইনে না ধরলে list, {2}-এর জায়গা নেয়: multi = \"one\", args-এ {3} এবং list-এ {4} (তালিকা ফাইল) লাগবে"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": কোনো [assoc.{3}] নেই"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on হলো একটি ফাইল টাইপ বা তাদের তালিকা, যেমন [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: প্যারেন্ট '{2}' একটি [menu.*] নয়"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: প্যারেন্ট '{2}'-কে একটি সাবমেনু হতে হবে: target ছাড়া এবং নিজের প্যারেন্ট ছাড়া একটি [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2}-এ যায়; অথবা msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}]-এর জন্য একটি বৈশিষ্ট্য দরকার: 'feature' এখানে বা এর dir-এ সেট করুন"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; অথবা msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}]-এর feature লাগে (বা with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature নিজের উপাদানের সঙ্গে যায়, with-এর সঙ্গে নয়"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name একটি ফাইল নির্দেশ করে; name-এ ওয়াইল্ডকার্ড আছে"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: শেয়ার টার্গেটের types, formats বা দুটোই দরকার"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: অটোপ্লে হ্যান্ডলারের content-events, device-events বা দুটোই দরকার"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args সাধারণ লেখা হতে হবে (ইনস্টলের সময় পূরণ হওয়া [...] নয়)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events-এর class দরকার (প্রোগ্রামের IHWEventHandler COM ক্লাস)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file-কে {2} হতে হবে"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file-কে প্যাকেজে যাওয়া একটি ফাইলের নাম দিতে হবে"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file-কে প্যাকেজে যাওয়া একটি প্রোগ্রামের নাম দিতে হবে"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types হলো ফাইল টাইপের তালিকা, যেমন [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows শুধু অক্ষর ও অঙ্ক নেয়"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64-এর জন্য [msix-psf]-এ launcher = \"...\" লাগে (PSF তার লঞ্চারগুলোর নাম দেয় PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] external-location = true বা [env.*] (rubrapack-এর নিজস্ব লঞ্চার) কোনোটির সঙ্গেই চলে না"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] অ্যাপ্লিকেশনগুলো PSF লঞ্চার দিয়ে চালু করে: এর জন্য [msix-app.ID] লাগে"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' তার \"applications\"-এ অ্যাপ্লিকেশন '{2}'-এর নাম দেয় না"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files-এ '{1}' নেই (লঞ্চার)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: ফাইল '{2}' DLL নয়"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] তার ড্রাইভার একবার নির্দেশ করে: driver (একটি [odbc-driver]) বা driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] driver-name সহ with = \"file:<ID>\" লাগে: যে উপাদানের সঙ্গে এটি ইনস্টল হয়"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: প্রতি মেশিন প্যাকেজ ডেটা উৎসগুলো মেশিনের জন্য নিবন্ধন করে"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] একটি কপি দেখায়: msix (publisher সহ) বা upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix হলো প্যাকেজের পরিচয় নাম (৩ থেকে ৫০টি অক্ষর, অঙ্ক, '.' বা '-') এবং এর publisher (\"CN=...\") লাগবে, ম্যানিফেস্টে যেমন আছে"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: অন্য কপিটি আগাম পরীক্ষা খোঁজে: preflight = true লাগবে"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code এই প্যাকেজেরই (সেটি আপগ্রেড, অন্য কপি নয়)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}]-এর জন্য এর dir-এর একটি বৈশিষ্ট্য থাকতে হবে"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: MSIX-এর জন্য args সাধারণ লেখা হতে হবে (ইনস্টলের সময় পূরণ হওয়া [...] নয়)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: MSIX-এ একটি স্কিম একটি অ্যাপ খোলে: target-কে [msix-app.*] এক্সিকিউটেবল হতে হবে"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}]-এর জন্য 'value' দরকার (বা remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR MSIX-এর বাইরে পৌঁছায় না; [assoc.*], [protocol.*], [com.*] বা [handler.*], অথবা msi-only = true ব্যবহার করুন"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: একটি qword মানের জন্য rubrapack-এর সহায়ক DLL দরকার, যা মার্জ মডিউল বহন করে না"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: একটি MSIX শুধু {2}\\Software-এর অধীনের মান বহন করে"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: একটি MSIX মান সরায়ও না, পিছনে রেখেও যায় না (remove, keep); msi-only = true ব্যবহার করুন"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: একটি MSIX তার সব মান লেখে (when); msi-only = true ব্যবহার করুন"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: এর মানে এমন একটি অংশ আছে যা Windows Installer ইনস্টলের সময় পূরণ করে ([...]); একটি MSIX শুধু স্থির মান রাখে"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\"-এর জন্য rubrapack-এর সহায়ক DLL দরকার, যা মার্জ মডিউল বহন করে না"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: কী বা মানের নাম একটি রেজিস্ট্রি হাইভে যেতে পারে না"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" কম্পিউটার-ভিত্তিক প্যাকেজে on = \"uninstall\" সহ root = \"HKCU\"-এর জন্য"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}]-এর জন্য একটি বৈশিষ্ট্য দরকার: 'feature' এখানে বা এর dir-এ সেট করুন"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true {2}-এর অধীনের ফোল্ডারের জন্য নয়"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true-এর জন্য rubrapack-এর সহায়ক DLL দরকার, যা মার্জ মডিউল বহন করে না"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" কম্পিউটার-ভিত্তিক প্যাকেজে AppData বা LocalAppData-র ফোল্ডারে recursive = true-এর জন্য"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: MSIX-এর জন্য args সাধারণ লেখা হতে হবে (ইনস্টলের সময় পূরণ হওয়া [...] নয়)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file-কে প্যাকেজে যাওয়া একটি প্রোগ্রামের নাম দিতে হবে"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] '{2}' বৈশিষ্ট্যের বিজ্ঞাপন দেয়, যার advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise, when-এর সাথে একত্রিত হয় না"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: একটি MSIX-এর শর্টকাট শুধু ডেস্কটপ ও স্টার্ট মেনুতে থাকে{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: একটি MSIX শর্টকাটের কোনো working-dir নেই"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: একটি MSIX শর্টকাট সবসময় থাকে (when MSI-এর জন্য)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: একটি MSIX শর্টকাট তার অ্যাপের লোগো দেখায়; icon MSI-এর জন্য"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: একটি বিজ্ঞাপিত শর্টকাট MSI-এর জন্য (MSIX সম্পূর্ণ প্যাকেজ ইনস্টল করে)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: একটি বিজ্ঞাপিত শর্টকাটের জন্য একটি আইকন প্রয়োজন"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: MSIX-এর জন্য args সাধারণ লেখা হতে হবে (ইনস্টলের সময় পূরণ হওয়া [...] নয়)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: MSIX-এ একটি শর্টকাট একটি অ্যাপ চালু করে: target-কে [msix-app.*] এক্সিকিউটেবল হতে হবে"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: একটি MSIX-এর স্টার্ট মেনু এন্ট্রি তার অ্যাপ, যা কোনো args নেয় না"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: কোনো ডায়ালগ লেখার এই ID নেই"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded MSI-এর জন্য; MSIX-এর নিজস্ব ইনস্টলার UI নেই"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui]-এর জন্য [package]-এ ui = \"basic\" বা অন্য একটি ডায়ালগ সেট প্রয়োজন (বা embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} এস্কেপ একটি ইউনিকোড স্কেলার মান নয়"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: এই প্যাকেজ আগেরটিকে পরিষ্কারভাবে আপগ্রেড করবে না"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "একটি প্যাকেজের `lint`: ডায়ালগ, কোড পেজ, লেখার স্বাভাবিকীকরণ"

msgid "`lint` of an MSIX package or bundle"
msgstr "একটি MSIX প্যাকেজ বা বান্ডলের `lint`"

msgid "a %s control has no property"
msgstr "{1} নিয়ন্ত্রণের কোনো property নেই"

msgid "a %s control has no text; put a text control beside it"
msgstr "একটি {1} কন্ট্রোলের কোনো লেখা নেই; পাশে একটি টেক্সট কন্ট্রোল রাখুন"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "একটি {1} কন্ট্রোলের জন্য [property.{2}] দরকার যার একটি মান ডিফল্ট (নীরব ইনস্টলেশন এটি ব্যবহার করে)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "একটি {1} প্যাকেজ HKLM-এ লিখতে পারে না; HKMU ব্যবহার করুন"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "একটি .msix আউটপুটের জন্য এক্সিকিউটেবলের নাম দেওয়া একটি [msix-app.ID] টেবিল দরকার"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "একটি .msix আউটপুটের জন্য একটি [msix] টেবিল দরকার (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "একটি .msm আউটপুট একটি মার্জ মডিউল, যা [package]-এর বদলে [module] থাকা উৎস থেকে তৈরি"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "একটি .txt, .md বা .rtf ফাইল, অথবা কোনোটি না হলে -"

msgid "a PE file without a certificate table entry"
msgstr "সার্টিফিকেট টেবিল এন্ট্রি ছাড়া একটি PE ফাইল"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN কখনো কমান্ড লাইন থেকে নেওয়া হয় না (অন্যরা দেখতে পারে); --pin-env বা --pin-file ব্যবহার করুন"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "বান্ডল ম্যানিফেস্টের একটি Package অজানা Type-সহ"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "বান্ডল ম্যানিফেস্টের FileName, Offset বা Size ছাড়া একটি Package"

msgid "a ZIP entry does not inflate to its size"
msgstr "একটি ZIP এন্ট্রি তার আকারে প্রসারিত হয় না"

msgid "a ZIP entry larger than allowed"
msgstr "অনুমোদিতের চেয়ে বড় একটি ZIP এন্ট্রি"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "একটি ZIP এন্ট্রির CRC-32 মেলে না"

msgid "a ZIP entry's data lies outside the file"
msgstr "একটি ZIP এন্ট্রির ডেটা ফাইলের বাইরে"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "একটি [module] উৎস একটি মার্জ মডিউল তৈরি করে: -o <name>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "একটি বাইনারি মান হলো জোড় সংখ্যক হেক্স অঙ্ক, যেমন \"01A0FF\""

msgid "a bundle without packages"
msgstr "প্যাকেজবিহীন একটি বান্ডল"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "পথের একটি সার্টিফিকেটে এমন গুরুত্বপূর্ণ এক্সটেনশন আছে যা rubrapack বোঝে না"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "পথের একটি সার্টিফিকেট এমন সার্টিফিকেট দিয়ে স্বাক্ষরিত যা CA নয়"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "একটি চেইনে শুধু [chain], [chain-package.ID] এবং [define] থাকে, [{1}] নয়; প্যাকেজগুলি নিজেদের উৎস থেকে তৈরি"

msgid "a chain holds at most %d packages"
msgstr "একটি চেইনে সর্বোচ্চ {1}টি প্যাকেজ থাকে"

msgid "a chain needs [chain]"
msgstr "একটি চেইনের জন্য [chain] দরকার"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "একটি চেইনের জন্য অন্তত একটি [chain-package.ID] দরকার"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "এমন অক্ষর যা Windows নামে অনুমোদন করে না (/ \\ : * ? \" < > |)"

msgid "a container holds at most %u package families"
msgstr "একটি কন্টেইনারে সর্বাধিক {1}টি প্যাকেজ পরিবার থাকে"

msgid "a control character"
msgstr "একটি নিয়ন্ত্রণ অক্ষর"

msgid "a damaged PE optional header"
msgstr "একটি ক্ষতিগ্রস্ত PE ঐচ্ছিক হেডার"

msgid "a damaged PE section table"
msgstr "একটি ক্ষতিগ্রস্ত PE সেকশন টেবিল"

msgid "a damaged ZIP64 end record"
msgstr "একটি ক্ষতিগ্রস্ত ZIP64 শেষ রেকর্ড"

msgid "a damaged cabinet header"
msgstr "ক্ষতিগ্রস্ত cabinet হেডার"

msgid "a damaged hive bin"
msgstr "একটি ক্ষতিগ্রস্ত হাইভ bin"

msgid "a diagnostic of rubrapack"
msgstr "rubrapack-এর একটি ডায়াগনস্টিক"

msgid "a disabled service cannot be started"
msgstr "নিষ্ক্রিয় পরিষেবা চালু করা যায় না"

msgid "a dual package cannot choose between a user and a system variable"
msgstr "একটি dual প্যাকেজ ব্যবহারকারী ও সিস্টেম ভেরিয়েবলের মধ্যে বেছে নিতে পারে না"

msgid "a dual package writes HKMU (HKLM or HKCU as installed), not HKCU"
msgstr "একটি dual প্যাকেজ HKMU-তে লেখে (ইনস্টল অনুযায়ী HKLM বা HKCU), HKCU-তে নয়"

msgid "a dword value is an integer 0..4294967295 (0x0..0xFFFFFFFF)"
msgstr "একটি dword মান হলো 0..4294967295 পূর্ণসংখ্যা (0x0..0xFFFFFFFF)"

msgid "a feature this rubrapack does not provide (or was built without)"
msgstr "এমন একটি সুবিধা যা এই rubrapack দেয় না (বা যা ছাড়াই তৈরি)"

msgid "a file larger than allowed"
msgstr "অনুমোদিতের চেয়ে বড় একটি ফাইল"

msgid "a file name under '%s' is not valid Unicode and cannot be packaged"
msgstr "'{1}'-এর অধীনে একটি ফাইলের নাম বৈধ ইউনিকোড নয় এবং প্যাকেজ করা যায় না"

msgid "a file name without / \\ : * ? \" < > | $"
msgstr "/ \\ : * ? \" < > | $ ছাড়া একটি ফাইলের নাম"

msgid "a file's component or directory chain is broken"
msgstr "একটি ফাইলের উপাদান বা ডিরেক্টরি শৃঙ্খল ভাঙা"

msgid "a font goes into an MSIX through a [font.*] that names it"
msgstr "একটি ফন্ট MSIX-এ যায় একটি [font.*]-এর মাধ্যমে যা তার নাম দেয়"

msgid "a framework package has no applications, capabilities or dependencies of its own (%s)"
msgstr "ফ্রেমওয়ার্ক প্যাকেজের নিজস্ব কোনো অ্যাপ্লিকেশন, সক্ষমতা বা নির্ভরতা থাকে না ({1})"

msgid "a hash the token signing does not know"
msgstr "এমন একটি হ্যাশ যা টোকেন স্বাক্ষর জানে না"

msgid "a hive cell crosses its bin"
msgstr "একটি হাইভ সেল তার bin অতিক্রম করে"

msgid "a hive version or type rubrapack does not read"
msgstr "হাইভের এমন সংস্করণ বা ধরন যা rubrapack পড়ে না"

msgid "a known folder itself ('%s') cannot get permissions"
msgstr "একটি পরিচিত ফোল্ডার নিজে ('{1}') অনুমতি পেতে পারে না"

msgid "a license needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "একটি লাইসেন্সের জন্য ui = \"minimal\", \"installdir\" বা \"features\" দরকার"

msgid "a local header with extra fields (not a package rubrapack or Windows' packaging API wrote)"
msgstr "অতিরিক্ত ফিল্ডসহ একটি লোকাল হেডার (rubrapack বা Windows প্যাকেজিং API-এর লেখা প্যাকেজ নয়)"

msgid "a malformed central directory"
msgstr "একটি ত্রুটিপূর্ণ কেন্দ্রীয় ডিরেক্টরি"

msgid "a modification package has no applications of its own"
msgstr "একটি পরিবর্তন প্যাকেজের নিজস্ব কোনো অ্যাপ নেই"

msgid "a modification package needs Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "একটি পরিবর্তন প্যাকেজের জন্য Windows বিল্ড 18362 বা পরবর্তী দরকার: [msix] min-version = \"10.0.18362.0\" সেট করুন"

msgid "a module's compress is \"none\", \"mszip\" or \"mszip:0\" ... \"mszip:9\""
msgstr "একটি মডিউলের compress হলো \"none\", \"mszip\" বা \"mszip:0\" ... \"mszip:9\""

msgid "a module's name is its ID in the ModuleID: letters, digits and _, at most 35 characters"
msgstr "একটি মডিউলের নাম ModuleID-তে তার ID: অক্ষর, সংখ্যা এবং _, সর্বোচ্চ 35 অক্ষর"

msgid "a multi value is a non-empty array of strings"
msgstr "একটি multi মান হলো স্ট্রিংয়ের একটি অ-শূন্য অ্যারে"

msgid "a multi value is an array of strings"
msgstr "একটি multi মান হলো স্ট্রিংয়ের একটি অ্যারে"

msgid "a name ending with a space or a dot"
msgstr "স্পেস বা বিন্দু দিয়ে শেষ হওয়া নাম"

msgid "a name longer than 255 bytes"
msgstr "255 বাইটের চেয়ে দীর্ঘ নাম"

msgid "a package named in the bundle manifest is not in the bundle"
msgstr "বান্ডল ম্যানিফেস্টে নাম দেওয়া একটি প্যাকেজ বান্ডলে নেই"

msgid "a package without Identity Name, Publisher, Version and ProcessorArchitecture (or ResourceId)"
msgstr "Identity Name, Publisher, Version এবং ProcessorArchitecture (বা ResourceId) ছাড়া একটি প্যাকেজ"

msgid "a package's Offset or Size in the bundle manifest does not match where it lies (or it is compressed)"
msgstr "বান্ডল ম্যানিফেস্টে একটি প্যাকেজের Offset বা Size তার অবস্থানের সাথে মেলে না (বা এটি সংকুচিত)"

msgid "a package's identity differs from what the bundle manifest says of it"
msgstr "একটি প্যাকেজের পরিচয় বান্ডল ম্যানিফেস্ট এ সম্পর্কে যা বলে তা থেকে আলাদা"

msgid "a package's name in the bundle must be a file name ending in .msix or .appx"
msgstr "বান্ডলে একটি প্যাকেজের নাম .msix বা .appx দিয়ে শেষ হওয়া ফাইল নাম হতে হবে"

msgid "a password is never taken on the command line (others can see it); use --pass-env or --pass-file"
msgstr "পাসওয়ার্ড কখনো কমান্ড লাইন থেকে নেওয়া হয় না (অন্যরা দেখতে পারে); --pass-env বা --pass-file ব্যবহার করুন"

msgid "a per-machine package does not write HKCU (it would be the installing user's); use scope = \"user\""
msgstr "মেশিন-প্রতি প্যাকেজ HKCU-তে লেখে না (এটি ইনস্টলকারী ব্যবহারকারীর হতো); scope = \"user\" ব্যবহার করুন"

msgid "a proxy with a user name or password is not supported"
msgstr "ব্যবহারকারী নাম বা পাসওয়ার্ডসহ প্রক্সি সমর্থিত নয়"

msgid "a qword value is an integer or \"0x\" and 1 to 16 hex digits"
msgstr "একটি qword মান হলো পূর্ণসংখ্যা বা \"0x\" এবং 1 থেকে 16টি হেক্স অঙ্ক"

msgid "a radio control stacks its buttons: height must be at least 12 per value (%d)"
msgstr "একটি radio কন্ট্রোল তার বোতামগুলি স্তূপ করে: উচ্চতা প্রতি মানে অন্তত 12 হতে হবে ({1})"

msgid "a record has more columns than its table"
msgstr "একটি রেকর্ডে তার টেবিলের চেয়ে বেশি কলাম আছে"

msgid "a record is cut short"
msgstr "একটি রেকর্ড অসম্পূর্ণভাবে কাটা"

msgid "a record names a string the pool does not have"
msgstr "একটি রেকর্ড এমন স্ট্রিংয়ের নাম দেয় যা পুলে নেই"

msgid "a reserved device name"
msgstr "একটি সংরক্ষিত ডিভাইস নাম"

msgid "a rollback action cannot be asynchronous"
msgstr "একটি রোলব্যাক ক্রিয়া অ্যাসিঙ্ক্রোনাস হতে পারে না"

msgid "a scheme is a lower-case letter, then lower-case letters, digits, '+', '-' or '.' (got '%s')"
msgstr "একটি স্কিম হলো একটি ছোট হাতের অক্ষর, তারপর ছোট হাতের অক্ষর, সংখ্যা, '+', '-' বা '.' ('{1}' পাওয়া গেছে)"

msgid "a script action between InstallInitialize and RemoveExistingProducts (error 2613)"
msgstr "InstallInitialize এবং RemoveExistingProducts-এর মধ্যে একটি স্ক্রিপ্ট ক্রিয়া (ত্রুটি 2613)"

msgid "a section lies outside the file"
msgstr "একটি সেকশন ফাইলের বাইরে"

msgid "a service name may not contain '/' or '\\' (at most 256 characters)"
msgstr "পরিষেবার নামে '/' বা '\\' থাকতে পারে না (সর্বোচ্চ 256 অক্ষর)"

msgid "a setup .exe is built from a source with [chain]; '%s' builds a package (.msi, .msix)"
msgstr "একটি সেটআপ .exe [chain] থাকা উৎস থেকে তৈরি হয়; '{1}' একটি প্যাকেজ তৈরি করে (.msi, .msix)"

msgid "a source holds one [package] or one [module], not both"
msgstr "একটি উৎসে একটি [package] বা একটি [module] থাকে, দুটোই নয়"

msgid "a source that passes the RP1xxx checks should never meet these: please report it with the source"
msgstr "RP1xxx পরীক্ষা পাস করা উৎসের কখনো এগুলির মুখোমুখি হওয়া উচিত নয়: উৎসসহ জানান"

msgid "a stored ZIP entry whose sizes differ"
msgstr "একটি সংরক্ষিত ZIP এন্ট্রি যার আকার আলাদা"

msgid "a stream of the package cannot be read"
msgstr "প্যাকেজের একটি স্ট্রিম পড়া যায় না"

msgid "a table has more than 32 columns"
msgstr "একটি টেবিলে 32-এর বেশি কলাম আছে"

msgid "a value `with` a file shares its component: put `when` on the file"
msgstr "একটি ফাইলের `with` থাকা মান তার উপাদান ভাগ করে: `when` ফাইলে দিন"

msgid "a value is 1 to 64 bytes"
msgstr "একটি মান 1 থেকে 64 বাইট"

msgid "a value that goes 'with' a file takes that file's feature"
msgstr "একটি ফাইলের 'with' যাওয়া মান সেই ফাইলের বৈশিষ্ট্য নেয়"

msgid "a version is 3 or 4 numbers with dots, such as 1.0.0"
msgstr "একটি সংস্করণ বিন্দুসহ 3 বা 4টি সংখ্যা, যেমন 1.0.0"

msgid "account must be LocalSystem, LocalService or NetworkService"
msgstr "account-কে LocalSystem, LocalService বা NetworkService হতে হবে"

msgid "action '%s' is already defined"
msgstr "ক্রিয়া '{1}' ইতিমধ্যে সংজ্ঞায়িত"

msgid "action is neither a standard action nor in CustomAction"
msgstr "ক্রিয়াটি মানক ক্রিয়া নয়, CustomAction-এও নেই"

msgid "action must be \"warn\" or \"refuse\" (got '%s')"
msgstr "action হতে হবে \"warn\" বা \"refuse\" ('{1}' পাওয়া গেছে)"

msgid "adds too many tables"
msgstr "অতিরিক্ত টেবিল যোগ করে"

msgid "advertise is \"allow\" or \"disallow\" (got '%s')"
msgstr "advertise অবশ্যই \"allow\" বা \"disallow\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "after = '%s' is not a page of this dialog set (RpWelcomeDlg%s%s%s) or a [dialog.*]"
msgstr "after = '{1}' এই ডায়ালগ সেটের পৃষ্ঠা (RpWelcomeDlg{2}{3}{4}) বা একটি [dialog.*] নয়"

msgid "alias belongs to kind = \"alias\""
msgstr "alias kind = \"alias\"-এর অন্তর্গত"

msgid "alias must be a file name ending in .exe: letters, digits, '.', '_', '-' (got '%s')"
msgstr "alias-কে .exe দিয়ে শেষ হওয়া ফাইলের নাম হতে হবে: অক্ষর, সংখ্যা, '.', '_', '-' ('{1}' পাওয়া গেছে)"

msgid "an INI section may not contain ']' and a key may not contain '='"
msgstr "INI সেকশনে ']' এবং কী-তে '=' থাকতে পারে না"

msgid "an MSIX cannot place files in the temporary folder"
msgstr "একটি MSIX অস্থায়ী ফোল্ডারে ফাইল রাখতে পারে না"

msgid "an application has one alias ([msix-extension.%s] is one already)"
msgstr "একটি অ্যাপের একটি উপনাম থাকে ([msix-extension.{1}] ইতিমধ্যে একটি)"

msgid "an application has one share target ([msix-extension.%s] is one already)"
msgstr "একটি অ্যাপ্লিকেশনের একটি শেয়ার টার্গেট থাকে ([msix-extension.{1}] ইতিমধ্যে একটি)"

msgid "an empty name"
msgstr "একটি খালি নাম"

msgid "an https server needs --tls-trust <certificates> or --system-roots to check it against"
msgstr "একটি https সার্ভার যাচাইয়ের জন্য --tls-trust <সার্টিফিকেট> বা --system-roots দরকার"

msgid "an https:// proxy is not supported; give an http:// proxy (https servers are reached through CONNECT)"
msgstr "একটি https:// প্রক্সি সমর্থিত নয়; একটি http:// প্রক্সি দিন (https সার্ভারে CONNECT দিয়ে পৌঁছানো হয়)"

msgid "an old-style Authenticode timestamp (PKCS#9 counterSignature), which rubrapack does not check"
msgstr "পুরনো ধাঁচের Authenticode টাইমস্ট্যাম্প (PKCS#9 counterSignature), যা rubrapack যাচাই করে না"

msgid "an optional or modification package declares no capabilities and no virtualization settings: its main package's apply"
msgstr "একটি ঐচ্ছিক বা পরিবর্তন প্যাকেজ কোনো সক্ষমতা ও ভার্চুয়ালাইজেশন সেটিং ঘোষণা করে না: প্রধান প্যাকেজেরটি প্রযোজ্য"

msgid "an x86 package writes the 32-bit registry view only"
msgstr "একটি x86 প্যাকেজ শুধু 32-বিট রেজিস্ট্রি ভিউতে লেখে"

msgid "app '%s' is not an [msix-app.*]"
msgstr "অ্যাপ '{1}' একটি [msix-app.*] নয়"

msgid "appinstaller-uri and package-uri go together: where the .appinstaller file and the package will be"
msgstr "appinstaller-uri এবং package-uri একসাথে যায়: যেখানে .appinstaller ফাইল ও প্যাকেজ থাকবে"

msgid "arch must be \"x64\", \"arm64\" or \"x86\" (got '%s')"
msgstr "arch-কে \"x64\", \"arm64\" বা \"x86\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "arch must be \"x64\", \"x86\" or \"arm64\" (the setup program's own)"
msgstr "arch-কে \"x64\", \"x86\" বা \"arm64\" হতে হবে (সেটআপ প্রোগ্রামের নিজের)"

msgid "argument %d is not valid UTF-8 (byte %zu)"
msgstr "আর্গুমেন্ট {1} বৈধ UTF-8 নয় (বাইট {2})"

msgid "argument %d is not valid Unicode (UTF-16 unit %zu)"
msgstr "আর্গুমেন্ট {1} বৈধ ইউনিকোড নয় (UTF-16 একক {2})"

msgid "array is not closed"
msgstr "অ্যারে বন্ধ হয়নি"

msgid "arrays inside arrays are not supported"
msgstr "অ্যারের ভিতরে অ্যারে সমর্থিত নয়"

msgid "arrays must hold only strings or only integers"
msgstr "অ্যারেতে শুধু স্ট্রিং বা শুধু পূর্ণসংখ্যা থাকতে হবে"

msgid "as must be \"system\" or \"user\" (got '%s')"
msgstr "as \"system\" বা \"user\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "assembly must be \"dotnet\" or \"win32\""
msgstr "assembly অবশ্যই \"dotnet\" বা \"win32\" হতে হবে"

msgid "at most %d languages besides English"
msgstr "ইংরেজি ছাড়া সর্বোচ্চ {1}টি ভাষা"

msgid "at most 100 [msix-app.*] tables"
msgstr "সর্বোচ্চ 100টি [msix-app.*] টেবিল"

msgid "at most 50 [action.*] tables (this file has %zu)"
msgstr "সর্বোচ্চ 50টি [action.*] টেবিল (এই ফাইলে {1}টি)"

msgid "background-color is \"transparent\" or \"#RRGGBB\", like \"#1E3A5F\""
msgstr "background-color হলো \"transparent\" বা \"#RRGGBB\", যেমন \"#1E3A5F\""

msgid "bad variable name in '$(...)'"
msgstr "'$(...)'-এ ভুল ভেরিয়েবল নাম"

msgid "banner must be a .bmp file (Windows Installer shows BMP only)"
msgstr "banner-কে একটি .bmp ফাইল হতে হবে (Windows Installer শুধু BMP দেখায়)"

msgid "build a package from a source file"
msgstr "একটি উৎস ফাইল থেকে প্যাকেজ তৈরি করুন"

msgid "building %s from a %s source needs its own upgrade family: add %s = \"{...}\" to [package]"
msgstr "{2} উৎস থেকে {1} তৈরি করতে নিজস্ব আপগ্রেড পরিবার দরকার: [package]-এ {3} = \"{{...}\" যোগ করুন"

msgid "cab must be \"embed\" or \"external\""
msgstr "cab-কে \"embed\" বা \"external\" হতে হবে"

msgid "cannot be read"
msgstr "পড়া যায় না"

msgid "cannot build the ClientHello"
msgstr "ClientHello তৈরি করা যায় না"

msgid "cannot bundle the packages: %s"
