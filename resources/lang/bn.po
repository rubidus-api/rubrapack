msgstr "dir '{1}' সংজ্ঞায়িত নয়"

msgid "dir ID"
msgstr "dir ID"

msgid "direction must be \"in\" or \"out\" (got '%s')"
msgstr "direction-কে \"in\" বা \"out\" হতে হবে ('{1}' পাওয়া গেছে)"

