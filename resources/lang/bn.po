msgstr "ProductCode এবং UpgradeCode একই GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} প্রথম তিনটি অংশে আগের {2}-এর চেয়ে বেশি নয়: Windows Installer আপগ্রেড করে না"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "শর্টকাট যে প্রোগ্রাম খোলে (শর্টকাট না চাইলে -)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: এমন কোনো ভাষা নেই (অন্তর্নির্মিত: {2}; অন্যটির জন্য তার ভাষা প্যাক লাগবে, {3}.po)"

msgid "Reference, "
msgstr "রেফারেন্স, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "ক্রম {1} কোনো Media সারির আওতায় নেই (শেষ {2})"

msgid "Sequence %ld is used by another file"
msgstr "ক্রম {1} অন্য একটি ফাইল ব্যবহার করে"

