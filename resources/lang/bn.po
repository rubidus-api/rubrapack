msgstr "ক্লাস {1} [msix-extension.{2}]-এও আছে"

msgid "class must be a GUID like {12345678-...} (got '%s')"
msgstr "class-কে {{12345678-...} এর মতো GUID হতে হবে ('{1}' পাওয়া গেছে)"

msgid "close-programs has no effect with preflight = false"
msgstr "preflight = false থাকলে close-programs-এর কোনো প্রভাব নেই"

msgid "close-programs must be \"ask\", \"always\" or \"never\" (got '%s')"
