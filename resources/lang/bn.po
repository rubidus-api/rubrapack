msgstr "do/undo আর্গুমেন্ট 255 অক্ষরের চেয়ে দীর্ঘ"

msgid "dotted keys are not supported; put the key in its own table"
msgstr "বিন্দুযুক্ত কী সমর্থিত নয়; কীটি নিজস্ব টেবিলে রাখুন"

msgid "driver '%s' is not an [odbc-driver.*]"
msgstr "ড্রাইভার '{1}' [odbc-driver.*] নয়"

msgid "dump a package (MSI tables as IDT)"
msgstr "একটি প্যাকেজ ডাম্প করুন (MSI টেবিল IDT হিসেবে)"

msgid "duplicate primary key"
msgstr "পুনরাবৃত্ত প্রাথমিক কী"

msgid "embedded must be a .dll file (the author's UI handler)"
msgstr "embedded অবশ্যই একটি .dll ফাইল হতে হবে (লেখকের UI হ্যান্ডলার)"

msgid "empty arrays are not supported"
msgstr "খালি অ্যারে সমর্থিত নয়"

msgid "ends with a space or a dot"
msgstr "স্পেস বা বিন্দু দিয়ে শেষ হয়"

msgid "error"
msgstr "ত্রুটি"

msgid "executable = \"%s\" must name a [file.*] that goes into the package"
msgstr "executable = \"{1}\"-কে প্যাকেজে যাওয়া একটি [file.*]-এর নাম দিতে হবে"

msgid "expected ',' or ']' in the array"
msgstr "অ্যারেতে ',' বা ']' প্রত্যাশিত ছিল"

msgid "expected '=' after the key"
msgstr "কী-এর পরে '=' প্রত্যাশিত ছিল"

msgid "expected ']' to close the table name"
msgstr "টেবিলের নাম বন্ধ করতে ']' প্রত্যাশিত ছিল"

msgid "expected a key, a [table] or a comment"
msgstr "একটি কী, একটি [টেবিল] বা একটি মন্তব্য প্রত্যাশিত ছিল"

msgid "extension '%s' already has a program ([assoc.%s])"
msgstr "এক্সটেনশন '{1}'-এর ইতিমধ্যে একটি প্রোগ্রাম আছে ([assoc.{2}])"

msgid "extension must be '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "এক্সটেনশন '.' এবং ছোট হাতের অক্ষর, সংখ্যা, '_' বা '-' হতে হবে ('{1}' পাওয়া গেছে)"

msgid "external-location = true makes the identity of a program installed elsewhere: not a framework, optional or modification package"
msgstr "external-location = true প্যাকেজটিকে অন্যত্র ইনস্টল করা একটি প্রোগ্রামের পরিচয় বানায়: এটি ফ্রেমওয়ার্ক, ঐচ্ছিক বা পরিবর্তন প্যাকেজ নয়"

msgid "external-location = true needs Windows build 19041 or later: set [msix] min-version = \"10.0.19041.0\""
msgstr "external-location = true-এর জন্য Windows বিল্ড 19041 বা পরের দরকার: [msix] min-version = \"10.0.19041.0\" দিন"

msgid "extra-files has no effect with preflight = false"
msgstr "preflight = false থাকলে extra-files-এর কোনো প্রভাব নেই"

msgid "extra-files must be \"ask\", \"keep\" or \"delete\" (got '%s')"
msgstr "extra-files-কে \"ask\", \"keep\" বা \"delete\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "feature %s is gone: installations that had it lose what it held"
msgstr "বৈশিষ্ট্য {1} আর নেই: যেসব ইনস্টলেশনে এটি ছিল সেগুলি এর বিষয়বস্তু হারায়"

msgid "feature '%s' is its own ancestor"
msgstr "বৈশিষ্ট্য '{1}' নিজেরই পূর্বপুরুষ"

msgid "feature '%s' is not defined"
msgstr "বৈশিষ্ট্য '{1}' সংজ্ঞায়িত নয়"

msgid "feature parent '%s' is not defined"
msgstr "বৈশিষ্ট্যের প্যারেন্ট '{1}' সংজ্ঞায়িত নয়"

msgid "file '%s' already runs service '%s'"
msgstr "ফাইল '{1}' ইতিমধ্যে পরিষেবা '{2}' চালায়"

msgid "file '%s' is already registered as a font"
msgstr "ফাইল '{1}' ইতিমধ্যে ফন্ট হিসেবে নিবন্ধিত"

msgid "file '%s' is not a [file.*] of this package"
msgstr "ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "file '%s' must be installed in the Fonts folder itself (a [dir.*] with path = \"Fonts\")"
msgstr "ফাইল '{1}' খোদ Fonts ফোল্ডারে ইনস্টল হতে হবে (path = \"Fonts\" সহ একটি [dir.*])"

msgid "file '%s' needs a feature: set 'feature' here or on its dir"
msgstr "ফাইল '{1}'-এর জন্য একটি বৈশিষ্ট্য দরকার: 'feature' এখানে বা এর dir-এ সেট করুন"

msgid "file must be \"file:<ID>\""
msgstr "file-কে \"file:<ID>\" হতে হবে"

msgid "file name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "ফাইলের নাম {1}টি UTF-16 একক; 8.3 সংক্ষিপ্ত নামসহ MSI সর্বোচ্চ {2}টি ধরে"

msgid "file-system-virtualization and registry-virtualization = false need Windows build 18362 or later: set [msix] min-version = \"10.0.18362.0\""
msgstr "file-system-virtualization এবং registry-virtualization = false-এর জন্য Windows বিল্ড 18362 বা পরবর্তী দরকার: [msix] min-version = \"10.0.18362.0\" সেট করুন"

msgid "file: '%s' is not a [file.*] of this package"
msgstr "file: '{1}' এই প্যাকেজের [file.*] নয়"

msgid "file: '%s' serves COM classes only as an .exe or a .dll"
msgstr "file: '{1}' COM ক্লাস শুধু .exe বা .dll হিসেবে পরিবেশন করে"

msgid "files but no Media row"
msgstr "ফাইল আছে কিন্তু কোনো Media সারি নেই"

msgid "fix the value the message names; IDs are letters, digits and '_' and differ across all tables"
msgstr "বার্তায় উল্লিখিত মান ঠিক করুন; ID হলো অক্ষর, সংখ্যা ও '_' এবং সব টেবিলে আলাদা"

msgid "floating-point numbers are not supported"
msgstr "ফ্লোটিং-পয়েন্ট সংখ্যা সমর্থিত নয়"

msgid "folder '%s' needs a feature: set 'feature' here or on its dir"
msgstr "ফোল্ডার '{1}'-এর জন্য একটি বৈশিষ্ট্য দরকার: 'feature' এখানে বা এর dir-এ সেট করুন"

msgid "folder name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "ফোল্ডারের নাম {1}টি UTF-16 একক; 8.3 সংক্ষিপ্ত নামসহ MSI সর্বোচ্চ {2}টি ধরে"

msgid "follow-parent needs a parent"
msgstr "follow-parent-এর জন্য একটি প্যারেন্ট দরকার"

msgid "fonts need scope = \"machine\" (this is %s)"
msgstr "ফন্টের জন্য scope = \"machine\" দরকার (এটি {1})"

msgid "format %lld needs a newer rubrapack (this one reads format %d)"
msgstr "বিন্যাস {1}-এর জন্য নতুন rubrapack দরকার (এটি বিন্যাস {2} পড়ে)"

msgid "format is a whole number: format = %d"
msgstr "format একটি পূর্ণসংখ্যা: format = {1}"

msgid "give --pass-env or --pass-file, not both"
msgstr "--pass-env বা --pass-file দিন, দুটোই নয়"

msgid "give --pin-env or --pin-file, not both"
msgstr "--pin-env বা --pin-file দিন, দুটোই নয়"

msgid "give [msix] and [msix-app.*] what they need, or keep the item for the MSI with msi-only = true"
msgstr "[msix] এবং [msix-app.*]-কে প্রয়োজনীয় জিনিস দিন, অথবা msi-only = true দিয়ে আইটেমটি MSI-এর জন্য রাখুন"

msgid "give a file below this folder"
msgstr "এই ফোল্ডারের নিচে একটি ফাইল দিন"

msgid "give a file directly in the program folder, or - for none"
msgstr "সরাসরি প্রোগ্রাম ফোল্ডারে একটি ফাইল দিন, অথবা কোনোটি না হলে -"

msgid "give a folder below this one, such as dist"
msgstr "এর নিচে একটি ফোল্ডার দিন, যেমন dist"

msgid "give a name of 1 to 128 bytes"
msgstr "1 থেকে 128 বাইটের একটি নাম দিন"

msgid "give all three logos (logo-150, logo-44, store-logo) or none"
msgstr "তিনটি লোগোই (logo-150, logo-44, store-logo) দিন বা কোনোটিই না"

msgid "give one of --key, --pkcs11 and --key-store"
msgstr "--key, --pkcs11 এবং --key-store-এর একটি দিন"

msgid "give sub folders of the program folder, separated by commas, or - for none"
msgstr "প্রোগ্রাম ফোল্ডারের সাব-ফোল্ডার কমা দিয়ে আলাদা করে দিন, অথবা কোনোটি না হলে -"

msgid "glob '%s' matches no file"
msgstr "প্যাটার্ন '{1}' কোনো ফাইলের সাথে মেলে না"

msgid "glob '%s' matches the output file '%s'"
msgstr "প্যাটার্ন '{1}' আউটপুট ফাইল '{2}'-এর সাথে মেলে"

msgid "has a MergeModule.CABinet stream that cannot be read"
msgstr "একটি MergeModule.CABinet স্ট্রিম আছে যা পড়া যায় না"

msgid "has a MergeModule.CABinet that cannot be read"
msgstr "একটি MergeModule.CABinet আছে যা পড়া যায় না"

msgid "has a Module*Sequence table without the standard columns"
msgstr "মানক কলাম ছাড়া একটি Module*Sequence টেবিল আছে"

msgid "has a ModuleConfiguration item without a name or with an unknown format"
msgstr "নাম ছাড়া বা অজানা বিন্যাসের একটি ModuleConfiguration আইটেম আছে"

msgid "has a ModuleConfiguration table without the standard columns"
msgstr "মানক কলাম ছাড়া একটি ModuleConfiguration টেবিল আছে"

msgid "has a ModuleSubstitution table without the standard columns"
msgstr "মানক কলাম ছাড়া একটি ModuleSubstitution টেবিল আছে"

msgid "has a ModuleSubstitution template naming an item that ModuleConfiguration does not have"
msgstr "এমন একটি ModuleSubstitution টেমপ্লেট আছে যা ModuleConfiguration-এ নেই এমন আইটেমের নাম দেয়"

msgid "has a component with a condition; an MSIX installs everything"
msgstr "শর্তসহ একটি উপাদান আছে; একটি MSIX সবকিছু ইনস্টল করে"

msgid "has a file whose component or cabinet entry is missing"
msgstr "এমন একটি ফাইল আছে যার উপাদান বা cabinet এন্ট্রি নেই"

msgid "has a folder outside its TARGETDIR that an MSIX has no place for"
msgstr "TARGETDIR-এর বাইরে এমন একটি ফোল্ডার আছে যার MSIX-এ জায়গা নেই"

msgid "has a table that cannot be read"
msgstr "এমন একটি টেবিল আছে যা পড়া যায় না"

msgid "has a table whose columns differ from the package's"
msgstr "এমন একটি টেবিল আছে যার কলাম প্যাকেজের থেকে আলাদা"

msgid "has actions for a sequence table the package does not have"
msgstr "প্যাকেজে নেই এমন ক্রম টেবিলের জন্য ক্রিয়া আছে"

msgid "has components, but the package has no FeatureComponents table"
msgstr "উপাদান আছে, কিন্তু প্যাকেজে FeatureComponents টেবিল নেই"

msgid "has files but no MergeModule.CABinet or Directory table"
msgstr "ফাইল আছে কিন্তু MergeModule.CABinet বা Directory টেবিল নেই"

msgid "has files but no MergeModule.CABinet stream"
msgstr "ফাইল আছে কিন্তু MergeModule.CABinet স্ট্রিম নেই"

msgid "has files, but the package has no Media table"
msgstr "ফাইল আছে, কিন্তু প্যাকেজে Media টেবিল নেই"

msgid "has no ModuleSignature: not a merge module"
msgstr "ModuleSignature নেই: মার্জ মডিউল নয়"

msgid "has no ProductCode or ProductVersion"
msgstr "ProductCode বা ProductVersion নেই"

msgid "has no Property table"
msgstr "Property টেবিল নেই"

msgid "has no identity (Name, Publisher and Version)"
msgstr "এর পরিচয় নেই (Name, Publisher ও Version)"

msgid "has no summary information"
msgstr "এতে সারাংশ তথ্য নেই"

msgid "has records for a table neither the base nor the transform defines"
msgstr "এমন একটি টেবিলের রেকর্ড আছে যা বেস বা ট্রান্সফর্ম কেউ সংজ্ঞায়িত করে না"

msgid "has text outside ASCII in another code page than 65001 (UTF-8)"
msgstr "65001 (UTF-8) ছাড়া অন্য কোড পেজে ASCII-এর বাইরের লেখা আছে"

msgid "icon must be an .ico file"
msgstr "icon-কে একটি .ico ফাইল হতে হবে"

msgid "icon: file '%s' is not a [file.*] of this package"
msgstr "icon: ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "id must be a GUID like {12345678-1234-1234-1234-123456789ABC}: the module's own, kept in every version"
msgstr "id-কে {{12345678-1234-1234-1234-123456789ABC} এর মতো GUID হতে হবে: মডিউলের নিজস্ব, প্রতিটি সংস্করণে রাখা হয়"

msgid "identifier is winget's Publisher.Package: 2 to 8 parts of 1 to 32 characters, no spaces or \\ / : * ? \" < > | (got '%s')"
msgstr "identifier হলো winget-এর Publisher.Package: ১ থেকে ৩২ অক্ষরের ২ থেকে ৮টি অংশ, ফাঁকা ও \\ / : * ? \" < > | ছাড়া ('{1}' পাওয়া গেছে)"

msgid "identity-name must be 3 to 50 characters of A-Z, a-z, 0-9, '.' and '-' (got '%s')"
msgstr "identity-name-কে A-Z, a-z, 0-9, '.' এবং '-' এর 3 থেকে 50টি অক্ষর হতে হবে ('{1}' পাওয়া গেছে)"

msgid "image must be a .bmp file (Windows Installer shows BMP only)"
msgstr "image অবশ্যই একটি .bmp ফাইল হতে হবে (Windows Installer শুধু BMP দেখায়)"

msgid "inline tables are not supported; use a [kind.ID] table"
msgstr "ইনলাইন টেবিল সমর্থিত নয়; একটি [kind.ID] টেবিল ব্যবহার করুন"

msgid "installed asks Windows what is installed; it runs on Windows only"
msgstr "installed Windows-কে জিজ্ঞেস করে কী ইনস্টল করা আছে; এটি কেবল Windows-এ চলে"

msgid "installs to the same path as line %u (Windows ignores case in names%s)"
msgstr "লাইন {1}-এর একই পথে ইনস্টল হয় (Windows নামে বড়-ছোট হাতের অক্ষর উপেক্ষা করে{2})"

msgid "instances is for a per-machine package (scope = \"machine\")"
msgstr "instances প্রতি কম্পিউটার প্যাকেজের জন্য (scope = \"machine\")"

msgid "instances is not yet combined with [menu.*] (the menu's identity package is one per build)"
msgstr "instances এখনও [menu.*] এর সাথে একত্রিত করা যায় না (মেনুর পরিচয় প্যাকেজ প্রতি বিল্ডে একটি)"

msgid "internal error: a built-in dialog has a broken tab order; please report it"
msgstr "অভ্যন্তরীণ ত্রুটি: একটি অন্তর্নির্মিত ডায়ালগের ট্যাব ক্রম ভাঙা; জানান"

msgid "internal: a module table has no _Validation rule"
msgstr "অভ্যন্তরীণ: একটি মডিউল টেবিলের _Validation নিয়ম নেই"

msgid "internal: no _Validation rule for a column of %s"
msgstr "অভ্যন্তরীণ: {1}-এর একটি কলামের জন্য _Validation নিয়ম নেই"

msgid "invalid"
msgstr "অবৈধ"

msgid "invalid - %s"
msgstr "অবৈধ - {1}"

msgid "is '.' or '..'"
msgstr "'.' বা '..'"

msgid "is a reserved device name"
msgstr "একটি সংরক্ষিত ডিভাইস নাম"

msgid "is empty"
msgstr "খালি"

msgid "is longer than 255 UTF-16 units"
msgstr "255টি UTF-16 এককের চেয়ে দীর্ঘ"

msgid "is not a Windows Installer database"
msgstr "Windows Installer ডেটাবেস নয়"

msgid "is not a compound file"
msgstr "কম্পাউন্ড ফাইল নয়"

msgid "is not a patch: it has no patch code, target products or transforms"
msgstr "প্যাচ নয়: এতে প্যাচ কোড, লক্ষ্য পণ্য বা রূপান্তর নেই"

msgid "is not a valid MSIX package"
msgstr "বৈধ MSIX প্যাকেজ নয়"

msgid "is not valid UTF-8"
msgstr "বৈধ UTF-8 নয়"

msgid "isolate-for: '%s' is not a program (.exe)"
msgstr "isolate-for: '{1}' প্রোগ্রাম (.exe) নয়"

msgid "keep the upgrade code, raise the version, keep component codes of files that stay"
msgstr "আপগ্রেড কোড রাখুন, সংস্করণ বাড়ান, থেকে যাওয়া ফাইলের উপাদান কোড রাখুন"

msgid "key '%.*s' is set twice in this table (first at line %u)"
msgstr "কী '{1}' এই টেবিলে দুবার সেট করা হয়েছে (প্রথমবার লাইন {2}-এ)"

msgid "key '%s' must not start or end with '\\' or contain an empty part"
msgstr "কী '{1}' '\\' দিয়ে শুরু বা শেষ হতে পারবে না বা খালি অংশ থাকতে পারবে না"

msgid "key '%s' outside a table; only 'format' comes before the first table"
msgstr "কী '{1}' টেবিলের বাইরে; প্রথম টেবিলের আগে শুধু 'format' আসে"

msgid "key file '%s': %s"
msgstr "কী ফাইল '{1}': {2}"

msgid "kind must be \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" or \"autoplay\" (got '%s')"
msgstr "kind-কে \"alias\", \"startup-task\", \"firewall\", \"com-server\", \"toast\", \"context-menu\", \"app-extension\", \"app-extension-host\", \"app-service\", \"share-target\" বা \"autoplay\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "kind must be \"preview\", \"thumbnail\" or \"property\" (got '%s')"
msgstr "kind-কে \"preview\", \"thumbnail\" বা \"property\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "kind must be registry, file, dir or component"
msgstr "kind-কে registry, file, dir বা component হতে হবে"

msgid "labels is an array of strings, one per value"
msgstr "labels হলো স্ট্রিংয়ের একটি অ্যারে, প্রতিটি মানের জন্য একটি"

msgid "language '%s' has no language pack (lang/%s.po beside the source, or RUBRAPACK_LANG_DIR)"
msgstr "ভাষা '{1}'-এর কোনো ভাষা প্যাক নেই (উৎসের পাশে lang/{2}.po, বা RUBRAPACK_LANG_DIR)"

msgid "language '%s' is listed twice"
msgstr "ভাষা '{1}' দুবার তালিকাভুক্ত"

msgid "language '%s' is not in [ui] languages"
msgstr "ভাষা '{1}' [ui] languages-এ নেই"

msgid "language '%s' lacks %zu text(s), the first is %s: add them to its language pack (lang/%s.po) or give [ui-text.ID] text-%s"
msgstr "ভাষা '{1}'-এ {2}টি লেখা নেই, প্রথমটি {3}: এগুলি এর ভাষা প্যাকে যোগ করুন (lang/{4}.po) বা [ui-text.ID] text-{5} দিন"

msgid "language '%s' needs [ui] langid-%s (its LANGIDs, for the automatic choice)"
msgstr "ভাষা '{1}'-এর জন্য [ui] langid-{2} দরকার (স্বয়ংক্রিয় নির্বাচনের জন্য এর LANGID)"

msgid "language '%s' needs [ui] name-%s (its name on the language page)"
msgstr "ভাষা '{1}'-এর জন্য [ui] name-{2} দরকার (ভাষা পৃষ্ঠায় এর নাম)"

msgid "language = \"ko-KR\" no longer makes the dialogs Korean: they are English unless [ui] languages = [\"ko\"] adds Korean"
msgstr "language = \"ko-KR\" আর ডায়ালগ কোরীয় করে না: [ui] languages = [\"ko\"] কোরীয় যোগ না করলে সেগুলি ইংরেজি"

msgid "language must be \"ko-KR\" or \"en-US\""
msgstr "language-কে \"ko-KR\" বা \"en-US\" হতে হবে"

msgid "language must be \"neutral\", \"en-US\" or \"ko-KR\""
msgstr "language-কে \"neutral\", \"en-US\" বা \"ko-KR\" হতে হবে"

msgid "languages = \"all\" stands alone, not in an array: it takes every built-in language"
msgstr "languages = \"all\" একা লেখা হয়, কোনো অ্যারের ভেতরে নয়: এটি সব অন্তর্নির্মিত ভাষা নেয়"

msgid "languages holds codes like \"ko\" or \"zh_TW\" (2 or 3 lower-case letters, and _ and a region's two capitals) (got '%s')"
msgstr "languages-এ \"ko\" বা \"zh_TW\"-এর মতো কোড থাকে (2 বা 3টি ছোট হাতের অক্ষর, এবং _ ও অঞ্চলের দুটি বড় হাতের অক্ষর) ('{1}' পাওয়া গেছে)"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "languages হলো ভাষা কোডের একটি অ্যারে, যেমন [\"ko\"]"

msgid "languages needs a dialog set (ui = \"basic\" or another)"
msgstr "languages-এর জন্য একটি ডায়ালগ সেট দরকার (ui = \"basic\" বা অন্য)"

msgid "launch must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "launch-কে এই প্যাকেজের একটি [file.*] নির্দেশকারী \"file:<ID>\" হতে হবে"

msgid "launch-args needs launch"
msgstr "launch-args-এর জন্য launch দরকার"

msgid "launcher is the file name of the PSF launcher in files, like \"PsfLauncher64.exe\""
msgstr "launcher হলো files-এর PSF লঞ্চারের ফাইলের নাম, যেমন \"PsfLauncher64.exe\""

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "license-কে .txt, .md (সাধারণ লেখা হিসেবে দেখানো হয়) বা .rtf ফাইল হতে হবে"

msgid "lint: %s row %s: column %s is not in NFC (%zu row%s); build --nfc puts folder, file and shortcut names in NFC"
msgstr "lint: {1} সারি {2}: কলাম {3} NFC-তে নেই ({4}টি সারি{-5}); build --nfc ফোল্ডার, ফাইল ও শর্টকাটের নাম NFC-তে আনে"

msgid "lint: %s%s"
msgstr "lint: {1}{2}"

msgid "lint: code page %u, not 65001: text is not checked as UTF-8, widths only for ASCII"
msgstr "lint: কোড পেজ {1}, 65001 নয়: লেখা UTF-8 হিসেবে যাচাই হয় না, প্রস্থ শুধু ASCII-এর জন্য"

msgid "lint: no problems\n"
msgstr "lint: কোনো সমস্যা নেই\n"

msgid "lint: see the problems above\n"
msgstr "lint: উপরের সমস্যাগুলি দেখুন\n"

msgid "list the keys a token or the Windows certificate store can sign with"
msgstr "একটি টোকেন বা Windows সার্টিফিকেট স্টোর যে কী দিয়ে স্বাক্ষর করতে পারে তার তালিকা"

msgid "logo '%s' and its .scale-100 variant are both there: keep one"
msgstr "লোগো '{1}' এবং এর .scale-100 রূপ দুটোই আছে: একটি রাখুন"

msgid "logo '%s' at scale %s is %ux%u pixels; it must be %ux%u"
msgstr "স্কেল {2}-এ লোগো '{1}' {3}x{4} পিক্সেল; এটি {5}x{6} হতে হবে"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "স্কেল {2}-এ লোগো '{1}' PNG ফাইল নয়"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "লোগো '{1}' {2}x{3} পিক্সেল; এটি {4}x{5} হতে হবে"

msgid "logo '%s' is not a PNG file"
msgstr "লোগো '{1}' PNG ফাইল নয়"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "লোগো '{1}' পাওয়া যায়নি (.scale-100 ... .scale-400 রূপ হিসেবেও না)"

msgid "logo '%s': a logo with scale variants needs an ASCII file name with an extension"
msgstr "লোগো '{1}': স্কেল রূপসহ লোগোর জন্য এক্সটেনশনসহ ASCII ফাইলের নাম দরকার"

msgid "logo must be a .png of 8-bit RGB or RGBA, not interlaced, at most 1024 pixels a side"
msgstr "logo অবশ্যই 8-বিট RGB বা RGBA .png হতে হবে, ইন্টারলেসড নয়, প্রতি বাহুতে সর্বোচ্চ 1024 পিক্সেল"

msgid "main-package is the main package's identity name (got '%s')"
msgstr "main-package হলো প্রধান প্যাকেজের পরিচয় নাম ('{1}' পাওয়া গেছে)"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "main-publisher এবং modification = true main-package-এর সাথে যায় (যে প্যাকেজের এটি অংশ)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "main-publisher হলো প্রধান প্যাকেজের প্রকাশক, যেমন \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "নিয়ন্ত্রণ অক্ষর বা / \\ : * ? \" < > | $ থাকতে পারে না"

msgid "may not start with a space or end with a space or a dot"
msgstr "স্পেস দিয়ে শুরু বা স্পেস বা বিন্দু দিয়ে শেষ হতে পারে না"

msgid "merge module '%s' not found"
msgstr "মার্জ মডিউল '{1}' পাওয়া যায়নি"

msgid "min-version must be a version like 1.2.3"
msgstr "min-version-কে 1.2.3-এর মতো সংস্করণ হতে হবে"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "min-version-এর চারটি অংশ থাকতে হবে, যেমন 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "min-version-এর চারটি অংশ থাকতে হবে, যেমন 14.0.24217.0"

msgid "mismatch"
msgstr "অমিল"

msgid "mode = \"remove\" removes the key; it takes no 'value'"
msgstr "mode = \"remove\" কী সরায়; এটি 'value' নেয় না"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "mode-কে \"set\", \"add\" বা \"remove\" হতে হবে"

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "mode-কে \"set\", \"append\" বা \"prepend\" হতে হবে"

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "অনুমোদিত বা ডিরেক্টরিতে থাকা সংখ্যার চেয়ে বেশি ZIP এন্ট্রি"

msgid "more keys and values than allowed"
msgstr "অনুমোদিতের চেয়ে বেশি কী ও মান"

msgid "more than 3 redirects"
msgstr "3টির বেশি পুনর্নির্দেশ"

msgid "more than 96 sections"
msgstr "96টির বেশি সেকশন"

msgid "more than one source file ('%s')"
msgstr "একাধিক উৎস ফাইল ('{1}')"

msgid "more than one token is present: name one with --token-label"
msgstr "একাধিক টোকেন আছে: --token-label দিয়ে একটির নাম দিন"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "multi-কে \"each\", \"one\" বা \"single\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "multi-line strings are not supported"
msgstr "বহু-লাইনের স্ট্রিং সমর্থিত নয়"

msgid "multi-line strings are not supported; use one line with \\n"
msgstr "বহু-লাইনের স্ট্রিং সমর্থিত নয়; \\n-সহ একটি লাইন ব্যবহার করুন"

msgid "must be 1 to 64 bytes"
msgstr "1 থেকে 64 বাইট হতে হবে"

msgid "name contains a control character"
msgstr "নামে একটি নিয়ন্ত্রণ অক্ষর আছে"

msgid "name is a package's identity name (got '%s')"
msgstr "name হলো একটি প্যাকেজের পরিচয় নাম ('{1}' পাওয়া গেছে)"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "নাম ASCII নয় এবং summary-name নেই; সারাংশের Subject হবে 'rubrapack package'"

msgid "names a folder its Directory table does not have"
msgstr "এমন একটি ফোল্ডারের নাম দেয় যা এর Directory টেবিলে নেই"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "new msix এখনো বাস্তবায়িত নয়: একটি MSI উৎস তৈরি করে [msix] যোগ করুন (ম্যানুয়াল দেখুন)"

msgid "no 'format = %d' line: a source in the format of rubrapack 0.18 or earlier, which this version does not read (paths start with $(ProgramFiles) or $(INSTALLDIR) now); see the manual's Source format"
msgstr "'format = {1}' লাইন নেই: rubrapack 0.18 বা পুরনো বিন্যাসের উৎস, যা এই সংস্করণ পড়ে না (এখন পথ $(ProgramFiles) বা $(INSTALLDIR) দিয়ে শুরু হয়); ম্যানুয়ালের উৎস বিন্যাস দেখুন"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "--trust দেওয়া হয়নি: স্বাক্ষর যাচাই হয় কিন্তু কাকে বিশ্বাস করতে হবে তা কিছুই বলে না"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "কী ফাইলে (বা --cert ফাইলে) কোনো সার্টিফিকেট কী-এর নয়"

msgid "no control characters"
msgstr "নিয়ন্ত্রণ অক্ষর ছাড়া"

msgid "no keys\n"
msgstr "কোনো কী নেই\n"

msgid "no main program, so no shortcuts: none"
msgstr "প্রধান প্রোগ্রাম নেই, তাই শর্টকাটও নেই: কোনোটি না"

msgid "no server name, or one longer than 255 bytes"
msgstr "সার্ভারের নাম নেই, বা 255 বাইটের চেয়ে দীর্ঘ"

msgid "no string pool: not a transform"
msgstr "স্ট্রিং পুল নেই: ট্রান্সফর্ম নয়"

msgid "no table '%s' in '%s'"
msgstr "'{2}'-এ '{1}' টেবিল নেই"

msgid "no-remove leaves Modify (its Remove) as the only way to remove the product: it cannot go with no-modify"
msgstr "no-remove পরিবর্তন (এর সরান)-কে পণ্য সরানোর একমাত্র উপায় হিসেবে রাখে: এটি no-modify-এর সাথে যেতে পারে না"

msgid "not a PE file (no MZ header)"
msgstr "PE ফাইল নয় (MZ হেডার নেই)"

msgid "not a PE file (no PE header)"
msgstr "PE ফাইল নয় (PE হেডার নেই)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "PEM, PKCS#8 বা PKCS#12 ফাইল নয়"

msgid "not a ZIP archive (no end record)"
msgstr "ZIP আর্কাইভ নয় (শেষ রেকর্ড নেই)"

msgid "not a ZIP archive (too short)"
msgstr "ZIP আর্কাইভ নয় (খুব ছোট)"

msgid "not a cabinet (no MSCF header)"
msgstr "cabinet নয় (MSCF হেডার নেই)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "rubrapack গ্রহণ করে এমন প্রক্সি URL নয় (http://host:port)"

msgid "not a registry hive"
msgstr "রেজিস্ট্রি হাইভ নয়"

msgid "not a valid number"
msgstr "বৈধ সংখ্যা নয়"

msgid "not a value"
msgstr "মান নয়"

msgid "not a value (strings need quotes)"
msgstr "মান নয় (স্ট্রিংয়ের জন্য উদ্ধৃতিচিহ্ন লাগে)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "rubrapack গ্রহণ করে এমন http:// বা https:// URL নয়"

msgid "not valid UTF-8"
msgstr "বৈধ UTF-8 নয়"

msgid "not-checked (give --trust or --system-roots)"
msgstr "যাচাই করা হয়নি (--trust বা --system-roots দিন)"

msgid "not-present"
msgstr "অনুপস্থিত"

msgid "nothing changed\n"
msgstr "কিছুই পরিবর্তন হয়নি\n"

msgid "number out of range"
msgstr "সংখ্যা পরিসরের বাইরে"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "অক্টাল ও বাইনারি সংখ্যা সমর্থিত নয়; দশমিক বা 0x ব্যবহার করুন"

msgid "on = \"uninstall\" is for HKLM, HKCU and HKMU (classes go with [assoc.*], [com.*] and the like)"
msgstr "on = \"uninstall\" HKLM, HKCU এবং HKMU-এর জন্য (ক্লাস [assoc.*], [com.*] ইত্যাদির সাথে যায়)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "on = \"uninstall\" একটি কী তার নিচের সবকিছুসহ সরায়: '{1}' Software-এর অধীনে কোনো পণ্যের নিজস্ব কী নয়"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" অপসারণের সময় পুরো কী সরায়; এটি '{1}' নেয় না"

msgid "on Windows `keys list` shows the certificate store"
msgstr "Windows-এ `keys list` সার্টিফিকেট স্টোর দেখায়"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "Windows-এ টোকেন সার্টিফিকেট স্টোরের মাধ্যমে ব্যবহৃত হয় (--key-store <থাম্বপ্রিন্ট>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "on হলো remove = true-এর জন্য (কখন কী সরানো হয়)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "on-কে \"install\" বা \"uninstall\" হতে হবে"

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "on-কে \"install\", \"uninstall\" বা \"both\" হতে হবে"

msgid "on: each is a file type ('.' and lower-case letters, digits, '_' or '-'), \"*\" (every file), \"folder\", \"background\" (the empty part of a folder), \"drive\" or \"assoc:<ID>\" (got '%s')"
msgstr "on: প্রতিটি একটি ফাইল টাইপ ('.' এবং ছোট হাতের অক্ষর, সংখ্যা, '_' বা '-'), \"*\" (প্রতিটি ফাইল), \"folder\", \"background\" (ফোল্ডারের খালি অংশ), \"drive\" বা \"assoc:<ID>\" ('{1}' পাওয়া গেছে)"

msgid "only a bitmap control takes an image"
msgstr "শুধু একটি bitmap নিয়ন্ত্রণ image নেয়"

msgid "only radio, combo and listbox controls take labels"
msgstr "শুধু radio, combo ও listbox নিয়ন্ত্রণ labels নেয়"

msgid "only radio, combo and listbox controls take values"
msgstr "শুধু radio, combo ও listbox নিয়ন্ত্রণ values নেয়"

msgid "out of memory"
msgstr "মেমরি ফুরিয়ে গেছে"

msgid "output '%s': rubrapack writes .msi, .msm, .msix, .msixbundle, .msixupload and a chain's setup .exe"
msgstr "আউটপুট '{1}': rubrapack .msi, .msm, .msix, .msixbundle, .msixupload এবং একটি চেইনের সেটআপ .exe লেখে"

msgid "package '%s' %s"
msgstr "প্যাকেজ '{1}' {2}"

msgid "package '%s' not found"
msgstr "প্যাকেজ '{1}' পাওয়া যায়নি"

msgid "parent must be another product's upgrade-code, not this package's own"
msgstr "parent-কে অন্য পণ্যের upgrade-code হতে হবে, এই প্যাকেজের নিজেরটি নয়"

msgid "parent must be the main product's upgrade-code, a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "parent-কে প্রধান পণ্যের upgrade-code হতে হবে, {{12345678-1234-1234-1234-123456789ABC} এর মতো GUID"

msgid "path must be \"$(Base)/relative/path\" with '/' (Base is a folder such as ProgramFiles, or a dir ID)"
msgstr "path-কে '/' সহ \"$(Base)/আপেক্ষিক/পথ\" হতে হবে (Base হলো ProgramFiles-এর মতো ফোল্ডার, বা একটি dir ID)"

msgid "path must start with a Windows folder (like $(ProgramFiles) or $(System))"
msgstr "path-কে একটি Windows ফোল্ডার দিয়ে শুরু হতে হবে (যেমন $(ProgramFiles) বা $(System))"

msgid "paths"
msgstr "পথ"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "perceived-type-কে \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" বা \"application\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "অনুমতির জন্য scope = \"machine\" দরকার (এটি {1})"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "phase \"immediate\", \"deferred\", \"commit\" বা \"rollback\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "ports-কে একটি পোর্ট বা 1-65535-এর মধ্যে \"8000-8100\"-এর মতো পরিসর হতে হবে ('{1}' পাওয়া গেছে)"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "একটি র‍্যান্ডম GUID, বা rubrapack কোনো লেখা থেকে যেটি বের করে, তা প্রিন্ট করুন"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "উৎসগুলির JSON Schema প্রিন্ট করুন (এমন এডিটরের জন্য যা কী সম্পূর্ণ ও যাচাই করে)"

msgid "print the version"
msgstr "সংস্করণ প্রিন্ট করুন"

msgid "print this help, or one command's usage"
msgstr "এই সহায়তা, বা একটি কমান্ডের ব্যবহার প্রিন্ট করুন"

msgid "product-code must be a GUID"
msgstr "product-code-কে একটি GUID হতে হবে"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile-কে \"all\", \"domain\", \"private\" বা \"public\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id '{1}' ইতিমধ্যে [com.{2}]-এর"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id '{1}' [assoc.{2}]-এরও: একটি ফাইল টাইপ ও একটি COM ক্লাসের দুটি নাম দরকার"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "prog-id '{1}' [assoc.{2}]-এ অন্য বিবরণ, target, icon বা args-সহও আছে"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "prog-id-কে অক্ষর, সংখ্যা, '.', '_' বা '-' হতে হবে, সংখ্যা দিয়ে শুরু নয়, সর্বোচ্চ 39 ('{1}' পাওয়া গেছে)"

msgid "properties are for Windows Installer packages; an MSIX takes none"
msgstr "properties Windows Installer প্যাকেজের জন্য; MSIX এটি নেয় না"

msgid "property '%s' already belongs to control '%s'"
msgstr "বৈশিষ্ট্য '{1}' ইতিমধ্যে কন্ট্রোল '{2}'-এর"

msgid "property '%s' has the name of a dir or feature"
msgstr "বৈশিষ্ট্য '{1}'-এর নাম একটি dir বা ফিচারের নাম"

msgid "property '%s' is already defined (line %u)"
msgstr "বৈশিষ্ট্য '{1}' ইতিমধ্যে সংজ্ঞায়িত (লাইন {2})"

msgid "property '%s' is already searched (line %u)"
msgstr "বৈশিষ্ট্য '{1}' ইতিমধ্যে অনুসন্ধান করা হচ্ছে (লাইন {2})"

msgid "property '%s' is set by rubrapack or the installer and cannot be defined here"
msgstr "বৈশিষ্ট্য '{1}' rubrapack বা ইনস্টলার সেট করে এবং এখানে সংজ্ঞায়িত করা যায় না"

msgid "property '%s' must be a public name of your own (upper case)"
msgstr "বৈশিষ্ট্য '{1}'-কে আপনার নিজস্ব একটি পাবলিক নাম হতে হবে (বড় হাতের)"

msgid "property '%s' must be a public name: upper-case letters, digits and '_'"
msgstr "বৈশিষ্ট্য '{1}'-কে পাবলিক নাম হতে হবে: বড় হাতের অক্ষর, সংখ্যা এবং '_'"

msgid "protocol must be \"tcp\" or \"udp\" (got '%s')"
msgstr "protocol-কে \"tcp\" বা \"udp\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "public-folder must be a folder of the package, like \"Public\" (got '%s')"
msgstr "public-folder-কে প্যাকেজের একটি ফোল্ডার হতে হবে, যেমন \"Public\" ('{1}' পাওয়া গেছে)"

msgid "publisher is the package's publisher, such as \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""
msgstr "publisher হলো প্যাকেজের প্রকাশক, যেমন \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""

msgid "publisher must be the signing certificate's subject, such as \"CN=Example, O=Example, C=KR\""
msgstr "publisher-কে স্বাক্ষর সার্টিফিকেটের subject হতে হবে, যেমন \"CN=Example, O=Example, C=KR\""

msgid "publisher must not carry the unsigned-test OID; --unsigned-test adds it"
msgstr "publisher-এ unsigned-test OID থাকা চলবে না; এটি --unsigned-test যোগ করে"

msgid "quoted keys are not supported"
msgstr "উদ্ধৃতিচিহ্নযুক্ত কী সমর্থিত নয়"

msgid "quoted table names are not supported"
msgstr "উদ্ধৃতিচিহ্নযুক্ত টেবিলের নাম সমর্থিত নয়"

msgid "reboot must be \"suppress\" or \"allow\""
msgstr "reboot-কে \"suppress\" বা \"allow\" হতে হবে"

msgid "recursive = true is for on = \"uninstall\""
msgstr "recursive = true হলো on = \"uninstall\"-এর জন্য"

msgid "recursive = true never runs when an upgrade removes this version; it takes no 'upgrade'"
msgstr "আপগ্রেড যখন এই সংস্করণ সরায় তখন recursive = true কখনো চলে না; এটি 'upgrade' নেয় না"

msgid "recursive = true removes the folder with everything in it; it takes no 'name'"
msgstr "recursive = true ফোল্ডারটি এর সবকিছুসহ সরায়; এটি 'name' নেয় না"

msgid "refuse-upgrade-below %s is above this package's version %s"
msgstr "refuse-upgrade-below {1} এই প্যাকেজের সংস্করণ {2}-এর উপরে"

msgid "refuse-upgrade-below '%s' must be a version like 1.2.3"
msgstr "refuse-upgrade-below '{1}'-কে 1.2.3-এর মতো সংস্করণ হতে হবে"

msgid "refuse-upgrade-message needs refuse-upgrade-below"
msgstr "refuse-upgrade-message-এর জন্য refuse-upgrade-below দরকার"

msgid "region %d of the language page holds %zu languages, at most %d (X-Rubrapack-Group of their packs)"
msgstr "ভাষা পৃষ্ঠার অঞ্চল {1}-এ {2}টি ভাষা আছে, সর্বোচ্চ {3} (প্যাকগুলোর X-Rubrapack-Group)"

msgid "registration must be \"machine\" or \"user\" (got '%s')"
msgstr "registration \"machine\" বা \"user\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "registry '%s' removes a value; it has nothing to protect"
msgstr "রেজিস্ট্রি '{1}' একটি মান সরায়; এর রক্ষা করার কিছু নেই"

msgid "registry value '%s' needs a feature"
msgstr "রেজিস্ট্রি মান '{1}'-এর জন্য একটি বৈশিষ্ট্য দরকার"

msgid "remove = true removes the value at install; it takes no 'value'"
msgstr "remove = true ইনস্টলের সময় মান সরায়; এটি 'value' নেয় না"

msgid "remove-addons needs the cleanup task: remove cleanup = false"
msgstr "remove-addons-এর জন্য পরিষ্কারের কাজ দরকার: cleanup = false সরান"

msgid "replaces holds at most 16 upgrade codes"
msgstr "replaces সর্বোচ্চ 16টি আপগ্রেড কোড ধরে"

msgid "replaces holds upgrade codes, GUIDs like {12345678-1234-1234-1234-123456789ABC} (got '%s')"
msgstr "replaces আপগ্রেড কোড ধরে, {{12345678-1234-1234-1234-123456789ABC} এর মতো GUID ('{1}' পাওয়া গেছে)"

msgid "replaces is an array of upgrade codes, like [\"{12345678-1234-1234-1234-123456789ABC}\"]"
msgstr "replaces হলো আপগ্রেড কোডের একটি অ্যারে, যেমন [\"{{12345678-1234-1234-1234-123456789ABC}\"]"

msgid "replaces lists %s twice"
msgstr "replaces {1} দুবার তালিকাভুক্ত করে"

msgid "replaces names %s, which is this package's own upgrade-code or its parent"
msgstr "replaces {1}-এর নাম দেয়, যা এই প্যাকেজের নিজস্ব বা এর প্যারেন্টের upgrade-code"

msgid "required property %s is missing"
msgstr "প্রয়োজনীয় বৈশিষ্ট্য {1} নেই"

msgid "rollback twin must come before %.*s (%ld <= %ld)"
msgstr "রোলব্যাক যমজকে {1}-এর আগে আসতে হবে ({2} <= {3})"

msgid "root must be HKLM, HKCR or HKCU"
msgstr "root-কে HKLM, HKCR বা HKCU হতে হবে"

msgid "root must be HKLM, HKCU, HKCR or HKMU (got '%s')"
msgstr "root-কে HKLM, HKCU, HKCR বা HKMU হতে হবে ('{1}' পাওয়া গেছে)"

msgid "rubrapack explain <RPnnnn>: what a diagnostic code means. The codes by range:\n"
msgstr "rubrapack explain <RPnnnn>: একটি ডায়াগনস্টিক কোডের অর্থ। পরিসর অনুযায়ী কোড:\n"

msgid "rubrapack new: a few questions make the source (Enter takes the value in [ ]).\n"
msgstr "rubrapack new: কয়েকটি প্রশ্ন উৎস তৈরি করে (Enter [ ]-এর ভিতরের মান নেয়)।\n"

msgid "run `rubrapack help <command>`; check the paths and that the output folder exists"
msgstr "`rubrapack help <command>` চালান; পথ এবং আউটপুট ফোল্ডার আছে কি না যাচাই করুন"

msgid "run: '%s' (machine 0x%04X) cannot run on this package's machines"
msgstr "run: '{1}' (মেশিন 0x{2}) এই প্যাকেজের মেশিনে চলতে পারে না"

msgid "run: '%s' is not a program (.exe)"
msgstr "run: '{1}' কোনো প্রোগ্রাম নয় (.exe)"

msgid "run: file '%s' is not a [file.*] of this package"
msgstr "run: ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "save the source as UTF-8 (or UTF-16 with a BOM), with LF or CRLF line ends"
msgstr "উৎসটি LF বা CRLF লাইন শেষসহ UTF-8 (বা BOM-সহ UTF-16) হিসেবে সংরক্ষণ করুন"

msgid "say whether this Windows has a product of that upgrade code or an app package of that family installed"
msgstr "এই Windows-এ সেই আপগ্রেড কোডের পণ্য বা সেই ফ্যামিলির অ্যাপ প্যাকেজ ইনস্টল করা আছে কি না বলে"

msgid "scheme '%s' already has a program ([protocol.%s])"
msgstr "স্কিম '{1}'-এর ইতিমধ্যে একটি প্রোগ্রাম আছে ([protocol.{2}])"

msgid "scope must be \"machine\", \"user\" or \"dual\""
msgstr "scope-কে \"machine\", \"user\" বা \"dual\" হতে হবে"

msgid "sddl must be an SDDL string like \"D:PAI(A;OICI;FA;;;BA)\""
msgstr "sddl-কে \"D:PAI(A;OICI;FA;;;BA)\"-এর মতো SDDL স্ট্রিং হতে হবে"

msgid "search property '%s' must be a public name of your own (upper case)"
msgstr "অনুসন্ধান বৈশিষ্ট্য '{1}'-কে আপনার নিজস্ব একটি পাবলিক নাম হতে হবে (বড় হাতের)"

msgid "see the message; rebuilding with rubrapack fixes most of these"
msgstr "বার্তা দেখুন; rubrapack দিয়ে আবার তৈরি করলে এগুলির বেশিরভাগ ঠিক হয়"

msgid "sequence %ld is not after %s (%ld)"
msgstr "ক্রম {1} {2}-এর পরে নয় ({3})"

msgid "sequences an action next to one that neither the package nor the module runs"
msgstr "একটি ক্রিয়াকে এমন একটির পাশে রাখে যা প্যাকেজ বা মডিউল কেউই চালায় না"

msgid "service name '%s' is already used"
msgstr "পরিষেবার নাম '{1}' ইতিমধ্যে ব্যবহৃত"

msgid "services need scope = \"machine\" (this is %s)"
msgstr "পরিষেবার জন্য scope = \"machine\" দরকার (এটি {1})"

msgid "shortcut name is %zu UTF-16 units; with its 8.3 short name MSI holds at most %zu"
msgstr "শর্টকাটের নাম {1}টি UTF-16 একক; 8.3 সংক্ষিপ্ত নামসহ MSI সর্বোচ্চ {2}টি ধরে"

msgid "show what differs between two packages: tables, rows, cells and summary"
msgstr "দুটি প্যাকেজের মধ্যে কী আলাদা দেখায়: টেবিল, সারি, ঘর ও সারাংশ"

msgid "sign a PE file, an MSI package, an MSIX package or bundle"
msgstr "একটি PE ফাইল, MSI প্যাকেজ, MSIX প্যাকেজ বা বান্ডলে স্বাক্ষর করুন"

msgid "signed %s\n"
msgstr "স্বাক্ষরিত: {1}\n"

msgid "source '%s' is a directory; use [files.ID] for many files"
msgstr "উৎস '{1}' একটি ডিরেক্টরি; অনেক ফাইলের জন্য [files.ID] ব্যবহার করুন"

msgid "source '%s' is a symbolic link; links are not followed"
msgstr "উৎস '{1}' একটি সিম্বলিক লিঙ্ক; লিঙ্ক অনুসরণ করা হয় না"

msgid "source '%s' is not a regular file"
msgstr "উৎস '{1}' সাধারণ ফাইল নয়"

msgid "source file '%s' changed while the package was being built"
msgstr "প্যাকেজ তৈরির সময় উৎস ফাইল '{1}' পরিবর্তিত হয়েছে"

msgid "source file '%s' is larger than 2 GiB"
msgstr "উৎস ফাইল '{1}' 2 GiB-এর চেয়ে বড়"

msgid "source file '%s' not found"
msgstr "উৎস ফাইল '{1}' পাওয়া যায়নি"

msgid "source must be \"file:<ID>\""
msgstr "source-কে \"file:<ID>\" হতে হবে"

msgid "source must be an .msi, .msix, .msixbundle or .msp package"
msgstr "source-কে একটি .msi, .msix, .msixbundle বা .msp প্যাকেজ হতে হবে"

msgid "source path '%s' must be relative to the source file"
msgstr "উৎস পথ '{1}'-কে উৎস ফাইলের সাপেক্ষে হতে হবে"

msgid "source paths use '/', not '\\\\' (got '%s')"
msgstr "উৎস পথে '/' ব্যবহার হয়, '\\\\' নয় ('{1}' পাওয়া গেছে)"

msgid "source-format"
msgstr "source-format"

msgid "source: file '%s' is not a [file.*] of this package"
msgstr "source: ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "start must be auto, demand or disabled"
msgstr "start-কে auto, demand বা disabled হতে হবে"

msgid "string is not closed on this line"
msgstr "স্ট্রিং এই লাইনে বন্ধ হয়নি"

msgid "string lengths exceed the string data"
msgstr "স্ট্রিংয়ের দৈর্ঘ্য স্ট্রিং ডেটা ছাড়িয়ে যায়"

msgid "summary information cannot be shown as IDT yet"
msgstr "সারাংশ তথ্য এখনো IDT হিসেবে দেখানো যায় না"

msgid "summary-name must be ASCII (summary information holds ASCII only)"
msgstr "summary-name-কে ASCII হতে হবে (সারাংশ তথ্যে শুধু ASCII থাকে)"

msgid "symbols is a list of .pdb files, like [\"build/$(ARCH)/app.pdb\"]"
msgstr "symbols হলো .pdb ফাইলের তালিকা, যেমন [\"build/$(ARCH)/app.pdb\"]"

msgid "table %s %s"
msgstr "টেবিল {1} {2}"

msgid "table '%s' is unreadable"
msgstr "টেবিল '{1}' অপাঠ্য"

msgid "table [%s%s%s] is defined twice (first at line %u)"
msgstr "টেবিল [{1}{2}{3}] দুবার সংজ্ঞায়িত (প্রথমবার লাইন {4}-এ)"

msgid "table name expected"
msgstr "টেবিলের নাম প্রত্যাশিত ছিল"

msgid "table names have at most two parts: [kind] or [kind.ID]"
msgstr "টেবিলের নামে সর্বোচ্চ দুটি অংশ থাকে: [kind] বা [kind.ID]"

msgid "tables"
msgstr "টেবিল"

msgid "tables and keys: an unknown table or key, a required one missing, an item without a feature once features exist"
msgstr "টেবিল ও কী: অজানা টেবিল বা কী, অনুপস্থিত প্রয়োজনীয় কী, বৈশিষ্ট্য থাকলে বৈশিষ্ট্যবিহীন আইটেম"

msgid "tags is a list of at most 16 search terms, like [\"editor\", \"text\"]"
msgstr "tags হলো সর্বাধিক ১৬টি অনুসন্ধান শব্দের তালিকা, যেমন [\"editor\", \"text\"]"

msgid "takes no configuration (it has no ModuleConfiguration)"
msgstr "কোনো কনফিগারেশন নেয় না (ModuleConfiguration নেই)"

msgid "target '%s' does not exist"
msgstr "লক্ষ্য '{1}' নেই"

msgid "target must be \"dir:<ID>\", \"file:<ID>\" or \"registry:<ID>\""
msgstr "target-কে \"dir:<ID>\", \"file:<ID>\" বা \"registry:<ID>\" হতে হবে"

msgid "target must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "target-কে এই প্যাকেজের একটি [file.*] নির্দেশকারী \"file:<ID>\" হতে হবে"

msgid "target name '%s' %s"
msgstr "লক্ষ্যের নাম '{1}' {2}"

msgid "target: file '%s' is not a [file.*] of this package"
msgstr "target: ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "task-id '%s' is already used by [msix-extension.%s]"
msgstr "task-id '{1}' ইতিমধ্যে [msix-extension.{2}] ব্যবহার করে"

msgid "task-id, display-name and enabled belong to kind = \"startup-task\""
msgstr "task-id, display-name এবং enabled kind = \"startup-task\"-এর অন্তর্গত"

msgid "that file exists already; give another name"
msgstr "সেই ফাইল আগে থেকেই আছে; অন্য নাম দিন"

msgid "that folder holds no files"
msgstr "সেই ফোল্ডারে কোনো ফাইল নেই"

msgid "the FilesInUse dialog needs a ListBox table, even an empty one (error 2205; the dialog is skipped)"
msgstr "FilesInUse ডায়ালগের জন্য একটি ListBox টেবিল দরকার, খালি হলেও (ত্রুটি 2205; ডায়ালগ এড়িয়ে যাওয়া হয়)"

msgid "the PIN has characters or a length the token does not take"
msgstr "PIN-এ এমন অক্ষর বা দৈর্ঘ্য আছে যা টোকেন নেয় না"

msgid "the PIN has expired: change it on the token first"
msgstr "PIN-এর মেয়াদ শেষ: আগে টোকেনে এটি পরিবর্তন করুন"

msgid "the PIN is locked (too many wrong tries)"
msgstr "PIN লক হয়ে গেছে (অনেক ভুল চেষ্টা)"

msgid "the ProductCode is the previous version's: that is a minor upgrade (REINSTALLMODE), not the major upgrade rubrapack builds"
msgstr "ProductCode আগের সংস্করণের: এটি ছোট আপগ্রেড (REINSTALLMODE), rubrapack যে বড় আপগ্রেড তৈরি করে তা নয়"

msgid "the UTF-16 file is not valid UTF-16"
msgstr "UTF-16 ফাইল বৈধ UTF-16 নয়"

msgid "the ZIP central directory lies outside the file"
msgstr "ZIP কেন্দ্রীয় ডিরেক্টরি ফাইলের বাইরে"

msgid "the application ID '%s' becomes Application Id: letters and digits only, not starting with a digit"
msgstr "অ্যাপ ID '{1}' Application Id হয়ে যায়: শুধু অক্ষর ও সংখ্যা, সংখ্যা দিয়ে শুরু নয়"

msgid "the archive does not end in ZIP64 end records as MSIX packages do"
msgstr "আর্কাইভ MSIX প্যাকেজের মতো ZIP64 শেষ রেকর্ড দিয়ে শেষ হয় না"

msgid "the archive has no ZIP64 end record"
msgstr "আর্কাইভে ZIP64 শেষ রেকর্ড নেই"

msgid "the bundle manifest has no Identity Name, Publisher and Version"
msgstr "বান্ডল ম্যানিফেস্টে Identity Name, Publisher এবং Version নেই"

msgid "the cabinet has no room for a signature"
msgstr "cabinet-এ স্বাক্ষরের জায়গা নেই"

msgid "the cabinet has reserved space in its folders or data blocks, which rubrapack does not lay out"
msgstr "cabinet-এর ফোল্ডার বা ডেটা ব্লকে সংরক্ষিত জায়গা আছে, যা rubrapack সামলায় না"

msgid "the cabinet's signature uses a hash rubrapack does not check (only SHA-256)"
msgstr "cabinet-এর স্বাক্ষর এমন হ্যাশ ব্যবহার করে যা rubrapack যাচাই করে না (কেবল SHA-256)"

msgid "the central directory lies outside the archive"
msgstr "কেন্দ্রীয় ডিরেক্টরি আর্কাইভের বাইরে"

msgid "the certificate has a critical extension rubrapack does not understand"
msgstr "সার্টিফিকেটে এমন গুরুত্বপূর্ণ এক্সটেনশন আছে যা rubrapack বোঝে না"

msgid "the certificate has expired"
msgstr "সার্টিফিকেটের মেয়াদ শেষ"

msgid "the certificate is a CA certificate, not a signing certificate"
msgstr "সার্টিফিকেটটি CA সার্টিফিকেট, স্বাক্ষর সার্টিফিকেট নয়"

msgid "the certificate is not for code signing (no code-signing extended key usage)"
msgstr "সার্টিফিকেট কোড স্বাক্ষরের জন্য নয় (কোড স্বাক্ষরের বর্ধিত কী ব্যবহার নেই)"

msgid "the certificate is not valid yet"
msgstr "সার্টিফিকেট এখনো বৈধ নয়"

msgid "the certificate path is longer than 8"
msgstr "সার্টিফিকেট পথ 8-এর চেয়ে দীর্ঘ"

msgid "the certificate table does not hold an Authenticode signature"
msgstr "সার্টিফিকেট টেবিলে Authenticode স্বাক্ষর নেই"

msgid "the certificate table is not at the end of the file"
msgstr "সার্টিফিকেট টেবিল ফাইলের শেষে নেই"

msgid "the certificate's key usage does not allow digital signatures"
msgstr "সার্টিফিকেটের কী ব্যবহার ডিজিটাল স্বাক্ষর অনুমোদন করে না"

msgid "the certificate's subject cannot be written as an MSIX publisher"
