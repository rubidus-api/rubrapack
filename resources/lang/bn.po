msgid "trusted"
msgstr "বিশ্বস্ত"

msgid "two actions share sequence %d (%.*s and %.*s); give an [action] a different sequence, before or after"
msgstr "দুটি ক্রিয়া একই sequence {1} ভাগ করে ({2} ও {3}); কোনো একটি [action]-কে অন্য sequence, before বা after দিন"

msgid "two packages of one architecture in a bundle"
msgstr "বান্ডলে একই আর্কিটেকচারের দুটি প্যাকেজ"

msgid "two packages of one name in a bundle"
msgstr "বান্ডলে একই নামের দুটি প্যাকেজ"

msgid "two resource packages of one ResourceId in a bundle"
msgstr "বান্ডলে একই ResourceId-এর দুটি রিসোর্স প্যাকেজ"

msgid "type must be string, expand, dword, qword, binary or multi (got '%s')"
msgstr "type-কে string, expand, dword, qword, binary বা multi হতে হবে (পাওয়া গেছে '{1}')"

msgid "type must be text, checkbox, edit, radio, combo, listbox or bitmap (got '%s')"
msgstr "type অবশ্যই text, checkbox, edit, radio, combo, listbox বা bitmap হতে হবে ('{1}' পাওয়া গেছে)"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' এই প্যাকেজের [file.*] নয়"

msgid "typelib-version is major.minor in hex digits, like \"1.0\" (got '%s')"
msgstr "typelib-version হেক্স অঙ্কে major.minor, যেমন \"1.0\" (পাওয়া গেছে '{1}')"

msgid "types and verb belong to kind = \"context-menu\""
msgstr "types এবং verb kind = \"context-menu\"-এর অন্তর্গত"

msgid "types: each is \".ext\" or \"*\" (every file)"
msgstr "types: প্রতিটি \".ext\" বা \"*\" (প্রতিটি ফাইল)"

msgid "types: each is '.' and lower-case letters, digits, '_' or '-' (got '%s')"
msgstr "types: প্রতিটি '.' এবং ছোট হাতের অক্ষর, অঙ্ক, '_' বা '-' (পাওয়া গেছে '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" ব্যবহারকারীকে dir '{2}'-এর ফোল্ডার বেছে নিতে দেয়, যা নেই ([ui] install-dir সেট করুন)"

msgid "ui = \"features\" needs [feature.*] tables to choose from"
msgstr "ui = \"features\"-এর বেছে নেওয়ার জন্য [feature.*] টেবিল দরকার"

msgid "ui must be none, basic, minimal, installdir or features (got '%s')"
msgstr "ui-কে none, basic, minimal, installdir বা features হতে হবে (পাওয়া গেছে '{1}')"

msgid "unexpected text after the value"
msgstr "মানের পরে অপ্রত্যাশিত পাঠ্য"

msgid "unknown command '%s' (see 'rubrapack help')"
msgstr "অজানা কমান্ড '{1}' (দেখুন 'rubrapack help')"

msgid "unknown escape \\%c (use '...' for text with backslashes)"
msgstr "অজানা এস্কেপ \\{1} (ব্যাকস্ল্যাশযুক্ত পাঠ্যের জন্য '...' ব্যবহার করুন)"

msgid "unknown inspect option (use a table name, --summary, --files or --streams)"
msgstr "অজানা inspect বিকল্প (টেবিলের নাম, --summary, --files বা --streams ব্যবহার করুন)"

msgid "unknown key '%s' in [%s%s%s]"
msgstr "[{2}{3}{4}]-এ অজানা কী '{1}'"

msgid "unknown key '%s' in [%s%s%s] (did you mean '%s'?)"
msgstr "[{2}{3}{4}] (আপনি কি '{5}' বোঝাতে চেয়েছেন?)-এ অজানা কী '{1}'"

msgid "unknown or incomplete %s option '%s'"
msgstr "অজানা বা অসম্পূর্ণ {1} বিকল্প '{2}'"

msgid "unknown table [%s%s%s]"
msgstr "অজানা টেবিল [{1}{2}{3}]"

msgid "unknown table [%s%s%s] (did you mean [%s]?)"
msgstr "অজানা টেবিল [{1}{2}{3}] (আপনি কি [{4}] বোঝাতে চেয়েছেন?)"

msgid "unpack a package into a new directory, laid out as it installs"
msgstr "একটি প্যাকেজ নতুন ডিরেক্টরিতে খুলুন, ইনস্টলের মতো করে সাজানো"

msgid "unsupported - %s"
msgstr "সমর্থিত নয় - {1}"

msgid "untrusted"
msgstr "অবিশ্বস্ত"

msgid "update-* keys need appinstaller-uri and package-uri"
msgstr "update-* কী-এর জন্য appinstaller-uri এবং package-uri দরকার"

msgid "upgrade = false is for on = \"uninstall\" or \"both\" (an installation is never an upgrade's removal)"
msgstr "upgrade = false হলো on = \"uninstall\" বা \"both\"-এর জন্য (ইনস্টল কখনো আপগ্রেডের অপসারণ নয়)"

msgid "upgrade-code must be a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "upgrade-code-কে {{12345678-1234-1234-1234-123456789ABC}-এর মতো GUID হতে হবে"

msgid "usage: rubrapack %s"
msgstr "ব্যবহার: rubrapack {1}"

msgid "usage: rubrapack %s\n\n%s%s\n"
msgstr "ব্যবহার: rubrapack {1}\n\n{2}{3}\n"

msgid "usage: rubrapack inspect <file.cab> (no table or option)"
msgstr "ব্যবহার: rubrapack inspect <file.cab> (কোনো টেবিল বা বিকল্প ছাড়া)"

msgid "usage: rubrapack inspect <file.msi> [table|--summary] --json"
msgstr "ব্যবহার: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "ব্যবহার: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "ব্যবহার: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

msgid "usage: rubrapack inspect <setup.exe> (no table or option)"
msgstr "ব্যবহার: rubrapack inspect <setup.exe> (কোনো টেবিল বা বিকল্প ছাড়া)"

msgid "usage: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"
msgstr "ব্যবহার: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "ব্যবহার: rubrapack lint <file.msix|file.msixbundle> [--strict]"

msgid "use '/' in path"
msgstr "পথে '/' ব্যবহার করুন"

msgid "use a full rubrapack build or another way"
msgstr "সম্পূর্ণ rubrapack বিল্ড বা অন্য উপায় ব্যবহার করুন"

msgid "used by more than one component"
msgstr "একাধিক উপাদান ব্যবহার করে"

msgid "users must be \"all\" (got '%s')"
msgstr "users-কে \"all\" হতে হবে ('{1}' পাওয়া গেছে)"

msgid "value '%s' is listed twice"
msgstr "মান '{1}' দুবার তালিকাভুক্ত"

msgid "value missing"
msgstr "মান অনুপস্থিত"

msgid "values and labels are strings"
msgstr "values এবং labels স্ট্রিং"

msgid "values is an array of 1 to 32 strings"
msgstr "values হলো 1 থেকে 32টি স্ট্রিংয়ের অ্যারে"

msgid "values: IDs, GUIDs, versions, numbers out of range, references to things that do not exist"
msgstr "মান: ID, GUID, সংস্করণ, সীমার বাইরের সংখ্যা, অস্তিত্বহীন জিনিসের উল্লেখ"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "চলক '{1}' সংজ্ঞায়িত নয় ([define] বা -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "চলকের নাম '{1}'-এ '=' থাকতে পারে না বা = + - ! * দিয়ে শুরু হতে পারে না"

msgid "variables"
msgstr "চলক"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "চলক: মানহীন $(NAME), বন্ধ না করা $(, এমন জায়গায় Windows নাম বা dir ID যেখানে তা বসতে পারে না"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "সংস্করণ '{1}'-কে a.b.c বা a.b.c.d হতে হবে"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "সংস্করণ '{1}'-কে a.b.c বা a.b.c.d হতে হবে যেখানে a, b <= 255 এবং c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" 64-বিট প্যাকেজের ফাইলের 'with' হতে পারে না"

msgid "view must be \"32\" or \"64\""
msgstr "view-কে \"32\" বা \"64\" হতে হবে"

msgid "warning"
msgstr "সতর্কতা"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "একটি ডায়াগনস্টিক কোডের অর্থ, যে বার্তাগুলো এটি বহন করে, কী করতে হবে এবং ম্যানুয়াল কোথায় আরও বলে"

msgid "with must be \"file:<ID>\""
msgstr "with-কে \"file:<ID>\" হতে হবে"

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: ফাইল '{1}' এই প্যাকেজের [file.*] নয়"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "--pkcs11 ছাড়া `keys list` Windows সার্টিফিকেট স্টোর দেখায়"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' কোনো dir ID নয়"

msgid "write a Windows Sandbox configuration that installs the package in a fresh, disposable Windows"
msgstr "একটি Windows Sandbox কনফিগারেশন লেখে যা প্যাকেজটি নতুন, ফেলে দেওয়া যায় এমন Windows-এ ইনস্টল করে"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "একটি প্যাচ (.msp) লিখুন: যে ফাইল ও সারি একটি ইনস্টল করা ভিত্তিকে লক্ষ্যে হালনাগাদ করে"

msgid "write a shared package container's definition: MSIX packages that run in one container"
msgstr "একটি শেয়ার করা প্যাকেজ কন্টেইনারের সংজ্ঞা লেখে: একটি কন্টেইনারে চলা MSIX প্যাকেজ"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
msgstr "একটি সোর্স ফাইল লিখুন (.toml; .rpk নামও): উত্তর থেকে তৈরি, জিজ্ঞাসা করা বা বিকল্প হিসেবে দেওয়া, একটি নির্দিষ্ট শুরু, বা একটি বিদ্যমান MSI"

msgid "write a transform (.mst): what turns one package into the other"
msgstr "একটি ট্রান্সফর্ম (.mst) লিখুন: যা একটি প্যাকেজকে অন্যটিতে বদলায়"

msgid "write the table or value the plain way the manual shows"
msgstr "টেবিল বা মান ম্যানুয়ালে দেখানো সরল উপায়ে লিখুন"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "মানটি '[~]' ছাড়া লিখুন; mode = \"append\" বা \"prepend\" এটি যোগ করে"

msgid "wrote %s\n"
msgstr "লেখা হয়েছে {1}\n"

msgid "x + width must be at most 370 (the page width)"
msgstr "x + width সর্বোচ্চ 370 হতে হবে (পৃষ্ঠার প্রস্থ)"

msgid "y + height must be at most 234 (the line above the buttons)"
msgstr "y + height সর্বোচ্চ 234 হতে হবে (বোতামের উপরের রেখা)"

