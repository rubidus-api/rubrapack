msgid "the request could not be sent"
msgstr "অনুরোধ পাঠানো যায়নি"

msgid "the response has a malformed or conflicting Content-Length"
msgstr "প্রতিক্রিয়ায় ত্রুটিপূর্ণ বা পরস্পরবিরোধী Content-Length আছে"

msgid "the response has both Content-Length and chunked (refused: a smuggling risk)"
msgstr "প্রতিক্রিয়ায় Content-Length এবং chunked দুটোই আছে (প্রত্যাখ্যাত: স্মাগলিং ঝুঁকি)"

msgid "the response is larger than 4 MiB"
msgstr "প্রতিক্রিয়া 4 MiB-এর চেয়ে বড়"

msgid "the response uses a transfer coding other than chunked"
msgstr "প্রতিক্রিয়া chunked ছাড়া অন্য ট্রান্সফার কোডিং ব্যবহার করে"

msgid "the same condition is already required (line %u)"
msgstr "একই শর্ত ইতিমধ্যে প্রয়োজনীয় (লাইন {1})"

msgid "the same without questions:\n  rubrapack new "
msgstr "একই, প্রশ্ন ছাড়া:\n  rubrapack new "

msgid "the server did not answer with HTTP/1.x"
msgstr "সার্ভার HTTP/1.x দিয়ে উত্তর দেয়নি"

msgid "the server redirected from https to http (refused)"
