msgstr "'{1}': '{2}' y '{3}' serían la misma ruta en Windows; no se extrajo nada"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' no está en [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': no se puede leer una tabla"

msgid "'%s': a table is unreadable"
msgstr "'{1}': una tabla es ilegible"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': un MSIX instala todos sus archivos (when); use msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': un MSIX quita todos sus archivos (keep); use msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': el archivo cabinet '{2}' está dañado o no es stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': el nombre de cabinet '{2}' no es un nombre de archivo simple"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': el archivo comprimido '{2}' (secuencia {3}) no tiene cabinet"

