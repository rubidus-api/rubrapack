msgstr "'{1}': el flujo de cabinet '{2}' no existe"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': el manifiesto no tiene {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': el manifiesto nombra '{2}', que no está en el paquete"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': marca de tiempo de {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': la transformación '{2}' no se puede leer frente a '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' es el idioma propio del paquete ({2}); dé ese texto sin el sufijo"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' hace que Windows Installer escriba una cadena múltiple; use type = \"multi\" y una matriz"

msgid "'_' in numbers is not supported"
msgstr "'_' en los números no está admitido"

msgid "'help' takes at most one command name"
msgstr "'help' admite como máximo un nombre de comando"

msgid "'version' takes no arguments"
msgstr "'version' no admite argumentos"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs es para .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch para un lote: una lista de x64, x86 y arm64, cada uno una vez (se recibió '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch admite una arquitectura, o una lista para una salida .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp y --allow-unsigned-cabs van con --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress es para .msi; un MSIX admite --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist nombra una carpeta nueva junto al origen (sin ruta)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs admite un número de 1 a 64 (se recibió '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store es un almacén de certificados de Windows; en otros sistemas use un archivo de clave o --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store admite la huella digital SHA-1 del certificado (40 dígitos hexadecimales)"

