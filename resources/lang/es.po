msgstr "'{1}' no tiene la transformación incrustada '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' no tiene información de resumen legible"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' no tiene la transformación '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' es UTF-16: edit solo cambia orígenes UTF-8 (guárdelo primero como UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' es un nombre de Windows; dé otro nombre a la variable"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' es un [chain]: compila un programa de instalación, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' es un control del marco integrado; elija otro ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' es una carpeta del equipo; un paquete {2} no puede escribir allí"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' es un módulo de combinación: combínelo con [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' es un nombre que el formato MSIX reserva para sí"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' es un vínculo simbólico; los vínculos no se siguen"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' también es un [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' también es un ID de dir; dé otro nombre a la variable"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' está compilado para la máquina 0x{2}, no para el arch de este paquete; establezca any-arch = true si es intencionado"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' no es un archivo PE (.exe, .dll), ni un paquete MSI, ni un paquete o lote MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' no es un archivo PE, ni un paquete MSI, ni un paquete o lote MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' no es una carpeta conocida ni un ID de dir (carpetas conocidas: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' no es un archivo cabinet que rubrapack pueda leer (stored o MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' no es un código de diagnóstico (RP y cuatro dígitos, como RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' no es un programa (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' no es un archivo normal"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' no es un programa de instalación de rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' no es un ID válido (letras, dígitos y '_', sin empezar por un dígito, como máximo {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' no es una base de datos MSI válida: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' no es un paquete MSIX válido: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' no es un paquete válido: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' no es un origen válido (el subconjunto de TOML); corríjalo primero a mano"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' no es una transformación válida: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' no es un nombre de variable válido"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' está reservado y no se puede usar como ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' es el nombre de un dir: solo una búsqueda en el registro o de dir puede rellenar un dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' parece un archivo de programa (PE), pero sus encabezados o recursos están dañados"

msgid "'%s' must be a string"
msgstr "'{1}' debe ser una cadena"

msgid "'%s' must be an integer"
msgstr "'{1}' debe ser un entero"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' debe estar entre {2} y {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' debe ser true o false"

msgid "'%s' must not be empty"
msgstr "'{1}' no puede estar vacío"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' no nombra transformaciones (propiedad de resumen 8): no es una revisión"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' empieza por una carpeta: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' tiene {4}; no se extrajo nada"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entradas, más que el límite {3} (--limit-entries); no se extrajo nada"

