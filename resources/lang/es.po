msgstr "'{1}': el archivo '{2}' no coincide con su MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': el archivo '{2}' no tiene componente o directorio"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': el archivo '{2}' tiene {3} bytes y la tabla File dice {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': el archivo '{2}' no está en el cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': sus cabinets externos no están cubiertos por la firma (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': su carpeta no lleva a una ubicación conocida"

