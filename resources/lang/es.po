# rubrapack language pack: Spanish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: es\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Español\n"
"X-Rubrapack-LangIDs: 1034, 3082, 2058, 11274, 9226, 13322, 10250, 22538\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 6\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, diálogos {6}{7}\n  1 nombre, fabricante, versión, arquitectura    2 carpeta de instalación, para quién\n  3 diálogos, licencia, idiomas                  4 partes opcionales\n  5 accesos directos                             6 archivos: igualar la carpeta del programa\n  7 cualquier clave                              v ver   l lint   s guardar   q salir\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMensajes con este código (* representa un nombre o un valor):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nLos resultados van a stdout y los diagnósticos a stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nQué hacer: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} ya no existe, pero un acceso directo lo abre: cambie primero los accesos directos (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  allí hay {1} archivos y {2} carpetas\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s o q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  se añadieron [dir.{1}] y [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  se añadió [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  indíquelo como tabla.clave, por ejemplo package.version o dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: sin problemas\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: vea los problemas anteriores (el archivo indicado allí es una copia de comprobación)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  los demás idiomas de [ui] languages se conservan; cambie esa lista con 7 (cualquier clave)\n"

msgid "  removed [file.%s]\n"
msgstr "  se quitó [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  se quitó [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subcarpetas:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  eso no cabe en el subconjunto de TOML; no se cambió nada\n"

msgid "  that was not readable text; again, please\n"
msgstr "  eso no era texto legible; otra vez, por favor\n"

msgid "  the program folder '%s': %s\n"
msgstr "  la carpeta del programa '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  el origen no tiene tablas [file] a las que pueda apuntar un acceso directo\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  el origen no tiene subcarpetas como las escribe `new` ([files] \"<folder>/<name>/**\"); añádalas con 6\n"

msgid "  too long; again, please\n"
msgstr "  demasiado largo; otra vez, por favor\n"

msgid "  y or n\n"
msgstr "  y o n\n"

msgid " (changed)"
msgstr " (cambiado)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - crea paquetes de Windows Installer (.msi) y MSIX (.msix)\n\nuso: rubrapack [--lang <code>] <command> [arguments]\n\ncomandos:\n"

msgid " and its dir"
msgstr " y su dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) no tiene variable de entorno, así que un valor expandible no puede contenerlo; use un valor de cadena (se rellena al instalar)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) es un {2}: puede iniciar una ruta o sustituir un valor que rellena Windows Installer (registro, entorno, INI, argumentos, mensajes), pero no aquí"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) no es una carpeta desde la que pueda empezar una ruta (un ID de dir, o ProgramFiles, LOCALAPPDATA, ProgramData ... - vea Paths en el manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  estructura:   {2}\n  resumen:      {3}\n  firma:        {4}\n  cadena:       {5}{6}{7}\n  revocación:   no comprobada\n  marca de tiempo: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: la variable no está definida"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' no es un control de este diálogo"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' no está en {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': el texto de la licencia necesita el nombre en inglés de la fuente, así que se muestra con la fuente propia del idioma; escriba el nombre en inglés (como \"Malgun Gothic\") para usar también allí esta fuente"

msgid "%s component, but the package platform is %.*s"
msgstr "componente {1}, pero la plataforma del paquete es {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} no corresponde a kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} no corresponde a kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} contiene LANGID (1..65535), como 1041"

msgid "%s holds strings"
msgstr "{1} contiene cadenas"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} es una lista de textos \"Clave=Valor\""

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} es un nombre de fuente de 1 a 31 caracteres, como \"Segoe UI\" (tiene {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} es una condición MSI con las comillas cerradas y los paréntesis equilibrados"

msgid "%s is an array of strings, one per value"
msgstr "{1} es una matriz de cadenas, una por valor"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} es para paquetes MSI: un MSIX no lo quita msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} ya no existe. ¿Quitar [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} supera los 240 caracteres"

msgid "%s is new. Add it?"
msgstr "{1} es nuevo. ¿Añadirlo?"

msgid "%s is not a GUID in registry format"
msgstr "{1} no es un GUID en formato de registro"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} no es un código que use este rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} debe ser \"file:<ID>\" y nombrar un [file.*] de este paquete"

msgid "%s must be a GUID"
msgstr "{1} debe ser un GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} debe ser un GUID como {12345678-...} (se recibió '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} debe ser una dirección https://, http:// o file://, o una ruta \\\\server\\share (se recibió '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} debe ser distinto de upgrade-code (una familia de actualización por arquitectura)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} necesita la compilación {2} de Windows o posterior: establezca [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} necesita resources/bin/rubrapack_ca-{2}.dll, y este rubrapack se compiló sin él"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA no comprobada (indique --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA de confianza"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA no de confianza - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} ya no existe o está vacío. ¿Quitar [files.{3}] y [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ es una carpeta nueva. ¿Añadirla?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} error(es){-3}, {4} advertencia(s){-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} error(es){-3}, {4} advertencia(s){-5} (frente a {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} archivos, {3} bytes\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} archivos, {3} errores, 0 advertencias\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} diagnósticos más no mostrados\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' no es una acción estándar que rubrapack coloque"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: el archivo '{2}' no es un [file.*] de este paquete"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: el archivo '{2}' no es un programa (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' no está cerrado (escriba '$$(' para el texto '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' ya existe; se deja como está"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' ya existe; quítelo o compile en otra carpeta"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' ya tiene un controlador {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' ya tiene permisos"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' y '{2}' son la misma ruta en el paquete"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' pertenece a Windows o a los navegadores"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' no se puede leer frente a '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' no cabe en el subconjunto de TOML; no se guardó nada"

msgid "'%s' exists already"
msgstr "'{1}' ya existe"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' ya existe; cámbielo con `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' existe y no es un directorio vacío; extraiga en uno nuevo"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' va en {2}; o msi-only = true"

