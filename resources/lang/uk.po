msgstr "min-version має бути версією на зразок 1.2.3"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "min-version має мати чотири частини, наприклад 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "min-version має мати чотири частини, наприклад 14.0.24217.0"

msgid "mismatch"
msgstr "невідповідність"

