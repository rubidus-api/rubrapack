msgstr "у Windows `keys list` показує сховище сертифікатів"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "у Windows токен використовується через сховище сертифікатів (--key-store <відбиток>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "on - для remove = true (коли ключ видаляється)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "on має бути \"install\" або \"uninstall\""

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "on має бути \"install\", \"uninstall\" або \"both\""

