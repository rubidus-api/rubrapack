msgstr "no-remove залишає \"Змінити\" (його \"Видалити\") єдиним способом видалити продукт: не поєднується з no-modify"

msgid "not a PE file (no MZ header)"
msgstr "не файл PE (немає заголовка MZ)"

msgid "not a PE file (no PE header)"
msgstr "не файл PE (немає заголовка PE)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "не файл PEM, PKCS#8 або PKCS#12"

msgid "not a ZIP archive (no end record)"
msgstr "не архів ZIP (немає кінцевого запису)"

