msgstr "view має бути \"32\" або \"64\""

msgid "warning"
msgstr "попередження"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "що означає код діагностики, повідомлення, які його несуть, що робити і де посібник каже більше"

msgid "with must be \"file:<ID>\""
msgstr "with має бути \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: файл '{1}' не є [file.*] цього пакета"

