msgstr "більше записів ZIP, ніж дозволено або ніж містить каталог"

msgid "more keys and values than allowed"
msgstr "більше ключів і значень, ніж дозволено"

msgid "more than 3 redirects"
msgstr "понад 3 переспрямування"

msgid "more than 96 sections"
msgstr "понад 96 розділів"

msgid "more than one source file ('%s')"
msgstr "більше ніж один файл джерела ('{1}')"

