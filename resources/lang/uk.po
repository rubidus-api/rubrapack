msgstr "perceived-type має бути \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" або \"application\" (отримано '{1}')"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "дозволи потребують scope = \"machine\" (тут {1})"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "phase має бути \"immediate\", \"deferred\", \"commit\" або \"rollback\" (отримано '{1}')"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "ports має бути портом або діапазоном на зразок \"8000-8100\" у межах 1-65535 (отримано '{1}')"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "вивести випадковий GUID або той, що rubrapack виводить із тексту"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "вивести JSON Schema джерел (для редактора, що доповнює й перевіряє ключі)"

msgid "print the version"
msgstr "вивести версію"

msgid "print this help, or one command's usage"
msgstr "вивести цю довідку або використання однієї команди"

msgid "product-code must be a GUID"
msgstr "product-code має бути GUID"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "profile має бути \"all\", \"domain\", \"private\" або \"public\" (отримано '{1}')"

