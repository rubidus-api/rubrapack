msgstr "використання: rubrapack inspect <file.msi> [table|--summary] --json"

msgid "usage: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"
msgstr "використання: rubrapack inspect <file.msi> [table|--summary|--files|--streams] | inspect <file.msix|file.msixbundle> [--files|--manifest] | inspect <file.mst|file.msp> --base <base.msi> | inspect <file.cab>"

msgid "usage: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"
msgstr "використання: rubrapack inspect <file.msix|file.msixbundle> [--files | --manifest]"

msgid "usage: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"
msgstr "використання: rubrapack inspect <file.mst> --base <base.msi> | --summary | --streams"

