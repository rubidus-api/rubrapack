msgstr "publisher не може містити OID unsigned-test; його додає --unsigned-test"

msgid "quoted keys are not supported"
msgstr "ключі в лапках не підтримуються"

msgid "quoted table names are not supported"
msgstr "імена таблиць у лапках не підтримуються"

msgid "reboot must be \"suppress\" or \"allow\""
msgstr "reboot має бути \"suppress\" або \"allow\""

msgid "recursive = true is for on = \"uninstall\""
msgstr "recursive = true - для on = \"uninstall\""

msgid "recursive = true never runs when an upgrade removes this version; it takes no 'upgrade'"
msgstr "recursive = true ніколи не виконується, коли оновлення видаляє цю версію; він не приймає 'upgrade'"

msgid "recursive = true removes the folder with everything in it; it takes no 'name'"
msgstr "recursive = true видаляє папку з усім умістом; він не приймає 'name'"

msgid "refuse-upgrade-below %s is above this package's version %s"
msgstr "refuse-upgrade-below {1} вище за версію {2} цього пакета"

msgid "refuse-upgrade-below '%s' must be a version like 1.2.3"
msgstr "refuse-upgrade-below '{1}' має бути версією на зразок 1.2.3"

msgid "refuse-upgrade-message needs refuse-upgrade-below"
msgstr "refuse-upgrade-message потребує refuse-upgrade-below"

msgid "region %d of the language page holds %zu languages, at most %d (X-Rubrapack-Group of their packs)"
msgstr "у регіоні {1} сторінки мов {2} мов, не більше {3} (X-Rubrapack-Group їхніх пакетів)"

msgid "registration must be \"machine\" or \"user\" (got '%s')"
msgstr "registration має бути \"machine\" або \"user\" (отримано '{1}')"

msgid "registry '%s' removes a value; it has nothing to protect"
msgstr "реєстр '{1}' видаляє значення; йому нічого захищати"

msgid "registry value '%s' needs a feature"
msgstr "значення реєстру '{1}' потребує компонента"

msgid "remove = true removes the value at install; it takes no 'value'"
msgstr "remove = true видаляє значення під час інсталяції; він не приймає 'value'"

msgid "remove-addons needs the cleanup task: remove cleanup = false"
msgstr "remove-addons потребує завдання очищення: видаліть cleanup = false"

msgid "replaces holds at most 16 upgrade codes"
msgstr "replaces містить щонайбільше 16 кодів оновлення"

msgid "replaces holds upgrade codes, GUIDs like {12345678-1234-1234-1234-123456789ABC} (got '%s')"
msgstr "replaces містить коди оновлення, GUID на зразок {12345678-1234-1234-1234-123456789ABC} (отримано '{1}')"

msgid "replaces is an array of upgrade codes, like [\"{12345678-1234-1234-1234-123456789ABC}\"]"
msgstr "replaces - масив кодів оновлення, наприклад [\"{12345678-1234-1234-1234-123456789ABC}\"]"

