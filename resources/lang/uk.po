msgstr "не архів ZIP (закороткий)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "не URL проксі, який приймає rubrapack (http://хост:порт)"

msgid "not a registry hive"
msgstr "не вулик реєстру"

msgid "not a valid number"
msgstr "неправильне число"

msgid "not a value"
msgstr "не значення"

msgid "not a value (strings need quotes)"
msgstr "не значення (рядкам потрібні лапки)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "не URL http:// або https://, який приймає rubrapack"

msgid "not valid UTF-8"
msgstr "неправильний UTF-8"

msgid "not-checked (give --trust or --system-roots)"
msgstr "не перевірено (вкажіть --trust або --system-roots)"

msgid "not-present"
msgstr "відсутнє"

msgid "nothing changed\n"
msgstr "нічого не змінено\n"

msgid "number out of range"
msgstr "число поза діапазоном"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "вісімкові та двійкові числа не підтримуються; використайте десяткові або 0x"

