msgstr "mode = \"remove\" видаляє ключ; він не приймає 'value'"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "mode має бути \"set\", \"add\" або \"remove\""

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "mode має бути \"set\", \"append\" або \"prepend\""

