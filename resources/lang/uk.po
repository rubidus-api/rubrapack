msgstr "type має бути text, checkbox, edit, radio, combo, listbox або bitmap (отримано '{1}')"

msgid "typelib-file: '%s' is not a [file.*] of this package"
msgstr "typelib-file: '{1}' не є [file.*] цього пакета"

