# rubrapack language pack: Ukrainian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: uk\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Українська\n"
"X-Rubrapack-LangIDs: 1058\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, діалогові вікна {6}{7}\n  1 ім'я, виробник, версія, архітектура         2 папка інсталяції, для кого\n  3 діалогові вікна, ліцензія, мови             4 необов'язкові частини\n  5 ярлики                                      6 файли: за папкою програми\n  7 будь-який ключ                              v показати   l lint   s зберегти   q вийти\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nПовідомлення з цим кодом (* позначає ім'я або значення):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nРезультати йдуть у stdout, діагностика - у stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nЩо зробити: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} більше немає, але його відкриває ярлик: спершу змініть ярлики (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  там файлів: {1}, папок: {2}\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s або q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  додано [dir.{1}] і [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  додано [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  укажіть це як таблиця.ключ, наприклад package.version або dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: проблем немає\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: див. проблеми вище (названий там файл - контрольна копія)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  інші мови в [ui] languages залишаються; змініть цей список через 7 (будь-який ключ)\n"

msgid "  removed [file.%s]\n"
msgstr "  видалено [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  видалено [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  підпапки:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  це не вкладається в підмножину TOML; нічого не змінено\n"

msgid "  that was not readable text; again, please\n"
msgstr "  це не був зрозумілий текст; ще раз, будь ласка\n"

msgid "  the program folder '%s': %s\n"
msgstr "  папка програми '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  у джерелі немає таблиць [file], на які міг би вказувати ярлик\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  у джерелі немає підпапок у вигляді, як їх записує `new` ([files] \"<folder>/<name>/**\"); додайте їх через 6\n"

msgid "  too long; again, please\n"
msgstr "  задовго; ще раз, будь ласка\n"

msgid "  y or n\n"
msgstr "  y або n\n"

msgid " (changed)"
msgstr " (змінено)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - створює пакети Windows Installer (.msi) і MSIX (.msix)\n\nвикористання: rubrapack [--lang <code>] <command> [arguments]\n\nкоманди:\n"

msgid " and its dir"
msgstr " і його dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) не має змінної середовища, тому розгортуване значення не може її містити; використайте рядкове значення (заповнюється під час інсталяції)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) - це {2}: воно може починати шлях або заміняти значення, яке заповнює Windows Installer (реєстр, середовище, INI, аргументи, повідомлення), але не тут"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) - не папка, з якої може починатися шлях (ідентифікатор dir або ProgramFiles, LOCALAPPDATA, ProgramData ... - див. Paths у посібнику){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  структура:    {2}\n  дайджест:     {3}\n  підпис:       {4}\n  ланцюжок:     {5}{6}{7}\n  відкликання:  не перевірено\n  позначка часу: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: змінну не задано"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' не є елементом керування цього діалогового вікна"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' немає в {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': текстові ліцензії потрібна англійська назва шрифту, тому він показується власним шрифтом мови; напишіть англійську назву (наприклад, \"Malgun Gothic\"), щоб і там використати цей шрифт"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' має бути текою"

msgid "%s component, but the package platform is %.*s"
msgstr "компонент {1}, але платформа пакета - {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} не належить до kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} не належить до kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} містить LANGID (1..65535), наприклад 1041"

msgid "%s holds strings"
msgstr "{1} містить рядки"

msgid "%s is %u to %u characters long"
msgstr "довжина {1} — від {2} до {3} символів"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} — це список текстів \"Ключ=Значення\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} — список текстів, наприклад [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} - назва шрифту від 1 до 31 символу, наприклад \"Segoe UI\" (отримано {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} - умова MSI із закритими лапками та збалансованими дужками"

msgid "%s is an array of strings, one per value"
msgstr "{1} - масив рядків, по одному на значення"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} стосується пакетів MSI: msiexec не видаляє MSIX"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} більше немає. Видалити [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} довше за 240 символів"

msgid "%s is new. Add it?"
msgstr "{1} новий. Додати його?"

msgid "%s is not a GUID in registry format"
msgstr "{1} не є GUID у форматі реєстру"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} не є кодом, який використовує цей rubrapack{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} має бути \"file:<ID>\" і називати [file.*] цього пакета"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} має містити від {2} до {3} літер, цифр, '.' або '-' і не починатися з '.' (отримано '{4}')"

msgid "%s must be a GUID"
msgstr "{1} має бути GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} має бути GUID на зразок {12345678-...} (отримано '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} має бути адресою http:// або https:// (отримано '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} має бути адресою https://, http:// або file:// чи шляхом \\\\server\\share (отримано '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} має відрізнятися від upgrade-code (одна родина оновлень на архітектуру)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} потребує збірки Windows {2} або новішої: задайте [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} потребує resources/bin/rubrapack_ca-{2}.dll, без якого зібрано цей rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA не перевірено (вкажіть --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA довірений"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA недовірений - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} більше немає або порожня. Видалити [files.{3}] і [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ - нова папка. Додати її?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: помилок: {2}{-3}, попереджень: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: помилок: {2}{-3}, попереджень: {4}{-5} (порівняно з {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: файлів: {2}, байтів: {3}\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: файлів: {2}, помилок: {3}, попереджень: 0\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: не показано ще діагностик: {2}\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' — не стандартна дія, яку розміщує rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: файл '{2}' не є [file.*] цього пакета"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: файл '{2}' не є програмою (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' не закрито (для тексту '$(' напишіть '$$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' уже існує; залишено як є"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' уже існує; видаліть його або зберіть в іншу папку"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' уже має обробник {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' уже має дозволи"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' і '{2}' - той самий шлях у пакеті"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' належить Windows або браузерам"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' не вдається прочитати відносно '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' не вкладається в підмножину TOML; нічого не збережено"

msgid "'%s' exists already"
msgstr "'{1}' уже існує"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' уже існує; змініть його командою `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' існує і не є порожнім каталогом; розпакуйте в новий"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' потрапляє в {2}; або msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' має непридатний для читання потік зведених відомостей"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' не має таблиць Directory, Component, File і Media, з яких можна розпакувати"

msgid "'%s' has no embedded transform '%s'"
msgstr "у '{1}' немає вбудованого перетворення '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' не має придатних для читання зведених відомостей"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' не має перетворення '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' у UTF-16: edit змінює лише джерела UTF-8 (спершу збережіть його як UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' - ім'я Windows; дайте змінній інше ім'я"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' - це [chain]: створює програму інсталяції, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' - елемент керування вбудованої рамки; виберіть інший ідентифікатор"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' - папка комп'ютера; пакет {2} не може туди записувати"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' - модуль злиття: натомість об'єднайте його через [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' - ім'я, яке формат MSIX залишає собі"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' - символьне посилання; посилання не відстежуються"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' також є [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' також ідентифікатор dir; дайте змінній інше ім'я"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' зібрано для машини 0x{2}, а не для arch цього пакета; задайте any-arch = true, якщо так задумано"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не є ні файлом PE (.exe, .dll), ні пакетом MSI, ні пакетом або набором MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не є ні файлом PE, ні пакетом MSI, ні пакетом або набором MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' не є ні відомою папкою, ні ідентифікатором dir (відомі папки: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is neither an MSIX package nor a package family name (<Name>_<publisher ID>)"
msgstr "'{1}' — не пакет MSIX і не назва сімейства пакетів (<Name>_<publisher ID>)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' не є cabinet, який rubrapack може прочитати (stored або MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' не є кодом діагностики (RP і чотири цифри, наприклад RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' не є програмою (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' не є звичайним файлом"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' не є програмою інсталяції rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' - неправильний ідентифікатор (літери, цифри і '_', не починається з цифри, не більше {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' - неправильна база даних MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' - неправильний пакет MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' - неправильний пакет: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' - неправильне джерело (підмножина TOML); спершу виправте його вручну"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' - неправильне перетворення: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' - неправильне ім'я змінної"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' зарезервовано, і його не можна використати як ідентифікатор"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' - ім'я dir: dir може заповнити лише пошук у реєстрі або dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' схожий на файл програми (PE), але його заголовки або ресурси пошкоджено"

msgid "'%s' must be a string"
msgstr "'{1}' має бути рядком"

msgid "'%s' must be an integer"
msgstr "'{1}' має бути цілим числом"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' має бути між {2} і {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' має бути true або false"

msgid "'%s' must not be empty"
msgstr "'{1}' не може бути порожнім"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' не називає перетворень (властивість зведення 8): це не виправлення"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' починається з папки: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' має {4}; нічого не розпаковано"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': записів: {2}, більше за ліміт {3} (--limit-entries); нічого не розпаковано"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' і '{3}' у Windows були б тим самим шляхом; нічого не розпаковано"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' немає в [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': не вдається прочитати таблицю"

msgid "'%s': a table is unreadable"
msgstr "'{1}': таблиця непридатна для читання"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX встановлює всі свої файли (when); використайте msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX видаляє всі свої файли (keep); використайте msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' пошкоджено або це не stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': ім'я cabinet '{2}' не є простим іменем файлу"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': стиснутий файл '{2}' (послідовність {3}) не має cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': каталог '{2}' має батьківський '{3}', якого немає"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': каталог '{2}' є власним предком або вкладений надто глибоко"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': файл '{2}' не відповідає своєму MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': файл '{2}' не має компонента або каталогу"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': файл '{2}' має {3} байтів, таблиця File вказує {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': файлу '{2}' немає в cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': його зовнішні cabinet не охоплено підписом (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': його папка не веде до відомого розташування"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': записати потрібно понад {2} байтів (--limit-bytes); нічого не розпаковано"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': немає --timestamp: підпис перестає бути чинним, коли сплине термін сертифіката"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': пакет '{2}' не відповідає своєму SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': потоку cabinet '{2}' немає"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': маніфест не має {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': маніфест називає '{2}', якого немає в пакеті"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': позначка часу від {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': перетворення '{2}' не вдається прочитати відносно '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' - власна мова пакета ({2}); укажіть цей текст без суфікса"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' змушує Windows Installer записати мультирядок; використайте type = \"multi\" і масив"

msgid "'_' in numbers is not supported"
msgstr "'_' у числах не підтримується"

msgid "'help' takes at most one command name"
msgstr "'help' приймає щонайбільше одну назву команди"

msgid "'version' takes no arguments"
msgstr "'version' не приймає аргументів"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs - для .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch для набору: список x64, x86 і arm64, кожна один раз (отримано '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch приймає одну архітектуру або список для виводу .msixbundle / .msixupload"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp і --allow-unsigned-cabs ідуть разом із --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress - для .msi; MSIX приймає --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist називає нову папку поруч із джерелом (без шляху)"

msgid "--flat is for a .msixbundle output (its packages are written beside it)"
msgstr "--flat — для виводу .msixbundle (його пакети записуються поруч)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs приймає число від 1 до 64 (отримано '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store - сховище сертифікатів Windows; деінде використовуйте файл ключа або --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store приймає відбиток SHA-1 сертифіката (40 шістнадцяткових цифр)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: такої мови немає (вбудовані: {2}; іншій потрібен її мовний пакет, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (або RUBRAPACK_LANG) вибирає мову цих текстів: {1} або мову з мовним пакетом.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang потребує мови, наприклад en або ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages потребує діалогових вікон: укажіть також --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress приймає deflate або store (отримано '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: змінну не задано"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code приймає GUID великими літерами у фігурних дужках: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: змінну не задано"

msgid "--previous compares two .msi packages"
msgstr "--previous порівнює два пакети .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: не вдається прочитати кореневі сертифікати операційної системи"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} не відповідає виводу '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} не реалізовано (msi або msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target приймає msi або msix (отримано '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots і --proxy ідуть разом із --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test і --msix-compress - для виводів .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test - для пакетів без підпису; із --key не вказуйте його"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate приймає none або деякі з product-code,upgrade-code,language,platform"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget — для виводу .msi, .msix або .msixbundle"

msgid "--winget needs a [winget] table: identifier, installer-url, license, short-description"
msgstr "для --winget потрібна таблиця [winget]: identifier, installer-url, license, short-description"

msgid "--winget needs the package in one file: winget downloads one, so not cab = \"external\""
msgstr "для --winget пакет має бути одним файлом: winget завантажує один, тож не cab = \"external\""

msgid "-D %.*s is given twice"
msgstr "-D {1} вказано двічі"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' - ім'я Windows; дайте змінній інше ім'я"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D потребує ІМ'Я=ЗНАЧЕННЯ (отримано '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "-i запитує кожну відповідь; вкажіть або -i, або параметри"

msgid "; its range is "
msgstr "; його діапазон - "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' немає в SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "ActionProperty має бути загальнодоступною властивістю (великі літери)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "Усі коди: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x не починається з PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x - не останній запис"

msgid "Architecture (x64, x86, arm64)"
msgstr "Архітектура (x64, x86, arm64)"

msgid "Choose"
msgstr "Виберіть"

msgid "Command line"
msgstr "Командний рядок"

msgid "Command line (lint)"
msgstr "Командний рядок (lint)"

msgid "Common AppData"
msgstr "Спільна AppData"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId не є GUID у форматі реєстру"

msgid "Desktop shortcut?"
msgstr "Ярлик на робочому столі?"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "Діалогові вікна (none, basic, minimal, installdir, features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "Коди виходу: 0 гаразд, 1 помилка джерела, 2 використання, 3 введення/виведення, 4 підписування або перевірка,\n5 lint, 6 мережа.\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "У таблиці File, Component або Directory бракує стандартного стовпця"

msgid "Folder name under Program Files"
msgstr "Ім'я папки в Program Files"

msgid "Folder with the files to install"
msgstr "Папка з файлами для інсталяції"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "Ідентифікатор '{1}' уже використано (рядок {2}); ідентифікатори мають різнитися в усіх таблицях"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "Папка інсталяції (шлях [dir.INSTALLDIR])"

msgid "Install for (machine, user, dual)"
msgstr "Інсталювати для (machine, user, dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "Ключ як таблиця.ключ (package.version, dir.INSTALLDIR.path, ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' належить іншому компоненту"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' немає у File"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' немає в Registry"

msgid "Korean dialogs as well as English?"
msgstr "Корейські діалогові вікна, а також англійські?"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} нижче, ніж у нижчого DiskId"

msgid "Leave without saving the changes?"
msgstr "Вийти без збереження змін?"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "Ліцензія для прийняття (.txt, .md, .rtf; - якщо немає)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "MSIX не має віртуальної папки для AppData користувача; програма створює там потрібне під час роботи"

msgid "MSIX packages"
msgstr "Пакети MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: що потрібно пакету MSIX і чого він не може містити"

msgid "Main program, for shortcuts (- for none)"
msgstr "Головна програма, для ярликів (- якщо немає)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "Посібник: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "Виробник"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Виробник (показується в Інстальованих програмах)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt повернув підпис ECDSA неправильної довжини"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "Необов'язкові частини, які користувач може позначити (підпапки, через кому; - якщо немає)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "Токен PKCS#11: токен не містить сертифіката з CKA_ID ключа (вкажіть його через --cert)"

msgid "Paths"
msgstr "Шляхи"

msgid "Product name"
msgstr "Назва продукту"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode і UpgradeCode - той самий GUID"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion {1} не вища за попередню {2} у перших трьох полях: Windows Installer не оновлює"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "Програма, яку відкривають ярлики (- без ярликів)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: такої мови немає (вбудовані: {2}; іншій потрібен її мовний пакет, {3}.po)"

msgid "Reference, "
msgstr "Довідник, "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "Послідовність {1} не охоплено жодним рядком Media (останній {2})"

msgid "Sequence %ld is used by another file"
msgstr "Послідовність {1} використовує інший файл"

msgid "Source file to write"
msgstr "Файл джерела для запису"

msgid "Source format"
msgstr "Формат джерела"

msgid "Source must name a File row for type %ld"
msgstr "Source має називати рядок File для типу {1}"

msgid "Start menu shortcut?"
msgstr "Ярлик у меню \"Пуск\"?"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "Записи меню \"Пуск\", \"Програми\", робочого столу й автозавантаження беруться з [shortcut.*] і [msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML поза підмножиною, яку читає rubrapack, або `format` відсутній чи надто новий"

msgid "Tables"
msgstr "Таблиці"

msgid "The TOML subset"
msgstr "Підмножина TOML"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "Файли UTF-16 big-endian не підтримуються; збережіть як UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode {1} відрізняється від коду попередньої версії {2}: цей пакет її не замінює"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode не є GUID у форматі реєстру"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "Значення (текст, число, true/false, [\"a\", \"b\"]; - видаляє ключ)"

msgid "Variables"
msgstr "Змінні"

msgid "Version"
msgstr "Версія"

msgid "Version ([define] VERSION)"
msgstr "Версія ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Версії та оновлення"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer дозволяє щонайбільше 255.255.65535(.65535)"

msgid "Windows name"
msgstr "ім'я Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] потребує '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] не може бути в модулі злиття; це має пакет, який його об'єднує"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] ще не підтримується (заплановано на {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] не може бути в MSIX; додайте msi-only = true, щоб зібрати MSIX без нього"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] розташовано в AppData або LocalAppData користувача: пакет dual, встановлений для всіх користувачів, кладе його лише в профіль користувача, який встановлює"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ідентифікатор у модулі злиття має щонайбільше 35 символів (до нього додається GUID модуля)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] потребує ідентифікатора: напишіть [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] не приймає ідентифікатора: напишіть [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml не має </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml - не останній запис (це не пакет, який записав rubrapack або API пакування Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Масиви таблиць [[...]] не підтримуються; дайте кожному елементу власний [kind.ID]"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] розміщується один раз: before, after або sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] потребує і do, і undo (undo також відкочує невдалий do)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] потребує entry: функцію DLL для виклику"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] потребує run = \"file:<ID>\": програму, яку запускають do і undo"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] запускає одне: run (exe), dll (встановлену DLL) або binary (DLL у пакеті); або do і undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} — для однієї дії, а не для пари do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: відкладена дія, що запускає встановлений файл, має йти після InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: негайна дія виконується від імені користувача, що встановлює; as — для інших фаз"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args — для програми; DLL отримує data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check іде з парою do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data — для відкладеної, commit- або rollback-дії (негайна читає властивості)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry — функція DLL; run бере args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args для MSIX мають бути простим текстом (без [...], що заповнюються під час інсталяції)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: у MSIX тип файлу відкриває програму: target має бути виконуваним файлом [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] трапляється двічі"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] потребує ідентифікатора: напишіть [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id і typelib записуються лише для MSI; MSIX реєструє клас без них"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args належать програмі; DLL завантажується, а не запускається"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate запускає DLL у dllhost; '{2}' - програма"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading - для DLL; програма сама задає свій apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version і typelib-file потребують typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] потрапляє в {2}; або msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: його джерелом має бути файл, що потрапляє в пакет"

msgid "[define] values must be strings"
msgstr "Значення [define] мають бути рядками"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] потребує '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] потребує image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] потребує 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] потребує 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] потребує 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] має елементів керування: {2}; щонайбільше 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] не має [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] розміщено після самого себе через інші діалогові вікна"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] потребує ui = \"minimal\", \"installdir\" або \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' - ім'я Windows; дайте dir інший ідентифікатор"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard потребує допоміжної DLL rubrapack, якої модуль злиття не містить"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] потребує компонента"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX задає всі свої змінні (when); використайте msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: його значення називає місце, якого MSIX не може дати (папку поза пакетом, яка не є папкою Windows, або частину часу інсталяції); використайте msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: з external-location = true пакет не містить жодного файла програми, тож і засобу запуску rubrapack; або msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] уже в теці своєї програми; isolate-for — для спільної DLL, встановленої в іншому місці"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] розташовано в профілі користувача, і він має component-guid: ключовим шляхом лишається файл, тоді як правила Windows вимагають там значення HKCU (ICE38); приберіть component-guid, щоб його отримати"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Провідник завантажує обробник {2} з DLL; [com.{3}] - програма"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows читає обробники властивостей лише для комп'ютера; пакет потребує scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: обробник попереднього перегляду працює в prevhost Windows; не вказуйте app-id і surrogate в [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX містить лише обробники ескізів і попереднього перегляду (упакований обробник властивостей не дав Провіднику значень); msi-only = true залишає його для MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: тип файлу MSIX належить програмі; додайте [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: клас {2} не є [com.*] цього пакета (його обслуговує DLL обробника)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: у MSIX обробники спільно мають усі свої типи або жодного (тип є в одній асоціації типу файлу)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: у MSIX його клас працює в surrogate; threading = \"sta\" в [com.{2}] дає його вікну цикл повідомлень (з threading = {3} перегляд може лишитися порожнім)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: у MSIX усі його типи в одному типі файлу [assoc] або в жодному"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: його клас - msi-only ([com.{2}]); MSIX не мав би для нього сервера"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types - список типів файлів, наприклад [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] потрапляє в {2}; або msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] потребує 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] потребує компонента: задайте 'feature' тут або в його dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX записує всі свої записи INI (when); використайте msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: його значення має частину, яку Windows Installer заповнює під час інсталяції ([...]); MSIX записує файл під час збирання"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] потребує 'on': де показується елемент, наприклад [\".txt\"] або \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] потребує 'target' (програму, яку він запускає) або елементів із parent = \"{2}\" (підменю)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] потребує 'target': програму, яку запускає елемент"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: меню Windows 11 приймає ID лише з літер і цифр (без '_'): перейменуйте або вкажіть windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: підменю нічого не запускає: не вказуйте 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: елемент підменю показується там, де його підменю: не вказуйте 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args має частину, яку Windows Installer заповнює під час інсталяції ([...]); MSIX містить лише незмінний текст"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when — це \"HKCU\\\\key\\\\value\" або \"HKLM\\\\...\", у пункту меню Windows 11, що не входить у підменю"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when вказує на значення, яке пише сам цей пакет ([registry.{2}]): пункт ніколи не з'явиться"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: його програми немає в MSIX (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: його значення не можуть потрапити в реєстр пакета"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list має частину, яку Windows Installer заповнює під час інсталяції ([...]); MSIX містить лише незмінний текст"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: list заміняє {2}, коли шляхи не вміщуються в командний рядок: потрібні multi = \"one\", {3} в args і {4} (файл списку) в list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": немає [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on - тип файлу або їх список, наприклад [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' не є [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' має бути підменю: [menu.*] без target і без власного parent"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] потрапляє в {2}; або msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] потребує компонента: задайте 'feature' тут або в його dir"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; або msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] потребує feature (або with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature іде зі своїм компонентом, а не з with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name вказує один файл; у name є підставні знаки"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: цілі спільного доступу потрібні types, formats або обидва"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: обробнику автовідтворення потрібні content-events, device-events або обидва"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args мають бути простим текстом (без [...], що заповнюються під час інсталяції)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events потрібен class (COM-клас IHWEventHandler програми)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file має бути {2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file має називати файл, що потрапляє в пакет"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file має називати програму, що потрапляє в пакет"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types - список типів файлів, наприклад [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows приймає лише літери й цифри"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "[msix-psf] для arm64 потребує launcher = \"...\" (PSF називає свої засоби запуску PsfLauncher32.exe, PsfLauncher64.exe)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] не поєднується ні з external-location = true, ні з [env.*] (власним засобом запуску rubrapack)"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] запускає програми через засіб запуску PSF: потрібен [msix-app.ID]"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: config '{1}' не називає програму '{2}' у своїх \"applications\""

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: у files немає '{1}' (засобу запуску)"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: файл '{2}' — не DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] вказує свій драйвер один раз: driver (один [odbc-driver]) або driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] із driver-name потребує with = \"file:<ID>\": компонент, з яким він встановлюється"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: пакет для комп'ютера реєструє джерела даних для комп'ютера"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] вказує одну копію: msix (з publisher) або upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix — ім'я посвідчення пакета (від 3 до 50 літер, цифр, '.' або '-'), і потрібен publisher (\"CN=...\"), як у його маніфесті"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: іншу копію шукає попередня перевірка: потрібно preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code належить цьому пакету (це оновлення, а не інша копія)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] потребує, щоб його dir мав компонент"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: args для MSIX мають бути простим текстом (без [...], що заповнюються під час інсталяції)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: у MSIX схема відкриває програму: target має бути виконуваним файлом [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] потребує 'value' (або remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR не сягає за межі MSIX; використайте [assoc.*], [protocol.*], [com.*] або [handler.*], або msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: значення qword потребує допоміжної DLL rubrapack, якої модуль злиття не містить"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: MSIX містить значення лише під {2}\\Software"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: MSIX ані не видаляє значень, ані не залишає їх (remove, keep); використайте msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: MSIX записує всі свої значення (when); використайте msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: його значення має частину, яку Windows Installer заповнює під час інсталяції ([...]); MSIX містить лише незмінні значення"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\" потребує допоміжної DLL rubrapack, якої модуль злиття не містить"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: ім'я ключа або значення не може потрапити у вулик реєстру"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" - для root = \"HKCU\" з on = \"uninstall\", у пакеті для комп'ютера"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] потребує компонента: задайте 'feature' тут або в його dir"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true - не для папки під {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true потребує допоміжної DLL rubrapack, якої модуль злиття не містить"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" - для recursive = true у папки в AppData або LocalAppData, у пакеті для комп'ютера"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: args для MSIX мають бути простим текстом (без [...], що заповнюються під час інсталяції)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file має називати програму, що потрапляє в пакет"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] рекламує компонент '{2}', у якого advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise не поєднується з when"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: MSIX має ярлики лише на робочому столі та в меню \"Пуск\"{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: ярлик MSIX не має working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: ярлик MSIX є завжди (when - для MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: ярлик MSIX показує логотип своєї програми; icon - для MSI"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: рекламований ярлик призначений для MSI (MSIX встановлює весь пакунок)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: рекламованому ярлику потрібен значок"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: args для MSIX мають бути простим текстом (без [...], що заповнюються під час інсталяції)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: у MSIX ярлик запускає програму: target має бути виконуваним файлом [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: запис меню \"Пуск\" у MSIX - це його програма, яка не приймає args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: жоден текст діалогового вікна не має цього ідентифікатора"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded призначено для MSI; MSIX не має власного інтерфейсу встановлення"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] потребує ui = \"basic\" або інший набір діалогів у [package] (або embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "escape-послідовність \\{1} не є скалярним значенням Unicode"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: цей пакет не оновив би попередній чисто"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` пакета: діалогові вікна, кодова сторінка, нормалізація тексту"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` пакета або набору MSIX"

msgid "a %s control has no property"
msgstr "елемент {1} не має property"

msgid "a %s control has no text; put a text control beside it"
msgstr "елемент керування {1} не має тексту; розмістіть поруч текстовий елемент"

