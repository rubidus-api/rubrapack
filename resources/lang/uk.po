msgstr "властивість '{1}' має бути загальнодоступним ім'ям: великі літери, цифри і '_'"

msgid "protocol must be \"tcp\" or \"udp\" (got '%s')"
msgstr "protocol має бути \"tcp\" або \"udp\" (отримано '{1}')"

msgid "public-folder must be a folder of the package, like \"Public\" (got '%s')"
msgstr "public-folder має бути папкою пакета, наприклад \"Public\" (отримано '{1}')"

msgid "publisher is the package's publisher, such as \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""
msgstr "publisher - видавець пакета, наприклад \"CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US\""

msgid "publisher must be the signing certificate's subject, such as \"CN=Example, O=Example, C=KR\""
msgstr "publisher має бути суб'єктом сертифіката підпису, наприклад \"CN=Example, O=Example, C=KR\""

