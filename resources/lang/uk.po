msgstr "image приймає лише елемент bitmap"

msgid "only radio, combo and listbox controls take labels"
msgstr "labels приймають лише елементи radio, combo та listbox"

msgid "only radio, combo and listbox controls take values"
msgstr "values приймають лише елементи radio, combo та listbox"

msgid "out of memory"
msgstr "бракує пам'яті"

