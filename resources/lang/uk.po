msgstr "багаторядкові рядки не підтримуються; використайте один рядок із \\n"

msgid "must be 1 to 64 bytes"
msgstr "має бути від 1 до 64 байтів"

msgid "name contains a control character"
msgstr "ім'я містить керівний символ"

msgid "name is a package's identity name (got '%s')"
msgstr "name - ім'я ідентичності пакета (отримано '{1}')"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "name не в ASCII, і немає summary-name; темою зведення буде 'rubrapack package'"

msgid "names a folder its Directory table does not have"
msgstr "називає папку, якої немає в його таблиці Directory"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "new msix ще не реалізовано: створіть джерело MSI і додайте [msix] (див. посібник)"

msgid "no 'format = %d' line: a source in the format of rubrapack 0.18 or earlier, which this version does not read (paths start with $(ProgramFiles) or $(INSTALLDIR) now); see the manual's Source format"
msgstr "немає рядка 'format = {1}': джерело у форматі rubrapack 0.18 або старішого, якого ця версія не читає (шляхи тепер починаються з $(ProgramFiles) або $(INSTALLDIR)); див. Source format у посібнику"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "не вказано --trust: підпис перевіряється, але ніщо не каже, кому довіряти"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "жоден сертифікат у файлі ключа (або у файлі --cert) не належить ключу"

msgid "no control characters"
msgstr "без керівних символів"

msgid "no keys\n"
msgstr "ключів немає\n"

msgid "no main program, so no shortcuts: none"
msgstr "немає головної програми, тож немає ярликів: немає"

msgid "no server name, or one longer than 255 bytes"
msgstr "немає імені сервера, або воно довше за 255 байтів"

msgid "no string pool: not a transform"
msgstr "немає пулу рядків: це не перетворення"

msgid "no table '%s' in '%s'"
msgstr "немає таблиці '{1}' в '{2}'"

