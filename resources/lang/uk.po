msgstr "language = \"ko-KR\" більше не робить діалогові вікна корейськими: вони англійські, якщо [ui] languages = [\"ko\"] не додає корейську"

msgid "language must be \"ko-KR\" or \"en-US\""
msgstr "language має бути \"ko-KR\" або \"en-US\""

msgid "language must be \"neutral\", \"en-US\" or \"ko-KR\""
msgstr "language має бути \"neutral\", \"en-US\" або \"ko-KR\""

msgid "languages = \"all\" stands alone, not in an array: it takes every built-in language"
msgstr "languages = \"all\" пишеться окремо, не в масиві: він додає всі вбудовані мови"

msgid "languages holds codes like \"ko\" or \"zh_TW\" (2 or 3 lower-case letters, and _ and a region's two capitals) (got '%s')"
msgstr "languages містить коди на зразок \"ko\" або \"zh_TW\" (2 або 3 малі літери, а також _ і дві великі літери регіону) (отримано '{1}')"

msgid "languages is an array of language codes, like [\"ko\"]"
msgstr "languages - масив кодів мов, наприклад [\"ko\"]"

msgid "languages needs a dialog set (ui = \"basic\" or another)"
msgstr "languages потребує набору діалогових вікон (ui = \"basic\" або іншого)"

msgid "launch must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "launch має бути \"file:<ID>\" і називати [file.*] цього пакета"

msgid "launch-args needs launch"
msgstr "launch-args потребує launch"

msgid "launcher is the file name of the PSF launcher in files, like \"PsfLauncher64.exe\""
msgstr "launcher — ім’я файла засобу запуску PSF у files, наприклад \"PsfLauncher64.exe\""

msgid "license must be a .txt, .md (shown as plain text) or .rtf file"
msgstr "license має бути файлом .txt, .md (показується як простий текст) або .rtf"

msgid "lint: %s row %s: column %s is not in NFC (%zu row%s); build --nfc puts folder, file and shortcut names in NFC"
msgstr "lint: {1} рядок {2}: стовпець {3} не в NFC (рядків: {4}{-5}); build --nfc переводить імена папок, файлів і ярликів у NFC"

msgid "lint: %s%s"
msgstr "lint: {1}{2}"

msgid "lint: code page %u, not 65001: text is not checked as UTF-8, widths only for ASCII"
msgstr "lint: кодова сторінка {1}, а не 65001: текст не перевіряється як UTF-8, ширини лише для ASCII"

msgid "lint: no problems\n"
msgstr "lint: проблем немає\n"

msgid "lint: see the problems above\n"
msgstr "lint: див. проблеми вище\n"

msgid "list the keys a token or the Windows certificate store can sign with"
msgstr "показати ключі, якими може підписувати токен або сховище сертифікатів Windows"

msgid "logo '%s' and its .scale-100 variant are both there: keep one"
msgstr "логотип '{1}' і його варіант .scale-100 є обидва: залиште один"

msgid "logo '%s' at scale %s is %ux%u pixels; it must be %ux%u"
msgstr "логотип '{1}' у масштабі {2} має {3}x{4} пікселів; має бути {5}x{6}"

msgid "logo '%s' at scale %s is not a PNG file"
msgstr "логотип '{1}' у масштабі {2} не є файлом PNG"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "логотип '{1}' має {2}x{3} пікселів; має бути {4}x{5}"

