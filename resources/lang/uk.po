msgstr "types: кожен - '.' і малі літери, цифри, '_' або '-' (отримано '{1}')"

msgid "ui = \"%s\" lets the user choose the folder of dir '%s', which does not exist (set [ui] install-dir)"
msgstr "ui = \"{1}\" дає користувачеві вибрати папку dir '{2}', якої не існує (задайте [ui] install-dir)"

