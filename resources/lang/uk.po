msgid "logo must be a .png of 8-bit RGB or RGBA, not interlaced, at most 1024 pixels a side"
msgstr "logo має бути .png 8-біт RGB або RGBA, без черезрядковості, не більше 1024 пікселів на сторону"

msgid "main-package is the main package's identity name (got '%s')"
msgstr "main-package - ім'я ідентичності основного пакета (отримано '{1}')"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "main-publisher і modification = true ідуть разом із main-package (пакетом, до якого належить цей)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "main-publisher - видавець основного пакета, наприклад \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "не може містити керівних символів або / \\ : * ? \" < > | $"

