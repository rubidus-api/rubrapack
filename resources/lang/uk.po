msgstr "on = \"uninstall\" видаляє ключ з усім, що під ним: '{1}' не є власним ключем продукту під Software"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" видаляє під час видалення весь ключ; він не приймає '{1}'"

