msgstr "prog-id '{1}' уже належить [com.{2}]"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id '{1}' також належить [assoc.{2}]: тип файлу і клас COM потребують двох імен"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "prog-id '{1}' також є в [assoc.{2}] з іншим description, target, icon або args"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "prog-id має складатися з літер, цифр, '.', '_' або '-', не починатися з цифри, щонайбільше 39 (отримано '{1}')"

msgid "property '%s' already belongs to control '%s'"
msgstr "властивість '{1}' уже належить елементу керування '{2}'"

msgid "property '%s' has the name of a dir or feature"
msgstr "властивість '{1}' має ім'я dir або компонента"

msgid "property '%s' is already defined (line %u)"
msgstr "властивість '{1}' уже визначено (рядок {2})"

msgid "property '%s' is already searched (line %u)"
msgstr "властивість '{1}' уже шукається (рядок {2})"

msgid "property '%s' is set by rubrapack or the installer and cannot be defined here"
msgstr "властивість '{1}' задає rubrapack або інсталятор, і її не можна визначити тут"

