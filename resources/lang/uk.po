msgstr "присутній більше ніж один токен: назвіть один через --token-label"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "multi має бути \"each\", \"one\" або \"single\" (отримано '{1}')"

msgid "multi-line strings are not supported"
msgstr "багаторядкові рядки не підтримуються"

