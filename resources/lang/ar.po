msgstr "يجب أن يكون الإصدار '{1}' على شكل a.b.c أو a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "يجب أن يكون الإصدار '{1}' على شكل a.b.c أو a.b.c.d حيث a وb ‏<= 255 وc وd ‏<= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "لا يمكن أن يذهب view = \"32\" 'with' ملف في حزمة 64 بت"

msgid "view must be \"32\" or \"64\""
msgstr "يجب أن يكون view هو \"32\" أو \"64\""

msgid "warning"
msgstr "تحذير"

