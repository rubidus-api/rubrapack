msgstr "main-package هو اسم هوية الحزمة الرئيسية (الموجود '{1}')"

msgid "main-publisher and modification = true go with main-package (the package this one belongs to)"
msgstr "main-publisher وmodification = true يأتيان مع main-package (الحزمة التي تنتمي إليها هذه الحزمة)"

msgid "main-publisher is the main package's publisher, such as \"CN=Example\""
msgstr "main-publisher هو ناشر الحزمة الرئيسية، مثل \"CN=Example\""

msgid "may not contain control characters or / \\ : * ? \" < > | $"
msgstr "لا يجوز أن يحتوي على أحرف تحكم أو / \\ : * ? \" < > | $"

msgid "may not start with a space or end with a space or a dot"
msgstr "لا يجوز أن يبدأ بمسافة أو ينتهي بمسافة أو نقطة"

msgid "merge module '%s' not found"
msgstr "لم يُعثر على وحدة الدمج '{1}'"

msgid "min-version must be a version like 1.2.3"
msgstr "يجب أن يكون min-version إصداراً مثل 1.2.3"

msgid "min-version must have four parts, such as 10.0.17763.0"
msgstr "يجب أن يتكون min-version من أربعة أجزاء، مثل 10.0.17763.0"

msgid "min-version must have four parts, such as 14.0.24217.0"
msgstr "يجب أن يتكون min-version من أربعة أجزاء، مثل 14.0.24217.0"

msgid "mismatch"
msgstr "عدم تطابق"

msgid "mode = \"remove\" removes the key; it takes no 'value'"
msgstr "mode = \"remove\" يزيل المفتاح؛ ولا يأخذ 'value'"

msgid "mode must be \"set\", \"add\" or \"remove\""
msgstr "يجب أن يكون mode هو \"set\" أو \"add\" أو \"remove\""

msgid "mode must be \"set\", \"append\" or \"prepend\""
msgstr "يجب أن يكون mode هو \"set\" أو \"append\" أو \"prepend\""

msgid "more ZIP entries than allowed or than the directory holds"
msgstr "إدخالات ZIP أكثر من المسموح أو مما يحمله الدليل"

msgid "more keys and values than allowed"
msgstr "مفاتيح وقيم أكثر من المسموح"

msgid "more than 3 redirects"
msgstr "أكثر من 3 عمليات إعادة توجيه"

msgid "more than 96 sections"
msgstr "أكثر من 96 قسماً"

msgid "more than one source file ('%s')"
msgstr "أكثر من ملف مصدر واحد ('{1}')"

msgid "more than one token is present: name one with --token-label"
msgstr "يوجد أكثر من رمز مميز واحد: سمِّ واحداً باستخدام --token-label"

msgid "msix-packages"
msgstr "msix-packages"

msgid "multi must be \"each\", \"one\" or \"single\" (got '%s')"
msgstr "يجب أن يكون multi هو \"each\" أو \"one\" أو \"single\" (الموجود '{1}')"

msgid "multi-line strings are not supported"
msgstr "السلاسل متعددة الأسطر غير مدعومة"

msgid "multi-line strings are not supported; use one line with \\n"
msgstr "السلاسل متعددة الأسطر غير مدعومة؛ استخدم سطراً واحداً مع \\n"

msgid "must be 1 to 64 bytes"
msgstr "يجب أن يكون من 1 إلى 64 بايت"

msgid "name contains a control character"
msgstr "يحتوي الاسم على حرف تحكم"

msgid "name is a package's identity name (got '%s')"
msgstr "name هو اسم هوية الحزمة (الموجود '{1}')"

msgid "name is not ASCII and summary-name is missing; the summary Subject will read 'rubrapack package'"
msgstr "الاسم ليس ASCII وsummary-name مفقود؛ سيكون Subject الملخص 'rubrapack package'"

msgid "names a folder its Directory table does not have"
msgstr "يسمّي مجلداً ليس في جدول Directory الخاص به"

msgid "new msix is not implemented yet: make an MSI source and add [msix] (see the manual)"
msgstr "new msix غير منفّذ بعد: أنشئ مصدر MSI وأضف [msix] (راجع الدليل)"

msgid "no 'format = %d' line: a source in the format of rubrapack 0.18 or earlier, which this version does not read (paths start with $(ProgramFiles) or $(INSTALLDIR) now); see the manual's Source format"
msgstr "لا يوجد سطر 'format = {1}': مصدر بتنسيق rubrapack 0.18 أو أقدم، لا يقرؤه هذا الإصدار (تبدأ المسارات الآن بـ $(ProgramFiles) أو $(INSTALLDIR))؛ راجع Source format في الدليل"

msgid "no --trust given: the signature verifies but nothing says whom to trust"
msgstr "لم يُعطَ --trust: التوقيع سليم لكن لا شيء يحدد بمن يُوثق"

msgid "no certificate in the key file (or the --cert file) belongs to the key"
msgstr "لا توجد في ملف المفتاح (أو ملف --cert) شهادة تنتمي إلى المفتاح"

msgid "no control characters"
msgstr "لا أحرف تحكم"

msgid "no keys\n"
msgstr "لا توجد مفاتيح\n"

msgid "no main program, so no shortcuts: none"
msgstr "لا يوجد برنامج رئيسي، لذا لا اختصارات: لا شيء"

msgid "no server name, or one longer than 255 bytes"
msgstr "لا يوجد اسم خادم، أو أنه أطول من 255 بايت"

msgid "no string pool: not a transform"
msgstr "لا توجد مجموعة سلاسل: ليس تحويلاً"

msgid "no table '%s' in '%s'"
msgstr "لا يوجد جدول '{1}' في '{2}'"

msgid "no-remove leaves Modify (its Remove) as the only way to remove the product: it cannot go with no-modify"
msgstr "يترك no-remove الخيار Modify (الإزالة فيه) الطريقة الوحيدة لإزالة المنتج: لا يمكن أن يأتي مع no-modify"

msgid "not a PE file (no MZ header)"
msgstr "ليس ملف PE (لا يوجد رأس MZ)"

msgid "not a PE file (no PE header)"
msgstr "ليس ملف PE (لا يوجد رأس PE)"

msgid "not a PEM, PKCS#8 or PKCS#12 file"
msgstr "ليس ملف PEM أو PKCS#8 أو PKCS#12"

msgid "not a ZIP archive (no end record)"
msgstr "ليس أرشيف ZIP (لا يوجد سجل النهاية)"

msgid "not a ZIP archive (too short)"
msgstr "ليس أرشيف ZIP (قصير جداً)"

msgid "not a proxy URL rubrapack accepts (http://host:port)"
msgstr "ليس عنوان URL لوكيل يقبله rubrapack ‏(http://host:port)"

msgid "not a registry hive"
msgstr "ليس خلية سجل"

msgid "not a valid number"
msgstr "ليس رقماً صالحاً"

msgid "not a value"
msgstr "ليس قيمة"

msgid "not a value (strings need quotes)"
msgstr "ليس قيمة (تحتاج السلاسل النصية إلى علامات اقتباس)"

msgid "not an http:// or https:// URL rubrapack accepts"
msgstr "ليس عنوان URL من نوع http:// أو https:// يقبله rubrapack"

msgid "not valid UTF-8"
msgstr "ليس UTF-8 صالحاً"

msgid "not-checked (give --trust or --system-roots)"
msgstr "لم يُفحص (أعطِ --trust أو --system-roots)"

msgid "not-present"
msgstr "غير موجود"

msgid "nothing changed\n"
msgstr "لم يتغير شيء\n"

msgid "number out of range"
msgstr "رقم خارج النطاق"

msgid "octal and binary numbers are not supported; use decimal or 0x"
msgstr "الأرقام الثمانية والثنائية غير مدعومة؛ استخدم العشري أو 0x"

msgid "on = \"uninstall\" is for HKLM, HKCU and HKMU (classes go with [assoc.*], [com.*] and the like)"
msgstr "on = \"uninstall\" مخصص لـ HKLM وHKCU وHKMU (تذهب الفئات مع [assoc.*] و[com.*] وما شابه)"

msgid "on = \"uninstall\" removes a key with everything below it: '%s' is not a product's own key below Software"
msgstr "on = \"uninstall\" يزيل مفتاحاً بكل ما تحته: '{1}' ليس مفتاحاً خاصاً بمنتج تحت Software"

msgid "on = \"uninstall\" removes the whole key at removal; it takes no '%s'"
msgstr "on = \"uninstall\" يزيل المفتاح كله عند الإزالة؛ ولا يأخذ '{1}'"

msgid "on Windows `keys list` shows the certificate store"
msgstr "على Windows يعرض `keys list` مخزن الشهادات"

msgid "on Windows a token is used through the certificate store (--key-store <thumbprint>)"
msgstr "على Windows يُستخدم الرمز المميز عبر مخزن الشهادات (--key-store <thumbprint>)"

msgid "on is for remove = true (when the key is removed)"
msgstr "on مخصص لـ remove = true (متى يُزال المفتاح)"

msgid "on must be \"install\" or \"uninstall\""
msgstr "يجب أن يكون on هو \"install\" أو \"uninstall\""

msgid "on must be \"install\", \"uninstall\" or \"both\""
msgstr "يجب أن يكون on هو \"install\" أو \"uninstall\" أو \"both\""

msgid "on: each is a file type ('.' and lower-case letters, digits, '_' or '-'), \"*\" (every file), \"folder\", \"background\" (the empty part of a folder), \"drive\" or \"assoc:<ID>\" (got '%s')"
msgstr "on: كل منها نوع ملف ('.' ثم حروف صغيرة أو أرقام أو '_' أو '-')، أو \"*\" (كل ملف)، أو \"folder\"، أو \"background\" (الجزء الفارغ من مجلد)، أو \"drive\"، أو \"assoc:<ID>\" (الموجود '{1}')"

msgid "only radio and combo controls take labels"
msgstr "لا تأخذ labels إلا عناصر التحكم radio وcombo"

msgid "only radio and combo controls take values"
msgstr "لا تأخذ values إلا عناصر التحكم radio وcombo"

msgid "out of memory"
msgstr "نفدت الذاكرة"

msgid "output '%s': rubrapack writes .msi, .msm, .msix, .msixbundle and a chain's setup .exe"
msgstr "الإخراج '{1}': يكتب rubrapack ملفات .msi و.msm و.msix و.msixbundle وملف setup .exe للسلسلة"

msgid "package '%s' %s"
msgstr "الحزمة '{1}' {2}"

msgid "package '%s' not found"
msgstr "لم يُعثر على الحزمة '{1}'"

msgid "parent must be another product's upgrade-code, not this package's own"
msgstr "يجب أن يكون parent هو upgrade-code لمنتج آخر، وليس الخاص بهذه الحزمة"

msgid "parent must be the main product's upgrade-code, a GUID like {12345678-1234-1234-1234-123456789ABC}"
msgstr "يجب أن يكون parent هو upgrade-code للمنتج الرئيسي، معرّف GUID مثل {{12345678-1234-1234-1234-123456789ABC}"

msgid "path must be \"$(Base)/relative/path\" with '/' (Base is a folder such as ProgramFiles, or a dir ID)"
msgstr "يجب أن يكون path على شكل \"$(Base)/relative/path\" مع '/' (‏Base مجلد مثل ProgramFiles، أو معرّف dir)"

msgid "path must start with a Windows folder (like $(ProgramFiles) or $(System))"
msgstr "يجب أن يبدأ path بمجلد من مجلدات Windows (مثل $(ProgramFiles) أو $(System))"

msgid "paths"
msgstr "المسارات"

msgid "perceived-type must be \"image\", \"text\", \"audio\", \"video\", \"compressed\", \"document\", \"system\" or \"application\" (got '%s')"
msgstr "يجب أن يكون perceived-type هو \"image\" أو \"text\" أو \"audio\" أو \"video\" أو \"compressed\" أو \"document\" أو \"system\" أو \"application\" (الموجود '{1}')"

msgid "permissions need scope = \"machine\" (this is %s)"
msgstr "تحتاج الأذونات إلى scope = \"machine\" (هذه {1})"

msgid "phase must be \"immediate\", \"deferred\", \"commit\" or \"rollback\" (got '%s')"
msgstr "يجب أن يكون phase إما \"immediate\" أو \"deferred\" أو \"commit\" أو \"rollback\" (وردت '{1}')"

msgid "ports must be a port or a range like \"8000-8100\" within 1-65535 (got '%s')"
msgstr "يجب أن يكون ports منفذاً أو نطاقاً مثل \"8000-8100\" ضمن 1-65535 (الموجود '{1}')"

msgid "print a random GUID, or the one rubrapack derives from a text"
msgstr "طباعة GUID عشوائي، أو الذي يشتقه rubrapack من نص"

msgid "print the JSON Schema of sources (for an editor that completes and checks keys)"
msgstr "طباعة JSON Schema للمصادر (لمحرر يُكمل المفاتيح ويفحصها)"

msgid "print the version"
msgstr "طباعة الإصدار"

msgid "print this help, or one command's usage"
msgstr "طباعة هذه المساعدة، أو طريقة استخدام أمر واحد"

msgid "product-code must be a GUID"
msgstr "يجب أن يكون product-code معرّف GUID"

msgid "profile must be \"all\", \"domain\", \"private\" or \"public\" (got '%s')"
msgstr "يجب أن يكون profile هو \"all\" أو \"domain\" أو \"private\" أو \"public\" (الموجود '{1}')"

msgid "prog-id '%s' is already [com.%s]'s"
msgstr "prog-id ‏'{1}' تابع بالفعل لـ [com.{2}]"

msgid "prog-id '%s' is also [assoc.%s]'s: a file type and a COM class need two names"
msgstr "prog-id ‏'{1}' تابع أيضاً لـ [assoc.{2}]: يحتاج نوع الملف وفئة COM إلى اسمين"

msgid "prog-id '%s' is also in [assoc.%s] with another description, target, icon or args"
msgstr "prog-id ‏'{1}' موجود أيضاً في [assoc.{2}] بوصف أو هدف أو أيقونة أو وسيطات أخرى"

msgid "prog-id must be letters, digits, '.', '_' or '-', not starting with a digit, at most 39 (got '%s')"
msgstr "يجب أن يتكون prog-id من حروف وأرقام و'.' و'_' و'-'، لا يبدأ برقم، 39 حرفاً على الأكثر (الموجود '{1}')"

msgid "property '%s' already belongs to control '%s'"
msgstr "الخاصية '{1}' تابعة بالفعل لعنصر التحكم '{2}'"

msgid "property '%s' has the name of a dir or feature"
msgstr "للخاصية '{1}' اسم dir أو ميزة"

