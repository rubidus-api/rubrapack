msgstr "الاستخدام: rubrapack lint <file.msi> [--previous <old.msi>] [--strict]"

msgid "usage: rubrapack lint <file.msix|file.msixbundle> [--strict]"
msgstr "الاستخدام: rubrapack lint <file.msix|file.msixbundle> [--strict]"

