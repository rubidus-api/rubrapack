msgstr "المتغير '{1}' غير معرّف ([define] أو -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "لا يجوز أن يحتوي اسم المتغير '{1}' على '=' أو أن يبدأ بـ = + - ! *"

