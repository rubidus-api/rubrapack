msgstr "الشعار '{1}' عند المقياس {2} ليس ملف PNG"

msgid "logo '%s' is %ux%u pixels; it must be %ux%u"
msgstr "الشعار '{1}' هو {2}x{3} بكسل؛ يجب أن يكون {4}x{5}"

msgid "logo '%s' is not a PNG file"
msgstr "الشعار '{1}' ليس ملف PNG"

msgid "logo '%s' not found (nor as .scale-100 ... .scale-400 variants)"
msgstr "لم يُعثر على الشعار '{1}' (ولا على متغيراته .scale-100 ... .scale-400)"

