# rubrapack language pack: Arabic.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.
# The language reads right to left (X-Rubrapack-Direction: rtl): its dialogs are mirrored.

msgid ""
msgstr ""
"Language: ar\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: العربية\n"
"X-Rubrapack-LangIDs: 1025, 3073, 14337, 2049, 11265, 6145, 5121, 13313\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 5\n"
"X-Rubrapack-Direction: rtl\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}، {4}، {5}، مربعات الحوار {6}{7}\n  1 الاسم، الشركة المصنعة، الإصدار، البنية      2 مجلد التثبيت، لمن يتم التثبيت\n  3 مربعات الحوار، الترخيص، اللغات               4 الأجزاء الاختيارية\n  5 الاختصارات                                   6 الملفات: مطابقة مجلد البرنامج\n  7 أي مفتاح                                     v عرض   l lint   s حفظ   q خروج\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nالرسائل التي تحمل هذا الرمز (* تعني اسماً أو قيمة):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nتذهب النتائج إلى stdout، والتشخيصات إلى stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nما الذي يجب فعله: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} لم يعد موجوداً، لكن اختصاراً يفتحه: غيّر الاختصارات (5) أولاً\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} ملف و{2} مجلد هناك\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7 أو v أو l أو s أو q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  تمت إضافة [dir.{1}] و[files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  تمت إضافة [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  اكتبه على شكل table.key، مثل package.version أو dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: لا توجد مشكلات\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: راجع المشكلات أعلاه (الملف المذكور هناك نسخة للفحص)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  تُحفظ اللغات الأخرى في [ui] languages؛ غيّر تلك القائمة بالخيار 7 (أي مفتاح)\n"

msgid "  removed [file.%s]\n"
msgstr "  تمت إزالة [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  تمت إزالة [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  المجلدات الفرعية:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  هذا لا يتوافق مع مجموعة TOML الفرعية؛ لم يتغير شيء\n"

msgid "  that was not readable text; again, please\n"
msgstr "  لم يكن ذلك نصاً مقروءاً؛ مرة أخرى من فضلك\n"

msgid "  the program folder '%s': %s\n"
msgstr "  مجلد البرنامج '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  لا يحتوي المصدر على جداول [file] يشير إليها اختصار\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  لا يحتوي المصدر على مجلدات فرعية كما يكتبها `new` ([files] \"<folder>/<name>/**\")؛ أضفها بالخيار 6\n"

msgid "  too long; again, please\n"
msgstr "  طويل جداً؛ مرة أخرى من فضلك\n"

msgid "  y or n\n"
msgstr "  y أو n\n"

msgid " (changed)"
msgstr " (تم التغيير)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - إنشاء حزم Windows Installer (.msi) وMSIX (.msix)\n\nالاستخدام: rubrapack [--lang <code>] <command> [arguments]\n\nالأوامر:\n"

msgid " and its dir"
msgstr " ومجلده"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) ليس متغير بيئة، لذا لا يمكن أن تحمله قيمة قابلة للتوسيع؛ استخدم قيمة نصية (تُملأ وقت التثبيت)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) هو {2}: يمكن أن يبدأ به مسار، أو أن يحل محل قيمة يملؤها Windows Installer (السجل، البيئة، INI، الوسيطات، الرسائل)، وليس هنا"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) ليس مجلداً يمكن أن يبدأ منه مسار (معرّف dir، أو ProgramFiles أو LOCALAPPDATA أو ProgramData ... - راجع Paths في الدليل){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  البنية:       {2}\n  الملخص:       {3}\n  التوقيع:      {4}\n  السلسلة:      {5}{6}{7}\n  الإبطال:      لم يُفحص\n  الطابع الزمني: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: المتغير غير معيّن"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' ليس عنصر تحكم في مربع الحوار هذا"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' ليس في {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': يحتاج نص الترخيص إلى الاسم الإنجليزي للخط، لذا يظهر بخط اللغة نفسها؛ اكتب الاسم الإنجليزي (مثل \"Malgun Gothic\") لاستخدام هذا الخط هناك أيضاً"

msgid "%s component, but the package platform is %.*s"
msgstr "مكوّن {1}، لكن نظام الحزمة الأساسي هو {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} لا ينتمي إلى kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} لا ينتمي إلى kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} يحمل معرّفات LANGID ‏(1..65535)، مثل 1041"

msgid "%s holds strings"
msgstr "{1} يحمل سلاسل نصية"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} قائمة من نصوص \"مفتاح=قيمة\""

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} اسم خط من 1 إلى 31 حرفاً، مثل \"Segoe UI\" (الموجود {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} شرط MSI بعلامات اقتباس مغلقة وأقواس متوازنة"

msgid "%s is an array of strings, one per value"
msgstr "{1} مصفوفة سلاسل نصية، واحدة لكل قيمة"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} مخصص لحزم MSI: لا تتم إزالة MSIX بواسطة msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} لم يعد موجوداً. هل تريد إزالة [file.{2}]؟"

msgid "%s is longer than 240 characters"
msgstr "{1} أطول من 240 حرفاً"

msgid "%s is new. Add it?"
msgstr "{1} جديد. هل تريد إضافته؟"

msgid "%s is not a GUID in registry format"
msgstr "{1} ليس GUID بتنسيق السجل"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} ليس رمزاً يستخدمه rubrapack هذا{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "يجب أن يكون {1} على شكل \"file:<ID>\" يسمّي [file.*] في هذه الحزمة"

msgid "%s must be a GUID"
msgstr "يجب أن يكون {1} معرّف GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "يجب أن يكون {1} معرّف GUID مثل {{12345678-...} (الموجود '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "يجب أن يكون {1} عنوان https:// أو http:// أو file://، أو مساراً \\\\server\\share (الموجود '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "يجب أن يختلف {1} عن upgrade-code (عائلة ترقية واحدة لكل بنية)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "يحتاج {1} إلى إصدار Windows {2} أو أحدث: عيّن [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "يحتاج {1} إلى resources/bin/rubrapack_ca-{2}.dll، وقد بُني rubrapack هذا بدونه"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}، لم يُفحص TSA (حدد --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}، TSA موثوق"

msgid "%s, TSA untrusted - %s"
msgstr "{1}، TSA غير موثوق - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} لم يعد موجوداً أو أنه فارغ. هل تريد إزالة [files.{3}] و[dir.{4}]؟"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ مجلد جديد. هل تريد إضافته؟"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: الأخطاء: {2}{-3}، التحذيرات: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: الأخطاء: {2}{-3}، التحذيرات: {4}{-5} (مقارنة بـ {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} ملف، {3} بايت\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} ملف، {3} خطأ، 0 تحذير\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} تشخيصاً آخر لم يُعرض\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' ليس إجراءً قياسيًا يضعه rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: الملف '{2}' ليس [file.*] في هذه الحزمة"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: الملف '{2}' ليس برنامجاً (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' غير مغلق (اكتب '$$(' للنص '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' موجود بالفعل؛ يُترك كما هو"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' موجود بالفعل؛ أزله أو قم بالبناء في مجلد آخر"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' لديه بالفعل معالج {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' لديه أذونات بالفعل"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' و'{2}' هما المسار نفسه في الحزمة"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' تابع لـ Windows أو المستعرضات"

msgid "'%s' cannot be read against '%s': %s"
msgstr "لا يمكن قراءة '{1}' مقابل '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' لا يتوافق مع مجموعة TOML الفرعية؛ لم يُحفظ شيء"

msgid "'%s' exists already"
msgstr "'{1}' موجود بالفعل"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' موجود بالفعل؛ غيّره باستخدام `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' موجود وليس دليلاً فارغاً؛ استخرج إلى دليل جديد"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' يذهب إلى {2}؛ أو msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' يحتوي على دفق معلومات ملخص غير قابل للقراءة"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' لا يحتوي على جداول Directory وComponent وFile وMedia للاستخراج منها"

msgid "'%s' has no readable summary information"
msgstr "'{1}' لا يحتوي على معلومات ملخص قابلة للقراءة"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' لا يحتوي على التحويل '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' بترميز UTF-16: يغيّر edit مصادر UTF-8 فقط (احفظه بترميز UTF-8 أولاً)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' اسم من أسماء Windows؛ أعط المتغير اسماً آخر"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' هو [chain]: يبني برنامج إعداد، -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' عنصر تحكم في الإطار المضمّن؛ اختر معرّفاً آخر"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' مجلد على مستوى الجهاز؛ لا يمكن لحزمة {2} الكتابة فيه"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' وحدة دمج: ادمجها باستخدام [merge.ID] بدلاً من ذلك"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' اسم يحتفظ به تنسيق MSIX لنفسه"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' ارتباط رمزي؛ لا يتم تتبّع الارتباطات"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' هو أيضاً [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' هو أيضاً معرّف dir؛ أعط المتغير اسماً آخر"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' مبني للجهاز 0x{2}، وليس لبنية هذه الحزمة؛ عيّن any-arch = true إذا كان ذلك مقصوداً"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ليس ملف PE ‏(.exe، .dll)، ولا حزمة MSI، ولا حزمة MSIX أو مجموعة حزم"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ليس ملف PE، ولا حزمة MSI، ولا حزمة MSIX أو مجموعة حزم"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' ليس مجلداً معروفاً ولا معرّف dir (المجلدات المعروفة: ProgramFiles، ProgramFiles32، CommonFiles، AppData، LocalAppData، CommonAppData، StartMenu، Programs، Desktop، Windows، System، Fonts، Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' ليس ملف cabinet يستطيع rubrapack قراءته (مخزّن أو MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' ليس رمز تشخيص (RP وأربعة أرقام، مثل RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' ليس برنامجاً (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' ليس ملفاً عادياً"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' ليس برنامج إعداد من rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' ليس معرّفاً صالحاً (حروف وأرقام و'_'، لا يبدأ برقم، {2} حرفاً على الأكثر)"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' ليس قاعدة بيانات MSI صالحة: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' ليس حزمة MSIX صالحة: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' ليس حزمة صالحة: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' ليس مصدراً صالحاً (مجموعة TOML الفرعية)؛ أصلحه يدوياً أولاً"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' ليس تحويلاً صالحاً: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' ليس اسم متغير صالحاً"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' محجوز ولا يمكن استخدامه كمعرّف"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' هو اسم dir: لا يملأ dir إلا بحث في السجل أو بحث عن dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "يبدو '{1}' ملف برنامج (PE) لكن رؤوسه أو موارده تالفة"

msgid "'%s' must be a string"
msgstr "يجب أن يكون '{1}' سلسلة نصية"

msgid "'%s' must be an integer"
msgstr "يجب أن يكون '{1}' عدداً صحيحاً"

msgid "'%s' must be between %lld and %lld"
msgstr "يجب أن يكون '{1}' بين {2} و{3}"

msgid "'%s' must be true or false"
msgstr "يجب أن يكون '{1}' true أو false"

msgid "'%s' must not be empty"
msgstr "يجب ألا يكون '{1}' فارغاً"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' لا يسمّي أي تحويلات (خاصية الملخص 8): ليس تصحيحاً"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' يبدأ بمجلد: \"$(ProgramFiles)/Example\"، \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' فيه {4}؛ لم يُستخرج شيء"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} إدخالاً، أكثر من الحد {3} ‏(--limit-entries)؛ لم يُستخرج شيء"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': سيكون '{2}' و'{3}' المسار نفسه على Windows؛ لم يُستخرج شيء"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' ليست في [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': لا يمكن قراءة جدول"

msgid "'%s': a table is unreadable"
msgstr "'{1}': جدول غير قابل للقراءة"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': تثبّت حزمة MSIX كل ملفاتها (when)؛ استخدم msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': تزيل حزمة MSIX كل ملفاتها (keep)؛ استخدم msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': ملف cabinet '{2}' تالف أو ليس stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': اسم cabinet '{2}' ليس اسم ملف بسيطاً"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': الملف المضغوط '{2}' (التسلسل {3}) ليس له cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': الدليل '{2}' له أصل '{3}' غير موجود"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': الدليل '{2}' هو سلفه الخاص أو متداخل بعمق شديد"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': الملف '{2}' لا يطابق MsiFileHash الخاص به"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': الملف '{2}' ليس له مكوّن أو دليل"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': حجم الملف '{2}' هو {3} بايت، ويذكر جدول File ‏{4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': الملف '{2}' ليس في cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': ملفات cabinet الخارجية الخاصة به لا يغطيها التوقيع (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': مجلده لا يؤدي إلى موقع معروف"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': أكثر من {2} بايت للكتابة (--limit-bytes)؛ لم يُستخرج شيء"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': لا يوجد --timestamp: يتوقف التوقيع عن الصلاحية عند انتهاء صلاحية الشهادة"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': الحزمة '{2}' لا تطابق قيمة SHA-256 الخاصة بها"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': دفق cabinet ‏'{2}' غير موجود"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': البيان لا يحتوي على {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': يسمّي البيان '{2}'، وهو ليس في الحزمة"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': طابع زمني من {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': لا يمكن قراءة التحويل '{2}' مقابل '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' هي لغة الحزمة نفسها ({2})؛ اكتب ذلك النص بدون اللاحقة"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' يجعل Windows Installer يكتب سلسلة متعددة؛ استخدم type = \"multi\" ومصفوفة"

msgid "'_' in numbers is not supported"
msgstr "'_' في الأرقام غير مدعوم"

msgid "'help' takes at most one command name"
msgstr "يأخذ 'help' اسم أمر واحد على الأكثر"

msgid "'version' takes no arguments"
msgstr "لا يأخذ 'version' أي وسيطات"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs مخصص لملفات .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch لمجموعة حزم: قائمة من x64 وx86 وarm64، كل منها مرة واحدة (الموجود '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "يأخذ --arch بنية واحدة، أو قائمة لإخراج .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "تُستخدم --cert و--pass-env و--pass-file و--timestamp و--allow-unsigned-cabs مع --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress مخصص لملفات .msi؛ تأخذ MSIX الخيار --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "يسمّي --dist مجلداً جديداً بجوار المصدر (بدون مسار)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "يأخذ --jobs رقماً من 1 إلى 64 (الموجود '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store هو مخزن شهادات Windows؛ في غير Windows استخدم ملف مفتاح أو --pkcs11"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "يأخذ --key-store بصمة SHA-1 للشهادة (40 رقماً ستة عشرياً)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: لا توجد لغة كهذه (المضمّنة: {2}؛ تحتاج لغة أخرى إلى حزمة لغتها، {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (أو RUBRAPACK_LANG) يختار لغة هذه النصوص: {1}، أو لغة لها حزمة لغة.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "يحتاج --lang إلى لغة، مثل en أو ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "يحتاج --languages إلى مربعات حوار: أعطِ --ui أيضاً"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "يأخذ --msix-compress القيمة deflate أو store (الموجود '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: المتغير غير معيّن"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "يأخذ --patch-code معرّف GUID بأحرف كبيرة مع أقواس: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: المتغير غير معيّن"

msgid "--previous compares two .msi packages"
msgstr "يقارن --previous بين حزمتي .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: لا يمكن قراءة شهادات الجذر في نظام التشغيل"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} لا يطابق الإخراج '{2}'"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} غير منفّذ (msi أو msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "يأخذ --target القيمة msi أو msix (الموجود '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "تُستخدم --tsa-trust و--tls-trust و--system-roots و--proxy مع --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test و--msix-compress مخصصان لمخرجات .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test مخصص للحزم غير الموقّعة؛ احذفه مع --key"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "يأخذ --validate القيمة none، أو بعضاً من product-code,upgrade-code,language,platform"

msgid "-D %.*s is given twice"
msgstr "أُعطي -D {1} مرتين"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' اسم من أسماء Windows؛ أعط المتغير اسماً آخر"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "يحتاج -D إلى NAME=VALUE (الموجود '{1}')"

msgid "-i asks for every answer; give either -i or the options"
msgstr "يطلب -i كل إجابة؛ أعطِ إما -i أو الخيارات"

msgid "; its range is "
msgstr "؛ نطاقه "

msgid "ActionProperty '%.*s' is not in SecureCustomProperties"
msgstr "ActionProperty '{1}' ليست في SecureCustomProperties"

msgid "ActionProperty must be a public (upper case) property"
msgstr "يجب أن تكون ActionProperty خاصية عامة (بأحرف كبيرة)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "جميع الرموز: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "لا يبدأ AppxSignature.p7x بـ PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x ليس الإدخال الأخير"

msgid "Architecture (x64, x86, arm64)"
msgstr "البنية (x64، x86، arm64)"

msgid "Choose"
msgstr "اختر"

msgid "Command line"
msgstr "سطر الأوامر"

msgid "Command line (lint)"
msgstr "سطر الأوامر (lint)"

msgid "Common AppData"
msgstr "AppData المشترك"

msgid "ComponentId is not a GUID in registry format"
msgstr "ComponentId ليس GUID بتنسيق السجل"

msgid "Desktop shortcut?"
msgstr "اختصار على سطح المكتب؟"

msgid "Dialogs (none, basic, minimal, installdir, features)"
msgstr "مربعات الحوار (none، basic، minimal، installdir، features)"

msgid "Exit codes: 0 ok, 1 source error, 2 usage, 3 input/output, 4 signing or verification,\n5 lint, 6 network.\n"
msgstr "رموز الخروج: 0 نجاح، 1 خطأ في المصدر، 2 الاستخدام، 3 الإدخال/الإخراج، 4 التوقيع أو التحقق،\n5 lint، 6 الشبكة.\n"

msgid "File, Component or Directory table lacks a standard column"
msgstr "ينقص جدول File أو Component أو Directory عموداً قياسياً"

msgid "Folder name under Program Files"
msgstr "اسم المجلد تحت Program Files"

msgid "Folder with the files to install"
msgstr "المجلد الذي يحتوي على الملفات المطلوب تثبيتها"

msgid "ID '%s' is already used (line %u); IDs must differ across all tables"
msgstr "المعرّف '{1}' مستخدم بالفعل (السطر {2})؛ يجب أن تختلف المعرّفات عبر كل الجداول"

msgid "Install folder ([dir.INSTALLDIR] path)"
msgstr "مجلد التثبيت (مسار [dir.INSTALLDIR])"

msgid "Install for (machine, user, dual)"
msgstr "التثبيت لـ (machine، user، dual)"

msgid "Key as table.key (package.version, dir.INSTALLDIR.path, ...)"
msgstr "المفتاح على شكل table.key ‏(package.version، dir.INSTALLDIR.path، ...)"

msgid "KeyPath '%.*s' belongs to another component"
msgstr "KeyPath '{1}' تابع لمكوّن آخر"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' ليس في File"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' ليس في Registry"

msgid "Korean dialogs as well as English?"
msgstr "مربعات حوار باللغة الكورية إلى جانب الإنجليزية؟"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence ‏{1} أقل من تسلسل DiskId أدنى"

msgid "Leave without saving the changes?"
msgstr "هل تريد المغادرة دون حفظ التغييرات؟"

msgid "License to accept (.txt, .md, .rtf; - for none)"
msgstr "الترخيص المطلوب قبوله (.txt، .md، .rtf؛ - لعدم وجوده)"

msgid "MSIX has no virtual folder for the user's AppData; the app creates what it needs there when it runs"
msgstr "لا تحتوي MSIX على مجلد ظاهري لـ AppData الخاص بالمستخدم؛ ينشئ التطبيق ما يحتاجه هناك عند تشغيله"

msgid "MSIX packages"
msgstr "حزم MSIX"

msgid "MSIX: what an MSIX package needs, and what it cannot carry"
msgstr "MSIX: ما تحتاجه حزمة MSIX، وما لا يمكنها حمله"

msgid "Main program, for shortcuts (- for none)"
msgstr "البرنامج الرئيسي، للاختصارات (- لعدم وجوده)"

msgid "Manual: %s\"%s\" - https://rubidus-api.github.io/rubrapack/en/%s%s\n"
msgstr "الدليل: {1}\"{2}\" - https://rubidus-api.github.io/rubrapack/en/{3}{4}\n"

msgid "Manufacturer"
msgstr "الشركة المصنعة"

msgid "Manufacturer (shown in Installed apps)"
msgstr "الشركة المصنعة (تظهر في التطبيقات المثبتة)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "أعاد NCrypt توقيع ECDSA بطول خاطئ"

msgid "Optional parts the user may tick (sub folders, commas; - for none)"
msgstr "الأجزاء الاختيارية التي يمكن للمستخدم تحديدها (مجلدات فرعية، مفصولة بفواصل؛ - لعدم وجودها)"

msgid "PKCS#11 token: the token holds no certificate with the key's CKA_ID (give it with --cert)"
msgstr "رمز PKCS#11 المميز: لا يحمل الرمز أي شهادة بمعرّف CKA_ID الخاص بالمفتاح (أعطها باستخدام --cert)"

msgid "Paths"
msgstr "المسارات"

msgid "Product name"
msgstr "اسم المنتج"

msgid "ProductCode and UpgradeCode are the same GUID"
msgstr "ProductCode وUpgradeCode هما GUID نفسه"

msgid "ProductVersion %s is not higher than the previous %s in its first three fields: Windows Installer does not upgrade"
msgstr "ProductVersion ‏{1} ليس أعلى من السابق {2} في حقوله الثلاثة الأولى: لا يقوم Windows Installer بالترقية"

msgid "Program the shortcuts open (- for no shortcuts)"
msgstr "البرنامج الذي تفتحه الاختصارات (- لعدم وجود اختصارات)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: لا توجد لغة كهذه (المضمّنة: {2}؛ تحتاج لغة أخرى إلى حزمة لغتها، {3}.po)"

msgid "Reference, "
msgstr "المرجع، "

msgid "Sequence %ld is not covered by any Media row (last %ld)"
msgstr "التسلسل {1} لا يغطيه أي صف في Media (الأخير {2})"

msgid "Sequence %ld is used by another file"
msgstr "التسلسل {1} يستخدمه ملف آخر"

msgid "Source file to write"
msgstr "ملف المصدر المطلوب كتابته"

msgid "Source format"
msgstr "تنسيق المصدر"

msgid "Source must name a File row for type %ld"
msgstr "يجب أن يسمّي Source صفاً في File للنوع {1}"

msgid "Start menu shortcut?"
msgstr "اختصار في قائمة ابدأ؟"

msgid "Start menu, Programs, Desktop and Startup entries come from [shortcut.*] and [msix-extension.*]"
msgstr "تأتي إدخالات قائمة ابدأ والبرامج وسطح المكتب وبدء التشغيل من [shortcut.*] و[msix-extension.*]"

msgid "TOML outside the subset rubrapack reads, or `format` missing or too new"
msgstr "TOML خارج المجموعة الفرعية التي يقرؤها rubrapack، أو `format` مفقود أو أحدث من اللازم"

msgid "Tables"
msgstr "الجداول"

msgid "The TOML subset"
msgstr "مجموعة TOML الفرعية"

msgid "UTF-16 big-endian files are not supported; save as UTF-8"
msgstr "ملفات UTF-16 بترتيب big-endian غير مدعومة؛ احفظها بترميز UTF-8"

msgid "UpgradeCode %s differs from the previous version's %s: this package does not replace it"
msgstr "UpgradeCode ‏{1} يختلف عن {2} للإصدار السابق: هذه الحزمة لا تستبدله"

msgid "UpgradeCode is not a GUID in registry format"
msgstr "UpgradeCode ليس GUID بتنسيق السجل"

msgid "Value (text, a number, true/false, [\"a\", \"b\"]; - removes the key)"
msgstr "القيمة (نص، رقم، true/false، [\"a\", \"b\"]؛ - تزيل المفتاح)"

msgid "Variables"
msgstr "المتغيرات"

msgid "Version"
msgstr "الإصدار"

msgid "Version ([define] VERSION)"
msgstr "الإصدار ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "الإصدارات والترقيات"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "يسمح Windows Installer بحد أقصى 255.255.65535(.65535)"

msgid "Windows name"
msgstr "اسم Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] يحتاج إلى '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "لا يمكن أن يدخل [{1}{2}] في وحدة دمج؛ الحزمة التي تدمجها هي التي تحتويه"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] غير مدعوم بعد (مخطط له في {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "لا يمكن أن يدخل [{1}.{2}] في MSIX؛ أضف msi-only = true لبناء MSIX بدونه"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] موجود في AppData أو LocalAppData الخاص بالمستخدم: حزمة dual المثبتة لجميع المستخدمين تضعه في ملف تعريف المستخدم الذي يثبّتها فقط"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: للمعرّف في وحدة الدمج 35 حرفاً على الأكثر (يُضاف إليه GUID الوحدة)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "يحتاج [{1}] إلى معرّف: اكتب [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "لا يأخذ [{1}] معرّفاً: اكتب [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "لا يحتوي [Content_Types].xml على </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml ليس الإدخال الأخير (ليست حزمة كتبها rubrapack أو واجهة الحزم في Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "مصفوفات الجداول [[...]] غير مدعومة؛ أعط كل عنصر [kind.ID] خاصاً به"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] يوضع مرة واحدة: before أو after أو sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "يحتاج [action.{1}] إلى do وundo معاً (undo يتراجع أيضاً عن do فاشل)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] يحتاج entry: دالة مكتبة DLL التي تُستدعى"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] يحتاج run = \"file:<ID>\": البرنامج الذي يشغّله do وundo"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] يشغّل شيئًا واحدًا: run (ملف exe) أو dll (مكتبة DLL مثبَّتة) أو binary (مكتبة DLL في الحزمة)؛ أو do وundo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} لإجراء واحد، لا لزوج do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: الإجراء المؤجَّل الذي يشغّل ملفًا مثبَّتًا يجب أن يأتي بعد InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: الإجراء الفوري يعمل بصفة المستخدم الذي يثبّت؛ وas للمراحل الأخرى"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args لبرنامج؛ وتأخذ مكتبة DLL قيمة data"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: يذهب check مع زوج do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data لإجراء مؤجَّل أو commit أو rollback (الإجراء الفوري يقرأ الخصائص)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry دالة في مكتبة DLL؛ وrun يأخذ args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: يجب أن تكون args لحزمة MSIX نصاً عادياً (لا [...] تُملأ عند التثبيت)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: في MSIX يفتح نوع الملف تطبيقاً: يجب أن يكون target ملفاً تنفيذياً لـ [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] موجود مرتين"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "يحتاج [chain-package] إلى معرّف: اكتب [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: يُكتب app-id وtypelib لحزمة MSI فقط؛ تسجّل MSIX الفئة بدونهما"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args خاصة ببرنامج؛ ملف DLL يُحمَّل ولا يُشغَّل"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: يشغّل surrogate ملف DLL في dllhost؛ '{2}' برنامج"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading خاص بملف DLL؛ البرنامج يحدد apartment الخاص به"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: يحتاج typelib-version وtypelib-file إلى typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] يذهب إلى {2}؛ أو msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: يجب أن يكون مصدره ملفاً يدخل في الحزمة"

msgid "[define] values must be strings"
msgstr "يجب أن تكون قيم [define] سلاسل نصية"

msgid "[dialog-control.%s] needs '%s'"
msgstr "يحتاج [dialog-control.{1}] إلى '{2}'"

msgid "[dialog-control.%s] needs 'property'"
msgstr "يحتاج [dialog-control.{1}] إلى 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "يحتاج [dialog-control.{1}] إلى 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "يحتاج [dialog-control.{1}] إلى 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "في [dialog.{1}] ‏{2} عنصر تحكم؛ 64 على الأكثر"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "لا يحتوي [dialog.{1}] على أي [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] موضوع بعد نفسه عبر مربعات حوار أخرى"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "يحتاج [dialog.{1}] إلى ui = \"minimal\" أو \"installdir\" أو \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' اسم من أسماء Windows؛ أعط dir معرّفاً آخر"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: يحتاج guard إلى DLL المساعد الخاص بـ rubrapack، ولا تحمله وحدة الدمج"

msgid "[env.%s] needs a feature"
msgstr "يحتاج [env.{1}] إلى ميزة"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: تعيّن MSIX كل متغيراتها (when)؛ استخدم msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: قيمته تسمّي مكاناً لا تستطيع MSIX تقديمه (مجلد خارج الحزمة ليس من مجلدات Windows، أو جزء يُحدد وقت التثبيت)؛ استخدم msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] موجود فعلًا في مجلد برنامجه؛ وisolate-for لمكتبة DLL مشتركة مثبَّتة في مكان آخر"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] موجود في ملف تعريف المستخدم وله component-guid: يبقى مسار المفتاح هو الملف، بينما تريد قواعد Windows قيمة HKCU هناك (ICE38)؛ احذف component-guid للحصول عليها"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: يحمّل المستكشف معالج {2} من DLL؛ [com.{3}] برنامج"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: يقرأ Windows معالجات الخصائص على مستوى الجهاز فقط؛ تحتاج الحزمة إلى scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: يعمل معالج المعاينة في prevhost الخاص بـ Windows؛ اترك app-id وsurrogate خارج [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: تحمل MSIX معالجات الصور المصغرة والمعاينة فقط (معالج الخصائص المحزّم لم يعطِ المستكشف أي قيم)؛ msi-only = true يبقيه لحزمة MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: نوع ملف MSIX ينتمي إلى تطبيق؛ أضف [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: الفئة {2} ليست [com.*] في هذه الحزمة (DLL المعالج هو الذي يخدمها)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: في MSIX تتشارك المعالجات كل أنواعها أو لا شيء منها (النوع موجود في ارتباط نوع ملف واحد)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: في MSIX تعمل فئته في surrogate؛ threading = \"sta\" في [com.{2}] يمنح نافذته حلقة رسائل (مع threading = {3} قد تبقى المعاينة فارغة)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: في MSIX تكون كل أنواعه في نوع ملف [assoc] واحد، أو لا شيء"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: فئته msi-only ‏([com.{2}])؛ لن يكون لـ MSIX خادم لها"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types قائمة بأنواع الملفات، مثل [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] يذهب إلى {2}؛ أو msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "يحتاج [ini.{1}] إلى 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "يحتاج [ini.{1}] إلى ميزة: عيّن 'feature' هنا أو على dir الخاص به"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: تكتب MSIX كل إدخالات INI الخاصة بها (when)؛ استخدم msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: قيمته تحتوي جزءاً يملؤه Windows Installer وقت التثبيت ([...])؛ تكتب MSIX الملف عند بنائها"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "يحتاج [menu.{1}] إلى 'on': حيث يظهر العنصر، مثل [\".txt\"] أو \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "يحتاج [menu.{1}] إلى 'target' (البرنامج الذي يشغّله)، أو عناصر بـ parent = \"{2}\" (قائمة فرعية)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "يحتاج [menu.{1}] إلى 'target': البرنامج الذي يشغّله العنصر"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: قائمة Windows 11 لا تقبل إلا معرّف ID من حروف وأرقام (بلا '_'): غيّر اسمه أو اجعل windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: القائمة الفرعية لا تشغّل شيئاً: اترك 'args' خارجاً"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: عنصر القائمة الفرعية يظهر حيث تظهر قائمته الفرعية: اترك 'on' خارجاً"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args فيه جزء يملؤه Windows Installer وقت التثبيت ([...])؛ لا تحمل MSIX إلا نصاً ثابتاً"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: قيمة hide-when هي \"HKCU\\\\key\\\\value\" أو \"HKLM\\\\...\"، على عنصر في قائمة Windows 11 ليس داخل قائمة فرعية"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: يسمي hide-when قيمة تكتبها هذه الحزمة نفسها ([registry.{2}]): لن يظهر العنصر أبدًا"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: برنامجه ليس في MSIX ‏(msi-only؟)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: لا يمكن أن تدخل قيمه في سجل الحزمة"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list فيه جزء يملؤه Windows Installer وقت التثبيت ([...])؛ لا تحمل MSIX إلا نصاً ثابتاً"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: يحل list محل {2} حين لا تتسع المسارات في سطر أوامر: يلزم multi = \"one\" و{3} في args و{4} (ملف القائمة) في list"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": لا يوجد [assoc.{3}]"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on نوع ملف أو قائمة منها، مثل [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' ليس [menu.*]"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: يجب أن يكون parent '{2}' قائمة فرعية: [menu.*] بلا target وبلا parent خاص به"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] يذهب إلى {2}؛ أو msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "يحتاج [merge.{1}] إلى ميزة: عيّن 'feature' هنا أو على dir الخاص به"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}؛ أو msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] يحتاج feature (أو with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: يذهب feature مع مكوّن خاص به، لا مع with"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: يحدد new-name ملفًا واحدًا؛ ويحتوي name على أحرف بدل"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: يجب أن تكون args نصاً عادياً (لا [...] تُملأ عند التثبيت)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: يجب أن يكون file ‏{2}"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: يجب أن يسمّي file ملفاً يدخل في الحزمة"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: يجب أن يسمّي file برنامجاً يدخل في الحزمة"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types قائمة بأنواع الملفات، مثل [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': لا يقبل Windows إلا الحروف والأرقام"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: الملف '{2}' ليس مكتبة DLL"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] يحدد برنامج تشغيله مرة واحدة: driver (أي [odbc-driver]) أو driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] مع driver-name يحتاج with = \"file:<ID>\": المكوّن الذي يُثبَّت معه"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: حزمة لكل جهاز تسجّل مصادر البيانات للجهاز"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] يسمي نسخة واحدة: msix (مع publisher) أو upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix هو اسم هوية الحزمة (من 3 إلى 50 حرفًا أو رقمًا أو '.' أو '-') ويلزمه publisher (\"CN=...\")، كما في بيانها"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: يبحث الفحص المسبق عن النسخة الأخرى: يلزم preflight = true"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code هو رمز هذه الحزمة نفسها (هذا ترقية وليس نسخة أخرى)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "يحتاج [permission.{1}] إلى أن يكون لـ dir الخاص به ميزة"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: يجب أن تكون args لحزمة MSIX نصاً عادياً (لا [...] تُملأ عند التثبيت)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: في MSIX يفتح المخطط تطبيقاً: يجب أن يكون target ملفاً تنفيذياً لـ [msix-app.*]"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "يحتاج [registry.{1}] إلى 'value' (أو remove = true)"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: لا يصل HKCR إلى خارج MSIX؛ استخدم [assoc.*] أو [protocol.*] أو [com.*] أو [handler.*]، أو msi-only = true"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: تحتاج قيمة qword إلى DLL المساعد الخاص بـ rubrapack، ولا تحمله وحدة الدمج"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: تحمل MSIX القيم تحت {2}\\Software فقط"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: لا تزيل MSIX القيم ولا تتركها خلفها (remove، keep)؛ استخدم msi-only = true"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: تكتب MSIX كل قيمها (when)؛ استخدم msi-only = true"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: قيمته تحتوي جزءاً يملؤه Windows Installer وقت التثبيت ([...])؛ لا تحمل MSIX إلا قيماً ثابتة"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: يحتاج on = \"uninstall\" إلى DLL المساعد الخاص بـ rubrapack، ولا تحمله وحدة الدمج"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: لا يمكن أن يدخل اسم المفتاح أو القيمة في خلية سجل"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\" مخصص لـ root = \"HKCU\" مع on = \"uninstall\"، في حزمة لكل الكمبيوتر"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "يحتاج [remove.{1}] إلى ميزة: عيّن 'feature' هنا أو على dir الخاص به"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true ليس لمجلد تحت {2}"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: يحتاج recursive = true إلى DLL المساعد الخاص بـ rubrapack، ولا تحمله وحدة الدمج"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\" مخصص لـ recursive = true على مجلد في AppData أو LocalAppData، في حزمة لكل الكمبيوتر"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: يجب أن تكون args لحزمة MSIX نصاً عادياً (لا [...] تُملأ عند التثبيت)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: يجب أن يسمّي file برنامجاً يدخل في الحزمة"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: لا تحتوي MSIX على اختصارات إلا على سطح المكتب وفي قائمة ابدأ{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: لا يحتوي اختصار MSIX على working-dir"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: اختصار MSIX موجود دائماً (when خاص بـ MSI)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: يعرض اختصار MSIX شعار تطبيقه؛ icon خاص بـ MSI"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: يجب أن تكون args لحزمة MSIX نصاً عادياً (لا [...] تُملأ عند التثبيت)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: في MSIX يشغّل الاختصار تطبيقاً: يجب أن يكون target ملفاً تنفيذياً لـ [msix-app.*]"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: إدخال قائمة ابدأ في MSIX هو تطبيقها، ولا يأخذ args"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: لا يوجد نص حوار بهذا المعرّف"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package]"
msgstr "يحتاج [ui] إلى ui = \"basic\" أو مجموعة حوار أخرى في [package]"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "تسلسل الهروب \\{1} ليس قيمة Unicode قياسية"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: لن تقوم هذه الحزمة بترقية السابقة بشكل سليم"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "`lint` لحزمة: مربعات الحوار، صفحة الترميز، توحيد النص"

msgid "`lint` of an MSIX package or bundle"
msgstr "`lint` لحزمة MSIX أو مجموعة حزم"

msgid "a %s control has no text; put a text control beside it"
msgstr "لا يحتوي عنصر التحكم {1} على نص؛ ضع عنصر تحكم نصياً بجانبه"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "يحتاج عنصر التحكم {1} إلى [property.{2}] بإحدى قيمه كقيمة افتراضية (يستخدمها التثبيت الصامت)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "لا يمكن لحزمة {1} الكتابة في HKLM؛ استخدم HKMU"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "يحتاج إخراج .msix إلى جدول [msix-app.ID] يسمّي الملف التنفيذي"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "يحتاج إخراج .msix إلى جدول [msix] ‏(identity-name، publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "إخراج .msm هو وحدة دمج، تُبنى من مصدر فيه [module] بدلاً من [package]"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "ملف .txt أو .md أو .rtf، أو - لعدم وجوده"

msgid "a PE file without a certificate table entry"
msgstr "ملف PE بلا إدخال لجدول الشهادات"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "لا يُؤخذ رقم PIN أبداً من سطر الأوامر (يمكن للآخرين رؤيته)؛ استخدم --pin-env أو --pin-file"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "Package في بيان مجموعة الحزم من Type غير معروف"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "Package في بيان مجموعة الحزم بدون FileName أو Offset أو Size"

msgid "a ZIP entry does not inflate to its size"
msgstr "إدخال ZIP لا يُفك ضغطه إلى حجمه"

