msgid "Reset"
msgstr "மீட்டமை(&S)"

msgctxt "installer"
msgid "DiskCost"
msgstr "வட்டு(&D)"

msgctxt "installer"
msgid "DiskCostTitle"
msgstr "வட்டு இடம்"

msgctxt "installer"
msgid "DiskCostText"
msgstr "தேர்ந்தெடுத்த அம்சங்களுக்குத் தேவையான இடம் மற்றும் கிடைக்கும் இடம்."

msgctxt "installer"
msgid "ReadyTitle"
msgstr "நிறுவத் தயார்"

