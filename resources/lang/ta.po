msgstr "செயல் திரும்பப்பெறப்படுகிறது:"

msgctxt "installer"
msgid "Action.RollbackCleanup"
msgstr "காப்புக் கோப்புகள் அகற்றப்படுகின்றன"

msgctxt "installer"
msgid "Action.StartServices"
msgstr "சேவைகள் தொடங்கப்படுகின்றன"

msgctxt "installer"
msgid "Action.StopServices"
msgstr "சேவைகள் நிறுத்தப்படுகின்றன"

msgctxt "installer"
msgid "Action.UnpublishFeatures"
msgstr "தயாரிப்பு அம்சங்களின் வெளியீடு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.UnregisterClassInfo"
msgstr "வகுப்புச் சேவையகங்களின் பதிவு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.UnregisterExtensionInfo"
msgstr "நீட்டிப்புச் சேவையகங்களின் பதிவு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.UnregisterFonts"
msgstr "எழுத்துருக்களின் பதிவு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.UnregisterMIMEInfo"
msgstr "MIME தகவலின் பதிவு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.UnregisterProgIdInfo"
msgstr "நிரல் அடையாளங்காட்டிகளின் பதிவு நீக்கப்படுகிறது"

msgctxt "installer"
msgid "Action.WriteEnvironmentStrings"
msgstr "சூழல் சரங்கள் புதுப்பிக்கப்படுகின்றன"

msgctxt "installer"
msgid "Action.WriteIniValues"
msgstr "INI கோப்பு மதிப்புகள் எழுதப்படுகின்றன"

msgctxt "installer"
msgid "Action.WriteRegistryValues"
msgstr "கணினிப் பதிவேட்டு மதிப்புகள் எழுதப்படுகின்றன"

msgctxt "installer"
msgid "PerUserOnly"
msgstr "[ProductName] தற்போதைய பயனருக்கு மட்டுமே நிறுவப்படும் (MSIINSTALLPERUSER=1)."

msgctxt "installer"
msgid "NewerInstalled"
msgstr "[ProductName] இன் இதே அல்லது புதிய பதிப்பு ஏற்கெனவே நிறுவப்பட்டுள்ளது."

msgctxt "installer"
msgid "OlderRefused"
msgstr "இந்தத் தொகுப்பால் நிறுவப்பட்ட பழைய [ProductName] பதிப்பை மேம்படுத்த முடியாது. முதலில் அதை அகற்றவும், பிறகு இந்த அமைவை மீண்டும் இயக்கவும்:"

msgctxt "installer"
msgid "Details.FileCopy"
msgstr "கோப்பை நகலெடு"

msgctxt "installer"
msgid "Details.FileRemove"
msgstr "கோப்பை அகற்று"

msgctxt "installer"
msgid "Details.FilePatch"
msgstr "கோப்புக்கு இணைப்பு"

msgctxt "installer"
msgid "Details.FolderCreate"
msgstr "கோப்புறையை உருவாக்கு"

msgctxt "installer"
msgid "Details.FolderRemove"
msgstr "கோப்புறையை அகற்று"

msgctxt "installer"
msgid "Details.RegAddValue"
msgstr "பதிவேட்டு மதிப்பை எழுது"

msgctxt "installer"
msgid "Details.RegRemoveValue"
msgstr "பதிவேட்டு மதிப்பை அகற்று"

msgctxt "installer"
msgid "Details.RegRemoveKey"
msgstr "பதிவேட்டு விசையை அகற்று"

msgctxt "installer"
msgid "Details.ShortcutCreate"
msgstr "குறுக்குவழியை உருவாக்கு"

msgctxt "installer"
msgid "Details.ShortcutRemove"
msgstr "குறுக்குவழியை அகற்று"

msgctxt "installer"
msgid "Details.ServiceInstall"
msgstr "சேவையை நிறுவு"

msgctxt "installer"
msgid "Details.ServiceControl"
msgstr "சேவையைக் கட்டுப்படுத்து"

msgctxt "installer"
msgid "Details.IniWriteRemoveValue"
msgstr "INI மதிப்பை எழுது"

msgctxt "installer"
msgid "Details.UpdateEnvironmentStrings"
msgstr "சூழல் மாறியை அமை"

msgctxt "installer"
msgid "Details.RegisterFont"
msgstr "எழுத்துருவைப் பதிவுசெய்"

msgctxt "installer"
msgid "Details.UnregisterFont"
msgstr "எழுத்துருவின் பதிவை நீக்கு"

msgctxt "installer"
msgid "Details.CustomActionSchedule"
msgstr "செயலை இயக்கு"

msgctxt "installer"
msgid "Setup.Damaged"
msgstr "இந்த அமைவு நிரல் சேதமடைந்துள்ளது: அதை மீண்டும் பதிவிறக்கவும்."

msgctxt "installer"
msgid "Setup.Ask"
msgstr "இந்த நிரல்கள் ஏற்கெனவே நிறுவப்பட்டுள்ளன. என்ன செய்வது என்பதைத் தேர்வுசெய்யவும்."

msgctxt "installer"
msgid "Setup.Repair"
msgstr "சரிசெய்(&P)"

msgctxt "installer"
msgid "Setup.Remove"
msgstr "அகற்று(&R)"

msgctxt "installer"
msgid "Setup.Cancel"
msgstr "ரத்துசெய்"

msgctxt "installer"
msgid "Setup.RemoveAsk"
msgstr "இந்தக் கணினியிலிருந்து இந்த நிரல்களை அகற்றவா?"

msgctxt "installer"
msgid "Setup.Removed"
msgstr "நிரல்கள் அகற்றப்பட்டன."

msgctxt "installer"
msgid "Setup.RemoveFailed"
msgstr "ஒரு நிரலை அகற்ற முடியவில்லை."

msgctxt "installer"
msgid "Setup.TempFailed"
msgstr "அமைவு நிரலால் தற்காலிகக் கோப்புறையை உருவாக்க முடியவில்லை."

msgctxt "installer"
msgid "Setup.RepairFailed"
msgstr "{1} ஐச் சரிசெய்ய முடியவில்லை (பிழை {2})."

msgctxt "installer"
msgid "Setup.InstallFailed"
msgstr "{1} ஐ நிறுவ முடியவில்லை (பிழை {2}). அதற்குப் பிறகு எதுவும் நிறுவப்படவில்லை."

msgctxt "installer"
msgid "Setup.Repaired"
msgstr "நிரல்கள் சரிசெய்யப்பட்டன."

msgctxt "installer"
msgid "Setup.Finished"
msgstr "அமைவு முடிந்தது."

msgctxt "installer"
msgid "DirNotEmptyText"
msgstr "இந்தக் கோப்புறையில் ஏற்கெனவே கோப்புகள் அல்லது கோப்புறைகள் உள்ளன. [ProductName] அகற்றப்படும்போது கோப்புறையில் உள்ள அனைத்தும் நீக்கப்படும் - இப்போது உள்ளவையும் கூட. காலியான அல்லது புதிய கோப்புறை பாதுகாப்பான தேர்வு."

msgctxt "installer"
msgid "DirChoose"
msgstr "வேறு(&C)"

msgctxt "installer"
msgid "DirContinue"
msgstr "இதையே(&U)"

msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] நிரல்(கள்) [3] இன் கோப்புகளைப் பயன்படுத்துகின்றன:\r\n[2]\r\nஅனைத்தையும் மூடவா?\r\n\r\nஆம்: அனைத்தையும் மூடித் தொடர் (சேமிக்காத வேலை இழக்கப்படலாம்).\r\nஇல்லை: மூடாமல் தொடர் (ஏற்கெனவே திறந்திருக்கும் நிரல்கள் மீண்டும் திறக்கப்படும் வரை பழைய கோப்புகளை வைத்திருக்கும்).\r\nரத்துசெய்: நிறுத்து."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: நிறுத்தப்பட்டது, ஏனெனில் [1] நிரல்(கள்) அதன் கோப்புகளைப் பயன்படுத்துகின்றன:\r\n[2]அவற்றை மூடி மீண்டும் முயலவும், அல்லது RPCLOSE=yes (அனைத்தையும் மூடித் தொடர்) அல்லது RPCLOSE=no (மூடாமல் தொடர்) கொடுக்கவும்."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[3] இன் கோப்புறைகளில் உள்ள [1] உருப்படிகள் அதனுடன் நிறுவப்படவில்லை:\r\n[2]\r\nஅவற்றையும் நீக்கவா?\r\n\r\nஆம்: [3] உடன் அவற்றையும் நீக்கு (திரும்பப் பெற முடியாது).\r\nஇல்லை: [3] ஐ அகற்றி அவற்றை வைத்திரு.\r\nரத்துசெய்: நிறுத்து."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: நிறுத்தப்பட்டது, ஏனெனில் அதன் கோப்புறைகளில் உள்ள [1] உருப்படிகள் அதனுடன் நிறுவப்படவில்லை:\r\n[2]RPEXTRA=delete (அவற்றையும் நீக்கு) அல்லது RPEXTRA=keep (அவற்றை வைத்திரு) கொடுத்து மீண்டும் அகற்றவும்."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "இந்தக் கணினியின் மற்ற [1] பயனர்களிடம் [3] இன் அமைப்புகள் அல்லது தரவு இருக்கலாம்:\r\n[2]\r\nஅவர்களுடையதையும் நீக்கவா?\r\n\r\nஆம்: ஒவ்வொரு பயனருக்கும் நீக்கு (மீட்டெடுக்க முடியாது).\r\nஇல்லை: உங்களுடையதை மட்டும் நீக்கு.\r\nரத்துசெய்: நிறுத்து."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] ஏற்கெனவே இந்தக் கணினியில் Microsoft Store-இலிருந்து அல்லது பயன்பாட்டுத் தொகுப்பாக நிறுவப்பட்டுள்ளது ([2]). ஒரு நிரலின் இரண்டு நகல்களும் அதன் கோப்புகளைத் திறக்கும், இரண்டும் அதன் மெனுக்களைக் காட்டும்.\r\n\r\nஇதையும் நிறுவவா?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] ஏற்கெனவே இந்தக் கணினியில் Microsoft Store-இலிருந்து அல்லது பயன்பாட்டுத் தொகுப்பாக நிறுவப்பட்டுள்ளது ([2]). முதலில் அந்த நகலை அகற்றுங்கள் (அமைப்புகள் > பயன்பாடுகள்), பிறகு இதை நிறுவுங்கள்."

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "இந்தக் கணினியில் [1]-இன் வேறொரு நிறுவல் ஏற்கெனவே உள்ளது ([2]). ஒரு நிரலின் இரண்டு நகல்களும் அதன் கோப்புகளைத் திறக்கும், இரண்டும் அதன் மெனுக்களைக் காட்டும்.\r\n\r\nஇதையும் நிறுவவா?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "இந்தக் கணினியில் [1]-இன் வேறொரு நிறுவல் ஏற்கெனவே உள்ளது ([2]). முதலில் அதை அகற்றுங்கள் (அமைப்புகள் > பயன்பாடுகள்), பிறகு இதை நிறுவுங்கள்."

msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] நிறுவ முடியவில்லை, திரும்பப்பெறுதலும் எல்லாவற்றையும் அகற்றவில்லை. மீதமுள்ளவை கீழே உள்ளன. நிறுவியை மீண்டும் இயக்கி, வேண்டாம் எனில் [1] ஐ அகற்றுங்கள்.\r\nபதிவு: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] மேம்படுத்த முடியவில்லை, திரும்பப்பெறுதலும் உங்கள் முந்தைய பதிப்பை மீட்கவில்லை. வேறுபாடுகள் கீழே உள்ளன. அந்தப் பதிப்பின் நிறுவியால் சரிசெய்யுங்கள், அல்லது புதிய பதிப்பை மீண்டும் நிறுவுங்கள்.\r\nபதிவு: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] அகற்ற முடியவில்லை, திரும்பப்பெறுதலும் அதை முன்பிருந்தபடி மீட்கவில்லை. வேறுபாடுகள் கீழே உள்ளன. அதன் நிறுவியால் சரிசெய்து, மீண்டும் அகற்றுங்கள்.\r\nபதிவு: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] சரிசெய்ய முடியவில்லை, திரும்பப்பெறுதலும் அதை முன்பிருந்தபடி மீட்கவில்லை. வேறுபாடுகள் கீழே உள்ளன. சரிசெய்ய நிறுவியை மீண்டும் இயக்குங்கள்.\r\nபதிவு: [2]"
