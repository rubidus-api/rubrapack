msgstr "'{1}' mövcuddur və boş kataloq deyil; yenisinə çıxarın"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' {2}-ə gedir; və ya msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' oxunmayan xülasə məlumatı axınına malikdir"

