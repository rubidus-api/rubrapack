msgstr "'{1}' qovluqla başlayır: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' {4}-a malikdir; heç nə çıxarılmadı"

