msgstr "'{1}' çıxarmaq üçün Directory, Component, File və Media cədvəllərinə malik deyil"

msgid "'%s' has no readable summary information"
msgstr "'{1}' oxunaqlı xülasə məlumatına malik deyil"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' '{2}' transformasiyasına malik deyil"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' UTF-16-dır: edit yalnız UTF-8 mənbələri dəyişir (əvvəlcə onu UTF-8 kimi saxlayın)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' Windows adıdır; dəyişənə başqa ad verin"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' [chain]-dir: o, quraşdırma proqramı qurur, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' daxili çərçivənin idarəetmə elementidir; başqa ID seçin"

