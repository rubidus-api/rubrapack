msgid "usage: rubrapack explain [RPnnnn]"
msgstr "istifadə: rubrapack explain [RPnnnn]"

msgid "usage: rubrapack extract <file.msi|file.msix|file.msixbundle|file.cab|setup.exe> -d <new dir> [--limit-entries N] [--limit-bytes N]"
