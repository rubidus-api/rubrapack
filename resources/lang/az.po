# rubrapack language pack: Azerbaijani (Latin script).
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: az\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Azərbaycan dili\n"
"X-Rubrapack-LangIDs: 1068\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 4\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialoqlar {6}{7}\n  1 ad, istehsalçı, versiya, arxitektura        2 quraşdırma qovluğu, kim üçün\n  3 dialoqlar, lisenziya, dillər                 4 isteğe bağlı hissələr\n  5 qısayollar                                   6 fayllar: proqram qovluğuna uyğunlaşdır\n  7 istənilən açar                               v bax   l lint   s saxla   q çıx\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nBu kodlu mesajlar (* ad və ya dəyər yerinə durur):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nNəticələr stdout-a, diaqnostika stderr-ə gedir.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nNə etməli: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} yoxdur, amma bir qısayol onu açır: əvvəlcə qısayolları dəyişin (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  orada {1} fayl və {2} qovluq var\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s və ya q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] və [files.{2}] əlavə edildi\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] əlavə edildi\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  onu cədvəl.açar kimi verin, məsələn package.version və ya dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: problem yoxdur\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: yuxarıdakı problemlərə baxın (orada adı çəkilən fayl yoxlama nüsxəsidir)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages-dəki digər dillər saxlanılır; o siyahını 7 ilə dəyişin (istənilən açar)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] silindi\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}] silindi{2}\n"

msgid "  sub folders:"
msgstr "  alt qovluqlar:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  bu TOML alt dəstinə uyğun deyil; heç nə dəyişdirilmədi\n"

msgid "  that was not readable text; again, please\n"
msgstr "  bu oxunaqlı mətn deyildi; yenidən, xahiş edirik\n"

msgid "  the program folder '%s': %s\n"
msgstr "  proqram qovluğu '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  mənbədə qısayolun göstərə biləcəyi [file] cədvəlləri yoxdur\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  mənbədə `new`-un yazdığı kimi alt qovluqlar yoxdur ([files] \"<folder>/<name>/**\"); onları 6 ilə əlavə edin\n"

msgid "  too long; again, please\n"
msgstr "  çox uzundur; yenidən, xahiş edirik\n"

msgid "  y or n\n"
msgstr "  y və ya n\n"

msgid " (changed)"
msgstr " (dəyişdirildi)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) və MSIX (.msix) paketləri yaradır\n\nistifadə: rubrapack [--lang <code>] <command> [arguments]\n\nəmrlər:\n"

msgid " and its dir"
msgstr " və onun qovluğu"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) mühit dəyişəninə malik deyil, ona görə genişlənən dəyər onu saxlaya bilməz; sətir dəyərindən istifadə edin (quraşdırma zamanı doldurulur)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) {2}-dır: yolu başlada və ya Windows Installer-in doldurduğu dəyərin yerinə dura bilər (reyestr, mühit, INI, arqumentlər, mesajlar), amma burada yox"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) yolun başlaya biləcəyi qovluq deyil (dir ID və ya ProgramFiles, LOCALAPPDATA, ProgramData ... - təlimatdakı Yollar bölməsinə baxın){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktur:    {2}\n  həzm:        {3}\n  imza:        {4}\n  zəncir:      {5}{6}{7}\n  ləğv:        yoxlanılmayıb\n  vaxt möhürü: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: dəyişən təyin edilməyib"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' bu dialoqun idarəetmə elementi deyil"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' {3} daxilində yoxdur"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': lisenziya mətninə şriftin ingiliscə adı lazımdır, ona görə o dilin öz şriftində göstərilir; bu şrifti orada da istifadə etmək üçün ingiliscə adını yazın (məsələn, \"Malgun Gothic\")"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} komponent, amma paketin platforması {2}-dir"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} kind = \"{2}\" növünə aid deyil"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} kind = \"firewall\" növünə aid deyil"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID-ləri saxlayır (1..65535), məsələn 1041"

msgid "%s holds strings"
msgstr "{1} sətirləri saxlayır"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} 1-31 simvollu şrift adıdır, məsələn \"Segoe UI\" ({2} alındı)"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} bağlı dırnaqları və balanslı mötərizələri olan MSI şərtidir"

msgid "%s is an array of strings, one per value"
msgstr "{1} sətirlər massividir, hər dəyər üçün biri"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI paketləri üçündür: MSIX msiexec ilə silinmir"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} yoxdur. [file.{2}] silinsin?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 simvoldan uzundur"

msgid "%s is new. Add it?"
msgstr "{1} yenidir. Əlavə edilsin?"

msgid "%s is not a GUID in registry format"
msgstr "{1} reyestr formatında GUID deyil"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} bu rubrapack-in istifadə etdiyi kod deyil{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} bu paketin [file.*]-ını göstərən \"file:<ID>\" olmalıdır"

msgid "%s must be a GUID"
msgstr "{1} GUID olmalıdır"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} {{12345678-...} kimi GUID olmalıdır ('{2}' alındı)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} https://, http:// və ya file:// ünvanı, ya da \\\\server\\share yolu olmalıdır ('{2}' alındı)"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} upgrade-code-dan fərqli olmalıdır (hər arxitektura üçün bir təkmilləşdirmə ailəsi)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} üçün Windows {2} və ya daha yeni quruluş lazımdır: [msix] min-version = \"10.0.{3}.0\" təyin edin"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} üçün resources/bin/rubrapack_ca-{2}.dll lazımdır, bu rubrapack onsuz qurulub"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA yoxlanılmayıb (--tsa-trust verin)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA etibarlıdır"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA etibarsızdır - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} yoxdur və ya boşdur. [files.{3}] və [dir.{4}] silinsin?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ yeni qovluqdur. Əlavə edilsin?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: xətalar: {2}{-3}, xəbərdarlıqlar: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: xətalar: {2}{-3}, xəbərdarlıqlar: {4}{-5} ({6} ilə müqayisədə)\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} fayl, {3} bayt\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} fayl, {3} xəta, 0 xəbərdarlıq\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: daha {2} diaqnostika göstərilmədi\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: '{2}' faylı bu paketin [file.*]-ı deyil"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: '{2}' faylı proqram deyil (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' bağlanmayıb ('$(' mətni üçün '$$(' yazın)"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' artıq mövcuddur; olduğu kimi saxlanılır"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' artıq mövcuddur; onu silin və ya başqa qovluğa qurun"

