msgstr "'{1}' artıq {2} işləyicisinə malikdir ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' artıq icazələrə malikdir"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' və '{2}' paketdə eyni yoldur"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' Windows-a və ya brauzerlərə aiddir"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' '{2}' ilə müqayisədə oxuna bilmir: {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' TOML alt dəstinə uyğun deyil; heç nə saxlanılmadı"

msgid "'%s' exists already"
msgstr "'{1}' artıq mövcuddur"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' artıq mövcuddur; onu `rubrapack edit {2}` ilə dəyişin"

