msgstr "'{1}': {2} giriş, {3} limitindən çox (--limit-entries); heç nə çıxarılmadı"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' və '{3}' Windows-da eyni yol olardı; heç nə çıxarılmadı"

