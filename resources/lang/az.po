msgstr "[com.{1}]: app-id və typelib yalnız MSI üçün yazılır; MSIX sinfi onlarsız qeydiyyata alır"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args proqrama aiddir; DLL yüklənir, işə salınmır"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate DLL-i dllhost-da işlədir; '{2}' proqramdır"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading DLL üçündür; proqram öz apartamentini özü təyin edir"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version və typelib-file üçün typelib lazımdır"

