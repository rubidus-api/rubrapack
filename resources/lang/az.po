msgstr "[copy.{1}]: onun mənbəyi paketə daxil olan fayl olmalıdır"

msgid "[define] values must be strings"
msgstr "[define] dəyərləri sətir olmalıdır"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] üçün '{2}' lazımdır"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] üçün 'property' lazımdır"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] üçün 'text' lazımdır"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] üçün 'values' lazımdır"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}]-də {2} idarəetmə elementi var; ən çoxu 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}]-də [dialog-control.*] yoxdur"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] digər dialoqlar vasitəsilə özündən sonra yerləşdirilib"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] üçün ui = \"minimal\", \"installdir\" və ya \"features\" lazımdır"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' Windows adıdır; dir-ə başqa ID verin"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard üçün rubrapack-in köməkçi DLL-i lazımdır, birləşdirmə modulu onu daşımır"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] üçün xüsusiyyət lazımdır"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX bütün dəyişənlərini təyin edir (when); msi-only = true istifadə edin"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: onun dəyəri MSIX-in verə bilmədiyi yeri göstərir (paketdən kənar, Windows-a aid olmayan qovluq və ya quraşdırma zamanı hissə); msi-only = true istifadə edin"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] istifadəçi profilindədir və component-guid var: onun açar yolu fayl olaraq qalır, Windows qaydaları isə orada HKCU dəyəri istəyir (ICE38); onu almaq üçün component-guid-i çıxarın"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer {2} işləyicisini DLL-dən yükləyir; [com.{3}] proqramdır"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows xassə işləyicilərini yalnız kompüter üzrə oxuyur; paketə scope = \"machine\" lazımdır"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
