msgstr "'{1}' kompüter qovluğudur; {2} paketi ora yaza bilməz"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' birləşdirmə moduludur: onu [merge.ID] ilə birləşdirin"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' MSIX formatının özü üçün saxladığı addır"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' simvolik keçiddir; keçidlərə əməl edilmir"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' həm də [property.*]-dir"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' həm də dir ID-dir; dəyişənə başqa ad verin"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' bu paketin arxitekturası üçün deyil, 0x{2} maşını üçün qurulub; qəsdəndirsə any-arch = true təyin edin"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nə PE faylı (.exe, .dll), nə MSI paketi, nə də MSIX paketi və ya dəstidir"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' nə PE faylı, nə MSI paketi, nə də MSIX paketi və ya dəstidir"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' nə məlum qovluq, nə də dir ID-dir (məlum qovluqlar: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

