msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: berhenti, karena [1] item di foldernya tidak diinstal bersamanya:\r\n[2]Berikan RPEXTRA=delete (hapus juga) atau RPEXTRA=keep (pertahankan), lalu hapus lagi."

msgctxt "installer"
