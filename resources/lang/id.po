msgstr "[action.{1}] menjalankan satu hal: run (exe), dll (DLL terpasang) atau binary (DLL dalam paket); atau do dan undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} untuk satu tindakan, bukan untuk pasangan do/undo"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: tindakan tertunda yang menjalankan berkas terpasang harus setelah InstallFiles (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: tindakan langsung berjalan sebagai pengguna yang memasang; as untuk fase lain"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args milik program; DLL mendapat data"

