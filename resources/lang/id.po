msgstr "[action.{1}]: check ikut dengan pasangan do/undo"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data untuk tindakan tertunda, commit atau rollback (yang langsung membaca properti)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry adalah fungsi DLL; run mengambil args"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args untuk MSIX harus berupa teks biasa (tanpa [...] yang diisi saat instalasi)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: di MSIX jenis file membuka aplikasi: target harus berupa executable [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] ada dua kali"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] memerlukan ID: tulis [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id dan typelib hanya ditulis untuk MSI; MSIX mendaftarkan kelas tanpa keduanya"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args milik program; DLL dimuat, tidak dijalankan"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate menjalankan DLL di dllhost; '{2}' adalah program"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading untuk DLL; program menetapkan apartment-nya sendiri"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version dan typelib-file memerlukan typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] masuk ke {2}; atau msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: sumbernya harus file yang masuk ke paket"

msgid "[define] values must be strings"
msgstr "Nilai [define] harus berupa string"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] memerlukan '{2}'"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] memerlukan image"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] memerlukan 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] memerlukan 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] memerlukan 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] memiliki {2} kontrol; paling banyak 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] tidak memiliki [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] ditempatkan setelah dirinya sendiri melalui dialog lain"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] memerlukan ui = \"minimal\", \"installdir\" atau \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' adalah nama Windows; beri dir ID lain"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard memerlukan DLL pembantu rubrapack, yang tidak dibawa modul gabungan"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] memerlukan fitur"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX mengatur semua variabelnya (when); gunakan msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: nilainya menyebut tempat yang tidak dapat diberikan MSIX (folder di luar paket yang bukan folder Windows, atau bagian waktu instalasi); gunakan msi-only = true"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: dengan external-location = true paket tidak membawa file program apa pun, jadi juga tidak membawa peluncur rubrapack; atau msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] sudah ada di folder programnya; isolate-for untuk DLL bersama yang dipasang di tempat lain"

msgid "[file.%s] is in the user's profile and has component-guid: its key path stays the file, where Windows' rules want an HKCU value (ICE38); leave component-guid out to get one"
msgstr "[file.{1}] berada di profil pengguna dan memiliki component-guid: jalur kuncinya tetap berkas tersebut, sedangkan aturan Windows menghendaki nilai HKCU di sana (ICE38); hapus component-guid untuk mendapatkannya"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer memuat handler {2} dari DLL; [com.{3}] adalah program"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows membaca handler properti hanya per mesin; paket memerlukan scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: handler pratinjau berjalan di prevhost Windows; jangan cantumkan app-id dan surrogate di [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX hanya membawa handler thumbnail dan pratinjau (handler properti dalam paket tidak memberi nilai ke Explorer); msi-only = true mempertahankannya untuk MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: jenis file MSIX milik aplikasi; tambahkan [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: kelas {2} bukan [com.*] dari paket ini (DLL handler yang melayaninya)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: di MSIX handler berbagi semua jenisnya atau tidak sama sekali (satu jenis ada dalam satu asosiasi jenis file)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: di MSIX kelasnya berjalan dalam surrogate; threading = \"sta\" di [com.{2}] memberi jendelanya loop pesan (dengan threading = {3} pratinjau bisa tetap kosong)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: di MSIX semua jenisnya ada dalam satu jenis file [assoc], atau tidak ada"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: kelasnya msi-only ([com.{2}]); MSIX tidak akan memiliki server untuknya"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types adalah daftar jenis file, seperti [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] masuk ke {2}; atau msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] memerlukan 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] memerlukan fitur: atur 'feature' di sini atau di dir-nya"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX menulis semua entri INI-nya (when); gunakan msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: nilainya memiliki bagian yang diisi Windows Installer saat instalasi ([...]); MSIX menulis file saat dibangun"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] memerlukan 'on': tempat item muncul, seperti [\".txt\"] atau \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] memerlukan 'target' (program yang dijalankannya), atau item dengan parent = \"{2}\" (submenu)"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] memerlukan 'target': program yang dijalankan item"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: menu Windows 11 hanya menerima ID dari huruf dan angka (tanpa '_'): ganti namanya, atau windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: submenu tidak menjalankan apa pun: hilangkan 'args'"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: item submenu muncul di tempat submenunya muncul: hilangkan 'on'"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args memiliki bagian yang diisi Windows Installer saat instalasi ([...]); MSIX hanya memuat teks tetap"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when adalah \"HKCU\\\\key\\\\value\" atau \"HKLM\\\\...\", pada item menu Windows 11 yang tidak berada di submenu"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
