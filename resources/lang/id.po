# rubrapack language pack: Indonesian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: id\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Bahasa Indonesia\n"
"X-Rubrapack-LangIDs: 1057\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 2\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialog {6}{7}\n  1 nama, produsen, versi, arsitektur            2 folder instalasi, untuk siapa diinstal\n  3 dialog, lisensi, bahasa                      4 bagian opsional\n  5 pintasan                                     6 file: samakan dengan folder program\n  7 kunci apa pun                                v lihat   l lint   s simpan   q keluar\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nPesan dengan kode ini (* mewakili nama atau nilai):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nHasil dikirim ke stdout, diagnostik ke stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nYang harus dilakukan: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} sudah tidak ada, tetapi ada pintasan yang membukanya: ubah pintasan (5) terlebih dahulu\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} file dan {2} folder di sana\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s atau q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  menambahkan [dir.{1}] dan [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  menambahkan [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  tulis sebagai table.key, misalnya package.version atau dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: tidak ada masalah\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: lihat masalah di atas (file yang disebut di sana adalah salinan untuk pemeriksaan)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  bahasa lain di [ui] languages tetap dipertahankan; ubah daftar itu dengan 7 (kunci apa pun)\n"

msgid "  removed [file.%s]\n"
msgstr "  menghapus [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  menghapus [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  subfolder:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  itu tidak sesuai dengan subset TOML; tidak ada yang diubah\n"

msgid "  that was not readable text; again, please\n"
msgstr "  itu bukan teks yang dapat dibaca; silakan ulangi\n"

msgid "  the program folder '%s': %s\n"
msgstr "  folder program '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  sumber tidak memiliki tabel [file] untuk dituju pintasan\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  sumber tidak memiliki subfolder seperti yang ditulis `new` ([files] \"<folder>/<name>/**\"); tambahkan dengan 6\n"

msgid "  too long; again, please\n"
msgstr "  terlalu panjang; silakan ulangi\n"

msgid "  y or n\n"
msgstr "  y atau n\n"

msgid " (changed)"
msgstr " (diubah)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - membuat paket Windows Installer (.msi) dan MSIX (.msix)\n\npenggunaan: rubrapack [--lang <code>] <command> [arguments]\n\nperintah:\n"

msgid " and its dir"
msgstr " dan dir-nya"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) tidak memiliki variabel lingkungan, jadi nilai yang dapat diperluas tidak bisa memuatnya; gunakan nilai string (diisi saat instalasi)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) adalah {2}: dapat mengawali jalur, atau menggantikan nilai yang diisi Windows Installer (registri, lingkungan, INI, argumen, pesan), bukan di sini"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) bukan folder awal jalur (ID dir, atau ProgramFiles, LOCALAPPDATA, ProgramData ... - lihat Paths di manual){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktur:     {2}\n  digest:       {3}\n  tanda tangan: {4}\n  rantai:       {5}{6}{7}\n  pencabutan:   tidak diperiksa\n  stempel waktu: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: variabel tidak diatur"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' bukan kontrol dialog ini"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' tidak ada di {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': teks lisensi memerlukan nama font dalam bahasa Inggris, jadi ditampilkan dengan font bahasa itu sendiri; tulis nama bahasa Inggrisnya (seperti \"Malgun Gothic\") agar font ini juga dipakai di sana"

msgid "%s component, but the package platform is %.*s"
msgstr "komponen {1}, tetapi platform paket adalah {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} bukan bagian dari kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} bukan bagian dari kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} berisi LANGID (1..65535), seperti 1041"

msgid "%s holds strings"
msgstr "{1} berisi string"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} adalah daftar teks \"Kunci=Nilai\""

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} adalah daftar teks, seperti [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} adalah nama font 1 sampai 31 karakter, seperti \"Segoe UI\" (didapat {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} adalah kondisi MSI dengan tanda kutip tertutup dan tanda kurung seimbang"

msgid "%s is an array of strings, one per value"
msgstr "{1} adalah array string, satu per nilai"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} untuk paket MSI: MSIX tidak dihapus oleh msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} sudah tidak ada. Hapus [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} lebih panjang dari 240 karakter"

msgid "%s is new. Add it?"
msgstr "{1} baru. Tambahkan?"

msgid "%s is not a GUID in registry format"
msgstr "{1} bukan GUID dalam format registri"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} bukan kode yang digunakan rubrapack ini{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} harus berupa \"file:<ID>\" yang menyebut [file.*] dari paket ini"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} harus terdiri atas {2} sampai {3} huruf, angka, '.' atau '-', tidak diawali '.' (didapat '{4}')"

msgid "%s must be a GUID"
msgstr "{1} harus berupa GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} harus berupa GUID seperti {{12345678-...} (didapat '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} harus berupa alamat https://, http:// atau file://, atau jalur \\\\server\\share (didapat '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} harus berbeda dari upgrade-code (satu keluarga peningkatan per arsitektur)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} memerlukan Windows build {2} atau lebih baru: atur [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} memerlukan resources/bin/rubrapack_ca-{2}.dll, yang tidak disertakan saat rubrapack ini dibangun"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA tidak diperiksa (berikan --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA tepercaya"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA tidak tepercaya - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} sudah tidak ada atau kosong. Hapus [files.{3}] dan [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ adalah folder baru. Tambahkan?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} kesalahan{-3}, {4} peringatan{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} kesalahan{-3}, {4} peringatan{-5} (terhadap {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} file, {3} byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} file, {3} kesalahan, 0 peringatan\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} diagnostik lagi tidak ditampilkan\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' bukan tindakan standar yang ditempatkan rubrapack"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: file '{2}' bukan [file.*] dari paket ini"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: file '{2}' bukan program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' tidak ditutup (tulis '$$(' untuk teks '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' sudah ada; dibiarkan apa adanya"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' sudah ada; hapus atau bangun ke folder lain"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' sudah memiliki handler {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' sudah memiliki izin"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' dan '{2}' adalah jalur yang sama dalam paket"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' milik Windows atau browser"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' tidak dapat dibaca terhadap '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' tidak sesuai dengan subset TOML; tidak ada yang disimpan"

msgid "'%s' exists already"
msgstr "'{1}' sudah ada"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' sudah ada; ubah dengan `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' ada dan bukan direktori kosong; ekstrak ke direktori baru"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' masuk ke {2}; atau msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' memiliki aliran informasi ringkasan yang tidak dapat dibaca"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' tidak memiliki tabel Directory, Component, File dan Media untuk diekstrak"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' tidak memiliki transformasi tertanam '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' tidak memiliki informasi ringkasan yang dapat dibaca"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' tidak memiliki transform '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' adalah UTF-16: edit hanya mengubah sumber UTF-8 (simpan sebagai UTF-8 terlebih dahulu)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' adalah nama Windows; beri variabel nama lain"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' adalah [chain]: membangun program setup, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' adalah kontrol bingkai bawaan; pilih ID lain"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' adalah folder mesin; paket {2} tidak dapat menulis di sana"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' adalah modul gabungan: gabungkan dengan [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' adalah nama yang dicadangkan format MSIX untuk dirinya"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' adalah tautan simbolik; tautan tidak diikuti"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' juga merupakan [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' juga ID dir; beri variabel nama lain"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' dibangun untuk mesin 0x{2}, bukan arsitektur paket ini; atur any-arch = true jika memang disengaja"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' bukan file PE (.exe, .dll), paket MSI, maupun paket atau bundel MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' bukan file PE, paket MSI, maupun paket atau bundel MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' bukan folder yang dikenal maupun ID dir (folder yang dikenal: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' bukan cabinet yang dapat dibaca rubrapack (stored atau MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' bukan kode diagnostik (RP dan empat digit, seperti RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' bukan program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' bukan file biasa"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' bukan program setup rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' bukan ID yang valid (huruf, digit dan '_', tidak diawali digit, paling banyak {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' bukan basis data MSI yang valid: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' bukan paket MSIX yang valid: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' bukan paket yang valid: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' bukan sumber yang valid (subset TOML); perbaiki secara manual terlebih dahulu"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' bukan transform yang valid: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' bukan nama variabel yang valid"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' dicadangkan dan tidak dapat digunakan sebagai ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' adalah nama dir: hanya pencarian registri atau dir yang dapat mengisi dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' tampak seperti file program (PE) tetapi header atau sumber dayanya rusak"

msgid "'%s' must be a string"
msgstr "'{1}' harus berupa string"

msgid "'%s' must be an integer"
msgstr "'{1}' harus berupa bilangan bulat"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' harus antara {2} dan {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' harus true atau false"

msgid "'%s' must not be empty"
msgstr "'{1}' tidak boleh kosong"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' tidak menyebut transform (properti ringkasan 8): bukan patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' diawali folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' memiliki {4}; tidak ada yang diekstrak"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} entri, lebih dari batas {3} (--limit-entries); tidak ada yang diekstrak"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' dan '{3}' akan menjadi jalur yang sama di Windows; tidak ada yang diekstrak"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' tidak ada di [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': sebuah tabel tidak dapat dibaca"

msgid "'%s': a table is unreadable"
msgstr "'{1}': sebuah tabel tidak terbaca"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX menginstal semua filenya (when); gunakan msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX menghapus semua filenya (keep); gunakan msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' rusak atau bukan stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': nama cabinet '{2}' bukan nama file biasa"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': file terkompresi '{2}' (urutan {3}) tidak memiliki cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': direktori '{2}' memiliki induk '{3}' yang tidak ada"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': direktori '{2}' adalah leluhurnya sendiri atau bersarang terlalu dalam"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': file '{2}' tidak cocok dengan MsiFileHash-nya"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': file '{2}' tidak memiliki komponen atau direktori"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': file '{2}' berukuran {3} byte, tabel File menyebut {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': file '{2}' tidak ada di cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': cabinet eksternalnya tidak dicakup tanda tangan (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': foldernya tidak mengarah ke lokasi yang dikenal"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': lebih dari {2} byte untuk ditulis (--limit-bytes); tidak ada yang diekstrak"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': tanpa --timestamp: tanda tangan tidak lagi valid saat sertifikat kedaluwarsa"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': paket '{2}' tidak cocok dengan SHA-256-nya"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': aliran cabinet '{2}' tidak ada"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifest tidak memiliki {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifest menyebut '{2}', yang tidak ada dalam paket"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': stempel waktu dari {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transform '{2}' tidak dapat dibaca terhadap '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' adalah bahasa paket itu sendiri ({2}); berikan teks itu tanpa akhiran"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' membuat Windows Installer menulis multi-string; gunakan type = \"multi\" dan array"

msgid "'_' in numbers is not supported"
msgstr "'_' dalam angka tidak didukung"

msgid "'help' takes at most one command name"
msgstr "'help' menerima paling banyak satu nama perintah"

msgid "'version' takes no arguments"
msgstr "'version' tidak menerima argumen"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs untuk .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch untuk bundel: daftar x64, x86 dan arm64, masing-masing sekali (didapat '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle output"
msgstr "--arch menerima satu arsitektur, atau daftar untuk output .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp dan --allow-unsigned-cabs digunakan bersama --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress untuk .msi; MSIX menerima --msix-compress deflate|store"

