msgstr "Versi dan peningkatan"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer mengizinkan paling tinggi 255.255.65535(.65535)"

msgid "Windows name"
msgstr "nama Windows"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] memerlukan '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] tidak dapat masuk ke modul gabungan; paket yang menggabungkannya yang memilikinya"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] belum didukung (direncanakan untuk {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] tidak dapat masuk ke MSIX; tambahkan msi-only = true untuk membangun MSIX tanpanya"

msgid "[%s.%s] is in the user's AppData or LocalAppData: a dual package installed for all users puts it in the installing user's profile only"
msgstr "[{1}.{2}] berada di AppData atau LocalAppData pengguna: paket dual yang dipasang untuk semua pengguna hanya menaruhnya di profil pengguna yang memasang"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID dalam modul gabungan paling banyak 35 karakter (GUID modul ditambahkan)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] memerlukan ID: tulis [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] tidak menerima ID: tulis [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml tidak memiliki </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml bukan entri terakhir (bukan paket yang ditulis rubrapack atau API pengemasan Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Array tabel [[...]] tidak didukung; beri setiap item [kind.ID] sendiri"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] ditempatkan sekali: before, after atau sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] memerlukan do dan undo (undo juga membatalkan do yang gagal)"

