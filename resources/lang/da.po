msgid "write a transform (.mst): what turns one package into the other"
msgstr "skriv en transformation (.mst): det, der gør den ene pakke til den anden"

msgid "write the table or value the plain way the manual shows"
msgstr "skriv tabellen eller værdien på den enkle måde, manualen viser"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "skriv værdien uden '[~]'; mode = \"append\" eller \"prepend\" tilføjer den"

