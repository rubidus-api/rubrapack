msgstr "værdier: ID'er, GUID'er, versioner, tal uden for interval, henvisninger til ting, der ikke findes"

msgid "variable '%s' is not defined ([define] or -D %s=...)%s"
msgstr "variablen '{1}' er ikke defineret ([define] eller -D {2}=...){3}"

msgid "variable name '%s' may not contain '=' or start with = + - ! *"
msgstr "variabelnavnet '{1}' må ikke indeholde '=' eller begynde med = + - ! *"

msgid "variables"
msgstr "variabler"

msgid "variables: $(NAME) without a value, $( not closed, a Windows name or dir ID where it cannot stand"
msgstr "variabler: $(NAVN) uden værdi, $( ikke lukket, et Windows-navn eller dir-ID, hvor det ikke kan stå"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "versionen '{1}' skal være a.b.c eller a.b.c.d"

msgid "version '%s' must be a.b.c or a.b.c.d with a, b <= 255 and c, d <= 65535"
msgstr "versionen '{1}' skal være a.b.c eller a.b.c.d med a, b <= 255 og c, d <= 65535"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\" kan ikke følge 'with' en fil i en 64-bit-pakke"

msgid "view must be \"32\" or \"64\""
msgstr "view skal være \"32\" eller \"64\""

msgid "warning"
msgstr "advarsel"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "hvad en diagnosekode betyder, meddelelserne, der bærer den, hvad du skal gøre, og hvor manualen siger mere"

msgid "with must be \"file:<ID>\""
msgstr "with skal være \"file:<ID>\""

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: filen '{1}' er ikke en [file.*] i denne pakke"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "uden --pkcs11 viser `keys list` Windows-certifikatlageret"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' er ikke et dir-ID"

msgid "write a patch (.msp): the files and rows that update an installed base to the target"
msgstr "skriv en patch (.msp): filerne og rækkerne, der opdaterer en installeret base til målet"

msgid "write a source file (.toml; .rpk names too): made from answers, asked or given as options, a fixed starter, or an existing MSI"
