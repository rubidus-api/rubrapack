# rubrapack language pack: Danish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: da\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Dansk\n"
"X-Rubrapack-LangIDs: 1030\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 7\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, dialogbokse {6}{7}\n  1 navn, producent, version, arkitektur        2 installationsmappe, hvem den installeres for\n  3 dialogbokse, licens, sprog                  4 valgfrie dele\n  5 genveje                                     6 filer: tilpas til programmappen\n  7 vilkårlig nøgle                             v vis   l lint   s gem   q afslut\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nMeddelelser med denne kode (* står for et navn eller en værdi):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nResultater går til stdout, diagnostik til stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nHvad du skal gøre: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} findes ikke længere, men en genvej åbner den: ret genvejene (5) først\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  der er {1} filer og {2} mapper\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s eller q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  tilføjede [dir.{1}] og [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  tilføjede [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  angiv det som tabel.nøgle, f.eks. package.version eller dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: ingen problemer\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: se problemerne ovenfor (filen, der nævnes dér, er en kontrolkopi)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  andre sprog i [ui] languages bevares; ret listen med 7 (vilkårlig nøgle)\n"

msgid "  removed [file.%s]\n"
msgstr "  fjernede [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  fjernede [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  undermapper:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  det passer ikke i TOML-delmængden; intet blev ændret\n"

msgid "  that was not readable text; again, please\n"
msgstr "  det var ikke læsbar tekst; prøv igen\n"

msgid "  the program folder '%s': %s\n"
msgstr "  programmappen '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  kilden har ingen [file]-tabeller, som en genvej kan pege på\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  kilden har ingen undermapper, som `new` skriver dem ([files] \"<folder>/<name>/**\"); tilføj dem med 6\n"

msgid "  too long; again, please\n"
msgstr "  for langt; prøv igen\n"

msgid "  y or n\n"
msgstr "  y eller n\n"

msgid " (changed)"
msgstr " (ændret)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - bygger Windows Installer- (.msi) og MSIX-pakker (.msix)\n\nbrug: rubrapack [--lang <code>] <command> [arguments]\n\nkommandoer:\n"

msgid " and its dir"
msgstr " og dens dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) har ingen miljøvariabel, så en udvidelig værdi kan ikke indeholde den; brug en strengværdi (udfyldes ved installationen)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) er en {2}: den kan indlede en sti eller stå for en værdi, som Windows Installer udfylder (registreringsdatabase, miljø, INI, argumenter, meddelelser), men ikke her"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) er ikke en mappe, som en sti kan begynde fra (et dir-ID, eller ProgramFiles, LOCALAPPDATA, ProgramData ... - se Paths i manualen){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  struktur:     {2}\n  digest:       {3}\n  signatur:     {4}\n  kæde:         {5}{6}{7}\n  tilbagekald.: ikke kontrolleret\n  tidsstempel:  {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: variablen er ikke sat"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' er ikke et kontrolelement i denne dialogboks"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' er ikke i {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': licensteksten skal bruge skrifttypens engelske navn og vises derfor i sprogets egen skrifttype; skriv det engelske navn (f.eks. \"Malgun Gothic\") for også at bruge skrifttypen dér"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' skal være en mappe"

msgid "%s component, but the package platform is %.*s"
msgstr "{1}-komponent, men pakkens platform er {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} hører ikke til kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} hører ikke til kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} indeholder LANGID'er (1..65535), f.eks. 1041"

msgid "%s holds strings"
msgstr "{1} indeholder strenge"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1} er en liste med \"Nøgle=Værdi\"-tekster"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} er en liste af tekster, f.eks. [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} er et skrifttypenavn på 1 til 31 tegn, f.eks. \"Segoe UI\" (fik {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} er en MSI-betingelse med lukkede anførselstegn og afbalancerede parenteser"

msgid "%s is an array of strings, one per value"
msgstr "{1} er en matrix af strenge, én pr. værdi"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} gælder MSI-pakker: en MSIX fjernes ikke af msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} findes ikke længere. Fjern [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} er længere end 240 tegn"

msgid "%s is new. Add it?"
msgstr "{1} er ny. Tilføj den?"

msgid "%s is not a GUID in registry format"
msgstr "{1} er ikke et GUID i registreringsdatabaseformat"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} er ikke en kode, som denne rubrapack bruger{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} skal være \"file:<ID>\", der navngiver en [file.*] i denne pakke"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} skal være {2} til {3} bogstaver, cifre, '.' eller '-' og må ikke starte med '.' (fik '{4}')"

msgid "%s must be a GUID"
msgstr "{1} skal være et GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} skal være et GUID som {12345678-...} (fik '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} skal være en https://-, http://- eller file://-adresse eller en \\\\server\\share-sti (fik '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} skal være forskellig fra upgrade-code (én opgraderingsfamilie pr. arkitektur)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} kræver Windows-build {2} eller nyere: angiv [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} kræver resources/bin/rubrapack_ca-{2}.dll, som denne rubrapack blev bygget uden"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA ikke kontrolleret (angiv --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA betroet"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA ikke betroet - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} findes ikke længere eller er tom. Fjern [files.{3}] og [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ er en ny mappe. Tilføj den?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} fejl{-3}, {4} advarsel/advarsler{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: {2} fejl{-3}, {4} advarsel/advarsler{-5} (i forhold til {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} filer, {3} byte\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} filer, {3} fejl, 0 advarsler\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: yderligere {2} diagnoser vises ikke\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}' er ikke en standardhandling, som rubrapack placerer"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: filen '{2}' er ikke en [file.*] i denne pakke"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: filen '{2}' er ikke et program (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' er ikke lukket (skriv '$$(' for teksten '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' findes allerede; den forbliver, som den er"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' findes allerede; fjern den, eller byg i en anden mappe"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' har allerede en {2}-handler ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' har allerede tilladelser"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' og '{2}' er den samme sti i pakken"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' tilhører Windows eller browserne"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' kan ikke læses i forhold til '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' passer ikke i TOML-delmængden; intet blev gemt"

msgid "'%s' exists already"
msgstr "'{1}' findes allerede"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' findes allerede; ret den med `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' findes og er ikke en tom mappe; udpak til en ny"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' havner i {2}; eller msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' har en ulæselig strøm med oversigtsoplysninger"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' har ingen Directory-, Component-, File- og Media-tabeller at udpakke fra"

msgid "'%s' has no embedded transform '%s'"
msgstr "'{1}' har ingen integreret transformation '{2}'"

msgid "'%s' has no readable summary information"
msgstr "'{1}' har ingen læselige oversigtsoplysninger"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' har ingen transformation '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' er UTF-16: edit ændrer kun UTF-8-kilder (gem den som UTF-8 først)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' er et Windows-navn; giv variablen et andet navn"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' er en [chain]: den bygger et installationsprogram, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' er et kontrolelement i den indbyggede ramme; vælg et andet ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' er en computermappe; en {2}-pakke kan ikke skrive der"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' er et fletningsmodul: flet det med [merge.ID] i stedet"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' er et navn, som MSIX-formatet forbeholder sig selv"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' er et symbolsk link; links følges ikke"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' er også en [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' er også et dir-ID; giv variablen et andet navn"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' er bygget til maskine 0x{2}, ikke til denne pakkes arch; angiv any-arch = true, hvis det er meningen"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' er hverken en PE-fil (.exe, .dll), en MSI-pakke eller en MSIX-pakke eller -samling"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' er hverken en PE-fil, en MSI-pakke eller en MSIX-pakke eller -samling"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' er hverken en kendt mappe eller et dir-ID (kendte mapper: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' er ikke en cabinet, som rubrapack kan læse (stored eller MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' er ikke en diagnosekode (RP og fire cifre, f.eks. RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' er ikke et program (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' er ikke en almindelig fil"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' er ikke et installationsprogram fra rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' er ikke et gyldigt ID (bogstaver, cifre og '_', begynder ikke med et ciffer, højst {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' er ikke en gyldig MSI-database: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' er ikke en gyldig MSIX-pakke: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' er ikke en gyldig pakke: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' er ikke en gyldig kilde (TOML-delmængden); ret den i hånden først"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' er ikke en gyldig transformation: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' er ikke et gyldigt variabelnavn"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' er reserveret og kan ikke bruges som ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' er navnet på en dir: kun en registreringsdatabase- eller dir-søgning kan udfylde en dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' ligner en programfil (PE), men dens headere eller ressourcer er beskadigede"

msgid "'%s' must be a string"
msgstr "'{1}' skal være en streng"

msgid "'%s' must be an integer"
msgstr "'{1}' skal være et heltal"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' skal være mellem {2} og {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' skal være true eller false"

msgid "'%s' must not be empty"
msgstr "'{1}' må ikke være tom"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' navngiver ingen transformationer (oversigtsegenskab 8): ikke en patch"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' begynder med en mappe: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' har {4}; intet blev udpakket"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} poster, flere end grænsen {3} (--limit-entries); intet blev udpakket"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' og '{3}' ville være den samme sti i Windows; intet blev udpakket"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' er ikke i [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': en tabel kan ikke læses"

msgid "'%s': a table is unreadable"
msgstr "'{1}': en tabel er ulæselig"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': en MSIX installerer alle sine filer (when); brug msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': en MSIX fjerner alle sine filer (keep); brug msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' er beskadiget eller ikke stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': cabinetnavnet '{2}' er ikke et simpelt filnavn"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': komprimeret fil '{2}' (sekvens {3}) har ingen cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': mappen '{2}' har en overordnet '{3}', som ikke findes"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': mappen '{2}' er sin egen forfader eller indlejret for dybt"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': filen '{2}' passer ikke med sin MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': filen '{2}' har ingen komponent eller mappe"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': filen '{2}' er {3} byte, File-tabellen siger {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': filen '{2}' er ikke i cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': dens eksterne cabinets er ikke dækket af signaturen (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': dens mappe fører ikke til en kendt placering"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': mere end {2} byte at skrive (--limit-bytes); intet blev udpakket"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': ingen --timestamp: signaturen holder op med at være gyldig, når certifikatet udløber"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': pakken '{2}' passer ikke med sin SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': cabinetstrømmen '{2}' findes ikke"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': manifestet har ingen {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': manifestet nævner '{2}', som ikke er i pakken"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': tidsstempel fra {2}: {3}"

msgid "'%s': transform '%.*s' cannot be read against '%s': %s"
msgstr "'{1}': transformationen '{2}' kan ikke læses i forhold til '{3}': {4}"

msgid "'-%s' is the package's own language (%s); give that text without the suffix"
msgstr "'-{1}' er pakkens eget sprog ({2}); angiv den tekst uden suffikset"

msgid "'[~]' makes Windows Installer write a multi-string; use type = \"multi\" and an array"
msgstr "'[~]' får Windows Installer til at skrive en multistreng; brug type = \"multi\" og en matrix"

msgid "'_' in numbers is not supported"
msgstr "'_' i tal understøttes ikke"

msgid "'help' takes at most one command name"
msgstr "'help' tager højst ét kommandonavn"

msgid "'version' takes no arguments"
msgstr "'version' tager ingen argumenter"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs gælder .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch for en samling: en liste med x64, x86 og arm64, hver én gang (fik '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch tager én arkitektur, eller en liste til et .msixbundle / .msixupload-output"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp og --allow-unsigned-cabs hører til --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress gælder .msi; en MSIX tager --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist navngiver en ny mappe ved siden af kilden (ingen sti)"

