msgstr "bruges af mere end én komponent"

msgid "users must be \"all\" (got '%s')"
msgstr "users skal være \"all\" (fik '{1}')"

msgid "value '%s' is listed twice"
msgstr "værdien '{1}' står to gange på listen"

msgid "value missing"
msgstr "værdi mangler"

msgid "values and labels are strings"
msgstr "values og labels er strenge"

msgid "values is an array of 1 to 32 strings"
msgstr "values er en matrix af 1 til 32 strenge"

