msgctxt "installer"
msgid "PreflightAsk"
msgstr "[1] program(mer) bruger filer fra [3]:\r\n[2]\r\nVil du lukke dem alle?\r\n\r\nJa: luk dem alle, og fortsæt (ikke-gemt arbejde kan gå tabt).\r\nNej: fortsæt uden at lukke (programmer, der allerede er åbne, beholder de gamle filer, indtil de åbnes igen).\r\nAnnuller: stop."

msgctxt "installer"
msgid "PreflightSilent"
msgstr "[3]: standset, fordi [1] program(mer) bruger dets filer:\r\n[2]Luk dem, og prøv igen, eller angiv RPCLOSE=yes (luk alle, og fortsæt) eller RPCLOSE=no (fortsæt uden at lukke)."

msgctxt "installer"
msgid "PreflightExtra"
msgstr "[1] element i mapperne for [3] blev ikke installeret med det:\r\n[2]\r\nVil du også slette dem?\r\n\r\nJa: slet dem sammen med [3] (de kan ikke gendannes).\r\nNej: fjern [3], og behold dem.\r\nAnnuller: stop."

msgctxt "installer"
msgid "PreflightExtraSilent"
msgstr "[3]: standset, fordi [1] element i dets mapper ikke blev installeret med det:\r\n[2]Angiv RPEXTRA=delete (slet også dem) eller RPEXTRA=keep (behold dem), og fjern det igen."

msgctxt "installer"
msgid "PreflightUsers"
msgstr "[1] andre brugere af denne computer kan have indstillinger eller data fra [3]:\r\n[2]\r\nSkal deres også slettes?\r\n\r\nJa: slet dem for alle brugere (de kan ikke gendannes).\r\nNej: slet kun dine.\r\nAnnuller: stop."

msgctxt "installer"
msgid "PreflightOtherStore"
msgstr "[1] er allerede installeret på computeren fra Microsoft Store eller som app-pakke ([2]). To kopier af et program åbner begge dets filer og viser begge dets menuer.\r\n\r\nInstallere også denne?"

msgctxt "installer"
msgid "PreflightOtherStoreRefuse"
msgstr "[1] er allerede installeret på computeren fra Microsoft Store eller som app-pakke ([2]). Fjern først den kopi (Indstillinger > Apps), og installer så denne."

msgctxt "installer"
msgid "PreflightOtherMsi"
msgstr "Der er allerede en anden installation af [1] på computeren ([2]). To kopier af et program åbner begge dets filer og viser begge dets menuer.\r\n\r\nInstallere også denne?"

msgctxt "installer"
msgid "PreflightOtherMsiRefuse"
msgstr "Der er allerede en anden installation af [1] på computeren ([2]). Fjern den først (Indstillinger > Apps), og installer så denne."

msgctxt "installer"
msgid "ReportInstall"
msgstr "[1] kunne ikke installeres, og fortrydelsen fjernede ikke alt. Det, der er tilbage, står nedenfor. Kør installationsprogrammet igen, og fjern derefter [1], hvis du ikke vil have det.\r\nLog: [2]"

msgctxt "installer"
msgid "ReportUpgrade"
msgstr "[1] kunne ikke opgraderes, og fortrydelsen gendannede ikke den version, du havde. Forskellene står nedenfor. Reparer den med den versions installationsprogram, eller installer den nye version igen.\r\nLog: [2]"

msgctxt "installer"
msgid "ReportRemove"
msgstr "[1] kunne ikke fjernes, og fortrydelsen gendannede det ikke. Forskellene står nedenfor. Reparer det med dets installationsprogram, og fjern det derefter igen.\r\nLog: [2]"

msgctxt "installer"
msgid "ReportRepair"
msgstr "[1] kunne ikke repareres, og fortrydelsen gendannede det ikke. Forskellene står nedenfor. Kør installationsprogrammet igen for at reparere det.\r\nLog: [2]"
