msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Dosya Gezgini bir {2} işleyicisini DLL'den yükler; [com.{3}] bir programdır"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows özellik işleyicilerini yalnızca makine başına okur; paket scope = \"machine\" gerektirir"

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: bir önizleme işleyicisi Windows'un prevhost'unda çalışır; [com.{2}] içinden app-id ve surrogate'ı çıkarın"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: bir MSIX yalnızca küçük resim ve önizleme işleyicileri taşır (paketlenmiş bir özellik işleyicisi Dosya Gezgini'ne değer vermedi); msi-only = true onu MSI için tutar"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: bir MSIX dosya türü bir uygulamaya aittir; bir [msix-app.*] ekleyin"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: {2} sınıfı bu paketin bir [com.*] tablosu değil (işleyicinin DLL'si ona hizmet eder)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: bir MSIX'te işleyiciler tüm türlerini paylaşır ya da hiçbirini (bir tür tek bir dosya türü ilişkilendirmesindedir)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: bir MSIX'te sınıfı bir surrogate içinde çalışır; [com.{2}] içindeki threading = \"sta\" penceresine bir ileti döngüsü verir (threading = {3} ile önizleme boş kalabilir)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: bir MSIX'te türlerinin hepsi tek bir [assoc] dosya türündedir ya da hiçbiri"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: sınıfı msi-only ([com.{2}]); MSIX'in onun için sunucusu olmazdı"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types bir dosya türleri listesidir, örneğin [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] {2} konumuna gider; ya da msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] 'value' gerektirir"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] bir özellik gerektirir: 'feature' değerini burada ya da dir'inde ayarlayın"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: bir MSIX tüm INI girdilerini yazar (when); msi-only = true kullanın"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: değerinde Windows Installer'ın kurulumda doldurduğu bir parça var ([...]); bir MSIX dosyayı oluşturulurken yazar"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] 'on' gerektirir: öğenin nerede gösterildiği, örneğin [\".txt\"] veya \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] 'target' (başlattığı program) ya da parent = \"{2}\" olan öğeler (bir alt menü) gerektirir"

msgid "[menu.%s] needs 'target': the program the item starts"
msgstr "[menu.{1}] 'target' gerektirir: öğenin başlattığı program"

msgid "[menu.%s]: Windows 11's menu takes an ID of letters and digits only (no '_'): rename it, or windows11 = false"
msgstr "[menu.{1}]: Windows 11 menüsü yalnızca harf ve rakamlardan oluşan bir ID kabul eder ('_' olmaz): adını değiştirin ya da windows11 = false"

msgid "[menu.%s]: a sub-menu starts nothing: leave 'args' out"
msgstr "[menu.{1}]: bir alt menü hiçbir şey başlatmaz: 'args' değerini çıkarın"

msgid "[menu.%s]: an item of a sub-menu shows where its sub-menu shows: leave 'on' out"
msgstr "[menu.{1}]: bir alt menü öğesi alt menüsünün gösterildiği yerde görünür: 'on' değerini çıkarın"

msgid "[menu.%s]: args has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: args içinde Windows Installer'ın kurulumda doldurduğu bir parça var ([...]); bir MSIX yalnızca sabit metin tutar"

msgid "[menu.%s]: hide-when is \"HKCU\\\\key\\\\value\" or \"HKLM\\\\...\", on an item of Windows 11's menu that is not in a sub-menu"
msgstr "[menu.{1}]: hide-when, \"HKCU\\\\key\\\\value\" ya da \"HKLM\\\\...\" olur; bir alt menüde olmayan bir Windows 11 menü öğesinde kullanılır"

msgid "[menu.%s]: hide-when names a value this package writes ([registry.%s]): the item would never show"
msgstr "[menu.{1}]: hide-when bu paketin kendisinin yazdığı bir değeri gösteriyor ([registry.{2}]): öğe hiç görünmez"

msgid "[menu.%s]: its program is not in the MSIX (msi-only?)"
msgstr "[menu.{1}]: programı MSIX'te yok (msi-only?)"

msgid "[menu.%s]: its values cannot go into the package's registry"
msgstr "[menu.{1}]: değerleri paketin kayıt defterine giremez"

msgid "[menu.%s]: list has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed text only"
msgstr "[menu.{1}]: list içinde Windows Installer'ın kurulumda doldurduğu bir parça var ([...]); bir MSIX yalnızca sabit metin tutar"

msgid "[menu.%s]: list stands for %s when the paths do not fit a command line: it needs multi = \"one\", %s in args and %s (the list file) in list"
msgstr "[menu.{1}]: yollar bir komut satırına sığmadığında list, {2} yerine geçer: multi = \"one\", args içinde {3} ve list içinde {4} (liste dosyası) gerekir"

msgid "[menu.%s]: on = \"%s\": there is no [assoc.%s]"
msgstr "[menu.{1}]: on = \"{2}\": [assoc.{3}] yok"

msgid "[menu.%s]: on is a file type or a list of them, like [\".txt\", \"folder\"]"
msgstr "[menu.{1}]: on bir dosya türü ya da bunların listesidir, örneğin [\".txt\", \"folder\"]"

msgid "[menu.%s]: parent '%s' is not a [menu.*]"
msgstr "[menu.{1}]: parent '{2}' bir [menu.*] değil"

msgid "[menu.%s]: parent '%s' must be a sub-menu: a [menu.*] without target and without a parent of its own"
msgstr "[menu.{1}]: parent '{2}' bir alt menü olmalıdır: target'ı ve kendi parent'ı olmayan bir [menu.*]"

msgid "[merge.%s] goes to %s; or msi-only = true"
msgstr "[merge.{1}] {2} konumuna gider; ya da msi-only = true"

msgid "[merge.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[merge.{1}] bir özellik gerektirir: 'feature' değerini burada ya da dir'inde ayarlayın"

msgid "[merge.%s]: '%s' %s"
msgstr "[merge.{1}]: '{2}' {3}"

msgid "[merge.%s]: '%s' %s; or msi-only = true"
msgstr "[merge.{1}]: '{2}' {3}; ya da msi-only = true"

msgid "[move.%s] needs a feature (or with = \"file:<ID>\")"
msgstr "[move.{1}] feature gerektirir (ya da with = \"file:<ID>\")"

msgid "[move.%s]: feature goes with a component of its own, not with"
msgstr "[move.{1}]: feature kendi bileşeniyle birlikte gider, with ile değil"

msgid "[move.%s]: new-name names one file; name has wildcards"
msgstr "[move.{1}]: new-name tek bir dosyayı belirtir; name joker karakter içerir"

msgid "[msix-extension.%s]: a share target needs types, formats or both"
msgstr "[msix-extension.{1}]: paylaşım hedefi için types, formats veya ikisi gerekir"

msgid "[msix-extension.%s]: an autoplay handler needs content-events, device-events or both"
msgstr "[msix-extension.{1}]: otomatik kullan işleyicisi için content-events, device-events veya ikisi gerekir"

msgid "[msix-extension.%s]: args must be plain text (no [...] filled in at install)"
msgstr "[msix-extension.{1}]: args düz metin olmalıdır (kurulumda doldurulan [...] olmadan)"

msgid "[msix-extension.%s]: device-events need class (the program's IHWEventHandler COM class)"
msgstr "[msix-extension.{1}]: device-events için class gerekir (programın IHWEventHandler COM sınıfı)"

msgid "[msix-extension.%s]: file must be %s"
msgstr "[msix-extension.{1}]: file {2} olmalıdır"

msgid "[msix-extension.%s]: file must name a file that goes into the package"
msgstr "[msix-extension.{1}]: file pakete giren bir dosyayı adlandırmalıdır"

msgid "[msix-extension.%s]: file must name a program that goes into the package"
msgstr "[msix-extension.{1}]: file pakete giren bir programı adlandırmalıdır"

msgid "[msix-extension.%s]: types is a list of file types, like [\".txt\", \"*\"]"
msgstr "[msix-extension.{1}]: types bir dosya türleri listesidir, örneğin [\".txt\", \"*\"]"

msgid "[msix-extension.%s]: verb '%s': Windows takes letters and digits only"
msgstr "[msix-extension.{1}]: verb '{2}': Windows yalnızca harf ve rakam kabul eder"

msgid "[msix-psf] for arm64 needs launcher = \"...\" (the PSF names its launchers PsfLauncher32.exe and PsfLauncher64.exe)"
msgstr "arm64 için [msix-psf] launcher = \"...\" gerektirir (PSF başlatıcılarını PsfLauncher32.exe, PsfLauncher64.exe diye adlandırır)"

msgid "[msix-psf] goes with neither external-location = true nor [env.*] (rubrapack's own launcher)"
msgstr "[msix-psf] ne external-location = true ne de [env.*] (rubrapack'in kendi başlatıcısı) ile birlikte kullanılır"

msgid "[msix-psf] starts the applications through the PSF launcher: it needs an [msix-app.ID]"
msgstr "[msix-psf] uygulamaları PSF başlatıcısıyla başlatır: bir [msix-app.ID] gerekir"

msgid "[msix-psf]: config '%s' does not name the application '%s' in its \"applications\""
msgstr "[msix-psf]: '{1}' config dosyası \"applications\" içinde '{2}' uygulamasını adlandırmıyor"

msgid "[msix-psf]: files has no '%s' (the launcher)"
msgstr "[msix-psf]: files içinde '{1}' (başlatıcı) yok"

msgid "[odbc-driver.%s]: file '%s' is not a DLL"
msgstr "[odbc-driver.{1}]: '{2}' dosyası bir DLL değil"

msgid "[odbc-source.%s] names its driver once: driver (an [odbc-driver]) or driver-name"
msgstr "[odbc-source.{1}] sürücüsünü bir kez belirtir: driver (bir [odbc-driver]) ya da driver-name"

msgid "[odbc-source.%s] with driver-name needs with = \"file:<ID>\": the component it is installed with"
msgstr "[odbc-source.{1}] driver-name ile with = \"file:<ID>\" gerektirir: birlikte kurulduğu bileşen"

msgid "[odbc-source.%s]: a per-machine package registers data sources for the machine"
msgstr "[odbc-source.{1}]: makine başına bir paket veri kaynaklarını makineye kaydeder"

msgid "[other-copy.%s] names one copy: msix (with publisher) or upgrade-code"
msgstr "[other-copy.{1}] bir kopya belirtir: msix (publisher ile) ya da upgrade-code"

msgid "[other-copy.%s]: msix is the package's identity name (3 to 50 letters, digits, '.' or '-') and needs publisher (\"CN=...\"), as its manifest has them"
msgstr "[other-copy.{1}]: msix paketin kimlik adıdır (3 ile 50 arası harf, rakam, '.' ya da '-') ve publisher (\"CN=...\") gerekir; ikisi de bildirimindeki gibi"

msgid "[other-copy.%s]: the preflight looks for the other copy: it needs preflight = true"
msgstr "[other-copy.{1}]: diğer kopyayı ön denetim arar: preflight = true gerekir"

msgid "[other-copy.%s]: upgrade-code is this package's own (that is an upgrade, not another copy)"
msgstr "[other-copy.{1}]: upgrade-code bu paketin kendisininki (bu bir yükseltmedir, başka bir kopya değil)"

msgid "[permission.%s] needs its dir to have a feature"
msgstr "[permission.{1}] dir'inin bir özelliği olmasını gerektirir"

msgid "[protocol.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[protocol.{1}]: bir MSIX için args düz metin olmalıdır (kurulumda doldurulan [...] olmadan)"

msgid "[protocol.%s]: in an MSIX a scheme opens an application: target must be an [msix-app.*] executable"
msgstr "[protocol.{1}]: bir MSIX'te bir şema bir uygulama açar: target bir [msix-app.*] yürütülebilir dosyası olmalıdır"

msgid "[registry.%s] needs 'value' (or remove = true)"
msgstr "[registry.{1}] 'value' (ya da remove = true) gerektirir"

msgid "[registry.%s]: HKCR does not reach outside an MSIX; use [assoc.*], [protocol.*], [com.*] or [handler.*], or msi-only = true"
msgstr "[registry.{1}]: HKCR bir MSIX'in dışına ulaşmaz; [assoc.*], [protocol.*], [com.*] veya [handler.*] ya da msi-only = true kullanın"

msgid "[registry.%s]: a qword value needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: bir qword değeri, bir birleştirme modülünün taşımadığı rubrapack yardımcı DLL'sini gerektirir"

msgid "[registry.%s]: an MSIX carries values under %s\\Software only"
msgstr "[registry.{1}]: bir MSIX yalnızca {2}\\Software altındaki değerleri taşır"

msgid "[registry.%s]: an MSIX neither removes values nor leaves them behind (remove, keep); use msi-only = true"
msgstr "[registry.{1}]: bir MSIX değerleri ne kaldırır ne de geride bırakır (remove, keep); msi-only = true kullanın"

msgid "[registry.%s]: an MSIX writes all its values (when); use msi-only = true"
msgstr "[registry.{1}]: bir MSIX tüm değerlerini yazar (when); msi-only = true kullanın"

msgid "[registry.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX holds fixed values only"
msgstr "[registry.{1}]: değerinde Windows Installer'ın kurulumda doldurduğu bir parça var ([...]); bir MSIX yalnızca sabit değerler tutar"

msgid "[registry.%s]: on = \"uninstall\" needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[registry.{1}]: on = \"uninstall\", bir birleştirme modülünün taşımadığı rubrapack yardımcı DLL'sini gerektirir"

msgid "[registry.%s]: the key or value name cannot go into a registry hive"
msgstr "[registry.{1}]: anahtar veya değer adı bir kayıt defteri kovanına giremez"

msgid "[registry.%s]: users = \"all\" is for root = \"HKCU\" with on = \"uninstall\", in a per-machine package"
msgstr "[registry.{1}]: users = \"all\", bilgisayar paketinde on = \"uninstall\" ile root = \"HKCU\" içindir"

msgid "[remove.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[remove.{1}] bir özellik gerektirir: 'feature' değerini burada ya da dir'inde ayarlayın"

msgid "[remove.%s]: recursive = true is not for a folder below %s"
msgstr "[remove.{1}]: recursive = true, {2} altındaki bir klasör için değildir"

msgid "[remove.%s]: recursive = true needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[remove.{1}]: recursive = true, bir birleştirme modülünün taşımadığı rubrapack yardımcı DLL'sini gerektirir"

msgid "[remove.%s]: users = \"all\" is for recursive = true on a folder in AppData or LocalAppData, in a per-machine package"
msgstr "[remove.{1}]: users = \"all\", bilgisayar paketinde AppData veya LocalAppData içindeki bir klasörde recursive = true içindir"

msgid "[service.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[service.{1}]: bir MSIX için args düz metin olmalıdır (kurulumda doldurulan [...] olmadan)"

msgid "[service.%s]: file must name a program that goes into the package"
msgstr "[service.{1}]: file pakete giren bir programı adlandırmalıdır"

msgid "[shortcut.%s] advertises feature '%s', which is advertise = \"disallow\""
msgstr "[shortcut.{1}] '{2}' özelliğini tanıtıyor, ancak o özellik advertise = \"disallow\""

msgid "[shortcut.%s]: advertise is not combined with when"
msgstr "[shortcut.{1}]: advertise, when ile birlikte kullanılmaz"

msgid "[shortcut.%s]: an MSIX has shortcuts on the desktop and in the Start menu only%s"
msgstr "[shortcut.{1}]: bir MSIX'in kısayolları yalnızca masaüstünde ve Başlat menüsündedir{2}"

msgid "[shortcut.%s]: an MSIX shortcut has no working-dir"
msgstr "[shortcut.{1}]: bir MSIX kısayolunun working-dir değeri yoktur"

msgid "[shortcut.%s]: an MSIX shortcut is always there (when is for an MSI)"
msgstr "[shortcut.{1}]: bir MSIX kısayolu her zaman vardır (when bir MSI içindir)"

msgid "[shortcut.%s]: an MSIX shortcut shows its application's logo; icon is for an MSI"
msgstr "[shortcut.{1}]: bir MSIX kısayolu uygulamasının logosunu gösterir; icon bir MSI içindir"

msgid "[shortcut.%s]: an advertised shortcut is for an MSI (an MSIX installs the whole package)"
msgstr "[shortcut.{1}]: tanıtılan bir kısayol bir MSI içindir (MSIX paketin tamamını kurar)"

msgid "[shortcut.%s]: an advertised shortcut needs an icon"
msgstr "[shortcut.{1}]: tanıtılan bir kısayol bir simge gerektirir"

msgid "[shortcut.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[shortcut.{1}]: bir MSIX için args düz metin olmalıdır (kurulumda doldurulan [...] olmadan)"

msgid "[shortcut.%s]: in an MSIX a shortcut starts an application: target must be an [msix-app.*] executable"
msgstr "[shortcut.{1}]: bir MSIX'te kısayol bir uygulama başlatır: target bir [msix-app.*] yürütülebilir dosyası olmalıdır"

msgid "[shortcut.%s]: the Start menu entry of an MSIX is its application, which takes no args"
msgstr "[shortcut.{1}]: bir MSIX'in Başlat menüsü girdisi kendi uygulamasıdır, args almaz"

msgid "[ui-text.%s]: no dialog text has this ID"
msgstr "[ui-text.{1}]: hiçbir iletişim kutusu metninin bu kimliği yok"

msgid "[ui] embedded is for an MSI; an MSIX has no installer UI of its own"
msgstr "[ui] embedded bir MSI içindir; bir MSIX'in kendi kurulum arabirimi yoktur"

msgid "[ui] needs ui = \"basic\" or another dialog set in [package] (or embedded = \"...dll\")"
msgstr "[ui] için [package] içinde ui = \"basic\" veya başka bir iletişim kutusu kümesi gerekir (veya embedded = \"....dll\")"

msgid "\\%c escape is not a Unicode scalar value"
msgstr "\\{1} kaçış dizisi bir Unicode skaler değeri değil"

msgid "`lint --previous`: this package would not upgrade the previous one cleanly"
msgstr "`lint --previous`: bu paket öncekini temiz biçimde yükseltmez"

msgid "`lint` of a package: dialogs, code page, text normalisation"
msgstr "bir paketin `lint` denetimi: iletişim kutuları, kod sayfası, metin normalleştirme"

msgid "`lint` of an MSIX package or bundle"
msgstr "bir MSIX paketinin veya paket grubunun `lint` denetimi"

msgid "a %s control has no property"
msgstr "{1} denetiminin property'si yoktur"

msgid "a %s control has no text; put a text control beside it"
msgstr "bir {1} denetiminin metni yok; yanına bir metin denetimi koyun"

msgid "a %s control needs [property.%s] with one of its values as the default (a silent installation uses it)"
msgstr "bir {1} denetimi, değerlerinden biri varsayılan olan bir [property.{2}] gerektirir (sessiz kurulum onu kullanır)"

msgid "a %s package cannot write HKLM; use HKMU"
msgstr "bir {1} paketi HKLM'ye yazamaz; HKMU kullanın"

msgid "a .msix output needs an [msix-app.ID] table naming the executable"
msgstr "bir .msix çıktısı, yürütülebilir dosyayı adlandıran bir [msix-app.ID] tablosu gerektirir"

msgid "a .msix output needs an [msix] table (identity-name, publisher)"
msgstr "bir .msix çıktısı bir [msix] tablosu gerektirir (identity-name, publisher)"

msgid "a .msm output is a merge module, built from a source with [module] instead of [package]"
msgstr "bir .msm çıktısı, [package] yerine [module] içeren bir kaynaktan oluşturulan bir birleştirme modülüdür"

msgid "a .txt, .md or .rtf file, or - for none"
msgstr "bir .txt, .md veya .rtf dosyası ya da yoksa -"

msgid "a PE file without a certificate table entry"
msgstr "sertifika tablosu girdisi olmayan bir PE dosyası"

msgid "a PIN is never taken on the command line (others can see it); use --pin-env or --pin-file"
msgstr "PIN asla komut satırından alınmaz (başkaları görebilir); --pin-env veya --pin-file kullanın"

msgid "a Package of the bundle manifest of an unknown Type"
msgstr "paket grubu bildiriminde bilinmeyen Type türünde bir Package"

msgid "a Package of the bundle manifest without FileName, Offset or Size"
msgstr "paket grubu bildiriminde FileName, Offset veya Size olmayan bir Package"

msgid "a ZIP entry does not inflate to its size"
msgstr "bir ZIP girdisi boyutuna açılmıyor"

msgid "a ZIP entry larger than allowed"
msgstr "izin verilenden büyük bir ZIP girdisi"

msgid "a ZIP entry's CRC-32 does not match"
msgstr "bir ZIP girdisinin CRC-32'si eşleşmiyor"

msgid "a ZIP entry's data lies outside the file"
msgstr "bir ZIP girdisinin verisi dosyanın dışında"

msgid "a [module] source builds a merge module: -o <name>.msm"
msgstr "bir [module] kaynağı bir birleştirme modülü oluşturur: -o <ad>.msm"

msgid "a binary value is an even number of hex digits, like \"01A0FF\""
msgstr "ikili değer çift sayıda onaltılık rakamdır, örneğin \"01A0FF\""

msgid "a bundle without packages"
msgstr "paketsiz bir paket grubu"

msgid "a certificate in the path has a critical extension rubrapack does not understand"
msgstr "yoldaki bir sertifikanın rubrapack'in anlamadığı kritik bir uzantısı var"

msgid "a certificate in the path is signed by a certificate that is not a CA"
msgstr "yoldaki bir sertifika CA olmayan bir sertifika tarafından imzalanmış"

msgid "a chain holds [chain], [chain-package.ID] and [define] only, not [%s]; the packages are built from their own sources"
msgstr "bir zincir yalnızca [chain], [chain-package.ID] ve [define] içerir, [{1}] içermez; paketler kendi kaynaklarından oluşturulur"

msgid "a chain holds at most %d packages"
msgstr "bir zincir en fazla {1} paket içerir"

msgid "a chain needs [chain]"
msgstr "bir zincir [chain] gerektirir"

msgid "a chain needs at least one [chain-package.ID]"
msgstr "bir zincir en az bir [chain-package.ID] gerektirir"

msgid "a character Windows does not allow in a name (/ \\ : * ? \" < > |)"
msgstr "Windows'un bir adda izin vermediği bir karakter (/ \\ : * ? \" < > |)"

msgid "a container holds at most %u package families"
msgstr "bir kapsayıcıda en fazla {1} paket ailesi olur"

msgid "a control character"
msgstr "bir denetim karakteri"

msgid "a damaged PE optional header"
msgstr "bozuk bir PE isteğe bağlı üst bilgisi"

msgid "a damaged PE section table"
msgstr "bozuk bir PE bölüm tablosu"

msgid "a damaged ZIP64 end record"
msgstr "bozuk bir ZIP64 son kaydı"

msgid "a damaged hive bin"
msgstr "bozuk bir kovan bölmesi (hive bin)"

msgid "a diagnostic of rubrapack"
msgstr "rubrapack'in bir tanılaması"

msgid "a disabled service cannot be started"
msgstr "devre dışı bir hizmet başlatılamaz"

msgid "a dual package cannot choose between a user and a system variable"
