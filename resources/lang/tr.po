msgstr "değişkenler: değersiz $(AD), kapatılmamış $(, duramayacağı yerde bir Windows adı veya dir kimliği"

msgid "version '%s' must be a.b.c or a.b.c.d"
msgstr "sürüm '{1}' a.b.c veya a.b.c.d olmalıdır"

