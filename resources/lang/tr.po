msgstr "Windows Installer en fazla 255.255.65535(.65535) izin verir"

msgid "Windows name"
msgstr "Windows adı"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] '{4}' gerektirir"

