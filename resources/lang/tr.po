msgstr "{1}: {2} dosya, {3} hata, 0 uyarı\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: {2} tanılama daha gösterilmedi\n"

msgid "%s: '%s' is not a standard action rubrapack places"
msgstr "{1}: '{2}', rubrapack'in yerleştirdiği standart bir eylem değil"

