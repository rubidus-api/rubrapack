msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': bildirimde {2} {3} yok"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': bildirim pakette olmayan '{2}' öğesini adlandırıyor"

msgid "'%s': timestamp from %s: %s"
msgstr "'{1}': {2} kaynağından zaman damgası: {3}"

