msgstr "'{1}' bir program (.exe) değil"

msgid "'%s' is not a regular file"
msgstr "'{1}' normal bir dosya değil"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' bir rubrapack kurulum programı değil{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' geçerli bir kimlik değil (harfler, rakamlar ve '_', rakamla başlamaz, en fazla {2})"

