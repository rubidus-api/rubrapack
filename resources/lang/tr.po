msgstr "[{1}.{2}] kullanıcının AppData veya LocalAppData klasöründe: tüm kullanıcılar için kurulan bir dual paket onu yalnızca kuran kullanıcının profiline koyar"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: bir birleştirme modülündeki kimlik en fazla 35 karakterdir (modülün GUID'i ona eklenir)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] bir kimlik gerektirir: [{2}.ID] yazın"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] kimlik almaz: [{2}] yazın"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml içinde </Types> yok"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml son girdi değil (rubrapack veya Windows paketleme API'sinin yazdığı bir paket değil)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "[[...]] tablo dizileri desteklenmez; her öğeye kendi [kind.ID]'sini verin"

msgid "[action.%s] is placed once: before, after or sequence"
msgstr "[action.{1}] bir kez yerleştirilir: before, after ya da sequence"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] hem do hem undo gerektirir (undo başarısız bir do'yu da geri alır)"

msgid "[action.%s] needs entry: the DLL's function to call"
msgstr "[action.{1}] entry gerektirir: çağrılacak DLL işlevi"

msgid "[action.%s] needs run = \"file:<ID>\": the program do and undo run"
msgstr "[action.{1}] run = \"file:<ID>\" gerektirir: do ve undo'nun çalıştırdığı program"

msgid "[action.%s] runs one thing: run (an exe), dll (an installed DLL) or binary (a DLL in the package); or do and undo"
msgstr "[action.{1}] bir şey çalıştırır: run (bir exe), dll (kurulu bir DLL) ya da binary (paketteki bir DLL); ya da do ve undo"

msgid "[action.%s]: %s is for a single action, not a do/undo pair"
msgstr "[action.{1}]: {2} tek bir eylem içindir, do/undo çifti için değil"

msgid "[action.%s]: a deferred action that runs an installed file must be after InstallFiles (sequence > 4000)"
msgstr "[action.{1}]: kurulu bir dosyayı çalıştıran ertelenmiş eylem InstallFiles'tan sonra olmalıdır (sequence > 4000)"

msgid "[action.%s]: an immediate action runs as the user who installs; as is for the other phases"
msgstr "[action.{1}]: anlık bir eylem kuran kullanıcı olarak çalışır; as diğer aşamalar içindir"

msgid "[action.%s]: args are a program's; a DLL gets data"
msgstr "[action.{1}]: args bir programınkidir; bir DLL data alır"

msgid "[action.%s]: check goes with a do/undo pair"
msgstr "[action.{1}]: check bir do/undo çiftiyle gider"

msgid "[action.%s]: data is for a deferred, commit or rollback action (an immediate one reads properties)"
msgstr "[action.{1}]: data ertelenmiş, commit ya da rollback eylemi içindir (anlık olan özellikleri okur)"

msgid "[action.%s]: entry is a DLL's function; run takes args"
msgstr "[action.{1}]: entry bir DLL'nin işlevidir; run args alır"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: bir MSIX için args düz metin olmalıdır (kurulumda doldurulan [...] olmadan)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: bir MSIX'te dosya türü bir uygulama açar: target bir [msix-app.*] yürütülebilir dosyası olmalıdır"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] iki kez var"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] bir kimlik gerektirir: [chain-package.ID] yazın"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id ve typelib yalnızca MSI için yazılır; MSIX sınıfı onlarsız kaydeder"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args bir programa aittir; bir DLL yüklenir, başlatılmaz"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate bir DLL'yi dllhost içinde çalıştırır; '{2}' bir programdır"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading bir DLL içindir; bir program kendi apartment'ını ayarlar"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version ve typelib-file, typelib gerektirir"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] {2} konumuna gider; ya da msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: kaynağı pakete giren bir dosya olmalıdır"

msgid "[define] values must be strings"
msgstr "[define] değerleri dize olmalıdır"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] '{2}' gerektirir"

msgid "[dialog-control.%s] needs 'image'"
msgstr "[dialog-control.{1}] image gerektirir"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] 'property' gerektirir"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] 'text' gerektirir"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] 'values' gerektirir"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] içinde {2} denetim var; en fazla 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] içinde [dialog-control.*] yok"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] diğer iletişim kutuları üzerinden kendinden sonraya yerleştirilmiş"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] ui = \"minimal\", \"installdir\" veya \"features\" gerektirir"

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' bir Windows adıdır; dir'e başka bir kimlik verin"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard, bir birleştirme modülünün taşımadığı rubrapack yardımcı DLL'sini gerektirir"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] bir özellik gerektirir"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: bir MSIX tüm değişkenlerini ayarlar (when); msi-only = true kullanın"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: değeri bir MSIX'in veremeyeceği bir yeri adlandırıyor (paket dışında Windows klasörü olmayan bir klasör ya da kurulum zamanı parçası); msi-only = true kullanın"

msgid "[env.%s]: with external-location = true the package carries none of the program's files, so not rubrapack's launcher either; or msi-only = true"
msgstr "[env.{1}]: external-location = true ile paket programın hiçbir dosyasını taşımaz, dolayısıyla rubrapack başlatıcısını da; veya msi-only = true"

msgid "[file.%s] is in its program's folder already; isolate-for is for a shared DLL installed elsewhere"
msgstr "[file.{1}] zaten kendi programının klasöründe; isolate-for başka yere kurulan paylaşılan bir DLL içindir"

