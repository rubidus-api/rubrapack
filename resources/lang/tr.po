msgstr "[{1}{2}] bir birleştirme modülüne giremez; onu birleştiren pakette bulunur"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] henüz desteklenmiyor ({3} için planlandı)"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] bir MSIX'e giremez; MSIX'i onsuz oluşturmak için msi-only = true ekleyin"

