msgstr "'{1}': yazılacak {2} bayttan fazla veri var (--limit-bytes); hiçbir şey çıkarılmadı"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': --timestamp yok: sertifikanın süresi dolunca imza geçersiz olur"

