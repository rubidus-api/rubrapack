msgstr "sürüm '{1}', a, b <= 255 ve c, d <= 65535 olan a.b.c veya a.b.c.d olmalıdır"

msgid "view = \"32\" cannot go 'with' a file of a 64-bit package"
msgstr "view = \"32\", 64 bit bir paketin dosyasıyla 'with' gidemez"

msgid "view must be \"32\" or \"64\""
msgstr "view \"32\" veya \"64\" olmalıdır"

msgid "warning"
msgstr "uyarı"

msgid "what a diagnostic code means, the messages that carry it, what to do and where the manual says more"
msgstr "bir tanılama kodunun anlamı, onu taşıyan iletiler, ne yapılacağı ve kılavuzun nerede daha fazlasını söylediği"

msgid "with must be \"file:<ID>\""
msgstr "with \"file:<ID>\" olmalıdır"

msgid "with: file '%s' is not a [file.*] of this package"
msgstr "with: '{1}' dosyası bu paketin bir [file.*] tablosu değil"

msgid "without --pkcs11, `keys list` shows the Windows certificate store"
msgstr "--pkcs11 olmadan `keys list` Windows sertifika deposunu gösterir"

msgid "working-dir '%s' is not a dir ID"
msgstr "working-dir '{1}' bir dir kimliği değil"

msgid "write a Windows Sandbox configuration that installs the package in a fresh, disposable Windows"
msgstr "paketi yeni, tek kullanımlık bir Windows'a kuran bir Windows Sandbox yapılandırması yazar"

