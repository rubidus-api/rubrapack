msgstr "'help' en fazla bir komut adı alır"

msgid "'version' takes no arguments"
msgstr "'version' bağımsız değişken almaz"

msgid "--allow-unsigned-cabs is for .msi"
msgstr "--allow-unsigned-cabs .msi içindir"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "bir paket grubu için --arch: x64, x86 ve arm64 listesi, her biri bir kez (alınan: '{1}')"

msgid "--arch takes one architecture, or a list for a .msixbundle or .msixupload output"
msgstr "--arch bir mimari alır ya da .msixbundle / .msixupload çıktısı için bir liste"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp ve --allow-unsigned-cabs --key ile birlikte kullanılır"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress .msi içindir; bir MSIX --msix-compress deflate|store alır"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist kaynağın yanında yeni bir klasörü adlandırır (yol olmadan)"

