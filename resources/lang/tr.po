msgid "write a transform (.mst): what turns one package into the other"
msgstr "bir dönüşüm (.mst) yazar: bir paketi diğerine çeviren şey"

msgid "write the table or value the plain way the manual shows"
msgstr "tabloyu veya değeri kılavuzun gösterdiği sade biçimde yazın"

msgid "write the value without '[~]'; mode = \"append\" or \"prepend\" adds it"
msgstr "değeri '[~]' olmadan yazın; mode = \"append\" veya \"prepend\" onu ekler"

