msgstr "--msix-compress deflate veya store alır (alınan: '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: değişken ayarlanmamış"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code büyük harfli ve süslü ayraçlı bir GUID alır: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: değişken ayarlanmamış"

msgid "--previous compares two .msi packages"
msgstr "--previous iki .msi paketini karşılaştırır"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: işletim sisteminin kök sertifikaları okunamıyor"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1}, '{2}' çıktısıyla eşleşmiyor"

msgid "--target %s is not implemented (msi or msix)"
msgstr "--target {1} uygulanmadı (msi veya msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target msi veya msix alır (alınan: '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots ve --proxy --timestamp ile birlikte kullanılır"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test ve --msix-compress .msix çıktıları içindir"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test imzasız paketler içindir; --key ile birlikte vermeyin"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate none ya da şunlardan bazılarını alır: product-code,upgrade-code,language,platform"

msgid "--winget is for a .msi, .msix or .msixbundle output"
msgstr "--winget bir .msi, .msix veya .msixbundle çıktısı içindir"

