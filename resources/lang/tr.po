msgstr "--key-store bir Windows sertifika deposudur; başka yerlerde bir anahtar dosyası veya --pkcs11 kullanın"

msgid "--key-store takes the certificate's SHA-1 thumbprint (40 hex digits)"
msgstr "--key-store sertifikanın SHA-1 parmak izini alır (40 onaltılık rakam)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: böyle bir dil yok (yerleşik: {2}; başka bir dil kendi dil paketini gerektirir, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (veya RUBRAPACK_LANG) bu metinlerin dilini seçer: {1} ya da dil paketi olan bir dil.\n"

