# rubrapack language pack: Turkish.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: tr\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-14 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Türkçe\n"
"X-Rubrapack-LangIDs: 1055\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 5\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, iletişim kutuları {6}{7}\n  1 ad, üretici, sürüm, mimari                  2 kurulum klasörü, kimin için kurulur\n  3 iletişim kutuları, lisans, diller           4 isteğe bağlı parçalar\n  5 kısayollar                                  6 dosyalar: program klasörüne uydur\n  7 herhangi bir anahtar                        v görüntüle   l lint   s kaydet   q çık\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nBu koda sahip iletiler (* bir adın veya değerin yerini tutar):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nSonuçlar stdout'a, tanılamalar stderr'e gider.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nYapılacak: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} artık yok ama bir kısayol onu açıyor: önce kısayolları değiştirin (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  orada {1} dosya ve {2} klasör var\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s veya q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  [dir.{1}] ve [files.{2}] eklendi\n"

msgid "  added [file.%s]\n"
msgstr "  [file.{1}] eklendi\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  tablo.anahtar biçiminde verin, örneğin package.version veya dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: sorun yok\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: yukarıdaki sorunlara bakın (orada adı geçen dosya bir denetim kopyasıdır)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  [ui] languages içindeki diğer diller korunur; bu listeyi 7 ile değiştirin (herhangi bir anahtar)\n"

msgid "  removed [file.%s]\n"
msgstr "  [file.{1}] kaldırıldı\n"

msgid "  removed [files.%s]%s\n"
msgstr "  [files.{1}]{2} kaldırıldı\n"

msgid "  sub folders:"
msgstr "  alt klasörler:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  bu TOML alt kümesine uymuyor; hiçbir şey değiştirilmedi\n"

msgid "  that was not readable text; again, please\n"
msgstr "  bu okunabilir bir metin değildi; lütfen yeniden\n"

msgid "  the program folder '%s': %s\n"
msgstr "  program klasörü '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  kaynakta bir kısayolun gösterebileceği [file] tablosu yok\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  kaynakta `new` komutunun yazdığı biçimde alt klasör yok ([files] \"<folder>/<name>/**\"); bunları 6 ile ekleyin\n"

msgid "  too long; again, please\n"
msgstr "  çok uzun; lütfen yeniden\n"

msgid "  y or n\n"
msgstr "  y veya n\n"

msgid " (changed)"
msgstr " (değişti)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - Windows Installer (.msi) ve MSIX (.msix) paketleri oluşturur\n\nkullanım: rubrapack [--lang <code>] <command> [arguments]\n\nkomutlar:\n"

msgid " and its dir"
msgstr " ve onun dir'i"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) için ortam değişkeni yok, bu yüzden genişletilebilir bir değer onu tutamaz; bir dize değeri kullanın (kurulumda doldurulur)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) bir {2}: bir yolu başlatabilir ya da Windows Installer'ın doldurduğu bir değerin yerini tutabilir (kayıt defteri, ortam, INI, bağımsız değişkenler, iletiler), ama burada değil"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) bir yolun başlayabileceği bir klasör değil (bir dir kimliği ya da ProgramFiles, LOCALAPPDATA, ProgramData ... - kılavuzdaki Paths bölümüne bakın){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  yapı:         {2}\n  özet:         {3}\n  imza:         {4}\n  zincir:       {5}{6}{7}\n  iptal:        denetlenmedi\n  zaman damgası: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: değişken ayarlanmamış"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' bu iletişim kutusunun bir denetimi değil"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}', {3} içinde değil"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': lisans metni yazı tipinin İngilizce adını gerektirir, bu yüzden dilin kendi yazı tipiyle görünür; bu yazı tipini orada da kullanmak için İngilizce adı yazın (\"Malgun Gothic\" gibi)"

msgid "%s = '%s' must be a folder"
msgstr "{1} = '{2}' bir klasör olmalıdır"

msgid "%s component, but the package platform is %.*s"
msgstr "{1} bileşeni, ama paketin platformu {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1}, kind = \"{2}\" için geçerli değil"

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1}, kind = \"firewall\" için geçerli değil"

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} LANGID değerleri tutar (1..65535), örneğin 1041"

msgid "%s holds strings"
msgstr "{1} dizeler tutar"

msgid "%s is %u to %u characters long"
msgstr "{1} {2}-{3} karakter uzunluğundadır"

msgid "%s is a list of \"Key=Value\" texts"
msgstr "{1}, \"Anahtar=Değer\" metinlerinin bir listesidir"

msgid "%s is a list of texts, like [\"%s\"]"
msgstr "{1} bir metin listesidir, örneğin [\"{2}\"]"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1}, 1 ile 31 karakter arası bir yazı tipi adıdır, örneğin \"Segoe UI\" (alınan: {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1}, tırnakları kapalı ve parantezleri dengeli bir MSI koşuludur"

msgid "%s is an array of strings, one per value"
msgstr "{1}, her değer için bir tane olmak üzere bir dize dizisidir"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} MSI paketleri içindir: bir MSIX msiexec ile kaldırılmaz"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} artık yok. [file.{2}] kaldırılsın mı?"

msgid "%s is longer than 240 characters"
msgstr "{1} 240 karakterden uzun"

msgid "%s is new. Add it?"
msgstr "{1} yeni. Eklensin mi?"

msgid "%s is not a GUID in registry format"
msgstr "{1}, kayıt defteri biçiminde bir GUID değil"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1}, bu rubrapack'in kullandığı bir kod değil{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1}, bu paketin bir [file.*] tablosunu adlandıran \"file:<ID>\" olmalıdır"

msgid "%s must be %u to %u letters, digits, '.' or '-', not starting with '.' (got '%s')"
msgstr "{1} {2} ile {3} arasında harf, rakam, '.' veya '-' olmalı ve '.' ile başlamamalıdır (alınan: '{4}')"

msgid "%s must be a GUID"
msgstr "{1} bir GUID olmalıdır"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1}, {12345678-...} gibi bir GUID olmalıdır (alınan: '{2}')"

msgid "%s must be an http:// or https:// address (got '%s')"
msgstr "{1} bir http:// veya https:// adresi olmalıdır ('{2}' alındı)"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} bir https://, http:// veya file:// adresi ya da bir \\\\server\\share yolu olmalıdır (alınan: '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1}, upgrade-code'dan farklı olmalıdır (mimari başına bir yükseltme ailesi)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1}, Windows {2} veya sonraki bir yapı gerektirir: [msix] min-version = \"10.0.{3}.0\" olarak ayarlayın"

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1}, bu rubrapack'in onsuz derlendiği resources/bin/rubrapack_ca-{2}.dll dosyasını gerektirir"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA denetlenmedi (--tsa-trust verin)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA güvenilir"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA güvenilmez - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} artık yok ya da boş. [files.{3}] ve [dir.{4}] kaldırılsın mı?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ yeni bir klasör. Eklensin mi?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: {2} hata{-3}, {4} uyarı{-5}\n"

