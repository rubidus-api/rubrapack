msgstr "{1}: '{2}' dosyası bu paketin bir [file.*] tablosu değil"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: '{2}' dosyası bir program (.exe) değil"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' kapatılmamış ('$(' metni için '$$(' yazın)"

