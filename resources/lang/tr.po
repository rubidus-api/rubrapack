msgstr "'{1}' 0x{2} makinesi için derlenmiş, bu paketin arch değeri için değil; amaç buysa any-arch = true ayarlayın"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ne bir PE dosyası (.exe, .dll), ne bir MSI paketi ne de bir MSIX paketi veya paket grubu"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' ne bir PE dosyası, ne bir MSI paketi ne de bir MSIX paketi veya paket grubu"

