msgstr "--arch приема една архитектура или списък за изход .msixbundle"

msgid "--cert, --pass-env, --pass-file, --timestamp and --allow-unsigned-cabs go with --key"
msgstr "--cert, --pass-env, --pass-file, --timestamp и --allow-unsigned-cabs вървят с --key"

msgid "--compress is for .msi; an MSIX takes --msix-compress deflate|store"
msgstr "--compress е за .msi; MSIX приема --msix-compress deflate|store"

msgid "--dist names a new folder beside the source (no path)"
msgstr "--dist посочва нова папка до източника (без път)"

msgid "--jobs takes a number from 1 to 64 (got '%s')"
msgstr "--jobs приема число от 1 до 64 (получено '{1}')"

msgid "--key-store is a Windows certificate store; elsewhere use a key file or --pkcs11"
msgstr "--key-store е хранилище за сертификати на Windows; другаде използвайте файл с ключ или --pkcs11"

