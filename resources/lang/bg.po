# rubrapack language pack: Bulgarian.
#
# One file is one language (the manual: "Language packs"). The header names the language; an entry
# without msgctxt is a text of the command line - msgid is the English text as rubrapack writes
# it, msgstr its translation, with {1}, {2} ... for the English text's conversions (%s, %zu) in
# the English order, {-2} for one that has no place in this language, {{ for a brace. An entry with
# msgctxt "installer" is a text of the installers rubrapack builds: msgid is its ID.

msgid ""
msgstr ""
"Language: bg\n"
"Project-Id-Version: rubrapack\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: rubrapack\n"
"Language-Team: rubrapack\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Rubrapack-Name: Български\n"
"X-Rubrapack-LangIDs: 1026\n"
"X-Rubrapack-Font: Segoe UI\n"
"X-Rubrapack-Group: 8\n"

msgid "\n%s: \"%s\" %s, %s, %s, dialogs %s%s\n  1 name, manufacturer, version, architecture   2 install folder, who it installs for\n  3 dialogs, license, languages                  4 optional parts\n  5 shortcuts                                    6 files: match the program folder\n  7 any key                                      v view   l lint   s save   q quit\n"
msgstr "\n{1}: \"{2}\" {3}, {4}, {5}, диалогови прозорци {6}{7}\n  1 име, производител, версия, архитектура      2 папка за инсталиране, за кого се инсталира\n  3 диалогови прозорци, лиценз, езици            4 незадължителни части\n  5 преки пътища                                 6 файлове: съгласуване с папката на програмата\n  7 произволен ключ                              v преглед   l lint   s запис   q изход\n"

msgid "\nMessages with this code (* stands for a name or a value):\n"
msgstr "\nСъобщения с този код (* означава име или стойност):\n"

msgid "\nResults go to stdout, diagnostics to stderr.\n"
msgstr "\nРезултатите отиват в stdout, диагностиките в stderr.\n"

msgid "\nWhat to do: %s.\n"
msgstr "\nКакво да направите: {1}.\n"

msgid "  %s is gone, but a shortcut opens it: change the shortcuts (5) first\n"
msgstr "  {1} вече го няма, но пряк път го отваря: първо променете преките пътища (5)\n"

msgid "  %zu files and %zu folders there\n"
msgstr "  {1} файла и {2} папки там\n"

msgid "  1-7, v, l, s or q\n"
msgstr "  1-7, v, l, s или q\n"

msgid "  added [dir.%s] and [files.%s]\n"
msgstr "  добавени [dir.{1}] и [files.{2}]\n"

msgid "  added [file.%s]\n"
msgstr "  добавен [file.{1}]\n"

msgid "  give it as table.key, such as package.version or dir.INSTALLDIR.path\n"
msgstr "  дайте го като table.key, например package.version или dir.INSTALLDIR.path\n"

msgid "  lint: no problems\n"
msgstr "  lint: няма проблеми\n"

msgid "  lint: see the problems above (the file named there is a check copy)\n"
msgstr "  lint: вижте проблемите по-горе (посоченият там файл е копие за проверка)\n"

msgid "  other languages in [ui] languages are kept; change that list with 7 (any key)\n"
msgstr "  другите езици в [ui] languages се запазват; променете този списък с 7 (произволен ключ)\n"

msgid "  removed [file.%s]\n"
msgstr "  премахнат [file.{1}]\n"

msgid "  removed [files.%s]%s\n"
msgstr "  премахнат [files.{1}]{2}\n"

msgid "  sub folders:"
msgstr "  подпапки:"

msgid "  that does not fit the TOML subset; nothing was changed\n"
msgstr "  това не се побира в подмножеството на TOML; нищо не е променено\n"

msgid "  that was not readable text; again, please\n"
msgstr "  това не беше четим текст; отново, моля\n"

msgid "  the program folder '%s': %s\n"
msgstr "  папката на програмата '{1}': {2}\n"

msgid "  the source has no [file] tables for a shortcut to point at\n"
msgstr "  източникът няма таблици [file], към които да сочи пряк път\n"

msgid "  the source has no sub folders as `new` writes them ([files] \"<folder>/<name>/**\"); add them with 6\n"
msgstr "  източникът няма подпапки във вида, в който ги пише `new` ([files] \"<folder>/<name>/**\"); добавете ги с 6\n"

msgid "  too long; again, please\n"
msgstr "  твърде дълго; отново, моля\n"

msgid "  y or n\n"
msgstr "  y или n\n"

msgid " (changed)"
msgstr " (променено)"

msgid " - build Windows Installer (.msi) and MSIX (.msix) packages\n\nusage: rubrapack [--lang <code>] <command> [arguments]\n\ncommands:\n"
msgstr " - създава пакети Windows Installer (.msi) и MSIX (.msix)\n\nупотреба: rubrapack [--lang <code>] <command> [arguments]\n\nкоманди:\n"

msgid " and its dir"
msgstr " и неговата dir"

msgid "$(%s) has no environment variable, so an expandable value cannot hold it; use a string value (filled in at install time)"
msgstr "$({1}) няма променлива на средата, затова разширяема стойност не може да го съдържа; използвайте низова стойност (попълва се при инсталиране)"

msgid "$(%s) is a %s: it may start a path, or stand in a value Windows Installer fills in (registry, environment, INI, arguments, messages), not here"
msgstr "$({1}) е {2}: може да започва път или да замества стойност, която Windows Installer попълва (регистър, среда, INI, аргументи, съобщения), но не тук"

msgid "$(%s) is not a folder a path can start from (a dir ID, or ProgramFiles, LOCALAPPDATA, ProgramData ... - see the manual's Paths)%s"
msgstr "$({1}) не е папка, от която може да започва път (dir ID, или ProgramFiles, LOCALAPPDATA, ProgramData ... - вижте Paths в ръководството){2}"

msgid "%s\n  structure:  %s\n  digest:     %s\n  signature:  %s\n  chain:      %s%s%s\n  revocation: not-checked\n  timestamp:  %s\n"
msgstr "{1}\n  структура:    {2}\n  отпечатък:    {3}\n  подпис:       {4}\n  верига:       {5}{6}{7}\n  отмяна:       не е проверено\n  времеви печат: {8}\n"

msgid "%s %s: the variable is not set"
msgstr "{1} {2}: променливата не е зададена"

msgid "%s '%.*s' is not a control of this dialog"
msgstr "{1} '{2}' не е контрола в този диалогов прозорец"

msgid "%s '%.*s' is not in %s"
msgstr "{1} '{2}' не е в {3}"

msgid "%s '%s': %s"
msgstr "{1} '{2}': {3}"

msgid "%s '%s': the license text needs the face's English name, so it shows in the language's own face; write the English name (like \"Malgun Gothic\") to use this face there too"
msgstr "{1} '{2}': текстът на лиценза изисква английското име на шрифта, затова се показва с шрифта на езика; напишете английското име (например \"Malgun Gothic\"), за да се ползва този шрифт и там"

msgid "%s component, but the package platform is %.*s"
msgstr "компонент {1}, но платформата на пакета е {2}"

msgid "%s does not belong to kind = \"%s\""
msgstr "{1} не принадлежи на kind = \"{2}\""

msgid "%s does not belong to kind = \"firewall\""
msgstr "{1} не принадлежи на kind = \"firewall\""

msgid "%s holds LANGIDs (1..65535), like 1041"
msgstr "{1} съдържа LANGID (1..65535), например 1041"

msgid "%s holds strings"
msgstr "{1} съдържа низове"

msgid "%s is a typeface name of 1 to 31 characters, like \"Segoe UI\" (got %zu)"
msgstr "{1} е име на шрифт от 1 до 31 знака, например \"Segoe UI\" (получено {2})"

msgid "%s is an MSI condition with closed quotes and balanced parentheses"
msgstr "{1} е условие на MSI със затворени кавички и балансирани скоби"

msgid "%s is an array of strings, one per value"
msgstr "{1} е масив от низове, по един за всяка стойност"

msgid "%s is for MSI packages: an MSIX is not removed by msiexec"
msgstr "{1} е за пакети MSI: MSIX не се премахва от msiexec"

msgid "%s is gone. Remove [file.%s]?"
msgstr "{1} вече го няма. Да се премахне ли [file.{2}]?"

msgid "%s is longer than 240 characters"
msgstr "{1} е по-дълго от 240 знака"

msgid "%s is new. Add it?"
msgstr "{1} е ново. Да се добави ли?"

msgid "%s is not a GUID in registry format"
msgstr "{1} не е GUID във формата на регистъра"

msgid "%s is not a code this rubrapack uses%s%s"
msgstr "{1} не е код, който този rubrapack използва{2}{3}"

msgid "%s must be \"file:<ID>\" naming a [file.*] of this package"
msgstr "{1} трябва да е \"file:<ID>\", посочващ [file.*] от този пакет"

msgid "%s must be a GUID"
msgstr "{1} трябва да е GUID"

msgid "%s must be a GUID like {12345678-...} (got '%s')"
msgstr "{1} трябва да е GUID като {{12345678-...} (получено '{2}')"

msgid "%s must be an https://, http:// or file:// address, or a \\\\server\\share path (got '%s')"
msgstr "{1} трябва да е адрес https://, http:// или file://, или път \\\\server\\share (получено '{2}')"

msgid "%s must differ from upgrade-code (one upgrade family per architecture)"
msgstr "{1} трябва да се различава от upgrade-code (едно семейство за надстройка на архитектура)"

msgid "%s needs Windows build %u or later: set [msix] min-version = \"10.0.%u.0\""
msgstr "{1} изисква Windows build {2} или по-нова: задайте [msix] min-version = \"10.0.{3}.0\""

msgid "%s needs resources/bin/rubrapack_ca-%s.dll, which this rubrapack was built without"
msgstr "{1} изисква resources/bin/rubrapack_ca-{2}.dll, без който е компилиран този rubrapack"

msgid "%s, TSA not-checked (give --tsa-trust)"
msgstr "{1}, TSA не е проверен (дайте --tsa-trust)"

msgid "%s, TSA trusted"
msgstr "{1}, TSA е доверен"

msgid "%s, TSA untrusted - %s"
msgstr "{1}, TSA не е доверен - {2}"

msgid "%s/%s is gone or empty. Remove [files.%s] and [dir.%s]?"
msgstr "{1}/{2} го няма или е празна. Да се премахнат ли [files.{3}] и [dir.{4}]?"

msgid "%s/%s/ is a new folder. Add it?"
msgstr "{1}/{2}/ е нова папка. Да се добави ли?"

msgid "%s: %zu error%s, %zu warning%s\n"
msgstr "{1}: грешки: {2}{-3}, предупреждения: {4}{-5}\n"

msgid "%s: %zu error%s, %zu warning%s (against %s)\n"
msgstr "{1}: грешки: {2}{-3}, предупреждения: {4}{-5} (спрямо {6})\n"

msgid "%s: %zu files, %llu bytes\n"
msgstr "{1}: {2} файла, {3} байта\n"

msgid "%s: %zu files, %zu errors, 0 warnings\n"
msgstr "{1}: {2} файла, {3} грешки, 0 предупреждения\n"

msgid "%s: %zu more diagnostics not shown\n"
msgstr "{1}: още {2} диагностики не са показани\n"

msgid "%s: file '%s' is not a [file.*] of this package"
msgstr "{1}: файлът '{2}' не е [file.*] от този пакет"

msgid "%s: file '%s' is not a program (.exe)"
msgstr "{1}: файлът '{2}' не е програма (.exe)"

msgid "'$(' is not closed (write '$$(' for the text '$(')"
msgstr "'$(' не е затворено (напишете '$$(' за текста '$(')"

msgid "'%s' already exists; it is left as it is"
msgstr "'{1}' вече съществува; остава както е"

msgid "'%s' already exists; remove it or build into another folder"
msgstr "'{1}' вече съществува; премахнете го или компилирайте в друга папка"

msgid "'%s' already has a %s handler ([handler.%s])"
msgstr "'{1}' вече има манипулатор {2} ([handler.{3}])"

msgid "'%s' already has permissions"
msgstr "'{1}' вече има разрешения"

msgid "'%s' and '%s' are the same path in the package"
msgstr "'{1}' и '{2}' са един и същ път в пакета"

msgid "'%s' belongs to Windows or the browsers"
msgstr "'{1}' принадлежи на Windows или на браузърите"

msgid "'%s' cannot be read against '%s': %s"
msgstr "'{1}' не може да се прочете спрямо '{2}': {3}"

msgid "'%s' does not fit the TOML subset; nothing was saved"
msgstr "'{1}' не се побира в подмножеството на TOML; нищо не е записано"

msgid "'%s' exists already"
msgstr "'{1}' вече съществува"

msgid "'%s' exists already; change it with `rubrapack edit %s`"
msgstr "'{1}' вече съществува; променете го с `rubrapack edit {2}`"

msgid "'%s' exists and is not an empty directory; extract into a new one"
msgstr "'{1}' съществува и не е празна директория; извлечете в нова"

msgid "'%s' goes to %s; or msi-only = true"
msgstr "'{1}' отива в {2}; или msi-only = true"

msgid "'%s' has an unreadable summary information stream"
msgstr "'{1}' има нечетим поток с обобщена информация"

msgid "'%s' has no Directory, Component, File and Media tables to extract from"
msgstr "'{1}' няма таблици Directory, Component, File и Media, от които да се извлича"

msgid "'%s' has no readable summary information"
msgstr "'{1}' няма четима обобщена информация"

msgid "'%s' has no transform '%.*s'"
msgstr "'{1}' няма трансформация '{2}'"

msgid "'%s' is UTF-16: edit changes UTF-8 sources only (save it as UTF-8 first)"
msgstr "'{1}' е UTF-16: edit променя само източници в UTF-8 (първо го запишете като UTF-8)"

msgid "'%s' is a Windows name; give the variable another name"
msgstr "'{1}' е име на Windows; дайте друго име на променливата"

msgid "'%s' is a [chain]: it builds a setup program, -o setup.exe"
msgstr "'{1}' е [chain]: създава програма за инсталиране, -o setup.exe"

msgid "'%s' is a control of the built-in frame; choose another ID"
msgstr "'{1}' е контрола от вградената рамка; изберете друг ID"

msgid "'%s' is a machine folder; a %s package cannot write there"
msgstr "'{1}' е папка на компютъра; пакет {2} не може да пише там"

msgid "'%s' is a merge module: merge it with [merge.ID] instead"
msgstr "'{1}' е модул за сливане: слейте го с [merge.ID]"

msgid "'%s' is a name the MSIX format keeps for itself"
msgstr "'{1}' е име, което форматът MSIX пази за себе си"

msgid "'%s' is a symbolic link; links are not followed"
msgstr "'{1}' е символна връзка; връзките не се следват"

msgid "'%s' is also a [property.*]"
msgstr "'{1}' е също [property.*]"

msgid "'%s' is also a dir ID; give the variable another name"
msgstr "'{1}' е също dir ID; дайте друго име на променливата"

msgid "'%s' is built for machine 0x%04X, not for this package's arch; set any-arch = true if that is intended"
msgstr "'{1}' е компилиран за машина 0x{2}, а не за архитектурата на този пакет; задайте any-arch = true, ако това е умишлено"

msgid "'%s' is neither a PE file (.exe, .dll), an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не е нито PE файл (.exe, .dll), нито пакет MSI, нито пакет или сбор MSIX"

msgid "'%s' is neither a PE file, an MSI package nor an MSIX package or bundle"
msgstr "'{1}' не е нито PE файл, нито пакет MSI, нито пакет или сбор MSIX"

msgid "'%s' is neither a known folder nor a dir ID (known folders: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"
msgstr "'{1}' не е нито известна папка, нито dir ID (известни папки: ProgramFiles, ProgramFiles32, CommonFiles, AppData, LocalAppData, CommonAppData, StartMenu, Programs, Desktop, Windows, System, Fonts, Temp)"

msgid "'%s' is not a cabinet rubrapack can read (stored or MSZIP)"
msgstr "'{1}' не е cabinet, който rubrapack може да чете (stored или MSZIP)"

msgid "'%s' is not a diagnostic code (RP and four digits, like RP1612)"
msgstr "'{1}' не е диагностичен код (RP и четири цифри, например RP1612)"

msgid "'%s' is not a program (.exe)"
msgstr "'{1}' не е програма (.exe)"

msgid "'%s' is not a regular file"
msgstr "'{1}' не е обикновен файл"

msgid "'%s' is not a rubrapack setup program%s"
msgstr "'{1}' не е инсталационна програма на rubrapack{2}"

msgid "'%s' is not a valid ID (letters, digits and '_', not starting with a digit, at most %zu)"
msgstr "'{1}' не е валиден ID (букви, цифри и '_', не започва с цифра, най-много {2})"

msgid "'%s' is not a valid MSI database: %s"
msgstr "'{1}' не е валидна база данни MSI: {2}"

msgid "'%s' is not a valid MSIX package: %s"
msgstr "'{1}' не е валиден пакет MSIX: {2}"

msgid "'%s' is not a valid package: %s"
msgstr "'{1}' не е валиден пакет: {2}"

msgid "'%s' is not a valid source (the TOML subset); fix it by hand first"
msgstr "'{1}' не е валиден източник (подмножеството на TOML); първо го поправете ръчно"

msgid "'%s' is not a valid transform: %s"
msgstr "'{1}' не е валидна трансформация: {2}"

msgid "'%s' is not a valid variable name"
msgstr "'{1}' не е валидно име на променлива"

msgid "'%s' is reserved and cannot be used as an ID"
msgstr "'{1}' е запазено и не може да се ползва като ID"

msgid "'%s' is the name of a dir: only a registry or dir search can fill a dir"
msgstr "'{1}' е име на dir: само търсене в регистъра или dir може да попълни dir"

msgid "'%s' looks like a program file (PE) but its headers or resources are damaged"
msgstr "'{1}' прилича на програмен файл (PE), но заглавията или ресурсите му са повредени"

msgid "'%s' must be a string"
msgstr "'{1}' трябва да е низ"

msgid "'%s' must be an integer"
msgstr "'{1}' трябва да е цяло число"

msgid "'%s' must be between %lld and %lld"
msgstr "'{1}' трябва да е между {2} и {3}"

msgid "'%s' must be true or false"
msgstr "'{1}' трябва да е true или false"

msgid "'%s' must not be empty"
msgstr "'{1}' не трябва да е празно"

msgid "'%s' names no transforms (summary property 8): not a patch"
msgstr "'{1}' не назовава трансформации (свойство на обобщението 8): не е корекция"

msgid "'%s' starts with a folder: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""
msgstr "'{1}' започва с папка: \"$(ProgramFiles)/Example\", \"$(INSTALLDIR)/docs\""

msgid "'%s': %s"
msgstr "'{1}': {2}"

msgid "'%s': %s '%s' has %s; nothing was extracted"
msgstr "'{1}': {2} '{3}' има {4}; нищо не е извлечено"

msgid "'%s': %s%s"
msgstr "'{1}': {2}{3}"

msgid "'%s': %zu entries, more than the limit %llu (--limit-entries); nothing was extracted"
msgstr "'{1}': {2} записа, повече от лимита {3} (--limit-entries); нищо не е извлечено"

msgid "'%s': '%s' and '%s' would be the same path on Windows; nothing was extracted"
msgstr "'{1}': '{2}' и '{3}' биха били един и същ път в Windows; нищо не е извлечено"

msgid "'%s': '%s' is not in [ui] languages"
msgstr "'{1}': '{2}' не е в [ui] languages"

msgid "'%s': a table cannot be read"
msgstr "'{1}': таблица не може да се прочете"

msgid "'%s': a table is unreadable"
msgstr "'{1}': таблица е нечетима"

msgid "'%s': an MSIX installs all its files (when); use msi-only = true"
msgstr "'{1}': MSIX инсталира всичките си файлове (when); използвайте msi-only = true"

msgid "'%s': an MSIX removes all its files (keep); use msi-only = true"
msgstr "'{1}': MSIX премахва всичките си файлове (keep); използвайте msi-only = true"

msgid "'%s': cabinet '%s' is damaged or not stored/MSZIP"
msgstr "'{1}': cabinet '{2}' е повреден или не е stored/MSZIP"

msgid "'%s': cabinet name '%s' is not a plain file name"
msgstr "'{1}': името на cabinet '{2}' не е просто име на файл"

msgid "'%s': compressed file '%s' (sequence %ld) has no cabinet"
msgstr "'{1}': компресираният файл '{2}' (последователност {3}) няма cabinet"

msgid "'%s': directory '%s' has a parent '%s' that is not there"
msgstr "'{1}': директорията '{2}' има родител '{3}', който го няма"

msgid "'%s': directory '%s' is its own ancestor or nested too deep"
msgstr "'{1}': директорията '{2}' е свой собствен предшественик или е вложена твърде дълбоко"

msgid "'%s': file '%s' does not match its MsiFileHash"
msgstr "'{1}': файлът '{2}' не съвпада с неговия MsiFileHash"

msgid "'%s': file '%s' has no component or directory"
msgstr "'{1}': файлът '{2}' няма компонент или директория"

msgid "'%s': file '%s' is %zu bytes, the File table says %lu"
msgstr "'{1}': файлът '{2}' е {3} байта, а таблицата File казва {4}"

msgid "'%s': file '%s' is not in cabinet '%s'"
msgstr "'{1}': файлът '{2}' не е в cabinet '{3}'"

msgid "'%s': its external cabinets are not covered by the signature (--allow-unsigned-cabs)"
msgstr "'{1}': външните му cabinet файлове не са обхванати от подписа (--allow-unsigned-cabs)"

msgid "'%s': its folder does not lead to a known location"
msgstr "'{1}': папката му не води до известно място"

msgid "'%s': more than %llu bytes to write (--limit-bytes); nothing was extracted"
msgstr "'{1}': повече от {2} байта за запис (--limit-bytes); нищо не е извлечено"

msgid "'%s': no --timestamp: the signature stops being valid when the certificate expires"
msgstr "'{1}': няма --timestamp: подписът престава да е валиден, когато сертификатът изтече"

msgid "'%s': package '%s' does not match its SHA-256"
msgstr "'{1}': пакетът '{2}' не съвпада със своя SHA-256"

msgid "'%s': the cabinet stream '%s' is not there"
msgstr "'{1}': потокът на cabinet '{2}' го няма"

msgid "'%s': the manifest has no %s %s"
msgstr "'{1}': манифестът няма {2} {3}"

msgid "'%s': the manifest names '%s', which is not in the package"
msgstr "'{1}': манифестът посочва '{2}', което не е в пакета"

