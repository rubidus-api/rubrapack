msgstr "--key-store приема SHA-1 отпечатъка на сертификата (40 шестнадесетични цифри)"

msgid "--lang %s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "--lang {1}: няма такъв език (вградени: {2}; друг изисква езиковия си пакет, {3}.po)"

msgid "--lang (or RUBRAPACK_LANG) chooses the language of these texts: %s, or one with a language pack.\n"
msgstr "--lang (или RUBRAPACK_LANG) избира езика на тези текстове: {1}, или език с езиков пакет.\n"

msgid "--lang needs a language, such as en or ko"
msgstr "--lang изисква език, например en или ko"

msgid "--languages needs dialogs: give --ui too"
msgstr "--languages изисква диалогови прозорци: дайте и --ui"

msgid "--msix-compress takes deflate or store (got '%s')"
msgstr "--msix-compress приема deflate или store (получено '{1}')"

msgid "--pass-env %s: the variable is not set"
msgstr "--pass-env {1}: променливата не е зададена"

msgid "--patch-code takes a GUID in upper case with braces: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"
msgstr "--patch-code приема GUID с главни букви и скоби: {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"

msgid "--pin-env %s: the variable is not set"
msgstr "--pin-env {1}: променливата не е зададена"

msgid "--previous compares two .msi packages"
msgstr "--previous сравнява два пакета .msi"

msgid "--system-roots: the operating system's root certificates cannot be read"
msgstr "--system-roots: основните сертификати на операционната система не могат да се прочетат"

msgid "--target %s does not match the output '%s'"
msgstr "--target {1} не съвпада с изхода '{2}'"

