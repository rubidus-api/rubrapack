msgstr "--target {1} не е реализиран (msi или msix)"

msgid "--target takes msi or msix (got '%s')"
msgstr "--target приема msi или msix (получено '{1}')"

msgid "--tsa-trust, --tls-trust, --system-roots and --proxy go with --timestamp"
msgstr "--tsa-trust, --tls-trust, --system-roots и --proxy вървят с --timestamp"

msgid "--unsigned-test and --msix-compress are for .msix outputs"
msgstr "--unsigned-test и --msix-compress са за изходи .msix"

msgid "--unsigned-test is for packages without a signature; with --key leave it out"
msgstr "--unsigned-test е за пакети без подпис; с --key го пропуснете"

msgid "--validate takes none, or some of product-code,upgrade-code,language,platform"
msgstr "--validate приема none или някои от product-code,upgrade-code,language,platform"

msgid "-D %.*s is given twice"
msgstr "-D {1} е дадено два пъти"

msgid "-D %s: '%s' is a Windows name; give the variable another name"
msgstr "-D {1}: '{2}' е име на Windows; дайте друго име на променливата"

msgid "-D needs NAME=VALUE (got '%s')"
msgstr "-D изисква NAME=VALUE (получено '{1}')"

