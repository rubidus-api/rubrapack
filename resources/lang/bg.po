msgstr "--allow-unsigned-cabs е за .msi"

msgid "--arch for a bundle: a list of x64, x86 and arm64, each once (got '%s')"
msgstr "--arch за сбор: списък от x64, x86 и arm64, всяко по веднъж (получено '{1}')"

