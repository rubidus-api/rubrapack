msgstr "ActionProperty трябва да е публично свойство (с главни букви)"

msgid "All codes: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"
msgstr "Всички кодове: https://rubidus-api.github.io/rubrapack/en/rpk.html#diagnostic-codes\n"

msgid "AppxSignature.p7x does not start with PKCX"
msgstr "AppxSignature.p7x не започва с PKCX"

msgid "AppxSignature.p7x is not the last entry"
msgstr "AppxSignature.p7x не е последният запис"

