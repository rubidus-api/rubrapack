msgstr "Програма, която преките пътища отварят (- за без преки пътища)"

msgid "RUBRAPACK_LANG=%s: no such language (built in: %s; another needs its language pack, %s.po)"
msgstr "RUBRAPACK_LANG={1}: няма такъв език (вградени: {2}; друг изисква езиковия си пакет, {3}.po)"

msgid "Reference, "
msgstr "Справочник, "

