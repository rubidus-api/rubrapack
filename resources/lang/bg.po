msgstr "KeyPath '{1}' принадлежи на друг компонент"

msgid "KeyPath '%.*s' is not in File"
msgstr "KeyPath '{1}' не е във File"

msgid "KeyPath '%.*s' is not in Registry"
msgstr "KeyPath '{1}' не е в Registry"

msgid "Korean dialogs as well as English?"
msgstr "Диалогови прозорци на корейски освен на английски?"

msgid "LastSequence %ld is below that of a lower DiskId"
msgstr "LastSequence {1} е под това на по-малък DiskId"

msgid "Leave without saving the changes?"
msgstr "Изход без записване на промените?"

