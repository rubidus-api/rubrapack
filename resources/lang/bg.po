msgstr "Стойност (текст, число, true/false, [\"a\", \"b\"]; - премахва ключа)"

msgid "Variables"
msgstr "Променливи"

msgid "Version"
msgstr "Версия"

msgid "Version ([define] VERSION)"
msgstr "Версия ([define] VERSION)"

msgid "Versions and upgrades"
msgstr "Версии и надстройки"

msgid "Windows Installer allows at most 255.255.65535(.65535)"
msgstr "Windows Installer позволява най-много 255.255.65535(.65535)"

msgid "[%s%s%s] needs '%s'"
msgstr "[{1}{2}{3}] изисква '{4}'"

msgid "[%s%s] cannot go into a merge module; the package that merges it has it"
msgstr "[{1}{2}] не може да влезе в модул за сливане; има го пакетът, който го слива"

msgid "[%s%s] is not supported yet (planned for %s)"
msgstr "[{1}{2}] още не се поддържа (планирано за {3})"

msgid "[%s.%s] cannot go into an MSIX; add msi-only = true to build the MSIX without it"
msgstr "[{1}.{2}] не може да влезе в MSIX; добавете msi-only = true, за да се създаде MSIX без него"

msgid "[%s.%s]: an ID in a merge module has at most 35 characters (the module's GUID is added to it)"
msgstr "[{1}.{2}]: ID в модул за сливане има най-много 35 знака (добавя се GUID на модула)"

msgid "[%s] needs an ID: write [%s.ID]"
msgstr "[{1}] изисква ID: напишете [{2}.ID]"

msgid "[%s] takes no ID: write [%s]"
msgstr "[{1}] не приема ID: напишете [{2}]"

msgid "[Content_Types].xml has no </Types>"
msgstr "[Content_Types].xml няма </Types>"

msgid "[Content_Types].xml is not the last entry (not a package rubrapack or Windows' packaging API wrote)"
msgstr "[Content_Types].xml не е последният запис (не е пакет, записан от rubrapack или API за пакети на Windows)"

msgid "[[...]] arrays of tables are not supported; give each item its own [kind.ID]"
msgstr "Масиви от таблици [[...]] не се поддържат; дайте на всеки елемент собствен [kind.ID]"

msgid "[action.%s] check has no effect: nothing runs it yet; remove it"
msgstr "check на [action.{1}] няма ефект: още нищо не го изпълнява; премахнете го"

msgid "[action.%s] needs both do and undo (the undo also rolls back a failed do)"
msgstr "[action.{1}] изисква и do, и undo (undo също отменя неуспешно do)"

msgid "[assoc.%s]: args for an MSIX must be plain text (no [...] filled in at install)"
msgstr "[assoc.{1}]: args за MSIX трябва да е обикновен текст (без [...], попълвани при инсталиране)"

msgid "[assoc.%s]: in an MSIX a file type opens an application: target must be an [msix-app.*] executable"
msgstr "[assoc.{1}]: в MSIX файловият тип отваря приложение: target трябва да е изпълним файл на [msix-app.*]"

msgid "[chain-package.%s] is there twice"
msgstr "[chain-package.{1}] е два пъти"

msgid "[chain-package] needs an ID: write [chain-package.ID]"
msgstr "[chain-package] изисква ID: напишете [chain-package.ID]"

msgid "[com.%s]: app-id and typelib are written for the MSI only; the MSIX registers the class without them"
msgstr "[com.{1}]: app-id и typelib се записват само за MSI; MSIX регистрира класа без тях"

msgid "[com.%s]: args are a program's; a DLL is loaded, not started"
msgstr "[com.{1}]: args са на програма; DLL се зарежда, не се стартира"

msgid "[com.%s]: surrogate runs a DLL in dllhost; '%s' is a program"
msgstr "[com.{1}]: surrogate изпълнява DLL в dllhost; '{2}' е програма"

msgid "[com.%s]: threading is for a DLL; a program sets its own apartment"
msgstr "[com.{1}]: threading е за DLL; програмата задава своя apartment"

msgid "[com.%s]: typelib-version and typelib-file need typelib"
msgstr "[com.{1}]: typelib-version и typelib-file изискват typelib"

msgid "[copy.%s] goes to %s; or msi-only = true"
msgstr "[copy.{1}] отива в {2}; или msi-only = true"

msgid "[copy.%s]: its source must be a file that goes into the package"
msgstr "[copy.{1}]: източникът му трябва да е файл, който влиза в пакета"

msgid "[define] values must be strings"
msgstr "Стойностите на [define] трябва да са низове"

msgid "[dialog-control.%s] needs '%s'"
msgstr "[dialog-control.{1}] изисква '{2}'"

msgid "[dialog-control.%s] needs 'property'"
msgstr "[dialog-control.{1}] изисква 'property'"

msgid "[dialog-control.%s] needs 'text'"
msgstr "[dialog-control.{1}] изисква 'text'"

msgid "[dialog-control.%s] needs 'values'"
msgstr "[dialog-control.{1}] изисква 'values'"

msgid "[dialog.%s] has %zu controls; at most 64"
msgstr "[dialog.{1}] има {2} контроли; най-много 64"

msgid "[dialog.%s] has no [dialog-control.*]"
msgstr "[dialog.{1}] няма [dialog-control.*]"

msgid "[dialog.%s] is placed after itself through other dialogs"
msgstr "[dialog.{1}] е поставен след себе си чрез други диалогови прозорци"

msgid "[dialog.%s] needs ui = \"minimal\", \"installdir\" or \"features\""
msgstr "[dialog.{1}] изисква ui = \"minimal\", \"installdir\" или \"features\""

msgid "[dir.%s]: '%s' is a Windows name; give the dir another ID"
msgstr "[dir.{1}]: '{2}' е име на Windows; дайте друг ID на dir"

msgid "[dir.%s]: guard needs rubrapack's helper DLL, which a merge module does not carry"
msgstr "[dir.{1}]: guard изисква помощния DLL на rubrapack, който модулът за сливане не носи"

msgid "[env.%s] needs a feature"
msgstr "[env.{1}] изисква функция"

msgid "[env.%s]: an MSIX sets all its variables (when); use msi-only = true"
msgstr "[env.{1}]: MSIX задава всички свои променливи (when); използвайте msi-only = true"

msgid "[env.%s]: its value names a place an MSIX cannot give (a folder outside the package that is not a Windows folder, or an install-time part); use msi-only = true"
msgstr "[env.{1}]: стойността му посочва място, което MSIX не може да даде (папка извън пакета, която не е папка на Windows, или част от времето на инсталиране); използвайте msi-only = true"

msgid "[handler.%s]: Explorer loads a %s handler from a DLL; [com.%s] is a program"
msgstr "[handler.{1}]: Explorer зарежда манипулатор {2} от DLL; [com.{3}] е програма"

msgid "[handler.%s]: Windows reads property handlers per machine only; the package needs scope = \"machine\""
msgstr "[handler.{1}]: Windows чете манипулаторите на свойства само за компютъра; пакетът изисква scope = \"machine\""

msgid "[handler.%s]: a preview handler runs in Windows' prevhost; leave app-id and surrogate out of [com.%s]"
msgstr "[handler.{1}]: манипулаторът за визуализация работи в prevhost на Windows; оставете app-id и surrogate извън [com.{2}]"

msgid "[handler.%s]: an MSIX carries thumbnail and preview handlers only (a packaged property handler gave Explorer no values); msi-only = true keeps it for the MSI"
msgstr "[handler.{1}]: MSIX носи само манипулатори за миниатюри и визуализация (пакетиран манипулатор на свойства не даде стойности на Explorer); msi-only = true го запазва за MSI"

msgid "[handler.%s]: an MSIX file type belongs to an application; add an [msix-app.*]"
msgstr "[handler.{1}]: файлов тип на MSIX принадлежи на приложение; добавете [msix-app.*]"

msgid "[handler.%s]: class %s is not a [com.*] of this package (the handler's DLL serves it)"
msgstr "[handler.{1}]: класът {2} не е [com.*] от този пакет (DLL на манипулатора го обслужва)"

msgid "[handler.%s]: in an MSIX handlers share all their types or none (a type is in one file type association)"
msgstr "[handler.{1}]: в MSIX манипулаторите споделят всичките си типове или никои (типът е в една асоциация на файлов тип)"

msgid "[handler.%s]: in an MSIX its class runs in a surrogate; threading = \"sta\" in [com.%s] gives its window a message loop (with threading = %s the preview may stay blank)"
msgstr "[handler.{1}]: в MSIX класът му работи в surrogate; threading = \"sta\" в [com.{2}] дава на прозореца цикъл за съобщения (с threading = {3} визуализацията може да остане празна)"

msgid "[handler.%s]: in an MSIX its types are all in one [assoc] file type, or none"
msgstr "[handler.{1}]: в MSIX всичките му типове са в един файлов тип [assoc], или в никой"

msgid "[handler.%s]: its class is msi-only ([com.%s]); the MSIX would have no server for it"
msgstr "[handler.{1}]: класът му е msi-only ([com.{2}]); MSIX няма да има сървър за него"

msgid "[handler.%s]: types is a list of file types, like [\".txt\"]"
msgstr "[handler.{1}]: types е списък от файлови типове, например [\".txt\"]"

msgid "[ini.%s] goes to %s; or msi-only = true"
msgstr "[ini.{1}] отива в {2}; или msi-only = true"

msgid "[ini.%s] needs 'value'"
msgstr "[ini.{1}] изисква 'value'"

msgid "[ini.%s] needs a feature: set 'feature' here or on its dir"
msgstr "[ini.{1}] изисква функция: задайте 'feature' тук или в неговата dir"

msgid "[ini.%s]: an MSIX writes all its INI entries (when); use msi-only = true"
msgstr "[ini.{1}]: MSIX записва всичките си записи в INI (when); използвайте msi-only = true"

msgid "[ini.%s]: its value has a part Windows Installer fills in at install time ([...]); an MSIX writes the file when it is built"
msgstr "[ini.{1}]: стойността му има част, която Windows Installer попълва при инсталиране ([...]); MSIX записва файла при създаването си"

msgid "[menu.%s] needs 'on': where the item shows, like [\".txt\"] or \"folder\""
msgstr "[menu.{1}] изисква 'on': къде се показва елементът, например [\".txt\"] или \"folder\""

msgid "[menu.%s] needs 'target' (the program it starts), or items with parent = \"%s\" (a sub-menu)"
msgstr "[menu.{1}] изисква 'target' (програмата, която стартира) или елементи с parent = \"{2}\" (подменю)"

msgid "[menu.%s] needs 'target': the program the item starts"
