msgstr "Производител"

msgid "Manufacturer (shown in Installed apps)"
msgstr "Производител (показва се в Инсталирани приложения)"

msgid "NCrypt returned an ECDSA signature of the wrong length"
msgstr "NCrypt върна подпис ECDSA с грешна дължина"

